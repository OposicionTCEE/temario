% Figura: la SML y la falacia del WACC. Bloque 2, apartado «El coste de oportunidad del proyecto».
% Panel (a): la SML convierte la beta en una tasa, r = gamma + beta lambda_M (gamma = 1, lambda_M = 1,5; unidades ilustrativas).
%   M: cartera de mercado (beta = 1, r_M = gamma + lambda_M). P: un proyecto con beta_P = 1,6; su prima es beta_P lambda_M.
% Panel (b): la misma SML. WACC de la empresa (sin impuestos): el de la beta de sus activos, beta_A = 1 -> 2,5 (discontinua).
%   Proyecto S (seguro): beta = 0,4, rentabilidad 2,0 > SML (1,6) pero < WACC (2,5): la empresa lo rechaza aunque crea valor.
%   Proyecto R (arriesgado): beta = 1,7, rentabilidad 3,1 > WACC (2,5) pero < SML (3,55): la empresa lo acepta aunque destruye valor.
%   Zonas sombreadas: entre la SML y el WACC, donde la tasa única se equivoca.
% Generar con: bash Code/generar_figura.sh falacia_wacc
\begin{tikzpicture}[x=3.0cm, y=1.15cm, font=\footnotesize, >={Stealth[length=4pt]}]
  % ---------- Panel (a): de la beta a la tasa ----------
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (1.1,4.95) {(a) La SML: de la beta a la tasa};
    \draw[->] (0,0) -- (2.25,0) node[below left, yshift=-2pt] {$\beta$};
    \draw[->] (0,0) -- (0,4.5) node[left] {$r$};
    \draw[very thick] (0,1) -- (2.1,4.15) node[above right, xshift=-4pt] {SML};
    \node[left] at (0,1) {$\gamma$};
    % Pendiente: una unidad de beta se paga con lambda_M.
    \draw[densely dotted] (0,1) -- (1,1);
    \draw[densely dotted] (1,0) -- (1,1);
    \draw[thick] (1,1) -- (1,2.5);
    \node[right] at (1,1.75) {$\lambda_M$};
    \node[below] at (0.5,1) {$1$};
    \fill (1,2.5) circle (2pt) node[above left] {$M$};
    \node[below] at (1,0) {$\beta_M=1$};
    % Proyecto P: prima = beta_P lambda_M.
    \draw[densely dotted] (1.6,0) -- (1.6,3.4);
    \draw[densely dotted] (1,1) -- (1.6,1);
    \fill (1.6,3.4) circle (2pt) node[left, xshift=-1pt] {$P$};
    \node[below] at (1.6,0) {$\beta_P$};
    \draw[decorate, decoration={brace, amplitude=4pt}] (1.64,3.4) -- (1.64,1)
      node[midway, right, xshift=4pt, align=left] {$\lambda_P=\beta_P\,\lambda_M$};
    \draw[decorate, decoration={brace, amplitude=4pt}] (1.64,1) -- (1.64,0)
      node[midway, right, xshift=4pt] {$\gamma$};
  \end{scope}
  % ---------- Panel (b): la falacia del WACC ----------
  \begin{scope}[xshift=8.4cm]
    \node[font=\footnotesize\bfseries] at (1.1,4.95) {(b) La falacia del WACC};
    \fill[black!12] (0,1) -- (1,2.5) -- (0,2.5) -- cycle;
    \fill[black!12] (1,2.5) -- (2.1,4.15) -- (2.1,2.5) -- cycle;
    \draw[->] (0,0) -- (2.25,0) node[below left, yshift=-2pt] {$\beta$};
    \draw[->] (0,0) -- (0,4.5) node[left] {$r$};
    \draw[very thick] (0,1) -- (2.1,4.15) node[above right, xshift=-4pt] {SML};
    \draw[very thick, dashed] (0,2.5) -- (2.1,2.5) node[right] {$r_{\text{WACC}}$};
    \fill (0.4,2.0) circle (2pt) node[above left] {$S$};
    \fill (1.7,3.1) circle (2pt) node[below right] {$R$};
    \node[left] at (0,1) {$\gamma$};
    \draw[densely dotted] (1,0) -- (1,2.5);
    \node[below] at (1,0) {$\beta_A$};
  \end{scope}
\end{tikzpicture}
