% Figura: la falacia del WACC. Bloque 2, apartado «El coste de oportunidad del proyecto».
% Línea del mercado de valores (SML): E[r] = gamma + beta lambda_M, con gamma = 1 y lambda_M = 1,5 (unidades ilustrativas).
% WACC de la empresa: el de su beta media, beta_e = 1 -> 2,5 (línea horizontal discontinua).
% Proyecto S (seguro): beta = 0,4, rentabilidad 2,0 > SML (1,6) pero < WACC (2,5): la empresa lo rechaza aunque crea valor.
% Proyecto R (arriesgado): beta = 1,7, rentabilidad 3,1 > WACC (2,5) pero < SML (3,55): la empresa lo acepta aunque destruye valor.
% Zonas sombreadas: entre la SML y el WACC, donde la tasa única se equivoca.
% Generar con: bash Code/generar_figura.sh falacia_wacc
\begin{tikzpicture}[x=4.2cm, y=1.35cm, font=\footnotesize, >={Stealth[length=4pt]}]
  % Zonas de error.
  \fill[black!12] (0,1) -- (1,2.5) -- (0,2.5) -- cycle;
  \fill[black!12] (1,2.5) -- (2.1,4.15) -- (2.1,2.5) -- cycle;
  % Ejes.
  \draw[->] (0,0) -- (2.3,0) node[below left, yshift=-2pt] {$\beta$};
  \draw[->] (0,0) -- (0,4.5) node[left] {$\mathbb E[r]$};
  % SML y WACC.
  \draw[very thick] (0,1) -- (2.1,4.15) node[above right] {SML};
  \draw[very thick, dashed] (0,2.5) -- (2.1,2.5) node[right] {$r_{\text{WACC}}$};
  % Proyectos.
  \fill (0.4,2.0) circle (2pt) node[below right] {$S$};
  \fill (1.7,3.1) circle (2pt) node[below right] {$R$};
  % Marcas.
  \node[left] at (0,1) {$\gamma$};
  \draw[densely dotted] (1,0) -- (1,2.5);
  \node[below] at (1,0) {$\beta_{\text{empresa}}$};
\end{tikzpicture}
