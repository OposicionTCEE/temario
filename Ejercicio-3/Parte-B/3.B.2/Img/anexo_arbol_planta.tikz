% Figura del anexo: árbol de decisión de la ampliación o nueva planta (ejemplo numérico, VAN en unidades monetarias).
% Ampliación grande: 0,5 x 150 + 0,5 x (-50) = 50; pequeña: 0,5 x 100 + 0,5 x 50 = 75.
% Nueva planta grande: 0,5 x 350 + 0,5 x (-350) = 0; pequeña: 0,75 x 250 + 0,25 x 150 = 225 (corrige 271,8).
% Decisión: ampliación pequeña (75) frente a nueva planta pequeña (225): nueva planta pequeña. Ramas elegidas en grueso.
% Generar con: bash Code/generar_figura.sh anexo_arbol_planta
\begin{tikzpicture}[font=\footnotesize,
    dec/.style={draw, fill=black!12, minimum size=7pt, inner sep=0pt},
    azar/.style={draw, circle, fill=black!12, minimum size=7pt, inner sep=0pt},
    elegida/.style={very thick}, descartada/.style={thin, black!55}]
  \node[dec, label=above:{$225$}] (r) at (0,0) {};
  \node[dec, label=left:{$75$}] (amp) at (-4,-1.4) {};
  \node[dec, label=right:{$225$}] (nue) at (4,-1.4) {};
  \draw[descartada] (r) -- node[above left] {ampliar} (amp);
  \draw[elegida] (r) -- node[above right] {nueva planta} (nue);
  \foreach \p/\x/\nom/\v/\est in {amp/-6/grande/50/descartada, amp/-2/pequeña/75/elegida, nue/2/grande/0/descartada, nue/6/pequeña/225/elegida} {
    \node[azar, label=right:{$\v$}] (\p\x) at (\x,-2.9) {};
    \draw[\est] (\p) -- node[above, sloped, black] {\nom} (\p\x);
  }
  \foreach \c/\x/\pa/\va/\pb/\vb in {amp-6/-6/0,5/150/0,5/-50, amp-2/-2/0,5/100/0,5/50, nue2/2/0,5/350/0,5/-350, nue6/6/0,75/250/0,25/150} {
    \draw (\c) -- node[left] {$\pa$} (\x-0.7,-4.3) node[below] {$\va$};
    \draw (\c) -- node[right] {$\pb$} (\x+0.7,-4.3) node[below] {$\vb$};
  }
\end{tikzpicture}
