% Figura: índice de rentabilidad y racionamiento de capital (LORIE y SAVAGE, 1955). Bloque 1, apartado del índice de rentabilidad.
% Ejemplo conductor: A exige I_A = 2 y tiene VAN_A = 2,4 (R_A = 1,2); B exige I_B = 6 y tiene VAN_B = 3,6 (R_B = 0,6).
% Presupuesto K = I_B. Con A, el resto del presupuesto (K - I_A) se coloca al tipo de interés (VAN nulo): VAN total = VAN_A.
% Si los proyectos fueran divisibles, A más una fracción theta = (K - I_A)/I_B de B: VAN_A + R_B (K - I_A) = 4,8.
% El índice de rentabilidad es la pendiente del radio que une el origen con cada proyecto. Valores ilustrativos.
% Generar con: bash Code/generar_figura.sh indice_rentabilidad
\begin{tikzpicture}[x=1.5cm, y=1.1cm, font=\footnotesize, >={Stealth[length=4pt]}]
  % Ejes.
  \draw[->] (0,0) -- (7.4,0) node[below left, yshift=-2pt] {$I$};
  \draw[->] (0,0) -- (0,5.6) node[left] {$VAN$};
  % Radios desde el origen: su pendiente es el índice de rentabilidad.
  \draw[thick] (0,0) -- (2.9,3.48) node[above] {$R_A$};
  \draw[thick] (0,0) -- (6.9,4.14) node[right] {$R_B$};
  % Presupuesto.
  \draw[dashed] (6,0) -- (6,5.3);
  % Con A: el resto del presupuesto, a VAN nulo.
  \draw[very thick, densely dotted] (2,2.4) -- (6,2.4);
  % Con A y una fracción de B (proyectos divisibles): pendiente R_B.
  \draw[very thick, black!55] (2,2.4) -- (6,4.8);
  % Proyectos y combinaciones.
  \fill (2,2.4) circle (2pt) node[above left] {$A$};
  \fill (6,3.6) circle (2pt);
  \fill (6,2.4) circle (2pt);
  \fill[black!55] (6,4.8) circle (2pt);
  \node[right] at (6.05,4.8) {$A+\theta B$};
  \node[right] at (6.05,3.45) {$B$};
  \node[right] at (6.05,2.4) {$A$};
  % Marcas.
  \draw (2,0.08) -- (2,-0.08) node[below] {$I_A$};
  \node[below] at (6,-0.08) {$K=I_B$};
  \draw[densely dotted] (0,2.4) -- (2,2.4);
  \draw[densely dotted] (0,3.6) -- (6,3.6);
  \node[left] at (0,2.4) {$VAN_A$};
  \node[left] at (0,3.6) {$VAN_B$};
\end{tikzpicture}
