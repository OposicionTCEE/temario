% Figura: el círculo de la endogeneidad. Bloque 2, apartado «Balance: ¿qué supone el método y cuándo deja de valer?».
% Panel (a), izquierda: el ciclo coste del proyecto -> VAN -> valor de la empresa -> endeudamiento -> costes de las fuentes
%   -> coste del proyecto. MODIGLIANI y MILLER (1958) cortan el último eslabón: los costes de las fuentes cambian, su media no.
% Panel (b), derecha: el mismo círculo sobre la SML r = gamma + beta lambda_M (gamma = 1, lambda_M = 1,1; ilustrativo).
%   Puntos del método (llenos), D/V = 0,5: D (0,1; 1,11), A (1; 2,1), E_P: beta = (1 - 0,05)/0,5 = 1,9 -> r = 3,09;
%     WACC = r_A - ahorro fiscal = 1,65.
%   Con más deuda y costes de insolvencia (huecos), D/V = 0,6: D' (0,4; 1,44), A' (1,25; 2,375),
%     E_P': beta = (1,25 - 0,4·0,6)/0,4 = 2,525 -> r = 3,7775; WACC' = 1,875 (más allá del endeudamiento óptimo).
%   Bucle discontinuo: el nuevo WACC cambia el valor V y, con él, D/V, que vuelve a mover los puntos.
% Generar con: bash Code/generar_figura.sh circulo_endogeneidad
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  % ---------- Panel (a): el círculo ----------
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (3.6,5.55) {(a) El círculo};
    \tikzset{caja/.style={draw, thick, rounded corners=2pt, align=center, inner sep=3pt, minimum height=0.9cm, text width=2.15cm}}
    \node[caja] (coste) at (3.6,4.55) {Coste del proyecto\\ $r_{\text{WACC}}^P$};
    \node[caja] (van)   at (6.05,3.05) {VAN del\\ proyecto};
    \node[caja] (valor) at (5.1,0.75) {Valor de la\\ empresa, $V$};
    \node[caja] (deuda) at (2.1,0.75) {Endeudamiento\\ $D/V$};
    \node[caja] (fuentes) at (1.15,3.05) {Costes de las\\ fuentes, $r_E$, $r_D$};
    \draw[->, thick] (coste.east) to[bend left=18] (van.north);
    \draw[->, thick] (van.south) to[bend left=18] (valor.north east);
    \draw[->, thick] (valor.west) -- (deuda.east);
    \draw[->, thick] (deuda.north west) to[bend left=18] (fuentes.south);
    \draw[->, thick] (fuentes.north) to[bend left=18] coordinate[pos=0.5] (corte) (coste.west);
    % Corte de MODIGLIANI y MILLER: los costes de las fuentes cambian, su media no.
    \draw[very thick] ($(corte)+(-0.17,-0.03)$) -- ($(corte)+(0.03,0.2)$);
    \draw[very thick] ($(corte)+(-0.05,-0.13)$) -- ($(corte)+(0.15,0.1)$);
    \node[anchor=south east] at ($(corte)+(-0.1,0.12)$) {MM (1958)};
  \end{scope}
  % ---------- Panel (b): el círculo sobre la SML ----------
  \begin{scope}[xshift=8.4cm, x=2.35cm, y=1.1cm]
    \node[font=\footnotesize\bfseries] at (1.4,5.05) {(b) El círculo sobre la SML};
    \draw[->] (0,0) -- (2.85,0) node[below left, yshift=-2pt] {$\beta$};
    \draw[->] (0,0) -- (0,4.4) node[left] {$r$};
    \draw[very thick] (0,1) -- (2.75,4.025) node[below right, xshift=-6pt] {SML};
    \node[left] at (0,1) {$\gamma$};
    % Puntos del método (llenos).
    \fill (0.1,1.11) circle (2pt) node[below right] {$D$};
    \fill (1,2.1) circle (2pt) node[above left] {$A$};
    \fill (1.9,3.09) circle (2pt) node[above left] {$E_P$};
    \fill (1,1.65) circle (2pt) node[below] {WACC};
    % Con más deuda y costes de insolvencia (huecos).
    \draw[thick, fill=white] (0.4,1.44) circle (2pt) node[below right] {$D'$};
    \draw[thick, fill=white] (1.25,2.375) circle (2pt) node[above left] {$A'$};
    \draw[thick, fill=white] (2.525,3.7775) circle (2pt) node[above left] {$E_P'$};
    \draw[thick, fill=white] (1.25,1.875) circle (2pt) node[right] {WACC$'$};
    % Desplazamientos.
    \draw[->, densely dashed] (1.03,1.68) -- (1.21,1.85);
    % Bucle: el nuevo WACC cambia V y D/V, que vuelven a mover los puntos.
    \draw[->, thick, densely dashed] (1.3,1.8) .. controls (1.9,1.0) and (1.3,0.3) .. node[pos=0.55, below right] {$V$, $D/V$}
      (0.75,0.55) .. controls (0.35,0.75) and (0.3,1.1) .. (0.38,1.36);
    % Leyenda.
    \fill (0.1,4.25) circle (2pt) node[right, xshift=2pt] {método (MM)};
    \draw[thick, fill=white] (0.1,3.85) circle (2pt) node[right, xshift=2pt] {con insolvencia};
  \end{scope}
\end{tikzpicture}
