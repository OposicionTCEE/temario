% Figura: valor de la opción de invertir frente al VAN estático (modelo de DIXIT y PINDYCK, 1994, opción perpetua).
% Bloque 1, apartado «Opciones reales». Inversión I = 1. VAN estático: V - I.
% Opción con volatilidad baja: beta = 3, umbral V* = beta/(beta-1) I = 1,5; F(V) = A V^beta, A = 0,5/1,5^3 = 0,148.
% Opción con volatilidad alta: beta = 1,6, umbral V* = 2,667; A = 1,667/2,667^1,6 = 0,347.
% Por encima del umbral, la opción vale V - I (se invierte). Valores ilustrativos.
% Generar con: bash Code/generar_figura.sh opcion_valor
\begin{tikzpicture}[x=3.3cm, y=1.9cm, font=\footnotesize, >={Stealth[length=4pt]}]
  \draw[->] (0,0) -- (3.45,0) node[below left, yshift=-2pt] {$V$};
  \draw[->] (0,-1.05) -- (0,2.55) node[left] {valor};
  % VAN estático.
  \draw[thick, dashed] (0,-1) -- (3.3,2.3) node[above left] {$V-I$};
  % Opción con volatilidad baja.
  \draw[very thick, black!55] plot[domain=0:1.5, samples=60] (\x, {0.148*\x*\x*\x});
  \fill[black!55] (1.5,0.5) circle (1.6pt);
  % Opción con volatilidad alta.
  \draw[very thick] plot[domain=0:2.667, samples=80] (\x, {0.347*pow(\x,1.6)});
  \fill (2.667,1.667) circle (1.6pt);
  \node[black!55, below right] at (1.2,0.25) {$\sigma$ baja};
  \node[above left] at (2.2,1.35) {$\sigma$ alta};
  % Marcas: inversión y umbrales.
  \draw (1,0.04) -- (1,-0.04) node[below] {$I$};
  \draw[densely dotted, black!55] (1.5,0) -- (1.5,0.5);
  \node[below, black!55] at (1.5,0) {$V^*_1$};
  \draw[densely dotted] (2.667,0) -- (2.667,1.667);
  \node[below] at (2.667,0) {$V^*_2$};
\end{tikzpicture}
