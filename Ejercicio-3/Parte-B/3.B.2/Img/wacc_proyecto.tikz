% Figura: del coste de la comparable al WACC del proyecto. Bloque 2, apartado «Método: ¿qué procedimiento seguir?».
% Panel (a): cadena de balances a valor de mercado (altura = valor, normalizado a 1; gris = riesgo sistemático por euro).
%   Comparable C: D/V = 0,3 -> recursos propios con beta_A/0,7 (gris 31). Negocio sin deuda: E = V, coste r_A (gris 22).
%   Proyecto P: D/V = 0,6 -> recursos propios con beta_A/0,4 (gris 55). Activos iguales en los tres (beta_A, r_A).
%   (1) desapalancar: de C al negocio; (2) reapalancar: del negocio a P; (3) recomponer el WACC de P.
% Panel (b): SML r = gamma + beta lambda_M (gamma = 1, lambda_M = 1,1; unidades ilustrativas).
%   D: beta_D = 0,1. A: beta_A = 1 -> r_A = 2,1. Acciones de C: beta = (1 - 0,1·0,3)/0,7 = 1,386.
%   Acciones de P: beta = (1 - 0,1·0,6)/0,4 = 2,35. WACC de P: r_A - T r_D (D/V)_P, por debajo de r_A (1,75, ilustrativo).
% Generar con: bash Code/generar_figura.sh wacc_proyecto
\begin{tikzpicture}[font=\footnotesize, x=1cm, y=1cm, >={Stealth[length=4pt]}]
  % ---------- Panel (a): los balances ----------
  \node[font=\footnotesize\bfseries] at (6.675,4.55) {(a) Del balance de la comparable al del proyecto};
  \foreach \px/\titulo/\corte/\gris/\etE/\etD in {
      0/{Comparable C}/0.9/31/{$E_C$,\ $r_E^C$}/{$D_C$,\ $r_D^C$},
      5.1/{Negocio sin deuda}/0/22/{$E=V$,\ $r_A$}/{},
      10.2/{Proyecto P}/1.8/55/{$E_P$,\ $r_E^P$}/{$D_P$,\ $r_D^P$}} {
    \begin{scope}[xshift=\px cm]
      \node at (1.575,3.4) {\titulo};
      % Activos: el mismo negocio en los tres balances.
      \fill[black!22] (0,0) rectangle (1.5,3);
      \draw[thick] (0,0) rectangle (1.5,3);
      \node at (0.75,1.5) {$V$,\ $r_A$};
      % Recursos propios (arriba) y deuda (abajo).
      \fill[black!\gris] (1.65,\corte) rectangle (3.15,3);
      \draw[thick] (1.65,\corte) rectangle (3.15,3);
      \node at (2.4,{(3+\corte)/2}) {\etE};
      \ifdim\corte pt>0pt
        \draw[thick] (1.65,0) rectangle (3.15,\corte);
        \node at (2.4,{\corte/2}) {\etD};
      \fi
    \end{scope}
  }
  \draw[->, thick] (3.45,1.5) -- (4.8,1.5) node[midway, above] {(1)} node[midway, below] {desapalancar};
  \draw[->, thick] (8.55,1.5) -- (9.9,1.5) node[midway, above] {(2)} node[midway, below] {reapalancar};
  \draw[decorate, decoration={brace, amplitude=4pt, mirror}] (10.2,-0.12) -- (13.35,-0.12)
    node[midway, below, yshift=-3pt] {(3) $r_{\text{WACC}}^P$};
  % ---------- Panel (b): el recorrido sobre la SML ----------
  \begin{scope}[yshift=-6.9cm, xshift=3.4cm, x=2.6cm, y=1.1cm]
    \node[font=\footnotesize\bfseries] at (1.3,4.55) {(b) El recorrido sobre la SML};
    \draw[->] (0,0) -- (2.75,0) node[below left, yshift=-2pt] {$\beta$};
    \draw[->] (0,0) -- (0,4.2) node[left] {$r$};
    \draw[very thick] (0,1) -- (2.6,3.86) node[above right, xshift=-4pt] {SML};
    \node[left] at (0,1) {$\gamma$};
    % Líneas de referencia.
    \foreach \b/\r in {1/2.1, 1.386/2.525, 2.35/3.585} {
      \draw[densely dotted, black!60] (\b,0) -- (\b,\r);
      \draw[densely dotted, black!60] (0,\r) -- (\b,\r);
    }
    \draw[densely dotted, black!60] (0,1.75) -- (1,1.75);
    \node[left] at (0,2.1) {$r_A$};
    \node[left] at (0,2.525) {$r_E^C$};
    \node[left] at (0,3.585) {$r_E^P$};
    \node[left] at (0,1.75) {$r_{\text{WACC}}^P$};
    \node[below] at (1,0) {$\beta_A$};
    \node[below] at (1.386,0) {$\beta_E^C$};
    \node[below] at (2.35,0) {$\beta_E^P$};
    % Puntos.
    \fill (0.1,1.11) circle (2pt) node[above left] {$D$};
    \fill (1,2.1) circle (2pt) node[above left] {$A$};
    \fill (1.386,2.525) circle (2pt) node[above left] {$C$};
    \fill (2.35,3.585) circle (2pt) node[above left] {$P$};
    \draw[thick, fill=white] (1,1.75) circle (2pt);
    % Recorrido: (1) desapalancar, (2) reapalancar, (3) recomponer.
    \draw[->, thick] (1.40,2.42) to[bend left=35] node[midway, below right, xshift=-2pt] {(1)} (1.06,2.03);
    \draw[->, thick] (1.08,2.0) to[bend right=25] node[midway, below right] {(2)} (2.33,3.47);
    \draw[->, thick] (0.93,2.03) -- (0.93,1.8) node[midway, left] {(3)};
  \end{scope}
\end{tikzpicture}
