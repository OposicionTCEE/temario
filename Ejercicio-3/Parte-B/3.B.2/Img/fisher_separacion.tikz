% Figura: separación de FISHER (1930) en el modelo de dos periodos de HIRSHLEIFER (1958). Bloque 1, apartado del VAN.
% Dotación Y_0 = 6 hoy; frontera de inversión C_1 = 3,2·sqrt(Y_0 - C_0); tipo de interés r = 0,25.
% Tangencia: I* = 1,6384, C_0^P = 4,3616, C_1^P = 4,096; recta de mercado C_1 = (1+r)(W_0 - C_0), W_0 = 7,6384 (VAN = 1,6384).
% Propietario a (presta): C = (2,5; 6,423); propietario b (se endeuda): C = (6,2; 1,798). Curvas de indiferencia
% Cobb-Douglas tangentes a la recta de mercado en esos puntos: C_1 = C_1a (C_0a/C_0)^k, k = 0,4865 (a) y 4,3103 (b).
% Escala: 1,15 cm por unidad en C_0 y 0,62 cm en C_1. Curvas ilustrativas.
% Generar con: bash Code/generar_figura.sh fisher_separacion
\begin{tikzpicture}[x=1.15cm, y=0.62cm, font=\footnotesize, >={Stealth[length=4pt]}]
  % Ejes.
  \draw[->] (0,0) -- (9.0,0) node[below left, yshift=-2pt] {$C_0$};
  \draw[->] (0,0) -- (0,10.6) node[left] {$C_1$};
  % Recta de mercado.
  \draw[very thick] (0,9.548) -- (7.6384,0);
  \node[right] at (0.55,9.2) {$C_1=(1+r)\,(W_0-C_0)$};
  % Frontera de inversión.
  \draw[very thick, black!55] plot[domain=0.25:6, samples=200] (\x, {3.2*sqrt(6-\x)});
  \node[black!55, below] at (1.25,6.85) {$f(Y_0-C_0)$};
  % Curvas de indiferencia de los propietarios a y b.
  \draw[thick, dashed] plot[domain=1.6:5.4, samples=80] (\x, {6.423*pow(2.5/\x,0.4865)}) node[right] {$U_a$};
  \draw[thick, dashed] plot[domain=5.05:8.4, samples=80] (\x, {1.798*pow(6.2/\x,4.3103)}) node[right] {$U_b$};
  % Punto de inversión óptima y sus proyecciones.
  \draw[densely dotted] (4.3616,0) -- (4.3616,4.096) -- (0,4.096);
  \fill (4.3616,4.096) circle (2pt) node[above right] {$P^*$};
  \node[left] at (0,4.096) {$C_1^P$};
  % Consumos elegidos por a y b.
  \fill (2.5,6.423) circle (2pt) node[above right] {$a$};
  \fill (6.2,1.798) circle (2pt) node[above right, xshift=-1pt] {$b$};
  % Marcas en el eje de C_0.
  \foreach \x/\t in {4.3616/{C_0^P}, 6/{Y_0}, 7.6384/{W_0}} {
    \draw (\x,0.15) -- (\x,-0.15) node[below] {$\t$};
  }
  % Llaves: inversión y VAN.
  \draw[decorate, decoration={brace, mirror, amplitude=4pt}] (4.3616,-1.25) -- (6,-1.25) node[midway, below=4pt] {$I^*$};
  \draw[decorate, decoration={brace, mirror, amplitude=4pt}] (6,-1.25) -- (7.6384,-1.25) node[midway, below=4pt] {$VAN$};
\end{tikzpicture}
