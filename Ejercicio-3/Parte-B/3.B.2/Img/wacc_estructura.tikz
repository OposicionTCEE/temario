% Figura: ¿depende el WACC de la estructura de capital? Bloque 2, apartado «El WACC del proyecto».
% Mismas curvas que las figuras wacc_tradicional y mm_paneles del Tema 3.B.3, para que ambos temas coincidan.
% (a) Visión tradicional (DURAND, 1952): r_D = 0,9 hasta x = 3 y 0,9 + 0,12 (x - 3)^2 después; r_E = 1,6 + 0,05 x + 0,06 x^2;
%     WACC = (r_E + r_D x)/(1 + x), con mínimo en L* (x = 3).
% (b) MODIGLIANI y MILLER (1958), deuda sin riesgo: r_D = 0,8; r_U = 1,8; r_E = r_U + (r_U - r_D) x; WACC = r_U.
% Curvas ilustrativas. Generar con: bash Code/generar_figura.sh wacc_estructura
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  % (a) Visión tradicional.
  \begin{scope}[x=1.0cm, y=1.0cm]
    \node[font=\footnotesize\bfseries] at (3,5.0) {(a) Visión tradicional};
    \draw[->] (0,0) -- (6.6,0) node[below left, yshift=-2pt] {$D/E$};
    \draw[->] (0,0) -- (0,4.6) node[left] {coste};
    \draw[very thick] plot[domain=0:6, samples=60] (\x, {1.6+0.05*\x+0.06*\x*\x}) node[right] {$r_E$};
    \draw[very thick] (0,0.9) -- (3,0.9) plot[domain=3:6, samples=30] (\x, {0.9+0.12*(\x-3)*(\x-3)}) node[below right] {$r_D$};
    \draw[very thick, dashed] plot[domain=0:6, samples=80] (\x, {(1.6+0.05*\x+0.06*\x*\x + \x*(\x<3 ? 0.9 : 0.9+0.12*(\x-3)*(\x-3)))/(1+\x)}) node[above right] {$r_{\text{WACC}}$};
    \draw[dotted] (3,1.2475) -- (3,0) node[below] {$L^{*}$};
  \end{scope}
  % (b) MODIGLIANI y MILLER.
  \begin{scope}[xshift=8.6cm, x=1.0cm, y=0.7cm]
    \node[font=\footnotesize\bfseries] at (2.2,7.14) {(b) MODIGLIANI y MILLER};
    \draw[->] (0,0) -- (4.9,0) node[below left, yshift=-2pt] {$D/E$};
    \draw[->] (0,0) -- (0,6.57) node[left] {coste};
    \draw[very thick] (0,1.8) -- (4.2,1.8+4.2) node[right] {$r_E$};
    \draw[very thick, dashed] (0,1.8) -- (4.4,1.8) node[above left] {$r_{\text{WACC}}$};
    \draw[very thick] (0,0.8) -- (4.4,0.8) node[right] {$r_D$};
    \node[left] at (0,1.8) {$r_U$};
  \end{scope}
\end{tikzpicture}
