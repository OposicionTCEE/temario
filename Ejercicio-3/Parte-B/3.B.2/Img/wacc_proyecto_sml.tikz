% Figura: el método sobre la línea del mercado de valores. Bloque 2, apartado «Método: ¿qué procedimiento seguir?».
% SML r = gamma + beta lambda_M (gamma = 1, lambda_M = 1,1; unidades ilustrativas).
%   D: beta_D = 0,1 -> r_D = 1,11. A: beta_A = 1 -> r_A = 2,1.
%   Acciones de C, (D/V)_C = 0,3: beta = (1 - 0,1·0,3)/0,7 = 1,386 -> r = 2,525.
%   Acciones de P, (D/V)_P = 0,6: beta = (1 - 0,1·0,6)/0,4 = 2,35 -> r = 3,585.
%   WACC de P: r_A - T r_D (D/V)_P, por debajo de r_A (1,6, ilustrativo).
% Debajo del eje, los brazos de la palanca con apoyo en beta_A: beta_E - beta_A = (beta_A - beta_D) D/E.
%   Comparable: 0,9 · 0,3/0,7 = 0,386. Proyecto: 0,9 · 0,6/0,4 = 1,35.
% Antes era el panel (b) de wacc_proyecto (separado y ampliado a petición del usuario, 22/10/2026).
% Generar con: bash Code/generar_figura.sh wacc_proyecto_sml
\begin{tikzpicture}[font=\footnotesize, x=4cm, y=1.2cm, >={Stealth[length=4pt]}]
  % Ejes y SML.
  \draw[->] (0,0) -- (2.7,0) node[below left, yshift=-2pt] {$\beta$};
  \draw[->] (0,0) -- (0,4.2) node[left] {$r$};
  \draw[very thick] (0,1) -- (2.6,3.86) node[above right, xshift=-4pt] {SML};
  \node[left] at (0,1) {$\gamma$};
  % Líneas de referencia.
  \foreach \b/\r in {1/2.1, 1.386/2.525, 2.35/3.585} {
    \draw[densely dotted, black!60] (\b,0) -- (\b,\r);
    \draw[densely dotted, black!60] (0,\r) -- (\b,\r);
  }
  \draw[densely dotted, black!60] (0.1,0) -- (0.1,1.11);
  \draw[densely dotted, black!60] (0,1.6) -- (1,1.6);
  \node[left] at (0,2.1) {$r_A$};
  \node[left] at (0,2.525) {$r_E^C$};
  \node[left] at (0,3.585) {$r_E^P$};
  \node[left] at (0,1.6) {$r_{\text{WACC}}^P$};
  \node[below] at (0.1,0) {$\beta_D$};
  \node[below] at (1,0) {$\beta_A$};
  \node[below] at (1.386,0) {$\beta_E^C$};
  \node[below] at (2.35,0) {$\beta_E^P$};
  % Puntos.
  \fill (0.1,1.11) circle (2pt) node[above left] {$D$};
  \fill (1,2.1) circle (2pt) node[above left] {$A$};
  \fill (1.386,2.525) circle (2pt) node[below right] {$E_C$};
  \fill (2.35,3.585) circle (2pt) node[below right] {$E_P$};
  \draw[thick, fill=white] (1,1.6) circle (2pt);
  % (1) desapalancar: de E_C a A, por debajo de la recta.
  \draw[->, thick] (1.37,2.41) to[bend left=35] node[pos=0.5, below, yshift=-1pt] {(1)} (1.05,2.03);
  % (2) reapalancar: de A a E_P, por encima de la recta.
  \draw[->, thick] (0.97,2.24) to[bend left=28] node[pos=0.45, above left] {(2)} (2.31,3.72);
  % (3) recomponer: de A al WACC del proyecto (ahorro fiscal).
  \draw[->, thick] (1,2.0) -- (1,1.7);
  \draw[decorate, decoration={brace, amplitude=3pt}] (1.03,2.08) -- (1.03,1.62)
    node[midway, right, xshift=2pt] {(3) $T\,r_D^P\,(D/V)_P$};
  % Brazos de la palanca (apoyo en beta_A).
  \node[left] at (-0.02,-0.95) {Comparable C};
  \draw[decorate, decoration={brace, amplitude=3pt, mirror}] (0.1,-0.75) -- (1,-0.75)
    node[midway, below, yshift=-2pt] {$\beta_A-\beta_D$};
  \draw[decorate, decoration={brace, amplitude=3pt, mirror}] (1,-0.75) -- (1.386,-0.75)
    node[midway, below, yshift=-2pt] {$(\beta_A-\beta_D)\,(D/E)_C$};
  \node[left] at (-0.02,-1.85) {Proyecto P};
  \draw[decorate, decoration={brace, amplitude=3pt, mirror}] (0.1,-1.65) -- (1,-1.65)
    node[midway, below, yshift=-2pt] {$\beta_A-\beta_D$};
  \draw[decorate, decoration={brace, amplitude=3pt, mirror}] (1,-1.65) -- (2.35,-1.65)
    node[midway, below, yshift=-2pt] {$(\beta_A-\beta_D)\,(D/E)_P$};
  \fill (1,-0.75) ++(0,0.02) -- ++(-0.022,-0.16) -- ++(0.044,0) -- cycle;
  \fill (1,-1.65) ++(0,0.02) -- ++(-0.022,-0.16) -- ++(0.044,0) -- cycle;
\end{tikzpicture}
