% Figura: simulación de Montecarlo de los proyectos A y B. Bloque 1, apartado «Simulación de Montecarlo».
% Distribuciones ilustrativas del VAN simulado (normales): A, media 0,8 y desviación 0,4; B, media 1,8 y desviación 1,6
% (B, mayor y más lento, tiene más VAN esperado y más dispersión).
% (a) Densidades del VAN; punteadas, los VAN esperados; discontinua, VAN = 0.
% (b) Perfiles de riesgo (probabilidad acumulada, aproximada por una logística: Phi(z) ~ 1/(1+exp(-1,702 z))).
%     En VAN = 0 se leen P(VAN_A < 0) ~ 0,02-0,03 y P(VAN_B < 0) ~ 0,13.
% Generar con: bash Code/generar_figura.sh montecarlo_paneles
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  % ---------- (a) Distribución del VAN ----------
  \begin{scope}[x=0.74cm, y=3.6cm]
    \node[font=\footnotesize\bfseries] at (1,1.28) {(a) Distribución del VAN};
    \draw[->] (-3.2,0) -- (5.3,0) node[below left, yshift=-2pt] {$VAN$};
    \draw[dashed] (0,0) -- (0,1.05);
    \node[below] at (0,0) {$0$};
    \draw[very thick] plot[domain=-0.8:2.4, samples=120] (\x, {exp(-(\x-0.8)*(\x-0.8)/(2*0.16))/(0.4*2.5066)});
    \draw[very thick, dashed] plot[domain=-3.2:5.2, samples=120] (\x, {exp(-(\x-1.8)*(\x-1.8)/(2*2.56))/(1.6*2.5066)});
    \node at (1.65,0.75) {$A$};
    \node at (4.1,0.13) {$B$};
    \draw[densely dotted] (0.8,0) -- (0.8,0.997);
    \node[above] at (0.8,0.997) {$\mathbb E[VAN_A]$};
    \draw[densely dotted] (1.8,0) -- (1.8,0.249);
    \node[above right, xshift=-2pt] at (1.8,0.249) {$\mathbb E[VAN_B]$};
  \end{scope}
  % ---------- (b) Perfil de riesgo ----------
  \begin{scope}[xshift=9.0cm, x=0.74cm, y=3.6cm]
    \node[font=\footnotesize\bfseries] at (1,1.28) {(b) Perfil de riesgo};
    \draw[->] (-3.2,0) -- (5.3,0) node[below left, yshift=-2pt] {$VAN$};
    \draw[->] (-3.2,0) -- (-3.2,1.12) node[above right, xshift=-6pt] {probabilidad acumulada};
    \node[left] at (-3.2,1) {$1$};
    \draw[densely dotted] (-3.2,1) -- (5.2,1);
    \draw[dashed] (0,0) -- (0,1.05);
    \node[below] at (0,0) {$0$};
    \draw[very thick] (-3.2,0) -- plot[domain=-1.2:5.2, samples=120] (\x, {1/(1+exp(-1.702*(\x-0.8)/0.4))});
    \draw[very thick, dashed] plot[domain=-3.2:5.2, samples=120] (\x, {1/(1+exp(-1.702*(\x-1.8)/1.6))});
    \node at (0.3,0.62) {$A$};
    \node at (3.0,0.62) {$B$};
    % Probabilidades de VAN negativo.
    \pgfmathsetmacro{\pa}{1/(1+exp(1.702*2))}
    \pgfmathsetmacro{\pb}{1/(1+exp(1.702*1.125))}
    \draw[densely dotted] (-3.2,\pa) -- (0,\pa);
    \draw[densely dotted] (-3.2,\pb) -- (0,\pb);
    \node[left] at (-3.2,\pa) {$P(VAN_A<0)$};
    \node[left] at (-3.2,\pb) {$P(VAN_B<0)$};
  \end{scope}
\end{tikzpicture}
