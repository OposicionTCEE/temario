% Figura: simulación de Montecarlo de los proyectos A y B. Bloque 1, apartado «Simulación de Montecarlo».
% Distribuciones ilustrativas del VAN simulado (normales): A, media 1 y desviación 0,5; B, media 1,2 y desviación 1,4
% (B, mayor y más lento, tiene más VAN esperado y más dispersión).
% (a) Densidades del VAN; punteadas, los VAN esperados; discontinua, VAN = 0.
% (b) Perfiles de riesgo (probabilidad acumulada, aproximada por una logística: Phi(z) ~ 1/(1+exp(-1,702 z))).
%     En VAN = 0 se leen P(VAN_A < 0) ~ 0,03 y P(VAN_B < 0) ~ 0,19.
% Generar con: bash Code/generar_figura.sh montecarlo_paneles
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  % ---------- (a) Distribución del VAN ----------
  \begin{scope}[x=0.82cm, y=4.6cm]
    \node[font=\footnotesize\bfseries] at (1,0.98) {(a) Distribución del VAN};
    \draw[->] (-3.2,0) -- (5.3,0) node[below left, yshift=-2pt] {$VAN$};
    \draw[dashed] (0,0) -- (0,0.85);
    \node[below] at (0,0) {$0$};
    \draw[very thick] plot[domain=-1:3, samples=120] (\x, {exp(-(\x-1)*(\x-1)/(2*0.25))/(0.5*2.5066)});
    \draw[very thick, dashed] plot[domain=-3.2:5.2, samples=120] (\x, {exp(-(\x-1.2)*(\x-1.2)/(2*1.96))/(1.4*2.5066)});
    \node at (1.75,0.72) {$A$};
    \node at (3.6,0.17) {$B$};
    \draw[densely dotted] (1,0) -- (1,0.798);
    \draw[densely dotted] (1.2,0) -- (1.2,0.285);
    \node[below] at (0.75,-0.005) {$\mathbb E[VAN_A]$};
    \node[below] at (2.6,-0.005) {$\mathbb E[VAN_B]$};
  \end{scope}
  % ---------- (b) Perfil de riesgo ----------
  \begin{scope}[xshift=9.6cm, x=0.82cm, y=3.6cm]
    \node[font=\footnotesize\bfseries] at (1,1.25) {(b) Perfil de riesgo};
    \draw[->] (-3.2,0) -- (5.3,0) node[below left, yshift=-2pt] {$VAN$};
    \draw[->] (-3.2,0) -- (-3.2,1.12) node[above] {probabilidad acumulada};
    \node[left] at (-3.2,1) {$1$};
    \draw[densely dotted] (-3.2,1) -- (5.2,1);
    \draw[dashed] (0,0) -- (0,1.05);
    \node[below] at (0,0) {$0$};
    \draw[very thick] plot[domain=-3.2:5.2, samples=120] (\x, {1/(1+exp(-1.702*(\x-1)/0.5))});
    \draw[very thick, dashed] plot[domain=-3.2:5.2, samples=120] (\x, {1/(1+exp(-1.702*(\x-1.2)/1.4))});
    \node at (1.75,0.55) {$A$};
    \node at (3.3,0.62) {$B$};
    % Probabilidades de VAN negativo.
    \pgfmathsetmacro{\pa}{1/(1+exp(1.702*2))}
    \pgfmathsetmacro{\pb}{1/(1+exp(1.702*1.2/1.4))}
    \draw[densely dotted] (-3.2,\pa) -- (0,\pa);
    \draw[densely dotted] (-3.2,\pb) -- (0,\pb);
    \node[left] at (-3.2,\pa) {$P(VAN_A<0)$};
    \node[left] at (-3.2,\pb) {$P(VAN_B<0)$};
  \end{scope}
\end{tikzpicture}
