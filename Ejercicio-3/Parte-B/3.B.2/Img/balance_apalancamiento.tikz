% Figura: el mismo negocio con poca y con mucha deuda (balance a valor de mercado).
% Bloque 2, apartado «Riesgo de los activos: desapalancar y reapalancar la beta».
% Altura de cada caja = valor (V = E + D, igual en los dos paneles). Intensidad del gris = riesgo sistemático por euro:
%   activos, el mismo en (a) y (b) (beta_A); deuda casi sin riesgo (beta_D ~ 0, en blanco);
%   recursos propios: beta_E = beta_A (1 + D/E), mayor cuanto mayor es D/E -> gris más oscuro en (b).
%   (a) D/E = 1/3 (E = 3, D = 1); (b) D/E = 2 (E = 4/3, D = 8/3). Unidades ilustrativas.
% Generar con: bash Code/generar_figura.sh balance_apalancamiento
\begin{tikzpicture}[font=\footnotesize, x=1cm, y=1cm,
    caja/.style={draw, thick, minimum width=2.6cm, align=center, inner sep=2pt}]
  \foreach \px/\alto/\gris/\titulo in {0/3/30/{(a) Poca deuda}, 8.2/1.333/52/{(b) Mucha deuda}} {
    \begin{scope}[xshift=\px cm]
      \node[font=\footnotesize\bfseries] at (2.75,4.75) {\titulo};
      \node at (1.3,4.25) {Activos};
      \node at (4.2,4.25) {Financiación};
      % Activos: el negocio entero.
      \fill[black!22] (0,0) rectangle (2.6,4);
      \draw[thick] (0,0) rectangle (2.6,4);
      \node[align=center] at (1.3,2) {$V$\\[2pt]$\beta_A$,\ $r_A$};
      % Recursos propios (arriba) y deuda (abajo).
      \pgfmathsetmacro{\corte}{4-\alto}
      \fill[black!\gris] (2.9,\corte) rectangle (5.5,4);
      \draw[thick] (2.9,\corte) rectangle (5.5,4);
      \node[align=center] at (4.2,{(4+\corte)/2}) {$E$\\[1pt]$\beta_E$,\ $r_E$};
      \draw[thick] (2.9,0) rectangle (5.5,\corte);
      \node[align=center] at (4.2,{\corte/2}) {$D$\\[1pt]$\beta_D\approx 0$,\ $r_D$};
      % V = E + D.
      \draw[decorate, decoration={brace, amplitude=4pt, mirror}] (2.9,-0.12) -- (5.5,-0.12)
        node[midway, below, yshift=-3pt] {$V=E+D$};
    \end{scope}
  }
  \node at (11.35,-1.05) {$\beta_A$ igual, \ $\beta_E^{(b)}>\beta_E^{(a)}$};
\end{tikzpicture}
