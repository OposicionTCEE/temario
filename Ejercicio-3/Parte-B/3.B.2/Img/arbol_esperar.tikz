% Figura: árbol de decisión del proyecto A con demanda incierta. Bloque 1, apartado «¿Cuánto vale la información?».
% (a) Invertir hoy: nodo de decisión en t = 0; si se invierte (-I_A), la naturaleza elige CF+ (p) o CF- (1-p) en t = 1.
% (b) Esperar: la naturaleza revela la demanda en t = 1 y la empresa decide entonces; invierte solo si la demanda es alta
%     (ramas elegidas en trazo grueso) y cobra en t = 2.
% Cuadrados: nodos de decisión; círculos: nodos de azar. Sin cifras.
% Generar con: bash Code/generar_figura.sh arbol_esperar
\begin{tikzpicture}[font=\footnotesize,
    dec/.style={draw, fill=black!12, minimum size=7pt, inner sep=0pt},
    azar/.style={draw, circle, fill=black!12, minimum size=7pt, inner sep=0pt},
    elegida/.style={very thick}, descartada/.style={thin, black!55}]
  % (a) Invertir hoy.
  \node[font=\footnotesize\bfseries] at (2.5,2.45) {(a) Invertir hoy};
  \node[dec] (d0) at (0,0) {};
  \node[azar] (c) at (2.6,0.9) {};
  \draw[elegida] (d0) -- node[above left] {invertir} node[below right, pos=0.55] {$-I_A$} (c);
  \draw[descartada] (d0) -- node[below left] {no invertir} (2.6,-1.2) node[right, black] {$0$};
  \draw[elegida] (c) -- node[above left] {$p$} (5,1.7) node[right] {$CF^+$};
  \draw[elegida] (c) -- node[below left] {$1-p$} (5,0.1) node[right] {$CF^-$};
  \node[black!60] at (0,-2.05) {$t=0$};
  \node[black!60] at (5,-2.05) {$t=1$};
  % (b) Esperar a conocer la demanda.
  \begin{scope}[xshift=8.6cm]
    \node[font=\footnotesize\bfseries] at (2.5,2.45) {(b) Esperar};
    \node[azar] (n) at (0,0) {};
    \node[dec] (da) at (2.4,1.1) {};
    \node[dec] (db) at (2.4,-1.1) {};
    \draw[elegida] (n) -- node[above left] {$p$} (da);
    \draw[elegida] (n) -- node[below left] {$1-p$} (db);
    \draw[elegida] (da) -- node[above] {$-I_A$} (5,1.75) node[right] {$CF^+$};
    \draw[descartada] (da) -- (5,0.55) node[right, black] {$0$};
    \draw[descartada] (db) -- node[below] {$-I_A$} (5,-0.55) node[right, black] {$CF^-$};
    \draw[elegida] (db) -- (5,-1.75) node[right] {$0$};
    \node[black!60] at (0,-2.05) {$t=0$};
    \node[black!60] at (2.4,-2.05) {$t=1$};
    \node[black!60] at (5,-2.05) {$t=2$};
  \end{scope}
\end{tikzpicture}
