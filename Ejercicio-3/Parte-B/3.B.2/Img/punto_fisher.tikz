% Figura: el punto de FISHER con el ejemplo conductor. Bloque 1, apartado «El punto de FISHER».
% A: inversión 1, flujo 1,8 al cabo de un periodo: VAN_A = -1 + 1,8/(1+r); TIR_A = 0,8.
% B: inversión 3, flujo 5 al cabo de dos periodos: VAN_B = -3 + 5/(1+r)^2; TIR_B = sqrt(5/3) - 1 = 0,291.
% Proyecto diferencial B - A: -2, -1,8, +5; su TIR es la tasa de FISHER, r_F = 0,194 (VAN común 0,508).
% Valores ilustrativos; en la figura solo se rotulan las tasas.
% Generar con: bash Code/generar_figura.sh punto_fisher
\begin{tikzpicture}[x=10cm, y=1.45cm, font=\footnotesize, >={Stealth[length=4pt]}]
  \draw[->] (0,0) -- (1.08,0) node[below left, yshift=-2pt] {$r$};
  \draw[->] (0,-1.9) -- (0,2.3) node[left] {$VAN$};
  % Perfiles de A, B y del proyecto diferencial.
  \draw[very thick] plot[domain=0:1, samples=80] (\x, {-1+1.8/(1+\x)}) node[right] {$VAN_A$};
  \draw[very thick, black!55] plot[domain=0:1, samples=80] (\x, {-3+5/((1+\x)*(1+\x))}) node[right] {$VAN_B$};
  \draw[thick, dashed] plot[domain=0:0.62, samples=80] (\x, {-2-1.8/(1+\x)+5/((1+\x)*(1+\x))}) node[below] {$VAN_{B-A}$};
  % Tasa de FISHER y TIR.
  \draw[densely dotted] (0.194,0) -- (0.194,0.508);
  \fill (0.194,0.508) circle (1.6pt);
  \fill (0.194,0) circle (1.6pt);
  \node[below left] at (0.194,0) {$r_F$};
  \fill[black!55] (0.291,0) circle (1.6pt);
  \node[above right, black!55] at (0.291,0) {$TIR_B$};
  \fill (0.8,0) circle (1.6pt);
  \node[above right] at (0.8,0) {$TIR_A$};
\end{tikzpicture}
