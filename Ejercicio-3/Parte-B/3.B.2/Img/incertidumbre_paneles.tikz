% Figura: medir la incertidumbre del proyecto A. Bloque 1, apartado «Medir la incertidumbre en cualquier contexto».
% (a) Análisis de sensibilidad (diagrama de tornado): cada barra es el intervalo del VAN al variar una sola variable
%     entre su valor pesimista y optimista, con las demás en su valor central; línea gruesa: VAN central; discontinua: VAN = 0.
%     Intervalos ilustrativos (escala del VAN): CF [-0,6; 1,6], p [-0,2; 1,2], r [0,1; 0,9], I_A [0,2; 0,8]; central 0,5.
% (b) Simulación de Montecarlo: densidad del VAN (normal de media 1 y desviación 0,63, ilustrativa); sombreado, P(VAN < 0).
% Generar con: bash Code/generar_figura.sh incertidumbre_paneles
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  % (a) Sensibilidad.
  \begin{scope}[x=2.2cm, y=0.62cm]
    \node[font=\footnotesize\bfseries] at (0.5,5.3) {(a) Sensibilidad};
    \foreach \y/\nom/\lo/\hi in {4/{$CF$}/-0.6/1.6, 3/{$p$}/-0.2/1.2, 2/{$r$}/0.1/0.9, 1/{$I_A$}/0.2/0.8} {
      \fill[black!25] (\lo,\y-0.32) rectangle (\hi,\y+0.32);
      \draw (\lo,\y-0.32) rectangle (\hi,\y+0.32);
      \node[left] at (-0.75,\y) {\nom};
    }
    \draw[->] (-0.75,0.2) -- (1.85,0.2) node[below left, yshift=-2pt] {$VAN$};
    \draw[dashed] (0,0.2) -- (0,4.7);
    \node[below] at (0,0.2) {$0$};
    \draw[very thick] (0.5,0.2) -- (0.5,4.7);
    \node[below] at (0.5,0.2) {$VAN_0$};
  \end{scope}
  % (b) Montecarlo.
  \begin{scope}[xshift=9.0cm, x=1.35cm, y=4.2cm]
    \node[font=\footnotesize\bfseries] at (1,0.86) {(b) Montecarlo};
    \fill[black!25] plot[domain=-1.2:0, samples=40] (\x, {exp(-(\x-1)*(\x-1)/0.8)}) -- (0,0) -- (-1.2,0) -- cycle;
    \draw[very thick] plot[domain=-1.2:3.2, samples=100] (\x, {exp(-(\x-1)*(\x-1)/0.8)});
    \draw[->] (-1.3,0) -- (3.4,0) node[below left, yshift=-2pt] {$VAN$};
    \draw[dashed] (0,0) -- (0,0.75);
    \node[below] at (0,0) {$0$};
    \draw[densely dotted] (1,0) -- (1,1);
    \node[below] at (1,0) {$\mathbb E[VAN]$};
    \node[left] at (-0.25,0.42) {$P(VAN<0)$};
    \draw[->] (-0.55,0.36) -- (-0.3,0.1);
  \end{scope}
\end{tikzpicture}
