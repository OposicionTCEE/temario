% Figura: el perfil del VAN, VAN(r), según el calendario de signos de los flujos. Bloque 1, apartado «El perfil del VAN».
% (a) Proyecto convencional (-, +): -3 + 5/(1+r)^2; una TIR = sqrt(5/3) - 1 = 0,291. Eje r de 0 a 1,2.
% (b) Proyecto con un coste final (-, +, -), como la bomba de LORIE y SAVAGE (1955): -1 + 6,25/(1+r) - 6,25/(1+r)^2;
%     dos TIR, 0,25 y 4; máximo 0,5625 en r = 1. Eje r de 0 a 6.
% (c) Proyecto con anticipo (+, -, +): 1 - 3/(1+r) + 2,5/(1+r)^2; positivo para todo r (mínimo 0,1 en r = 2/3). Eje r de 0 a 3.
% Valores ilustrativos; en la figura solo se rotulan las TIR.
% Generar con: bash Code/generar_figura.sh perfil_van
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  % (a) Convencional.
  \begin{scope}[x=3.6cm, y=0.62cm]
    \node[font=\footnotesize\bfseries] at (0.6,3.3) {(a) Flujos $-,\,+$};
    \draw[->] (0,0) -- (1.3,0) node[below left, yshift=-2pt] {$r$};
    \draw[->] (0,-3.1) -- (0,2.9) node[left] {$VAN$};
    \draw[very thick] plot[domain=0:1.2, samples=60] (\x, {-3+5/((1+\x)*(1+\x))});
    \fill (0.291,0) circle (1.6pt);
    \node[above right] at (0.291,0) {$TIR$};
  \end{scope}
  % (b) Dos TIR.
  \begin{scope}[xshift=5.6cm, x=0.65cm, y=1.9cm]
    \node[font=\footnotesize\bfseries] at (3.2,1.08) {(b) Flujos $-,\,+,\,-$};
    \draw[->] (0,0) -- (6.4,0) node[below left, yshift=-2pt] {$r$};
    \draw[->] (0,-1.01) -- (0,0.95) node[left] {$VAN$};
    \draw[very thick] plot[domain=0:6, samples=150] (\x, {-1+6.25/(1+\x)-6.25/((1+\x)*(1+\x))});
    \fill (0.25,0) circle (1.6pt); \fill (4,0) circle (1.6pt);
    \node[below right] at (0.25,0) {$TIR_1$};
    \node[above right] at (4,0) {$TIR_2$};
  \end{scope}
  % (c) Sin TIR.
  \begin{scope}[xshift=11.2cm, x=1.3cm, y=1.65cm]
    \node[font=\footnotesize\bfseries] at (1.6,1.24) {(c) Flujos $+,\,-,\,+$};
    \draw[->] (0,0) -- (3.4,0) node[below left, yshift=-2pt] {$r$};
    \draw[->] (0,-1.16) -- (0,1.1) node[left] {$VAN$};
    \draw[very thick] plot[domain=0:3, samples=80] (\x, {1-3/(1+\x)+2.5/((1+\x)*(1+\x))});
  \end{scope}
\end{tikzpicture}
