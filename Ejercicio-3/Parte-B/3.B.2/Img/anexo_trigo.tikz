% Figura del anexo: opción de no cuidar el cultivo (siembra de trigo; unidades monetarias).
% (a) Sin flexibilidad: invertir 1.000; clima bueno (0,8) 2.500, malo (0,2) -200; E(VAN) = 960 frente a 0 de no invertir.
% (b) Con flexibilidad: tras conocer el clima se decide cuidar el cultivo o no; con clima malo, no hacerlo evita -200.
%     E(VAN) = -1.000 + 0,8 x 2.500 = 1.000. Valor de la opción: 40.
% Generar con: bash Code/generar_figura.sh anexo_trigo
\begin{tikzpicture}[font=\footnotesize,
    dec/.style={draw, fill=black!12, minimum size=7pt, inner sep=0pt},
    azar/.style={draw, circle, fill=black!12, minimum size=7pt, inner sep=0pt},
    elegida/.style={very thick}, descartada/.style={thin, black!55}]
  % (a)
  \node[font=\footnotesize\bfseries] at (2.4,1.9) {(a) Sin flexibilidad};
  \node[dec] (d) at (0,0) {};
  \node[azar] (c) at (2.4,0.6) {};
  \draw[elegida] (d) -- node[above left] {invertir} node[below right, pos=0.6] {$-1.000$} (c);
  \draw[descartada] (d) -- node[below left] {no invertir} (2.4,-1.2) node[right, black] {$0$};
  \draw (c) -- node[above left] {$0,8$} (4.8,1.3) node[right] {$2.500$};
  \draw (c) -- node[below left] {$0,2$} (4.8,-0.1) node[right] {$-200$};
  % (b)
  \begin{scope}[xshift=8.4cm]
    \node[font=\footnotesize\bfseries] at (2.6,1.9) {(b) Con flexibilidad};
    \node[dec] (d) at (0,0) {};
    \node[azar] (c) at (2.2,0.6) {};
    \node[dec] (g) at (3.9,1.25) {};
    \node[dec] (b) at (3.9,-0.05) {};
    \draw[elegida] (d) -- node[above left] {invertir} node[below right, pos=0.6] {$-1.000$} (c);
    \draw[descartada] (d) -- node[below left] {no invertir} (2.2,-1.2) node[right, black] {$0$};
    \draw (c) -- node[above left] {$0,8$} (g);
    \draw (c) -- node[below left] {$0,2$} (b);
    \draw[elegida] (g) -- (5.6,1.6) node[right] {$2.500$};
    \draw[descartada] (g) -- (5.6,0.95) node[right, black] {$0$};
    \draw[descartada] (b) -- (5.6,0.3) node[right, black] {$-200$};
    \draw[elegida] (b) -- (5.6,-0.4) node[right] {$0$};
  \end{scope}
\end{tikzpicture}
