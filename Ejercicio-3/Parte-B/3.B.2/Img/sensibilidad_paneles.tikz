% Figura: análisis de sensibilidad del proyecto A. Bloque 1, apartado «Análisis de sensibilidad».
% VAN_A = -I_A + [p CF+ + (1-p) CF-]/(1+r) (proyecto A con flujo incierto, como en el árbol de decisión).
% (a) Punto muerto: VAN_A en función de p, con las demás variables en su valor central (recta: -1,2 + 2,4 p).
%     Se anula en p* = 0,5; valor central p0 = 0,7 (VAN0 = 0,48). Unidades ilustrativas.
% (b) Diagrama de tornado: intervalo del VAN_A al mover cada variable entre su valor pesimista y optimista,
%     ordenadas por amplitud: p [-0,24; 1,2], CF+ [-0,3; 1,1], r [0,1; 0,8], CF- [0,2; 0,75], I_A [0,25; 0,7].
%     Las barras que cruzan VAN = 0 son las que pueden cambiar la decisión.
% Generar con: bash Code/generar_figura.sh sensibilidad_paneles
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  % ---------- (a) Punto muerto ----------
  \begin{scope}[x=5.6cm, y=1.45cm]
    \node[font=\footnotesize\bfseries] at (0.5,1.95) {(a) Punto muerto};
    \draw[->] (0,0) -- (1.12,0) node[below left, yshift=-2pt] {$p$};
    \draw[->] (0,-1.4) -- (0,1.6) node[left] {$VAN_A$};
    \draw[very thick] (0,-1.2) -- (1,1.2) node[right] {$VAN_A(p)$};
    \node[left] at (0,0) {$0$};
    \draw[densely dotted] (1,0) -- (1,1.2);
    \node[below] at (1,0) {$1$};
    % Punto muerto y valor central.
    \fill (0.5,0) circle (1.8pt);
    \node[below right] at (0.5,0) {$p^*$};
    \draw[densely dotted] (0.7,0) -- (0.7,0.48) -- (0,0.48);
    \fill (0.7,0.48) circle (1.8pt);
    \node[below] at (0.7,0) {$p_0$};
    \node[left] at (0,0.48) {$VAN_0$};
    \draw[decorate, decoration={brace, amplitude=4pt}] (0.5,0.06) -- (0.7,0.06)
      node[midway, above, yshift=3pt] {margen};
  \end{scope}
  % ---------- (b) Diagrama de tornado ----------
  \begin{scope}[xshift=9.4cm, x=3.1cm, y=0.62cm]
    \node[font=\footnotesize\bfseries] at (0.45,6.75) {(b) Diagrama de tornado};
    \foreach \y/\nom/\lo/\hi in {5/{$p$}/-0.24/1.2, 4/{$CF^+$}/-0.3/1.1, 3/{$r$}/0.1/0.8, 2/{$CF^-$}/0.2/0.75, 1/{$I_A$}/0.25/0.7} {
      \fill[black!25] (\lo,\y-0.32) rectangle (\hi,\y+0.32);
      \draw (\lo,\y-0.32) rectangle (\hi,\y+0.32);
      \node[left] at (-0.45,\y) {\nom};
    }
    \draw[->] (-0.45,0.2) -- (1.4,0.2) node[below left, yshift=-2pt] {$VAN_A$};
    \draw[dashed] (0,0.2) -- (0,5.7);
    \node[below] at (0,0.2) {$0$};
    \draw[very thick] (0.48,0.2) -- (0.48,5.7);
    \node[below] at (0.48,0.2) {$VAN_0$};
  \end{scope}
\end{tikzpicture}
