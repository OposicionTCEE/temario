\begin{tikzpicture}[
  font=\footnotesize,
  x=0.88cm, y=0.72cm,
  caja/.style={draw=black!70, rounded corners=1.5pt, align=left, inner sep=4pt},
  et/.style={font=\scriptsize, align=center, inner sep=1.5pt},
  flecha/.style={-{Latex[length=4.5pt]}, draw=black!65, line width=0.5pt}
]

% ---- ejes ----
\draw[black!75, -{Latex[length=5pt]}] (0,0) -- (0,10.3) node[anchor=south east, font=\scriptsize] {$e$};
\draw[black!75, -{Latex[length=5pt]}] (0,0) -- (10.4,0) node[anchor=north east, font=\scriptsize] {divisas};
\node[et, anchor=east, text width=1.5cm] at (-0.15,9.2) {tipo de cambio};

% ---- curvas ----
\draw[black, line width=0.9pt] (1,1) -- (9.3,9.3) node[anchor=south west, font=\scriptsize] {$S$};
\draw[black, line width=0.9pt] (1,9) -- (9.3,0.7) node[anchor=north west, font=\scriptsize] {$D_0$};
\draw[black!70, dashed, line width=0.8pt] (1,5) -- (5.3,0.7) node[anchor=north west, font=\scriptsize] {$D_1$};

% ---- paridad y puntos ----
\draw[black!70, dotted, line width=0.7pt] (0,3) -- (7,3);
\node[et, anchor=east] at (-0.1,3) {$e_0$};
\draw[black!70, dotted, line width=0.7pt] (0,5) -- (5,5);
\node[et, anchor=east] at (-0.1,5) {$e_1$};
\draw[black!70, dotted, line width=0.7pt] (3,0) -- (3,3);
\draw[black!70, dotted, line width=0.7pt] (7,0) -- (7,3);
\draw[black!70, dotted, line width=0.7pt] (5,0) -- (5,5);

\fill[black] (3,3) circle (2.2pt); \node[et, anchor=south east] at (3.0,3.15) {$A\,(=E_2)$};
\fill[black] (7,3) circle (2.2pt); \node[et, anchor=south west] at (7.1,3.1) {$B$};
\fill[black] (5,5) circle (2.2pt); \node[et, anchor=south west] at (5.1,5.1) {$E_1$};

% ---- brecha ----
\draw[{Latex[length=4pt]}-{Latex[length=4pt]}, black, line width=0.8pt] (3.15,2.3) -- (6.85,2.3);
\node[et, anchor=north, fill=white] at (5,2.3) {\textbf{brecha}};

% ---- movimientos ----
\draw[flecha] (0.4,3.15) -- (0.4,4.85);
\draw[flecha] (6.2,6.0) -- (4.0,4.3);
\node[et, anchor=west, text width=1.7cm] at (6.3,6.2) {$D_0\to D_1$};

% ---- explicación ----
\node[caja, text width=4.15cm, fill=black!8, anchor=north west] at (10.9,10.0)
  {\textbf{Margen 1: el precio}\\[2pt] {\scriptsize La moneda se devalúa, $e_0\to e_1$, y el mercado se vacía en $E_1$. \textbf{Si todos devalúan a la vez, nadie gana competitividad} y solo queda la desconfianza}};

\node[caja, text width=4.4cm, fill=black!8, anchor=north west] at (11.0,6.3)
  {\textbf{Margen 2: la cantidad}\\[2pt] {\scriptsize Cae el gasto, $D_0\to D_1$, y el mercado se vacía en $E_2$ sin mover el precio. Si nadie decide el recorte, lo impone la recesión: \textbf{es el ajuste por el paro}}};

\node[caja, text width=4.4cm, fill=black!16, draw=black, line width=0.6pt, anchor=north west] at (11.0,2.6)
  {\textbf{El margen que falta: financiar}\\[2pt] {\scriptsize Cubrir $A\,$-$\,B$ con reservas ajenas no cierra la brecha: compra tiempo para que actúen los otros dos. \textbf{Nadie puede dárselo a sí mismo}, y ese es el hueco que viene a llenar el Fondo}};
\end{tikzpicture}
