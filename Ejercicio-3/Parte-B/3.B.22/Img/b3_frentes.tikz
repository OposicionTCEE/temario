\begin{tikzpicture}[
  font=\footnotesize,
  cel/.style={draw=black!70, align=left, inner sep=4pt, text width=4.0cm, minimum height=2.5cm, anchor=north west},
  cab/.style={draw=black, line width=0.6pt, align=center, inner sep=4pt, text width=4.0cm, fill=black!18, anchor=north west},
  fila/.style={align=center, inner sep=3pt, text width=2.3cm, anchor=north west, font=\footnotesize\bfseries}
]

\def\xa{2.6} \def\xb{6.85} \def\xc{11.1}

\node[cab] at (\xa,0.9) {\textbf{Legitimidad}\\[-1pt] {\scriptsize ¿quién manda aquí?}};
\node[cab] at (\xb,0.9) {\textbf{Eficacia}\\[-1pt] {\scriptsize ¿funciona lo que hace?}};
\node[cab] at (\xc,0.9) {\textbf{Relevancia}\\[-1pt] {\scriptsize ¿hace falta?}};

\node[fila] at (0,-0.5) {La acusación};
\node[cel, fill=white] at (\xa,-0.3) {{\scriptsize Gobierna según la economía mundial de hace quince años: la cuota de China casi duplicaría su peso real, y Estados Unidos veta en solitario toda reforma}};
\node[cel, fill=white] at (\xb,-0.3) {{\scriptsize Sus programas contraen la actividad, su condicionalidad no ha cambiado de fondo y sus previsiones yerran siempre en la misma dirección}};
\node[cel, fill=white] at (\xc,-0.3) {{\scriptsize Cada vez menos países quieren un programa, y los que pueden se protegen con reservas, canjes y acuerdos regionales}};

\node[fila] at (0,-3.2) {La evidencia};
\node[cel, fill=black!5] at (\xa,-3.0) {{\scriptsize La 16.ª revisión sube todas las cuotas por igual y aplaza el realineamiento; la decimoquinta terminó sin aumento alguno}};
\node[cel, fill=black!5] at (\xb,-3.0) {{\scriptsize El saldo exterior mejora casi siempre; el crecimiento cae a corto plazo; el efecto catalítico es débil, y lo que más predice el éxito es la propiedad local}};
\node[cel, fill=black!5] at (\xc,-3.0) {{\scriptsize Sus recursos pierden peso frente al PIB y a los pasivos exteriores del mundo, y su crédito vivo se concentra en muy pocos países}};

\node[fila] at (0,-5.9) {La defensa};
\node[cel, fill=black!12] at (\xa,-5.7) {{\scriptsize Ninguna institución reparte poder sin que alguien lo ceda, y el reparto vigente lo fijan sus accionistas, no su personal}};
\node[cel, fill=black!12] at (\xb,-5.7) {{\scriptsize El contrafactual no es un mundo tranquilo, sino el mismo país sin financiación: casi siempre, peor}};
\node[cel, fill=black!12] at (\xc,-5.7) {{\scriptsize Es la única capa universal: las demás dependen de con quién se lleve bien cada país}};

\node[draw=black, line width=0.6pt, rounded corners=1.5pt, align=center, inner sep=5pt, text width=15.0cm, fill=black!5, anchor=north west] at (0,-8.6)
  {\textbf{Los tres frentes no pesan igual.} El de la eficacia admite matices y el de la relevancia depende de cómo evolucione la red de seguridad; el de la legitimidad, en cambio, \textbf{no tiene respuesta técnica}: es un problema de reparto de poder que solo puede resolver quien tendría que ceder, y eso explica por qué los otros dos no terminan de cerrarse.};
\end{tikzpicture}
