\begin{tikzpicture}[
  font=\footnotesize,
  y=0.0062cm,
  caja/.style={draw=black!70, rounded corners=1.5pt, align=center, inner sep=4pt},
  et/.style={font=\scriptsize, align=center},
  flecha/.style={-{Latex[length=4.5pt]}, draw=black!65, line width=0.5pt}
]

% --- Hoy ---
\def\xa{0}
\fill[black!18, draw=black!70] (\xa-1.45,0) rectangle (\xa+1.45,476);
\fill[black!8, draw=black!70]  (\xa-1.45,476) rectangle (\xa+1.45,840);
\fill[white, draw=black!70]    (\xa-1.45,840) rectangle (\xa+1.45,977);
\node[et] at (\xa,238) {\textbf{Cuotas}\\ $476$};
\node[et] at (\xa,658) {\textbf{NAP}\\ $364$};
\node[et] at (\xa,908) {\textbf{Bilaterales}\\ $137$};
\node[align=center] at (\xa,1105) {\textbf{Hoy}\\[-2pt] {\scriptsize propios: $49\%$}};

% --- Tras la 16.ª ---
\def\xb{4.2}
\fill[black!18, draw=black!70] (\xb-1.45,0) rectangle (\xb+1.45,716);
\fill[black!8, draw=black!70]  (\xb-1.45,716) rectangle (\xb+1.45,1019);
\node[et] at (\xb,358) {\textbf{Cuotas}\\ $716$};
\node[et] at (\xb,868) {\textbf{NAP}\\ $303$};
\node[align=center] at (\xb,1145) {\textbf{Tras la 16.ª revisión}\\[-2pt] {\scriptsize propios: $70\%$}};

\draw[flecha] (\xa+1.7,500) -- (\xb-1.7,500);

\node[caja, text width=7.6cm, fill=black!5, anchor=west] at (6.2,780)
  {\textbf{Tres capas, muy distintas.} Las \textbf{cuotas} son permanentes y de los $191$ miembros. Los \textbf{Nuevos Acuerdos de Préstamo} son líneas de unos cuarenta países que hay que activar con su consentimiento. Los \textbf{bilaterales} se renuevan uno a uno y llevan provisionales desde 2012};

\node[caja, text width=7.6cm, fill=black!12, draw=black, line width=0.6pt, anchor=west] at (6.2,250)
  {\textbf{La 16.ª revisión no agranda el Fondo: cambia la naturaleza de su dinero.} La capacidad total se queda en torno al billón de dólares, pero lo permanente y de todos pasa del $49\%$ a cerca del $70\%$, y la institución deja de depender de que unos pocos acreedores renueven sus líneas};

\node[et, anchor=north west] at (-1.6,-90) {Miles de millones de DEG.};
\end{tikzpicture}
