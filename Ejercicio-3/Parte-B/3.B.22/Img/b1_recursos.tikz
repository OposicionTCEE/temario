% Cuerpo, bloque 1 — Las tres capas de recursos del Fondo, hoy y tras la 16.ª revisión general de cuotas.
\begin{tikzpicture}[>={Stealth[length=2.2mm]}, every node/.style={font=\footnotesize}, y=0.0058cm]

  % ---- eje ----
  \draw[->] (-1.9,0) -- (-1.9,1130) node[above=2pt, align=center]{\scriptsize miles de millones\\[-2pt]\scriptsize de DEG};
  \foreach \y in {0,250,500,750,1000} {
    \draw (-1.95,\y) -- (-1.9,\y);
    \node[anchor=east, font=\scriptsize] at (-2.0,\y) {$\y$};
  }

  % ---- hoy ----
  \fill[gray!45, draw=black] (-1.1,0) rectangle (1.1,476);
  \fill[gray!20, draw=black] (-1.1,476) rectangle (1.1,840);
  \fill[white, draw=black]   (-1.1,840) rectangle (1.1,977);
  \node at (0,238) {Cuotas};
  \node at (0,658) {NAP};
  \node[font=\scriptsize] at (0,908) {bilaterales};
  \node[anchor=south] at (0,1010) {\textbf{hoy}};

  % ---- tras la 16.ª ----
  \fill[gray!45, draw=black] (3.3,0) rectangle (5.5,716);
  \fill[gray!20, draw=black] (3.3,716) rectangle (5.5,1019);
  \node at (4.4,358) {Cuotas};
  \node at (4.4,868) {NAP};
  \node[anchor=south, align=center] at (4.4,1050) {\textbf{tras la 16.ª}\\[-2pt]\textbf{revisión}};

  % ---- flecha ----
  \draw[->, thick] (1.45,500) -- (2.95,500);

  % ---- lo propio frente a lo prestado ----
  \draw[decorate, decoration={brace, amplitude=4pt}] (1.25,476) -- (1.25,0);
  \node[anchor=west, font=\scriptsize] at (1.35,238) {$49\%$ propio};
  \draw[decorate, decoration={brace, amplitude=4pt}] (5.65,716) -- (5.65,0);
  \node[anchor=west, font=\scriptsize] at (5.75,358) {$70\%$ propio};
\end{tikzpicture}
