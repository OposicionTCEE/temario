% Cuerpo, bloque 3 — Eje cronologico: los objetos sucesivos del Fondo y los dos tramos
% en que se quedo sin ninguno.
\begin{tikzpicture}[>={Stealth[length=2.2mm]}, every node/.style={font=\footnotesize}]

  % ---- eje del tiempo ----
  \draw[->] (-0.3,0) -- (13.3,0);
  \foreach \x/\a in {0/1944, 4.495/1973, 5.89/1982, 6.975/1989, 10.54/2012, 12.71/hoy} {
    \draw (\x,-0.09) -- (\x,0.09);
    \node[anchor=north, font=\scriptsize] at (\x,-0.12) {\a};
  }

  % ---- los objetos ----
  \fill[gray!30, draw=black] (0,0.35) rectangle (4.495,0.95);
  \fill[gray!30, draw=black] (5.89,0.35) rectangle (6.975,0.95);
  \fill[gray!30, draw=black] (7.13,0.35) rectangle (10.54,0.95);
  \draw[gray!65, dashed] (10.70,0.35) rectangle (12.71,0.95);
  \node at (11.70,0.65) {?};

  % ---- rotulos, escalonados ----
  \node[anchor=south, align=center] at (2.25,1.25) {guardián de las paridades};
  \node[anchor=south, align=center, font=\footnotesize\itshape] at (5.19,1.25) {sin oficio};
  \node[anchor=south, align=center] at (8.84,1.25) {bombero de las crisis\\[-2pt]de cuenta financiera};
  \draw[gray!60] (6.43,2.30) -- (6.43,0.98);
  \node[anchor=south, align=center] at (6.43,2.32) {gestor de la crisis\\[-2pt]de deuda};
  \draw[gray!60] (11.70,2.30) -- (11.70,0.98);
  \node[anchor=south, align=center] at (11.70,2.32) {objeto en discusión};
\end{tikzpicture}
