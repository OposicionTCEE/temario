\begin{tikzpicture}[
  font=\footnotesize,
  obj/.style={draw=black!70, rounded corners=1.5pt, align=left, inner sep=4pt, text width=3.3cm, minimum height=3.1cm, anchor=north west},
  et/.style={font=\scriptsize\itshape, align=center, inner sep=2pt, text width=3.3cm},
  flecha/.style={-{Latex[length=5pt]}, draw=black!65, line width=0.7pt}
]

\def\dx{3.75}

\node[obj, fill=black!16] at (0*\dx,0)
  {\textbf{1944-1973}\\ \textbf{Guardián de las paridades}\\[3pt] {\scriptsize Vigila los tipos de cambio declarados y financia desequilibrios temporales.\\[2pt] \textit{Clientela:} todos, y sobre todo Europa}};
\node[obj, fill=black!10] at (1*\dx,0)
  {\textbf{1982-1989}\\ \textbf{Gestor de la crisis de deuda}\\[3pt] {\scriptsize Coordina a los acreedores y organiza el ajuste para evitar el impago en cadena.\\[2pt] \textit{Clientela:} América Latina}};
\node[obj, fill=black!10] at (2*\dx,0)
  {\textbf{1990-2012}\\ \textbf{Gestor de crisis de cuenta financiera}\\[3pt] {\scriptsize Programas grandes y rápidos contra la fuga de capitales.\\[2pt] \textit{Clientela:} emergentes y, al final, la zona del euro}};
\node[obj, fill=black!5] at (3*\dx,0)
  {\textbf{2013-hoy}\\ \textbf{¿?}\\[3pt] {\scriptsize Prevención, deuda de renta baja, clima, bienes públicos globales.\\[2pt] \textit{El objeto está en discusión, y de eso trata este bloque}}};

\draw[flecha] (3.4,-1.55) -- (3.7,-1.55);
\draw[flecha] (7.15,-1.55) -- (7.45,-1.55);
\draw[flecha] (10.9,-1.55) -- (11.2,-1.55);

\node[et, anchor=north] at (1.65,-3.35) {1973: desaparecen las paridades y con ellas el oficio};
\node[et, anchor=north] at (5.4,-3.35) {1989: el Plan Brady cierra la crisis y se acaban los clientes};
\node[et, anchor=north] at (9.15,-3.35) {2008: la crisis devuelve al Fondo al centro};
\node[et, anchor=north] at (12.9,-3.35) {2013: los emergentes se autoaseguran y vuelve la duda};

\node[draw=black, line width=0.6pt, rounded corners=1.5pt, align=center, inner sep=5pt, text width=14.9cm, fill=black!5, anchor=north west] at (0,-4.6)
  {\textbf{Las organizaciones internacionales no suelen sobrevivir a la desaparición de su objeto; el Fondo lo ha hecho tres veces.} La razón no está en su mandato, que quedó sin contenido en 1973, sino en su balance: mientras sea el único que presta cuando ya no presta nadie, encontrará para qué servir.};
\end{tikzpicture}
