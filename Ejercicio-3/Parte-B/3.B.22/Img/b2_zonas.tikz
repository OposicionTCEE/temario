% Cuerpo, bloque 2 — El dictamen de sostenibilidad: tres sendas posibles de la deuda proyectada
% y la consecuencia tasada que cada una lleva aparejada.
\begin{tikzpicture}[>={Stealth[length=2.2mm]}, every node/.style={font=\footnotesize}]
  \draw[->] (0,0) -- (7.2,0) node[below=2pt, pos=0.95]{tiempo};
  \draw[->] (0,0) -- (0,4.9) node[above=2pt, align=center]{deuda\\[-2pt]sobre PIB};

  \fill (0.8,2.6) circle (1.8pt);
  \node[anchor=east] at (0.70,2.6) {hoy};

  \draw[thick] (0.8,2.6) .. controls (3.0,3.2) and (4.6,3.8) .. (6.0,4.4);
  \node[anchor=west, align=left] at (6.12,4.4) {claramente insostenible:\\[-2pt]\scriptsize primero la quita, después el dinero};

  \draw[thick] (0.8,2.6) .. controls (3.0,2.6) and (4.6,2.5) .. (6.0,2.5);
  \node[anchor=west, align=left] at (6.12,2.5) {franja intermedia:\\[-2pt]\scriptsize presta si otro cierra el agujero};

  \draw[thick] (0.8,2.6) .. controls (3.0,2.1) and (4.6,1.2) .. (6.0,0.7);
  \node[anchor=west, align=left] at (6.12,0.7) {sostenible con alta probabilidad:\\[-2pt]\scriptsize presta sin pedir nada a nadie};
\end{tikzpicture}
