\begin{tikzpicture}[
  font=\footnotesize,
  caja/.style={draw=black!70, rounded corners=1.5pt, align=center, inner sep=4pt},
  preg/.style={caja, fill=black!6, text width=3.9cm},
  hoja/.style={caja, fill=white, text width=3.2cm},
  cab/.style={caja, fill=black!18, draw=black, line width=0.6pt, text width=6.2cm},
  flecha/.style={-{Latex[length=4.5pt]}, draw=black!65, line width=0.5pt},
  et/.style={font=\scriptsize, align=center, inner sep=1.5pt}
]

% ---------------- Pregunta inicial ----------------
\node[caja, fill=black!10, draw=black, line width=0.6pt, text width=7.2cm] (ini) at (0,0)
  {\textbf{¿Hay ya un desequilibrio de balanza de pagos?}};

% ---------------- Dos ramas ----------------
\node[cab] (prev) at (-4.3,-1.7) {\textbf{NO: prevenir}\\[1pt] {\scriptsize Líneas de seguro, normalmente sin desembolso}};
\node[cab] (res)  at (4.3,-1.7)  {\textbf{SÍ: resolver}\\[1pt] {\scriptsize Financiación efectiva contra un programa}};
\draw[flecha] (ini.south) -- (-4.3,-1.2) -- (prev.north);
\draw[flecha] (ini.south) -- (4.3,-1.2) -- (res.north);

% ---------------- Rama de prevención ----------------
\node[preg] (q2) at (-4.3,-3.5) {¿Las políticas del país son muy sólidas?};
\draw[flecha] (prev.south) -- (q2.north);

\node[hoja] (fcl) at (-6.2,-5.9) {\textbf{FCL} y \textbf{SLL}\\[1pt] {\scriptsize Sin condicionalidad posterior: la garantía es el historial}};
\node[hoja] (pll) at (-2.4,-5.9) {\textbf{PLL}\\[1pt] {\scriptsize Vulnerabilidades que quedan: condicionalidad ligera}};
\draw[flecha] (q2.south) -- (-6.2,-4.7) -- (fcl.north);
\draw[flecha] (q2.south) -- (-2.4,-4.7) -- (pll.north);
\node[et] at (-6.7,-4.5) {sí};
\node[et] at (-1.9,-4.5) {casi};

% ---------------- Rama de resolución ----------------
\node[preg] (q3) at (4.3,-3.5) {¿Puede diseñarse y ejecutarse un programa?};
\draw[flecha] (res.south) -- (q3.north);

\node[hoja] (rfi) at (2.4,-5.9) {\textbf{RFI} y \textbf{RCF}\\[1pt] {\scriptsize Urgencia o capacidad rota: desembolso directo, sin revisiones}};
\node[preg, text width=3.2cm] (q4) at (6.2,-5.9) {¿Coyuntural o exige reformas de fondo?};
\draw[flecha] (q3.south) -- (2.4,-4.7) -- (rfi.north);
\draw[flecha] (q3.south) -- (6.2,-4.7) -- (q4.north);
\node[et] at (1.9,-4.5) {no};
\node[et] at (6.7,-4.5) {sí};

\node[hoja] (sba) at (6.2,-8.1) {\textbf{SBA} y \textbf{SCF}\\[1pt] {\scriptsize Coyuntural: $1$-$3$ años}};
\node[hoja] (eff) at (6.2,-9.9) {\textbf{EFF} y \textbf{ECF}\\[1pt] {\scriptsize Estructural: $3$-$4$ años, devolución larga}};
\draw[flecha] (q4.south) -- (sba.north);
\draw[flecha] (sba.south) -- (eff.north);

% ---------------- Añadidos ----------------
\node[caja, text width=6.2cm, fill=black!4, anchor=north] (rsf) at (-4.3,-7.6)
  {\textbf{Sobre un programa vigente:} el \textbf{RSF} añade financiación a veinte años para riesgos de largo plazo, clima y pandemias};
\node[caja, text width=6.2cm, fill=black!4, anchor=north] (pci) at (-4.3,-9.3)
  {\textbf{Sin dinero, solo sello:} el \textbf{PCI} y el seguimiento por el personal avalan políticas cuando no hay financiación ni se la quiere};

\node[caja, text width=14.6cm, fill=black!5, draw=black, line width=0.6pt, anchor=north] at (0,-11.2)
  {\textbf{Dos decisiones independientes.} La \textbf{ventanilla} la fija la renta del país: la Cuenta de Recursos Generales para todos, el fondo concesional (PRGT) para los de renta baja y una mezcla de las dos para los que están en el límite. La \textbf{facilidad} la fija la naturaleza del problema, y por eso cada instrumento de la Cuenta tiene su gemelo concesional: SBA y SCF, EFF y ECF, RFI y RCF.};
\end{tikzpicture}
