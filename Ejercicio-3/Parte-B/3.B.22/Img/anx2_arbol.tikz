\begin{tikzpicture}[
  font=\footnotesize,
  caja/.style={draw=black!70, rounded corners=1.5pt, align=center, inner sep=4pt},
  preg/.style={caja, fill=black!6, text width=4.5cm},
  hoja/.style={caja, fill=white, text width=4.3cm},
  cab/.style={caja, fill=black!18, draw=black, line width=0.6pt, text width=6.6cm},
  flecha/.style={-{Latex[length=4.5pt]}, draw=black!65, line width=0.5pt},
  et/.style={font=\scriptsize, align=center, inner sep=1.5pt}
]

% ---------------- Pregunta inicial ----------------
\node[caja, fill=black!10, draw=black, line width=0.6pt, text width=7.5cm] (ini) at (0,0)
  {\textbf{¿Hay ya un desequilibrio de balanza de pagos?}};

% ---------------- Dos ramas ----------------
\node[cab] (prev) at (-4.1,-1.6) {\textbf{NO: prevenir}\\[1pt] {\scriptsize Líneas de seguro, normalmente sin desembolso}};
\node[cab] (res)  at (4.1,-1.6)  {\textbf{SÍ: resolver}\\[1pt] {\scriptsize Financiación efectiva contra un programa}};
\draw[flecha] (ini.south) -- (-4.1,-1.15) -- (prev.north);
\draw[flecha] (ini.south) -- (4.1,-1.15) -- (res.north);

% ---------------- Rama de prevención ----------------
\node[preg] (q2) at (-4.1,-3.3) {¿Las políticas del país son muy sólidas?};
\draw[flecha] (prev.south) -- (q2.north);

\node[hoja] (fcl) at (-6.3,-5.45) {\textbf{FCL} y \textbf{SLL}\\[1pt] {\scriptsize Sin condicionalidad posterior: la garantía es el historial. La SLL es renovable y de acceso menor}};
\node[hoja] (pll) at (-1.9,-5.45) {\textbf{PLL}\\[1pt] {\scriptsize Vulnerabilidades que quedan: condicionalidad ligera y acceso intermedio}};
\draw[flecha] (q2.south) -- (-6.3,-4.35) -- (fcl.north);
\draw[flecha] (q2.south) -- (-1.9,-4.35) -- (pll.north);
\node[et] at (-6.8,-4.15) {sí};
\node[et] at (-1.4,-4.15) {casi};

% ---------------- Rama de resolución ----------------
\node[preg] (q3) at (4.1,-3.3) {¿Puede diseñarse y ejecutarse un programa?};
\draw[flecha] (res.south) -- (q3.north);

\node[hoja] (rfi) at (1.9,-5.45) {\textbf{RFI} y \textbf{RCF}\\[1pt] {\scriptsize Urgencia, catástrofe o capacidad institucional rota: desembolso directo, sin programa ni revisiones}};
\node[preg, text width=4.3cm] (q4) at (6.3,-5.45) {¿El desequilibrio es coyuntural o exige reformas de fondo?};
\draw[flecha] (q3.south) -- (1.9,-4.35) -- (rfi.north);
\draw[flecha] (q3.south) -- (6.3,-4.35) -- (q4.north);
\node[et] at (1.4,-4.15) {no};
\node[et] at (6.8,-4.15) {sí};

\node[hoja] (sba) at (4.1,-7.9) {\textbf{SBA} y \textbf{SCF}\\[1pt] {\scriptsize Coyuntural: $1$-$3$ años}};
\node[hoja] (eff) at (8.5,-7.9) {\textbf{EFF} y \textbf{ECF}\\[1pt] {\scriptsize Estructural: $3$-$4$ años y plazos de devolución largos}};
\draw[flecha] (q4.south) -- (4.1,-6.9) -- (sba.north);
\draw[flecha] (q4.south) -- (8.5,-6.9) -- (eff.north);

% ---------------- Añadidos ----------------
\node[caja, text width=6.4cm, fill=black!4, anchor=north] (rsf) at (-4.1,-6.9)
  {\textbf{Sobre un programa vigente:} el \textbf{RSF} añade financiación a veinte años para riesgos de largo plazo, clima y pandemias};
\node[caja, text width=6.4cm, fill=black!4, anchor=north] (pci) at (-4.1,-8.55)
  {\textbf{Sin dinero, solo sello:} el \textbf{PCI} y el seguimiento por el personal avalan políticas cuando no hay financiación ni se la quiere};

\node[caja, text width=15.0cm, fill=black!5, draw=black, line width=0.6pt, anchor=north] at (0,-10.3)
  {\textbf{Dos decisiones independientes.} La \textbf{ventanilla} la fija la renta del país: Cuenta de Recursos Generales para todos, fondo concesional (PRGT) para los de renta baja, y una mezcla de ambas para los que están en el límite. La \textbf{facilidad} la fija la naturaleza del problema, y por eso cada instrumento de la CRG tiene su gemelo concesional: SBA y SCF, EFF y ECF, RFI y RCF.};
\end{tikzpicture}
