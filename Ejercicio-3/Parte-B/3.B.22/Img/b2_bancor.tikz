\begin{tikzpicture}[
  font=\footnotesize,
  cel/.style={draw=black!70, align=left, inner sep=4pt, text width=5.0cm, minimum height=1.3cm, anchor=north west},
  fila/.style={draw=black!70, align=left, inner sep=4pt, text width=3.5cm, minimum height=1.3cm, anchor=north west},
  cab/.style={draw=black, line width=0.6pt, align=center, inner sep=4pt, text width=5.0cm, fill=black!18, anchor=north west},
  et/.style={font=\scriptsize, align=center, inner sep=2pt}
]

\def\xa{3.65} \def\xb{8.85}

\node[cab, text width=3.5cm, anchor=north west] at (0,1.1) {\textbf{}};
\node[cab] at (\xa,1.1) {\textbf{El \textit{bancor} de KEYNES}\\[-1pt] {\scriptsize propuesto en 1943, nunca nació}};
\node[cab] at (\xb,1.1) {\textbf{El DEG}\\[-1pt] {\scriptsize creado en 1969, existe}};

\node[fila, fill=black!10] at (0,0) {\textbf{Quién lo crea}};
\node[cel, fill=white] at (\xa,0) {{\scriptsize La cámara de compensación, \textbf{sola}: se crea al liquidarse el comercio}};
\node[cel, fill=black!6] at (\xb,0) {{\scriptsize El Fondo, \textbf{por decisión} que exige el $85\%$ de los votos y constatar una necesidad mundial}};

\node[fila, fill=black!10] at (0,-1.35) {\textbf{Cómo se reparte}};
\node[cel, fill=white] at (\xa,-1.35) {{\scriptsize Según el saldo comercial: lo acumula quien exporta más de lo que importa}};
\node[cel, fill=black!6] at (\xb,-1.35) {{\scriptsize En proporción a la cuota: \textbf{recibe más quien menos lo necesita}}};

\node[fila, fill=black!10] at (0,-2.7) {\textbf{Para qué sirve}};
\node[cel, fill=white] at (\xa,-2.7) {{\scriptsize Para liquidar el comercio internacional: es \textbf{medio de pago}}};
\node[cel, fill=black!6] at (\xb,-2.7) {{\scriptsize Para obtener divisas de otro banco central: es \textbf{un derecho}, no un medio de pago}};

\node[fila, fill=black!16] at (0,-4.05) {\textbf{Quién paga el ajuste}};
\node[cel, fill=white] at (\xa,-4.05) {{\scriptsize \textbf{Los dos}: cargos sobre el saldo excesivo tanto del deudor como del acreedor}};
\node[cel, fill=black!6] at (\xb,-4.05) {{\scriptsize \textbf{Solo el deudor}: nada obliga al país con superávit a hacer nada}};

\node[draw=black, line width=0.6pt, rounded corners=1.5pt, align=center, inner sep=5pt, text width=13.5cm, fill=black!5, anchor=north west] at (0,-5.75)
  {\textbf{El DEG resolvió la mitad del problema que TRIFFIN había señalado} —crear reservas sin que un país tenga que endeudarse para suministrarlas— \textbf{y no tocó la otra mitad}, la asimetría del ajuste. Por eso es un activo y no un sistema: reparte liquidez, pero no cambia quién soporta la corrección de los desequilibrios.};
\end{tikzpicture}
