\begin{tikzpicture}[
  font=\footnotesize,
  y=0.0072cm,
  caja/.style={draw=black!70, rounded corners=1.5pt, align=center, inner sep=4pt},
  et/.style={font=\scriptsize, align=center},
  flecha/.style={-{Latex[length=4.5pt]}, draw=black!65, line width=0.5pt}
]

% ---------------- Columna 1: hoy ----------------
\def\xa{0}
\fill[black!16, draw=black!70] (\xa-1.5,0) rectangle (\xa+1.5,476);
\fill[black!8, draw=black!70]  (\xa-1.5,476) rectangle (\xa+1.5,840);
\fill[white, draw=black!70]    (\xa-1.5,840) rectangle (\xa+1.5,977);

\node[et] at (\xa,238) {\textbf{Cuotas}\\ $476$};
\node[et] at (\xa,658) {\textbf{NAP}\\ $364$};
\node[et] at (\xa,908) {\textbf{Bilaterales}\\ $137$};
\node[align=center] at (\xa,1090) {\textbf{Hoy}\\[-2pt] {\scriptsize total $\approx 977$}};

% ---------------- Columna 2: tras la 16.ª ----------------
\def\xb{4.6}
\fill[black!16, draw=black!70] (\xb-1.5,0) rectangle (\xb+1.5,716);
\fill[black!8, draw=black!70]  (\xb-1.5,716) rectangle (\xb+1.5,1019);

\node[et] at (\xb,358) {\textbf{Cuotas}\\ $716$};
\node[et] at (\xb,868) {\textbf{NAP}\\ $303$};
\node[align=center] at (\xb,1130) {\textbf{Tras la 16.ª revisión}\\[-2pt] {\scriptsize total $\approx 1.019$}};

\draw[flecha] (\xa+1.75,440) -- node[et, above, pos=0.5] {$+50\%$ de cuotas} node[et, below, pos=0.5] {repliegue de los NAP} (\xb-1.75,440);

% ---------------- Orden de uso ----------------
\draw[flecha] (\xa-1.8,20) -- (\xa-1.8,957);
\node[et, rotate=90, anchor=south] at (\xa-2.15,490) {orden de uso};

% ---------------- Leyenda, alineada con cada capa ----------------
\node[caja, text width=5.9cm, anchor=west, fill=white] at (6.9,908)
  {\textbf{Acuerdos bilaterales.} Temporales y renovables de uno en uno: la capa más frágil, y la que desaparece cuando entre en vigor la revisión};
\node[caja, text width=5.9cm, anchor=west, fill=black!8] at (6.9,620)
  {\textbf{Nuevos Acuerdos de Préstamo.} Líneas de crédito permanentes de unos cuarenta participantes, que se activan por periodos y exigen su consentimiento};
\node[caja, text width=5.9cm, anchor=west, fill=black!16] at (6.9,238)
  {\textbf{Cuotas.} Permanentes, de los $191$ miembros y disponibles sin más decisión. Solo son utilizables las monedas de los países con posición externa sólida};

\node[caja, text width=12.6cm, anchor=north west, fill=black!5, draw=black, line width=0.6pt] at (-1.0,-90)
  {\textbf{Lo que cambia la 16.ª revisión no es el tamaño, sino la naturaleza del dinero:} la capacidad total se mantiene en torno al billón de dólares, pero el peso de los recursos permanentes y de todos sube del $49\%$ a cerca del $70\%$, y el Fondo deja de depender de los acreedores que renuevan sus líneas.};
\end{tikzpicture}
