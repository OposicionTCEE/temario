\begin{tikzpicture}[
  font=\footnotesize,
  paso/.style={draw=black!70, rounded corners=1.5pt, align=left, inner sep=5pt, text width=12.4cm},
  flecha/.style={-{Latex[length=5pt]}, draw=black!65, line width=0.6pt},
  et/.style={font=\scriptsize\itshape, align=left, inner sep=2pt}
]

\node[paso, fill=black!14] (p0) at (0,0)
  {\textbf{0. El objetivo.} Frenar la sangría y empezar a reconstruir las reservas netas: de $30$ a $35$ en el año, esto es $\Delta R=+5$.};

\node[paso, fill=white, anchor=north] (p1) at (0,-1.3)
  {\textbf{1. La demanda de dinero.} Con un crecimiento real del $2\%$ y una inflación que baja del $24\%$ al $10\%$, el PIB nominal pasa de $1.000$ a $1.122$. Con velocidad constante, $V=5$, el público querrá tener $M^{d}=1.122/5=224{,}4$, frente a $200$: $\Delta M^{d}=+24{,}4$.};

\node[paso, fill=white, anchor=north] (p2) at (0,-3.5)
  {\textbf{2. El techo de crédito interno.} Del balance del banco central, $M=R+CI$, se despeja lo único que queda libre: $\Delta CI=\Delta M^{d}-\Delta R=24{,}4-5=+19{,}4$. \textbf{Este es el criterio de ejecución central del programa.}};

\node[paso, fill=white, anchor=north] (p3) at (0,-5.7)
  {\textbf{3. El reparto del crédito.} Si el crédito al sector privado ha de crecer como el PIB nominal ($+12{,}2\%$ sobre $100$, es decir $+12{,}2$), al Gobierno solo le quedan $19{,}4-12{,}2=+7{,}2$, frente a los $40$ que el banco central le prestó el año anterior.};

\node[paso, fill=white, anchor=north] (p4) at (0,-7.9)
  {\textbf{4. El déficit máximo.} El Gobierno solo puede gastar por encima de sus ingresos lo que alguien le preste: $20$ del exterior y $7{,}2$ del banco central. El déficit no puede pasar de $27{,}2$, el $2{,}4\%$ del PIB, frente al $6{,}0\%$ del año anterior.};

\node[paso, fill=black!8, anchor=north] (p5) at (0,-10.1)
  {\textbf{5. La comprobación exterior.} De $\Delta R=CC+CF$, con capital privado de $20$ y financiación oficial de $20$: $CC=5-40=-35$, una mejora de $15$ sobre el año anterior. \textbf{Si el ajuste previsto no produce esa mejora, el cuadro no cuadra y hay que volver al paso 0.}};

\foreach \a/\b in {p0/p1, p1/p2, p2/p3, p3/p4, p4/p5} {
  \draw[flecha] (\a.south) -- (\b.north);
}
\node[et, anchor=west] at (0.25,-1.1) {se proyecta};
\node[et, anchor=west] at (0.25,-3.3) {se despeja};
\node[et, anchor=west] at (0.25,-5.5) {se reparte};
\node[et, anchor=west] at (0.25,-7.7) {se traduce en déficit};
\node[et, anchor=west] at (0.25,-9.9) {se comprueba};

\node[draw=black, line width=0.6pt, rounded corners=1.5pt, fill=black!5, align=center, inner sep=5pt, text width=12.4cm, anchor=north] at (0,-12.5)
  {\textbf{La cadena va de un objetivo exterior a un techo de gasto público sin ninguna decisión política por medio.} Ahí están a la vez la fuerza del método, que hace explícito lo que cada objetivo cuesta, y su límite: basta cambiar el supuesto sobre la velocidad del dinero o sobre la inflación para que el ajuste exigido sea otro.};
\end{tikzpicture}
