\begin{tikzpicture}[
  font=\footnotesize,
  paso/.style={draw=black!70, rounded corners=1.5pt, align=left, inner sep=5pt, text width=12.4cm},
  flecha/.style={-{Latex[length=5pt]}, draw=black!65, line width=0.6pt},
  et/.style={font=\scriptsize\itshape, align=left, inner sep=2pt}
]

\node[paso, fill=black!14] (p0) at (0,0)
  {\textbf{0. El objetivo.} Reconstruir las reservas netas: de $30$ a $35$ en el año, esto es $\Delta R=+5$.};

\node[paso, fill=white, anchor=north] (p1) at (0,-1.25)
  {\textbf{1. La demanda de dinero.} Con un crecimiento real del $2\%$ y una inflación del $3\%$, el PIB nominal pasa de $1.000$ a $1.051$. Con velocidad constante, $V=5$, el dinero que el público querrá tener es $M^{d}=1.051/5=210{,}2$, frente a $200$: $\Delta M^{d}=+10{,}2$.};

\node[paso, fill=white, anchor=north] (p2) at (0,-3.45)
  {\textbf{2. El techo de crédito interno.} Del balance del banco central, $M=R+CI$, se despeja lo único que queda libre: $\Delta CI=\Delta M^{d}-\Delta R=10{,}2-5=+5{,}2$. \textbf{Este es el criterio de ejecución central del programa.}};

\node[paso, fill=white, anchor=north] (p3) at (0,-5.65)
  {\textbf{3. El reparto del crédito.} Si el crédito al sector privado ha de crecer como el PIB nominal ($+5{,}1\%$ sobre $100$, es decir $+5{,}1$), al Gobierno solo le queda $5{,}2-5{,}1=+0{,}1$.};

\node[paso, fill=white, anchor=north] (p4) at (0,-7.6)
  {\textbf{4. El déficit máximo.} El Gobierno solo puede gastar por encima de sus ingresos lo que alguien le preste: $20$ del exterior y $0{,}1$ del banco central. El déficit no puede pasar de $20{,}1$, el $1{,}9\%$ del PIB, frente al $6{,}0\%$ del año anterior.};

\node[paso, fill=black!8, anchor=north] (p5) at (0,-9.55)
  {\textbf{5. La comprobación exterior.} De $\Delta R=CC+CF$ con capital privado de $20$ y financiación oficial de $20$: $CC=5-40=-35$, una mejora de $15$ sobre el año anterior. \textbf{Si el ajuste previsto no produce esa mejora, el cuadro no cuadra y hay que volver al paso 0.}};

\foreach \a/\b/\t in {p0/p1/{se proyecta}, p1/p2/{se despeja}, p2/p3/{se reparte}, p3/p4/{se traduce a pesetas de presupuesto}, p4/p5/{se comprueba}} {
  \draw[flecha] (\a.south) -- (\b.north);
}
\node[et, anchor=west] at (0.25,-1.05) {se proyecta};
\node[et, anchor=west] at (0.25,-3.25) {se despeja};
\node[et, anchor=west] at (0.25,-5.45) {se reparte};
\node[et, anchor=west] at (0.25,-7.4) {se traduce en déficit};
\node[et, anchor=west] at (0.25,-9.35) {se comprueba};

\node[draw=black, line width=0.6pt, rounded corners=1.5pt, fill=black!5, align=center, inner sep=5pt, text width=12.4cm, anchor=north] at (0,-11.85)
  {\textbf{La cadena va de un objetivo exterior a un techo de gasto público sin ninguna decisión política por medio.} Ahí están a la vez la fuerza del método, que hace explícito lo que cada objetivo cuesta, y su límite: basta cambiar el supuesto sobre la velocidad del dinero para que el ajuste exigido sea otro.};
\end{tikzpicture}
