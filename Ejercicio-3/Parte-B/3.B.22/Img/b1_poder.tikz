\begin{tikzpicture}[
  font=\footnotesize,
  col/.style={draw=black, line width=0.6pt, rounded corners=1.5pt, align=left, inner sep=5pt, text width=4.3cm, anchor=north west},
  cab/.style={draw=black, line width=0.6pt, rounded corners=1.5pt, align=center, inner sep=4pt, text width=4.3cm, fill=black!18, anchor=north west},
  flecha/.style={-{Latex[length=5pt]}, draw=black!65, line width=0.7pt},
  et/.style={font=\scriptsize\itshape, align=center, inner sep=2pt}
]

\def\xa{0} \def\xb{5.2} \def\xc{10.4}

\node[cab] at (\xa,0) {\textbf{1. La cuota}};
\node[cab] at (\xb,0) {\textbf{2. El voto}};
\node[cab] at (\xc,0) {\textbf{3. Quién decide}};

\node[col, fill=black!6] at (\xa,-0.75)
  {{\scriptsize Un solo número, en DEG, que cada país aporta al fondo común y que fija a la vez lo que pone, lo que vota, lo que puede pedir y los DEG que recibe\\[4pt]
  \textbf{EEUU:} $83$ mil millones, el $17{,}4\%$\\
  \textbf{España:} $9{,}5$ mil millones, el $2{,}0\%$}};

\node[col, fill=black!6] at (\xb,-0.75)
  {{\scriptsize Votos básicos, iguales para todos ($5{,}502\%$ del total), más un voto por cada $100.000$ DEG de cuota\\[4pt]
  \textbf{EEUU:} $16{,}49\%$ \quad \textbf{España:} $1{,}92\%$\\[4pt]
  Mayoría simple para casi todo; $70\%$ para cargos y remuneración; \textbf{$85\%$ para cuotas, DEG y enmiendas}}};

\node[col, fill=black!6] at (\xc,-0.75)
  {{\scriptsize \textbf{Personal técnico:} diagnostica, negocia y redacta. Tiene la iniciativa\\[3pt]
  \textbf{Directorio Ejecutivo:} $25$ sillas, residente, decide por consenso\\[3pt]
  \textbf{Junta de Gobernadores:} $191$ miembros; refrenda lo que el Convenio le reserva\\[3pt]
  \textbf{CMFI:} orienta cada semestre, sin poder formal}};

\draw[flecha] (\xa+4.42,-2.4) -- (\xb-0.12,-2.4);
\draw[flecha] (\xb+4.42,-2.4) -- (\xc-0.12,-2.4);

\node[draw=black, line width=0.7pt, rounded corners=1.5pt, align=center, inner sep=5pt, text width=14.5cm, fill=black!12, anchor=north west] at (0,-5.5)
  {\textbf{Con el $16{,}49\%$ de los votos, Estados Unidos bloquea por sí solo todo lo que exige el $85\%$,} que es justamente lo que cambia la institución. Y como la cuota es a la vez dinero, voto, acceso y DEG, nadie acepta que baje la suya: \textbf{el poder relativo solo puede moverse si sube el total, y subir el total exige también ese $85\%$}.};
\end{tikzpicture}
