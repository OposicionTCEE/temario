\begin{tikzpicture}[
  font=\footnotesize,
  caja/.style={draw=black!70, rounded corners=1.5pt, align=center, inner sep=5pt},
  sec/.style={caja, fill=black!10, draw=black, line width=0.6pt, text width=5.0cm},
  et/.style={font=\scriptsize, align=center, inner sep=2pt, fill=white},
  doble/.style={{Latex[length=4pt]}-{Latex[length=4pt]}, draw=black!65, line width=0.5pt}
]

\def\xi{-3.6} \def\xd{3.6} \def\ys{1.9} \def\yi{-1.9}

\node[sec] (real) at (\xi,\ys)
  {\textbf{Sector real}\\[1pt] {\scriptsize Producción, absorción, precios}\\[1pt] {\scriptsize $Y=C+I+G+X-Q$}};
\node[sec] (fisc) at (\xd,\ys)
  {\textbf{Sector fiscal}\\[1pt] {\scriptsize Ingresos, gastos, déficit}\\[1pt] {\scriptsize $D=\Delta CI^{g}+\Delta B^{\,ext}+\Delta B^{\,int}$}};
\node[sec] (mone) at (\xi,\yi)
  {\textbf{Sector monetario}\\[1pt] {\scriptsize Balance del banco central}\\[1pt] {\scriptsize $M=R+CI$}};
\node[sec] (ext) at (\xd,\yi)
  {\textbf{Sector exterior}\\[1pt] {\scriptsize Balanza de pagos}\\[1pt] {\scriptsize $CC+CF=\Delta R$}};

% ---- enlaces ----
\draw[doble] (real) -- node[et, text width=4.4cm] {Los ingresos dependen del PIB; el gasto público es parte de la demanda} (fisc);
\draw[doble] (real) -- node[et, text width=3.0cm] {La demanda de dinero depende del PIB nominal} (mone);
\draw[doble] (fisc) -- node[et, text width=3.0cm] {Lo que no se financia dentro, lo financia el exterior} (ext);
\draw[doble] (mone) -- node[et, text width=4.4cm] {El saldo de la balanza de pagos es la variación de las reservas, activo del banco central} (ext);
\draw[doble] (real) -- node[et, text width=3.4cm, pos=0.42] {Las importaciones dependen de la absorción} (ext);
\draw[doble] (fisc) -- node[et, text width=3.4cm, pos=0.42] {El déficit que no se financia fuera lo monetiza el banco central} (mone);

\node[caja, text width=14.0cm, fill=black!5, draw=black, line width=0.6pt, anchor=north] at (0,-4.3)
  {\textbf{Las cuatro cuentas no son independientes: cada una recoge la contrapartida de las demás.} Una proyección que no cuadre en las cuatro a la vez es una proyección falsa, y en detectar esas incoherencias reside casi todo el valor del método: no predice el futuro, obliga a que las piezas encajen.};
\end{tikzpicture}
