\begin{tikzpicture}[
  font=\footnotesize,
  caja/.style={draw=black!70, rounded corners=1.5pt, align=center, inner sep=5pt},
  sec/.style={caja, fill=black!10, draw=black, line width=0.6pt, text width=4.3cm},
  et/.style={font=\scriptsize, align=center, inner sep=2.5pt, fill=white},
  doble/.style={{Latex[length=4pt]}-{Latex[length=4pt]}, draw=black!65, line width=0.5pt},
  flojo/.style={{Latex[length=4pt]}-{Latex[length=4pt]}, draw=black!45, line width=0.4pt, dashed}
]

\def\xi{-4.3} \def\xd{4.3} \def\ys{2.5} \def\yi{-2.5}

\node[sec] (real) at (\xi,\ys)
  {\textbf{Sector real}\\[1pt] {\scriptsize Producción, absorción y precios}\\[1pt] {\scriptsize $Y=C+I+G+X-Q$}};
\node[sec] (fisc) at (\xd,\ys)
  {\textbf{Sector fiscal}\\[1pt] {\scriptsize Ingresos, gastos y déficit}\\[1pt] {\scriptsize $D=\Delta CI^{g}+\Delta B^{\,ext}$}};
\node[sec] (mone) at (\xd,\yi)
  {\textbf{Sector monetario}\\[1pt] {\scriptsize Balance del banco central}\\[1pt] {\scriptsize $M=R+CI$}};
\node[sec] (ext) at (\xi,\yi)
  {\textbf{Sector exterior}\\[1pt] {\scriptsize Balanza de pagos}\\[1pt] {\scriptsize $CC+CF=\Delta R$}};

% ---- enlaces del perímetro ----
\draw[doble] (real) -- node[et, text width=3.6cm] {Los ingresos siguen al PIB y el gasto público es parte de la demanda} (fisc);
\draw[doble] (fisc) -- node[et, text width=3.1cm] {El déficit que no se financia fuera lo monetiza el banco central} (mone);
\draw[doble] (mone) -- node[et, text width=3.6cm] {El saldo de la balanza de pagos es la variación de las reservas} (ext);
\draw[doble] (ext) -- node[et, text width=2.7cm] {Las importaciones siguen a la absorción} (real);

% ---- diagonales ----
\draw[flojo] (real) -- node[et, text width=2.6cm, pos=0.30] {La demanda de dinero sigue al PIB nominal} (mone);
\draw[flojo] (fisc) -- node[et, text width=2.6cm, pos=0.30] {El resto del déficit lo financia el ahorro externo} (ext);

\node[caja, text width=13.8cm, fill=black!5, draw=black, line width=0.6pt, anchor=north] at (0,-4.9)
  {\textbf{Las cuatro cuentas no son independientes: cada una recoge la contrapartida de las demás.} Una proyección que no cuadre en las cuatro a la vez es una proyección falsa, y en detectar esas incoherencias reside casi todo el valor del método: no predice el futuro, obliga a que las piezas encajen.};
\end{tikzpicture}
