% Cuerpo, bloque 1 — Jerarquía del Fondo: de la cuota al voto y del voto a los órganos.
\begin{tikzpicture}[>={Stealth[length=2.2mm]}, every node/.style={font=\footnotesize},
  org/.style={draw, rounded corners=1.5pt, align=center, inner sep=4pt, text width=5.2cm, minimum height=0.95cm},
  lado/.style={draw, dashed, rounded corners=1.5pt, align=center, inner sep=4pt, text width=3.3cm, minimum height=0.95cm}]

  \node[org] (junta) at (0,0) {\textbf{Junta de Gobernadores}\\[-1pt] \scriptsize $191$ gobernadores};
  \node[org] (dir)   at (0,-2.0) {\textbf{Directorio Ejecutivo}\\[-1pt] \scriptsize $25$ sillas, residente};
  \node[org] (ger)   at (0,-4.0) {\textbf{Gerencia}\\[-1pt] \scriptsize Directora Gerente y cuatro subdirectores};
  \node[org] (staff) at (0,-6.0) {\textbf{Personal técnico}\\[-1pt] \scriptsize $\approx 3.100$ economistas};

  \node[lado] (cmfi) at (5.3,-1.0) {\textbf{CMFI}\\[-1pt] \scriptsize $25$ ministros, dos veces al año};

  % quién nombra a quién
  \draw[->, thick] (-1.1,-0.52) -- node[left=1pt]{\scriptsize elige} (-1.1,-1.48);
  \draw[->, thick] (-1.1,-2.52) -- node[left=1pt]{\scriptsize nombra} (-1.1,-3.48);
  \draw[->, thick] (-1.1,-4.52) -- node[left=1pt]{\scriptsize dirige} (-1.1,-5.48);

  % quién propone a quién
  \draw[->, thick] (1.1,-5.48) -- node[right=1pt]{\scriptsize propone} (1.1,-4.52);
  \draw[->, thick] (1.1,-3.48) -- node[right=1pt]{\scriptsize somete} (1.1,-2.52);
  \draw[->, thick] (1.1,-1.48) -- node[right=1pt, align=left]{\scriptsize eleva lo\\[-2pt]\scriptsize reservado} (1.1,-0.52);

  % el CMFI orienta
  \draw[->, dashed] (cmfi) -- node[above=1pt, pos=0.55]{\scriptsize orienta} (dir);

  % de dónde viene el poder
  \draw[->, thick] (-5.0,0) -- (-2.65,0);
  \node[anchor=east, align=right] at (-5.1,0) {\scriptsize cuota $\to$ votos\\[-2pt] \scriptsize ($85\%$ para lo que\\[-2pt] \scriptsize cambia la institución)};
\end{tikzpicture}
