\begin{tikzpicture}[
  font=\footnotesize,
  x=0.0395cm,
  caja/.style={draw=black!70, rounded corners=1.5pt, align=center, inner sep=4pt},
  et/.style={font=\scriptsize, align=center},
  flecha/.style={-{Latex[length=4.5pt]}, draw=black!65, line width=0.5pt},
  llave/.style={decorate, decoration={brace, amplitude=4pt, mirror}, draw=black!60}
]

% ---------------- Barra de tenencias ----------------
\fill[black!22, draw=black!70] (0,0) rectangle (75,1.5);
\fill[black!10, draw=black!70] (75,0) rectangle (100,1.5);
\fill[white, draw=black!70]    (100,0) rectangle (300,1.5);
\fill[black!35, draw=black!70] (300,0) rectangle (350,1.5);

\node[et] at (37.5,0.75) {Pagado en\\ moneda nacional};
\node[et] at (87.5,0.75) {Tramo de\\ reserva};
\node[et] at (200,0.75) {Tramos de crédito};
\node[et, text=white] at (325,0.75) {Recargo};

% ---------------- Eje ----------------
\draw[black!70] (0,-0.12) -- (350,-0.12);
\foreach \x/\t in {0/0, 75/75, 100/100, 300/300, 350/350} {
  \draw[black!70] (\x,-0.12) -- (\x,-0.30);
  \node[et, anchor=north] at (\x,-0.35) {$\t$};
}
\node[et, anchor=north] at (175,-0.80) {Tenencias del Fondo en moneda del país, en \% de la cuota};

% ---------------- Tres momentos ----------------
\node[caja, anchor=south, text width=3.3cm, fill=black!4] (ma) at (45,2.9)
  {\textbf{(a) Al suscribir}\\[2pt] {\scriptsize El $25\%$ se pagó en activos de reserva y el Fondo tiene el resto en moneda nacional}};
\node[caja, anchor=south, text width=3.3cm, fill=black!4] (mb) at (168,2.9)
  {\textbf{(b) Tramo de reserva}\\[2pt] {\scriptsize Giro incondicional, sin cargos ni devolución pactada: es reserva propia del país, no crédito}};
\node[caja, anchor=south, text width=3.3cm, fill=black!4] (mc) at (290,2.9)
  {\textbf{(c) Tramos de crédito}\\[2pt] {\scriptsize Lo que excede del $100\%$ es \textbf{crédito vivo}: exige programa, paga cargos y se recompra}};

\draw[flecha] (ma.south) -- (75,1.6);
\draw[flecha] (mb.south) -- (100,1.6);
\draw[flecha] (mc.south) -- (250,1.6);

% ---------------- Coste ----------------
\draw[llave] (100,-1.45) -- (300,-1.45);
\node[et, anchor=north] at (200,-1.68) {Cargo básico $=$ tipo de interés del DEG $+$ margen de $60$ pb};
\draw[llave] (300,-1.45) -- (350,-1.45);
\node[et, anchor=north, text width=3.1cm] at (331,-1.68) {$+200$ pb sobre el exceso};

\node[caja, text width=13.9cm, anchor=north west, fill=black!5, draw=black, line width=0.6pt] at (0,-2.95)
  {\textbf{La cuota ordena todo el crédito del Fondo:} fija dónde acaba la reserva propia del país y empieza el crédito condicionado, en qué punto el crédito se encarece y, con los límites de acceso, hasta dónde puede llegar. A los recargos por nivel se suma, desde los $36$ meses de uso ($51$ en los acuerdos ampliados), un recargo por tiempo de $75$ puntos básicos.};
\end{tikzpicture}
