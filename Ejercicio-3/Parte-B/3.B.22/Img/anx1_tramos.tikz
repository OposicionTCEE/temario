\begin{tikzpicture}[
  font=\footnotesize,
  x=0.0395cm,
  caja/.style={draw=black!70, rounded corners=1.5pt, align=center, inner sep=4pt},
  et/.style={font=\scriptsize, align=center},
  flecha/.style={-{Latex[length=4.5pt]}, draw=black!65, line width=0.5pt},
  llave/.style={decorate, decoration={brace, amplitude=4pt, mirror}, draw=black!60}
]

% ---------------- Barra de tenencias ----------------
\fill[black!22, draw=black!70] (0,0) rectangle (75,1.5);
\fill[black!10, draw=black!70] (75,0) rectangle (100,1.5);
\fill[white, draw=black!70]    (100,0) rectangle (300,1.5);
\fill[black!35, draw=black!70] (300,0) rectangle (350,1.5);

\node[et] at (37.5,0.75) {Pagado en\\ moneda nacional};
\node[et] at (87.5,0.75) {Tramo de\\ reserva};
\node[et] at (200,0.75) {Tramos de crédito};
\node[et, text=white] at (325,0.75) {Recargo};

% ---------------- Eje ----------------
\draw[black!70] (0,-0.1) -- (350,-0.1);
\foreach \x/\t in {0/0, 75/75, 100/100, 300/300, 350/350} {
  \draw[black!70] (\x,-0.1) -- (\x,-0.28);
  \node[et, anchor=north] at (\x,-0.33) {$\t$};
}
\node[et, anchor=north] at (175,-0.95) {Tenencias del Fondo en moneda del país, en \% de la cuota};

% ---------------- Tres momentos ----------------
\draw[flecha] (75,2.9) -- (75,1.65);
\node[caja, anchor=south, text width=3.5cm, fill=black!4] at (75,3.0)
  {\textbf{(a) Al suscribir}\\[2pt] {\scriptsize El $25\%$ se pagó en activos de reserva: el Fondo tiene el $75\%$ restante en moneda nacional}};

\draw[flecha] (100,2.9) -- (100,1.65);
\node[caja, anchor=south, text width=3.9cm, fill=black!4] at (152,3.0)
  {\textbf{(b) Giro del tramo de reserva}\\[2pt] {\scriptsize Incondicional, sin cargos y sin devolución pactada: es reserva propia del país, no crédito del Fondo}};

\draw[flecha] (250,2.9) -- (250,1.65);
\node[caja, anchor=south, text width=4.4cm, fill=black!4] at (265,3.0)
  {\textbf{(c) Compra en los tramos de crédito}\\[2pt] {\scriptsize Lo que excede del $100\%$ es \textbf{crédito vivo}: exige programa, paga cargos y debe recomprarse}};

% ---------------- Coste ----------------
\draw[llave] (100,-1.15) -- (300,-1.15);
\node[et, anchor=north] at (200,-1.35) {Cargo básico $=$ tipo de interés del DEG $+$ margen de $60$ pb};
\draw[llave] (300,-1.15) -- (350,-1.15);
\node[et, anchor=north, text width=3.3cm] at (335,-1.35) {$+200$ pb sobre el exceso};

\node[caja, text width=13.9cm, anchor=north west, fill=black!5, draw=black, line width=0.6pt] at (0,-2.6)
  {\textbf{La cuota ordena todo el crédito del Fondo:} fija dónde acaba la reserva propia del país y empieza el crédito condicionado, en qué punto el crédito se encarece y, con los límites de acceso, hasta dónde puede llegar. A los recargos por nivel se suma, desde los $36$ meses de uso ($51$ en los acuerdos ampliados), un recargo por tiempo de $75$ puntos básicos.};
\end{tikzpicture}
