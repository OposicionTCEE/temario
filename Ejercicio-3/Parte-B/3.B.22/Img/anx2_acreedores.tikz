\begin{tikzpicture}[
  font=\footnotesize,
  caja/.style={draw=black!70, rounded corners=1.5pt, align=center, inner sep=4pt},
  tier/.style={caja, text width=10.2cm},
  sub/.style={caja, text width=4.7cm, fill=white},
  flecha/.style={-{Latex[length=4.5pt]}, draw=black!65, line width=0.5pt},
  et/.style={font=\scriptsize, align=center, inner sep=2pt}
]

% ---------------- Tres clases de acreedor ----------------
\node[tier, fill=black!18] (mul) at (0,0)
  {\textbf{1. Acreedores multilaterales} \ {\scriptsize(FMI, Banco Mundial, bancos regionales de desarrollo)}\\[2pt]
   {\scriptsize Preferencia de hecho: \textbf{no participan en la quita}. Cobran íntegro y antes que nadie}};

\node[tier, fill=black!8, minimum height=2.3cm] (bil) at (0,-2.5) {};
\node[anchor=north] at (0,-1.55) {\textbf{2. Acreedores bilaterales oficiales}};
\node[sub, anchor=north east] at (-0.2,-2.05) {\textbf{Club de París}\\[1pt] {\scriptsize Veintidós acreedores con reglas comunes desde 1956}};
\node[sub, anchor=north west] at (0.2,-2.05) {\textbf{Acreedores de fuera}\\[1pt] {\scriptsize China, India, Arabia Saudí, Emiratos: hoy los mayores de los países pobres}};

\node[tier, fill=black!4] (priv) at (0,-4.95)
  {\textbf{3. Acreedores privados}\\[2pt]
   {\scriptsize Bonistas, con cláusulas de acción colectiva y agregación desde 2014; bancos; proveedores}};

% ---------------- Marco Común ----------------
\node[caja, text width=2.9cm, fill=black!12, anchor=west] (mc) at (5.4,-2.5)
  {\textbf{Marco Común del G20} (2020)\\[1pt] {\scriptsize Un solo Comité de Acreedores Oficiales para los dos grupos}};
\draw[flecha] (mc.west) -- (bil.east);

% ---------------- Reglas que los enlazan ----------------
\draw[flecha] (-5.4,-2.0) -- (-5.4,-4.6);
\node[et, rotate=90, anchor=south, text width=3.0cm] at (-5.75,-3.1) {\textbf{Comparabilidad de trato:} lo pactado por el grupo oficial hay que pedírselo al privado};

\draw[black!65, line width=0.5pt] (-5.15,-5.72) -- (5.15,-5.72);
\node[et, anchor=north, text width=10.2cm] at (0,-5.78) {\textbf{Garantías de financiación:} el Fondo no desembolsa hasta que el reparto entre todos ellos está cerrado};

% ---------------- Dónde falla ----------------
\node[caja, text width=14.4cm, fill=black!5, draw=black, line width=0.6pt, anchor=north] at (0,-6.6)
  {\textbf{Dónde falla.} \textit{Quién es oficial}: instituciones como el Afreximbank reclamaron preferencia y fueron presionadas para asumir pérdidas en Ghana y Zambia. \textit{El acreedor que litiga}: nada obliga a un bonista a aceptar, y el pleito con los tenedores de deuda bloqueó durante años el caso de Etiopía. \textit{El tiempo}: el primer caso del Marco Común, Chad, tardó dos años y terminó sin reducción nominal de la deuda.};
\end{tikzpicture}
