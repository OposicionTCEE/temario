\begin{tikzpicture}[
  font=\footnotesize,
  x=0.30cm,
  caja/.style={draw=black!70, rounded corners=1.5pt, align=center, inner sep=4pt},
  flecha/.style={-{Latex[length=4.5pt]}, draw=black!65, line width=0.5pt},
  et/.style={font=\scriptsize, align=center, inner sep=1.5pt}
]

% ---------------- Línea de tiempo ----------------
\draw[-{Latex[length=5pt]}, black!75, line width=0.7pt] (-5,0) -- (39,0);
\foreach \x in {0,6,12,18,24,30,36} {
  \draw[black!75] (\x,-0.15) -- (\x,0.15);
}
\foreach \x/\t in {0/0, 6/6, 12/12, 18/18, 24/24, 30/30, 36/36} {
  \node[et, anchor=north] at (\x,-0.25) {$\t$};
}
\node[et, anchor=north] at (20,-0.72) {meses desde la aprobación};

% ---------------- Antes de la aprobación ----------------
\node[caja, fill=black!14, text width=3.2cm, anchor=south east] (prev) at (-1.2,1.5)
  {\textbf{Acciones previas}\\[1pt] {\scriptsize Medidas que el país ejecuta \textbf{antes} de que el Directorio apruebe nada}};
\draw[flecha] (prev.south east) -- (-0.6,0.15);

% ---------------- Fechas de corte ----------------
\foreach \x in {6,18,30} {
  \draw[black!55, dashed] (\x,0.2) -- (\x,2.0);
}
\node[caja, fill=black!6, text width=4.3cm, anchor=south] (crit) at (12,2.1)
  {\textbf{Criterios de ejecución cuantitativos}\\[1pt] {\scriptsize Reservas internacionales netas mínimas, crédito interno neto máximo, déficit máximo, tope de deuda nueva. Se miden en \textbf{fechas de corte} semestrales}};

\node[caja, fill=black!6, text width=4.3cm, anchor=south] (estr) at (28,2.1)
  {\textbf{Parámetros estructurales y metas indicativas}\\[1pt] {\scriptsize Reformas concretas con fecha, y objetivos de seguimiento que no bloquean el desembolso}};
\draw[flecha] (estr.south) -- (28,0.2);

% ---------------- Revisiones y desembolsos ----------------
\foreach \x/\n in {0/{Aprobación}, 6/{1.ª revisión}, 12/{2.ª}, 18/{3.ª}, 24/{4.ª}, 30/{5.ª}, 36/{6.ª y cierre}} {
  \fill[black!25, draw=black!70] (\x-0.7,-2.4) rectangle (\x+0.7,-1.3);
  \node[et, anchor=north, text width=2.2cm] at (\x,-2.55) {\n};
}
\node[et, anchor=east, text width=2.5cm] at (-2.2,-1.85) {\textbf{Desembolso por tramos}};

% ---------------- Dispensa ----------------
\node[caja, fill=white, text width=4.6cm, anchor=north] (disp) at (10,-4.0)
  {\textbf{Si un criterio se incumple}\\[1pt] {\scriptsize El Directorio concede una \textbf{dispensa} si la desviación es menor o ya se ha corregido; si no, la revisión no se completa y \textbf{el programa descarrila}}};
\draw[flecha] (disp.north) -- (10,-2.5);

\node[caja, fill=black!5, draw=black, line width=0.6pt, text width=6.0cm, anchor=north] at (29,-4.0)
  {\textbf{La condicionalidad no es una promesa: es el calendario del dinero.} Sin revisión completada no hay tramo, y ese es todo el poder coercitivo del Fondo.};
\end{tikzpicture}
