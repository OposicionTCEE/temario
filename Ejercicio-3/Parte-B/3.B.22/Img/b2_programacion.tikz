% Cuerpo, bloque 2 — La programacion financiera en dos paneles: la demanda de dinero fija el tamano
% del balance y la frontera reparte ese tamano entre reservas y credito interno.
\begin{tikzpicture}[>={Stealth[length=2.2mm]}, every node/.style={font=\footnotesize}]

  % ============ (a) la demanda de dinero ============
  \draw[->] (0,0) -- (4.9,0) node[below=2pt, pos=0.97]{$\Delta(PY)$};
  \draw[->] (0,0) -- (0,4.3) node[above=2pt]{$\Delta M$};
  \draw[thick] (0,0) -- (4.3,3.87) node[above right=-1pt]{$\Delta M^{d}=\dfrac{\Delta(PY)}{V}$};
  \draw[dashed] (4.0,0) -- (4.0,3.6) -- (0,3.6);
  \fill (4.0,3.6) circle (1.6pt);
  \node[anchor=east] at (-0.08,3.6) {$\Delta M^{d}$};
  \node[anchor=north] at (2.45,-1.95) {\textbf{(a)} cuánto dinero cabe};

  % ============ hilo entre los dos paneles ============
  \draw[dotted, gray!70] (4.12,3.6) -- (6.48,3.6);

  % ============ (b) la frontera ============
  \begin{scope}[xshift=6.6cm]
    \draw[->] (0,0) -- (4.9,0) node[below=2pt, pos=0.97]{$\Delta DC$};
    \draw[->] (0,0) -- (0,4.3) node[above=2pt]{$\Delta R$};
    \node[anchor=east] at (-0.08,3.6) {$\Delta M^{d}$};
    \draw[thick] (0,3.6) -- (3.6,0);
    \node[anchor=west, align=left] at (2.30,3.15) {$\Delta R+\Delta DC=\Delta M^{d}$};
    \draw[gray!70] (2.25,3.05) -- (1.45,2.25);
    % objetivo de reservas y techo de credito que de el se sigue
    \draw[dashed] (0,0.738) node[anchor=east]{$\Delta R^{*}$} -- (2.862,0.738) -- (2.862,0);
    \fill (2.862,0.738) circle (1.6pt);
    \node[anchor=north] at (2.862,-0.06) {$\overline{\Delta DC}$};
    % reparto del credito
    \draw[decorate, decoration={brace, amplitude=4pt, mirror}] (0,-0.62) -- (1.800,-0.62);
    \draw[decorate, decoration={brace, amplitude=4pt, mirror}] (1.800,-0.62) -- (2.862,-0.62);
    \node[anchor=north east, font=\scriptsize] at (1.74,-0.80) {al sector privado};
    \node[anchor=north west, font=\scriptsize, align=left] at (1.90,-0.80) {al Gobierno:\\[-1pt]techo de déficit};
    \node[anchor=north] at (2.45,-1.95) {\textbf{(b)} entre qué se reparte};
  \end{scope}
\end{tikzpicture}
