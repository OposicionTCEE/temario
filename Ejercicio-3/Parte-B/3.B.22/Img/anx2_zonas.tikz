\begin{tikzpicture}[
  font=\footnotesize,
  caja/.style={draw=black!70, align=center, inner sep=4pt},
  cab/.style={caja, fill=black!18, draw=black, line width=0.6pt, text width=4.5cm, minimum height=1.0cm},
  cel/.style={caja, text width=4.5cm, minimum height=1.55cm},
  flecha/.style={-{Latex[length=4.5pt]}, draw=black!65, line width=0.5pt},
  et/.style={font=\scriptsize, align=right, inner sep=2pt}
]

\def\xa{0}  \def\xb{4.75} \def\xc{9.5}

% ---------------- Cabeceras ----------------
\node[cab, fill=black!8]  (ca) at (\xa,0) {\textbf{Sostenible\\ con alta probabilidad}};
\node[cab, fill=black!18] (cb) at (\xb,0) {\textbf{Sostenible,\\ pero no con alta probabilidad}};
\node[cab, fill=black!32] (cc) at (\xc,0) {\textbf{Insostenible}};

% ---------------- Fila 1: ¿presta el Fondo? ----------------
\node[cel, fill=white] (fa1) at (\xa,-1.55) {Presta sin exigir nada a los acreedores};
\node[cel, fill=white] (fb1) at (\xb,-1.55) {Presta solo si el agujero lo cierra alguien más};
\node[cel, fill=white] (fc1) at (\xc,-1.55) {\textbf{No puede prestar} mientras la deuda siga como está};

% ---------------- Fila 2: ¿qué se exige? ----------------
\node[cel, fill=black!4] (fa2) at (\xa,-3.25) {Nada. El programa se financia con el crédito del Fondo y el ajuste};
\node[cel, fill=black!4] (fb2) at (\xb,-3.25) {\textbf{Reperfilación} de los vencimientos próximos, o garantías de financiación de otros acreedores};
\node[cel, fill=black!4] (fc2) at (\xc,-3.25) {\textbf{Reestructuración}: quita suficiente para devolver la deuda a la zona sostenible};

% ---------------- Etiquetas de fila ----------------
\node[et, anchor=east, text width=2.5cm] at (\xa-2.55,0) {\textbf{Dictamen del análisis de sostenibilidad}};
\node[et, anchor=east, text width=2.5cm] at (\xa-2.55,-1.55) {\textbf{Qué puede hacer el Fondo}};
\node[et, anchor=east, text width=2.5cm] at (\xa-2.55,-3.25) {\textbf{Qué se exige antes}};

% ---------------- Nota ----------------
\node[caja, text width=14.3cm, fill=black!5, draw=black, line width=0.6pt, anchor=north, rounded corners=1.5pt] at (4.75,-4.45)
  {\textbf{El Fondo no es un árbitro neutral en esta decisión.} Como acreedor preferente no asume quitas, de modo que cuanto más preste antes de la reestructuración, mayor habrá de ser el recorte que soporten los demás. Esa es la razón de fondo por la que en 2010 se inventó la exención sistémica para Grecia y por la que se suprimió en 2016: prestar en la zona gris aplaza el problema y agranda la factura de quien acabe pagándolo.};
\end{tikzpicture}
