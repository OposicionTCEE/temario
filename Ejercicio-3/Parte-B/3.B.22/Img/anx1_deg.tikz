\begin{tikzpicture}[
  font=\footnotesize,
  y=0.021cm,
  caja/.style={draw=black!70, rounded corners=1.5pt, align=center, inner sep=4pt},
  et/.style={font=\scriptsize, align=center},
  flecha/.style={-{Latex[length=4.5pt]}, draw=black!65, line width=0.5pt}
]

% ------- panel (a) -------
\def\xa{0}
\fill[black!10, draw=black!70] (\xa-1.05,0) rectangle (\xa-0.15,100);
\fill[black!25, draw=black!70] (\xa+0.15,0) rectangle (\xa+1.05,100);
\node[et, anchor=north] at (\xa,-6) {\textbf{(a) Recién asignados}};
\node[et, anchor=north, text width=4.2cm] at (\xa,-26) {Tenencias $=$ asignación.\\ \textbf{Posición neta nula}: el país ni paga ni cobra, y sus reservas han aumentado sin coste};

% ------- panel (b) -------
\def\xb{5.3}
\fill[black!10, draw=black!70] (\xb-1.05,0) rectangle (\xb-0.15,100);
\fill[black!25, draw=black!70] (\xb+0.15,0) rectangle (\xb+1.05,40);
\draw[dashed, black!60] (\xb+0.15,100) -- (\xb+1.05,100);
\draw[{Latex[length=3.5pt]}-{Latex[length=3.5pt]}, black!70] (\xb+1.25,40) -- (\xb+1.25,100);
\node[et, anchor=west] at (\xb+1.35,70) {$-60$};
\node[et, anchor=north] at (\xb,-6) {\textbf{(b) Tras usarlos}};
\node[et, anchor=north, text width=4.2cm] at (\xb,-26) {Ha vendido $60$ a otro miembro a cambio de divisas.\\ \textbf{Paga el tipo del DEG} sobre la diferencia, sin plazo ni condiciones};

% ------- panel (c) -------
\def\xc{10.6}
\fill[black!10, draw=black!70] (\xc-1.05,0) rectangle (\xc-0.15,100);
\fill[black!25, draw=black!70] (\xc+0.15,0) rectangle (\xc+1.05,160);
\draw[dashed, black!60] (\xc+0.15,100) -- (\xc+1.05,100);
\draw[{Latex[length=3.5pt]}-{Latex[length=3.5pt]}, black!70] (\xc+1.25,100) -- (\xc+1.25,160);
\node[et, anchor=west] at (\xc+1.35,130) {$+60$};
\node[et, anchor=north] at (\xc,-6) {\textbf{(c) El que los recibe}};
\node[et, anchor=north, text width=4.2cm] at (\xc,-26) {Ha entregado divisas y tiene $60$ de más.\\ \textbf{Cobra el tipo del DEG} sobre la diferencia};

% ------- leyenda de barras -------
\node[et, anchor=south] at (\xa-0.6,165) {Asignación};
\node[et, anchor=south] at (\xa+0.6,165) {Tenencias};
\node[et, anchor=south, text width=2.6cm] at (\xa-0.6,178) {{\scriptsize pasivo, fijo}};
\node[et, anchor=south, text width=2.6cm] at (\xa+0.6,178) {{\scriptsize activo, variable}};

\node[caja, text width=13.9cm, anchor=north west, fill=black!5, draw=black, line width=0.6pt] at (-1.3,-105)
  {\textbf{El DEG no es dinero del Fondo ni un crédito contra él:} la asignación crea a la vez un activo y un pasivo del mismo importe, y quien entrega las divisas cuando un país usa sus DEG es \textbf{otro miembro}. Por eso el DEG funciona como una \textbf{línea de crédito perpetua e incondicional entre bancos centrales} al tipo de interés del DEG, y por eso los principales accionistas, que prefieren prestar con condiciones, nunca han querido que crezca.};
\end{tikzpicture}
