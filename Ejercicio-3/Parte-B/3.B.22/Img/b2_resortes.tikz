\begin{tikzpicture}[
  font=\footnotesize,
  x=0.88cm, y=0.72cm,
  caja/.style={draw=black!70, rounded corners=1.5pt, align=left, inner sep=4pt},
  et/.style={font=\scriptsize, align=center, inner sep=1.5pt},
  flecha/.style={-{Latex[length=4.5pt]}, draw=black!65, line width=0.5pt}
]

% ---- ejes ----
\draw[black!75, -{Latex[length=5pt]}] (0,0) -- (0,10.3) node[anchor=south east, font=\scriptsize] {$e$};
\draw[black!75, -{Latex[length=5pt]}] (0,0) -- (10.4,0) node[anchor=north east, font=\scriptsize] {divisas};

% ---- curvas ----
\draw[black, line width=0.9pt] (1,1) -- (9.3,9.3) node[anchor=south west, font=\scriptsize] {$S$};
\draw[black, line width=0.9pt] (1,9) -- (9.3,0.7) node[anchor=north west, font=\scriptsize] {$D_0$};
\draw[black!55, dashed, line width=0.7pt] (1,5) -- (5.3,0.7) node[anchor=north west, font=\scriptsize] {$D_1$};

% ---- paridad y puntos ----
\draw[black!70, dotted, line width=0.7pt] (0,3) -- (7,3);
\node[et, anchor=east] at (-0.1,3) {$e_0$};
\draw[black!55, dotted, line width=0.7pt] (0,5) -- (5,5);
\node[et, anchor=east] at (-0.1,5) {$e_1$};

\fill[black] (3,3) circle (2.2pt); \node[et, anchor=south east] at (3.0,3.15) {$A$};
\fill[black] (7,3) circle (2.2pt); \node[et, anchor=south west] at (7.1,3.1) {$B$};
\fill[black!55] (5,5) circle (2.0pt); \node[et, anchor=south west, text=black!55] at (5.1,5.1) {$E_1$};

% ---- la financiación cubre la brecha ----
\draw[line width=3.2pt, black!30] (3,3) -- (7,3);
\draw[{Latex[length=4pt]}-{Latex[length=4pt]}, black, line width=0.8pt] (3,3) -- (7,3);
\node[et, anchor=north, fill=white, text width=3.0cm] at (5,2.55) {\textbf{lo que cubre el Fondo} con reservas ajenas};

% ---- los dos movimientos que exige a cambio ----
\draw[flecha] (6.3,6.3) -- (4.1,4.4);
\node[et, anchor=west, text width=1.7cm] at (6.4,6.5) {$D_0\to D_1$};
\draw[flecha] (0.4,3.15) -- (0.4,4.85);
\node[et, anchor=west, text width=1.4cm] at (0.5,5.6) {$e_0\to e_1$};

% ---- las tres acciones ----
\node[caja, text width=4.4cm, fill=black!8, anchor=north west] at (11.0,10.1)
  {\textbf{Antes: supervisar}\\[2pt] {\scriptsize Diagnosticar y advertir \textbf{para que la brecha no llegue a abrirse}. No obliga a nada: funciona por información y por reputación}};

\node[caja, text width=4.4cm, fill=black!16, draw=black, line width=0.6pt, anchor=north west] at (11.0,6.7)
  {\textbf{Durante: financiar}\\[2pt] {\scriptsize Cubrir $A\,$-$\,B$ con reservas ajenas. \textbf{No cierra la brecha: compra tiempo} para que se cierre de otro modo}};

\node[caja, text width=4.4cm, fill=black!8, anchor=north west] at (11.0,3.3)
  {\textbf{A cambio: condicionar}\\[2pt] {\scriptsize Comprometer los movimientos que sí la cierran, $D_0\to D_1$ y, si hace falta, $e_0\to e_1$. \textbf{El precio del tiempo comprado}}};

\node[caja, text width=15.1cm, fill=black!5, draw=black, line width=0.6pt, anchor=north west] at (-0.6,-0.9)
  {\textbf{Prevenir es que la brecha no se abra; resolver es cubrirla mientras se cierra.} El Fondo es el único que puede hacer lo segundo, y precisamente por eso está en condiciones de exigir lo primero: toda su influencia sobre la política económica de un país nace de que puede entregarle el único margen que nadie se da a sí mismo.};
\end{tikzpicture}
