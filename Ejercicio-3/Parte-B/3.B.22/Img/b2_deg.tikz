% Cuerpo, bloque 2 — La mecanica del DEG: la asignacion es una linea fija y las tenencias se mueven
% por encima o por debajo de ella; la diferencia es lo que se cobra o se paga.
\begin{tikzpicture}[>={Stealth[length=2.2mm]}, every node/.style={font=\footnotesize}]

  % ================= (a) al recibir la asignacion =================
  \draw[->] (0,0) -- (0,4.3) node[above=2pt, align=center]{tenencias\\[-2pt]de DEG};
  \draw (0,0) -- (3.2,0);
  \fill[gray!35, draw=black] (0.45,0) rectangle (1.25,2.4);
  \fill[gray!35, draw=black] (1.95,0) rectangle (2.75,2.4);
  \draw[dashed] (-0.15,2.4) -- (3.3,2.4);
  \node[anchor=south east] at (3.3,2.45) {\scriptsize asignación};
  \node[anchor=north] at (0.85,-0.08) {país $A$};
  \node[anchor=north] at (2.35,-0.08) {país $B$};
  \node[anchor=north] at (1.6,-1.65) {\textbf{(a)} al recibir la asignación};

  % ================= (b) cuando A vende DEG a B =================
  \begin{scope}[xshift=5.6cm]
    \draw[->] (0,0) -- (0,4.3) node[above=2pt, align=center]{tenencias\\[-2pt]de DEG};
    \draw (0,0) -- (3.2,0);
    \fill[gray!35, draw=black] (0.45,0) rectangle (1.25,1.2);
    \draw[gray!55, dashed] (0.45,1.2) rectangle (1.25,2.4);
    \fill[gray!35, draw=black] (1.95,0) rectangle (2.75,2.4);
    \fill[gray!18, draw=black] (1.95,2.4) rectangle (2.75,3.6);
    \draw[dashed] (-0.15,2.4) -- (3.3,2.4);
    \node[anchor=south east] at (3.3,2.45) {\scriptsize asignación};
    \node[anchor=north, align=center] at (0.85,-0.08) {país $A$\\[-2pt]\scriptsize paga el tipo\\[-2pt]\scriptsize del DEG};
    \node[anchor=north, align=center] at (2.35,-0.08) {país $B$\\[-2pt]\scriptsize cobra el tipo\\[-2pt]\scriptsize del DEG};
    \draw[->] (1.0,4.0) -- (2.2,4.0) node[midway, above=0pt]{\scriptsize DEG};
    \draw[->] (2.2,3.25) -- (1.0,3.25) node[midway, above=0pt]{\scriptsize divisas};
    \node[anchor=north] at (1.6,-1.65) {\textbf{(b)} cuando $A$ vende DEG a $B$};
  \end{scope}
\end{tikzpicture}
