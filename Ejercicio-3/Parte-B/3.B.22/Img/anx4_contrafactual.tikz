\begin{tikzpicture}[
  font=\footnotesize,
  x=1.05cm, y=0.42cm,
  caja/.style={draw=black!70, rounded corners=1.5pt, align=center, inner sep=4pt},
  et/.style={font=\scriptsize, align=left, inner sep=2pt},
  flecha/.style={-{Latex[length=4pt]}, draw=black!60, line width=0.5pt}
]

% ---- ejes ----
\draw[black!70, -{Latex[length=5pt]}] (-3.4,2) -- (7.4,2) node[et, anchor=north west, pos=1] {tiempo};
\draw[black!70, -{Latex[length=5pt]}] (-3.4,2) -- (-3.4,12) node[et, anchor=south west, text width=1.9cm, pos=1] {producto};

\draw[black!60, dashed] (0,2) -- (0,11.4);
\node[et, anchor=south, align=center] at (0,11.5) {se firma\\ el programa};

% ---- senda observada ----
\draw[black, line width=1.0pt] (-3,9) -- (-2,8.6) -- (-1,7.8) -- (0,6.6) -- (1,5.9) -- (2,5.7) -- (3,6.3) -- (4,7.1) -- (5,7.9) -- (6,8.6);
\node[et, anchor=west] at (6.1,8.7) {\textbf{A.} Lo observado:\\ el país con programa};

% ---- comparación ingenua ----
\draw[black!65, dashed, line width=0.9pt] (-3,9.4) -- (0,9.7) -- (3,10.3) -- (6,10.9);
\node[et, anchor=west] at (6.1,10.9) {\textbf{B.} Países que no\\ pidieron programa};

% ---- contrafactual ----
\draw[black!70, dotted, line width=1.1pt] (0,6.6) -- (1,4.6) -- (2,3.4) -- (3,3.6) -- (4,4.4) -- (5,5.3) -- (6,6.1);
\node[et, anchor=west] at (6.1,5.8) {\textbf{C.} El mismo país\\ sin financiación};

% ---- anotaciones ----
\node[caja, text width=3.3cm, fill=black!5, anchor=north west] at (-3.25,6.4)
  {{\scriptsize \textbf{El sesgo de selección}\\ Quien acude al Fondo ya venía cayendo: comparar A con B es comparar enfermos con sanos}};

\node[caja, text width=4.1cm, fill=black!10, anchor=north west] (cf) at (1.0,9.5)
  {{\scriptsize \textbf{El contrafactual que importa}\\ No es \textit{no haber tenido programa}, sino \textbf{no haber tenido financiación}, que casi siempre es peor}};
\draw[flecha] (cf.south) -- (1.9,3.9);

\node[caja, text width=14.0cm, fill=black!5, draw=black, line width=0.6pt, anchor=north west] at (-3.4,1.3)
  {\textbf{Casi toda la discusión empírica sobre el Fondo consiste en construir C, que por definición no se observa.} De ahí las variables instrumentales, el emparejamiento por probabilidad de recibir programa y los controles sintéticos; y de ahí también que los resultados cambien tanto con el método, porque cada uno construye un contrafactual distinto.};
\end{tikzpicture}
