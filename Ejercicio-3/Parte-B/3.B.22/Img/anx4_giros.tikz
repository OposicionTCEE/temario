\begin{tikzpicture}[
  font=\footnotesize,
  cel/.style={draw=black!70, rounded corners=1.5pt, align=left, inner sep=4pt, text width=3.75cm, minimum height=2.6cm, anchor=north west},
  cab/.style={draw=black, line width=0.6pt, rounded corners=1.5pt, align=center, inner sep=4pt, text width=3.75cm, fill=black!18, anchor=north west},
  fila/.style={align=center, text width=2.1cm, anchor=north west, font=\footnotesize},
  flecha/.style={-{Latex[length=4pt]}, draw=black!55, line width=0.5pt}
]

\def\xa{2.4} \def\xb{6.45} \def\xc{10.5}

\node[cab] at (\xa,0.9) {\textbf{La doctrina anterior}};
\node[cab] at (\xb,0.9) {\textbf{El golpe de realidad}};
\node[cab] at (\xc,0.9) {\textbf{La doctrina de hoy}};

% ---------- Fila 1 ----------
\node[fila] at (0,-0.6) {\textbf{Flujos de capital}};
\node[cel, fill=white] at (\xa,-0.2) {{\scriptsize Liberalizar siempre y cuanto antes. En 1997 se propuso incluir la liberalización de la cuenta financiera entre los fines del Convenio}};
\node[cel, fill=black!6] at (\xb,-0.2) {{\scriptsize La crisis asiática, ese mismo año: los países que más se habían abierto fueron los que peor lo pasaron. La enmienda se abandonó}};
\node[cel, fill=black!12] at (\xc,-0.2) {{\scriptsize Visión Institucional (2012, revisada en 2022): los controles son un instrumento legítimo en circunstancias acotadas, y cabe usarlos de forma preventiva}};

% ---------- Fila 2 ----------
\node[fila] at (0,-3.4) {\textbf{Ajuste fiscal}};
\node[cel, fill=white] at (\xa,-3.0) {{\scriptsize Multiplicadores en torno a $0{,}5$: consolidar frena poco la actividad, y la confianza compensa parte de lo que frena}};
\node[cel, fill=black!6] at (\xb,-3.0) {{\scriptsize BLANCHARD y LEIGH (2013), desde la propia casa: el error de previsión de crecimiento era mayor cuanto mayor el ajuste previsto}};
\node[cel, fill=black!12] at (\xc,-3.0) {{\scriptsize El ritmo y la composición del ajuste importan tanto como su tamaño, y cabe el gradualismo cuando hay financiación que lo permita}};

% ---------- Fila 3 ----------
\node[fila] at (0,-6.2) {\textbf{Alcance del mandato}};
\node[cel, fill=white] at (\xa,-5.8) {{\scriptsize Lo distributivo, lo social y lo ambiental no son asunto de un fondo monetario}};
\node[cel, fill=black!6] at (\xb,-5.8) {{\scriptsize Su propia investigación: la desigualdad daña el crecimiento (OSTRY, BERG y TSANGARIDES, 2014) y el artículo sobre el neoliberalismo sobrevendido (2016)}};
\node[cel, fill=black!12] at (\xc,-5.8) {{\scriptsize Desigualdad, género y clima entran por la vía de la macrocriticidad, y con ellos la acusación de extralimitación}};

\foreach \y in {-1.5,-4.3,-7.1} {
  \draw[flecha] (\xa+3.85,\y) -- (\xb-0.1,\y);
  \draw[flecha] (\xb+3.85,\y) -- (\xc-0.1,\y);
}

\node[draw=black, line width=0.6pt, rounded corners=1.5pt, align=center, inner sep=5pt, text width=14.2cm, fill=black!5, anchor=north west] at (0.1,-8.7)
  {\textbf{El patrón se repite en los tres casos: el Fondo rectifica cuando su propia investigación contradice su doctrina, y casi nunca cuando se lo exigen desde fuera.} Es su rasgo institucional más valioso, porque pocas organizaciones publican la evidencia que las desmiente; y es también el que desconcierta a sus críticos, que suelen seguir discutiendo con una doctrina que el Fondo ya ha abandonado.};
\end{tikzpicture}
