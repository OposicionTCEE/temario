\begin{tikzpicture}[
  font=\footnotesize,
  cel/.style={draw=black!70, align=left, inner sep=4pt, text width=5.3cm, minimum height=1.5cm, anchor=north west},
  cab/.style={draw=black, line width=0.6pt, align=center, inner sep=4pt, text width=5.3cm, fill=black!18, anchor=north west},
  fila/.style={align=center, inner sep=3pt, text width=2.6cm, anchor=north west, font=\footnotesize\bfseries}
]

\def\xa{2.9} \def\xb{8.5}

\node[cab] at (\xa,1.0) {\textbf{Un Fondo concentrado}};
\node[cab] at (\xb,1.0) {\textbf{Un Fondo amplio}};

\node[fila] at (0,-0.25) {Qué haría};
\node[cel, fill=white] at (\xa,0) {{\scriptsize Volver al núcleo: estabilidad macroeconómica, sector exterior y crisis de balanza de pagos. Dejar el clima y el desarrollo a los bancos multilaterales}};
\node[cel, fill=white] at (\xb,0) {{\scriptsize Tratar como macrocrítico todo lo que afecte a la estabilidad: clima, desigualdad, gobernanza, pandemias, y prestar a veinte años si hace falta}};

\node[fila] at (0,-2.0) {Qué gana};
\node[cel, fill=black!5] at (\xa,-1.75) {{\scriptsize Autoridad en aquello que sabe hacer y menos frentes abiertos con sus accionistas}};
\node[cel, fill=black!5] at (\xb,-1.75) {{\scriptsize Responde a problemas reales que ninguna otra institución cubre con su capacidad técnica y su alcance universal}};

\node[fila] at (0,-3.75) {Qué pierde};
\node[cel, fill=black!5] at (\xa,-3.5) {{\scriptsize Influencia y financiación de los donantes, y la posibilidad de actuar sobre riesgos que acabarán siendo macroeconómicos}};
\node[cel, fill=black!5] at (\xb,-3.5) {{\scriptsize Foco, competencia técnica y legitimidad: una institución que opina de todo se expone a hacerlo peor y a desgastar la autoridad que tiene}};

\node[fila] at (0,-5.5) {Quién lo defiende};
\node[cel, fill=black!12] at (\xa,-5.25) {{\scriptsize Su mayor accionista y una parte del Directorio, por razones distintas: unos por doctrina, otros por coste}};
\node[cel, fill=black!12] at (\xb,-5.25) {{\scriptsize La gerencia, el personal de estudios y los donantes europeos que financian buena parte de esa agenda}};

\node[draw=black, line width=0.6pt, rounded corners=1.5pt, align=center, inner sep=5pt, text width=13.8cm, fill=black!5, anchor=north west] at (0,-7.3)
  {\textbf{La elección no es doctrinal, es presupuestaria y política:} el Fondo amplio necesita recursos que solo aportan quienes defienden esa agenda, y el Fondo concentrado necesita una legitimidad que solo daría la reforma de cuotas que lleva quince años bloqueada. \textbf{Las dos salidas dependen de lo mismo: de que sus accionistas se pongan de acuerdo sobre el reparto del poder.}};
\end{tikzpicture}
