% Cuerpo, bloque 3 — Las dos salidas del problema del mandato chocan con el mismo muro:
% el reparto del poder entre los accionistas.
\begin{tikzpicture}[>={Stealth[length=2.6mm]}, every node/.style={font=\footnotesize}]

  % ---- de donde se parte ----
  \fill (1.45,2.1) circle (2.0pt);
  \node[anchor=east] at (1.30,2.1) {el Fondo hoy};

  % ---- las dos salidas ----
  \draw[->, thick] (1.60,2.25) -- (5.30,3.75);
  \draw[->, thick] (1.60,1.95) -- (5.30,0.45);

  \node[anchor=south east, align=right] at (5.25,3.88)
    {\textbf{un Fondo concentrado}\\[-2pt]\scriptsize volver al núcleo macroeconómico};
  \node[anchor=north east, align=right] at (5.25,0.32)
    {\textbf{un Fondo amplio}\\[-2pt]\scriptsize todo lo que afecte a la estabilidad};

  % ---- el mismo muro ----
  \fill[gray!35, draw=black] (5.45,-0.25) rectangle (6.05,4.55);
  \node[rotate=90, font=\scriptsize] at (5.75,2.15) {el reparto del poder entre los accionistas};

  \node[anchor=west, align=left, font=\scriptsize] at (6.20,3.75)
    {le falta la legitimidad\\[-2pt]que daría la reforma de cuotas};
  \node[anchor=west, align=left, font=\scriptsize] at (6.20,0.45)
    {le faltan los recursos\\[-2pt]que solo aportan los donantes};
\end{tikzpicture}
