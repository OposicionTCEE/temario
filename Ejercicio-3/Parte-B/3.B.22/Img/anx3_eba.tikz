\begin{tikzpicture}[
  font=\footnotesize,
  paso/.style={draw=black!70, rounded corners=1.5pt, align=center, inner sep=4pt, text width=2.45cm, minimum height=2.5cm},
  flecha/.style={-{Latex[length=4.5pt]}, draw=black!65, line width=0.6pt},
  et/.style={font=\scriptsize, align=center, inner sep=2pt}
]

\node[paso, fill=black!14] (p1) at (0,0)
  {\textbf{1. Observado}\\[2pt] {\scriptsize Saldo corriente del año}\\[2pt] $-5{,}0$};
\node[paso, fill=white] (p2) at (3.0,0)
  {\textbf{2. Ajustado}\\[2pt] {\scriptsize Se depura el ciclo y lo transitorio}\\[2pt] $-4{,}2$};
\node[paso, fill=white] (p3) at (6.0,0)
  {\textbf{3. Norma}\\[2pt] {\scriptsize Saldo coherente con los fundamentos, estimado en panel}\\[2pt] $-1{,}5$};
\node[paso, fill=black!8] (p4) at (9.0,0)
  {\textbf{4. Brecha}\\[2pt] {\scriptsize Ajustado menos norma}\\[2pt] $-2{,}7$};
\node[paso, fill=black!14] (p5) at (12.0,0)
  {\textbf{5. Brecha cambiaria}\\[2pt] {\scriptsize Brecha dividida por la elasticidad}\\[2pt] sobrevaloración};

\foreach \a/\b in {p1/p2, p2/p3, p3/p4, p4/p5} { \draw[flecha] (\a) -- (\b); }

\node[et, anchor=north, text width=3.1cm] at (4.5,-1.55) {\textit{la parte discutible: la norma se estima}};

\node[draw=black!70, rounded corners=1.5pt, align=center, inner sep=4pt, text width=5.6cm, fill=black!4, anchor=north] (desc) at (9.0,-2.1)
  {\textbf{La brecha se descompone}\\[2pt] {\scriptsize Brecha de políticas propias ($-1{,}2$), de políticas ajenas ($-0{,}6$) y \textbf{residuo} ($-0{,}9$), que es lo que el modelo no explica}};
\draw[flecha] (p4.south) -- (desc.north);

\node[draw=black, line width=0.6pt, rounded corners=1.5pt, align=center, inner sep=5pt, text width=14.2cm, fill=black!5, anchor=north] at (6.0,-4.3)
  {\textbf{Lo que hace útil al método es que obliga a decir frente a qué se mide el desequilibrio;} lo que lo hace discutible es que la norma es una estimación y el residuo suele ser tan grande como la propia brecha. Por eso la valoración final del sector exterior la firma el personal y se publica para todos los países a la vez, de modo que las brechas sumen aproximadamente cero: el superávit de uno es el déficit de otro.};
\end{tikzpicture}
