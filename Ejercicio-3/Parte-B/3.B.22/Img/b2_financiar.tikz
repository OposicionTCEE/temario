\begin{tikzpicture}[
  font=\footnotesize,
  cel/.style={draw=black!70, align=center, inner sep=4pt, text width=3.5cm, minimum height=0.95cm, anchor=north west},
  fila/.style={draw=black!70, align=left, inner sep=4pt, text width=6.2cm, minimum height=0.95cm, anchor=north west},
  cab/.style={draw=black, line width=0.6pt, align=center, inner sep=4pt, text width=3.5cm, fill=black!18, anchor=north west},
  et/.style={font=\scriptsize, align=center, inner sep=2pt}
]

\def\xa{6.35} \def\xb{10.0}

\node[cab, text width=6.2cm, anchor=north west] at (0,1.0) {\textbf{El mismo país, el mismo año}};
\node[cab] at (\xa,1.0) {\textbf{Sin financiación}};
\node[cab] at (\xb,1.0) {\textbf{Con el Fondo}};

\node[fila, fill=black!10] at (0,0) {Objetivo de reservas netas};
\node[cel, fill=white] at (\xa,0) {$+20$};
\node[cel, fill=black!6] at (\xb,0) {$+5$};

\node[fila, fill=black!10] at (0,-1.0) {Techo de crédito interno};
\node[cel, fill=white] at (\xa,-1.0) {$+4{,}4$};
\node[cel, fill=black!6] at (\xb,-1.0) {$+19{,}4$};

\node[fila, fill=black!10] at (0,-2.0) {Crédito del banco central al Gobierno};
\node[cel, fill=white] at (\xa,-2.0) {$-7{,}8$};
\node[cel, fill=black!6] at (\xb,-2.0) {$+7{,}2$};

\node[fila, fill=black!10] at (0,-3.0) {Déficit público máximo, \% del PIB};
\node[cel, fill=white] at (\xa,-3.0) {$1{,}1$};
\node[cel, fill=black!6] at (\xb,-3.0) {$2{,}4$};

\node[fila, fill=black!16] at (0,-4.0) {\textbf{Ajuste fiscal del primer año}, puntos de PIB};
\node[cel, fill=white] at (\xa,-4.0) {$\mathbf{4{,}9}$};
\node[cel, fill=black!6] at (\xb,-4.0) {$\mathbf{3{,}6}$};

\node[fila, fill=black!16] at (0,-5.0) {\textbf{Mejora exigida a la cuenta corriente}};
\node[cel, fill=white] at (\xa,-5.0) {$\mathbf{30}$};
\node[cel, fill=black!6] at (\xb,-5.0) {$\mathbf{15}$};

\node[draw=black, line width=0.6pt, rounded corners=1.5pt, align=center, inner sep=5pt, text width=13.3cm, fill=black!5, anchor=north west] at (0,-6.4)
  {\textbf{La financiación no sustituye al ajuste: lo reparte en el tiempo.} La mejora de treinta en la cuenta corriente sigue siendo necesaria; lo que cambia es que se hará en tres años en lugar de en uno. Y como hay que devolver lo prestado, el propio calendario de la devolución obliga a completarla.};
\end{tikzpicture}
