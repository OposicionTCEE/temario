% Cuerpo, bloque 2 — La misma frontera del balance: con financiacion del Fondo el pais puede
% apuntar a un objetivo de reservas mas bajo (de A a B) y le queda mas credito interno.
\begin{tikzpicture}[>={Stealth[length=2.2mm]}, every node/.style={font=\footnotesize}]
  \draw[->] (0,0) -- (6.1,0) node[below=2pt, pos=0.97]{$\Delta DC$};
  \draw[->] (0,0) -- (0,5.3) node[above=2pt]{$\Delta R$};
  \node[anchor=east] at (-0.08,4.5) {$\Delta M^{d}$};
  \draw[thick] (0,4.5) -- (4.5,0);

  % los dos objetivos de reservas
  \draw[dashed] (0,3.689) -- (0.811,3.689) -- (0.811,0);
  \draw[dashed] (0,0.923) -- (3.578,0.923) -- (3.578,0);
  \fill (0.811,3.689) circle (1.8pt);
  \node[anchor=south west] at (0.87,3.73) {$A$};
  \fill (3.578,0.923) circle (1.8pt);
  \node[anchor=south west] at (3.64,0.97) {$B$};

  % el movimiento a lo largo de la frontera
  \draw[->, thick] (1.25,3.55) -- (3.35,1.45);
  \node[anchor=south west, align=left] at (2.52,2.72) {\scriptsize el desembolso\\[-2pt]\scriptsize del Fondo};

  % lo que cambia en cada eje
  \draw[<->] (0.33,0.923) -- (0.33,3.689);
  \node[anchor=west, align=left] at (0.45,2.31) {\scriptsize menos reservas\\[-2pt]\scriptsize que acumular};
  \draw[<->] (0.811,0.33) -- (3.578,0.33);
  \node[anchor=south] at (2.19,0.40) {\scriptsize más crédito interno};

  % el tramo que ya tiene dueno
  \draw[line width=3.5pt, gray!45] (0,-0.17) -- (2.250,-0.17);
  \node[anchor=north] at (1.125,-0.33) {\scriptsize crédito al sector privado};
\end{tikzpicture}
