\begin{tikzpicture}[
  font=\footnotesize,
  et/.style={draw=black!70, rounded corners=1.5pt, align=left, inner sep=4pt, text width=3.25cm, minimum height=3.5cm, anchor=north west},
  flecha/.style={-{Latex[length=4.5pt]}, draw=black!55, line width=0.5pt}
]

\def\dx{3.65}

% ---------- Fila 1 ----------
\node[et, fill=black!14] at (0*\dx,0)
  {\textbf{1944-1958}\\ \textit{El Fondo que no prestaba}\\[3pt] {\scriptsize \textbf{Objeto:} vigilar unas paridades que aún no existían, porque las monedas europeas no eran convertibles}\\[2pt] {\scriptsize \textbf{Quién pedía:} casi nadie; el Plan Marshall hizo el trabajo}};
\node[et, fill=black!10] at (1*\dx,0)
  {\textbf{1958-1971}\\ \textit{El sistema en marcha}\\[3pt] {\scriptsize \textbf{Objeto:} defender las paridades y financiar desequilibrios temporales}\\[2pt] {\scriptsize \textbf{Quién pedía:} Europa y el Reino Unido}\\[2pt] {\scriptsize \textbf{Novedad:} AGP (1962) y el DEG (1969)}};
\node[et, fill=black!6] at (2*\dx,0)
  {\textbf{1971-1982}\\ \textit{Sin objeto}\\[3pt] {\scriptsize \textbf{Objeto:} desaparecen las paridades; queda una supervisión recién inventada}\\[2pt] {\scriptsize \textbf{Quién pedía:} los países en desarrollo; la banca privada recicló los petrodólares sin el Fondo}};
\node[et, fill=black!10] at (3*\dx,0)
  {\textbf{1982-1989}\\ \textit{La crisis de la deuda}\\[3pt] {\scriptsize \textbf{Objeto:} evitar el impago en cadena y organizar el ajuste}\\[2pt] {\scriptsize \textbf{Quién pedía:} América Latina}\\[2pt] {\scriptsize \textbf{Novedad:} préstamo concertado y ajuste estructural}};

% ---------- Fila 2 ----------
\node[et, fill=black!10] at (0*\dx,-4.2)
  {\textbf{1989-1999}\\ \textit{Transición y capitales}\\[3pt] {\scriptsize \textbf{Objeto:} construir economías de mercado y apagar crisis de cuenta financiera}\\[2pt] {\scriptsize \textbf{Quién pedía:} el antiguo bloque soviético, México, Asia}};
\node[et, fill=black!6] at (1*\dx,-4.2)
  {\textbf{2000-2007}\\ \textit{La irrelevancia}\\[3pt] {\scriptsize \textbf{Objeto:} discutido dentro y fuera de la casa}\\[2pt] {\scriptsize \textbf{Quién pedía:} casi nadie}\\[2pt] {\scriptsize \textbf{Novedad:} en 2008 recorta presupuesto y pierde casi quinientos empleados por falta de ingresos}};
\node[et, fill=black!14] at (2*\dx,-4.2)
  {\textbf{2008-2012}\\ \textit{El regreso}\\[3pt] {\scriptsize \textbf{Objeto:} gestor de crisis sistémicas}\\[2pt] {\scriptsize \textbf{Quién pedía:} Europa, incluida la zona del euro}\\[2pt] {\scriptsize \textbf{Novedad:} el G20 triplica sus recursos; nace la FCL}};
\node[et, fill=black!10] at (3*\dx,-4.2)
  {\textbf{2013-2026}\\ \textit{Fragmentación}\\[3pt] {\scriptsize \textbf{Objeto:} prevención, deuda de renta baja, clima}\\[2pt] {\scriptsize \textbf{Quién pedía:} Argentina, Ucrania, Egipto, Pakistán}\\[2pt] {\scriptsize \textbf{Novedad:} RST, Marco Común y la revisión de cuotas atascada}};

\draw[flecha] (3.25,-1.75) -- (3.65,-1.75);
\draw[flecha] (6.90,-1.75) -- (7.30,-1.75);
\draw[flecha] (10.55,-1.75) -- (10.95,-1.75);
\draw[flecha] (3.25,-5.95) -- (3.65,-5.95);
\draw[flecha] (6.90,-5.95) -- (7.30,-5.95);
\draw[flecha] (10.55,-5.95) -- (10.95,-5.95);

\node[draw=black, line width=0.6pt, rounded corners=1.5pt, align=center, inner sep=5pt, text width=14.2cm, fill=black!5, anchor=north west] at (0,-8.0)
  {\textbf{La institución ha cambiado de objeto tres veces y de clientela cuatro.} Nació para vigilar un sistema de paridades que se deshizo en 1973; sobrevivió convirtiéndose en gestor de crisis de deuda y después de crisis de cuenta financiera; y hoy discute si su objeto incluye el clima y la desigualdad. Que siga en pie no se explica por su mandato, sino por su capacidad para encontrarse uno nuevo.};
\end{tikzpicture}
