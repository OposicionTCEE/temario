\begin{tikzpicture}[
  font=\footnotesize,
  caja/.style={draw=black!70, rounded corners=1.5pt, align=center, inner sep=4pt},
  actor/.style={caja, text width=3.2cm, minimum height=2.7cm},
  arriba/.style={caja, fill=black!4},
  may/.style={caja, text width=4.4cm, minimum height=1.3cm, fill=black!5},
  flecha/.style={-{Latex[length=4.5pt]}, draw=black!65, line width=0.5pt},
  discont/.style={-{Latex[length=4.5pt]}, draw=black!55, dashed, line width=0.5pt},
  et/.style={font=\scriptsize, align=center, inner sep=1.5pt}
]

\node[actor] (staff) at (-5.8,0) {\textbf{Personal técnico}\\ $\approx 3.100$ economistas\\[3pt] Diagnostica, negocia con el país y redacta el documento.\\[2pt] \textit{Tiene la iniciativa}};
\node[actor] (ger)   at (-1.93,0) {\textbf{Gerencia}\\ Directora Gerente\\ y cuatro subdirectores\\[3pt] Preside el Directorio y fija el orden del día.\\[2pt] \textit{Filtra lo que se somete}};
\node[actor] (dir)   at (1.93,0)  {\textbf{Directorio Ejecutivo}\\ $25$ sillas, residente\\[3pt] Varias veces por semana: programas, consultas del art. IV y políticas.\\[2pt] \textit{Decide}};
\node[actor] (junta) at (5.8,0)  {\textbf{Junta de Gobernadores}\\ $191$ miembros\\[3pt] Una vez al año y por correo: cuotas, DEG, enmiendas, admisión.\\[2pt] \textit{Refrenda lo reservado}};

\draw[flecha] (staff) -- (ger);
\draw[flecha] (ger) -- (dir);
\draw[flecha] (dir) -- (junta);

\node[arriba, text width=4.3cm] (cmfi) at (1.1,2.75) {\textbf{CMFI}\\ $25$ ministros y gobernadores,\\ dos veces al año\\[2pt] Sin poder formal: su comunicado\\ fija el programa de trabajo};
\node[arriba, text width=3.2cm] (g20)  at (6.3,2.75) {\textbf{G7} (1975) y \textbf{G20} (2009)\\[2pt] La orientación que\\ ya no da el CMFI};
\draw[flecha] (cmfi) -- (dir);
\draw[discont] (g20) -- node[et, above] {desplazan} (cmfi);

\node[may] (m1) at (-5.0,-2.8) {\textbf{Mayoría simple}\\ La regla general: casi todo lo que decide el Directorio};
\node[may] (m2) at (0,-2.8)    {\textbf{$70\%$ de los votos}\\ Tipo de cargo, remuneración y otras decisiones financieras};
\node[may] (m3) at (5.0,-2.8)  {\textbf{$85\%$ de los votos}\\ Cuotas, asignaciones de DEG, venta de oro y enmiendas};

\node[caja, text width=14.3cm, fill=black!8, draw=black, line width=0.6pt] (veto) at (0,-4.45)
  {\textbf{El veto:} con el $16{,}49\%$ de los votos, \textbf{Estados Unidos puede bloquear por sí solo} todo lo que exige el $85\%$, que es justo lo que cambia la institución. Ningún otro miembro llega al $15\%$; la Unión Europea lo supera sumada, pero vota repartida entre varias sillas.};
\draw[flecha] (m3) -- (veto);
\end{tikzpicture}
