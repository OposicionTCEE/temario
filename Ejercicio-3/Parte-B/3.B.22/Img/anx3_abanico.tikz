\begin{tikzpicture}[
  font=\footnotesize,
  caja/.style={draw=black!70, rounded corners=1.5pt, align=center, inner sep=4pt},
  et/.style={font=\scriptsize, align=center, inner sep=2pt},
  flecha/.style={-{Latex[length=4pt]}, draw=black!65, line width=0.5pt}
]

% ======== Panel (a): abanico de la deuda ========
\begin{scope}[yshift=-0.58cm, x=1.42cm, y=0.088cm]
  \fill[black!10] (0,60) -- (1,67) -- (2,73) -- (3,79) -- (4,84) -- (5,88)
    -- (5,58) -- (4,60) -- (3,61) -- (2,61) -- (1,61) -- cycle;
  \fill[black!22] (0,60) -- (1,65.5) -- (2,70) -- (3,74.5) -- (4,78) -- (5,80.5)
    -- (5,65.5) -- (4,66) -- (3,65.5) -- (2,64) -- (1,62.5) -- cycle;
  \draw[black, line width=0.9pt] (0,60) -- (1,64) -- (2,67) -- (3,70) -- (4,72) -- (5,73);
  \draw[black!75, dashed, line width=0.6pt] (0,70) -- (5.3,70);
  \node[et, anchor=west] at (5.35,70) {umbral};
  \draw[black!70] (0,55) -- (0,91);
  \draw[black!70] (0,55) -- (5.3,55);
  \foreach \y in {60,70,80,90} { \draw[black!70] (-0.06,\y) -- (0,\y); \node[et, anchor=east] at (-0.08,\y) {$\y$}; }
  \node[et, anchor=north west, text width=3.4cm] at (0.1,90) {\textbf{(a) Deuda pública, \% del PIB}};
  \node[et, anchor=west] at (1.15,61.5) {escenario base};
  \draw[flecha] (1.1,62.2) -- (0.92,63.6);
\end{scope}

% ======== Panel (b): necesidades brutas de financiación ========
\begin{scope}[yshift=0.10cm, x=1.42cm, y=0.185cm]
  \foreach \x/\h in {1/12, 2/14, 3/17, 4/16, 5/14} {
    \fill[black!25, draw=black!70] (\x-0.22,0) rectangle (\x+0.22,\h);
    \node[et, anchor=south] at (\x,\h) {$\h$};
  }
  \draw[black!75, dashed, line width=0.6pt] (0,15) -- (5.3,15);
  \node[et, anchor=west] at (5.35,15) {umbral};
  \draw[black!70] (0,0) -- (0,20.5);
  \draw[black!70] (0,0) -- (5.3,0);
  \foreach \x in {1,2,3,4,5} { \node[et, anchor=north] at (\x,-0.4) {$t+\x$}; }
  \node[et, anchor=north west, text width=4.6cm] at (0.1,20.3) {\textbf{(b) Necesidades brutas de financiación, \% del PIB}};
\end{scope}

% ======== Explicación ========
\node[caja, text width=5.5cm, fill=black!4, anchor=north west] at (8.6,7.3)
  {\textbf{Solvencia: el abanico}\\[2pt] {\scriptsize Diez mil simulaciones alrededor del escenario base. Un índice resume la \textbf{anchura} del abanico, que mide la incertidumbre, y el \textbf{esfuerzo} que haría falta para estabilizar la deuda}};

\node[caja, text width=5.5cm, fill=black!4, anchor=north west] at (8.6,3.9)
  {\textbf{Liquidez: la financiación}\\[2pt] {\scriptsize Lo que hay que colocar cada año, amortizaciones incluidas. Una deuda sostenible a largo plazo puede ser impagable un martes si vence demasiada a la vez}};

\node[caja, text width=5.5cm, fill=black!10, draw=black, line width=0.6pt, anchor=north west] at (8.6,1.0)
  {\textbf{El dictamen}\\[2pt] {\scriptsize Los dos índices se promedian en un índice de riesgo a medio plazo. La señal es \textbf{mecánica}; el dictamen lo firma el personal y lo aprueba el Directorio, y puede apartarse de ella justificándolo}};

\node[caja, text width=13.9cm, fill=black!5, draw=black, line width=0.6pt, anchor=north west] at (-0.7,-1.3)
  {\textbf{Todo depende del escenario base,} que es una proyección del propio Fondo. De ahí las \textbf{herramientas de realismo}: comparar el ajuste fiscal previsto y el crecimiento supuesto con lo que han logrado de verdad otros países en circunstancias parecidas. Se introdujeron porque las proyecciones de los programas erraban siempre en la misma dirección.};
\end{tikzpicture}
