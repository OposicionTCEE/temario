\begin{tikzpicture}[
  font=\footnotesize,
  cel/.style={draw=black!70, align=left, inner sep=4pt, text width=4.1cm, minimum height=1.45cm, anchor=north west},
  cab/.style={draw=black, line width=0.6pt, align=center, inner sep=3pt, text width=4.1cm, fill=black!18, anchor=north west},
  fila/.style={draw=black!70, align=center, inner sep=4pt, text width=2.8cm, minimum height=1.45cm, anchor=north west},
  et/.style={font=\scriptsize, align=center, inner sep=2pt}
]

\def\xa{2.95} \def\xb{7.2} \def\xc{11.45}

\node[cab, text width=2.8cm, anchor=north west] at (0,0.75) {\textbf{Capa}};
\node[cab] at (\xa,0.75) {\textbf{Qué es}};
\node[cab] at (\xb,0.75) {\textbf{Por qué se prefiere}};
\node[cab] at (\xc,0.75) {\textbf{Qué falla}};

% ---- fila 1 ----
\node[fila, fill=black!20] at (0,0) {\textbf{1. Reservas propias}};
\node[cel, fill=white] at (\xa,0) {{\scriptsize Divisas acumuladas por el banco central}};
\node[cel, fill=white] at (\xb,0) {{\scriptsize Disponibles al instante y sin pedir permiso a nadie}};
\node[cel, fill=white] at (\xc,0) {{\scriptsize Carísimas: hay que comprarlas renunciando a consumo o inversión}};

% ---- fila 2 ----
\node[fila, fill=black!14] at (0,-1.5) {\textbf{2. Líneas de canje entre bancos centrales}};
\node[cel, fill=white] at (\xa,-1.5) {{\scriptsize Un banco central emisor entrega su moneda a otro}};
\node[cel, fill=white] at (\xb,-1.5) {{\scriptsize Inmediatas, enormes y sin condiciones}};
\node[cel, fill=white] at (\xc,-1.5) {{\scriptsize Discrecionales: las concede quien emite, a quien considera sistémico. \textbf{No hay derecho}}};

% ---- fila 3 ----
\node[fila, fill=black!10] at (0,-3.0) {\textbf{3. Acuerdos regionales}};
\node[cel, fill=white] at (\xa,-3.0) {{\scriptsize MEDE, Chiang Mai, acuerdo de los BRICS, FLAR}};
\node[cel, fill=white] at (\xb,-3.0) {{\scriptsize Vecinos con interés propio en evitar el contagio}};
\node[cel, fill=white] at (\xc,-3.0) {{\scriptsize Pequeños ante una crisis grande, y varios exigen un programa del Fondo para activarse}};

% ---- fila 4 ----
\node[fila, fill=black!6] at (0,-4.5) {\textbf{4. El Fondo}};
\node[cel, fill=white] at (\xa,-4.5) {{\scriptsize Acceso reglado para los $191$ miembros}};
\node[cel, fill=white] at (\xb,-4.5) {{\scriptsize El único universal: no depende de con quién se lleve bien el país}};
\node[cel, fill=white] at (\xc,-4.5) {{\scriptsize Condicionalidad y, sobre todo, \textbf{estigma}: pedirlo es admitir que no quedaba nadie más}};

\node[draw=black, line width=0.6pt, rounded corners=1.5pt, align=center, inner sep=5pt, text width=15.1cm, fill=black!5, anchor=north west] at (0,-6.4)
  {\textbf{Las tres primeras capas son mayores, más rápidas y están peor repartidas que la cuarta:} quien las tiene no necesita al Fondo y quien no las tiene depende de él. Las \textbf{líneas precautorias} intentan dar la rapidez de las primeras con el derecho de la última, y apenas se usan, porque solicitar un seguro al Fondo manda la misma señal que pedirle un rescate.};
\end{tikzpicture}
