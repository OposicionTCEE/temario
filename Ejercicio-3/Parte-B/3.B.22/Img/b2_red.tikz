% Cuerpo, bloque 2 — Las cuatro capas de la red de seguridad financiera mundial, de dentro afuera.
\begin{tikzpicture}[>={Stealth[length=2.2mm]}, every node/.style={font=\footnotesize}]

  \fill[gray!8,  draw=black!70] (0,0) ellipse (6.0 and 3.9);
  \fill[gray!16, draw=black!70] (0,0) ellipse (4.8 and 3.1);
  \fill[gray!26, draw=black!70] (0,0) ellipse (3.6 and 2.3);
  \fill[gray!38, draw=black!70] (0,0) ellipse (2.4 and 1.5);
  \fill[white,   draw=black]    (0,0) ellipse (1.25 and 0.72);

  \node at (0,0) {\textbf{el país}};
  \node at (0,1.12) {reservas propias};
  \node at (0,1.92) {líneas de canje};
  \node at (0,2.72) {acuerdos regionales};
  \node at (0,3.52) {\textbf{el Fondo}};

  \draw[->, thick] (0.1,-1.15) -- (0.1,-3.6);
  \node[anchor=west, align=left] at (0.25,-2.4) {\scriptsize orden en que\\[-2pt]\scriptsize se recurre};

  \node[anchor=east, align=right] at (-6.3,1.6) {\scriptsize más rápido,\\[-2pt]\scriptsize sin condiciones,\\[-2pt]\scriptsize solo para algunos};
  \node[anchor=west, align=left] at (6.3,1.6) {\scriptsize más lento,\\[-2pt]\scriptsize con condiciones,\\[-2pt]\scriptsize para todos};
