\begin{tikzpicture}[
  font=\footnotesize,
  paso/.style={draw=black!70, rounded corners=1.5pt, align=left, inner sep=5pt, text width=9.4cm},
  lado/.style={draw=black!70, rounded corners=1.5pt, align=center, inner sep=4pt, text width=4.0cm, fill=black!4},
  flecha/.style={-{Latex[length=5pt]}, draw=black!65, line width=0.6pt},
  et/.style={font=\scriptsize\itshape, align=left, inner sep=2pt}
]

\node[paso, fill=black!14] (p1) at (0,0)
  {\textbf{1. Medir el agujero.} Diligencia debida en el país con el supervisor, auditoría externa cuando la supervisión ha perdido credibilidad, y estimación de los activos dañados, la liquidez y el capital que falta.};

\node[paso, fill=white, anchor=north] (p2) at (0,-1.45)
  {\textbf{2. Clasificar las entidades.} Con el agujero medido, cada entidad es viable o no lo es. Decidirlo es político además de técnico, y aplazarlo es la forma más común de agravar la factura.};

\node[paso, fill=white, anchor=north] (p3) at (0,-3.0)
  {\textbf{3a. Si es viable: recapitalizar.} Primero capital privado; si no aparece, público, con dilución de los accionistas. Los activos dañados se segregan a una sociedad de gestión que los compra con descuento y obliga a aflorar la pérdida.};

\node[paso, fill=white, anchor=north] (p4) at (0,-4.95)
  {\textbf{3b. Si no es viable: resolver.} Venta, o banco puente que asume activos y pasivos y mantiene los contratos. Las pérdidas se reparten en orden: accionistas, deuda subordinada, deuda sénior y, en el extremo, depositantes no garantizados.};

\node[paso, fill=black!8, anchor=north] (p5) at (0,-7.1)
  {\textbf{4. Sostener el sistema mientras tanto.} Liquidez del banco central a las entidades solventes, garantía de depósitos creíble y, solo si la situación se escapa, controles temporales a la salida de capitales.};

\foreach \a/\b in {p1/p2, p2/p3, p3/p4, p4/p5} { \draw[flecha] (\a.south) -- (\b.north); }

\node[lado, anchor=west] at (5.1,-0.75) {Sin esto, todo lo demás se hace a ciegas};
\node[lado, anchor=west] at (5.1,-4.0) {La recapitalización sin medir antes el agujero hay que repetirla};
\node[lado, anchor=west] at (5.1,-8.1) {Resolver sin liquidez contagia a las entidades sanas};

\node[draw=black, line width=0.6pt, rounded corners=1.5pt, align=center, inner sep=5pt, text width=14.0cm, fill=black!5, anchor=north] at (2.3,-9.5)
  {\textbf{La secuencia es el contenido.} Los elementos de una estrategia bancaria los conoce cualquiera; lo que distingue un saneamiento logrado de uno fallido es el orden y la velocidad, porque cada paso dado fuera de tiempo obliga a repetir el anterior y a un coste mayor.};
\end{tikzpicture}
