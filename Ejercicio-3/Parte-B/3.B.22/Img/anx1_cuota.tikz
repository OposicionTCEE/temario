\begin{tikzpicture}[
  font=\footnotesize,
  caja/.style={draw=black!70, rounded corners=1.5pt, align=center, inner sep=4pt},
  centro/.style={caja, fill=black!8, draw=black, line width=0.7pt, align=center, inner sep=6pt},
  fun/.style={caja, text width=3.05cm, minimum height=2.45cm},
  flecha/.style={-{Latex[length=4pt]}, draw=black!60},
  nota/.style={align=center, font=\scriptsize}
]

% --- Centro: la cuota
\node[centro, text width=4.1cm] (q) at (0,0)
  {\textbf{La cuota del país $i$}\\[2pt] Un único número, en DEG,\\ fijado por el Fondo\\[3pt] \textit{España:} $9.535{,}5$ millones\\ \textit{(}$14.303{,}3$ \textit{tras la 16.ª revisión)}};

% --- Cuatro funciones
\node[fun] (sus) at (-5.6,2.95) {\textbf{1. Suscripción}\\[2pt] Lo que el país \emph{pone}\\[3pt] $25\%$ en activos de reserva\\ (DEG o divisa de libre uso)\\ $75\%$ en moneda nacional};
\node[fun] (vot) at (-1.87,2.95) {\textbf{2. Voto}\\[2pt] Lo que el país \emph{manda}\\[3pt] $1$ voto por cada\\ $100.000$ DEG de cuota\\ $+$ votos básicos};
\node[fun] (acc) at (1.87,2.95) {\textbf{3. Acceso}\\[2pt] Lo que el país \emph{puede pedir}\\[3pt] Todos los límites de\\ financiación se expresan\\ en \% de la cuota};
\node[fun] (deg) at (5.6,2.95) {\textbf{4. Derechos de giro}\\[2pt] Lo que el país \emph{recibe}\\[3pt] Las asignaciones generales\\ de DEG se reparten en\\ proporción a la cuota};

\foreach \d in {sus,vot,acc,deg} { \draw[flecha] (q) -- (\d); }

% --- Consecuencia
\node[caja, fill=black!5, text width=14.6cm, draw=black, line width=0.6pt] (cons) at (0,-2.5)
  {\textbf{La consecuencia:} las cuatro funciones son el mismo número, de modo que \textbf{no se puede dar más voz sin dar más dinero, más acceso y más DEG}.\\[2pt]
   Y como ningún país ha aceptado nunca reducir su cuota nominal, \textbf{realinear el poder relativo exige aumentar el total}: de ahí que toda reforma de gobierno dependa de una revisión general de cuotas.};
\draw[flecha] (q) -- (cons);

\end{tikzpicture}
