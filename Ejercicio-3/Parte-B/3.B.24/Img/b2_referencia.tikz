% Figura del cuerpo (B2, «Zona del euro»: rendimiento a un mismo plazo de la deuda alemana y de la de otro Estado del euro; esquemática, sin escala).
% Generar con: bash Code/generar_figura.sh b2_referencia
\begin{tikzpicture}[font=\footnotesize]
\draw (-0.5,0) -- (4.05,0);
\fill[black!62] (0.00,0) rectangle (1.25,2.00);
\node[below, align=center, text width=2.4cm] at (0.625,0) {Alemania};
\fill[black!62] (2.50,0) rectangle (3.75,2.00);
\node[below, align=center, text width=2.4cm] at (3.125,0) {Otro Estado del euro};
\fill[black!40] (2.50,2.000) rectangle (3.75,2.700);
\fill[black!26] (2.50,2.700) rectangle (3.75,3.050);
\fill[black!16] (2.50,3.050) rectangle (3.75,3.550);
\draw[decorate, decoration={brace, amplitude=3.5pt}] (2.40,2.00) -- (2.40,3.550) node[midway, left=4pt] {$s$};
\draw[densely dotted] (-0.3,2.00) -- (3.95,2.00);
\draw[decorate, decoration={brace, amplitude=4pt, mirror}] (-0.15,0) -- (-0.15,2.00) node[midway, left=5pt] {$r_f$};
\fill[black!16] (4.45,2.95) rectangle (4.75,3.17);
\node[anchor=west] at (4.83,3.06) {Redenominación};
\fill[black!26] (4.45,2.45) rectangle (4.75,2.67);
\node[anchor=west] at (4.83,2.56) {Liquidez};
\fill[black!40] (4.45,1.95) rectangle (4.75,2.17);
\node[anchor=west] at (4.83,2.06) {Riesgo de crédito};
\fill[black!62] (4.45,1.45) rectangle (4.75,1.67);
\node[anchor=west] at (4.83,1.56) {Precio del tiempo, $r_f$};
\path ([yshift=1.5pt]current bounding box.north east) ([yshift=-1.5pt]current bounding box.south west);
\end{tikzpicture}
