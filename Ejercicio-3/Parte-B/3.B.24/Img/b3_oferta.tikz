% Figura del cuerpo (B3, «Hábitat»: prima que exigen los arbitrajistas según la oferta neta de bonos largos; esquemática).
% Generar con: bash Code/generar_figura.sh b3_oferta
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
\draw[->] (0,0) -- (6.4,0) node[below left] {Oferta neta de bonos largos};
\draw[->] (0,0) -- (0,3.7) node[above] {Prima por plazo, $\phi_n$};
\draw[very thick] (0.3,0.500) -- (5.6,3.150) node[right] {$D$};
\draw[thick, black!55] (2.4,0) -- (2.4,3.4) node[above] {$S_0$};
\draw[densely dotted] (0,1.550) -- (2.4,1.550);
\fill (2.4,1.550) circle (1.6pt);
\draw[thick, black!55] (4.0,0) -- (4.0,3.4) node[above] {$S_1$};
\draw[densely dotted] (0,2.350) -- (4.0,2.350);
\fill (4.0,2.350) circle (1.6pt);
\node[left] at (0,1.550) {$\phi_0$};
\node[left] at (0,2.350) {$\phi_1$};
\draw[->, thick] (2.55,3.0) -- (3.85,3.0);
\path ([yshift=1.5pt]current bounding box.north east) ([yshift=-1.5pt]current bounding box.south west);
