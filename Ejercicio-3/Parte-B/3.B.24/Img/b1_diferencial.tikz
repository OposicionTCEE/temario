\fill[black!26] (6.65,3.40) rectangle (6.95,3.62);
\node[anchor=west] at (7.03,3.51) {Prima por riesgo de impago};
\fill[black!40] (6.65,2.90) rectangle (6.95,3.12);
\node[anchor=west] at (7.03,3.01) {Pérdida esperada, $p\,\ell$};
\fill[black!62] (6.65,2.40) rectangle (6.95,2.62);
\node[anchor=west] at (7.03,2.51) {Precio del tiempo, $r_f$};
