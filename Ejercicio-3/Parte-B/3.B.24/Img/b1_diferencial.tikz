\node[below, align=center, text width=2.2cm] at (2.975,0) {Grado de inversión};
\fill[black!62] (4.70,0) rectangle (5.95,2.10);
\fill[black!40] (4.70,2.100) rectangle (5.95,3.050);
\fill[black!26] (4.70,3.050) rectangle (5.95,4.100);
