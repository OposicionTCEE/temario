% Figura (Anexo II, II.2, «Garantía y prelación»): bono garantizado frente a titulización; esquemática.
% Generar con: bash Code/generar_figura.sh anx_cedulas_titulizacion
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=5pt]}, caja/.style={draw=black!60, rounded corners=1pt, align=center, inner sep=3pt}]
\node[font=\footnotesize\bfseries] at (2.3,3.5) {Bono garantizado (cédula)};
\draw[black!60, rounded corners=2pt] (0,0) rectangle (4.6,3.0);
\node[anchor=north] at (2.3,2.95) {Banco emisor};
\node[caja, fill=black!12, minimum width=1.9cm, minimum height=1.6cm] (cob) at (1.2,1.25) {Préstamos\\de cobertura};
\node[caja, minimum width=1.9cm, minimum height=1.6cm] (pas) at (3.4,1.25) {Cédulas\\y resto\\del pasivo};
\node[caja, fill=black!5] (ten) at (2.3,-1.45) {Tenedores de cédulas};
\draw[->, thick] ([xshift=-0.45cm]ten.north) -- node[left, font=\scriptsize] {2} (cob.south);
\draw[->, thick] ([xshift=0.45cm]ten.north) -- node[right, font=\scriptsize] {1} (3.4,0);
\node[align=center, font=\scriptsize, anchor=north] at (2.3,-1.85) {1: derecho frente al banco\\2: preferencia sobre la cobertura};
\node[font=\footnotesize\bfseries] at (9.00,3.5) {Titulización};
\node[caja, fill=black!5] (ori) at (6.45,1.25) {Banco\\originador};
\draw[black!60, rounded corners=2pt] (8.60,0) rectangle (12.10,3.0);
\node[anchor=north] at (10.35,2.95) {Fondo de titulización};
\node[caja, fill=black!12, minimum width=1.6cm, minimum height=1.9cm] (pre) at (9.50,1.15) {Préstamos};
\node[caja, fill=black!5, minimum width=1.65cm, minimum height=0.55cm] (t0) at (11.20,1.80) {sénior};
\node[caja, fill=black!18, minimum width=1.65cm, minimum height=0.55cm] (t1) at (11.20,1.18) {intermedio};
\node[caja, fill=black!35, minimum width=1.65cm, minimum height=0.55cm] (t2) at (11.20,0.56) {subordinado};
\node[caja, fill=black!5] (inv) at (10.35,-1.45) {Inversores};
\draw[->, thick] (ori.east) -- node[above, font=\scriptsize, align=center] {vende\\los préstamos} (pre.west);
\draw[->, thick] (10.35,0) -- node[right, font=\scriptsize] {bonos por tramos} (inv.north);
\path ([yshift=1.5pt]current bounding box.north east) ([yshift=-1.5pt]current bounding box.south west);
\end{tikzpicture}
