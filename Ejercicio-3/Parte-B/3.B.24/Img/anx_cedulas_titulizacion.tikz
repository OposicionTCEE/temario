% Figura (Anexo II, II.2, «Garantía y prelación»): bono garantizado frente a titulización; esquemática.
% Generar con: bash Code/generar_figura.sh anx_cedulas_titulizacion
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=5pt]}, caja/.style={draw=black!60, rounded corners=1pt, align=center, inner sep=3pt}]
\node[font=\footnotesize\bfseries] at (2.9,3.55) {Bono garantizado (cédula)};
\draw[black!60, rounded corners=2pt] (0,0) rectangle (4.5,3.05);
\node[anchor=north] at (2.25,3.0) {Banco emisor};
\node[caja, fill=black!12, minimum width=1.85cm, minimum height=1.6cm] (cob) at (1.17,1.15) {Préstamos\\de cobertura};
\node[caja, minimum width=1.85cm, minimum height=1.6cm] (pas) at (3.33,1.15) {Cédulas\\y resto\\del pasivo};
\node[caja, fill=black!5, minimum width=1.6cm] (ten) at (6.1,2.1) {Tenedores\\de cédulas};
\draw[->, thick] (ten.west) -- (4.5,2.1) node[midway, above, font=\scriptsize] {1};
\draw[->, thick] (ten.south) to[out=-90, in=-90, looseness=0.75] node[pos=0.25, right, font=\scriptsize] {2} (cob.south);
\node[align=left, font=\scriptsize, anchor=north west] at (4.75,1.35) {1: derecho frente\\al banco\\2: preferencia sobre\\la cobertura};
\node[font=\footnotesize\bfseries] at (12.10,3.55) {Titulización};
\node[caja, fill=black!5, minimum width=1.6cm] (ori) at (9.35,1.5) {Banco\\originador};
\draw[black!60, rounded corners=2pt] (10.70,0) rectangle (14.20,3.05);
\node[anchor=north] at (12.45,3.0) {Fondo de titulización};
\node[caja, fill=black!12, minimum width=1.35cm, minimum height=1.9cm] (pre) at (11.50,1.2) {Présta-\\mos};
\node[caja, fill=black!5, minimum width=1.7cm, minimum height=0.55cm] (t0) at (13.28,1.85) {sénior};
\node[caja, fill=black!18, minimum width=1.7cm, minimum height=0.55cm] (t1) at (13.28,1.23) {intermedio};
\node[caja, fill=black!35, minimum width=1.7cm, minimum height=0.55cm] (t2) at (13.28,0.61) {subordinado};
\node[caja, fill=black!5, minimum width=1.3cm] (inv) at (15.35,1.2) {Inversores};
\draw[->, thick] (ori.east) -- node[above, font=\scriptsize, align=center] {vende los\\préstamos} (pre.west);
\draw[->, thick] (t1.east) -- (inv.west);
\node[font=\scriptsize, align=center] at (15.35,0.25) {bonos\\por tramos};
\path ([yshift=1.5pt]current bounding box.north east) ([yshift=-1.5pt]current bounding box.south west);
\end{tikzpicture}
