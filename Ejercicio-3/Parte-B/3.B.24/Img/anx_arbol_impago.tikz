% Figura (Anexo I, I.4, «Pérdida esperada»): árbol de un periodo de un bono con riesgo de impago.
% Generar con: bash Code/generar_figura.sh anx_arbol_impago
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
\node (P) at (0,0) {$P$};
\node[anchor=west] (A) at (4.2,1.1) {$CF$};
\node[anchor=west] (B) at (4.2,-1.1) {$(1-\ell)\,CF$};
\draw[->, thick] (P.east) -- (A.west) node[midway, above, sloped] {$1-p$};
\draw[->, thick] (P.east) -- (B.west) node[midway, below, sloped] {$p$};
\node[anchor=west, text=black!60] at ($(A.east)+(0.15,0)$) {paga};
\node[anchor=west, text=black!60] at ($(B.east)+(0.15,0)$) {impaga};
\draw[black!40] (-0.3,-1.9) -- (6.6,-1.9);
\node[below] at (0,-1.9) {$t=0$};
\node[below] at (4.6,-1.9) {$t=1$};
\path ([yshift=1.5pt]current bounding box.north east) ([yshift=-1.5pt]current bounding box.south west);
\end{tikzpicture}
