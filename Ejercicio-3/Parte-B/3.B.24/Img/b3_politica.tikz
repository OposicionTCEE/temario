% Figura del cuerpo (B3, «Acción»: instrumentos, componente de la curva sobre el que actúan y teoría que los sostiene; esquemática).
% Generar con: bash Code/generar_figura.sh b3_politica
\begin{tikzpicture}[>={Stealth[length=4pt]}]
\node[font=\footnotesize\bfseries] at (0,3.25) {Instrumento};
\node[font=\footnotesize\bfseries] at (4.3,3.25) {Actúa sobre};
\node[font=\footnotesize\bfseries] at (8.1,3.25) {Funciona si es cierta};
\node[rounded corners=2pt, fill=black!7, draw=black!45, align=center, minimum height=0.62cm, inner sep=2pt, font=\footnotesize, text width=3.3cm] (i0) at (0,2.40) {Tipo oficial};
\node[rounded corners=2pt, fill=black!7, draw=black!45, align=center, minimum height=0.62cm, inner sep=2pt, font=\footnotesize, text width=3.3cm] (i1) at (0,1.60) {Orientación sobre los tipos};
\node[rounded corners=2pt, fill=black!7, draw=black!45, align=center, minimum height=0.62cm, inner sep=2pt, font=\footnotesize, text width=3.3cm] (i2) at (0,0.80) {Compras de deuda y\\control de la curva};
\node[rounded corners=2pt, fill=black!7, draw=black!45, align=center, minimum height=0.62cm, inner sep=2pt, font=\footnotesize, text width=3.3cm] (i3) at (0,0.00) {Gestión de la deuda};
\node[rounded corners=2pt, fill=black!7, draw=black!45, align=center, minimum height=0.62cm, inner sep=2pt, font=\footnotesize, text width=1.5cm] (c0) at (4.3,2.4) {$i_0$};
\node[rounded corners=2pt, fill=black!7, draw=black!45, align=center, minimum height=0.62cm, inner sep=2pt, font=\footnotesize, text width=1.5cm] (c1) at (4.3,1.6) {$E[i_k]$};
\node[rounded corners=2pt, fill=black!7, draw=black!45, align=center, minimum height=0.62cm, inner sep=2pt, font=\footnotesize, text width=1.5cm, minimum height=1.42cm] (c2) at (4.3,0.4) {$\phi_n$};
\node[rounded corners=2pt, fill=black!7, draw=black!45, align=center, minimum height=0.62cm, inner sep=2pt, font=\footnotesize, text width=3.0cm] (t1) at (8.1,1.6) {la hipótesis de las expectativas};
\node[rounded corners=2pt, fill=black!7, draw=black!45, align=center, minimum height=0.62cm, inner sep=2pt, font=\footnotesize, text width=3.0cm, minimum height=1.42cm] (t2) at (8.1,0.4) {la teoría del\\hábitat preferido};
\draw[->, black!60] (i0.east) -- (c0.west);
\draw[->, black!60] (i1.east) -- (c1.west);
\draw[->, black!60] (i2.east) -- (c2.west |- i2.east);
\draw[->, black!60] (i3.east) -- (c2.west |- i3.east);
\draw[->, black!60] (c1.east) -- (t1.west);
\draw[->, black!60] (c2.east) -- (t2.west);
\node[font=\footnotesize] at (4.3,-0.95) {$r_n=\dfrac{1}{n}\displaystyle\sum_{k=0}^{n-1}E[i_k]+\phi_n$};
\path ([yshift=1.5pt]current bounding box.north east) ([yshift=-1.5pt]current bounding box.south west);
\end{tikzpicture}
