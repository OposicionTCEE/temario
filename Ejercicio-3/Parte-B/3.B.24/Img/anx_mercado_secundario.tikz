% Figura (Anexo II, II.4, «Estructura»): niveles del mercado secundario de bonos; esquemática.
% Generar con: bash Code/generar_figura.sh anx_mercado_secundario
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=5pt]}, caja/.style={draw=black!60, rounded corners=2pt, align=center, inner sep=4pt}]
\node[caja, fill=black!5, text width=3.0cm] (inv) at (0,0) {Inversores finales\\{\scriptsize fondos, aseguradoras, bancos, bancos centrales}};
\node[caja, fill=black!15, text width=3.0cm] (cm) at (5.6,0) {Creadores de mercado\\{\scriptsize inventario propio}};
\node[caja, fill=black!5, text width=3.0cm] (cm2) at (11.2,0) {Otros creadores\\de mercado};
\draw[<->, thick] (inv.east) -- node[above, font=\scriptsize, align=center] {precios de compra y venta} node[below, font=\scriptsize, align=center] {teléfono o plataformas\\con varios creadores} (cm.west);
\draw[<->, thick] (cm.east) -- node[above, font=\scriptsize, align=center] {cobertura y reparto} node[below, font=\scriptsize, align=center] {plataformas entre\\intermediarios} (cm2.west);
\node[caja, fill=black!10, text width=12.4cm] (liq) at (5.6,-2.4) {Compensación y liquidación: cámaras de contrapartida central y depositarios centrales};
\draw[->, black!50, densely dashed] (inv.south) -- (inv.south |- liq.north);
\draw[->, black!50, densely dashed] (cm.south) -- (cm.south |- liq.north);
\draw[->, black!50, densely dashed] (cm2.south) -- (cm2.south |- liq.north);
\path ([yshift=1.5pt]current bounding box.north east) ([yshift=-1.5pt]current bounding box.south west);
\end{tikzpicture}
