% Figura del cuerpo (B2, «Secundario»: precios de un intermediario según la cantidad en un bono líquido y en uno poco líquido; esquemática, sin escala).
% Generar con: bash Code/generar_figura.sh b2_liquidez
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
\begin{scope}[xshift=0.0cm]
