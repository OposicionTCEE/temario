\draw[->] (0,0) -- (5.00,0) node[below left] {Cantidad};
\draw[->] (0,0) -- (0,3.80) node[above] {Precio};
\draw[densely dotted] (0,1.90) -- (4.60,1.90);
\node[left] at (0,1.90) {$V$};
\draw[very thick] (0,2.025) -- (4.60,2.393) node[right] {$P_v$};
\draw[very thick, black!45] (0,1.775) -- (4.60,1.407) node[right] {$P_c$};
\draw[decorate, decoration={brace, amplitude=2.5pt, mirror}] (0.12,1.775) -- (0.12,2.025) node[midway, right=3pt] {$h$};
\end{scope}
\begin{scope}[xshift=6.6cm]
\node[font=\footnotesize\bfseries, anchor=west] at (-0.1,4.25) {Bono poco líquido};
\draw[->] (0,0) -- (5.00,0) node[below left] {Cantidad};
\draw[->] (0,0) -- (0,3.80) node[above] {Precio};
\draw[densely dotted] (0,1.90) -- (4.60,1.90);
\node[left] at (0,1.90) {$V$};
\draw[very thick] (0,2.350) -- (4.60,3.822) node[right] {$P_v$};
\draw[very thick, black!45] (0,1.450) -- (4.60,-0.022) node[right] {$P_c$};
\draw[decorate, decoration={brace, amplitude=2.5pt, mirror}] (0.12,1.450) -- (0.12,2.350) node[midway, right=3pt] {$h$};
\end{scope}
\path ([yshift=1.5pt]current bounding box.north east) ([yshift=-1.5pt]current bounding box.south west);
