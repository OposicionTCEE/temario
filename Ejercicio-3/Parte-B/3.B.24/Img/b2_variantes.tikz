\draw[->, black!60] (-0.85,1.10) -- (n.east);
\node[anchor=west, font=\footnotesize\bfseries] at (-8.25,0.00) {Crédito};
\node[rounded corners=2pt, fill=black!7, draw=black!45, text width=2.0cm, align=center, minimum height=0.62cm, inner sep=2pt, font=\footnotesize] (n) at (-2.50,0.00) {Cédula};
\draw[->, black!60] (-0.85,0.00) -- (n.east);
\node[rounded corners=2pt, fill=black!7, draw=black!45, text width=2.0cm, align=center, minimum height=0.62cm, inner sep=2pt, font=\footnotesize] (n) at (2.50,0.00) {Subordinado};
