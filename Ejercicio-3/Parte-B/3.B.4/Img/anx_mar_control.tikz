% Figura (anexo de marco institucional, «Concentraciones: ¿qué se notifica y cómo se examina?»). Procedimiento español
% de control de concentraciones (Ley 15/2007): notificación previa y suspensión de la ejecución (art. 9); primera fase de
% un mes y segunda fase de tres meses (art. 36); resolución de la CNMC; si en segunda fase prohíbe o condiciona, el
% Ministro puede elevar la decisión al Consejo de Ministros, que confirma o autoriza, con o sin condiciones, por razones
% de interés general distintas de la competencia (arts. 10.4 y 60).
% Generar con: bash Code/generar_figura.sh anx_mar_control
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]},
    caja/.style={draw, rounded corners=2pt, fill=white, align=center, minimum height=0.95cm, text width=2.7cm},
    fin/.style={caja, fill=teal!25},
    gob/.style={caja, fill=black!10},
    flecha/.style={->, thick}]
  \node[caja] (n) at (0,0) {Notificación previa\\ (no se ejecuta)};
  \node[caja] (f1) at (3.6,0) {Primera fase\\ (un mes)};
  \node[fin] (a1) at (7.2,0.85) {Autorización, con o\\ sin compromisos};
  \node[caja] (f2) at (7.2,-0.85) {Segunda fase\\ (tres meses)};
  \node[fin] (a2) at (10.8,0) {Autorización};
  \node[fin] (c2) at (10.8,-1.35) {Compromisos,\\ condiciones o\\ prohibición};
  \node[gob] (cm) at (10.8,-3.75) {Consejo de Ministros:\\ confirma o autoriza,\\ con o sin condiciones};
  \draw[flecha] (n) -- (f1);
  \draw[flecha] (f1) -- (a1.west);
  \draw[flecha] (f1) -- (f2.west);
  \draw[flecha] (f2) -- (a2.west);
  \draw[flecha] (f2) -- (c2.west);
  \draw[flecha, dashed] (c2) -- node[left=3pt, font=\scriptsize, align=right] {si el Ministro lo eleva,\\ por interés general} (cm);
\end{tikzpicture}
