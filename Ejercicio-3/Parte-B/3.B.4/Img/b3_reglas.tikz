% Figura (bloque 3, «Reglas: ¿quién decide sobre la oferta y quién cobra el control?»), a partir de BEBCHUK (1994).
% Ejes: cambio del valor de las acciones, Delta Y = Y_1 - Y_0, y de los beneficios privados del control,
% Delta B = B_1 - B_0, al pasar el control del dueño actual (0), con una fracción alpha de las acciones, al comprador (1).
% El cambio es eficiente por encima de la recta Delta Y + Delta B = 0. (a) Venta libre: se produce por encima de
% alpha Delta Y + Delta B = 0, de modo que se producen cambios ineficientes (arriba a la izquierda: más beneficios
% privados y menos valor) y no se producen cambios eficientes (abajo a la derecha). (b) Oferta obligatoria: se produce
% por encima de Delta Y + Delta B = B_0 (1 - alpha)/alpha; ninguno ineficiente, pero no se producen los eficientes de
% la banda. La recta discontinua inferior es B_1 = 0 (los beneficios privados no pueden ser negativos).
% Valores ilustrativos: alpha = 0,4, B_0 = 1.
% Generar con: bash Code/generar_figura.sh b3_reglas
\begin{tikzpicture}[font=\footnotesize, x=0.82cm, y=0.72cm,
    eje/.style={->, >={Stealth[length=4pt]}},
    recta/.style={thick},
    regla/.style={thick, dashed},
    ineficiente/.style={fill=black!22},
    bloqueado/.style={fill=teal!30}]
  % (a) Venta libre
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (0,4.0) {(a) Venta libre};
    \fill[ineficiente] (0,0) -- (-3,1.2) -- (-3,3) -- cycle;
    \fill[bloqueado] (0,0) -- (1,-1) -- (2.5,-1) -- cycle;
    \draw[eje] (-3.3,0) -- (3.4,0) node[below left] {$\Delta Y$};
    \draw[eje] (0,-1.5) -- (0,3.4) node[left] {$\Delta B$};
    \draw[dotted] (-3,-1) -- (3,-1) node[right] {\scriptsize $B_1=0$};
    \draw[recta] (-3,3) -- (1,-1);
    \node[left] at (-3,3) {\scriptsize eficiencia};
    \draw[regla] (-3,1.2) -- (2.5,-1);
    \node[left] at (-3,1.2) {\scriptsize venta libre};
    % leyenda
    \fill[ineficiente] (-3.2,-2.2) rectangle (-2.9,-1.95); \node[right] at (-2.85,-2.07) {\scriptsize se producen sin ser eficientes};
    \fill[bloqueado] (-3.2,-2.75) rectangle (-2.9,-2.5); \node[right] at (-2.85,-2.62) {\scriptsize eficientes que no se producen};
  \end{scope}
  % (b) Oferta obligatoria
  \begin{scope}[xshift=8.7cm]
    \node[font=\footnotesize\bfseries] at (0,4.0) {(b) Oferta obligatoria};
    \fill[bloqueado] (-3,3) -- (1,-1) -- (2.5,-1) -- (-1.5,3) -- cycle;
    \draw[eje] (-3.3,0) -- (3.4,0) node[below left] {$\Delta Y$};
    \draw[eje] (0,-1.5) -- (0,3.4) node[left] {$\Delta B$};
    \draw[dotted] (-3,-1) -- (3,-1) node[right] {\scriptsize $B_1=0$};
    \draw[recta] (-3,3) -- (1,-1);
    \node[left] at (-3,3) {\scriptsize eficiencia};
    \draw[regla] (-1.5,3) -- (2.5,-1);
    \node[right] at (0.8,0.95) {\scriptsize oferta obligatoria};
    % leyenda
    \fill[bloqueado] (-3.2,-2.2) rectangle (-2.9,-1.95); \node[right] at (-2.85,-2.07) {\scriptsize eficientes que no se producen};
  \end{scope}
\end{tikzpicture}
