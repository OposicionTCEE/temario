% Figura (bloque 3, «Gobierno: ¿por qué pueden fracasar las alianzas?»), a partir de HOLMSTRÖM (1982). Aportación de un
% socio, e_i: lo que añade al resultado conjunto (∂Y/∂e_i, decreciente), la parte que cobra (s_i ∂Y/∂e_i, con s_i = 1/2)
% y el coste de aportar (c'(e_i), creciente). El socio se detiene en ê_i, donde su parte iguala el coste; al conjunto le
% convendría llegar a e_i*, donde lo que añade iguala el coste. El triángulo entre las dos curvas, de ê_i a e_i*, es el
% valor que se pierde. Valores ilustrativos: ∂Y/∂e = 4 - 0,55 e; c'(e) = 0,4 + 0,35 e; ê = 2,56; e* = 4.
% Generar con: bash Code/generar_figura.sh b3_equipo
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]},
    nota/.style={font=\scriptsize, align=left, inner sep=1pt}]
  % valor que se pierde
  \fill[black!22] (2.56,2.592) -- (2.56,1.296) -- (4,1.8) -- cycle;
  % ejes
  \draw[->] (0,0) -- (7.0,0);
  \node[anchor=north west] at (5.0,-0.05) {aportación del socio, $e_i$};
  \draw[->] (0,0) -- (0,4.6) node[above right] {euros por unidad de aportación};
  % curvas
  \draw[very thick, black!70] (0,4.0) -- (5.6,0.92) node[right, nota, black] {lo que añade al conjunto, $\partial Y/\partial e_i$};
  \draw[very thick, teal!70!black] (0,2.0) -- (6.2,0.295) node[right, nota, black] {lo que cobra el socio, $s_i\,\partial Y/\partial e_i$};
  \draw[very thick] (0,0.4) -- (5.4,2.29) node[right, nota] {coste de aportar, $c'(e_i)$};
  % equilibrios
  \draw[dashed, black!50] (2.56,1.296) -- (2.56,0) node[below, black] {$\hat e_i$};
  \draw[dashed, black!50] (4,1.8) -- (4,0) node[below, black] {$e_i^*$};
  \fill[teal!70!black] (2.56,1.296) circle (1.7pt);
  \fill (4,1.8) circle (1.7pt);
  \node[nota, anchor=south west] at (4.05,1.85) {lo que convendría\\ al conjunto};
  \node[nota, anchor=north] at (2.2,1.15) {donde\\ se detiene};
  \node[nota, anchor=west] (p) at (3.3,3.2) {valor que se pierde};
  \draw[black!50] (p.west) -- (3.0,2.1);
\end{tikzpicture}
