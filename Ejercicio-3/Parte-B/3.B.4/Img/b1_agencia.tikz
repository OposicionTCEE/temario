% Figura (bloque 1, «Agencia: ¿qué gana el directivo con comprar?»): prima máxima que el directivo está dispuesto a pagar,
% π^max = S + B_T/α + B_R/α, en función de su participación en la empresa, α (con estimación correcta de la sinergia,
% Ŝ = S). Sobre la sinergia S, lo que conviene pagar a los accionistas, el beneficio privado del tamaño, B_T, y el de la
% reducción de su propio riesgo, B_R, se multiplican por 1/α: cuanto menor es la participación, mayor el sobreprecio. Con
% α = 1 el directivo pagaría S + B. Valores ilustrativos: S = 1, B_T = 0,35, B_R = 0,25.
% Generar con: bash Code/generar_figura.sh b1_agencia
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=6cm, y=1.2cm,
    nota/.style={font=\scriptsize, align=center, inner sep=1pt}]
  % primas que convienen a los accionistas
  \fill[black!8] (0,0) rectangle (1,1);
  % sobreprecio de agencia: tamaño y riesgo, multiplicados por 1/α
  \begin{scope}
    \clip (0,0) rectangle (1.0,3.6);
    \fill[teal!45] plot[domain=0.05:1, samples=150] (\x,{1+0.6/\x}) -- plot[domain=1:0.05, samples=150] (\x,{1+0.35/\x}) -- cycle;
    \fill[teal!18] plot[domain=0.05:1, samples=150] (\x,{1+0.35/\x}) -- (1,1) -- (0.05,1) -- cycle;
    \draw[thick, teal!70!black] plot[domain=0.05:1, samples=150] (\x,{1+0.6/\x});
    \draw[teal!70!black] plot[domain=0.05:1, samples=150] (\x,{1+0.35/\x});
  \end{scope}
  \draw[thick] (0,1) -- (1,1);
  % ejes
  \draw[->] (0,0) -- (1.12,0) node[below left] {participación del directivo, $\alpha$};
  \draw[->] (0,0) -- (0,3.85) node[above right] {prima máxima, $\pi^{max}$};
  \draw (1,0.05) -- (1,-0.05) node[below] {$1$};
  \node[below] at (0,0) {$0$};
  % rótulos
  \node[left] at (0,1) {$S$};
  \node[nota] at (0.6,0.5) {primas que convienen a los accionistas};
  \node[nota] at (0.62,1.22) {$B_T/\alpha$: tamaño};
  \node[nota] (r) at (0.68,2.75) {$B_R/\alpha$: menor riesgo\\ para el directivo};
  \draw[black!50] (r.south west) -- (0.36,2.3);
  \fill[teal!70!black] (1,1.6) circle (1.5pt) node[right, black] {$S+B$};
\end{tikzpicture}
