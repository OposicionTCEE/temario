% Figura (anexo I, «Opciones reales», «Estructura temporal de la operación: ¿comprar hoy o por etapas?»). V = V_B + S es
% lo que vale B en manos de A; en T vale V+ si las cosas van bien y V- si van mal. (a) Comprar hoy: A paga P en t = 0 y en
% T obtiene V, que en el estado desfavorable queda por debajo de lo pagado (V- < P < V+). (b) Comprar por etapas: A paga hoy
% c por una participación o una empresa conjunta con derecho a comprar el resto por P y, en T, solo compra si le conviene,
% de modo que obtiene max{V - P, 0} (empresa conjunta como opción de compra, KOGUT, 1991). Esquema ilustrativo.
% Generar con: bash Code/generar_figura.sh anx_val_opciones
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]},
    nodo/.style={circle, draw, fill=black!15, inner sep=1.6pt},
    decision/.style={rectangle, draw, fill=teal!25, inner sep=2.6pt},
    nota/.style={font=\scriptsize, inner sep=1pt}]
  % (a) Comprar hoy
  \node[font=\footnotesize\bfseries] at (2.3,2.2) {(a) Comprar hoy};
  \node[decision] (a0) at (0,0) {};
  \node[below=2pt] at (a0.south) {$-P$};
  \node[nodo] (au) at (3.0,1.1) {};
  \node[nodo] (ad) at (3.0,-1.1) {};
  \draw[->] (a0) -- node[above, sloped, nota] {bien} (au);
  \draw[->] (a0) -- node[below, sloped, nota] {mal} (ad);
  \node[right] at (au.east) {$V^+$};
  \node[right] at (ad.east) {$V^-$};
  \node[below] at (0,-1.75) {$t=0$}; \node[below] at (3.0,-1.75) {$T$};
  \node at (1.8,-2.65) {$V^-<P<V^+$};
  % (b) Comprar por etapas
  \begin{scope}[xshift=7.0cm]
    \node[font=\footnotesize\bfseries] at (3.0,2.2) {(b) Comprar por etapas};
    \node[decision] (b0) at (0,0) {};
    \node[below=2pt] at (b0.south) {$-c$};
    \node[nodo] (bu) at (2.6,1.1) {};
    \node[nodo] (bd) at (2.6,-1.1) {};
    \draw[->] (b0) -- node[above, sloped, nota] {bien} (bu);
    \draw[->] (b0) -- node[below, sloped, nota] {mal} (bd);
    \node[decision] (cu) at (3.8,1.1) {};
    \node[decision] (cd) at (3.8,-1.1) {};
    \draw[->] (bu) -- (cu); \draw[->] (bd) -- (cd);
    \node[right] at (cu.east) {compra: $V^+-P$};
    \node[right] at (cd.east) {no compra: $0$};
    \node[below] at (0,-1.75) {$t=0$}; \node[below] at (3.2,-1.75) {$T$};
    \node at (2.6,-2.65) {$\text{máx}\left\{V-P,\;0\right\}$};
  \end{scope}
  \node[nota] at (5.2,-3.35) {$V=V_B+S$: lo que vale B en manos de A};
\end{tikzpicture}
