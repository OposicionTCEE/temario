% Figura (bloque 1, «Crecimiento interno: ¿qué limita su velocidad?»): la capacidad de A crece por etapas. Cada expansión
% (tramo ascendente) avanza por debajo del ritmo que permite financiarla con beneficios retenidos, la tasa de crecimiento
% sostenible g* de HIGGINS (1977) (recta discontinua), y ocupa a la dirección hasta completarse; solo entonces queda
% atención directiva libre para la siguiente (tramos planos, PENROSE, 1959). La capacidad buscada se alcanza en el plazo T.
% Esquema ilustrativo.
% Generar con: bash Code/generar_figura.sh b1_interno
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]},
    nota/.style={font=\scriptsize, align=center, inner sep=1pt}]
  % ejes
  \draw[->] (0,0) -- (9.3,0) node[below left] {tiempo};
  \draw[->] (0,0) -- (0,4.3) node[above right] {capacidad de A};
  % capacidad actual y buscada
  \draw[dashed, black!40] (0,3.2) -- (8.6,3.2);
  \node[left, nota] at (0,1.0) {actual};
  \node[left, nota] at (0,3.2) {buscada};
  % techo de la financiación
  \draw[dashed, thick, black!55] (0,1.0) -- (3.93,3.95) node[right, nota, black!75, align=left] {techo de la financiación:\\ crecer a $g^*$ (HIGGINS)};
  % construir: expansiones sucesivas
  \draw[very thick] (0,1.0) -- (0.3,1.0) -- node[sloped, above, pos=0.66, nota] {expansión} (1.4,1.55) -- (2.0,1.55) -- (3.1,2.1) -- (3.7,2.1) -- (4.8,2.65) -- (5.4,2.65)
    -- (6.5,3.2) -- (8.6,3.2);
  % rótulos de la primera etapa
  \draw[decorate, decoration={brace, amplitude=3pt, mirror}] (1.4,1.47) -- (2.0,1.47)
    node[midway, below=3pt, nota] {la dirección\\ la asimila};
  % límite de la dirección
  \node[nota] (pen) at (5.05,1.0) {cada expansión ocupa\\ a la dirección hasta\\ completarse (PENROSE)};
  \draw[black!50] (pen.north) -- (5.05,2.6);
  % plazo
  \draw[dotted] (6.5,3.2) -- (6.5,0) node[below] {$T$};
\end{tikzpicture}
