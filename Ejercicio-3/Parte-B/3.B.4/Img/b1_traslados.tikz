% Figura (bloque 1, «Valor creado y valor trasladado»): la sinergia que ven los accionistas, S, suma el valor creado
% (eficiencia) y el trasladado desde acreedores, trabajadores y proveedores, clientes y Hacienda; para la economía solo
% cuenta el primero. Tamaños ilustrativos.
% Generar con: bash Code/generar_figura.sh b1_traslados
\begin{tikzpicture}[font=\footnotesize, y=0.75cm]
  % sinergia para los accionistas
  \fill[teal!40] (0,0) rectangle (1.4,2.6); \draw (0,0) rectangle (1.4,2.6);
  \node[align=center] at (0.7,1.3) {valor\\ creado};
  \foreach \a/\b/\c/\t in {2.6/3.3/black!12/{acreedores}, 3.3/4.2/black!22/{trabajadores y proveedores},
      4.2/5.0/black!32/{clientes}, 5.0/5.6/black!42/{Hacienda}} {
    \fill[\c] (0,\a) rectangle (1.4,\b); \draw (0,\a) rectangle (1.4,\b);
    \node[right, font=\scriptsize] at (1.45,{(\a+\b)/2}) {\t};
  }
  \draw[decorate, decoration={brace, amplitude=4pt}] (-0.1,0) -- (-0.1,5.6) node[midway, left=5pt, align=right] {sinergia para\\ los accionistas, $S$};
  \draw[decorate, decoration={brace, amplitude=4pt, mirror}] (4.7,2.6) -- (4.7,5.6) node[midway, right=5pt, align=left] {valor\\ trasladado};
  % ganancia para la economía
  \fill[teal!40] (7.2,0) rectangle (8.6,2.6); \draw (7.2,0) rectangle (8.6,2.6);
  \node[align=center] at (7.9,1.3) {valor\\ creado};
  \node[below, align=center] at (7.9,0) {ganancia para\\ la economía};
  \node[below, align=center] at (0.7,0) {ganancia para\\ los accionistas};
  \draw (-0.3,0) -- (9.0,0);
\end{tikzpicture}
