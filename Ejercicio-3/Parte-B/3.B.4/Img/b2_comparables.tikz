% Figura (bloque 2, «Comparables: ¿qué estiman las cotizadas y las transacciones?»). Los múltiplos de empresas cotizadas
% comparables son precios de participaciones minoritarias y estiman el valor de B por sí sola, V_B; los de transacciones
% comparables incluyen la prima que pagaron otros compradores, pi_c, y estiman un precio, V_B + pi_c. El máximo que A debe
% pagar sigue siendo V_B + S, con su propia sinergia S. Esquema ilustrativo.
% Generar con: bash Code/generar_figura.sh b2_comparables
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]},
    marca/.style={draw, thick},
    llave/.style={decorate, decoration={brace, amplitude=4pt, mirror}}]
  \draw[->] (-0.3,0) -- (8.2,0) node[below left] {valor};
  \fill[teal!25] (0.8,-0.12) rectangle (4.2,0.12);
  \foreach \x/\l in {0.8/{V_B}, 4.2/{V_B+\pi_c}, 7.0/{V_B+S}} {
    \draw[marca] (\x,0.22) -- (\x,-0.22);
    \node[above] at (\x,0.25) {$\l$};
  }
  \foreach \x/\l in {0.8/{comparables cotizadas}, 4.2/{transacciones comparables}} {
    \draw[->, black!55] (\x,1.25) -- (\x,0.75);
    \node[above, black!70] at (\x,1.25) {\l};
  }
  \draw[llave] (0.8,-0.32) -- (4.2,-0.32) node[midway, below=5pt] {$\pi_c$};
  \draw[llave] (0.8,-1.05) -- (7.0,-1.05) node[midway, below=5pt] {$S$};
\end{tikzpicture}
