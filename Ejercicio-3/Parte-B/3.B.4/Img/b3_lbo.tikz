% Figura (bloque 3, «Compras apalancadas: ¿qué cambia al endeudar la empresa comprada?»), a partir de KAPLAN y
% STRÖMBERG (2009). (a) La estructura: el fondo de capital riesgo, con los directivos, aporta poco capital propio, E, y
% los bancos mucha deuda, D, a una sociedad vehículo que compra B y se fusiona con ella, de modo que los flujos de caja
% libres de B pagan los intereses y devuelven la deuda. (b) Durante la inversión: el valor de la empresa, V = D + E,
% pasa de estar financiado sobre todo con deuda a estarlo sobre todo con capital propio, porque los flujos devuelven
% la deuda y el valor crece; en T el fondo sale, vendiendo la empresa o sacándola a bolsa. Valores ilustrativos.
% Generar con: bash Code/generar_figura.sh b3_lbo
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]},
    caja/.style={draw, rounded corners=2pt, minimum height=0.75cm, align=center, fill=white},
    flecha/.style={->, thick}]
  % (a) La estructura
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (2.6,4.3) {(a) La estructura};
    \node[caja, fill=teal!25, minimum width=2.4cm] (fondo) at (0.9,3.2) {Fondo y\\ directivos};
    \node[caja, fill=black!12, minimum width=2.4cm] (bancos) at (4.3,3.2) {Bancos};
    \node[caja, minimum width=2.8cm] (vehiculo) at (2.6,1.6) {Sociedad vehículo};
    \node[caja, fill=black!25, minimum width=2.8cm] (b) at (2.6,0.0) {B};
    \draw[flecha] (fondo.south) -- node[left=2pt, pos=0.45] {$E$} (vehiculo.north west);
    \draw[flecha] (bancos.south) -- node[right=2pt, pos=0.45] {$D$} (vehiculo.north east);
    \draw[flecha] (vehiculo.south) -- node[left=2pt] {compra} (b.north);
    \draw[dashed, rounded corners=4pt] (1.0,-0.55) rectangle (4.2,2.15);
    \node[left, align=right] at (1.0,0.8) {\scriptsize fusión};
    \draw[flecha, teal!60!black] (b.east) -- ++(1.6,0) |- node[right, pos=0.25, align=left, text=black] {$FCL_t$:\\ intereses\\ y devolución} (bancos.east);
  \end{scope}
  % (b) Durante la inversión
  \begin{scope}[xshift=9.0cm, y=0.8cm]
    \node[font=\footnotesize\bfseries] at (2.5,5.4) {(b) Durante la inversión};
    \foreach \x/\d/\v/\t in {0.4/2.1/3.0/{0}, 1.6/1.75/3.2/{1}, 2.8/1.35/3.45/{2}, 4.4/0.8/3.9/{T}} {
      \fill[black!30] (\x,0) rectangle (\x+0.8,\d); \draw (\x,0) rectangle (\x+0.8,\d);
      \fill[teal!35] (\x,\d) rectangle (\x+0.8,\v); \draw (\x,\d) rectangle (\x+0.8,\v);
      \node at (\x+0.4,\d/2) {$D$};
      \node at (\x+0.4,{(\d+\v)/2}) {$E$};
      \node[below] at (\x+0.4,0) {$\t$};
    }
    \node at (3.98,1.6) {$\cdots$};
    \draw (0.1,0) -- (5.5,0);
    \draw[flecha] (4.8,4.05) -- (4.8,4.75) node[above, align=center] {\scriptsize salida: venta\\[-2pt] \scriptsize o bolsa};
  \end{scope}
\end{tikzpicture}
