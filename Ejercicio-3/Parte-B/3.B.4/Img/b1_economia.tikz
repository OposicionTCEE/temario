% Figura (bloque 1, «Inversión agregada: ¿crece la economía cuando crece la empresa?»): la capacidad productiva de la
% economía, la de A más la de B. Si A construye, la inversión añade capacidad nueva; si A compra B, la capacidad de B solo
% cambia de propietario y el precio P va a los antiguos accionistas de B: la compra de acciones es una operación
% financiera, no formación bruta de capital. Esquema ilustrativo.
% Generar con: bash Code/generar_figura.sh b1_economia
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]},
    nota/.style={font=\scriptsize, align=center, inner sep=1pt}]
  % capacidad de la economía antes de la operación
  \draw[dashed, black!50] (-0.2,3.0) -- (8.0,3.0);
  % antes
  \fill[black!12] (0,0) rectangle (1.2,2.0); \draw (0,0) rectangle (1.2,2.0); \node at (0.6,1.0) {A};
  \fill[black!30] (0,2.0) rectangle (1.2,3.0); \draw (0,2.0) rectangle (1.2,3.0); \node at (0.6,2.5) {B};
  \node[below] at (0.6,0) {\strut antes};
  % A construye
  \begin{scope}[xshift=3.0cm]
    \fill[black!12] (0,0) rectangle (1.2,2.0); \draw (0,0) rectangle (1.2,2.0); \node at (0.6,1.0) {A};
    \fill[teal!40] (0,2.0) rectangle (1.2,3.0); \draw (0,2.0) rectangle (1.2,3.0); \node[nota] at (0.6,2.5) {nueva,\\ de A};
    \fill[black!30] (0,3.0) rectangle (1.2,4.0); \draw (0,3.0) rectangle (1.2,4.0); \node at (0.6,3.5) {B};
    \node[below] at (0.6,0) {\strut A construye};
    \node[nota, above] at (0.6,4.05) {la economía gana\\ capacidad: inversión};
  \end{scope}
  % A compra B
  \begin{scope}[xshift=6.0cm]
    \fill[black!12] (0,0) rectangle (1.2,2.0); \draw (0,0) rectangle (1.2,2.0); \node at (0.6,1.0) {A};
    \fill[black!30] (0,2.0) rectangle (1.2,3.0); \draw (0,2.0) rectangle (1.2,3.0); \node[nota] at (0.6,2.5) {B,\\ ya de A};
    \draw[very thick, teal!70!black] (0,0) rectangle (1.2,3.0);
    \node[below] at (0.6,0) {\strut A compra B};
    \node[nota, above] at (0.6,3.05) {misma capacidad:\\ cambia el propietario};
    \draw[->, thick, teal!70!black] (1.3,1.5) -- (2.1,1.5) node[right, nota, black, align=left] {$P$: a los\\ antiguos\\ accionistas\\ de B};
  \end{scope}
  \draw (-0.3,0) -- (8.0,0);
\end{tikzpicture}
