% Figura (bloque 1, «Olas: ¿por qué se concentran en el tiempo?»), a partir de MARTYNOVA y RENNEBOOG (2008): las seis
% olas de fusiones en Estados Unidos y su tipo dominante de operación. Fechas aproximadas (varían según los autores):
% 1897-1904 horizontales (monopolios); 1916-1929 verticales (oligopolios); 1965-1969 conglomerados; 1984-1989 tomas de
% control hostiles y compras apalancadas; 1993-2000 estratégicas y transfronterizas; 2003-2007 capital riesgo.
% Esquema ilustrativo: la altura de las olas no refleja su tamaño. Eje horizontal: años desde 1890 (0,12 cm por año).
% Generar con: bash Code/generar_figura.sh b1_olas
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=0.12cm, y=1cm,
    ola/.style={font=\scriptsize, align=center, inner sep=1pt}]
  % periodos de cada ola
  \foreach \a/\b in {7/14, 26/39, 75/79, 94/99, 103/110, 113/117}
    \fill[black!7] (\a,0) rectangle (\b,1.9);
  % ejes
  \draw[->] (0,0) -- (128,0) node[below left] {año};
  \draw[->] (0,0) -- (0,2.6) node[above right] {actividad};
  \foreach \t/\y in {0/1890, 20/1910, 40/1930, 60/1950, 80/1970, 100/1990, 120/2010} {
    \draw (\t,0.05) -- (\t,-0.05) node[below] {\y};
  }
  % actividad: suma de seis olas de igual altura sobre un nivel de fondo
  \draw[very thick, teal!70!black] plot[domain=0:125, samples=500] (\x, {0.12
      + 1.6*exp(-((\x-10.5)^2)/(2*2.2^2)) + 1.6*exp(-((\x-32.5)^2)/(2*4.1^2))
      + 1.6*exp(-((\x-77)^2)/(2*1.5^2))   + 1.6*exp(-((\x-96.5)^2)/(2*1.6^2))
      + 1.6*exp(-((\x-106.5)^2)/(2*2.2^2)) + 1.6*exp(-((\x-115)^2)/(2*1.4^2))});
  % rótulos: fechas y tipo dominante
  \node[ola] at (10.5,2.2) {\textbf{1897-1904}\\ horizontales};
  \node[ola] at (32.5,2.2) {\textbf{1916-1929}\\ verticales};
  \node[ola] at (77,2.2) {\textbf{1965-1969}\\ conglomerados};
  \node[ola] at (96.5,2.2) {\textbf{1984-1989}\\ hostiles y LBO};
  \node[ola] (o5) at (106.5,3.15) {\textbf{1993-2000}\\ estratégicas\\ y globales};
  \draw[black!40] (o5.south) -- (106.5,1.85);
  \node[ola] at (115.5,2.2) {\textbf{2003-2007}\\ capital riesgo};
\end{tikzpicture}
