% Figura (bloque 1, «Ciclicidad: ¿por qué se concentran en el tiempo?»): las seis olas de fusiones en Estados Unidos y su
% tipo dominante de operación. Fechas y tipos, de MARTYNOVA y RENNEBOOG (2008), aproximados (varían según los autores):
% 1897-1904 horizontales (monopolios); 1916-1929 verticales (oligopolios); 1965-1969 conglomerados; 1984-1989 tomas de
% control hostiles y compras apalancadas; 1993-2000 estratégicas y transfronterizas; 2003-2007 capital riesgo.
% Altura: máximo de cada ola en la serie de JOVANOVIC y ROUSSEAU (2001, figura 1), valor de las empresas que se fusionan
% (compradoras y compradas) en porcentaje del PIB, leído en su gráfico: 11,0 % en 1899; 4,1 % hacia 1929-1930; 5,0 % en
% 1968; 5,9 % en 1988; 28,2 % en 1998 (dato del propio gráfico). Antes de 1926 la serie mide los activos o el capital de
% las empresas que se fusionan (NELSON, 1959; EIS, 1968), y desde 1926, su valor de mercado (CRSP), con cambios de
% cobertura en 1962 y 1971. La serie termina en 1998: el final de la quinta ola y la sexta, en trazo discontinuo, no tienen
% altura comparable (la de la sexta es solo indicativa). Forma de las olas ilustrativa: subida lenta, caída rápida, sobre
% un nivel de fondo de 0,5 %. Eje horizontal: años desde 1890 (0,12 cm por año); eje vertical: 0,11 cm por punto de PIB.
% Generar con: bash Code/generar_figura.sh b1_olas
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=0.12cm, y=0.11cm,
    ola/.style={font=\scriptsize, align=center, inner sep=1pt}]
  % periodos de cada ola
  \foreach \a/\b in {7/14, 26/39, 75/79, 94/99, 103/110, 113/117}
    \fill[black!7] (\a,0) rectangle (\b,31);
  % ejes
  \draw[->] (0,0) -- (128,0) node[below left] {año};
  \draw[->] (0,0) -- (0,34) node[above right] {\% del PIB};
  \foreach \t/\y in {0/1890, 20/1910, 40/1930, 60/1950, 80/1970, 100/1990, 120/2010}
    \draw (\t,0.45) -- (\t,-0.45) node[below, text height=1.7ex, text depth=0.5ex] {\y};
  \foreach \v in {10,20,30}
    \draw (0.6,\v) -- (-0.6,\v) node[left] {\v};
  % olas con datos: subida lenta y caída rápida
  \draw[very thick, teal!70!black] (0,0.5) -- (6,0.5)
    -- plot[domain=6:9, samples=25] (\x,{0.5+10.5*(1-cos(180*(\x-6)/3))/2})
    -- plot[domain=9:14, samples=25] (\x,{0.5+10.5*(1+cos(180*(\x-9)/5))/2})
    -- (25,0.5)
    -- plot[domain=25:39, samples=40] (\x,{0.5+3.6*(1-cos(180*(\x-25)/14))/2})
    -- plot[domain=39:42, samples=20] (\x,{0.5+3.6*(1+cos(180*(\x-39)/3))/2})
    -- (72,0.5)
    -- plot[domain=72:78, samples=25] (\x,{0.5+4.5*(1-cos(180*(\x-72)/6))/2})
    -- plot[domain=78:81, samples=20] (\x,{0.5+4.5*(1+cos(180*(\x-78)/3))/2})
    -- (91,0.5)
    -- plot[domain=91:98, samples=25] (\x,{0.5+5.4*(1-cos(180*(\x-91)/7))/2})
    -- plot[domain=98:101, samples=20] (\x,{0.5+5.4*(1+cos(180*(\x-98)/3))/2})
    -- (103,0.5)
    -- plot[domain=103:108, samples=30] (\x,{0.5+27.7*(1-cos(180*(\x-103)/5))/2});
  % fuera de la serie: final de la quinta ola y sexta ola
  \draw[very thick, dashed, teal!70!black] (108,28.2) -- (110,28.2)
    -- plot[domain=110:112, samples=20] (\x,{0.5+27.7*(1+cos(180*(\x-110)/2))/2})
    -- (113,0.5)
    -- plot[domain=113:117, samples=25] (\x,{0.5+14.5*(1-cos(180*(\x-113)/4))/2})
    -- plot[domain=117:119, samples=20] (\x,{0.5+14.5*(1+cos(180*(\x-117)/2))/2})
    -- (124,0.5);
  % rótulos: fechas y tipo dominante
  \node[ola] at (9,15.5) {\textbf{1897-1904}\\ horizontales};
  \node[ola] at (32.5,9) {\textbf{1916-1929}\\ verticales};
  \node[ola] at (77,10) {\textbf{1965-1969}\\ conglomerados};
  \node[ola] at (96.5,11) {\textbf{1984-1989}\\ hostiles y LBO};
  \node[ola] at (93,24.5) {\textbf{1993-2000}\\ estratégicas\\ y globales};
  \node[ola] at (121,20) {\textbf{2003-2007}\\ capital riesgo};
\end{tikzpicture}
