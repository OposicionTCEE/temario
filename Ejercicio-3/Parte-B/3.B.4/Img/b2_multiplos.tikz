% Figura (bloque 2, «Contenido: ¿qué resume un múltiplo?»). Múltiplo del resultado de explotación después de impuestos
% que implica la fórmula de los inductores de valor (KOLLER, GOEDHART y WESSELS, 2020):
% V/[BAII_1(1 - tau)] = (1 - g/RONIC)/(k - g) = 1/k + (g/RONIC)(RONIC - k)/[k(k - g)]. La base, 1/k, es lo que vale cada
% euro de resultado sin crecimiento y solo depende del riesgo; la prima de crecimiento es positiva y crece con g si
% RONIC > k, nula si RONIC = k y negativa si RONIC < k (rayado: lo que el crecimiento resta). Valores ilustrativos:
% k = 10 % (base de 10), g = 2 % y 5 %, RONIC = 20 % (11,25 y 15), 10 % (10 y 10) y 7 % (8,93 y 5,71).
% Generar con: bash Code/generar_figura.sh b2_multiplos
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]},
    nota/.style={font=\scriptsize, align=center, inner sep=1pt},
    base/.style={fill=black!20, draw},
    prima/.style={fill=teal!45, draw},
    resta/.style={draw=black!55, dashed, fill=white}]
  \begin{scope}[y=0.22cm]
    % ejes y base
    \draw[->] (0,0) -- (7.9,0);
    \draw[->] (0,0) -- (0,17.6) node[above] {múltiplo};
    \draw[dashed, black!55] (0,10) -- (7.7,10) node[right, nota, align=left, black] {sin crecer:\\ solo el riesgo};
    \node[left] at (0,10) {$1/k$};
    % RONIC > k: la prima crece con g
    \draw[base] (0.63,0) rectangle (1.33,10); \draw[prima] (0.63,10) rectangle (1.33,11.25);
    \draw[base] (1.47,0) rectangle (2.17,10); \draw[prima] (1.47,10) rectangle (2.17,15);
    % RONIC = k: el crecimiento no cambia el múltiplo
    \draw[base] (3.13,0) rectangle (3.83,10);
    \draw[base] (3.97,0) rectangle (4.67,10);
    % RONIC < k: crecer resta
    \draw[base] (5.63,0) rectangle (6.33,8.93); \draw[resta] (5.63,8.93) rectangle (6.33,10);
    \draw[base] (6.47,0) rectangle (7.17,5.71); \draw[resta] (6.47,5.71) rectangle (7.17,10);
    % rótulos de las barras y de los grupos
    \foreach \c in {1.4,3.9,6.4} {
      \node[nota, below] at (\c-0.42,0) {$g$ bajo};
      \node[nota, below] at (\c+0.42,0) {$g$ alto};
    }
    \node at (1.4,-4.6) {$RONIC>k$};
    \node at (3.9,-4.6) {$RONIC=k$};
    \node at (6.4,-4.6) {$RONIC<k$};
    \node[nota, teal!50!black] at (1.4,16.7) {prima de crecimiento};
    \node[nota, align=left, anchor=west] (r) at (7.5,6.2) {prima\\ negativa};
    \draw[black!50] (r.west) -- (6.95,7.6);
  \end{scope}
\end{tikzpicture}
