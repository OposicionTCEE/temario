% Figura (bloque 2, «Contenido: ¿qué resume un múltiplo?»). Múltiplo valor de la empresa / resultado de explotación del año
% siguiente que implica la fórmula de los inductores de valor (KOLLER, GOEDHART y WESSELS, 2020):
% V/BAII = (1 - tau)(1 - g/RONIC)/(k - g), según la rentabilidad de la nueva inversión, RONIC, para dos tasas de crecimiento
% g_1 < g_2. Las curvas se cortan en RONIC = k, donde el múltiplo es (1 - tau)/k cualquiera que sea g; a su derecha, más
% crecimiento da un múltiplo mayor, y a su izquierda, menor (valores ilustrativos: tau = 25 %, k = 10 %, g = 2 % y 5 %).
% Esquema ilustrativo.
% Generar con: bash Code/generar_figura.sh b2_multiplos
\begin{tikzpicture}[font=\footnotesize]
  \begin{axis}[width=8.2cm, height=5.4cm, axis lines=left, xmin=0.04, xmax=0.31, ymin=0, ymax=14.5,
      xtick={0.1}, xticklabels={$k$}, ytick={7.5}, yticklabels={$\dfrac{1-\tau}{k}$}, xlabel={$RONIC$}, ylabel={$\dfrac{V}{BAII_1}$},
      samples=120, clip=true,
      xlabel style={at={(1,0)}, anchor=north east}, ylabel style={rotate=-90, at={(0,1)}, anchor=south east}]
    \addplot[very thick, black!45, domain=0.04:0.31] {0.75*(1-0.02/x)/(0.1-0.02)};
    \addplot[very thick, teal!70!black, domain=0.04:0.31] {0.75*(1-0.05/x)/(0.1-0.05)};
    \draw[dashed, black!40] (axis cs:0.1,0) -- (axis cs:0.1,7.5) -- (axis cs:0.04,7.5);
    \node[font=\scriptsize, teal!70!black, anchor=west] at (axis cs:0.255,12.3) {$g_2$};
    \node[font=\scriptsize, black!60, anchor=west] at (axis cs:0.255,8.0) {$g_1$};
    \node[font=\scriptsize, black!70, anchor=north west] at (axis cs:0.235,3.0) {$g_1<g_2$};
  \end{axis}
\end{tikzpicture}
