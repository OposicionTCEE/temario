% Figura del anexo de valoración («Del resultado al flujo de caja libre»). Cascada del resultado de explotación al flujo de
% caja libre: BAII menos los impuestos que pagaría sin deuda, tau BAII, da BAII(1 - tau); se suman las amortizaciones, A, y
% se restan la inversión en inmovilizado, I, y el aumento de las necesidades operativas de fondos, Delta NOF. Las tres
% últimas partidas son, juntas, la inversión neta, Delta CI. Esquema ilustrativo (alturas sin significado numérico).
% Generar con: bash Code/generar_figura.sh anx_val_fcl
\begin{tikzpicture}[font=\footnotesize, y=0.62cm,
    barra/.style={draw, black!70},
    llave/.style={decorate, decoration={brace, amplitude=4pt}}]
  \draw (-0.6,0) -- (9.6,0);
  \fill[black!25] (-0.4,0) rectangle (0.4,5.0);        \draw[barra] (-0.4,0) rectangle (0.4,5.0);
  \fill[black!50] (1.1,5.0) rectangle (1.9,3.75);      \draw[barra] (1.1,5.0) rectangle (1.9,3.75);
  \fill[teal!45] (2.6,0) rectangle (3.4,3.75);         \draw[barra] (2.6,0) rectangle (3.4,3.75);
  \fill[teal!20] (4.1,3.75) rectangle (4.9,4.75);      \draw[barra] (4.1,3.75) rectangle (4.9,4.75);
  \fill[black!50] (5.6,4.75) rectangle (6.4,2.95);     \draw[barra] (5.6,4.75) rectangle (6.4,2.95);
  \fill[black!50] (7.1,2.95) rectangle (7.9,2.35);     \draw[barra] (7.1,2.95) rectangle (7.9,2.35);
  \fill[teal!70!black] (8.6,0) rectangle (9.4,2.35);   \draw[barra] (8.6,0) rectangle (9.4,2.35);
  \foreach \a/\b/\y in {0.4/1.1/5.0, 1.9/2.6/3.75, 3.4/4.1/3.75, 4.9/5.6/4.75, 6.4/7.1/2.95, 7.9/8.6/2.35}
    \draw[dotted] (\a,\y) -- (\b,\y);
  \draw[llave] (4.1,5.25) -- (7.9,5.25) node[midway, above=5pt] {$-\Delta CI$};
  \foreach \x/\l in {0/{BAII}, 1.5/{-\tau\,BAII}, 3.0/{BAII\left(1-\tau\right)}, 4.5/{+A}, 6.0/{-I}, 7.5/{-\Delta NOF}, 9.0/{FCL}}
    \node[below] at (\x,0) {$\l$};
\end{tikzpicture}
