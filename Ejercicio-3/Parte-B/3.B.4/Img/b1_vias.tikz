% Figura (bloque 1, «Vías: ¿construir, comprar o aliarse?»): las tres vías por las que la empresa A puede obtener la
% capacidad que no tiene (almacenes automatizados, con la robótica de B). Construir: inversión I durante un plazo T;
% comprar: precio P = V_B + π; aliarse: contrato o empresa conjunta con B. Esquema ilustrativo.
% Generar con: bash Code/generar_figura.sh b1_vias
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=5pt]},
    caja/.style={draw, thick, rounded corners=2pt, align=center, minimum height=1.2cm, text width=2.7cm}]
  \node[caja] (A) at (0,0) {\textbf{Empresa A}\\ almacenes};
  \node[caja] (C) at (10.4,0) {\textbf{Capacidad}\\ almacenes\\ automatizados};
  % construir
  \draw[->, thick] (A.north) to[out=35, in=145]
    node[above, align=center] {\textbf{Construir}: división de robótica propia\\ inversión $I$ durante un plazo $T$} (C.north);
  % comprar
  \draw[->, thick, teal!70!black] (A.east) --
    node[above] {\textbf{Comprar} la empresa B} node[below] {precio $P=V_B+\pi$} (C.west);
  % aliarse
  \draw[->, thick, dashed] (A.south) to[out=-35, in=-145]
    node[below, align=center] {\textbf{Aliarse} con B\\ contrato o empresa conjunta} (C.south);
\end{tikzpicture}
