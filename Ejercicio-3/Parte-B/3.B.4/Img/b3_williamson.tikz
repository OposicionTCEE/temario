% Figura (bloque 3, «Competencia: ¿compensan los ahorros de costes el poder de mercado?»), a partir de WILLIAMSON
% (1968). Demanda D; antes de la fusión el precio es igual al coste, p_0 = c_0, y se venden q_0 unidades; después,
% el coste baja a c_1 y el precio sube a p_1, y se venden q_1. (a) Excedente total: la fusión ahorra (c_0 - c_1) q_1
% (rectángulo) y destruye el triángulo de pérdida de eficiencia, (p_1 - p_0)(q_0 - q_1)/2. (b) Excedente del
% consumidor: los clientes pierden el rectángulo (p_1 - p_0) q_1, que se traslada a la empresa, y el triángulo.
% Valores ilustrativos: D: p = 4,6 - 0,6 q; c_0 = p_0 = 2,2; c_1 = 1,7; p_1 = 3,1; q_0 = 4; q_1 = 2,5.
% Generar con: bash Code/generar_figura.sh b3_williamson
\begin{tikzpicture}[font=\footnotesize, x=1.0cm, y=0.95cm,
    eje/.style={->, >={Stealth[length=4pt]}},
    guia/.style={dashed, black!55}]
  \foreach \px/\titulo/\panel in {0/{(a) Excedente total}/a, 8.2/{(b) Excedente del consumidor}/b} {
    \begin{scope}[xshift=\px cm]
      \node[font=\footnotesize\bfseries] at (2.9,5.25) {\titulo};
      \ifx\panel a
      \fi
    \end{scope}
  }
  % (a) Excedente total
  \begin{scope}
    \fill[teal!35] (0,1.7) rectangle (2.5,2.2);
    \fill[black!30] (2.5,3.1) -- (2.5,2.2) -- (4,2.2) -- cycle;
    \draw[eje] (0,0) -- (6.2,0) node[below left] {$q$};
    \draw[eje] (0,0) -- (0,4.9) node[left] {$p$};
    \draw[thick] (0,4.6) -- (6,1.0) node[right] {$D$};
    \draw (0,2.2) -- (5.6,2.2) node[right] {$c_0$};
    \draw (0,1.7) -- (5.6,1.7) node[right] {$c_1$};
    \draw[guia] (0,3.1) -- (2.5,3.1);
    \draw[guia] (2.5,3.1) -- (2.5,0);
    \draw[guia] (4,2.2) -- (4,0);
    \node[left] at (0,3.1) {$p_1$};
    \node[left] at (0,2.2) {$p_0$};
    \node[below] at (2.5,0) {$q_1$};
    \node[below] at (4,0) {$q_0$};
    \node[font=\scriptsize] at (1.25,1.95) {ahorro de costes};
    \node[font=\scriptsize, align=left, right] at (3.25,2.95) {pérdida de\\ eficiencia};
  \end{scope}
  % (b) Excedente del consumidor
  \begin{scope}[xshift=8.2cm]
    \fill[black!14] (0,2.2) rectangle (2.5,3.1);
    \fill[black!30] (2.5,3.1) -- (2.5,2.2) -- (4,2.2) -- cycle;
    \draw[eje] (0,0) -- (6.2,0) node[below left] {$q$};
    \draw[eje] (0,0) -- (0,4.9) node[left] {$p$};
    \draw[thick] (0,4.6) -- (6,1.0) node[right] {$D$};
    \draw (0,2.2) -- (5.6,2.2) node[right] {$c_0$};
    \draw (0,1.7) -- (5.6,1.7) node[right] {$c_1$};
    \draw[guia] (0,3.1) -- (2.5,3.1);
    \draw[guia] (2.5,3.1) -- (2.5,0);
    \draw[guia] (4,2.2) -- (4,0);
    \node[left] at (0,3.1) {$p_1$};
    \node[left] at (0,2.2) {$p_0$};
    \node[below] at (2.5,0) {$q_1$};
    \node[below] at (4,0) {$q_0$};
    \node[font=\scriptsize] at (1.25,2.65) {traslado a la empresa};
    \node[font=\scriptsize, align=left, right] at (3.25,2.95) {pérdida de\\ eficiencia};
  \end{scope}
\end{tikzpicture}
