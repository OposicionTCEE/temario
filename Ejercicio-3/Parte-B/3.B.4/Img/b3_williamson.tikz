% Figura (bloque 3, «Competencia: ¿compensa el ahorro de costes el poder de mercado?»), a partir de WILLIAMSON (1968).
% Demanda D; antes de la fusión el precio es igual al coste, p_0 = c_0, y se venden q_0 unidades (punto «antes»);
% después, el coste baja a c_1 y el precio sube a p_1, y los clientes compran menos, q_1 < q_0 (punto «después»).
% (a) Excedente total: la fusión ahorra (c_0 - c_1) q_1 (rectángulo) y destruye el triángulo de pérdida de eficiencia,
% (p_1 - p_0)(q_0 - q_1)/2; el rectángulo (p_1 - p_0) q_1 es un traslado de los clientes a la empresa y no cambia el
% total. (b) Excedente del consumidor: los clientes pierden el traslado y el triángulo, y el ahorro no les llega si el
% precio no baja. Valores ilustrativos: D: p = 4,6 - 0,6 q; c_0 = p_0 = 2,2; c_1 = 1,7; p_1 = 3,1; q_0 = 4; q_1 = 2,5.
% Generar con: bash Code/generar_figura.sh b3_williamson
\begin{tikzpicture}[font=\footnotesize, x=1.0cm, y=0.95cm,
    eje/.style={->, >={Stealth[length=4pt]}},
    guia/.style={dashed, black!55},
    nota/.style={font=\scriptsize, align=center, inner sep=1pt}]
  \foreach \k/\tit in {0/{(a) Excedente total}, 1/{(b) Excedente del consumidor}} {
    \begin{scope}[xshift=\k*8.2cm]
      \node[font=\footnotesize\bfseries] at (2.9,5.25) {\tit};
      \ifnum\k=0
        \fill[teal!35] (0,1.7) rectangle (2.5,2.2);
        \draw[dashed, black!45] (0,2.2) rectangle (2.5,3.1);
        \node[nota] at (1.25,1.95) {ahorro de costes};
        \node[nota, black!60] at (1.25,2.65) {traslado:\\ no cambia el total};
      \else
        \fill[black!14] (0,2.2) rectangle (2.5,3.1);
        \draw[dashed, black!45] (0,1.7) rectangle (2.5,2.2);
        \node[nota] at (1.25,2.65) {traslado\\ a la empresa};
        \node[nota, black!60] at (1.25,1.95) {ahorro: no les llega};
      \fi
      \fill[black!30] (2.5,3.1) -- (2.5,2.2) -- (4,2.2) -- cycle;
      \draw[eje] (0,0) -- (6.2,0) node[below left] {$q$};
      \draw[eje] (0,0) -- (0,4.9) node[left] {$p$};
      \draw[thick] (0,4.6) -- (6,1.0) node[right] {$D$};
      \draw (0,2.2) -- (5.6,2.2) node[right] {$c_0$};
      \draw (0,1.7) -- (5.6,1.7) node[right] {$c_1$};
      \draw[guia] (2.5,3.1) -- (2.5,0);
      \draw[guia] (4,2.2) -- (4,0);
      \node[left] at (0,3.1) {$p_1$};
      \node[left] at (0,2.2) {$p_0$};
      \node[below] at (2.5,0) {$q_1$};
      \node[below] at (4,0) {$q_0$};
      \fill (4,2.2) circle (1.6pt) node[nota, anchor=south west] {antes};
      \fill (2.5,3.1) circle (1.6pt) node[nota, anchor=south west] {después};
      \node[nota] (t) at (4.75,3.35) {pérdida de\\ eficiencia};
      \draw[black!50] (t.south west) -- (3.0,2.5);
    \end{scope}
  }
\end{tikzpicture}
