% Figura (bloque 1, «Aliarse: ¿por qué no integrarse del todo?»): grados de integración con otra empresa, del mercado a la
% jerarquía, con las formas híbridas en medio (WILLIAMSON, 1991). Hacia la derecha aumentan el control y la integración;
% hacia la izquierda, la flexibilidad y la reversibilidad. Esquema ilustrativo.
% Generar con: bash Code/generar_figura.sh b1_integracion
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=5pt]}]
  \draw[thick] (0,0) -- (13.2,0);
  \foreach \x/\t in {0.6/{contrato puntual}, 2.6/{contrato a largo plazo}, 4.6/{alianza contractual},
      6.6/{empresa conjunta}, 8.6/{participación minoritaria}, 10.6/{adquisición}, 12.6/{fusión}} {
    \draw[thick] (\x,0.12) -- (\x,-0.12);
    \node[below, align=center, text width=1.8cm] at (\x,-0.15) {\t};
  }
  \draw[decorate, decoration={brace, amplitude=5pt}] (0.1,0.3) -- (3.1,0.3) node[midway, above=6pt] {\textbf{mercado}};
  \draw[decorate, decoration={brace, amplitude=5pt}] (4.1,0.3) -- (9.1,0.3) node[midway, above=6pt] {\textbf{formas híbridas}};
  \draw[decorate, decoration={brace, amplitude=5pt}] (10.1,0.3) -- (13.1,0.3) node[midway, above=6pt] {\textbf{jerarquía}};
  \draw[->, thick, teal!70!black] (0.6,-1.5) -- (12.6,-1.5) node[midway, above] {más control e integración};
  \draw[->, thick, black!55] (12.6,-2.0) -- (0.6,-2.0) node[midway, below] {más flexibilidad y reversibilidad};
\end{tikzpicture}
