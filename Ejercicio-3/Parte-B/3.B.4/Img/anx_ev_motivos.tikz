% Figura (anexo de evidencia, «Contraste: ¿cómo distinguir los motivos?»), a partir de BERKOVITCH y NARAYANAN (1993): relación entre
% la ganancia total de la operación, S, y la de la empresa comprada, la prima pi, según el motivo de la compra.
% (a) Sinergia: S > 0 y correlación positiva. (b) Arrogancia: S = 0 y correlación nula. (c) Agencia: S < 0 y correlación
% negativa. La recta discontinua pi = S separa las operaciones en que gana el comprador (debajo, VAN_A = S - pi > 0) de las
% que pierde (encima). Puntos ilustrativos.
% Generar con: bash Code/generar_figura.sh anx_ev_motivos
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]},
    punto/.style={circle, fill=teal!70!black, inner sep=0pt, minimum size=4pt}]
  \foreach \k/\tit/\cond in {0/{(a) Sinergia}/{>0}, 1/{(b) Arrogancia}/{=0}, 2/{(c) Agencia}/{<0}} {
    \begin{scope}[xshift=\k*5.2cm]
      \draw[->] (-2.0,0) -- (2.1,0) node[below left] {$S$};
      \draw[->] (0,0) -- (0,2.7) node[left] {$\pi$};
      \draw[dashed, black!50] (0,0) -- (1.95,1.95) node[right, black!65] {$\pi=S$};
      \node[font=\footnotesize\bfseries] at (0,3.15) {\tit};
      \node at (0,-0.55) {$\mathrm{corr}(S,\pi)\cond$};
    \end{scope}
  }
  % (a) Sinergia: la prima crece con la sinergia y queda por debajo de ella
  \foreach \x/\y in {0.35/0.28, 0.55/0.22, 0.75/0.52, 0.95/0.45, 1.15/0.78, 1.3/0.66, 1.5/0.98, 1.68/0.92, 1.85/1.22}
    \node[punto] at (\x,\y) {};
  % (b) Arrogancia: ganancia total nula, cualquiera que sea la prima
  \begin{scope}[xshift=5.2cm]
    \foreach \x/\y in {0.07/0.3, -0.08/0.58, 0.06/0.86, -0.05/1.12, 0.08/1.4, -0.07/1.68, 0.04/1.96, -0.04/2.24}
      \node[punto] at (\x,\y) {};
  \end{scope}
  % (c) Agencia: cuanto más se paga, más valor total se destruye
  \begin{scope}[xshift=10.4cm]
    \foreach \x/\y in {-0.3/0.36, -0.5/0.42, -0.68/0.7, -0.86/0.74, -1.05/1.0, -1.24/1.06, -1.42/1.34, -1.62/1.4, -1.82/1.66}
      \node[punto] at (\x,\y) {};
  \end{scope}
\end{tikzpicture}
