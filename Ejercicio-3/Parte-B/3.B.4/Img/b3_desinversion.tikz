% Figura (bloque 3, «Desinversión: ¿cuándo conviene vender una parte de la empresa?»). Propiedad de la división j
% después de cada forma de desinvertir. (a) Venta: j pasa a otra empresa, que paga en efectivo a la vendedora.
% (b) Escisión (spin-off): las acciones de j se reparten entre los accionistas de la empresa, que pasan a tener dos
% sociedades; no entra efectivo. (c) Salida parcial a bolsa (carve-out): la empresa vende a nuevos inversores una
% minoría de j, cobra en efectivo y conserva el control. Esquema ilustrativo.
% Generar con: bash Code/generar_figura.sh b3_desinversion
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]},
    caja/.style={draw, rounded corners=2pt, minimum width=1.9cm, minimum height=0.62cm, align=center, fill=white},
    division/.style={caja, fill=teal!30, minimum width=1.2cm},
    propiedad/.style={-, thick},
    dinero/.style={->, thick, teal!60!black}]
  % (a) Venta
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (1.6,3.1) {(a) Venta};
    \node[caja, fill=black!10] (acc) at (0.4,2.2) {Accionistas};
    \node[caja] (emp) at (0.4,0.9) {Empresa};
    \node[caja, fill=black!10] (comp) at (2.8,2.2) {Comprador};
    \node[division] (j) at (2.8,0.9) {$j$};
    \draw[propiedad] (acc) -- (emp);
    \draw[propiedad] (comp) -- (j);
    \draw[dinero] (comp.south west) to[bend right=15] node[left=1pt, pos=0.55, text=black] {efectivo} (emp.north east);
  \end{scope}
  % (b) Escisión
  \begin{scope}[xshift=5.3cm]
    \node[font=\footnotesize\bfseries] at (1.6,3.1) {(b) Escisión};
    \node[caja, fill=black!10] (acc) at (1.6,2.2) {Accionistas};
    \node[caja] (emp) at (0.4,0.9) {Empresa};
    \node[division] (j) at (2.8,0.9) {$j$};
    \draw[propiedad] (acc) -- (emp);
    \draw[propiedad] (acc) -- (j);
  \end{scope}
  % (c) Salida parcial a bolsa
  \begin{scope}[xshift=10.6cm]
    \node[font=\footnotesize\bfseries] at (1.6,3.1) {(c) Salida parcial a bolsa};
    \node[caja, fill=black!10] (acc) at (0.4,2.2) {Accionistas};
    \node[caja] (emp) at (0.4,0.9) {Empresa};
    \node[caja, fill=black!10] (nuevos) at (2.8,2.2) {Nuevos\\ inversores};
    \node[division] (j) at (1.6,-0.4) {$j$};
    \draw[propiedad] (acc) -- (emp);
    \draw[propiedad] (emp) -- node[left=2pt, font=\scriptsize] {mayoría} (j);
    \draw[propiedad] (nuevos) -- node[right=3pt, pos=0.6, font=\scriptsize] {minoría} (j);
    \draw[dinero] (nuevos.west) -- node[above=1pt, text=black] {efectivo} ([yshift=-0.12cm]emp.north east);
  \end{scope}
\end{tikzpicture}
