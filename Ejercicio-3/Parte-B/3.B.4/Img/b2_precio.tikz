% Figura (bloque 2, «Precio: ¿dónde termina entre el mínimo y el máximo?»). El precio P de la empresa B queda entre lo
% mínimo que acepta el vendedor, V_B, y lo máximo que paga el comprador, V_B + S. (a) Negociación bilateral: solución de
% negociación de NASH (1950) en su versión asimétrica, P = V_B + beta S; el vendedor obtiene pi = beta S y el comprador
% S - pi. (b) Competencia entre dos compradores con sinergias S_1 > S_2: el precio sube hasta V_B + S_2, la prima es S_2 y
% el ganador conserva S_1 - S_2. Esquema ilustrativo.
% Generar con: bash Code/generar_figura.sh b2_precio
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]},
    marca/.style={draw, thick},
    llave/.style={decorate, decoration={brace, amplitude=4pt, mirror}}]
  % (a) Negociación bilateral
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (3.3,1.55) {(a) Negociación bilateral};
    \draw[->] (-0.3,0) -- (7.0,0) node[below left] {valor};
    \fill[teal!25] (0.6,-0.12) rectangle (6.0,0.12);
    \foreach \x/\l in {0.6/{V_B}, 6.0/{V_B+S}} {
      \draw[marca] (\x,0.22) -- (\x,-0.22);
      \node[above] at (\x,0.25) {$\l$};
    }
    \fill[teal!70!black] (3.3,0.28) -- (3.12,0.62) -- (3.48,0.62) -- cycle;
    \node[above] at (3.3,0.62) {$P=V_B+\beta S$};
    \draw[llave] (0.6,-0.32) -- (3.28,-0.32) node[midway, below=5pt] {$\pi=\beta S$};
    \draw[llave] (3.32,-0.32) -- (6.0,-0.32) node[midway, below=5pt] {$S-\pi$};
    \node at (3.3,-1.35) {$0\leq\beta\leq1$};
  \end{scope}
  % (b) Competencia entre compradores
  \begin{scope}[xshift=8.4cm]
    \node[font=\footnotesize\bfseries] at (3.3,1.55) {(b) Competencia entre compradores};
    \draw[->] (-0.3,0) -- (7.0,0) node[below left] {valor};
    \fill[teal!25] (4.2,-0.12) rectangle (6.0,0.12);
    \foreach \x/\l in {0.6/{V_B}, 4.2/{V_B+S_2}, 6.0/{V_B+S_1}} {
      \draw[marca] (\x,0.22) -- (\x,-0.22);
      \node[above] at (\x,0.25) {$\l$};
    }
    \fill[teal!70!black] (4.2,0.62) -- (4.02,0.96) -- (4.38,0.96) -- cycle;
    \node[right] at (4.4,0.82) {$P$};
    \draw[llave] (0.6,-0.32) -- (4.18,-0.32) node[midway, below=5pt] {$\pi=S_2$};
    \draw[llave] (4.22,-0.32) -- (6.0,-0.32) node[midway, below=5pt] {$S_1-S_2$};
    \node at (3.3,-1.35) {$S_1>S_2$};
  \end{scope}
\end{tikzpicture}
