% Figura (bloque 2, «Patrimonio: ¿qué suelo pone lo que la empresa tiene?»). Valor de las acciones según la rentabilidad
% financiera esperada, ROE, con el modelo del beneficio residual (OHLSON, 1995) con rentabilidad constante, sin crecimiento y
% reparto de todo el resultado: E = PN ROE/k_E. La empresa vale su patrimonio neto contable, PN, solo si ROE = k_E; por
% debajo, vale menos, hasta el valor de liquidación, VL, en que conviene liquidarla; el valor es el mayor de los dos
% (línea gruesa). Esquema ilustrativo.
% Generar con: bash Code/generar_figura.sh b2_patrimonio
\begin{tikzpicture}[font=\footnotesize]
  \begin{axis}[width=8.2cm, height=5.4cm, axis lines=left, xmin=0, xmax=0.2, ymin=0, ymax=19,
      xtick={0.1}, xticklabels={$k_E$}, ytick={6,10}, yticklabels={$VL$, $PN$}, xlabel={$ROE$}, ylabel={$E$},
      samples=2, clip=false,
      xlabel style={at={(1,0)}, anchor=north east}, ylabel style={rotate=-90, at={(0,1)}, anchor=south east}]
    % continuar: E = PN ROE / k_E (PN = 10, k_E = 10 %)
    \addplot[thick, dashed, black!45, domain=0:0.06] {100*x};
    \addplot[line width=1.6pt, teal!70!black, domain=0.06:0.185] {100*x};
    % liquidar: VL
    \addplot[line width=1.6pt, black!60, domain=0:0.06] {6};
    \addplot[thick, dashed, black!35, domain=0.06:0.185] {6};
    % patrimonio neto contable
    \draw[dashed, black!40] (axis cs:0,10) -- (axis cs:0.1,10) -- (axis cs:0.1,0);
    \node[font=\scriptsize, teal!70!black, anchor=south east] at (axis cs:0.16,16.6) {$PN\,\dfrac{ROE}{k_E}$};
  \end{axis}
\end{tikzpicture}
