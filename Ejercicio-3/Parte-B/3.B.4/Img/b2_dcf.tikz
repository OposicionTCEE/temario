% Figura (bloque 2, «Valor por sí sola: flujos, tasa y valor terminal»). (a) El valor de B por sí sola: flujos de caja
% libres de un horizonte de T años más el valor terminal, descontados a la tasa del riesgo de B, k_B. (b) Crecer exige
% reinvertir: el resultado de explotación después de impuestos se reparte entero si la empresa no crece; para crecer a la
% tasa g hay que reinvertir la fracción g/RONIC, menor cuanto más rinde la nueva inversión (fórmula de los inductores de
% valor de KOLLER, GOEDHART y WESSELS, 2020). Valores ilustrativos: g = 5 %, RONIC = 15 % (reinversión de un tercio) y
% RONIC = 7 % (reinversión del 71 %). Esquema ilustrativo.
% Generar con: bash Code/generar_figura.sh b2_dcf
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]},
    nota/.style={font=\scriptsize, align=center, inner sep=1pt}]
  % títulos a la misma altura
  \foreach \x/\t in {2.6/{(a) Flujos y valor terminal}, 11.0/{(b) Crecer exige reinvertir}}
    \node[font=\footnotesize\bfseries] at (\x,4.3) {\t};
  % (a) Flujos y valor terminal
  \begin{scope}[x=0.9cm, y=0.95cm]
    \draw[->] (-0.4,0) -- (6.3,0) node[below left] {años};
    \foreach \t/\h in {1/0.45, 2/0.55, 3/0.65, 4/0.75, 5/0.85} {
      \fill[black!30] (\t-0.3,0) rectangle (\t+0.3,\h);
      \draw (\t-0.3,0) rectangle (\t+0.3,\h);
    }
    \fill[teal!40] (4.7,0.85) rectangle (5.3,3.6); \draw (4.7,0.85) rectangle (5.3,3.6);
    \node[right] at (5.35,2.3) {$VT_T$};
    \node[above] at (3,0.65) {$FCL_t$};
    \fill[teal!70!black] (-0.3,0) rectangle (0.3,2.6); \draw (-0.3,0) rectangle (0.3,2.6);
    \node[above] at (0,2.6) {$V_B$};
    \draw[->, dashed, black!60] (4.6,3.2) to[out=150, in=20] node[above, black] {$k_B$} (0.4,2.45);
    \foreach \t/\l in {0/0, 1/1, 5/T} \node[below] at (\t,0) {$\l$};
  \end{scope}
  % (b) Crecer exige reinvertir: el mismo resultado, repartido o reinvertido
  \begin{scope}[xshift=7.5cm]
    \draw[decorate, decoration={brace, amplitude=3pt}] (1.7,3.65) -- (6.7,3.65)
      node[midway, above=3pt, nota] {resultado de explotación después de impuestos};
    % sin crecer
    \fill[teal!40] (1.7,3.0) rectangle (6.7,3.55); \draw (1.7,3.0) rectangle (6.7,3.55);
    \node[nota] at (4.2,3.275) {flujo libre: se reparte todo};
    \node[left, align=right] at (1.6,3.275) {sin crecer};
    % crecer a g con RONIC alta
    \fill[black!25] (1.7,1.85) rectangle (3.37,2.4);
    \fill[teal!40] (3.37,1.85) rectangle (6.7,2.4);
    \draw (1.7,1.85) rectangle (6.7,2.4); \draw (3.37,1.85) -- (3.37,2.4);
    \node[nota] at (2.535,2.125) {reinversión};
    \node[nota] at (5.035,2.125) {flujo libre};
    \node[left, align=right] at (1.6,2.125) {crecer a $g$,\\ $RONIC$ alta};
    % crecer a g con RONIC baja
    \fill[black!25] (1.7,0.7) rectangle (5.27,1.25);
    \fill[teal!40] (5.27,0.7) rectangle (6.7,1.25);
    \draw (1.7,0.7) rectangle (6.7,1.25); \draw (5.27,0.7) -- (5.27,1.25);
    \node[nota] at (3.485,0.975) {reinversión: $g/RONIC$ del resultado};
    \node[nota] at (5.985,0.975) {flujo libre};
    \node[left, align=right] at (1.6,0.975) {crecer a $g$,\\ $RONIC$ baja};
  \end{scope}
\end{tikzpicture}
