% Figura (bloque 2, «Descuento de flujos»). (a) El valor de B por sí sola: flujos de caja libres de un horizonte de T años
% más el valor terminal, descontados a la tasa del riesgo de B, k_B. (b) Valor terminal según el crecimiento g con la
% fórmula de los inductores de valor (KOLLER, GOEDHART y WESSELS, 2020), VT = BAII(1 - tau)(1 - g/RONIC)/(k - g): crece
% con g si RONIC > k, no cambia si RONIC = k y disminuye si RONIC < k (valores ilustrativos: k = 10 %, RONIC = 20 %, 10 % y
% 7 %). (c) La sinergia: los costes de integración llegan al principio; los ahorros de costes, antes y más seguros que los
% aumentos de ingresos. Esquema ilustrativo.
% Generar con: bash Code/generar_figura.sh b2_dcf
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  % títulos a la misma altura
  \foreach \x/\t in {2.2/{(a) Flujos y valor terminal}, 7.7/{(b) Crecimiento y valor terminal}, 13.0/{(c) La sinergia}}
    \node[font=\footnotesize\bfseries] at (\x,4.0) {\t};
  % (a) Flujos y valor terminal
  \begin{scope}[x=0.72cm, y=0.9cm]
    \draw[->] (-0.4,0) -- (6.3,0) node[below left] {años};
    \foreach \t/\h in {1/0.45, 2/0.55, 3/0.65, 4/0.75, 5/0.85} {
      \fill[black!30] (\t-0.3,0) rectangle (\t+0.3,\h);
      \draw (\t-0.3,0) rectangle (\t+0.3,\h);
    }
    \fill[teal!40] (4.7,0.85) rectangle (5.3,3.6); \draw (4.7,0.85) rectangle (5.3,3.6);
    \node[right] at (5.35,2.3) {$VT_T$};
    \node[above] at (3,0.65) {$FCL_t$};
    \fill[teal!70!black] (-0.3,0) rectangle (0.3,2.6); \draw (-0.3,0) rectangle (0.3,2.6);
    \node[above] at (0,2.6) {$V_B$};
    \draw[->, dashed, black!60] (4.6,3.2) to[out=150, in=20] node[above, black] {$k_B$} (0.4,2.45);
    \foreach \t/\l in {0/0, 1/1, 5/T} \node[below] at (\t,0) {$\l$};
  \end{scope}
  % (b) Crecimiento y valor terminal
  \begin{axis}[at={(5.4cm,0)}, width=5.0cm, height=4.4cm, scale only axis=false, axis lines=left, xmin=0, xmax=0.125,
      ymin=0, ymax=34, xtick={0.1}, xticklabels={$k$}, ytick=\empty, xlabel={$g$}, ylabel={$VT$}, samples=80, clip=true,
      xlabel style={at={(1,0)}, anchor=north east}, ylabel style={rotate=-90, at={(0,1)}, anchor=south east}]
    \addplot[very thick, teal!70!black, domain=0:0.087] {(1-x/0.2)/(0.1-x)};
    \addplot[very thick, black!60, domain=0:0.1] {10};
    \addplot[very thick, black!35, domain=0:0.07] {(1-x/0.07)/(0.1-x)};
    \draw[dashed, black!40] (axis cs:0.1,0) -- (axis cs:0.1,34);
    \node[font=\scriptsize, teal!70!black, anchor=east] at (axis cs:0.063,20) {$RONIC>k$};
    \node[font=\scriptsize, black!70, anchor=south] at (axis cs:0.075,10.4) {$RONIC=k$};
    \node[font=\scriptsize, black!55, anchor=north west] at (axis cs:0.004,6.6) {$RONIC<k$};
  \end{axis}
  % (c) La sinergia
  \begin{scope}[xshift=10.8cm, x=0.66cm, y=1.05cm]
    \draw[->] (0.2,0) -- (7.0,0) node[below left] {años};
    \draw[->] (0.2,-1.2) -- (0.2,2.6) node[right] {$\Delta FCL_t$};
    \foreach \t/\c/\a/\i in {1/-1.0/0.2/0, 2/-0.4/0.6/0.1, 3/0/0.9/0.3, 4/0/1.0/0.5, 5/0/1.0/0.6, 6/0/1.0/0.7} {
      \fill[teal!60!black] (\t-0.28,0) rectangle (\t+0.28,\a);
      \fill[teal!25] (\t-0.28,\a) rectangle (\t+0.28,\a+\i);
      \fill[black!35] (\t-0.28,0) rectangle (\t+0.28,\c);
    }
    \foreach \y/\c/\l in {2.15/teal!60!black/{ahorro de costes}, 1.85/teal!25/{aumento de ingresos}, -0.95/black!35/{costes de integración}} {
      \fill[\c] (2.3,\y-0.08) rectangle (2.55,\y+0.08);
      \node[right, font=\scriptsize] at (2.6,\y) {\l};
    }
  \end{scope}
\end{tikzpicture}
