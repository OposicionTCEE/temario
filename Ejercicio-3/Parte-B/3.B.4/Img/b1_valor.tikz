% Figura (bloque 1, «Sinergia y prima: ¿cuándo gana el comprador?»), a partir de BREALEY, MYERS y ALLEN (2020).
% (a) La sinergia: V_AB = V_A + V_B + S. (b) El reparto: A obtiene V_B + S y paga P = V_B + π; VAN_A = S − π, positivo si
% π < S y negativo si π > S. Valores ilustrativos: V_A = 3, V_B = 1,4, S = 0,9; π = 0,5 o 1,3.
% Generar con: bash Code/generar_figura.sh b1_valor
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, y=0.8cm]
  % (a) La sinergia
  \node[font=\footnotesize\bfseries] at (2.4,6.2) {(a) La sinergia};
  \fill[black!12] (0.2,0) rectangle (1.2,3); \draw (0.2,0) rectangle (1.2,3); \node at (0.7,1.5) {$V_A$};
  \fill[black!30] (1.8,0) rectangle (2.8,1.4); \draw (1.8,0) rectangle (2.8,1.4); \node at (2.3,0.7) {$V_B$};
  \fill[black!12] (3.6,0) rectangle (4.6,3); \draw (3.6,0) rectangle (4.6,3); \node at (4.1,1.5) {$V_A$};
  \fill[black!30] (3.6,3) rectangle (4.6,4.4); \draw (3.6,3) rectangle (4.6,4.4); \node at (4.1,3.7) {$V_B$};
  \fill[teal!40] (3.6,4.4) rectangle (4.6,5.3); \draw (3.6,4.4) rectangle (4.6,5.3); \node at (4.1,4.85) {$S$};
  \draw[dashed] (0,4.4) -- (5.0,4.4);
  \node[right] at (5.0,4.4) {$V_A+V_B$};
  \node[below] at (0.7,0) {A}; \node[below] at (2.3,0) {B};
  \node[below, align=center] at (4.1,0) {A y B\\ unidas};
  \draw (0,0) -- (5.0,0);
  % (b) El reparto
  \begin{scope}[xshift=7.4cm]
    \node[font=\footnotesize\bfseries] at (2.9,6.2) {(b) El reparto};
    % caso pi < S
    \fill[black!30] (0.2,0) rectangle (1.2,1.4); \draw (0.2,0) rectangle (1.2,1.4); \node at (0.7,0.7) {$V_B$};
    \fill[teal!40] (0.2,1.4) rectangle (1.2,2.3); \draw (0.2,1.4) rectangle (1.2,2.3); \node at (0.7,1.85) {$S$};
    \fill[black!30] (1.5,0) rectangle (2.5,1.4); \draw (1.5,0) rectangle (2.5,1.4); \node at (2.0,0.7) {$V_B$};
    \fill[black!55] (1.5,1.4) rectangle (2.5,1.9); \draw (1.5,1.4) rectangle (2.5,1.9); \node[white] at (2.0,1.65) {$\pi$};
    \draw[decorate, decoration={brace, amplitude=3pt}] (2.6,2.3) -- (2.6,1.9) node[midway, right=3pt] {$VAN_A>0$};
    \draw[dotted] (1.2,2.3) -- (2.6,2.3);
    \node[below, align=center] at (0.7,0) {obtiene\\ $V_B+S$}; \node[below, align=center] at (2.0,0) {paga\\ $P$};
    \node at (1.35,-1.25) {$\pi<S$};
    % caso pi > S
    \begin{scope}[xshift=4.0cm]
      \fill[black!30] (0.2,0) rectangle (1.2,1.4); \draw (0.2,0) rectangle (1.2,1.4); \node at (0.7,0.7) {$V_B$};
      \fill[teal!40] (0.2,1.4) rectangle (1.2,2.3); \draw (0.2,1.4) rectangle (1.2,2.3); \node at (0.7,1.85) {$S$};
      \fill[black!30] (1.5,0) rectangle (2.5,1.4); \draw (1.5,0) rectangle (2.5,1.4); \node at (2.0,0.7) {$V_B$};
      \fill[black!55] (1.5,1.4) rectangle (2.5,2.7); \draw (1.5,1.4) rectangle (2.5,2.7); \node[white] at (2.0,2.05) {$\pi$};
      \draw[decorate, decoration={brace, amplitude=3pt}] (2.6,2.7) -- (2.6,2.3) node[midway, right=3pt] {$VAN_A<0$};
      \draw[dotted] (1.2,2.3) -- (2.6,2.3);
      \node[below, align=center] at (0.7,0) {obtiene\\ $V_B+S$}; \node[below, align=center] at (2.0,0) {paga\\ $P$};
      \node at (1.35,-1.25) {$\pi>S$};
    \end{scope}
    \draw (0,0) -- (6.9,0);
  \end{scope}
\end{tikzpicture}
