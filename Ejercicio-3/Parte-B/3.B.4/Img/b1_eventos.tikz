% Figura (bloque 1, «Reparto: ¿quién gana con la operación?»), a partir de ANDRADE, MITCHELL y STAFFORD (2001):
% rentabilidad anormal acumulada en torno al anuncio de la operación (día 0). La empresa comprada, B, sube algo antes del
% anuncio y salta al anunciarse, porque recibe la prima; el comprador, A, apenas se mueve o cae algo; las dos juntas
% ganan poco, pero ganan. Curvas ilustrativas.
% Generar con: bash Code/generar_figura.sh b1_eventos
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=0.55cm, y=1cm]
  % ejes
  \draw[->] (-10.6,0) -- (10.6,0);
  \draw[->] (-10.6,-0.6) -- (-10.6,3.0) node[above right] {rentabilidad anormal acumulada};
  \node[left] at (-10.6,0) {$0$};
  \draw[dotted, thick] (0,-0.6) -- (0,2.85);
  \foreach \d/\t in {-10/{-t}, 0/{0}, 10/{t}} {
    \draw (\d,0.06) -- (\d,-0.06);
  }
  \node[below] at (-10,-0.6) {$-t$};
  \node[below] at (0,-0.6) {$0$};
  \node[below] at (10,-0.6) {$t$};
  \node at (0,-1.35) {días respecto del anuncio};
  % B, la empresa comprada
  \draw[very thick, teal!70!black] plot[smooth, tension=0.55] coordinates
    {(-10,0) (-6,0.08) (-3,0.25) (-1,0.55) (0,1.55) (1,2.42) (3,2.55) (6,2.6) (10,2.62)};
  % A y B juntas
  \draw[very thick, black!60] plot[smooth, tension=0.55] coordinates
    {(-10,0) (-3,0.03) (-1,0.08) (0,0.25) (1,0.4) (5,0.43) (10,0.43)};
  % A, el comprador
  \draw[very thick, black!35] plot[smooth, tension=0.55] coordinates
    {(-10,0) (-3,0.0) (-1,-0.02) (0,-0.1) (1,-0.17) (5,-0.2) (10,-0.21)};
  % rótulos
  \node[right, teal!70!black] at (10.2,2.62) {B (comprada)};
  \node[right, black!70] at (10.2,0.47) {A y B juntas};
  \node[right, black!55] at (10.2,-0.25) {A (compradora)};
\end{tikzpicture}
