% Figura (bloque 1, «Arrogancia: ¿por qué se paga de más sin pretenderlo?»), a partir de ROLL (1986). (a) Cinco compradores
% estiman la misma sinergia con un error de media nula, Ŝ_i = S + ε_i, con ε_i normal de desviación típica σ: compra el que
% más la estima, cuya estimación es la mayor, Ŝ_(1). (b) Sobrestimación esperada del ganador, E[Ŝ_(1) − S] = c_n σ, donde
% c_n es la media del máximo de n normales tipificadas: 0; 0,56; 0,85; 1,03; 1,16; 1,27; 1,35; 1,42; 1,49; 1,54 para
% n = 1, …, 10.
% Generar con: bash Code/generar_figura.sh b1_arrogancia
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]},
    nota/.style={font=\scriptsize, align=center, inner sep=1pt}]
  % (a) Las estimaciones y la del ganador
  \begin{scope}[x=0.8cm, y=5cm]
    \node[font=\footnotesize\bfseries] at (0,0.7) {(a) Cinco estimaciones de la misma sinergia};
    \fill[black!7] plot[domain=-3:3, samples=100] (\x,{exp(-\x*\x/2)/sqrt(2*pi)}) -- cycle;
    \draw[thick, black!60] plot[domain=-3:3, samples=100] (\x,{exp(-\x*\x/2)/sqrt(2*pi)});
    \draw[->] (-3.3,0) -- (3.6,0) node[below left] {$\hat S_i$};
    \draw[dashed] (0,0) -- (0,0.45) node[above] {$S$};
    \foreach \e in {-1.2,-0.45,0.15,0.6} \fill (\e,0) circle (1.8pt);
    \fill[teal!70!black] (1.25,0) circle (2.4pt);
    \node[nota, teal!70!black, above] at (1.25,0.025) {compra:\\ $\hat S_{(1)}$};
    \draw[decorate, decoration={brace, amplitude=3pt, mirror}] (0,-0.03) -- (1.25,-0.03)
      node[midway, below=3pt, nota] {sobrestimación\\ del ganador};
  \end{scope}
  % (b) La sobrestimación esperada según el número de compradores
  \begin{scope}[xshift=4.6cm, x=0.5cm, y=1.5cm]
    \node[font=\footnotesize\bfseries] at (5.5,2.33) {(b) Más compradores, más sobrestimación};
    \draw[->] (0,0) -- (11,0);
    \node[below] at (5.5,-0.3) {número de compradores, $n$};
    \draw[->] (0,0) -- (0,1.85) node[above] {$E[\hat S_{(1)}-S]$};
    \foreach \y/\t in {0.5/{0{,}5\sigma}, 1/{\sigma}, 1.5/{1{,}5\sigma}}
      \draw (0.1,\y) -- (-0.1,\y) node[left] {$\t$};
    \foreach \n in {1,5,10}
      \draw (\n,0.05) -- (\n,-0.05) node[below] {$\n$};
    \draw[thick, teal!70!black] plot coordinates {(1,0) (2,0.564) (3,0.846) (4,1.029) (5,1.163) (6,1.267) (7,1.352)
      (8,1.424) (9,1.485) (10,1.539)};
    \foreach \n/\c in {1/0, 2/0.564, 3/0.846, 4/1.029, 5/1.163, 6/1.267, 7/1.352, 8/1.424, 9/1.485, 10/1.539}
      \fill[teal!70!black] (\n,\c) circle (1.6pt);
  \end{scope}
\end{tikzpicture}
