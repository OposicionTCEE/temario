% Figura (bloque 2, «Suma de partes: ¿vale el conglomerado lo que sus divisiones?»). Suma de partes: el valor de las acciones
% es la suma del valor de cada división, menos el valor actual de los costes centrales y la deuda neta,
% E_SP = V_1 + V_2 + V_3 - V_CC - D; si el mercado valora las acciones en E < E_SP, la diferencia es el descuento del
% conglomerado. El límite inferior de la suma de partes (matriz y filial, 3Com y Palm) está en la figura del anexo de
% valoración, anx_val_palm. Esquema ilustrativo.
% Generar con: bash Code/generar_figura.sh b2_partes
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, y=0.75cm,
    barra/.style={draw, black!70},
    llave/.style={decorate, decoration={brace, amplitude=3pt}}]
  \draw (-0.1,0) -- (7.4,0);
  \fill[teal!45] (0.1,0) rectangle (0.8,2.0);       \draw[barra] (0.1,0) rectangle (0.8,2.0);
  \fill[teal!45] (1.1,2.0) rectangle (1.8,3.6);     \draw[barra] (1.1,2.0) rectangle (1.8,3.6);
  \fill[teal!45] (2.1,3.6) rectangle (2.8,5.6);     \draw[barra] (2.1,3.6) rectangle (2.8,5.6);
  \fill[black!25] (3.1,5.6) rectangle (3.8,4.8);    \draw[barra] (3.1,5.6) rectangle (3.8,4.8);
  \fill[black!25] (4.1,4.8) rectangle (4.8,3.0);    \draw[barra] (4.1,4.8) rectangle (4.8,3.0);
  \fill[teal!70!black] (5.1,0) rectangle (5.8,3.0); \draw[barra] (5.1,0) rectangle (5.8,3.0);
  \fill[black!55] (6.4,0) rectangle (7.1,2.3);      \draw[barra] (6.4,0) rectangle (7.1,2.3);
  \foreach \a/\b/\y in {0.8/1.1/2.0, 1.8/2.1/3.6, 2.8/3.1/5.6, 3.8/4.1/4.8, 4.8/5.1/3.0} \draw[dotted] (\a,\y) -- (\b,\y);
  \draw[dotted] (5.8,3.0) -- (7.25,3.0);
  \draw[llave] (7.25,3.0) -- (7.25,2.3) node[midway, right=3pt] {descuento};
  \foreach \x/\l in {0.45/{V_1}, 1.45/{V_2}, 2.45/{V_3}, 3.45/{-V_{CC}}, 4.45/{-D}, 5.45/{E_{SP}}, 6.75/{E}}
    \node[below] at (\x,0) {$\l$};
\end{tikzpicture}
