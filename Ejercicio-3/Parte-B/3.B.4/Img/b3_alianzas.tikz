% Figura (bloque 3, «Cuándo: ¿qué ahorra no comprar?»), a partir de GROSSMAN y HART (1986) y HART y MOORE (1990).
% Ejes: importancia de lo que aporta cada socio y que ningún contrato puede especificar (conocimientos, esfuerzo,
% relaciones). Si ninguna aportación es decisiva basta un contrato; si lo es sobre todo la de uno, conviene que ese
% compre al otro, porque la propiedad le da los incentivos; si lo son las dos (y los activos de cada uno valen también
% por separado), la alianza conserva los incentivos de ambos. Fronteras ilustrativas.
% Generar con: bash Code/generar_figura.sh b3_alianzas
\begin{tikzpicture}[font=\footnotesize, x=6.4cm, y=4.6cm,
    eje/.style={->, >={Stealth[length=4pt]}}]
  \fill[black!6] (0,0) rectangle (0.34,0.35);
  \fill[black!18] (0.34,0) -- (1,0) -- (1,0.8) -- (0.55,0.35) -- (0.34,0.35) -- cycle;
  \fill[black!18] (0,0.35) -- (0,1) -- (0.8,1) -- (0.34,0.54) -- (0.34,0.35) -- cycle;
  \fill[teal!30] (0.34,0.35) -- (0.34,0.54) -- (0.8,1) -- (1,1) -- (1,0.8) -- (0.55,0.35) -- cycle;
  \draw (0.34,0) -- (0.34,0.54) -- (0.8,1);
  \draw (0,0.35) -- (0.55,0.35) -- (1,0.8);
  \draw (0,0) rectangle (1,1);
  \node at (0.17,0.175) {contrato};
  \node at (0.74,0.16) {A compra a B};
  \node at (0.17,0.78) {B compra a A};
  \node at (0.73,0.7) {alianza};
  \draw[eje] (0,-0.09) -- (1,-0.09) node[midway, below] {importancia de lo que aporta A};
  \draw[eje] (-0.06,0) -- (-0.06,1) node[midway, above, rotate=90] {importancia de lo que aporta B};
\end{tikzpicture}
