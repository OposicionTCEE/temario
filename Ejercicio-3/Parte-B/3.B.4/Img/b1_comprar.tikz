% Figura (bloque 1, «Comprar: ¿por qué adquirir lo que podría construirse?»): la capacidad de A en el tiempo si construye
% (gris, como en la figura del crecimiento interno: alcanza la capacidad buscada en el plazo T) y si compra B (verde
% azulado): salta de inmediato al pagar el precio P, pero integrar B ocupa a la dirección durante un tiempo, y solo después
% vuelve a crecer por etapas. El límite de la dirección (PENROSE, 1959) no desaparece, sino que se desplaza. Esquema
% ilustrativo.
% Generar con: bash Code/generar_figura.sh b1_comprar
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]},
    nota/.style={font=\scriptsize, align=center, inner sep=1pt}]
  % ejes
  \draw[->] (0,0) -- (9.3,0) node[below left] {tiempo};
  \draw[->] (0,0) -- (0,4.9) node[above right] {capacidad de A};
  \draw[dashed, black!40] (0,3.2) -- (8.6,3.2);
  \node[left, nota] at (0,1.0) {actual};
  \node[left, nota] at (0,3.2) {buscada};
  % construir (referencia)
  \draw[thick, black!35] (0,1.0) -- (0.3,1.0) -- (1.4,1.55) -- (2.0,1.55) -- (3.1,2.1) -- (3.7,2.1) -- (4.8,2.65)
    -- (5.4,2.65) -- (6.5,3.2);
  \node[nota, black!60, below right] at (5.0,2.55) {construir};
  \draw[dotted, black!45] (6.5,3.2) -- (6.5,0) node[below, black] {$T$};
  % comprar
  \draw[very thick, teal!70!black] (0,1.0) -- (0.3,1.0) -- (0.3,3.2) -- (2.6,3.2) -- (3.7,3.75) -- (4.3,3.75) -- (5.4,4.3)
    -- (6.6,4.3);
  \node[nota, teal!70!black, right, align=left] at (0.35,2.15) {compra de B:\\ paga $P$};
  \draw[decorate, decoration={brace, amplitude=3pt, mirror}] (0.35,3.12) -- (2.6,3.12)
    node[midway, below=3pt, nota] {integrar B\\ ocupa a la dirección};
  \node[nota, above left] at (3.3,3.6) {vuelve a crecer\\ por etapas};
\end{tikzpicture}
