% Figura (bloque 1, «Diversificación: ¿crea valor reducir el riesgo?»).
% (a) La beta de la empresa unida es la media de las betas ponderada por el valor: con β_A = 0,6, β_B = 1,6 y pesos 0,7 y
% 0,3, β_AB = 0,9, sobre la misma recta r = γ + β λ_M (LEVY y SARNAT, 1970): la rentabilidad exigida es la media y el valor,
% la suma. (b) Coaseguro: el valor de los activos al vencimiento por euro de deuda (F = 1) tiene media 1,6 en los dos
% casos y desviación 0,45 por separado y 0,3 unidas; la probabilidad de impago (área a la izquierda de F) es menor unidas,
% y la deuda vale más a costa de las acciones (GALAI y MASULIS, 1976). Curvas ilustrativas.
% Generar con: bash Code/generar_figura.sh b1_diversificacion
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  % (a) La beta de la empresa unida
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (2.6,5.0) {(a) La beta de la empresa unida};
    \draw[->] (0,0) -- (5.6,0) node[below left, align=right] {beta};
    \draw[->] (0,0) -- (0,4.5) node[above, align=center] {rentabilidad exigida};
    \draw[thick, teal!70!black] (0,1) -- (5.2,4.12) node[above, black] {$r=\gamma+\beta\lambda_M$};
    \foreach \b/\n/\lab in {1.5/A/{\beta_A}, 4.0/B/{\beta_B}, 2.25/AB/{\beta_{AB}}} {
      \pgfmathsetmacro{\r}{1+0.6*\b}
      \draw[dashed, black!55] (\b,0) -- (\b,\r) -- (0,\r);
      \fill (\b,\r) circle (1.6pt);
      \node[below] at (\b,0) {$\lab$};
    }
    \node[above left] at (1.5,1.9) {A};
    \node[above left] at (4.0,3.4) {B};
    \node[above left] at (2.25,2.35) {AB};
    \node[left] at (0,1) {$\gamma$};
    \node[left] at (0,1.9) {$r_A$}; \node[left] at (0,2.35) {$r_{AB}$}; \node[left] at (0,3.4) {$r_B$};
  \end{scope}
  % (b) El coaseguro de la deuda
  \begin{scope}[xshift=7.4cm]
    \node[font=\footnotesize\bfseries] at (3.0,5.0) {(b) El coaseguro de la deuda};
    \begin{axis}[at={(0,0)}, width=6.6cm, height=5.2cm, axis lines=left, xmin=0, xmax=3.2, ymin=0, ymax=1.45,
        xtick={1}, xticklabels={$F$}, ytick=\empty, xlabel={valor de los activos al vencimiento},
        xlabel style={font=\footnotesize}, ticklabel style={font=\footnotesize}, samples=160, clip=false]
      \addplot[domain=0:1, draw=none, fill=black!25] {exp(-(x-1.6)^2/(2*0.45^2))/(0.45*sqrt(2*pi))} \closedcycle;
      \addplot[domain=0:1, draw=none, fill=teal!45] {exp(-(x-1.6)^2/(2*0.3^2))/(0.3*sqrt(2*pi))} \closedcycle;
      \addplot[thick, black!60, domain=0:3.2] {exp(-(x-1.6)^2/(2*0.45^2))/(0.45*sqrt(2*pi))};
      \addplot[thick, teal!70!black, domain=0:3.2] {exp(-(x-1.6)^2/(2*0.3^2))/(0.3*sqrt(2*pi))};
      \draw[dashed] (axis cs:1,0) -- (axis cs:1,1.4);
      \node[font=\footnotesize, black!70] at (axis cs:2.55,0.55) {por separado};
      \node[font=\footnotesize, teal!70!black] at (axis cs:2.15,1.25) {unidas};
      \node[font=\scriptsize] at (axis cs:0.55,0.3) {impago};
    \end{axis}
  \end{scope}
\end{tikzpicture}
