% Figura (anexo de marco institucional, «Fusión: ¿qué exige la ley para unir dos sociedades?»). Pasos de una fusión
% interna según el RDL 5/2023: proyecto común de los administradores (arts. 4, 39 y 40), informes de administradores y,
% en las sociedades anónimas, de expertos independientes sobre el tipo de canje (art. 41), balance de fusión (art. 43),
% acuerdo de las juntas (art. 8), publicación (art. 10), plazo de un mes en que los acreedores disconformes pueden pedir
% garantías (art. 13) e inscripción en el Registro Mercantil, con la que la fusión surte efecto (art. 16).
% Generar con: bash Code/generar_figura.sh anx_mar_fusion
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]},
    paso/.style={draw, rounded corners=2pt, fill=white, align=center, minimum height=1.05cm, text width=2.75cm},
    clave/.style={paso, fill=teal!25},
    flecha/.style={->, thick}]
  \node[paso] (p1) at (0,0) {\textbf{1.} Proyecto común\\ de los administradores};
  \node[paso] (p2) at (3.45,0) {\textbf{2.} Informes de\\ administradores\\ y de expertos};
  \node[paso] (p3) at (6.9,0) {\textbf{3.} Balance\\ de fusión};
  \node[clave] (p4) at (10.35,0) {\textbf{4.} Acuerdo\\ de las juntas};
  \node[paso] (p5) at (10.35,-1.75) {\textbf{5.} Publicación\\ del acuerdo};
  \node[paso] (p6) at (6.9,-1.75) {\textbf{6.} Un mes: garantías\\ a los acreedores\\ disconformes};
  \node[clave] (p7) at (3.45,-1.75) {\textbf{7.} Escritura\\ e inscripción};
  \node[paso, fill=black!8] (p8) at (0,-1.75) {Efectos: sucesión\\ universal y canje};
  \draw[flecha] (p1) -- (p2);
  \draw[flecha] (p2) -- (p3);
  \draw[flecha] (p3) -- (p4);
  \draw[flecha] (p4) -- (p5);
  \draw[flecha] (p5) -- (p6);
  \draw[flecha] (p6) -- (p7);
  \draw[flecha] (p7) -- (p8);
\end{tikzpicture}
