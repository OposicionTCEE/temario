% Figura (anexo de marco institucional, «El registro: ¿qué es el fondo de comercio?»). Método de adquisición (NIIF 3):
% el comprador registra los activos identificables de la empresa comprada y sus pasivos a valor razonable, y la diferencia
% entre lo que paga y ese valor neto es el fondo de comercio (párrafo 32), que recoge el valor de la empresa como negocio
% en marcha que no figuraba en su balance, la sinergia que el comprador espera y lo que haya pagado de más. Si la
% diferencia es negativa, es una compra en condiciones muy ventajosas y se lleva a resultados (párrafo 34). Esquema
% ilustrativo.
% Generar con: bash Code/generar_figura.sh anx_mar_fondo
\begin{tikzpicture}[font=\footnotesize, y=0.75cm,
    llave/.style={decorate, decoration={brace, amplitude=3pt}}]
  % Barra izquierda: lo que tiene B
  \fill[black!25] (0,0) rectangle (1.6,2.4); \draw (0,0) rectangle (1.6,2.4);
  \node[align=center] at (0.8,1.2) {patrimonio\\ neto\\ contable};
  \fill[black!12] (0,2.4) rectangle (1.6,3.4); \draw (0,2.4) rectangle (1.6,3.4);
  \node[align=center, font=\scriptsize] at (0.8,2.9) {ajustes a valor\\ razonable};
  \draw[llave] (-0.15,0) -- (-0.15,3.4) node[midway, left=4pt, align=right] {activos\\ identificables\\ netos};
  % Barra derecha: lo que paga A
  \begin{scope}[xshift=3.2cm]
    \fill[black!18] (0,0) rectangle (1.6,3.4); \draw (0,0) rectangle (1.6,3.4);
    \node[align=center] at (0.8,1.7) {valor\\ razonable\\ neto};
    \fill[teal!20] (0,3.4) rectangle (1.6,4.4); \draw (0,3.4) rectangle (1.6,4.4);
    \node[font=\scriptsize] at (0.8,3.9) {negocio en marcha};
    \fill[teal!40] (0,4.4) rectangle (1.6,5.4); \draw (0,4.4) rectangle (1.6,5.4);
    \node[font=\scriptsize] at (0.8,4.9) {sinergia};
    \fill[teal!65] (0,5.4) rectangle (1.6,5.95); \draw (0,5.4) rectangle (1.6,5.95);
    \node[font=\scriptsize] at (0.8,5.67) {pago de más};
    \draw[llave] (1.75,5.95) -- (1.75,3.4) node[midway, right=4pt, align=left] {fondo de\\ comercio};
    \draw[llave] (2.9,5.95) -- (2.9,0) node[midway, right=4pt] {precio pagado};
  \end{scope}
  \draw[dotted] (1.6,3.4) -- (3.2,3.4);
  \draw (-0.3,0) -- (5.0,0);
  \node[below] at (0.8,0) {B};
  \node[below] at (4.0,0) {lo que paga A};
\end{tikzpicture}
