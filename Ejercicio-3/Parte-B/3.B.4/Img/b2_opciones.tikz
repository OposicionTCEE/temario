% Figura (bloque 2, «Opciones: ¿qué flexibilidad hay en una adquisición?»). (a) Comprar hoy: A paga P y obtiene V_B + S en el
% estado favorable (u) y en el desfavorable (d), de modo que el valor actual neto puede ser negativo en d. (b) Comprar por
% etapas: A paga hoy c por una participación o una empresa conjunta con derecho a comprar el resto y, en T, solo compra si
% la compra crea valor, max{V_B + S - P, 0} (empresa conjunta como opción de compra, KOGUT, 1991). Esquema ilustrativo.
% Generar con: bash Code/generar_figura.sh b2_opciones
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]},
    nodo/.style={circle, draw, fill=black!15, inner sep=1.6pt},
    decision/.style={rectangle, draw, fill=teal!25, inner sep=2.6pt}]
  % (a) Comprar hoy
  \node[font=\footnotesize\bfseries] at (2.3,2.55) {(a) Comprar hoy};
  \node[decision] (a0) at (0,0) {};
  \node[nodo] (au) at (3.0,1.2) {};
  \node[nodo] (ad) at (3.0,-1.2) {};
  \draw[->] (a0) -- node[above, sloped] {$P$} (au);
  \draw[->] (a0) -- (ad);
  \node[right] at (au.east) {$V_B^u+S^u-P>0$};
  \node[right] at (ad.east) {$V_B^d+S^d-P<0$};
  \node[below] at (0,-2.0) {$t=0$}; \node[below] at (3.0,-2.0) {$T$};
  % (b) Comprar por etapas
  \begin{scope}[xshift=8.0cm]
    \node[font=\footnotesize\bfseries] at (3.0,2.55) {(b) Comprar por etapas};
    \node[decision] (b0) at (0,0) {};
    \node[nodo] (bu) at (2.6,1.2) {};
    \node[nodo] (bd) at (2.6,-1.2) {};
    \draw[->] (b0) -- node[above, sloped] {$c$} (bu);
    \draw[->] (b0) -- (bd);
    \node[decision] (cu) at (4.0,1.2) {};
    \node[decision] (cd) at (4.0,-1.2) {};
    \draw[->] (bu) -- (cu); \draw[->] (bd) -- (cd);
    \node[right, align=left] at (cu.east) {compra:\\ $V_B^u+S^u-P$};
    \node[right, align=left] at (cd.east) {no compra:\\ $0$};
    \node[below] at (0,-2.0) {$t=0$}; \node[below] at (3.3,-2.0) {$T$};
  \end{scope}
\end{tikzpicture}
