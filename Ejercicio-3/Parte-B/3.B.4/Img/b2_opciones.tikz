% Figura (bloque 2, «Opciones: ¿qué flexibilidad hay en una adquisición?»). (a) Comprar hoy: A paga P en t = 0 y en T
% obtiene V_B + S, que en el estado desfavorable (d) queda por debajo de lo pagado. (b) Comprar por etapas: A paga hoy c por
% una participación o una empresa conjunta con derecho a comprar el resto y, en T, solo compra si la compra crea valor,
% de modo que obtiene max{V_B + S - P, 0} (empresa conjunta como opción de compra, KOGUT, 1991). Esquema ilustrativo.
% Generar con: bash Code/generar_figura.sh b2_opciones
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]},
    nodo/.style={circle, draw, fill=black!15, inner sep=1.6pt},
    decision/.style={rectangle, draw, fill=teal!25, inner sep=2.6pt}]
  % (a) Comprar hoy
  \node[font=\footnotesize\bfseries] at (2.3,2.2) {(a) Comprar hoy};
  \node[decision] (a0) at (0,0) {};
  \node[below=2pt] at (a0.south) {$-P$};
  \node[nodo] (au) at (3.0,1.1) {};
  \node[nodo] (ad) at (3.0,-1.1) {};
  \draw[->] (a0) -- node[above, sloped] {$u$} (au);
  \draw[->] (a0) -- node[below, sloped] {$d$} (ad);
  \node[right] at (au.east) {$V_B^u+S^u$};
  \node[right] at (ad.east) {$V_B^d+S^d$};
  \node[below] at (0,-1.75) {$t=0$}; \node[below] at (3.0,-1.75) {$T$};
  \node at (2.0,-2.65) {$V_B^d+S^d<P<V_B^u+S^u$};
  % (b) Comprar por etapas
  \begin{scope}[xshift=7.6cm]
    \node[font=\footnotesize\bfseries] at (3.0,2.2) {(b) Comprar por etapas};
    \node[decision] (b0) at (0,0) {};
    \node[below=2pt] at (b0.south) {$-c$};
    \node[nodo] (bu) at (2.6,1.1) {};
    \node[nodo] (bd) at (2.6,-1.1) {};
    \draw[->] (b0) -- node[above, sloped] {$u$} (bu);
    \draw[->] (b0) -- node[below, sloped] {$d$} (bd);
    \node[decision] (cu) at (3.8,1.1) {};
    \node[decision] (cd) at (3.8,-1.1) {};
    \draw[->] (bu) -- (cu); \draw[->] (bd) -- (cd);
    \node[right] at (cu.east) {compra: $V_B^u+S^u-P$};
    \node[right] at (cd.east) {no compra: $0$};
    \node[below] at (0,-1.75) {$t=0$}; \node[below] at (3.2,-1.75) {$T$};
    \node at (2.6,-2.65) {$\max\left\{V_B+S-P,\;0\right\}$};
  \end{scope}
\end{tikzpicture}
