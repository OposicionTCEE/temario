% Figura (bloque 3, «Riesgo: ¿quién soporta el error en la sinergia?»), a partir de BREALEY, MYERS y ALLEN (2020).
% Eje horizontal: sinergia que se obtiene de verdad, S~; la oferta se fijó con la esperada, S. (a) Prima que obtienen
% los accionistas de B: con efectivo es fija, pi; con acciones, pi + x (S~ - S), de pendiente x. (b) Valor actual neto
% de los accionistas de A: con efectivo, S~ - pi, de pendiente 1; con acciones, de pendiente 1 - x. Las dos formas de
% pago valen lo mismo si S~ = S, y la suma de los dos paneles es siempre S~.
% Valores ilustrativos: S = 2,5, pi = 1,2, x = 0,4.
% Generar con: bash Code/generar_figura.sh b3_pago
\begin{tikzpicture}[font=\footnotesize, x=1.15cm, y=0.95cm,
    eje/.style={->, >={Stealth[length=4pt]}},
    efectivo/.style={thick},
    acciones/.style={thick, teal!70!black}]
  % (a) Accionistas de B
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (2.1,3.75) {(a) Accionistas de B};
    \draw[eje] (0,0) -- (4.6,0) node[below left] {$\tilde S$};
    \draw[eje] (0,-0.2) -- (0,3.3) node[left] {$\tilde\pi$};
    \draw[dashed, black!50] (2.5,0) -- (2.5,2.9);
    \node[below] at (2.5,0) {$S$};
    \draw[efectivo] (0,1.2) -- (4.2,1.2) node[right] {efectivo};
    \draw[acciones] (0,0.2) -- (4.2,1.88) node[right] {acciones};
    \node[left] at (0,1.2) {$\pi$};
    \node[text=teal!70!black, font=\scriptsize, rotate=18.3] at (1.2,0.9) {pendiente $x$};
  \end{scope}
  % (b) Accionistas de A
  \begin{scope}[xshift=7.9cm]
    \node[font=\footnotesize\bfseries] at (2.1,3.75) {(b) Accionistas de A};
    \draw[eje] (0,0) -- (4.6,0) node[below left] {$\tilde S$};
    \draw[eje] (0,-1.4) -- (0,3.3) node[left] {$VAN_A$};
    \draw[dashed, black!50] (2.5,-1.3) -- (2.5,2.9);
    \node[below right] at (2.5,0) {$S$};
    \draw[efectivo] (0,-1.2) -- (4.2,3.0) node[right] {efectivo};
    \draw[acciones] (0,-0.2) -- (4.2,2.32) node[right] {acciones};
    \node[left] at (0,-1.2) {$-\pi$};
    \node[font=\scriptsize, rotate=39.6] at (3.2,2.55) {pendiente $1$};
    \node[text=teal!70!black, font=\scriptsize, rotate=26.4] at (3.45,1.6) {pendiente $1-x$};
  \end{scope}
\end{tikzpicture}
