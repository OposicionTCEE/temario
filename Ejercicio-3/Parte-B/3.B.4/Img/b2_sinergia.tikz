% Figura (bloque 2, «Sinergia: flujos propios y riesgo propio»). Flujos de caja adicionales de la unión, Delta FCL_t: los
% costes de integración llegan al principio y con seguridad; los ahorros de costes, antes y más seguros que los aumentos de
% ingresos. Esquema ilustrativo.
% Generar con: bash Code/generar_figura.sh b2_sinergia
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1.0cm, y=1.2cm]
  \draw[->] (0.2,0) -- (7.0,0) node[below left] {años};
  \draw[->] (0.2,-1.25) -- (0.2,2.5) node[right] {$\Delta FCL_t$};
  \foreach \t/\c/\a/\i in {1/-1.0/0.2/0, 2/-0.4/0.6/0.1, 3/0/0.9/0.3, 4/0/1.0/0.5, 5/0/1.0/0.6, 6/0/1.0/0.7} {
    \fill[teal!60!black] (\t-0.3,0) rectangle (\t+0.3,\a);
    \fill[teal!25] (\t-0.3,\a) rectangle (\t+0.3,\a+\i);
    \fill[black!35] (\t-0.3,0) rectangle (\t+0.3,\c);
  }
  \foreach \y/\c/\l in {2.25/teal!60!black/{ahorro de costes}, 1.95/teal!25/{aumento de ingresos}, -0.95/black!35/{costes de integración}} {
    \fill[\c] (2.3,\y-0.08) rectangle (2.55,\y+0.08);
    \node[right, font=\scriptsize] at (2.6,\y) {\l};
  }
\end{tikzpicture}
