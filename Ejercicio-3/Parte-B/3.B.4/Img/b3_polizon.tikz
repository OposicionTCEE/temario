% Figura (bloque 3, «Accionistas dispersos: ¿por qué se llevan casi toda la sinergia?»), a partir de GROSSMAN y HART
% (1980) y SHLEIFER y VISHNY (1986). La barra es la sinergia S de la toma de control y muestra quién se la queda.
% (a) Sin participación previa ni dilución: cada accionista solo vende al valor con la mejora, la prima es toda la
% sinergia y el comprador pierde el coste de la oferta, G_A = -c. (b) Con una participación previa theta comprada antes
% del anuncio y una dilución Phi de quienes no venden: los accionistas de B obtienen pi = (1 - theta)(S - Phi) y el
% comprador theta S + (1 - theta) Phi, menos el coste c. Valores ilustrativos: S = 3, theta = 0,2, Phi = 1.
% Generar con: bash Code/generar_figura.sh b3_polizon
\begin{tikzpicture}[font=\footnotesize, y=0.9cm,
    llave/.style={decorate, decoration={brace, amplitude=3pt}}]
  % (a) Sin participación previa ni dilución
  \node[font=\footnotesize\bfseries] at (2.0,3.7) {(a) Sin participación previa ni dilución};
  \fill[black!55] (1.4,0) rectangle (2.6,3); \draw (1.4,0) rectangle (2.6,3);
  \node[white] at (2.0,1.5) {$\pi$};
  \draw[llave] (1.25,0) -- (1.25,3) node[midway, left=4pt] {$S$};
  \draw[llave] (2.75,3) -- (2.75,0) node[midway, right=4pt] {$\pi=S$};
  \draw (0.5,0) -- (3.5,0);
  \node at (2.0,-0.5) {$G_A=-c$};
  \node at (2.0,-1.15) {$\theta=0,\quad\Phi=0$};
  % (b) Con participación previa y dilución
  \begin{scope}[xshift=7.4cm]
    \node[font=\footnotesize\bfseries] at (2.4,3.7) {(b) Con participación previa y dilución};
    \fill[black!55] (1.4,0) rectangle (2.6,1.6);
    \fill[teal!35] (1.4,1.6) rectangle (2.6,2.4);
    \fill[teal!65] (1.4,2.4) rectangle (2.6,3);
    \draw (1.4,0) rectangle (2.6,3); \draw (1.4,1.6) -- (2.6,1.6); \draw (1.4,2.4) -- (2.6,2.4);
    \node[white] at (2.0,0.8) {$\pi$};
    \node at (2.0,2.0) {$\left(1-\theta\right)\Phi$};
    \node at (2.0,2.7) {$\theta S$};
    \draw[llave] (1.25,0) -- (1.25,3) node[midway, left=4pt] {$S$};
    \draw[llave] (2.75,1.6) -- (2.75,0) node[midway, right=4pt] {$\pi=\left(1-\theta\right)\left(S-\Phi\right)$};
    \draw[llave] (2.75,3) -- (2.75,1.6) node[midway, right=4pt] {$G_A+c$};
    \draw (0.5,0) -- (3.5,0);
    \node at (2.0,-0.5) {$G_A=\theta S+\left(1-\theta\right)\Phi-c$};
    \node at (2.0,-1.15) {$\theta>0,\quad\Phi>0$};
  \end{scope}
\end{tikzpicture}
