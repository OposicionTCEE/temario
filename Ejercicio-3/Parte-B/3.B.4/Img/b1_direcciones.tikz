% Figura (bloque 1, «Fuentes: ¿de dónde sale la sinergia?»): la dirección de la operación respecto de la cadena de valor
% de A y la fuente de sinergia que le corresponde. Horizontal (competidor): escala, alcance y poder de mercado. Vertical
% hacia atrás (proveedor) o hacia adelante (distribuidor): costes de transacción y doble margen. Conglomerado (otro
% sector): mercado interno de capital. Esquema ilustrativo.
% Generar con: bash Code/generar_figura.sh b1_direcciones
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=5pt]},
    caja/.style={draw, thick, rounded corners=2pt, align=center, minimum height=0.95cm, text width=2.3cm},
    op/.style={thick, dashed, teal!70!black},
    fuente/.style={font=\scriptsize\itshape, align=center}]
  % cadena de valor
  \node[caja] (P) at (0,0) {Proveedor};
  \node[caja, fill=black!8] (A) at (5,0) {\textbf{A}};
  \node[caja] (D) at (10,0) {Distribuidor};
  \draw[->, line width=2pt, black!25] (P.east) -- (A.west);
  \draw[->, line width=2pt, black!25] (A.east) -- (D.west);
  \node[font=\scriptsize, black!60] at (5,0.85) {cadena de valor};
  % competidor y otro sector
  \node[caja] (C) at (5,-2.9) {Competidor de A};
  \node[caja] (O) at (10,-2.9) {Empresa de otro sector};
  % operaciones
  \draw[op] (A.south) -- node[left, align=right, text width=2.6cm] {\textbf{horizontal}} (C.north);
  \node[fuente, right] at (5.15,-1.45) {escala y alcance;\\ poder de mercado};
  \draw[op] (A.north west) to[out=150, in=30] node[above, align=center] {\textbf{vertical hacia atrás}} (P.north east);
  \draw[op] (A.north east) to[out=30, in=150] node[above, align=center] {\textbf{vertical hacia adelante}} (D.north west);
  \node[fuente] at (5,2.15) {costes de transacción; doble margen};
  \draw[op] (A.south east) -- node[above, sloped] {\textbf{conglomerado}} (O.north west);
  \node[fuente, below] at (10,-3.45) {mercado interno de capital};
\end{tikzpicture}
