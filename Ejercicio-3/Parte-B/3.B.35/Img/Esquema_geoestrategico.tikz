  \node[txt, text width=7.89cm] (tes3) at ([xshift=8.05cm]fondo) {\textcolor{eGri}{\textbf{$\Rightarrow$ ¿Confirma la tesis?}} \textbf{Sí}: fija las reglas sin EE.\,UU., aunque el comercio que crea es poco};
  \path let \p1=(ue3.south), \p2=(tes3.south), \n1={min(\y1,\y2)} in coordinate (sig) at (0,\n1-0.26cm);
