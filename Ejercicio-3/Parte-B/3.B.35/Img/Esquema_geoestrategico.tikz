      \node[anchor=north west, inner sep=0pt, font=\footnotesize\itshape, text=black!70] (g4nota) at (0,-1.05) {Forma supranacional, fondo ruso};
    \end{scope}
    \node[txt] (val4) at (11.09,-0.88) {\begin{tabular}{@{}l@{\hspace{4pt}}p{4.55cm}@{}}\textcolor{eA4}{$\triangleright$} & \raggedright No crea comercio: cuota del $9$-$13\%$\tabularnewline\noalign{\vskip 1.5pt}\textcolor{eA4}{$\triangleright$} & \raggedright Movilidad laboral avanzada, pero Tayikistán, fuera, recibe más remesas\tabularnewline\noalign{\vskip 1.5pt}\textcolor{eA4}{$\triangleright$} & \raggedright Tras 2022, vía de \textbf{desvío}: UE a Kirguistán $\times 9$\tabularnewline\end{tabular}};
  \end{scope}
  \path let \p1=(obj4.south), \p2=(como4.south), \p3=(g4nota.south), \p4=(val4.south), \n1={min(\y1,\y2,\y3,\y4)} in coordinate (fondo) at (0,\n1-0.2cm);
  \draw[flecha] ([shift={(7.77,-0.15)}]fondo) -- ([shift={(8.01,-0.15)}]fondo);
  \node[txt, text width=7.75cm] (ue4) at ([xshift=0.00cm]fondo) {\textcolor{eGri}{\textbf{Con la UE.}} \textbf{Geopolítica en negativo}: sin relación formal, para no legitimar la esfera rusa; vigila la elusión de sanciones};
  \node[txt, text width=7.89cm] (tes4) at ([xshift=8.05cm]fondo) {\textcolor{eGri}{\textbf{$\Rightarrow$ ¿Confirma la tesis?}} \textbf{Sí} para Rusia, como esfera de influencia; \textbf{no} como mercado: el comercio interno no crece};
  \path let \p1=(ue4.south), \p2=(tes4.south), \n1={min(\y1,\y2)} in coordinate (sig) at (0,\n1-0.26cm);
  \draw[eGri, line width=0.8pt] ([yshift=0.12cm]sig) -- ([shift={(15.94,0.12)}]sig);
  \node[txt, text width=15.94cm] at ([yshift=-0.05cm]sig) {$\Rightarrow$ \textbf{Balance del bloque}: Los acuerdos de seguridad dan cohesión mientras dura la amenaza, y los de influencia atan a los socios con dependencias asimétricas; en ninguno, el comercio entre los miembros es el resultado principal\textcolor{orange}{\textsuperscript{[Probable]}}};
