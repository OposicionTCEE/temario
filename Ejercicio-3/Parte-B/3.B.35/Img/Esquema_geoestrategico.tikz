    \draw[eA4, fill=white, line width=0.8pt] (4.17,-1.00) circle (3.3pt);
    \fill[eA4] (4.17,-1.00) ++(0,2.1pt) arc (90:270:2.1pt) -- cycle;
    \node[anchor=west, inner sep=1.5pt, fill=white] at (4.29,-1.00) {UA};
    \draw[eA4, fill=white, line width=0.8pt] (5.09,-1.00) circle (3.3pt);
    \fill[eA4] (5.09,-1.00) ++(0,2.1pt) arc (90:270:2.1pt) -- cycle;
    \node[anchor=west, inner sep=1.5pt, fill=white] at (5.21,-1.00) {MC};
    \node[txt] (como4) at (3.13,-1.24) {\begin{tabular}{@{}l@{\hspace{4pt}}p{2.87cm}@{}}\textbf{\textcolor{eA4!85!black}{1994}} & \raggedright idea de Nazarbáyev\tabularnewline\noalign{\vskip 1.5pt}\textbf{\textcolor{eA4!85!black}{2010}} & \raggedright unión aduanera\tabularnewline\noalign{\vskip 1.5pt}\textbf{\textcolor{eA4!85!black}{2015}} & \raggedright Unión Económica\tabularnewline\end{tabular}};
    \begin{scope}[shift={(6.96,-0.88)}]
      \node[gob=intergub] (g4sup) at (1.10,-0.17) {Consejo Supremo};
      \node[gob=supra] (g4com) at (3.05,-0.17) {Comisión};
      \node[gob=judicial, dashed] (g4tri) at (0.85,-0.79) {Tribunal};
      \node[gob=financiero] (g4ban) at (2.75,-0.79) {Banco};
