    \node[txt, text width=2.85cm] (obj4) at (0.00,-0.88) {Instrumento de \textbf{Rusia} ($80\%$ del PIB) para reconstruir su esfera postsoviética};
    \draw[black!25, line width=0.5pt] (3.25,-1.00) -- (5.09,-1.00);
    \draw[eA4, fill=white, line width=0.8pt] (3.25,-1.00) circle (3.3pt);
