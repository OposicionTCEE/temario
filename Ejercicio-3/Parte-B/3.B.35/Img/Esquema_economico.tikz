  \node[rot] at (9.80,-0.2) {Medios: dos estrategias};
  \node[txt, text width=3.60cm] (tesis) at (0,-0.6) {Los cuatro procesos nacen para \textbf{ampliar el mercado} de sus miembros y obtener ganancias económicas: eficiencia, escala o credibilidad. La misma finalidad se persigue con \textbf{dos estrategias opuestas}};
  \node[txt, text width=5.60cm] (just) at (3.90,-0.6) {\textbf{Estáticas}: creación de comercio $>$ desviación (VINER, 1950)\\\textbf{Dinámicas}: escala, competencia, inversión\\\textbf{Vecinos} = socios naturales $\Rightarrow$ poca desviación (WONNACOTT y LUTZ, 1989; KRUGMAN, 1991)\\\textbf{Credibilidad}: un tratado ata las reformas (FERNÁNDEZ y PORTES, 1998)};
  \node[txt, text width=6.14cm] (medA) at (9.80,-0.6) {\hangindent=0.45cm\hangafter=0\llap{\colorbox{eGri}{\textcolor{white}{\textbf{A}}}\hspace{0.12cm}}\textbf{Regionalismo cerrado} (CEPAL): industrializar tras un AEC, a menor coste que cada país solo (COOPER y MASSELL, 1965) $\to$ MCCA, CAN};
  \node[txt, text width=6.14cm] (medB) at ([yshift=-0.12cm]medA.south west) {\hangindent=0.45cm\hangafter=0\llap{\colorbox{eGri}{\textcolor{white}{\textbf{B}}}\hspace{0.12cm}}\textbf{Sin cesión de soberanía}: libre comercio sin AEC ni órganos supranacionales, para entrar en un mercado grande; precio: reglas de origen $\to$ EFTA, NAFTA};
  \path let \p1=(tesis.south), \p2=(just.south), \p3=(medB.south), \n1={min(\y1,\y2,\y3)} in coordinate (sig) at (0,\n1-0.35cm);
