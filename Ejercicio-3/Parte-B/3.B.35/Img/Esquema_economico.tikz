    \node[txt, text width=3.15cm] (obj3) at (0.00,-0.95) {México: \textbf{anclar sus reformas} y atraer IED; EE.\,UU.: integración profunda (inversión, propiedad intelectual, servicios); Canadá: defender lo ganado en 1988};
    \draw[black!25, line width=0.5pt] (3.57,-1.07) -- (5.41,-1.07);
    \draw[eA3, fill=white, line width=0.8pt] (3.57,-1.07) circle (3.3pt);
    \fill[eA3] (3.57,-1.07) circle (2.1pt);
    \node[anchor=west, inner sep=1.5pt, fill=white] at (3.69,-1.07) {ZLC};
    \fill[black!25] (4.49,-1.07) circle (1.3pt);
    \node[anchor=west, inner sep=1.5pt, text=black!40, fill=white] at (4.59,-1.07) {UA};
    \fill[black!25] (5.41,-1.07) circle (1.3pt);
    \node[anchor=west, inner sep=1.5pt, text=black!40, fill=white] at (5.51,-1.07) {MC};
    \node[txt] (como3) at (3.45,-1.32) {\begin{tabular}{@{}l@{\hspace{4pt}}p{2.55cm}@{}}\textbf{\textcolor{eA3!85!black}{1989}} & \raggedright acuerdo Canadá-EE.\,UU.\tabularnewline\noalign{\vskip 1.5pt}\textbf{\textcolor{eA3!85!black}{1994}} & \raggedright NAFTA\tabularnewline\noalign{\vskip 1.5pt}\textbf{\textcolor{eA3!85!black}{2020}} & \raggedright USMCA: origen del automóvil, cláusula China\tabularnewline\noalign{\vskip 1.5pt}\textbf{\textcolor{eA3!85!black}{2026}} & \raggedright EE.\,UU. no prorroga\tabularnewline\end{tabular}};
    \begin{scope}[shift={(7.05,-0.95)}]
      \node[gob=intergub] (g3com) at (1.85,-0.17) {Comisión de Libre Comercio};
      \node[gob=tecnico] (g3sec) at (0.95,-0.92) {Secretariado};
      \node[gob=tecnico] (g3cmt) at (2.75,-0.92) {Comités};
      \node[gob=judicial] (g3pan) at (0.95,-1.67) {Paneles};
      \node[gob=judicial] (g3lab) at (2.75,-1.67) {Mec. laboral};
      \draw[gflecha] (g3sec) -- (g3com);
      \draw[gflecha] (g3com) -- (g3cmt);
      \node[anchor=north west, text width=3.65cm, align=left, inner sep=0pt, font=\footnotesize\itshape, text=black!70] (g3nota) at (0,-2.00) {Ministros; sin AEC ni órganos supranacionales: la credibilidad está en los paneles};
    \end{scope}
    \node[txt] (val3) at (11.05,-0.95) {\begin{tabular}{@{}l@{\hspace{4pt}}p{4.59cm}@{}}\textcolor{eA3}{$\triangleright$} & \raggedright Cuota intrarregional: $41\%$ (1989) $\to$ $56\%$ (2002-2004) $\to$ $51\%$ (2023): socios naturales; China la frenó\tabularnewline\noalign{\vskip 1.5pt}\textcolor{eA3}{$\triangleright$} & \raggedright \textbf{Radios} en torno a EE.\,UU.: compra el $80\%$ de lo que vende México; cadena del automóvil\tabularnewline\noalign{\vskip 1.5pt}\textcolor{eA3}{$\triangleright$} & \raggedright Bienestar pequeño (CALIENDO y PARRO, 2015); perdedores locales (HAKOBYAN y McLAREN, 2016)\tabularnewline\noalign{\vskip 1.5pt}\textcolor{eA3}{$\triangleright$} & \raggedright México \textbf{no converge}: del $40\%$ al $29\%$ del PIB per cápita de EE.\,UU. (1993-2024)\tabularnewline\end{tabular}};
  \end{scope}
  \path let \p1=(obj3.south), \p2=(como3.south), \p3=(g3nota.south), \p4=(val3.south), \n1={min(\y1,\y2,\y3,\y4)} in coordinate (fondo) at (0,\n1-0.22cm);
  \node[rot] at ([xshift=0.00cm]fondo) {Relación con la UE};
  \node[rot] at ([xshift=8.05cm]fondo) {$\Rightarrow$ ¿Confirma la tesis?};
  \draw[flecha] ([shift={(7.77,-0.12)}]fondo) -- ([shift={(8.01,-0.12)}]fondo);
  \node[txt, text width=7.75cm] (ue3) at ([shift={(0.00,-0.37)}]fondo) {\textbf{Económica}: los tres pesan el $19\%$ del comercio de la UE, más que la UE para ellos ($14\%$); acuerdos con México (2026) y Canadá (CETA, 2017); desde 2025, diversificar frente a EE.\,UU.};
  \node[txt, text width=7.89cm] (tes3) at ([shift={(8.05,-0.37)}]fondo) {\textbf{Sí} en comercio y cadenas de valor; \textbf{no} en convergencia. Desde 2025, la lógica es también geoestratégica};
  \path let \p1=(ue3.south), \p2=(tes3.south), \n1={min(\y1,\y2)} in coordinate (sig) at (0,\n1-0.42cm);
  \draw[eGri, line width=0.8pt] ([yshift=0.12cm]sig) -- ([shift={(15.94,0.12)}]sig);
  \node[txt, text width=15.94cm] at ([yshift=-0.05cm]sig) {$\Rightarrow$ \textbf{Balance del bloque}: Hay comercio cuando los socios son complementarios o se anclan a un mercado grande (UE, EE.\,UU.), no cuando venden lo mismo; y ningún acuerdo reparte por sí solo las ganancias\textcolor{orange}{\textsuperscript{[Probable]}}};
\end{tikzpicture}%
