  \node[txt, text width=3.00cm] (tesis) at (0,-0.6) {Los cuatro nacen para \textbf{ampliar el mercado} y ganar eficiencia, escala o credibilidad, con \textbf{dos estrategias opuestas}};
  \node[txt, text width=6.40cm] (just) at (3.30,-0.6) {\textbf{Estáticas}: creación $>$ desviación (VINER, 1950)\\\textbf{Dinámicas}: escala, competencia, inversión\\\textbf{Vecinos} = socios naturales $\Rightarrow$ poca desviación (WONNACOTT y LUTZ, 1989; KRUGMAN, 1991)\\\textbf{Credibilidad}: un tratado ata las reformas (FERNÁNDEZ y PORTES, 1998)};
  \node[txt, text width=5.49cm] (medA) at (10.45,-0.6) {\textbf{Regionalismo cerrado} (CEPAL): industrializar tras un AEC a menor coste (COOPER y MASSELL, 1965) $\to$ MCCA, CAN};
