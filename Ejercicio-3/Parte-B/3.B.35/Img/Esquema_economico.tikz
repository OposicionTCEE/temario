    \node[txt] (como3) at (3.30,-1.32) {\begin{tabular}{@{}l@{\hspace{4pt}}p{2.75cm}@{}}\textbf{\textcolor{eA3!85!black}{1989}} & \raggedright Canadá-EE.\,UU.\tabularnewline\noalign{\vskip 1.5pt}\textbf{\textcolor{eA3!85!black}{1994}} & \raggedright NAFTA\tabularnewline\noalign{\vskip 1.5pt}\textbf{\textcolor{eA3!85!black}{2020}} & \raggedright USMCA: automóvil, China\tabularnewline\noalign{\vskip 1.5pt}\textbf{\textcolor{eA3!85!black}{2026}} & \raggedright EE.\,UU. no prorroga\tabularnewline\end{tabular}};
    \begin{scope}[shift={(7.10,-0.95)}]
      \node[gob=intergub] (g3com) at (1.80,-0.17) {Comisión de Libre Comercio};
      \node[gob=tecnico] (g3sec) at (0.90,-0.77) {Secretariado};
      \node[gob=tecnico] (g3cmt) at (2.70,-0.77) {Comités};
      \node[gob=judicial] (g3pan) at (0.90,-1.37) {Paneles};
      \node[gob=judicial] (g3lab) at (2.70,-1.37) {Mec. laboral};
      \draw[gflecha] (g3sec) -- (g3com);
      \draw[gflecha] (g3com) -- (g3cmt);
      \node[anchor=north west, text width=3.55cm, align=left, inner sep=0pt, font=\footnotesize\itshape, text=black!70] (g3nota) at (0,-1.62) {Sin órganos supranacionales: la credibilidad está en los paneles};
    \end{scope}
    \node[txt] (val3) at (11.00,-0.95) {\begin{tabular}{@{}l@{\hspace{4pt}}p{4.64cm}@{}}\textcolor{eA3}{$\triangleright$} & \raggedright Cuota: $41\%$ (1989) $\to$ $56\%$ (2002-2004) $\to$ $51\%$ (2023); \textbf{radios} en torno a EE.\,UU.\tabularnewline\noalign{\vskip 1.5pt}\textcolor{eA3}{$\triangleright$} & \raggedright Cadena del automóvil; bienestar pequeño (CALIENDO y PARRO, 2015)\tabularnewline\noalign{\vskip 1.5pt}\textcolor{eA3}{$\triangleright$} & \raggedright México \textbf{no converge}: del $40\%$ al $29\%$ del PIB per cápita de EE.\,UU.\tabularnewline\end{tabular}};
  \end{scope}
  \path let \p1=(obj3.south), \p2=(como3.south), \p3=(g3nota.south), \p4=(val3.south), \n1={min(\y1,\y2,\y3,\y4)} in coordinate (fondo) at (0,\n1-0.2cm);
  \draw[flecha] ([shift={(7.77,-0.15)}]fondo) -- ([shift={(8.01,-0.15)}]fondo);
  \node[txt, text width=7.75cm] (ue3) at ([xshift=0.00cm]fondo) {\textcolor{eGri}{\textbf{Relación con la UE.}} \textbf{Económica}: pesan el $19\%$ del comercio de la UE, más que la UE para ellos; desde 2025, diversificar frente a EE.\,UU.};
  \node[txt, text width=7.89cm] (tes3) at ([xshift=8.05cm]fondo) {\textcolor{eGri}{\textbf{$\Rightarrow$ ¿Confirma la tesis?}} \textbf{Sí} en comercio y cadenas de valor; \textbf{no} en convergencia. Desde 2025, también geoestratégico};
  \path let \p1=(ue3.south), \p2=(tes3.south), \n1={min(\y1,\y2)} in coordinate (sig) at (0,\n1-0.38cm);
  \draw[eGri, line width=0.8pt] ([yshift=0.12cm]sig) -- ([shift={(15.94,0.12)}]sig);
  \node[txt, text width=15.94cm] at ([yshift=-0.05cm]sig) {$\Rightarrow$ \textbf{Balance del bloque}: Hay comercio cuando los socios son complementarios o se anclan a un mercado grande (UE, EE.\,UU.), no cuando venden lo mismo; y ningún acuerdo reparte por sí solo las ganancias\textcolor{orange}{\textsuperscript{[Probable]}}};
\end{tikzpicture}%
