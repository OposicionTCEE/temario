  \node[txt, text width=3.30cm] (tesis) at (0,-0.6) {Los cuatro nacen para \textbf{ampliar el mercado} y ganar eficiencia, escala o credibilidad, con \textbf{dos estrategias opuestas}};
  \node[txt, text width=6.00cm] (just) at (3.60,-0.6) {\textbf{Estáticas}: creación $>$ desviación de comercio (VINER, 1950)\\\textbf{Dinámicas}: escala, competencia, inversión\\\textbf{Vecinos} = socios naturales $\Rightarrow$ poca desviación (WONNACOTT y LUTZ, 1989; KRUGMAN, 1991)\\\textbf{Credibilidad}: un tratado ata las reformas (FERNÁNDEZ y PORTES, 1998)};
  \node[txt, text width=6.04cm] (medA) at (9.90,-0.6) {\hangindent=0.45cm\hangafter=0\llap{\colorbox{eGri}{\textcolor{white}{\textbf{A}}}\hspace{0.12cm}}\textbf{Regionalismo cerrado} (CEPAL): industrializar tras un AEC, a menor coste que cada país solo (COOPER y MASSELL, 1965) $\to$ MCCA, CAN};
  \node[txt, text width=6.04cm] (medB) at ([yshift=-0.12cm]medA.south west) {\hangindent=0.45cm\hangafter=0\llap{\colorbox{eGri}{\textcolor{white}{\textbf{B}}}\hspace{0.12cm}}\textbf{Sin cesión de soberanía}: libre comercio sin AEC ni órganos supranacionales, para entrar en un mercado grande; precio: reglas de origen $\to$ EFTA, NAFTA};
