    \node[txt] (val3) at (11.09,-0.88) {\begin{tabular}{@{}l@{\hspace{4pt}}p{4.55cm}@{}}\textcolor{eA3}{$\triangleright$} & \raggedright Cuota: $41\%$ (1989) $\to$ $56\%$ (2003) $\to$ $51\%$ (2023); \textbf{radios} en torno a EE.\,UU.\tabularnewline\noalign{\vskip 1.5pt}\textcolor{eA3}{$\triangleright$} & \raggedright Cadena del automóvil; bienestar pequeño (CALIENDO y PARRO, 2015)\tabularnewline\noalign{\vskip 1.5pt}\textcolor{eA3}{$\triangleright$} & \raggedright México \textbf{no converge}: del $40\%$ al $29\%$ del PIB per cápita de EE.\,UU.\tabularnewline\end{tabular}};
  \end{scope}
  \path let \p1=(obj3.south), \p2=(como3.south), \p3=(g3nota.south), \p4=(val3.south), \n1={min(\y1,\y2,\y3,\y4)} in coordinate (fondo) at (0,\n1-0.2cm);
  \draw[flecha] ([shift={(7.77,-0.15)}]fondo) -- ([shift={(8.01,-0.15)}]fondo);
  \node[txt, text width=7.75cm] (ue3) at ([xshift=0.00cm]fondo) {\textcolor{eGri}{\textbf{Con la UE.}} \textbf{Económica}: $19\%$ del comercio de la UE, más que la UE para ellos; desde 2025, diversificar frente a EE.\,UU.};
  \node[txt, text width=7.89cm] (tes3) at ([xshift=8.05cm]fondo) {\textcolor{eGri}{\textbf{$\Rightarrow$ ¿Confirma la tesis?}} \textbf{Sí} en comercio y cadenas; \textbf{no} en convergencia. Desde 2025, también geoestratégico};
  \path let \p1=(ue3.south), \p2=(tes3.south), \n1={min(\y1,\y2)} in coordinate (sig) at (0,\n1-0.42cm);
  \draw[eGri, line width=0.8pt] ([yshift=0.12cm]sig) -- ([shift={(15.94,0.12)}]sig);
  \node[txt, text width=15.94cm] at ([yshift=-0.05cm]sig) {$\Rightarrow$ \textbf{Balance del bloque}: Hay comercio cuando los socios son complementarios o se anclan a un mercado grande (UE, EE.\,UU.), no cuando venden lo mismo; y ningún acuerdo reparte por sí solo las ganancias\textcolor{orange}{\textsuperscript{[Probable]}}};
\end{tikzpicture}%
