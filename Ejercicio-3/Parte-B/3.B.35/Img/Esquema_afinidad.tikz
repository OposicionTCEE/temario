    \node[txt] (val3) at (11.09,-0.88) {\begin{tabular}{@{}l@{\hspace{4pt}}p{4.55cm}@{}}\textcolor{eA3}{$\triangleright$} & \raggedright Cuota: $6\%$ (1998) $\to$ $13\%$ $\to$ $10\%$ (2023)\tabularnewline\noalign{\vskip 1.5pt}\textcolor{eA3}{$\triangleright$} & \raggedright Sin combustibles, un tercio va a los socios: el petróleo se vende fuera\tabularnewline\noalign{\vskip 1.5pt}\textcolor{eA3}{$\triangleright$} & \raggedright Cada subregión mira fuera: el Golfo, a Asia; el Magreb, a la UE\tabularnewline\end{tabular}};
  \end{scope}
  \path let \p1=(obj3.south), \p2=(como3.south), \p3=(g3nota.south), \p4=(val3.south), \n1={min(\y1,\y2,\y3,\y4)} in coordinate (fondo) at (0,\n1-0.2cm);
  \draw[flecha] ([shift={(7.77,-0.15)}]fondo) -- ([shift={(8.01,-0.15)}]fondo);
  \node[txt, text width=7.75cm] (ue3) at ([xshift=0.00cm]fondo) {\textcolor{eGri}{\textbf{Con la UE.}} \textbf{Geopolítica}: vecindad (estabilidad, migración, energía), nunca con el bloque; $7{,}5\%$ del comercio de la UE};
  \node[txt, text width=7.89cm] (tes3) at ([xshift=8.05cm]fondo) {\textcolor{eGri}{\textbf{$\Rightarrow$ ¿Confirma la tesis?}} \textbf{Sí} en aranceles; \textbf{no} en comercio: economías demasiado parecidas, que venden petróleo fuera};
  \path let \p1=(ue3.south), \p2=(tes3.south), \n1={min(\y1,\y2)} in coordinate (sig) at (0,\n1-0.42cm);
  \draw[eGri, line width=0.8pt] ([yshift=0.12cm]sig) -- ([shift={(15.94,0.12)}]sig);
  \node[txt, text width=15.94cm] at ([yshift=-0.05cm]sig) {$\Rightarrow$ \textbf{Balance del bloque}: La afinidad basta para firmar y crear instituciones, no para crear comercio: sin complementariedad, el comercio sigue mirando fuera, y el único éxito pleno, el CEFTA, lo es porque su meta era entrar en la UE\textcolor{orange}{\textsuperscript{[Probable]}}};
\end{tikzpicture}%
