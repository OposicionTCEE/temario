% Figura: las proposiciones de MODIGLIANI y MILLER (1958). Bloque 2, apartado «MODIGLIANI y MILLER (1958)».
% (a) Proposición I: el valor V es el mismo con cualquier reparto entre fondos propios (E, oscuro) y deuda (D, claro).
% (b) Proposición II con deuda sin riesgo: r_D = 0,8; r_U = 1,8; r_E = r_U + (r_U - r_D) x, lineal; r_WACC = r_U.
% (c) Con deuda arriesgada: r_D = 0,8 hasta x = 2 y 0,8 + 0,03 (x - 2)^2 después; r_E = r_U + (r_U - r_D(x)) x,
%     cóncava; r_WACC sigue igual a r_U. Escala vertical 0,7 cm por unidad. Curvas ilustrativas.
% Generar con: bash Code/generar_figura.sh mm_paneles
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  % (a) Proposición I.
  \node[font=\footnotesize\bfseries] at (2.0,4.75) {(a) Proposición I};
  \foreach \x/\e/\t in {0.3/3.6/{$0$}, 1.55/2.4/{$\tfrac{1}{2}$}, 2.8/1.2/{$2$}} {
    \fill[black!60] (\x,0) rectangle (\x+0.85,\e);
    \fill[black!12] (\x,\e) rectangle (\x+0.85,3.6);
    \draw (\x,0) rectangle (\x+0.85,3.6); \draw (\x,\e) -- (\x+0.85,\e);
    \node[below] at (\x+0.425,0) {\t};
  }
  \node[white] at (0.725,1.8) {$E$};
  \node[white] at (1.975,1.2) {$E$}; \node at (1.975,3.0) {$D$};
  \node[white] at (3.225,0.6) {$E$}; \node at (3.225,2.4) {$D$};
  \draw[dashed] (0.1,3.6) -- (3.85,3.6) node[right] {$V$};
  \node at (2.0,-0.75) {$D/E$};
  % (b) Proposición II, deuda sin riesgo.
  \begin{scope}[xshift=5.3cm, x=1cm, y=0.7cm]
    \node[font=\footnotesize\bfseries] at (2.2,6.8) {(b) Deuda sin riesgo};
    \draw[->] (0,0) -- (4.7,0) node[below left, yshift=-2pt] {$D/E$};
    \draw[->] (0,0) -- (0,6.3) node[left] {coste};
    \draw[very thick] (0,1.8) -- (4.2,1.8+4.2) node[right] {$r_E$};
    \draw[very thick, dashed] (0,1.8) -- (4.3,1.8) node[above left] {$r_{\text{WACC}}$};
    \draw[very thick] (0,0.8) -- (4.3,0.8) node[right] {$r_D$};
    \node[left] at (0,1.8) {$r_U$};
  \end{scope}
  % (c) Deuda con riesgo.
  \begin{scope}[xshift=10.8cm, x=1cm, y=0.7cm]
    \node[font=\footnotesize\bfseries] at (2.2,6.8) {(c) Deuda con riesgo};
    \draw[->] (0,0) -- (4.7,0) node[below left, yshift=-2pt] {$D/E$};
    \draw[->] (0,0) -- (0,6.3) node[left] {coste};
    \draw[very thick] plot[domain=0:4.3, samples=60] (\x, {1.8+(1.8-(\x<2 ? 0.8 : 0.8+0.03*(\x-2)*(\x-2)))*\x}) node[right] {$r_E$};
    \draw[very thick, dashed] (0,1.8) -- (4.3,1.8) node[above left] {$r_{\text{WACC}}$};
    \draw[very thick] (0,0.8) -- (2,0.8) plot[domain=2:4.3, samples=30] (\x, {0.8+0.03*(\x-2)*(\x-2)}) node[right] {$r_D$};
    \node[left] at (0,1.8) {$r_U$};
  \end{scope}
\end{tikzpicture}
