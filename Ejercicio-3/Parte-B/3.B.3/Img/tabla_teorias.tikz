% Figura: qué predice cada teoría sobre los determinantes del endeudamiento y qué muestran los datos.
% Bloque 2, apartado «La evidencia». Signos predichos y observados según FRANK y GOYAL (2009) y RAJAN y ZINGALES (1995);
% agencia: JENSEN (1986) para la rentabilidad y MYERS (1977) para las oportunidades de crecimiento. «·» = sin
% predicción clara. La columna de datos se resalta con un fondo gris.
% Generar con: bash Code/generar_figura.sh tabla_teorias
\begin{tikzpicture}[font=\footnotesize]
  \matrix (t) [matrix of nodes, nodes in empty cells,
    column 1/.style={nodes={text width=5.4cm, align=left}},
    column 2/.style={nodes={text width=2.2cm, align=center}},
    column 3/.style={nodes={text width=2.2cm, align=center}},
    column 4/.style={nodes={text width=2.2cm, align=center}},
    column 5/.style={nodes={text width=2.2cm, align=center, fill=black!10}},
    row sep=0pt, column sep=0pt, nodes={minimum height=0.62cm, anchor=center}] {
    \textbf{Determinante} & \textbf{Equilibrio estático} & \textbf{Orden jerárquico} & \textbf{Agencia} & \textbf{Datos} \\
    Rentabilidad & $+$ & $-$ & $+$ & $-$ \\
    Tangibilidad de los activos & $+$ & $-$ & $\cdot$ & $+$ \\
    Oportunidades de crecimiento & $-$ & $+$ & $-$ & $-$ \\
    Tamaño & $+$ & $-$ & $\cdot$ & $+$ \\
    Endeudamiento medio del sector & $+$ & $\cdot$ & $\cdot$ & $+$ \\
  };
  \draw[thick] (t-1-1.north west) -- (t-1-5.north east);
  \draw (t-1-1.south west) -- (t-1-5.south east);
  \draw[thick] (t-6-1.south west) -- (t-6-5.south east);
\end{tikzpicture}
