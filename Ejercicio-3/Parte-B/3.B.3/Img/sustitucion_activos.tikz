% Figura: la sustitución de activos (JENSEN y MECKLING, 1976). Bloque 2, apartado «Agencia».
% La empresa L tiene una deuda de nominal F = 2. (a) Proyecto seguro: vale m = 3 en los dos estados; la deuda cobra F
% y las acciones m - F. (b) Proyecto arriesgado de la misma media: vale m - s = 1,4 o m + s = 4,6 con igual
% probabilidad; en el estado malo la deuda cobra 1,4 y las acciones 0; en el bueno, 2 y 2,6. En valor esperado, la
% deuda pasa de 2 a 1,7 y las acciones de 1 a 1,3: el riesgo traslada valor de los acreedores a los accionistas.
% Barras: deuda (claro, abajo) y acciones (oscuro, arriba). Esquema ilustrativo.
% Generar con: bash Code/generar_figura.sh sustitucion_activos
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, y=0.9cm]
  \newcommand{\barra}[3]{% posición x, deuda, acciones
    \fill[black!12] (#1,0) rectangle (#1+0.8,#2); \draw (#1,0) rectangle (#1+0.8,#2);
    \ifdim #3pt>0pt \fill[black!55] (#1,#2) rectangle (#1+0.8,#2+#3); \draw (#1,#2) rectangle (#1+0.8,#2+#3); \fi
  }
  % (a) Proyecto seguro.
  \node[font=\footnotesize\bfseries] at (2.3,5.6) {(a) Proyecto seguro};
  \barra{0.3}{2}{1} \barra{1.5}{2}{1} \barra{3.2}{2}{1}
  \node[below, align=center] at (0.7,0) {estado\\malo}; \node[below, align=center] at (1.9,0) {estado\\bueno};
  \node[below] at (3.6,0) {esperado};
  \draw[dashed] (0,2) -- (4.4,2) node[right] {$F$};
  \draw[dotted] (0,3) -- (4.4,3) node[right] {$m$};
  \node at (3.6,1) {$D$}; \node[white] at (3.6,2.5) {$E$};
  % (b) Proyecto arriesgado, misma media.
  \begin{scope}[xshift=6.6cm]
    \node[font=\footnotesize\bfseries] at (2.3,5.6) {(b) Proyecto arriesgado};
    \barra{0.3}{1.4}{0} \barra{1.5}{2}{2.6} \barra{3.2}{1.7}{1.3}
    \node[below, align=center] at (0.7,0) {estado\\malo}; \node[below, align=center] at (1.9,0) {estado\\bueno};
    \node[below] at (3.6,0) {esperado};
    \draw[dashed] (0,2) -- (4.4,2) node[right] {$F$};
    \draw[dotted] (0,3) -- (4.4,3) node[right] {$m$};
    \node[left] at (0.3,1.4) {$m-s$};
    \node[left] at (1.5,4.6) {$m+s$};
    \node at (3.6,0.85) {$D$}; \node[white] at (3.6,2.35) {$E$};
  \end{scope}
\end{tikzpicture}
