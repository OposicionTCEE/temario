% Figura: qué regularidades de la política de dividendos explica cada teoría. Bloque 3, apartado «Evidencia».
% Regularidades de ALLEN y MICHAELY (2003). Marcas: \checkmark = la explica; \times = no la explica o predice lo
% contrario; · = sin predicción clara. Juicio de elaboración propia a partir del texto del bloque.
% Generar con: bash Code/generar_figura.sh tabla_dividendos
\begin{tikzpicture}[font=\footnotesize]
  \matrix (t) [matrix of nodes, nodes in empty cells,
    column 1/.style={nodes={text width=5.6cm, align=left}},
    column 2/.style={nodes={text width=2.1cm, align=center}},
    column 3/.style={nodes={text width=2.1cm, align=center}},
    column 4/.style={nodes={text width=2.1cm, align=center}},
    column 5/.style={nodes={text width=2.1cm, align=center}},
    row sep=0pt, column sep=0pt, nodes={minimum height=0.62cm, anchor=center}] {
    \textbf{Regularidad} & \textbf{Impuestos} & \textbf{Señal} & \textbf{Agencia} & \textbf{Comportamiento} \\
    Suavizado del dividendo & $\times$ & \checkmark & \checkmark & $\cdot$ \\
    Sustitución por recompras & \checkmark & $\cdot$ & $\cdot$ & \checkmark \\
    Reacción de la cotización, mayor ante recortes & $\times$ & \checkmark & \checkmark & $\cdot$ \\
    Inversores con tipos altos cobran dividendos & $\times$ & $\cdot$ & $\cdot$ & \checkmark \\
    Reparten las empresas grandes y maduras & $\cdot$ & $\times$ & \checkmark & $\cdot$ \\
  };
  \draw[thick] (t-1-1.north west) -- (t-1-5.north east);
  \draw (t-1-1.south west) -- (t-1-5.south east);
  \draw[thick] (t-6-1.south west) -- (t-6-5.south east);
  \node[anchor=north west, font=\footnotesize, align=left] at ([yshift=-3pt]t-6-1.south west)
    {\checkmark: la explica;\quad $\times$: no la explica o predice lo contrario;\quad $\cdot$: sin predicción clara.};
\end{tikzpicture}
