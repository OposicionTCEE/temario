% Figura: MYERS y MAJLUF (1984) y el orden jerárquico. Bloque 2, apartado «Información asimétrica».
% (a) y (b): valor para los antiguos accionistas de la empresa buena si no emite (a_A) y si emite acciones para un
%     proyecto de VAN b, cediendo a los nuevos accionistas la transferencia T. (a) b > T: emitir le compensa;
%     (b) b < T: renuncia al proyecto. Ilustrado con a_A = 2,4; b = 0,8; T = 0,4 en (a) y 1,2 en (b).
% (c) Orden jerárquico: coste de cada tramo de financiación según la cuantía que se necesita (fondos internos, deuda
%     segura, deuda con riesgo, acciones). Esquema ilustrativo.
% Generar con: bash Code/generar_figura.sh mm84_paneles
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  \def\aA{2.4}\def\b{0.8}
  % (a) b > T.
  \node[font=\footnotesize\bfseries] at (1.55,4.3) {(a) $b>T$};
  \fill[black!55] (0.3,0) rectangle (1.2,\aA); \draw (0.3,0) rectangle (1.2,\aA);
  \node[white] at (0.75,1.2) {$a_A$};
  \fill[black!55] (1.9,0) rectangle (2.8,\aA);
  \fill[black!15] (1.9,\aA) rectangle (2.8,\aA+\b);
  \draw (1.9,0) rectangle (2.8,\aA+\b); \draw (1.9,\aA) -- (2.8,\aA);
  \fill[white] (1.9,\aA+\b-0.4) rectangle (2.8,\aA+\b); \draw[dashed] (1.9,\aA+\b-0.4) rectangle (2.8,\aA+\b);
  \node[white] at (2.35,1.2) {$a_A$};
  \draw[decorate, decoration={brace, amplitude=3pt}] (1.82,\aA) -- (1.82,\aA+\b) node[midway, left=3pt] {$b$};
  \draw[decorate, decoration={brace, amplitude=3pt, mirror}] (2.88,\aA+\b-0.4) -- (2.88,\aA+\b) node[midway, right=3pt] {$T$};
  \draw[dotted] (0.1,\aA) -- (3.3,\aA);
  \node[below] at (0.75,0) {no emite}; \node[below] at (2.35,0) {emite};
  % (b) b < T.
  \begin{scope}[xshift=4.2cm]
    \node[font=\footnotesize\bfseries] at (1.55,4.3) {(b) $b<T$};
    \fill[black!55] (0.3,0) rectangle (1.2,\aA); \draw (0.3,0) rectangle (1.2,\aA);
    \node[white] at (0.75,1.2) {$a_A$};
    \fill[black!55] (1.9,0) rectangle (2.8,\aA);
    \fill[black!15] (1.9,\aA) rectangle (2.8,\aA+\b);
    \draw (1.9,0) rectangle (2.8,\aA+\b); \draw (1.9,\aA) -- (2.8,\aA);
    \fill[white] (1.9,\aA+\b-1.2) rectangle (2.8,\aA+\b); \draw[dashed] (1.9,\aA+\b-1.2) rectangle (2.8,\aA+\b);
    \node[white] at (2.35,0.9) {$a_A$};
    \draw[decorate, decoration={brace, amplitude=3pt}] (1.82,\aA) -- (1.82,\aA+\b) node[midway, left=3pt] {$b$};
    \draw[decorate, decoration={brace, amplitude=3pt, mirror}] (2.88,\aA+\b-1.2) -- (2.88,\aA+\b) node[midway, right=3pt] {$T$};
    \draw[dotted] (0.1,\aA) -- (3.3,\aA);
    \node[below] at (0.75,0) {no emite}; \node[below] at (2.35,0) {emite};
  \end{scope}
  % (c) Orden jerárquico.
  \begin{scope}[xshift=9.0cm]
    \node[font=\footnotesize\bfseries] at (3.2,4.3) {(c) Orden jerárquico};
    \draw[->] (0,0) -- (6.6,0) node[below left, yshift=-2pt] {fondos necesarios};
    \draw[->] (0,0) -- (0,3.9) node[left] {coste};
    \draw[very thick] (0,0.6) -- (1.6,0.6) -- (1.6,1.0) -- (3.0,1.0) -- (3.0,1.25) -- (4.5,2.1) -- (4.5,3.0) -- (6.3,3.0);
    \node[above, align=center] at (0.8,0.6) {fondos\\internos};
    \node[above, align=center] at (2.3,1.0) {deuda\\segura};
    \node[above left, align=center] at (4.1,1.9) {deuda\\con riesgo};
    \node[above, align=center] at (5.4,3.0) {acciones};
    \draw (1.6,0.08) -- (1.6,-0.08) node[below] {$W$};
  \end{scope}
\end{tikzpicture}
