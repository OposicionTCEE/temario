% Figura: MILLER y MODIGLIANI (1961). Bloque 3, apartado «MILLER y MODIGLIANI (1961)».
% Riqueza por acción de un accionista de la empresa U (activos V, efectivo C, n acciones, P_0 = (V + C)/n) en tres
% políticas: (a) reparte el efectivo como dividendo C/n y la acción pasa a valer V/n; (b) recompra acciones a P_0 y
% cada acción sigue valiendo P_0; (c) reparte un dividendo d > C/n financiado con acciones nuevas y la acción pasa a
% valer P_0 - d. En los tres casos la riqueza es P_0. Barras: valor de la acción (oscuro) y dividendo (claro).
% Esquema ilustrativo (P_0 = 3, C/n = 0,8, d = 1,6). Generar con: bash Code/generar_figura.sh mm61_paneles
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  \def\P{3.0}
  \foreach \x/\div/\tit in {0/0.8/{(a) Dividendo con el efectivo}, 5.3/0/{(b) Recompra}, 10.6/1.6/{(c) Emisión para pagar más}} {
    \begin{scope}[xshift=\x cm]
      \node[font=\footnotesize\bfseries] at (2.1,4.0) {\tit};
      % Antes.
      \fill[black!55] (0.4,0) rectangle (1.4,\P); \draw (0.4,0) rectangle (1.4,\P);
      \node[below] at (0.9,0) {antes};
      % Después.
      \fill[black!55] (2.6,0) rectangle (3.6,\P-\div); \draw (2.6,0) rectangle (3.6,\P-\div);
      \ifdim \div pt>0pt
        \fill[black!12] (2.6,\P-\div) rectangle (3.6,\P); \draw (2.6,\P-\div) rectangle (3.6,\P);
      \fi
      \node[below] at (3.1,0) {después};
      \draw[dashed] (0.2,\P) -- (4.0,\P);
    \end{scope}
  }
  \node[left] at (0.2,3.0) {$P_0$};
  \node[white] at (0.9,1.5) {$P_0$};
  \node[white] at (3.1,1.1) {$\frac{V}{n}$}; \node at (3.1,2.6) {$\frac{C}{n}$};
  \node[white] at (6.2,1.5) {$P_0$}; \node[white] at (8.4,1.5) {$P_0$};
  \node[white] at (11.5,1.5) {$P_0$};
  \node[white] at (13.7,0.7) {$P_0-d$}; \node at (13.7,2.2) {$d$};
\end{tikzpicture}
