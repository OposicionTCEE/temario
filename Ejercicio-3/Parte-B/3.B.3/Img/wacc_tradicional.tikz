% Figura: la visión tradicional del coste del capital (DURAND, 1952). Bloque 2, apartado «Estructura y coste del capital».
% x = D/E. r_D constante hasta un umbral y creciente después: 0,9 + 0,12 (x - 3)^2 para x > 3.
% r_E = 1,6 + 0,05 x + 0,06 x^2 (crece despacio al principio y deprisa después).
% WACC = (r_E + r_D x) / (1 + x): primero baja (pesa más la deuda, más barata) y luego sube; mínimo en L* (x = 3).
% Curvas ilustrativas. Generar con: bash Code/generar_figura.sh wacc_tradicional
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1.45cm, y=1.15cm]
  \draw[->] (0,0) -- (6.6,0) node[below left, yshift=-2pt] {$D/E$};
  \draw[->] (0,0) -- (0,4.6) node[left] {coste del capital};
  \draw[very thick] plot[domain=0:6, samples=60] (\x, {1.6+0.05*\x+0.06*\x*\x}) node[right] {$r_E$};
  \draw[very thick] (0,0.9) -- (3,0.9) plot[domain=3:6, samples=30] (\x, {0.9+0.12*(\x-3)*(\x-3)}) node[below right] {$r_D$};
  \draw[very thick, dashed] plot[domain=0:6, samples=80] (\x, {(1.6+0.05*\x+0.06*\x*\x + \x*(\x<3 ? 0.9 : 0.9+0.12*(\x-3)*(\x-3)))/(1+\x)}) node[above right] {$r_{\text{WACC}}$};
  \draw[dotted] (3,1.2475) -- (3,0) node[below] {$L^{*}$};
\end{tikzpicture}
