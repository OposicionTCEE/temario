% Figura: por qué las empresas acumulan liquidez (HOLMSTRÖM y TIROLE, 1998). Bloque 2, «Fondos propios».
% Eje: shock de liquidez rho por euro invertido. rho_0: renta que el empresario puede comprometer ante los inversores;
% rho_1: rendimiento total del proyecto (continuar es eficiente si rho <= rho_1); rho*: umbral con liquidez acumulada,
% rho_0 < rho* < rho_1. En gris, los proyectos que valdría la pena continuar y se abandonan.
% (a) Sin liquidez acumulada: continúa solo si rho <= rho_0. (b) Con liquidez acumulada: continúa hasta rho*.
% Esquema ilustrativo. Generar con: bash Code/generar_figura.sh ht_liquidez
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  \def\S{7.6}
  \foreach \i/\titulo/\u in {0/{(a) Sin liquidez acumulada}/2.0, 1/{(b) Con liquidez acumulada}/3.6} {
    \begin{scope}[xshift=\i*\S cm]
      \node[font=\footnotesize\bfseries] at (3.0,2.3) {\titulo};
      \fill[black!15] (\u,0) rectangle (4.8,0.5);
      \draw[->] (0,0) -- (6.4,0) node[below left, yshift=-2pt] {$\rho$};
      \draw (0,0.08) -- (0,-0.08) node[below] {$0$};
      \draw (2.0,0.12) -- (2.0,-0.12) node[below] {$\rho_0$};
      \draw (4.8,0.12) -- (4.8,-0.12) node[below] {$\rho_1$};
      \draw[decorate, decoration={brace, amplitude=4pt}] (0,0.65) -- (2.0,0.65) node[midway, above=4pt, align=center] {se refinancia\\en el mercado};
      \draw[decorate, decoration={brace, amplitude=4pt}] (\u,0.65) -- (6.2,0.65) node[midway, above=4pt] {se abandona};
    \end{scope}
  }
  \begin{scope}[xshift=\S cm]
    \draw (3.6,0.12) -- (3.6,-0.12) node[below] {$\rho^{*}$};
    \draw[decorate, decoration={brace, amplitude=4pt, mirror}] (2.0,-0.55) -- (3.6,-0.55) node[midway, below=4pt, align=center] {la cubre la\\liquidez acumulada};
  \end{scope}
\end{tikzpicture}
