% Figura: la deuda como señal (ROSS, 1977). Bloque 2, «Información oculta».
% Eje horizontal: nominal de la deuda D. Eje vertical: pago del directivo M = gamma_0 V_0 + gamma_1 (V_1 - L si quiebra).
% El mercado valora V_A si D > D* y V_B si D <= D*, con V_B <= D* < V_A. Tipo A (buena, trazo continuo) y tipo B (mala,
% discontinuo). (a) gamma_1 L > gamma_0 (V_A - V_B): al tipo B superar D* le baja el pago, no imita; separación.
% (b) gamma_1 L < gamma_0 (V_A - V_B): al tipo B superar D* le sube el pago, imita y la deuda no informa.
% Valores ilustrativos, sin datos. Generar con: bash Code/generar_figura.sh ross_senal
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  \def\S{7.6}
  \foreach \i/\titulo/\bq/\ai/\bi in {0/{(a) $\gamma_1L>\gamma_0(V_A-V_B)$}/0.5/1.7/1.1, 1/{(b) $\gamma_1L<\gamma_0(V_A-V_B)$}/1.3/2.5/1.9} {
    \begin{scope}[xshift=\i*\S cm]
      \node[font=\footnotesize\bfseries] at (2.9,3.75) {\titulo};
      \draw[->] (0,0) -- (6.0,0) node[below left, yshift=-2pt] {$D$};
      \draw[->] (0,0) -- (0,3.4) node[left, align=right] {pago del\\directivo};
      \foreach \x/\t in {1.8/{V_B}, 2.6/{D^{*}}, 4.4/{V_A}} {
        \draw[densely dotted] (\x,0) node[below] {$\t$} -- (\x,3.1);
      }
      % Tipo A (empresa buena).
      \draw[very thick] (0,2.2) -- (2.6,2.2);
      \draw[very thick] (2.6,2.8) -- (4.4,2.8);
      \draw[very thick] (4.4,\ai) -- (5.6,\ai) node[right] {$A$};
      % Tipo B (empresa mala).
      \draw[very thick, gray, dashed] (0,1.6) -- (1.8,1.6);
      \draw[very thick, gray, dashed] (1.8,\bq) -- (2.6,\bq);
      \draw[very thick, gray, dashed] (2.6,\bi) -- (5.6,\bi) node[right, black] {$B$};
      \fill (3.5,2.8) circle (2pt);
    \end{scope}
  }
  % Elección de la empresa mala: (a) no imita; (b) imita.
  \fill (0.9,1.6) circle (2pt);
  \begin{scope}[xshift=\S cm]
    \draw[thick] (0.9,1.6) circle (2pt);
    \fill (3.5,1.9) circle (2pt);
  \end{scope}
\end{tikzpicture}
