% Figura: las dos diluciones de una ampliación de capital. Bloque 1, apartado «Financiación propia externa».
% (a) Control: los accionistas A y B (participaciones alpha_A y alpha_B) no acuden a una ampliación de tamaño s
%     (fondos nuevos en proporción al capital previo) que suscribe C. Ilustrado con alpha_A = 0,8 y s = 0,25.
% (b) Valor: valor por acción tras emitir m acciones a p_e sobre n acciones de valor v: v' = (n v + m p_e)/(n + m).
%     Si p_e < v pierden los antiguos accionistas; si p_e > v, los nuevos. Esquema ilustrativo.
% Generar con: bash Code/generar_figura.sh dilucion_paneles
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  % (a) Dilución del control.
  \node[font=\footnotesize\bfseries] at (3.0,4.6) {(a) Dilución del control};
  \def\H{3.6}
  % Antes.
  \fill[black!55] (0.5,0) rectangle (2.1,0.8*\H);
  \fill[black!20] (0.5,0.8*\H) rectangle (2.1,\H);
  \draw (0.5,0) rectangle (2.1,\H); \draw (0.5,0.8*\H) -- (2.1,0.8*\H);
  \node[white] at (1.3,0.4*\H) {$\alpha_A$};
  \node at (1.3,0.9*\H) {$\alpha_B$};
  \node[below] at (1.3,0) {antes};
  % Después, sin acudir a la ampliación.
  \fill[black!55] (3.4,0) rectangle (5.0,0.64*\H);
  \fill[black!20] (3.4,0.64*\H) rectangle (5.0,0.8*\H);
  \fill[white] (3.4,0.8*\H) rectangle (5.0,\H);
  \draw (3.4,0) rectangle (5.0,\H); \draw (3.4,0.64*\H) -- (5.0,0.64*\H); \draw (3.4,0.8*\H) -- (5.0,0.8*\H);
  \node[white] at (4.2,0.32*\H) {$\alpha_A/(1+s)$};
  \node at (4.2,0.72*\H) {$\alpha_B/(1+s)$};
  \node at (4.2,0.9*\H) {$s/(1+s)$};
  \node[below] at (4.2,0) {después};
  \node[right] at (5.05,0.9*\H) {C};
  \node[right] at (5.05,0.72*\H) {B};
  \node[right] at (5.05,0.32*\H) {A};
  % (b) Dilución del valor.
  \begin{scope}[xshift=8.0cm]
    \node[font=\footnotesize\bfseries] at (3.1,4.6) {(b) Dilución del valor};
    \draw[->] (0,0) -- (6.3,0) node[below left, yshift=-2pt] {$p_e$};
    \draw[->] (0,0) -- (0,4.1) node[left, align=right] {valor por acción\\tras la emisión};
    \draw[dashed] (0,2.2) -- (6.0,2.2);
    \node[left] at (0,2.2) {$v$};
    \draw[very thick] (0,1.56) -- (6.0,3.31) node[above left] {$v'(p_e)$};
    \draw[dotted] (2.2,2.2) -- (2.2,0) node[below] {$v$};
    \node[align=center] at (1.2,0.75) {pierden los\\antiguos};
    \node[align=center] at (4.6,0.75) {pierden los\\nuevos};
  \end{scope}
\end{tikzpicture}
