% Figura: equilibrio estático. Bloque 2, «Insolvencia».
% (a) V_L = V_U + T_c D - p(D) C, con p(D) C = 0 hasta D = 1,5 y 0,09 (D - 1,5)^2 después; T_c = 0,35; V_U = 1,5.
%     Máximo en D* = 3,44. (b) Condición marginal T_c = p'(D*) C. Curvas ilustrativas.
% Generar con: bash Code/generar_figura.sh tradeoff_equilibrio
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1cm, y=1cm]
  % (a) Valor de la empresa.
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (3.0,4.35) {(a) Valor de la empresa};
    \draw[->] (0,0) -- (6.5,0) node[below left, yshift=-2pt] {$D$};
    \draw[->] (0,0) -- (0,4.0) node[left] {valor};
    \draw[dashed] (0,1.5) -- (6.0,1.5);
    \draw[dashed] (0,1.5) -- (6.0,3.6) node[right] {$V_U+T_cD$};
    \draw[very thick] (0,1.5) -- (1.5,2.025) plot[domain=1.5:6, samples=50] (\x, {1.5+0.35*\x-0.09*(\x-1.5)*(\x-1.5)}) node[right] {$V_L$};
    \node[left] at (0,1.5) {$V_U$};
    \draw[dotted] (3.44,2.365) -- (3.44,0) node[below] {$D^{*}$};
    \draw[decorate, decoration={brace, amplitude=3pt}] (5.05,1.5) -- (5.05,3.2675) node[pos=0.2, left=3pt] {ahorro fiscal};
    \draw[decorate, decoration={brace, amplitude=3pt, mirror}] (5.25,2.072) -- (5.25,3.3375) node[midway, right=3pt, align=left] {costes de\\insolvencia};
  \end{scope}
  % (b) Condición marginal: ahorro fiscal de un euro más, T_c (= 0,35), frente al aumento de los costes esperados,
  %     p'(D) C = 0 hasta D = 1,5 y 0,18 (D - 1,5) después. Escala vertical x6. Se cortan en D* = 3,44.
  \begin{scope}[xshift=8.3cm]
    \node[font=\footnotesize\bfseries] at (2.8,4.35) {(b) Lo que aporta y cuesta un euro más};
    \draw[->] (0,0) -- (5.6,0) node[below left, yshift=-2pt] {$D$};
    \draw[->] (0,0) -- (0,4.0) node[left] {margen};
    \draw[very thick] (0,2.1) -- (5.2,2.1) node[above left] {$T_c$};
    \draw[very thick] (0,0.02) -- (1.5,0.02) -- (4.8,3.564) node[right] {$p'(D)\,C$};
    \draw[dotted] (3.44,2.1) -- (3.44,0) node[below] {$D^{*}$};
  \end{scope}
\end{tikzpicture}
