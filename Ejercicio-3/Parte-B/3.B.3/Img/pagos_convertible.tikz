% Figura: lo que cobra al vencimiento un bono convertible frente a la deuda simple, según el valor de los activos V.
% Nominal F; al convertir, el bonista recibe la fracción gamma de la empresa (valor de conversión gamma V).
% Convertible: max(min(V, F), gamma V); conviene convertir cuando V > F/gamma. Bloque 1, apartado «Financiación
% híbrida». Curvas ilustrativas (gamma = 0,5).
% Generar con: bash Code/generar_figura.sh pagos_convertible
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  \def\F{1.6}
  \fill[black!8] (0,0) rectangle (\F,3.8);
  \draw[->] (0,0) -- (8.6,0) node[below left, yshift=-2pt] {$V$};
  \draw[->] (0,0) -- (0,4.0) node[left] {pago};
  % Deuda simple y valor de conversión.
  \draw[dashed] (\F,\F) -- (8.2,\F);
  \draw[dashed] (0,0) -- (7.6,3.8);
  \node[below right] at (5.0,\F) {deuda simple};
  \node[above left] at (7.2,3.6) {valor de conversión $\gamma V$};
  % Convertible.
  \draw[very thick] (0,0) -- (\F,\F) -- (3.2,\F) -- (7.6,3.8);
  \node[below right, align=left] at (7.65,3.8) {convertible};
  % Marcas.
  \draw[dotted] (3.2,\F) -- (3.2,0) node[below] {$F/\gamma$};
  \node[below] at (\F,0) {$F$};
  \node[left] at (0,\F) {$F$};
  \node at (\F/2,3.45) {impago};
\end{tikzpicture}
