% Figura: el precio de la acción el día en que deja de dar derecho al dividendo. Bloque 3, apartado «Impuestos y
% clientelas». (a) Sin impuestos: el precio cae exactamente en el dividendo d. (b) Con impuestos personales sobre los
% dividendos (T_div) y las plusvalías (T_g): el precio cae d (1 - T_div)/(1 - T_g), menos que d si T_div > T_g
% (ELTON y GRUBER, 1970). Esquema ilustrativo (d = 1,2; caída con impuestos 0,8).
% Generar con: bash Code/generar_figura.sh exdividendo
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  % (a) Sin impuestos.
  \node[font=\footnotesize\bfseries] at (3.0,4.2) {(a) Sin impuestos};
  \draw[->] (0,0) -- (6.4,0) node[below left, yshift=-2pt] {tiempo};
  \draw[->] (0,0) -- (0,3.8) node[left] {precio};
  \draw[very thick] (0.2,3.0) -- (3.0,3.0); \draw[very thick] (3.0,1.8) -- (6.0,1.8);
  \draw[dotted] (3.0,3.0) -- (3.0,0) node[below] {día ex dividendo};
  \draw[decorate, decoration={brace, amplitude=3pt}] (3.15,3.0) -- (3.15,1.8) node[midway, right=3pt] {$d$};
  % (b) Con impuestos.
  \begin{scope}[xshift=8.2cm]
    \node[font=\footnotesize\bfseries] at (3.0,4.2) {(b) Con impuestos, $T_{\text{div}}>T_g$};
    \draw[->] (0,0) -- (6.4,0) node[below left, yshift=-2pt] {tiempo};
    \draw[->] (0,0) -- (0,3.8) node[left] {precio};
    \draw[very thick] (0.2,3.0) -- (3.0,3.0); \draw[very thick] (3.0,2.2) -- (6.0,2.2);
    \draw[dashed] (3.0,1.8) -- (6.0,1.8);
    \draw[dotted] (3.0,3.0) -- (3.0,0) node[below] {día ex dividendo};
    \draw[decorate, decoration={brace, amplitude=3pt}] (3.15,3.0) -- (3.15,2.2) node[midway, right=3pt] {$d\,(1-T_{\text{div}})/(1-T_g)$};
    \draw[decorate, decoration={brace, amplitude=3pt, mirror}] (2.85,3.0) -- (2.85,1.8) node[midway, left=3pt] {$d$};
  \end{scope}
\end{tikzpicture}
