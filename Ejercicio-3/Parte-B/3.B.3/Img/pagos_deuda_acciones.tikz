% Figura: lo que cobran al vencimiento la deuda y los fondos propios según el valor de los activos V (MERTON, 1974).
% (a) Deuda con nominal F: min(V, F). (b) Fondos propios: max(V - F, 0), una opción de compra sobre los activos.
% Bloque 1, apartado «La empresa en términos financieros». Curvas ilustrativas.
% Generar con: bash Code/generar_figura.sh pagos_deuda_acciones
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  \def\F{2.6}\def\xm{6.2}\def\ym{3.9}
  % (a) Deuda.
  \node[font=\footnotesize\bfseries] at (3.1,4.6) {(a) Deuda: una promesa fija};
  \fill[black!8] (0,0) rectangle (\F,\ym);
  \draw[->] (0,0) -- (\xm,0) node[below left, yshift=-2pt] {$V$};
  \draw[->] (0,0) -- (0,\ym+0.2) node[left] {pago};
  \draw[dotted] (0,0) -- (3.8,3.8);
  \draw[dashed] (\F,0) -- (\F,\F) -- (0,\F);
  \draw[very thick] (0,0) -- (\F,\F) -- (\xm-0.2,\F);
  \node[below] at (\F,0) {$F$};
  \node[left] at (0,\F) {$F$};
  \node[align=center] at (\F/2,3.45) {impago};
  \node[align=center] at (\F+1.8,3.45) {solvencia};
  \node[above] at (5.0,\F) {$\min(V,F)$};
  % (b) Fondos propios.
  \begin{scope}[xshift=8.0cm]
    \node[font=\footnotesize\bfseries] at (3.1,4.6) {(b) Fondos propios: el residuo};
    \fill[black!8] (0,0) rectangle (\F,\ym);
    \draw[->] (0,0) -- (\xm,0) node[below left, yshift=-2pt] {$V$};
    \draw[->] (0,0) -- (0,\ym+0.2) node[left] {pago};
    \draw[very thick] (0,0) -- (\F,0) -- (\xm-0.2,\xm-0.2-\F);
    \node[below] at (\F,0) {$F$};
    \node[align=center] at (\F/2,3.45) {impago};
    \node[align=center] at (\F+1.8,3.45) {solvencia};
    \node[above left] at (5.6,2.9) {$\max(V-F,0)$};
  \end{scope}
\end{tikzpicture}
