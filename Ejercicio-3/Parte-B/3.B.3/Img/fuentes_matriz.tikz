% Figura: clasificación de las fuentes de financiación según su origen (interna/externa) y la naturaleza del derecho
% (propia/ajena). Bloque 1, apartado «La empresa en términos financieros». Las dos bandas cruzan la frontera entre
% columnas: la autofinanciación de mantenimiento (amortizaciones y provisiones) y los instrumentos híbridos.
% Generar con: bash Code/generar_figura.sh fuentes_matriz
\begin{tikzpicture}[font=\footnotesize,
  celda/.style={align=center, text width=4.6cm},
  banda/.style={draw, fill=black!12, rounded corners=2pt, align=center, minimum height=0.62cm}]
  \def\x{2.4}\def\cw{5.6}\def\rh{2.3}
  % Rejilla.
  \draw[thick] (\x,0) rectangle (\x+2*\cw,2*\rh);
  \draw (\x+\cw,0) -- (\x+\cw,2*\rh);
  \draw (\x,\rh) -- (\x+2*\cw,\rh);
  % Cabeceras de columna.
  \node[align=center] at (\x+0.5*\cw,2*\rh+0.5) {\textbf{Financiación propia}\\derecho residual};
  \node[align=center] at (\x+1.5*\cw,2*\rh+0.5) {\textbf{Financiación ajena}\\derecho fijo y exigible};
  \node[font=\footnotesize\itshape] at (\x+\cw,2*\rh+1.25) {Naturaleza del derecho};
  % Cabeceras de fila.
  \node[align=center, text width=2.0cm] at (\x-1.05,1.5*\rh) {\textbf{Interna}\\fondos que genera la empresa};
  \node[align=center, text width=2.0cm] at (\x-1.05,0.5*\rh) {\textbf{Externa}\\fondos de inversores};
  \node[font=\footnotesize\itshape, rotate=90] at (\x-2.3,\rh) {Origen de los fondos};
  % Celdas.
  \node[celda] at (\x+0.5*\cw,1.5*\rh+0.45) {Beneficio retenido (reservas):\\autofinanciación de enriquecimiento};
  \node[celda] at (\x+1.5*\cw,1.5*\rh+0.45) {---};
  \node[celda] at (\x+0.5*\cw,0.5*\rh+0.45) {Ampliaciones de capital};
  \node[celda] at (\x+1.5*\cw,0.5*\rh+0.45) {Deuda bancaria $\cdot$ deuda de mercado\\crédito comercial};
  % Bandas que cruzan la frontera.
  \node[banda, text width=6.6cm] at (\x+\cw,\rh+0.55) {Autofinanciación de mantenimiento: amortizaciones y provisiones};
  \node[banda, text width=6.6cm] at (\x+\cw,0.55) {Híbridos: preferentes, convertibles, préstamos participativos};
\end{tikzpicture}
