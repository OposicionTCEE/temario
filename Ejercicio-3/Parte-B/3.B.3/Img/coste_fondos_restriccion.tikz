% Figura: restricciones financieras e inversión (FAZZARI, HUBBARD y PETERSEN, 1988).
% Eje horizontal: inversión I; eje vertical: coste marginal de los fondos. D: rentabilidad marginal de la inversión.
% (a) Sin fricciones: los fondos cuestan r con independencia de su origen; la inversión I* no depende de los fondos
%     internos W. (b) Con prima de financiación externa a partir de W: la inversión I_0 < I* y sube a I_1 si los fondos
%     internos pasan de W a W'. Bloque 1, apartado «Financiación interna». Curvas ilustrativas.
% Generar con: bash Code/generar_figura.sh coste_fondos_restriccion
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  \def\r{1.4}
  % (a) Sin fricciones.
  \node[font=\footnotesize\bfseries] at (3.1,4.5) {(a) Sin fricciones};
  \draw[->] (0,0) -- (6.4,0) node[below left, yshift=-2pt] {$I$};
  \draw[->] (0,0) -- (0,4.1) node[left, align=right] {coste marginal\\de los fondos};
  \draw[very thick] (0,\r) -- (6.1,\r) node[above left] {oferta};
  \draw[thick] (0.5,3.6) -- (5.8,0.6) node[above right] {$D$};
  \draw[dashed] (4.39,\r) -- (4.39,0) node[below] {$I^{*}$};
  \node[left] at (0,\r) {$r$};
  \draw (1.8,0.08) -- (1.8,-0.08) node[below] {$W$};
  \draw (2.6,0.08) -- (2.6,-0.08) node[below] {$W'$};
  % (b) Con prima de financiación externa.
  \begin{scope}[xshift=8.2cm]
    \node[font=\footnotesize\bfseries] at (3.1,4.5) {(b) Con prima de financiación externa};
    \draw[->] (0,0) -- (6.4,0) node[below left, yshift=-2pt] {$I$};
    \draw[->] (0,0) -- (0,4.1) node[left, align=right] {coste marginal\\de los fondos};
    \draw[very thick] (0,\r) -- (1.8,\r) -- (4.0,3.05);
    \draw[very thick, dashed] (1.8,\r) -- (2.6,\r) -- (5.0,3.2);
    \node[above left] at (4.0,3.05) {oferta con $W$};
    \node[above] at (5.0,3.2) {oferta con $W'$};
    \draw[thick] (0.5,3.6) -- (5.8,0.6) node[above right] {$D$};
    \draw[dotted] (0,\r) -- (4.39,\r);
    \draw[dashed] (2.913,2.235) -- (2.913,0) node[below] {$I_0$};
    \draw[dashed] (3.369,1.976) -- (3.369,0) node[below] {$I_1$};
    \draw[dotted] (4.39,\r) -- (4.39,0) node[below] {$I^{*}$};
    \node[left] at (0,\r) {$r$};
    \draw (1.8,0.08) -- (1.8,-0.08); \node[above] at (1.8,0.04) {$W$};
    \draw (2.6,0.08) -- (2.6,-0.08); \node[above] at (2.6,0.04) {$W'$};
  \end{scope}
\end{tikzpicture}
