% Figura: el ajuste parcial de LINTNER (1956). Bloque 3, apartado «Qué se decide y qué se observa».
% Beneficio por acción E_t (ilustrativo), dividendo objetivo p·E_t con p = 0,5 y dividendo pagado
% D_t = D_{t-1} + c (p E_t - D_{t-1}) con c = 0,35 y D_0 = 1. Valores ilustrativos; escala horizontal 1 cm por período.
% Generar con: bash Code/generar_figura.sh lintner_ajuste
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1.1cm, y=1.1cm]
  \draw[->] (0,0) -- (10.6,0) node[below left, yshift=-2pt] {$t$};
  \draw[->] (0,0) -- (0,3.9) node[left] {por acción};
  \draw[thick] plot coordinates {(0,2) (1,2) (2,2.2) (3,3.4) (4,3.3) (5,3.5) (6,3.4) (7,2.2) (8,2.4) (9,3.0) (10,3.1)} node[right] {$E_t$};
  \draw[dashed] plot coordinates {(0,1.000) (1,1.000) (2,1.100) (3,1.700) (4,1.650) (5,1.750) (6,1.700) (7,1.100) (8,1.200) (9,1.500) (10,1.550)} node[right] {$p\,E_t$};
  \draw[very thick] plot coordinates {(0,1.000) (1,1.000) (2,1.035) (3,1.268) (4,1.402) (5,1.523) (6,1.585) (7,1.415) (8,1.340) (9,1.396) (10,1.450)} node[below right] {$D_t$};
\end{tikzpicture}
