% Figura: quién se financia y cómo según su capital propio A (HOLMSTRÖM y TIROLE, 1997).
% Cada barra es la misma inversión I. Por debajo de A_ (umbral inferior) la empresa no obtiene fondos; entre A_ y
% A^ (umbral superior) necesita un banco que la supervise y que aporte parte de los fondos; por encima de A^ se
% financia directamente en el mercado. Bloque 1, apartado «Financiación ajena». Esquema ilustrativo.
% Generar con: bash Code/generar_figura.sh ht_tramos
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  \def\h{2.6}
  % Eje del capital propio.
  \draw[->, thick] (0,0) -- (14.6,0) node[below left, yshift=-2pt] {capital propio de la empresa, $A$};
  \draw[thick] (4.8,0.1) -- (4.8,-0.1) node[below] {$\underline{A}$};
  \draw[thick] (9.6,0.1) -- (9.6,-0.1) node[below] {$\overline{A}$};
  \draw[dotted] (4.8,0) -- (4.8,4.1);
  \draw[dotted] (9.6,0) -- (9.6,4.1);
  % Títulos de los tramos.
  \node[font=\footnotesize\bfseries] at (2.4,3.8) {Sin financiación};
  \node[font=\footnotesize\bfseries] at (7.2,3.8) {Financiación bancaria};
  \node[font=\footnotesize\bfseries] at (12.1,3.8) {Financiación directa};
  % Tramo 1: el capital propio no basta y nadie presta el resto.
  \fill[black!70] (1.9,0.4) rectangle (2.9,1.1);
  \draw[dashed] (1.9,1.1) rectangle (2.9,0.4+\h);
  \draw (1.9,0.4) rectangle (2.9,1.1);
  \node[right] at (2.95,0.4+\h) {$I$};
  % Tramo 2: capital propio, préstamo del banco que supervisa y fondos de inversores no informados.
  \fill[black!70] (6.7,0.4) rectangle (7.7,1.5);
  \fill[black!35] (6.7,1.5) rectangle (7.7,2.1);
  \fill[black!8] (6.7,2.1) rectangle (7.7,0.4+\h);
  \draw (6.7,0.4) rectangle (7.7,0.4+\h);
  \draw (6.7,1.5) -- (7.7,1.5); \draw (6.7,2.1) -- (7.7,2.1);
  \node[right] at (7.75,0.4+\h) {$I$};
  % Tramo 3: capital propio y fondos del mercado.
  \fill[black!70] (11.6,0.4) rectangle (12.6,2.0);
  \fill[black!8] (11.6,2.0) rectangle (12.6,0.4+\h);
  \draw (11.6,0.4) rectangle (12.6,0.4+\h);
  \draw (11.6,2.0) -- (12.6,2.0);
  \node[right] at (12.65,0.4+\h) {$I$};
  % Leyenda.
  \fill[black!70] (2.6,-1.25) rectangle (2.9,-1.0); \draw (2.6,-1.25) rectangle (2.9,-1.0);
  \node[anchor=west] at (2.95,-1.12) {capital propio};
  \fill[black!35] (6.0,-1.25) rectangle (6.3,-1.0); \draw (6.0,-1.25) rectangle (6.3,-1.0);
  \node[anchor=west] at (6.35,-1.12) {préstamo del banco que supervisa};
  \fill[black!8] (10.4,-1.25) rectangle (10.7,-1.0); \draw (10.4,-1.25) rectangle (10.7,-1.0);
  \node[anchor=west] at (10.75,-1.12) {inversores no informados};
\end{tikzpicture}
