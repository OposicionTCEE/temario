% Figura: impuestos y costes de insolvencia. Bloque 2, apartado «Impuestos e insolvencia».
% (a) MODIGLIANI y MILLER (1963): V_L = V_U + T_c D, creciente con la deuda.
% (b) Equilibrio estático: V_L = V_U + T_c D - VA(costes de insolvencia), con VA(costes) = 0 hasta D = 1,5 y
%     0,09 (D - 1,5)^2 después; T_c = 0,35; V_U = 1,5. Máximo en D* = 3,44. Curvas ilustrativas.
% Generar con: bash Code/generar_figura.sh tradeoff_paneles
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1cm, y=1cm]
  % (a) Con impuesto sobre sociedades.
  \node[font=\footnotesize\bfseries] at (3.0,4.35) {(a) Con impuesto sobre sociedades};
  \draw[->] (0,0) -- (6.5,0) node[below left, yshift=-2pt] {$D$};
  \draw[->] (0,0) -- (0,4.0) node[left] {valor};
  \draw[dashed] (0,1.5) -- (6.0,1.5);
  \draw[very thick] (0,1.5) -- (6.0,3.6) node[right] {$V_L$};
  \node[left] at (0,1.5) {$V_U$};
  % (b) Equilibrio estático.
  \begin{scope}[xshift=7.6cm]
    \node[font=\footnotesize\bfseries] at (3.0,4.35) {(b) Equilibrio estático};
    \draw[->] (0,0) -- (6.5,0) node[below left, yshift=-2pt] {$D$};
    \draw[->] (0,0) -- (0,4.0) node[left] {valor};
    \draw[dashed] (0,1.5) -- (6.0,1.5);
    \draw[dashed] (0,1.5) -- (6.0,3.6) node[right] {$V_U+T_cD$};
    \draw[very thick] (0,1.5) -- (1.5,2.025) plot[domain=1.5:6, samples=50] (\x, {1.5+0.35*\x-0.09*(\x-1.5)*(\x-1.5)}) node[right] {$V_L$};
    \node[left] at (0,1.5) {$V_U$};
    \draw[dotted] (3.44,2.365) -- (3.44,0) node[below] {$D^{*}$};
    \draw[decorate, decoration={brace, amplitude=3pt}] (5.05,1.5) -- (5.05,3.2675) node[pos=0.2, left=3pt] {ahorro fiscal};
    \draw[decorate, decoration={brace, amplitude=3pt, mirror}] (5.25,2.072) -- (5.25,3.3375) node[midway, right=3pt, align=left] {costes de\\insolvencia};
  \end{scope}
\end{tikzpicture}
