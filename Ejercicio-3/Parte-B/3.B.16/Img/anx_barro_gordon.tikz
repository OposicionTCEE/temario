% anx_barro_gordon: sesgo inflacionista con discreción y unión con un ancla creíble (anexo I.3.4).
% Curva de PHILLIPS y = y_n + alpha (pi - pi^e) con alpha = 1; pérdida pi^2 + beta (y - y*)^2 con beta = 1; y_n = 2, y* = 4 (k = 2).
% Discreción: E = (2, 2) con pi^d = alpha beta k = 2; tentación G = (3, 1); compromiso C = (2, 0); unión con el ancla F = (2; 0,6).
% Curvas de indiferencia: circunferencias de centro (4, 0) y radios raíz de 8 (por E) y raíz de 2 (por G).
% Generar desde la carpeta del tema: bash Code/generar_figura.sh anx_barro_gordon
\begin{tikzpicture}[font=\footnotesize, x=1.45cm, y=1.45cm, >={Stealth[length=2mm]}]
  \begin{scope}
    \clip (0,-0.05) rectangle (5.6,3.55);
    \draw[black!40] (4,0) circle ({sqrt(8)});
    \draw[black!40] (4,0) circle ({sqrt(2)});
  \end{scope}
  \draw[->] (0,0) -- (5.8,0) node[below left] {$y$};
  \draw[->] (0,0) -- (0,3.7) node[below right] {$\pi$};
  \draw[black!85, thick] (2,0) -- (2,3.5) node[above] {largo plazo};
  \draw[black!85, thick] (2,0) -- (5.0,3.0) node[right] {$\pi^e=0$};
  \draw[black!85, thick] (0.5,0.5) -- (3.5,3.5) node[right] {$\pi^e=\pi^d$};
  \draw[black!45, dashed] (0,0.6) -- (2,0.6);
  \node[left] at (0,0.6) {$\pi_a$};
  \draw[black!45, dashed] (0,2) -- (2,2);
  \node[left] at (0,2) {$\pi^d=\alpha\beta k$};
  \fill (2,2) circle (1.6pt) node[left=3pt, yshift=6pt] {$E$};
  \fill (3,1) circle (1.6pt) node[below right] {$G$};
  \fill (2,0) circle (1.6pt) node[above left] {$C$};
  \fill (2,0.6) circle (1.6pt) node[right=2pt] {$F$};
  \fill (4,0) circle (1.2pt);
  \node[below] at (2,0) {$y_n$};
  \node[below] at (4,0) {$y^*=y_n+k$};
\end{tikzpicture}
