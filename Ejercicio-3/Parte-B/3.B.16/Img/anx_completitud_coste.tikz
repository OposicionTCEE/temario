% anx_completitud_coste: la curva de costes de una unión incompleta y de una completa (anexo I.5.2).
% B = 2,4 phi. Incompleta: C = 2,2 - 1,6 phi (phi* = 0,55). Completa: C = 1,2 - 1,0 phi (phi* = 0,353).
% Generar desde la carpeta del tema: bash Code/generar_figura.sh anx_completitud_coste
\begin{tikzpicture}[font=\footnotesize, x=8cm, y=1.7cm, >={Stealth[length=2mm]}]
  \draw[->] (0,0) -- (1.08,0) node[below left] {apertura hacia los socios, $\phi$};
  \draw[->] (0,0) -- (0,2.75) node[below right] {beneficios y costes, en proporción del PIB};
  \draw[black!85, thick] (0,0) -- (1,2.4) node[right] {$B$};
  \draw[black!55, thick] (0,2.2) -- (1,0.6) node[right] {$C$ (unión incompleta)};
  \draw[black!55, thick, dashed] (0,1.2) -- (1,0.2) node[right] {$C$ (unión completa)};
  \draw[->, black!60] (0.15,1.92) -- (0.15,1.12);
  \draw[black!40, densely dotted] (0.55,0) -- (0.55,1.32);
  \draw[black!40, densely dotted] (0.353,0) -- (0.353,0.847);
  \fill (0.55,1.32) circle (1.6pt);
  \fill (0.353,0.847) circle (1.6pt);
  \node[below] at (0.55,0) {$\phi^*_{\mathrm{inc}}$};
  \node[below] at (0.353,0) {$\phi^*_{\mathrm{comp}}$};
\end{tikzpicture}
