% b1_grados: escalera de los grados de integración monetaria; cada peldaño añade un atributo, y las llaves marcan
% los umbrales de irrevocabilidad, voz y respaldo (bloque 1.2). Versión abstracta de anx_grados (anexo I.1.2).
% Generar desde la carpeta del tema: bash Code/generar_figura.sh b1_grados
\begin{tikzpicture}[font=\footnotesize, x=1cm, y=1cm]
  \def\w{2.8} \def\h{1.05}
  \fill[black!7] (0,0) -- (0,\h) -- (\w,\h) -- (\w,2*\h) -- (2*\w,2*\h) -- (2*\w,3*\h) -- (3*\w,3*\h) -- (3*\w,4*\h)
                 -- (4*\w,4*\h) -- (4*\w,5*\h) -- (5*\w,5*\h) -- (5*\w,0) -- cycle;
  \draw[black!75, thick] (0,0) -- (0,\h) -- (\w,\h) -- (\w,2*\h) -- (2*\w,2*\h) -- (2*\w,3*\h) -- (3*\w,3*\h) -- (3*\w,4*\h)
                         -- (4*\w,4*\h) -- (4*\w,5*\h) -- (5*\w,5*\h) -- (5*\w,0);
  \draw[black!45] (0,0) -- (5*\w,0);
  \foreach \i in {1,...,4} { \draw[black!20] (\i*\w,0) -- (\i*\w,\i*\h); }
  % formas, dentro de cada peldaño
  \foreach \i/\n in {0/{Tipo fijo\\ajustable}, 1/{Caja de\\conversión}, 2/{Moneda\\adoptada}, 3/{Unión\\monetaria}, 4/{Nación}} {
    \node[anchor=north, align=center, font=\scriptsize\bfseries] at ({(\i+0.5)*\w},{(\i+1)*\h-0.08}) {\n};
  }
  % lo que añade cada peldaño, encima de su huella
  \foreach \i/\t in {0/{paridad\\revisable}, 1/{paridad fijada\\por ley}, 2/{sin moneda\\propia}, 3/{voz y señoreaje\\comunes}, 4/{respaldo y\\presupuesto común}} {
    \node[anchor=south, align=center, font=\scriptsize, black!70] at ({(\i+0.5)*\w},{(\i+1)*\h+0.04}) {\t};
  }
  % umbrales
  \draw[decorate, decoration={brace, mirror, amplitude=4pt}] (2*\w+0.05,-0.15) -- (5*\w-0.05,-0.15) node[midway, below=5pt, font=\scriptsize] {irrevocable};
  \draw[decorate, decoration={brace, mirror, amplitude=4pt}] (3*\w+0.05,-0.8) -- (5*\w-0.05,-0.8) node[midway, below=5pt, font=\scriptsize] {con voz en la política común};
  \draw[decorate, decoration={brace, mirror, amplitude=4pt}] (4*\w+0.05,-1.45) -- (5*\w-0.05,-1.45) node[midway, below=5pt, font=\scriptsize] {con respaldo};
\end{tikzpicture}
