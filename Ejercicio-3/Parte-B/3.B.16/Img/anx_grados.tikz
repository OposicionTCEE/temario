% anx_grados: grados de integración monetaria y atributos que se ceden o se comparten en cada uno (anexo I.1.2).
% Generar desde la carpeta del tema: bash Code/generar_figura.sh anx_grados
\begin{tikzpicture}[font=\footnotesize, x=1cm, y=1cm]
  % columnas: formas de integración
  \foreach \t [count=\c] in {{Tipo fijo\\ajustable},{Pseudounión\\cambiaria},{Unión\\cambiaria\\completa},{Caja de\\conversión},{Moneda\\adoptada},{Unión\\monetaria},{Unión\\completa\\(nación)}}{
    \node[anchor=south, align=center, font=\scriptsize, text width=1.55cm] at ({4.9+1.6*(\c-1)},0.35) {\t};
  }
  % sombreado de las formas unilaterales (columnas 4 y 5)
  \fill[black!6] ({4.9+1.6*3-0.78},0.3) rectangle ({4.9+1.6*4+0.78},-4.5);
  % filas: atributos de la soberanía monetaria
  \foreach \r/\l in {1/{Paridad irrevocable},2/{Política monetaria única},3/{Moneda común},4/{Voz en la política común},5/{Señoreaje propio o compartido},6/{Prestamista de los bancos},7/{Respaldo de la deuda pública},8/{Presupuesto y banca comunes}}{
    \node[anchor=east, align=right, text width=4.1cm] at (4.1,{-0.6*(\r-1)}) {\l};
    \draw[black!15] (0.1,{-0.6*(\r-1)-0.3}) -- (15.3,{-0.6*(\r-1)-0.3});
  }
  \draw[black!40] (0.1,0.3) -- (15.3,0.3);
  % valores: s = sí, m = en parte o con condiciones, n = no
  \foreach \r/\vals in {1/{n,m,s,m,s,s,s},2/{m,n,s,s,s,s,s},3/{n,n,n,n,s,s,s},4/{n,n,s,n,n,s,s},5/{s,s,s,m,n,s,s},6/{m,m,m,n,n,s,s},7/{m,m,m,n,n,n,s},8/{n,n,n,n,n,n,s}}{
    \foreach \v [count=\c] in \vals {
      \coordinate (P) at ({4.9+1.6*(\c-1)},{-0.6*(\r-1)});
      \if s\v \fill[black!75] (P) circle (0.15); \fi
      \if m\v \fill[black!75] (P) ++(90:0.15) arc[start angle=90, end angle=270, radius=0.15] -- cycle; \draw[black!75, line width=0.6pt] (P) circle (0.15); \fi
      \if n\v \draw[black!75, line width=0.6pt] (P) circle (0.15); \fi
    }
  }
  % llave de las formas unilaterales
  \draw[decorate, decoration={brace, mirror, amplitude=4pt}, black!60] ({4.9+1.6*3-0.7},-4.6) -- ({4.9+1.6*4+0.7},-4.6) node[midway, below=5pt, font=\scriptsize, black] {formas unilaterales: cliente y ancla};
  % leyenda
  \fill[black!75] (4.2,-5.75) circle (0.15); \node[anchor=west] at (4.45,-5.75) {sí};
  \fill[black!75] (5.6,-5.75) ++(90:0.15) arc[start angle=90, end angle=270, radius=0.15] -- cycle; \draw[black!75, line width=0.6pt] (5.6,-5.75) circle (0.15); \node[anchor=west] at (5.85,-5.75) {en parte o con condiciones};
  \draw[black!75, line width=0.6pt] (9.9,-5.75) circle (0.15); \node[anchor=west] at (10.15,-5.75) {no};
\end{tikzpicture}
