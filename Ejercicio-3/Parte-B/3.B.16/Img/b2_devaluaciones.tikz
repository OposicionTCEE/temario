% b2_devaluaciones: devaluaciones competitivas como dilema del prisionero entre dos socios con monedas propias (bloque 2.2).
% Pagos ordinales (4 = el mejor): sin cooperación, los dos devalúan (2, 2), aunque los dos preferirían no devaluar (3, 3);
% la moneda común suprime la estrategia de devaluar y deja solo la casilla (3, 3). Base en anx:devaluaciones_competitivas.
% Generar desde la carpeta del tema: bash Code/generar_figura.sh b2_devaluaciones
\begin{tikzpicture}[font=\footnotesize, x=1cm, y=1cm,
    celda/.style={draw=black!60, minimum width=3.0cm, minimum height=1.15cm, align=center}]
  \node[celda, fill=black!10, very thick] at (0,0) {$(3,\ 3)$};
  \node[celda] at (3.0,0) {$(1,\ 4)$};
  \node[celda] at (0,-1.15) {$(4,\ 1)$};
  \node[celda, fill=black!25] at (3.0,-1.15) {$(2,\ 2)$};
  \node[font=\footnotesize\bfseries] at (1.5,1.55) {País B};
  \node at (0,0.9) {no devalúa};
  \node at (3.0,0.9) {devalúa};
  \node[font=\footnotesize\bfseries, anchor=east] at (-2.3,-0.575) {País A};
  \node[anchor=east] at (-1.6,0) {no devalúa};
  \node[anchor=east] at (-1.6,-1.15) {devalúa};
  \node[anchor=west, align=left, font=\scriptsize] at (4.7,-1.15) {equilibrio sin cooperación:\\los dos devalúan};
  \node[anchor=west, align=left, font=\scriptsize] at (4.7,0) {con moneda común:\\la única casilla posible};
  \draw[black!50, ->, >={Stealth[length=1.8mm]}] (4.65,0) -- (1.6,0);
  \node[anchor=north, font=\scriptsize] at (1.5,-1.9) {pagos ordinales (país A, país B): 4 es el mejor resultado y 1 el peor};
\end{tikzpicture}
