% b2_devaluaciones: devaluaciones competitivas como dilema del prisionero entre dos socios con monedas propias (bloque 2.2).
% Pagos ordinales (4 = el mejor): sin cooperación, los dos devalúan (2, 2), aunque los dos preferirían no devaluar (3, 3);
% la moneda común suprime la estrategia de devaluar y deja solo la casilla (3, 3). Base en anx:devaluaciones_competitivas.
% Generar desde la carpeta del tema: bash Code/generar_figura.sh b2_devaluaciones
\begin{tikzpicture}[font=\footnotesize, x=1cm, y=1cm,
    celda/.style={draw=black!60, minimum width=3.4cm, minimum height=1.35cm, align=center}]
  \node[celda, fill=black!10, very thick] at (0,0) {$(3,\ 3)$\\[1pt]{\scriptsize con moneda común:}\\[-1pt]{\scriptsize la única casilla posible}};
  \node[celda] at (3.4,0) {$(1,\ 4)$};
  \node[celda] at (0,-1.35) {$(4,\ 1)$};
  \node[celda, fill=black!25] at (3.4,-1.35) {$(2,\ 2)$\\[1pt]{\scriptsize equilibrio sin cooperación:}\\[-1pt]{\scriptsize los dos devalúan}};
  \node[font=\footnotesize\bfseries] at (1.7,1.65) {País B};
  \node at (0,1.0) {no devalúa};
  \node at (3.4,1.0) {devalúa};
  \node[font=\footnotesize\bfseries, anchor=east] at (-2.4,-0.675) {País A};
  \node[anchor=east] at (-1.8,0) {no devalúa};
  \node[anchor=east] at (-1.8,-1.35) {devalúa};
  \node[anchor=north, font=\scriptsize] at (1.7,-2.15) {pagos ordinales (país A, país B): 4 es el mejor resultado y 1 el peor};
\end{tikzpicture}
