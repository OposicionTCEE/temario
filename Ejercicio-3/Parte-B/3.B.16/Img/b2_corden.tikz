% b2_corden: preferencias distintas e inflación común (bloque 2.3; CORDEN, 1972). Panel izquierdo, corto plazo: misma base
% que anx_phillips (anexo I.2.5): propio pi = 2,4/(u - 0,5) - 0,3 (A en u = 4), socio pi* = 3,6/(u - 0,5) - 0,1 (A* en
% u = 2,5), inflación común 1 (B y B*). Panel derecho, largo plazo: curva vertical en u_n = 3,2; la inflación común solo
% cambia la inflación (A, B y A* sobre la vertical). Figura abstracta.
% Generar desde la carpeta del tema: bash Code/generar_figura.sh b2_corden
\begin{tikzpicture}[font=\footnotesize, x=1.0cm, y=1.05cm, >={Stealth[length=2mm]}]
  % corto plazo
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (3.1,3.75) {Corto plazo};
    \draw[->] (0,0) -- (6.6,0) node[below left] {$u$};
    \draw[->] (0,0) -- (0,3.4) node[left] {$\pi$};
    \draw[black!85, thick, domain=1.25:6.2, samples=60] plot (\x, {2.4/(\x-0.5)-0.3}) node[above] {propio};
    \draw[black!55, thick, domain=1.75:6.2, samples=60] plot (\x, {3.6/(\x-0.5)-0.1}) node[above right] {socio};
    \draw[black!45, dashed] (0,1) -- (6.3,1) node[right] {$\bar\pi$};
    \fill (4,0.386) circle (1.6pt) node[below] {$A$};
    \fill (2.5,1.7) circle (1.6pt) node[above right] {$A^*$};
    \fill (2.346,1) circle (1.6pt) node[below left] {$B$};
    \fill (3.773,1) circle (1.6pt) node[above right] {$B^*$};
    \draw[->, black!60, shorten >=3pt, shorten <=3pt] (4,0.386) to[bend left=12] (2.346,1);
    \draw[->, black!60, shorten >=3pt, shorten <=3pt] (2.5,1.7) to[bend left=12] (3.773,1);
  \end{scope}
  % largo plazo
  \begin{scope}[xshift=8.0cm]
    \node[font=\footnotesize\bfseries] at (2.6,3.75) {Largo plazo};
    \draw[->] (0,0) -- (5.4,0) node[below left] {$u$};
    \draw[->] (0,0) -- (0,3.4) node[left] {$\pi$};
    \draw[black!85, thick] (2.6,0.1) -- (2.6,3.2);
    \node[below] at (2.6,0) {$u_n$};
    \draw[black!45, dashed] (0,1) -- (4.6,1) node[right] {$\bar\pi$};
    \fill (2.6,0.386) circle (1.6pt) node[right] {$A$};
    \fill (2.6,1) circle (1.6pt) node[above right] {$B=B^*$};
    \fill (2.6,1.7) circle (1.6pt) node[right] {$A^*$};
    \node[align=left, font=\scriptsize, anchor=west] at (2.85,2.6) {la inflación común\\no cambia el desempleo};
  \end{scope}
\end{tikzpicture}
