% anx3_orden: orden en que se completaron Estados Unidos (1790-1935) y la zona del euro (1999-2022), con escalas distintas (anexo III.5.4).
% Estados Unidos: asunción de las deudas de los estados (1790), ley de acuñación (1792), rechazo de una nueva asunción (1843),
% leyes de banca nacional e impuesto sobre los billetes de los estados (1863-1865), Reserva Federal (1913), garantía de depósitos
% (1933), seguro de desempleo (1935). Zona del euro: euro y BCE (1999), primer fondo de rescate (2010), MEDE y OMT (2012),
% supervisión única (2014), resolución única (2016), SURE y NGEU (2020), TPI (2022).
% Generar desde la carpeta del tema: bash Code/generar_figura.sh anx3_orden
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=2mm]}]
  % Estados Unidos: abscisa = (año - 1785) x 0,084 cm
  \node[anchor=east, font=\footnotesize\bfseries] at (-0.25,0) {Estados Unidos};
  \draw[->] (0,0) -- (13.3,0);
  \foreach \t in {1800,1825,...,1925} {
    \draw ({(\t-1785)*0.084},0.06) -- ({(\t-1785)*0.084},-0.06);
    \node[anchor=north, font=\scriptsize] at ({(\t-1785)*0.084},-0.08) {$\t$};
  }
  \foreach \a/\hecho in {1790/deuda federal, 1843/no rescate, 1864/billetes uniformes, 1913/Reserva Federal, 1933/garantía de depósitos} {
    \fill ({(\a-1785)*0.084},0) circle (1.6pt);
    \node[rotate=90, anchor=west, font=\scriptsize] at ({(\a-1785)*0.084},0.15) {\hecho};
  }
  \foreach \a/\hecho in {1792/dólar, 1935/seguro de desempleo} {
    \fill ({(\a-1785)*0.084},0) circle (1.6pt);
    \node[rotate=90, anchor=east, font=\scriptsize] at ({(\a-1785)*0.084},-0.5) {\hecho};
  }
  % zona del euro: abscisa = (año - 1995) x 0,37 cm
  \begin{scope}[yshift=-4.4cm]
    \node[anchor=east, font=\footnotesize\bfseries] at (-0.25,0) {Zona del euro};
    \draw[->] (0,0) -- (13.3,0);
    \foreach \t in {2000,2005,...,2030} {
      \draw ({(\t-1995)*0.37},0.06) -- ({(\t-1995)*0.37},-0.06);
      \node[anchor=north, font=\scriptsize] at ({(\t-1995)*0.37},-0.08) {$\t$};
    }
    \foreach \a/\hecho in {1999/euro y BCE, 2010/primer fondo de rescate, 2012/MEDE y OMT, 2014/supervisión única,
                           2016/resolución única, 2020/SURE y NGEU, 2022/TPI} {
      \fill ({(\a-1995)*0.37},0) circle (1.6pt);
      \node[rotate=90, anchor=west, font=\scriptsize] at ({(\a-1995)*0.37},0.15) {\hecho};
    }
    \node[anchor=north east, align=right, font=\scriptsize, black!60] at (13.3,-0.55) {pendientes: garantía de depósitos\\y capacidad fiscal permanente};
  \end{scope}
\end{tikzpicture}
