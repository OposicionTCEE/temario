% b4_sapir: flexibilidad y unión presupuestaria según la naturaleza de las perturbaciones (bloque 4.2; idea que DE GRAUWE,
% 2020, atribuye a SAPIR; DE GRAUWE y JI, 2016): con perturbaciones permanentes, la línea de coste nulo es casi vertical
% (solo ayuda la flexibilidad); con perturbaciones temporales, casi horizontal (basta un presupuesto común pequeño).
% Por encima y a la derecha de cada línea, la unión compensa. Base en anx_sapir (anexo I.5.5).
% Generar desde la carpeta del tema: bash Code/generar_figura.sh b4_sapir
\begin{tikzpicture}[font=\footnotesize, x=1.5cm, y=1.1cm, >={Stealth[length=2mm]}]
  \draw[->] (0,0) -- (5,0) node[below left] {flexibilidad, $F$};
  \draw[->] (0,0) -- (0,4);
  \node[anchor=south west] at (0,4) {unión presupuestaria, $U$};
  \draw[black!85, thick] (1.1,3.6) -- (1.6,0.2);
  \node[anchor=west, align=left, font=\scriptsize] at (1.4,3.5) {perturbaciones permanentes:\\solo ayuda la flexibilidad};
  \draw[black!60, thick, dashed] (0.2,1.25) -- (4.6,0.85);
  \node[anchor=south east, align=right, font=\scriptsize] at (4.6,0.95) {perturbaciones temporales:\\basta un presupuesto común pequeño};
  \node[font=\scriptsize, black!70] at (3.6,2.6) {la unión compensa por encima};
  \node[font=\scriptsize, black!70] at (3.6,2.25) {y a la derecha de cada línea};
\end{tikzpicture}
