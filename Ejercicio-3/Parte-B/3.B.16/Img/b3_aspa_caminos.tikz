% b3_aspa_caminos: los dos caminos del ajuste a la perturbación asimétrica de b3_aspa_choque (bloque 3.1). Con moneda propia
% (discontinuo), la depreciación devuelve las demandas a DA y DA* de golpe: E1 -> E0 y E1* -> E0*. En la unión (punteado),
% los salarios bajan en el país propio (OA'' : p = y - 1,3) y suben en el socio (OA*'' : p = y + 0,3), despacio: E1 -> E2 =
% (2,5; 1,2) y E1* -> E2* = (2,5; 2,8). Misma producción de llegada y mismo precio relativo. Base común en b3_aspa_choque.
% Generar desde la carpeta del tema: bash Code/generar_figura.sh b3_aspa_caminos
\begin{tikzpicture}[font=\footnotesize, x=1.15cm, y=0.95cm, >={Stealth[length=2mm]}]
  % país propio
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (2.5,4.65) {País propio};
    \draw[->] (0,0) -- (5,0) node[below left] {$y$};
    \draw[->] (0,0) -- (0,4.3) node[left] {$p$};
    \draw[black!85, thick] (0.9,0.4) -- (4.2,3.7) node[right] {$OA$};
    \draw[black!85, thick] (0.8,3.7) -- (4.0,0.5) node[right] {$DA$};
    \draw[black!60, thick] (0.4,3.3) -- (3.2,0.5) node[below left] {$DA'$};
    \draw[black!60, thick, densely dotted] (1.7,0.4) -- (4.6,3.3) node[right, black] {$OA''$};
    \draw[black!35, densely dotted] (2.5,0) -- (2.5,2.0);
    \draw[black!35, densely dotted] (2.1,0) -- (2.1,1.6);
    \draw[->, thick, black!75, dashed] (2.12,1.66) -- (2.44,1.98);
    \draw[->, thick, black!75, densely dotted] (2.16,1.54) -- (2.44,1.26);
    \fill (2.5,2.0) circle (1.5pt) node[right=1pt] {$E_0$};
    \fill (2.1,1.6) circle (1.5pt) node[left=1pt] {$E_1$};
    \fill (2.5,1.2) circle (1.5pt) node[right=1pt] {$E_2$};
    \node[below] at (2.1,0) {$y_1$}; \node[below] at (2.5,0) {$y_0$};
  \end{scope}
  % socio
  \begin{scope}[xshift=6.8cm]
    \node[font=\footnotesize\bfseries] at (2.5,4.65) {Socio};
    \draw[->] (0,0) -- (5,0) node[below left] {$y^*$};
    \draw[->] (0,0) -- (0,4.3) node[left] {$p^*$};
    \draw[black!85, thick] (0.9,0.4) -- (4.2,3.7) node[right] {$OA^*$};
    \draw[black!85, thick] (0.8,3.7) -- (4.0,0.5) node[below] {$DA^*$};
    \draw[black!60, thick] (1.6,3.7) -- (4.6,0.7) node[right] {$DA^{*\prime}$};
    \draw[black!60, thick, densely dotted] (0.3,0.6) -- (3.6,3.9) node[left, black] {$OA^{*\prime\prime}$};
    \draw[black!35, densely dotted] (2.5,0) -- (2.5,2.0);
    \draw[black!35, densely dotted] (2.9,0) -- (2.9,2.4);
    \draw[->, thick, black!75, dashed] (2.86,2.34) -- (2.56,2.04);
    \draw[->, thick, black!75, densely dotted] (2.84,2.46) -- (2.56,2.74);
    \fill (2.5,2.0) circle (1.5pt) node[left=1pt] {$E_0^*$};
    \fill (2.9,2.4) circle (1.5pt) node[right=1pt] {$E_1^*$};
    \fill (2.5,2.8) circle (1.5pt) node[left=1pt] {$E_2^*$};
    \node[below] at (2.5,0) {$y_0^*$}; \node[below] at (2.9,0) {$y_1^*$};
  \end{scope}
  % leyenda
  \draw[thick, black!75, dashed] (1.2,-1.0) -- (2.0,-1.0);
  \node[anchor=west] at (2.1,-1.0) {con moneda propia: la depreciación devuelve las demandas a su posición, de golpe};
  \draw[thick, black!75, densely dotted] (1.2,-1.5) -- (2.0,-1.5);
  \node[anchor=west] at (2.1,-1.5) {en la unión: los salarios bajan en el país propio y suben en el socio, despacio};
\end{tikzpicture}
