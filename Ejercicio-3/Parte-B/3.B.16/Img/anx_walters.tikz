% anx_walters: auge y crisis de un miembro con tipo de interés nominal común: diferencial de inflación, tipo real relativo y competitividad (anexo I.7.3).
% Trayectorias estilizadas: pi - pi_barra = sen(pi t/6); r - r_barra = -sen(pi t/6); q = (6/pi)(cos(pi t/6) - 1).
% Generar desde la carpeta del tema: bash Code/generar_figura.sh anx_walters
\begin{tikzpicture}[font=\footnotesize]
  \begin{axis}[name=a, width=7.6cm, height=5.6cm, xmin=0, xmax=12, ymin=-1.3, ymax=1.4,
    axis lines=middle, xlabel={tiempo}, title={(a) Inflación y tipo real frente a la unión}, title style={font=\footnotesize},
    xlabel style={at={(axis description cs:1,0)}, anchor=north east}, label style={font=\footnotesize},
    xtick=\empty, ytick=\empty, clip=false]
    \addplot[black!85, thick, domain=0:12, samples=100] {sin(deg(pi*x/6))};
    \addplot[black!50, thick, dashed, domain=0:12, samples=100] {-sin(deg(pi*x/6))};
    \node[anchor=south, black!85] at (axis cs:3,1.0) {$\pi-\bar\pi$};
    \node[anchor=north, black!55] at (axis cs:3,-1.0) {$r-\bar r$};
    \node[anchor=north] at (axis cs:3,-0.15) {auge};
    \node[anchor=south] at (axis cs:9,0.15) {crisis};
  \end{axis}
  \begin{axis}[at={(a.east)}, anchor=west, xshift=1.2cm, width=7.6cm, height=5.6cm, xmin=0, xmax=12, ymin=-4.3, ymax=0.8,
    axis lines=middle, xlabel={tiempo}, title={(b) Competitividad, $q$}, title style={font=\footnotesize},
    xlabel style={at={(axis description cs:1,1)}, anchor=south east}, label style={font=\footnotesize},
    xtick=\empty, ytick=\empty, clip=false]
    \addplot[black!85, thick, domain=0:12, samples=100] {(6/pi)*(cos(deg(pi*x/6))-1)};
    \node[anchor=north] at (axis cs:6,-3.9) {pérdida máxima de competitividad};
  \end{axis}
\end{tikzpicture}
