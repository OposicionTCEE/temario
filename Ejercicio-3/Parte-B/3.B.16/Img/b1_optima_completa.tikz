% b1_optima_completa: optimalidad y completitud como preguntas distintas (bloque 1.4, cierre del bloque): cuadro de dos
% por dos con ejemplos y trayectorias. Estados Unidos pasa de incompleta y no óptima (hasta los años treinta) a completa y
% óptima al completarse (ROCKOFF, 2000); Italia, completa sin ser óptima (el Mezzogiorno no ha convergido; DE GRAUWE, 2018);
% la zona del euro nace incompleta en 1999 con su optimalidad discutida (sobre la frontera entre filas, como en b4_amo) y se
% completa en parte hasta 2026 (b1_piezas). La casilla óptima e incompleta queda como pregunta, que responde el bloque 4.
% Generar desde la carpeta del tema: bash Code/generar_figura.sh b1_optima_completa
\begin{tikzpicture}[font=\footnotesize, x=1cm, y=1cm, >={Stealth[length=2mm]}]
  \def\W{5.2} \def\H{2.4}
  % casillas
  \draw[black!60] (0,0) rectangle (2*\W,2*\H);
  \draw[black!35] (\W,0) -- (\W,2*\H);
  \draw[black!35] (0,\H) -- (2*\W,\H);
  % columnas: completitud
  \node[anchor=south, font=\scriptsize\bfseries] at (0.5*\W,2*\H+0.05) {incompleta};
  \node[anchor=south, font=\scriptsize\bfseries] at (1.5*\W,2*\H+0.05) {completa};
  \node[anchor=south, font=\scriptsize] at (\W,2*\H+0.45) {completitud: ¿tiene la unión las instituciones de una nación?};
  % filas: optimalidad
  \node[anchor=east, font=\scriptsize\bfseries] at (-0.1,1.5*\H) {óptima};
  \node[anchor=east, font=\scriptsize\bfseries] at (-0.1,0.5*\H) {no óptima};
  \node[rotate=90, anchor=south, align=center, font=\scriptsize] at (-1.55,\H) {optimalidad:\\¿compensa compartir la moneda?};
  % casilla abierta
  \node[font=\large\bfseries, black!45] at (0.5*\W,4.15) {?};
  \node[align=center, font=\scriptsize, black!70] at (0.5*\W,3.45) {¿compensa una unión sin\\las instituciones de una nación?};
  % Estados Unidos: se completa y cruza a la casilla óptima
  \fill (2.9,0.75) circle (1.8pt) node[anchor=east, align=right, font=\scriptsize] {EE. UU. hasta\\los años treinta};
  \fill (7.6,3.7) circle (1.8pt) node[anchor=west, align=left, font=\scriptsize] {EE. UU. desde\\los años treinta};
  \draw[->, thick, black!70] (3.0,0.82) -- (7.48,3.62) node[pos=0.22, sloped, above, font=\scriptsize, black] {se completa};
  % Italia: completa sin ser óptima
  \fill (7.6,1.1) circle (1.8pt) node[anchor=west, align=left, font=\scriptsize] {Italia, con\\el Mezzogiorno};
  % zona del euro: optimalidad discutida, se completa en parte
  \fill (1.0,\H) circle (1.8pt) node[anchor=north, align=center, font=\scriptsize, yshift=-2pt] {zona del euro\\($1999$)};
  \draw[->, thick, black!80, densely dashed] (1.12,\H) -- (3.75,\H);
  \fill (3.85,\H) circle (1.8pt) node[anchor=north, font=\scriptsize, yshift=-2pt] {($2026$)};
\end{tikzpicture}
