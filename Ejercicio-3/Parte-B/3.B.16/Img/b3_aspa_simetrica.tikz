% b3_aspa_simetrica: perturbación simétrica de demanda (bloque 3.1, crítica de la frecuencia; COMISIÓN EUROPEA, 1990): las
% dos demandas caen juntas (DA' : p = 3,7 - y en los dos países) y la política monetaria común las devuelve a su posición;
% el tipo de cambio entre los socios no hace falta. Base común en b3_aspa_choque.
% Generar desde la carpeta del tema: bash Code/generar_figura.sh b3_aspa_simetrica
\begin{tikzpicture}[font=\footnotesize, x=1.15cm, y=0.95cm, >={Stealth[length=2mm]}]
  \foreach \dx/\t/\s in {0/{País propio}/{}, 6.8/{Socio}/{^*}} {
    \begin{scope}[xshift=\dx cm]
      \node[font=\footnotesize\bfseries] at (2.5,4.65) {\t};
      \draw[->] (0,0) -- (5,0) node[below left] {$y\s$};
      \draw[->] (0,0) -- (0,4.3) node[left] {$p\s$};
      \draw[black!85, thick] (0.9,0.4) -- (4.2,3.7) node[right] {$OA\s$};
      \draw[black!85, thick] (0.8,3.7) -- (4.0,0.5) node[right] {$DA\s$};
      \draw[black!60, thick] (0.4,3.3) -- (3.2,0.5) node[below left] {$DA\s{}'$};
      \draw[->, black!70] (3.45,1.05) -- (2.8,1.05);
      \draw[->, thick, black!75, dashed] (2.12,1.66) -- (2.44,1.98);
      \draw[black!35, densely dotted] (2.5,0) -- (2.5,2.0);
      \draw[black!35, densely dotted] (2.1,0) -- (2.1,1.6);
      \fill (2.5,2.0) circle (1.5pt) node[right=1pt] {$E_0\s$};
      \fill (2.1,1.6) circle (1.5pt) node[left=1pt] {$E_1\s$};
      \node[below] at (2.1,0) {$y_1\s$}; \node[below] at (2.5,0) {$y_0\s$};
    \end{scope}
  }
  \draw[->, black!70] (1.2,-1.0) -- (2.0,-1.0);
  \node[anchor=west] at (2.1,-1.0) {perturbación común: las dos demandas caen a la vez};
  \draw[thick, black!75, dashed] (1.2,-1.5) -- (2.0,-1.5);
  \node[anchor=west] at (2.1,-1.5) {política monetaria común: devuelve las dos demandas a su posición};
\end{tikzpicture}
