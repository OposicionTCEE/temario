% anx3_uniones: duración de algunas uniones monetarias con y sin unión política, 1790-2026 (anexo III.3).
% Fechas comprobadas el 08/11/2026: ley de acuñación de EE. UU. (1792); franco suizo (1850); lira (1862); marco (1876) y
% división de 1948 a 1990; Austria-Hungría (1867-1919, GARBER y SPENCER); Checoslovaquia (1919-1993, FIDRMUC et al.);
% Irlanda en la libra (1826-1979, Banco Central de Irlanda; Estado Libre desde 1922); Unión Latina (1865, de hecho hasta
% 1914, formal hasta 1927); Escandinava (1873, de hecho hasta 1914, formal hasta 1924); Junta Monetaria de África
% Oriental (1919-1966); Bélgica y Luxemburgo (1922-1998); franco CFA (1945); zona del rublo (1992-1993); euro (1999).
% Generar desde la carpeta del tema: bash Code/generar_figura.sh anx3_uniones
\begin{tikzpicture}[font=\footnotesize, x=0.05cm, y=1cm]
  % abscisa = año menos 1790
  \tikzset{con/.style={fill=black!80}, sin/.style={fill=black!40}, formal/.style={fill=black!12, draw=black!40, line width=0.3pt}}
  \newcommand{\barra}[4]{\path[#1] (#2-1790,#4-0.1) rectangle (#3-1790,#4+0.1);}
  \newcommand{\sigue}[2]{\fill[#1] (2026-1790,#2-0.1) -- (2031-1790,#2) -- (2026-1790,#2+0.1) -- cycle;}
  \newcommand{\rotulo}[2]{\node[anchor=east, font=\scriptsize] at (-3,#2) {#1};}
  % rejilla
  \foreach \t in {1800,1850,...,2000} { \draw[black!12] (\t-1790,0.2) -- (\t-1790,-6.45); }
  % con unión política
  \node[anchor=west, font=\scriptsize\bfseries] at (-70,0.05) {Uniones con unión política};
  \rotulo{Estados Unidos}{-0.4}       \barra{con}{1792}{2026}{-0.4}  \sigue{black!80}{-0.4}
  \rotulo{Suiza}{-0.8}                \barra{con}{1850}{2026}{-0.8}  \sigue{black!80}{-0.8}
  \rotulo{Italia}{-1.2}               \barra{con}{1862}{1999}{-1.2}  \node[anchor=west, font=\scriptsize, black!60] at (2001-1790,-1.2) {euro};
  \rotulo{Alemania}{-1.6}             \barra{con}{1876}{1948}{-1.6}  \draw[black!50, densely dotted] (1948-1790,-1.6) -- (1990-1790,-1.6);
                                      \barra{con}{1990}{1999}{-1.6}  \node[anchor=west, font=\scriptsize, black!60] at (2001-1790,-1.6) {euro};
  \node[anchor=north, font=\scriptsize, black!60] at (1969-1790,-1.63) {dos monedas};
  \rotulo{Austria-Hungría}{-2.0}      \barra{con}{1867}{1919}{-2.0}
  \rotulo{Checoslovaquia}{-2.4}       \barra{con}{1919}{1993}{-2.4}
  % sin unión política
  \node[anchor=west, font=\scriptsize\bfseries] at (-70,-2.95) {Uniones entre Estados soberanos};
  \rotulo{Irlanda y Reino Unido}{-3.4}  \barra{con}{1826}{1922}{-3.4}  \barra{sin}{1922}{1979}{-3.4}
  \rotulo{Unión Monetaria Latina}{-3.8} \barra{sin}{1865}{1914}{-3.8}  \barra{formal}{1914}{1927}{-3.8}
  \rotulo{Unión Monetaria Escandinava}{-4.2} \barra{sin}{1873}{1914}{-4.2} \barra{formal}{1914}{1924}{-4.2}
  \rotulo{África Oriental}{-4.6}        \barra{sin}{1919}{1966}{-4.6}
  \rotulo{Bélgica y Luxemburgo}{-5.0}   \barra{sin}{1922}{1999}{-5.0}  \node[anchor=west, font=\scriptsize, black!60] at (2001-1790,-5.0) {euro};
  \rotulo{Zona del franco CFA}{-5.4}    \barra{sin}{1945}{2026}{-5.4}  \sigue{black!40}{-5.4}
  \rotulo{Zona del rublo}{-5.8}         \barra{sin}{1992}{1994}{-5.8}  \node[anchor=east, font=\scriptsize, black!60] at (1990-1790,-5.8) {$1992$-$1993$};
  \rotulo{Zona del euro}{-6.2}          \barra{sin}{1999}{2026}{-6.2}  \sigue{black!40}{-6.2}
  % eje
  \draw (0,-6.5) -- (2031-1790,-6.5);
  \foreach \t in {1800,1850,...,2000} { \draw (\t-1790,-6.45) -- (\t-1790,-6.55) node[below, font=\scriptsize] {$\t$}; }
  % leyenda
  \path[con] (0,-7.25) rectangle (8,-7.05);    \node[anchor=west, font=\scriptsize] at (10,-7.15) {con unión política};
  \path[sin] (75,-7.25) rectangle (83,-7.05);  \node[anchor=west, font=\scriptsize] at (85,-7.15) {sin unión política};
  \path[formal] (150,-7.25) rectangle (158,-7.05); \node[anchor=west, font=\scriptsize] at (160,-7.15) {solo formal};
\end{tikzpicture}
