% b4_amo: línea AMO en el plano de la simetría de las perturbaciones y la flexibilidad (bloque 4.2; DE GRAUWE, 2020): por
% encima de la línea, la zona AMO. Estados Unidos por encima y la Unión Europea en su conjunto por debajo (DE GRAUWE, 2020);
% la zona del euro, cerca de la línea, con posición discutida. Una unión presupuestaria desplaza la línea hacia abajo
% (implicación del balance: con seguro común hacen falta menos simetría y menos flexibilidad). Base en anx_linea_amo.
% Generar desde la carpeta del tema: bash Code/generar_figura.sh b4_amo
\begin{tikzpicture}[font=\footnotesize, x=1.5cm, y=1.1cm, >={Stealth[length=2mm]}]
  \draw[->] (0,0) -- (5,0) node[below left] {flexibilidad, $F$};
  \draw[->] (0,0) -- (0,4);
  \node[anchor=south west] at (0,4) {simetría, $S$};
  \draw[black!85, thick] (0.4,3.5) -- (4.2,0.4) node[right] {línea AMO};
  \draw[black!55, thick, dashed] (0.2,2.4) -- (3.0,0.2) node[right, black, align=left, font=\scriptsize] {línea AMO con\\unión presupuestaria};
  \draw[->, black!60] (2.75,1.5) -- (2.2,1.05);
  \node[font=\footnotesize\bfseries, black!70] at (3.7,3.2) {zona AMO};
  \fill (3.4,2.6) circle (1.8pt) node[right] {EE. UU.};
  \fill (0.9,0.9) circle (1.8pt) node[below right] {UE};
  \fill (2.1,1.6) circle (1.8pt) node[left, align=right, font=\scriptsize] {zona del euro\\(posición discutida)};
\end{tikzpicture}
