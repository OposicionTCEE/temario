% anx3_miembros: número de miembros de la zona del euro, 1999-2026, con los países que entraron cada año (anexo III.5.2).
% Fechas de entrada (BCE): once fundadores en 1999; Grecia 2001; Eslovenia 2007; Chipre y Malta 2008; Eslovaquia 2009;
% Estonia 2011; Letonia 2014; Lituania 2015; Croacia 2023; Bulgaria 2026.
% Generar desde la carpeta del tema: bash Code/generar_figura.sh anx3_miembros
\begin{tikzpicture}[font=\footnotesize, x=0.45cm, y=0.32cm, >={Stealth[length=2mm]}]
  % abscisa = año menos 1998; ordenada = número de miembros menos 10
  \foreach \n in {11,13,...,21} { \draw[black!12] (0,\n-10) -- (29,\n-10); }
  \draw[black!85, thick] (1,1) -- (3,1) -- (3,2) -- (9,2) -- (9,3) -- (10,3) -- (10,5) -- (11,5) -- (11,6) -- (13,6) -- (13,7)
                         -- (16,7) -- (16,8) -- (17,8) -- (17,9) -- (25,9) -- (25,10) -- (28,10) -- (28,11) -- (28.8,11);
  \fill (1,1) circle (1.6pt);
  \node[anchor=north west, font=\scriptsize] at (1,0.9) {once fundadores};
  \foreach \x/\y/\pais in {3/2/Grecia, 9/3/Eslovenia, 10/5/{Chipre y Malta}, 11/6/Eslovaquia, 13/7/Estonia,
                           16/8/Letonia, 17/9/Lituania, 25/10/Croacia, 28/11/Bulgaria} {
    \fill (\x,\y) circle (1.4pt);
    \node[anchor=south east, font=\scriptsize] at (\x-0.05,\y+0.05) {\pais};
  }
  % ejes
  \draw[->] (0,0) -- (29.5,0);
  \draw[->] (0,0) -- (0,12);
  \foreach \t in {2000,2005,...,2025} { \draw (\t-1998,0.15) -- (\t-1998,-0.15) node[below] {$\t$}; }
  \foreach \n in {11,13,...,21} { \draw (0.12,\n-10) -- (-0.12,\n-10) node[left] {$\n$}; }
  \node[anchor=south west] at (-1.2,12.6) {número de miembros};
\end{tikzpicture}
