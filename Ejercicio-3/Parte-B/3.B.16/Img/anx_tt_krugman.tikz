% anx_tt_krugman: integración, simetría y línea AMO en la visión de KRUGMAN: TT decreciente, menos o más inclinada que la AMO (anexo I.5.5).
% AMO: de (0,4; 4,4) a (5,2; 0,4). TT1 desde (1,2; 2,2) con pendiente -0,25 (corta la AMO en x = 3,83). TT2 con pendiente -1,3.
% Generar desde la carpeta del tema: bash Code/generar_figura.sh anx_tt_krugman
\begin{tikzpicture}[font=\footnotesize, x=1.4cm, y=1.15cm, >={Stealth[length=2mm]}]
  \draw[->] (0,0) -- (5.9,0) node[below left] {integración comercial};
  \draw[->] (0,0) -- (0,4.9) node[below right] {simetría};
  \draw[black!85, thick] (0.4,4.4) -- (5.2,0.4) node[right] {AMO};
  \draw[black!55, thick] (0.6,2.35) -- (5.3,1.175) node[right] {TT$_1$};
  \draw[black!55, thick, dashed] (0.75,2.785) -- (2.75,0.185) node[right] {TT$_2$};
  \node at (4.4,3.0) {zona AMO};
  \fill (1.2,2.2) circle (1.6pt) node[above right] {UE-27};
  \fill (3.83,1.543) circle (1.6pt);
\end{tikzpicture}
