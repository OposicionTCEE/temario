% anx_calmfors: presión salarial según el grado de centralización de la negociación: relación monótona (BRUNO y SACHS, 1985) y en forma de joroba (CALMFORS y DRIFFILL, 1988) (anexo I.7.1).
% Generar desde la carpeta del tema: bash Code/generar_figura.sh anx_calmfors
\begin{tikzpicture}[font=\footnotesize, x=1.6cm, y=1.2cm]
  \draw[->] (0,0) -- (6.4,0) node[below left] {centralización de la negociación};
  \draw[->] (0,0) -- (0,4.2) node[below right] {presión salarial};
  \draw[black!85, thick, domain=0.6:5.6, samples=60] plot (\x, {3.3-0.088*(\x-3.1)*(\x-3.1)*4});
  \draw[black!50, thick, dashed] (0.6,3.3) -- (5.6,1.1);
  \node[anchor=south, black!85] at (3.1,3.32) {CALMFORS y DRIFFILL (1988)};
  \node[anchor=north east, black!55] at (5.6,1.05) {BRUNO y SACHS (1985)};
  \foreach \x/\t in {0.6/empresa, 3.1/sector, 5.6/nación}{
    \draw (\x,0.06) -- (\x,-0.06) node[below] {\t};
  }
\end{tikzpicture}
