% anx_umbral: beneficios y costes de la unión según la apertura y umbral phi* (anexo I.5.1). B = 2,4 phi; C = 2,2 - 1,6 phi; phi* = 0,55.
% Generar desde la carpeta del tema: bash Code/generar_figura.sh anx_umbral
\begin{tikzpicture}[font=\footnotesize, x=8cm, y=1.7cm, >={Stealth[length=2mm]}]
  \draw[->] (0,0) -- (1.08,0) node[below left] {apertura hacia los socios, $\phi$};
  \draw[->] (0,0) -- (0,2.75) node[below right] {beneficios y costes, en proporción del PIB};
  \draw[black!85, thick] (0,0) -- (1,2.4) node[right] {$B(\phi)$};
  \draw[black!55, thick] (0,2.2) -- (1,0.6) node[right] {$C(\phi)$};
  \draw[black!40, densely dotted] (0.55,0) -- (0.55,1.32);
  \fill (0.55,1.32) circle (1.6pt);
  \node[below] at (0.55,0) {$\phi^*$};
  \node[below] at (0,0) {$0$};
  \node[below] at (1,0) {$1$};
  \node[align=center, font=\scriptsize] at (0.27,0.35) {moneda propia:\\$C>B$};
  \node[align=center, font=\scriptsize] at (0.8,0.35) {unión:\\$B>C$};
\end{tikzpicture}
