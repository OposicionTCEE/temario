% b3_aspa_oferta: perturbación común de oferta (subida del precio del petróleo) con instituciones laborales distintas
% (bloque 3.2; BRUNO y SACHS, 1985; CALMFORS y DRIFFILL, 1988): la oferta sube poco donde la negociación está centralizada
% (OA' : p = y + 0,1; E1 = (2,2; 2,3)) y mucho donde se negocia por sectores (OA*' : p = y + 0,7; E1* = (1,9; 2,6)).
% Base común en b3_aspa_choque (oferta p = y - 0,5; demanda p = 4,5 - y; E0 = (2,5; 2,0)). Base del anexo en anx_oferta_comun.
% Generar desde la carpeta del tema: bash Code/generar_figura.sh b3_aspa_oferta
\begin{tikzpicture}[font=\footnotesize, x=1.15cm, y=0.95cm, >={Stealth[length=2mm]}]
  % negociación centralizada
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (2.5,4.65) {Negociación centralizada};
    \draw[->] (0,0) -- (5,0) node[below left] {$y$};
    \draw[->] (0,0) -- (0,4.3) node[left] {$p$};
    \draw[black!85, thick] (0.9,0.4) -- (4.2,3.7) node[right] {$OA$};
    \draw[black!60, thick] (0.3,0.4) -- (3.6,3.7) node[left] {$OA'$};
    \draw[black!85, thick] (0.8,3.7) -- (4.0,0.5) node[right] {$DA$};
    \draw[->, black!70] (3.5,3.02) -- (3.5,3.55);
    \draw[black!35, densely dotted] (2.5,0) -- (2.5,2.0);
    \draw[black!35, densely dotted] (2.2,0) -- (2.2,2.3);
    \fill (2.5,2.0) circle (1.5pt) node[right=1pt] {$E_0$};
    \fill (2.2,2.3) circle (1.5pt) node[left=1pt] {$E_1$};
    \node[below] at (2.2,0) {$y_1$}; \node[below] at (2.55,0) {$y_0$};
  \end{scope}
  % negociación por sectores
  \begin{scope}[xshift=6.8cm]
    \node[font=\footnotesize\bfseries] at (2.5,4.65) {Negociación por sectores};
    \draw[->] (0,0) -- (5,0) node[below left] {$y^*$};
    \draw[->] (0,0) -- (0,4.3) node[left] {$p^*$};
    \draw[black!85, thick] (0.9,0.4) -- (4.2,3.7) node[right] {$OA^*$};
    \draw[black!60, thick] (0.1,0.8) -- (3.1,3.8) node[left] {$OA^{*\prime}$};
    \draw[->, black!70] (3.5,3.02) -- (3.5,4.15);
    \draw[black!85, thick] (0.8,3.7) -- (4.0,0.5) node[right] {$DA^*$};
    \draw[black!35, densely dotted] (2.5,0) -- (2.5,2.0);
    \draw[black!35, densely dotted] (1.9,0) -- (1.9,2.6);
    \fill (2.5,2.0) circle (1.5pt) node[right=1pt] {$E_0^*$};
    \fill (1.9,2.6) circle (1.5pt) node[left=1pt] {$E_1^*$};
    \node[below] at (1.9,0) {$y_1^*$}; \node[below] at (2.5,0) {$y_0^*$};
  \end{scope}
\end{tikzpicture}
