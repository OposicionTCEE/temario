% anx_devaluacion_fiscal: esquema de una devaluación fiscal (FARHI, GOPINATH e ITSKHOKI, 2014) (anexo I.6.2).
% Generar desde la carpeta del tema: bash Code/generar_figura.sh anx_devaluacion_fiscal
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=2mm]},
  caja/.style={draw=black!60, rounded corners=2pt, align=center, inner sep=5pt, text width=5.2cm}]
  \node[caja, fill=black!6] (iva) at (0,0) {\textbf{Sube el IVA}\\grava los bienes propios y los importados que se consumen en el país; no grava las exportaciones};
  \node[caja, fill=black!6] (cot) at (7.2,0) {\textbf{Bajan las cotizaciones sociales}\\baja el coste de producir en el país};
  \node[caja] (int) at (0,-2.4) {en el país: los importados se encarecen frente a los propios};
  \node[caja] (ext) at (7.2,-2.4) {fuera: las exportaciones se abaratan};
  \node[caja, fill=black!12, text width=9.8cm] (res) at (3.6,-4.5) {\textbf{Los bienes propios se abaratan frente a los extranjeros, dentro y fuera, sin tocar el tipo de cambio: los mismos efectos reales que una devaluación, si los salarios no reaccionan}};
  \draw[->, black!60] (iva) -- (int);
  \draw[->, black!60] (cot) -- (int);
  \draw[->, black!60] (cot) -- (ext);
  \draw[->, black!60] (int) -- (res);
  \draw[->, black!60] (ext) -- (res);
\end{tikzpicture}
