% anx_clu: costes laborales unitarios relativos estilizados de los países con auge y sin auge, antes y después de la crisis (anexo I.7.5).
% Con auge: de 100 a 115 hasta la crisis (t = 8) y vuelta a 105. Sin auge: de 100 a 92 y ligera subida a 94.
% Generar desde la carpeta del tema: bash Code/generar_figura.sh anx_clu
\begin{tikzpicture}[font=\footnotesize, x=0.82cm, y=0.22cm]
  \draw[->] (0,85) -- (15,85) node[below left] {tiempo};
  \draw[->] (0,85) -- (0,120) node[below right] {coste laboral unitario relativo};
  \draw[black!40] (0,100) -- (14.5,100);
  \node[left] at (0,100) {$100$};
  \draw[black!85, thick] plot[smooth] coordinates {(0,100) (2,103) (4,107) (6,111) (8,115) (10,111) (12,107) (14,105)};
  \draw[black!50, thick, dashed] plot[smooth] coordinates {(0,100) (2,98) (4,95.5) (6,93.5) (8,92) (10,92.6) (12,93.4) (14,94)};
  \draw[black!40, densely dotted] (8,85) -- (8,118);
  \node[below] at (8,85) {crisis};
  \node[anchor=west, black!85] at (14.1,105) {países con auge};
  \node[anchor=west, black!55] at (14.1,94) {países sin auge};
  \node[align=center, font=\scriptsize] at (11,116.5) {devaluación\\interna};
\end{tikzpicture}
