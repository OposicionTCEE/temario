% b3_bucle: bucle entre los bancos y su Estado en una unión incompleta y asimetría del respaldo: el Eurosistema da
% liquidez a los bancos (saldos TARGET), pero no es prestamista del Estado (bloque 3.3; BRUNNERMEIER et al., 2016;
% FARHI y TIROLE, 2018; DE GRAUWE, 2020). Base en anx_bucle (anexo I.8.4), que muestra el ciclo completo.
% Generar desde la carpeta del tema: bash Code/generar_figura.sh b3_bucle
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=2.2mm]},
    caja/.style={draw=black!70, rounded corners=2pt, fill=black!6, align=center, text width=2.9cm, minimum height=1.1cm, inner sep=3pt},
    banco/.style={draw=black!85, thick, rounded corners=2pt, fill=black!14, align=center, text width=2.9cm, minimum height=1.1cm, inner sep=3pt}]
  \node[banco] (E) at (-3.6,0) {Estado};
  \node[banco] (B) at (3.6,0) {bancos del país};
  \node[caja] (S) at (0,3.0) {Eurosistema};
  \node[caja] (A) at (0,-2.6) {crédito y actividad};
  % bucle entre el Estado y sus bancos
  \draw[->, thick, black!80] (E.north east) to[out=25, in=155] node[above, align=center, font=\scriptsize] {su deuda pierde valor:\\los bancos pierden capital} (B.north west);
  \draw[->, thick, black!80] (B.west) -- node[below, font=\scriptsize] {rescates: más deuda pública} (E.east);
  \draw[->, thick, black!80] (B.south) to[out=-90, in=0] node[below right, font=\scriptsize] {menos crédito} (A.east);
  \draw[->, thick, black!80] (A.west) to[out=180, in=-90] node[below left, font=\scriptsize, align=right] {menos ingresos\\y más déficit} (E.south);
  % respaldo asimétrico
  \draw[->, thick, black!60] (S.east) to[out=0, in=90] node[above right, font=\scriptsize, align=left, text=black] {liquidez a los bancos\\(saldos TARGET)} (B.north);
  \draw[->, thick, black!40, dashed] (S.west) to[out=180, in=90] coordinate[pos=0.5] (X) node[above left, font=\scriptsize, align=right, text=black] {sin prestamista\\para el Estado} (E.north);
  \node[font=\large, black!75] at (X) {$\times$};
\end{tikzpicture}
