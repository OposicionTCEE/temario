% anx_bucle: bucle entre los bancos y su Estado en una unión monetaria incompleta (anexo I.8.4).
% Ciclo: prima soberana -> pérdidas de los bancos en deuda de su Estado -> crédito y actividad -> ingresos públicos y rescates esperados -> prima soberana.
% Entrada lateral: salida de depósitos y de financiación mayorista hacia bancos de otros miembros.
% Generar desde la carpeta del tema: bash Code/generar_figura.sh anx_bucle
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=2.2mm]},
    caja/.style={draw=black!70, rounded corners=2pt, fill=black!6, align=center, text width=3.6cm, minimum height=1.05cm, inner sep=3pt},
    lateral/.style={draw=black!50, dashed, rounded corners=2pt, align=center, text width=3.2cm, minimum height=1.05cm, inner sep=3pt}]
  \node[caja] (A) at (0,2.3) {prima de la deuda\\del Estado $\uparrow$};
  \node[caja] (B) at (4.6,0) {pérdidas de los bancos\\en deuda de su Estado};
  \node[caja] (C) at (0,-2.3) {crédito $\downarrow$\\actividad $\downarrow$};
  \node[caja] (D) at (-4.6,0) {ingresos públicos $\downarrow$\\rescates esperados $\uparrow$};
  \node[lateral] (E) at (4.6,3.35) {salida de depósitos y de\\financiación mayorista};
  \coordinate (X) at (6.0,0);
  \draw[->, thick, black!75] (A.east) to[out=0, in=90] (B.north);
  \draw[->, thick, black!75] (B.south) to[out=-90, in=0] (C.east);
  \draw[->, thick, black!75] (C.west) to[out=180, in=-90] (D.south);
  \draw[->, thick, black!75] (D.north) to[out=90, in=180] (A.west);
  \draw[->, black!55, dashed] (A.north east) to[out=40, in=180] (E.west);
  \draw[->, black!55, dashed] (E.south -| X) -- (B.north -| X);
\end{tikzpicture}
