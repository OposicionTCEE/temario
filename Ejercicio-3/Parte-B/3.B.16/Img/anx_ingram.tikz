% anx_ingram: perturbación temporal de la renta y consumo alisado con mercados financieros integrados (anexo I.2.4).
% Renta: 2 hasta t = 3, baja a 1,2 entre 3,5 y 5,5, vuelve a 2 en t = 6. Consumo con integración: 1,85 desde t = 3.
% Generar desde la carpeta del tema: bash Code/generar_figura.sh anx_ingram
\begin{tikzpicture}[font=\footnotesize, x=1.2cm, y=1.5cm, >={Stealth[length=2mm]}]
  % áreas: endeudamiento exterior (c > y) y devolución (y > c)
  \fill[black!18] (3,2) -- (3.5,1.2) -- (5.5,1.2) -- (5.906,1.85) -- (3.094,1.85) -- cycle;
  \fill[black!7] (5.906,1.85) -- (6,2) -- (10,2) -- (10,1.85) -- cycle;
  \draw[->] (0,0) -- (10.6,0) node[below left] {tiempo};
  \draw[->] (0,0) -- (0,2.55);
  \draw[black!85, thick] (0,2) -- (3,2) -- (3.5,1.2) -- (5.5,1.2) -- (6,2) -- (10,2);
  \draw[black!85, thick, dashed] (0,2) -- (3,2) -- (3,1.85) -- (10,1.85);
  \node[above] at (1.5,2) {renta, $y$, y consumo, $c$};
  \node[below] at (4.5,1.2) {renta, $y$};
  \node[above, align=center] at (8,2) {consumo con mercados integrados, $c$};
  \node[align=center, font=\scriptsize] at (4.5,1.55) {endeudamiento exterior};
  \node[font=\scriptsize, anchor=north] at (8,1.84) {devolución};
  \node[left] at (0,2) {$\bar y$};
  \draw[black!40, densely dotted] (3,0) -- (3,1.85);
  \node[below] at (3,0) {$t_0$};
\end{tikzpicture}
