% anx_mundell_ajuste: ajuste por salarios tras la perturbación asimétrica (anexo I.2.1).
% País propio: la OA baja 0,899 hasta cortar DA1 en y0 = 3,18 (p = 1,548). Socio: la OA* sube 0,90 hasta cortar DA*1 en y0 (p* = 3,348).
% Generar desde la carpeta del tema: bash Code/generar_figura.sh anx_mundell_ajuste
\begin{tikzpicture}[font=\footnotesize, x=1cm, y=1cm, >={Stealth[length=2mm]}]
  % ---------- país propio ----------
  \begin{scope}
    \node[anchor=south] at (3,5.1) {País propio};
    \draw[->] (0,0) -- (6.2,0) node[below left] {$y$};
    \draw[->] (0,0) -- (0,5.1) node[below left] {$p$};
    \draw[black!40, thick, dashed] (1.0,0.8) -- (5.5,4.2) node[right] {OA$_0$};
    \draw[black!85, thick] (1.2,0.052) -- (5.5,3.30) node[right] {OA$_1$};
    \draw[black!85, thick] (0.8,3.1) -- (5.0,0.361) node[right] {DA$_1$};
    \draw[->, black!60] (4.6,3.6) -- (4.85,2.85) node[midway, right] {$w\downarrow$};
    \draw[black!40, densely dotted] (3.18,0) -- (3.18,1.548) -- (0,1.548);
    \fill (2.541,1.964) circle (1.6pt) node[above=2pt] {$E_1$};
    \fill (3.18,1.548) circle (1.6pt) node[below=2pt] {$E_2$};
    \node[below] at (3.18,0) {$y_0$};
    \node[left] at (0,1.548) {$p_2$};
  \end{scope}
  % ---------- país socio ----------
  \begin{scope}[xshift=7.6cm]
    \node[anchor=south] at (3,5.1) {País socio};
    \draw[->] (0,0) -- (6.2,0) node[below left] {$y^*$};
    \draw[->] (0,0) -- (0,5.1) node[below left] {$p^*$};
    \draw[black!40, thick, dashed] (1.0,0.8) -- (5.5,4.2) node[right] {OA$^*_0$};
    \draw[black!85, thick] (1.0,1.70) -- (5.0,4.72) node[right] {OA$^*_1$};
    \draw[black!85, thick] (0.8,4.9) -- (5.4,1.9) node[right] {DA$^*_1$};
    \draw[->, black!60] (2.3,1.75) -- (2.05,2.45) node[midway, left] {$w^*\uparrow$};
    \draw[black!40, densely dotted] (3.18,0) -- (3.18,3.348) -- (0,3.348);
    \fill (3.82,2.931) circle (1.6pt) node[below=2pt] {$E^*_1$};
    \fill (3.18,3.348) circle (1.6pt) node[above=2pt] {$E^*_2$};
    \node[below] at (3.18,0) {$y^*_0$};
    \node[left] at (0,3.348) {$p^*_2$};
  \end{scope}
\end{tikzpicture}
