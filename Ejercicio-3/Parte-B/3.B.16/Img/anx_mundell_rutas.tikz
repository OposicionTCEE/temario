% anx_mundell_rutas: la misma depreciación real por tres vías (anexo I.2.1).
% Demanda de bienes propios en desviaciones: y^d = eta q - epsilon, con eta = 0,5 y epsilon = 1 (q necesario = 2).
% Generar desde la carpeta del tema: bash Code/generar_figura.sh anx_mundell_rutas
\begin{tikzpicture}[font=\footnotesize, x=1.45cm, y=1.45cm, >={Stealth[length=2mm]}]
  \draw[->] (-0.7,0) -- (4.3,0) node[below left] {$q$};
  \draw[->] (0,-1.75) -- (0,2.15) node[below left] {$y^d$};
  \draw[black!40, thick, dashed] (-0.6,-0.3) -- (3.9,1.95) node[right] {$y^d=\eta\,q$};
  \draw[black!85, thick] (-0.6,-1.3) -- (3.9,0.95) node[right] {$y^d=\eta\,q-\varepsilon$};
  \draw[->, black!60] (0,-0.08) -- (0,-0.92);
  \node[left, black!70] at (0,-0.5) {$\varepsilon$};
  \draw[->, thick] (0.12,-0.94) -- (1.9,-0.05);
  \node[below right, align=left] at (1.05,-0.62) {$\Delta q=\varepsilon/\eta$:\\$s\uparrow$, $p\downarrow$ o $p^*\uparrow$};
  \draw[black!40, densely dotted] (2,0) -- (2,0.25);
  \fill (0,0) circle (1.6pt) node[above left] {$A$};
  \fill (0,-1) circle (1.6pt) node[below left] {$B$};
  \fill (2,0) circle (1.6pt) node[above left] {$C$};
\end{tikzpicture}
