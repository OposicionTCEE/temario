% anx_kenen: varianza de la perturbación agregada relativa a la sectorial con n sectores de igual peso: rho + (1 - rho)/n (anexo I.2.3).
% Generar desde la carpeta del tema: bash Code/generar_figura.sh anx_kenen
\begin{tikzpicture}[font=\footnotesize]
  \begin{axis}[width=10.5cm, height=6.2cm, xmin=1, xmax=20, ymin=0, ymax=1.08,
    axis lines=left, xlabel={número de sectores de igual peso, $n$}, ylabel={varianza del agregado / varianza sectorial},
    label style={font=\footnotesize}, tick label style={font=\footnotesize},
    xtick={1,4,8,12,16,20}, xticklabels={$1$,$4$,$8$,$12$,$16$,$20$},
    ytick={0,0.3,0.5,1}, yticklabels={$0$,$0{,}3$,$0{,}5$,$1$}, clip=false]
    \addplot[black!85, thick, domain=1:20, samples=80] {1/x} node[pos=1, right] {$\rho=0$};
    \addplot[black!55, thick, dashed, domain=1:20, samples=80] {0.3+0.7/x} node[pos=1, right] {$\rho=0{,}3$};
    \addplot[black!35, densely dotted, domain=1:20] {0.3};
    \addplot[only marks, mark=*, mark size=1.4pt, black!85] coordinates {(1,1) (2,0.5) (4,0.25) (8,0.125) (16,0.0625)};
  \end{axis}
\end{tikzpicture}
