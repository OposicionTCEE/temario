% anx_sapir: equilibrio entre flexibilidad y unión presupuestaria según la naturaleza de las perturbaciones (anexo I.5.4).
% (a) permanentes: línea casi vertical; (b) temporales: línea casi horizontal. Unión de partida en (1,2; 0,8).
% Generar desde la carpeta del tema: bash Code/generar_figura.sh anx_sapir
\begin{tikzpicture}[font=\footnotesize, x=1.15cm, y=1.0cm, >={Stealth[length=2mm]}]
  \begin{scope}
    \node[anchor=south] at (2.6,4.75) {(a) Perturbaciones sobre todo permanentes};
    \draw[->] (0,0) -- (5.4,0) node[below left] {flexibilidad};
    \draw[->] (0,0) -- (0,4.7) node[below right] {unión presupuestaria};
    \draw[black!85, thick] (2.0,4.1) -- (2.6,0.3) node[right] {línea AMO};
    \node at (4.0,2.8) {zona AMO};
    \fill (1.2,0.8) circle (1.6pt) node[below left] {unión};
    \draw[->, black!60] (1.28,0.8) -- (2.45,0.8);
    \draw[->, black!60] (1.2,0.88) -- (1.2,3.9);
  \end{scope}
  \begin{scope}[xshift=7.2cm]
    \node[anchor=south] at (2.6,4.75) {(b) Perturbaciones sobre todo temporales};
    \draw[->] (0,0) -- (5.4,0) node[below left] {flexibilidad};
    \draw[->] (0,0) -- (0,4.7) node[below right] {unión presupuestaria};
    \draw[black!85, thick] (0.3,1.75) -- (5.0,1.05) node[above] {línea AMO};
    \node at (3.6,3.0) {zona AMO};
    \fill (1.2,0.8) circle (1.6pt) node[below left] {unión};
    \draw[->, black!60] (1.2,0.88) -- (1.2,1.55);
    \draw[->, black!60] (1.28,0.8) -- (4.85,0.8);
  \end{scope}
\end{tikzpicture}
