% anx3_fases: fases del pensamiento sobre la integración monetaria, sus preguntas y los hechos que las motivaron, 1944-2026 (anexo III.1).
% Las dos olas son las de la estructura de la Introducción; las cuatro primeras fases agrupan las de MONGELLI (2002).
% Generar desde la carpeta del tema: bash Code/generar_figura.sh anx3_fases
\begin{tikzpicture}[font=\footnotesize, x=0.17cm, y=1cm, >={Stealth[length=2mm]}]
  % fases: bloques sobre el eje (abscisa = año menos 1940)
  \foreach \ini/\fin/\tono/\nombre/\pregunta in {
      1944/1960/7/Antecedentes/{¿tipos fijos o flexibles?},
      1961/1975/15/Criterios/{¿qué área es óptima?},
      1976/1988/7/Credibilidad/{¿cuánto vale la política propia?},
      1989/2009/15/{Maastricht y endogeneidad}/{¿es Europa un área óptima?},
      2010/2026/7/{Fragilidad y completitud}/{¿qué necesita una unión para durar?}}{
    \pgfmathsetmacro{\ancho}{(\fin-\ini+1)*0.17-0.2}
    \fill[black!\tono] (\ini-1940,0.15) rectangle (\fin-1940+1,1.75);
    \node[anchor=north, text width=\ancho cm, align=center, font=\scriptsize] at ({(\ini+\fin+1)/2-1940},1.68) {\textbf{\nombre}\\[2pt] \pregunta};
  }
  % las dos olas
  \draw[decorate, decoration={brace, amplitude=4pt}] (1961-1940,1.85) -- (1975-1940+1,1.85) node[midway, above=4pt, font=\scriptsize] {primera ola};
  \draw[decorate, decoration={brace, amplitude=4pt}] (1989-1940,1.85) -- (2026-1940+1,1.85) node[midway, above=4pt, font=\scriptsize] {segunda ola};
  % eje del tiempo
  \draw[->] (0,0) -- (2030-1940,0);
  \foreach \t in {1940,1950,...,2020} {
    \draw (\t-1940,0.06) -- (\t-1940,-0.06);
    \node[anchor=north, font=\scriptsize] at (\t-1940,-0.08) {$\t$};
  }
  % hechos
  \foreach \a/\hecho in {1944/Bretton Woods, 1957/Tratado de Roma, 1970/Informe WERNER, 1973/fin de Bretton Woods, 1979/SME,
                         1989/Informe DELORS, 1992/Maastricht, 1999/euro, 2010/crisis de la deuda, 2012/OMT, 2020/NGEU} {
    \fill (\a-1940,0) circle (1.4pt);
    \draw[black!35, densely dotted] (\a-1940,0) -- (\a-1940,-0.45);
    \node[rotate=90, anchor=east, font=\scriptsize] at (\a-1940,-0.48) {\hecho};
  }
\end{tikzpicture}
