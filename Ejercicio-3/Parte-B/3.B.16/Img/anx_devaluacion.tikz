% anx_devaluacion: una devaluación frente a una perturbación permanente y su erosión por los costes y los salarios (anexo I.3.2).
% Bases del modelo de dos países: OA0: y = 0,0444 + 0,7556 x; DA0: y = 4 - 0,6522 (x - 0,8); DA1 = DA0 - 0,9; OA1 = OA0 + 0,6.
% E0 = (3,18; 2,448), E1 = (2,541; 1,964), E2 = (2,754; 2,725).
% Generar desde la carpeta del tema: bash Code/generar_figura.sh anx_devaluacion
\begin{tikzpicture}[font=\footnotesize, x=1.15cm, y=1.15cm, >={Stealth[length=2mm]}]
  \draw[->] (0,0) -- (6.4,0) node[below left] {$y$};
  \draw[->] (0,0) -- (0,5.0) node[below left] {$p$};
  \draw[black!85, thick] (1.0,0.8) -- (5.5,4.2) node[right] {OA$_0$};
  \draw[black!85, thick, dashed] (0.6,1.10) -- (5.0,4.42) node[right] {OA$_1$};
  \draw[black!85, thick] (0.8,4.0) -- (5.4,1.0) node[right] {DA$_0$};
  \draw[black!40, thick, dashed] (0.8,3.1) -- (5.0,0.361) node[right] {DA$_1$};
  \draw[->, black!60] (4.15,1.0) -- (4.35,1.75) node[midway, right] {$s\uparrow$};
  \draw[->, black!60] (4.75,3.0) -- (4.45,3.45) node[midway, right=2pt] {$w\uparrow$};
  \draw[black!40, densely dotted] (3.18,0) -- (3.18,2.448);
  \draw[black!40, densely dotted] (2.754,0) -- (2.754,2.725);
  \draw[black!40, densely dotted] (2.541,0) -- (2.541,1.964);
  \fill (3.18,2.448) circle (1.6pt) node[below=2pt] {$E_0$};
  \fill (2.541,1.964) circle (1.6pt) node[below=2pt] {$E_1$};
  \fill (2.754,2.725) circle (1.6pt) node[above=2pt] {$E_2$};
  \node[below] at (3.25,0) {$y_0$};
  \node[below] at (2.48,0) {$y_1$};
  \node[below] at (2.87,0) {$y_2$};
\end{tikzpicture}
