% anx_rigidez_baja: salario de pleno empleo y salario efectivo con rigidez salarial a la baja en un auge y su final (SCHMITT-GROHÉ y URIBE, 2016) (anexo I.6.3).
% Salario de pleno empleo: sube de 2 a 3,4 en el auge (t = 1 a 5) y cae a 2,2 tras la crisis (t = 5 a 6). Salario efectivo: sigue al de pleno empleo en el auge y después solo baja un poco.
% Generar desde la carpeta del tema: bash Code/generar_figura.sh anx_rigidez_baja
\begin{tikzpicture}[font=\footnotesize, x=1.15cm, y=1.35cm, >={Stealth[length=2mm]}]
  \fill[black!14] (5,3.4) -- (6,3.3) -- (11,3.05) -- (11,2.2) -- (6,2.2) -- cycle;
  \draw[->] (0,0) -- (11.6,0) node[below left] {tiempo};
  \draw[->] (0,0) -- (0,4.1) node[below right] {salario real};
  \draw[black!55, thick, dashed] (0,2) -- (1,2) -- (5,3.4) -- (6,2.2) -- (11,2.2);
  \draw[black!85, thick] (0,2) -- (1,2) -- (5,3.4) -- (11,3.05);
  \node[above, black!85] at (8.4,3.25) {salario efectivo};
  \node[below, black!55] at (8.4,2.15) {salario de pleno empleo};
  \node[align=center, font=\scriptsize] at (8.4,2.65) {desempleo involuntario};
  \draw[black!40, densely dotted] (1,0) -- (1,2);
  \draw[black!40, densely dotted] (5,0) -- (5,3.4);
  \node[below] at (3,0) {auge};
  \node[below] at (8,0) {fin del auge};
\end{tikzpicture}
