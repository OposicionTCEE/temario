% b3_umbral: balance de la unión en función de la integración con los socios: B(phi) crece y C(phi) decrece; completar la
% unión baja la curva de costes y el umbral de apertura (bloque 3.4; KRUGMAN, 1990; DE GRAUWE, 2020). Misma base que
% b2_beneficios (B = phi). C incompleta = 0,85 - 0,6 phi (umbral 0,53125); C completa = 0,55 - 0,5 phi (umbral 0,36667).
% Base en anx_umbral y anx_completitud_coste (anexo I.5.1 y I.5.2). Figura abstracta, sin datos.
% Generar desde la carpeta del tema: bash Code/generar_figura.sh b3_umbral
\begin{tikzpicture}[font=\footnotesize, x=11cm, y=4.2cm, >={Stealth[length=2mm]}]
  \fill[black!8] (0.36667,0) rectangle (0.53125,0.62);
  \draw[->] (0,0) -- (1.08,0);
  \node[anchor=north east] at (1.08,-0.14) {comercio con los socios en proporción del PIB, $\phi$};
  \draw[->] (0,0) -- (0,1.15);
  \node[anchor=south west] at (0,1.15) {beneficios y costes};
  \draw[black!85, thick] (0,0) -- (1,1) node[right] {$B(\phi)$};
  \draw[black!85, thick] (0,0.85) -- (1,0.25) node[right] {$C(\phi)$, unión incompleta};
  \draw[black!55, thick, dashed] (0,0.55) -- (1,0.05) node[right, black] {$C(\phi)$, unión completa};
  \foreach \x/\t in {0.36667/{\phi^*_c}, 0.53125/{\phi^*_i}} {
    \draw[black!40, densely dotted] (\x,0) -- (\x,\x);
    \fill (\x,\x) circle (1.5pt);
    \node[below] at (\x,0) {$\t$};
  }
  \draw[->, black!70, thick] (0.525,0.07) -- (0.374,0.07);
  \node[anchor=south, font=\scriptsize, align=center] at (0.449,0.09) {completar la unión\\baja el umbral};
  \node[anchor=north west, align=left, font=\scriptsize] at (0.05,1.12) {$\phi^*_i$: umbral de una unión incompleta\\$\phi^*_c$: umbral de una unión completa\\en gris, países a los que la unión solo les compensa si se completa};
\end{tikzpicture}
