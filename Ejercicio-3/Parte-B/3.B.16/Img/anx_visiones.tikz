% anx_visiones: la curva de costes según la visión monetarista y la keynesiana (anexo I.5.1).
% B = 2,4 phi. Monetarista: C = 0,6 - 0,5 phi (phi* = 0,207). Keynesiana: C = 3,2 - 1,2 phi (phi* = 0,889).
% Generar desde la carpeta del tema: bash Code/generar_figura.sh anx_visiones
\begin{tikzpicture}[font=\footnotesize, x=6cm, y=1.35cm, >={Stealth[length=2mm]}]
  \begin{scope}
    \node[anchor=south] at (0.5,3.35) {(a) Visión monetarista};
    \draw[->] (0,0) -- (1.1,0) node[below left] {$\phi$};
    \draw[->] (0,0) -- (0,3.3);
    \draw[black!85, thick] (0,0) -- (1,2.4) node[right] {$B$};
    \draw[black!55, thick] (0,0.6) -- (1,0.1) node[right] {$C$};
    \draw[black!40, densely dotted] (0.207,0) -- (0.207,0.497);
    \fill (0.207,0.497) circle (1.6pt);
    \node[below] at (0.207,0) {$\phi^*$};
  \end{scope}
  \begin{scope}[xshift=8cm]
    \node[anchor=south] at (0.5,3.35) {(b) Visión keynesiana};
    \draw[->] (0,0) -- (1.1,0) node[below left] {$\phi$};
    \draw[->] (0,0) -- (0,3.3);
    \draw[black!85, thick] (0,0) -- (1,2.4) node[right] {$B$};
    \draw[black!55, thick] (0,3.2) -- (1,2.0) node[right] {$C$};
    \draw[black!40, densely dotted] (0.889,0) -- (0.889,2.133);
    \fill (0.889,2.133) circle (1.6pt);
    \node[below] at (0.889,0) {$\phi^*$};
  \end{scope}
\end{tikzpicture}
