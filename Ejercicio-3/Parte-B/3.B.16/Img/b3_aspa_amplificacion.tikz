% b3_aspa_amplificacion: amplificación de la perturbación asimétrica cuando los inversores desconfían (bloque 3.3; DE GRAUWE,
% 2011, 2020): tras la perturbación (DA', DA*'), la prima sube en el país en recesión y baja en el refugio, y las demandas
% se desplazan otra vez (discontinuo): DA'' : p = 2,9 - y, E2 = (1,7; 1,2); DA*'' : p = 6,1 - y, E2* = (3,3; 2,8).
% Base común en b3_aspa_choque (oferta p = y - 0,5; demanda p = 4,5 - y; E0 = (2,5; 2,0)). Base del anexo en anx_amplificacion.
% Generar desde la carpeta del tema: bash Code/generar_figura.sh b3_aspa_amplificacion
\begin{tikzpicture}[font=\footnotesize, x=1.05cm, y=0.95cm, >={Stealth[length=2mm]}]
  % país en recesión
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (2.8,4.65) {País en recesión};
    \draw[->] (0,0) -- (5.6,0) node[below left] {$y$};
    \draw[->] (0,0) -- (0,4.3) node[left] {$p$};
    \draw[black!85, thick] (0.9,0.4) -- (4.2,3.7) node[right] {$OA$};
    \draw[black!85, thick] (0.8,3.7) -- (4.0,0.5) node[right] {$DA$};
    \draw[black!60, thick] (0.4,3.3) -- (3.2,0.5) node[below] {$DA'$};
    \draw[black!60, thick, dashed] (0.1,2.8) -- (2.4,0.5) node[below left] {$DA''$};
    \draw[->, black!70, dashed] (2.75,0.95) -- (2.05,0.95);
    \draw[black!35, densely dotted] (2.1,0) -- (2.1,1.6);
    \draw[black!35, densely dotted] (1.7,0) -- (1.7,1.2);
    \fill (2.5,2.0) circle (1.5pt) node[right=1pt] {$E_0$};
    \fill (2.1,1.6) circle (1.5pt) node[right=1pt] {$E_1$};
    \fill (1.7,1.2) circle (1.5pt) node[left=1pt] {$E_2$};
    \node[below] at (1.7,0) {$y_2$}; \node[below] at (2.15,0) {$y_1$};
  \end{scope}
  % refugio
  \begin{scope}[xshift=7.0cm]
    \node[font=\footnotesize\bfseries] at (2.8,4.65) {Socio que sirve de refugio};
    \draw[->] (0,0) -- (5.6,0) node[below left] {$y^*$};
    \draw[->] (0,0) -- (0,4.3) node[left] {$p^*$};
    \draw[black!85, thick] (0.9,0.4) -- (4.2,3.7) node[left] {$OA^*$};
    \draw[black!85, thick] (0.8,3.7) -- (4.0,0.5) node[below] {$DA^*$};
    \draw[black!60, thick] (1.6,3.7) -- (4.6,0.7) node[below] {$DA^{*\prime}$};
    \draw[black!60, thick, dashed] (2.4,3.7) -- (5.4,0.7) node[right] {$DA^{*\prime\prime}$};
    \draw[->, black!70, dashed] (4.35,0.95) -- (5.05,0.95);
    \draw[black!35, densely dotted] (2.9,0) -- (2.9,2.4);
    \draw[black!35, densely dotted] (3.3,0) -- (3.3,2.8);
    \fill (2.5,2.0) circle (1.5pt) node[left=1pt] {$E_0^*$};
    \fill (2.9,2.4) circle (1.5pt) node[left=1pt] {$E_1^*$};
    \fill (3.3,2.8) circle (1.5pt) node[left=1pt] {$E_2^*$};
    \node[below] at (2.85,0) {$y_1^*$}; \node[below] at (3.3,0) {$y_2^*$};
  \end{scope}
  % leyenda
  \draw[thick, black!60] (1.0,-1.0) -- (1.8,-1.0);
  \node[anchor=west] at (1.9,-1.0) {perturbación asimétrica};
  \draw[thick, black!60, dashed] (1.0,-1.5) -- (1.8,-1.5);
  \node[anchor=west] at (1.9,-1.5) {desconfianza: la prima sube en el país en recesión y baja en el refugio};
\end{tikzpicture}
