% anx_oferta_comun: una perturbación de oferta común con instituciones laborales distintas (anexo I.7.1).
% Base del modelo de dos países: OA0: y = 0,0444 + 0,7556 x; DA: y = 4,5217 - 0,6522 x; E0 = (3,18; 2,448).
% Centralizada: la OA sube 0,5 (E1 = (2,825; 2,679)). Intermedia: la OA sube 1,1 (E1 = (2,399; 2,957)).
% Generar desde la carpeta del tema: bash Code/generar_figura.sh anx_oferta_comun
\begin{tikzpicture}[font=\footnotesize, x=1cm, y=1cm, >={Stealth[length=2mm]}]
  \begin{scope}
    \node[anchor=south] at (3,5.1) {Negociación muy centralizada};
    \draw[->] (0,0) -- (6.2,0) node[below left] {$y$};
    \draw[->] (0,0) -- (0,5.1) node[below left] {$p$};
    \draw[black!40, thick, dashed] (1.0,0.8) -- (5.5,4.2) node[right] {OA$_0$};
    \draw[black!85, thick] (0.8,1.149) -- (4.6,4.020) node[above] {OA$_1$};
    \draw[black!85, thick] (0.8,4.0) -- (5.4,1.0) node[right] {DA};
    \draw[->, black!60] (4.4,3.37) -- (4.2,3.62);
    \draw[black!40, densely dotted] (3.18,0) -- (3.18,2.448);
    \draw[black!40, densely dotted] (2.825,0) -- (2.825,2.679);
    \fill (3.18,2.448) circle (1.6pt) node[below=2pt] {$E_0$};
    \fill (2.825,2.679) circle (1.6pt) node[above=2pt] {$E_1$};
    \node[below] at (3.3,0) {$y_0$};
    \node[below] at (2.72,0) {$y_1$};
  \end{scope}
  \begin{scope}[xshift=7.6cm]
    \node[anchor=south] at (3,5.1) {Negociación intermedia};
    \draw[->] (0,0) -- (6.2,0) node[below left] {$y^*$};
    \draw[->] (0,0) -- (0,5.1) node[below left] {$p^*$};
    \draw[black!40, thick, dashed] (1.0,0.8) -- (5.5,4.2) node[right] {OA$^*_0$};
    \draw[black!85, thick] (0.8,1.749) -- (4.4,4.469) node[right] {OA$^*_1$};
    \draw[black!85, thick] (0.8,4.0) -- (5.4,1.0) node[right] {DA$^*$};
    \draw[->, black!60] (4.4,3.37) -- (3.85,4.0);
    \draw[black!40, densely dotted] (3.18,0) -- (3.18,2.448);
    \draw[black!40, densely dotted] (2.399,0) -- (2.399,2.957);
    \fill (3.18,2.448) circle (1.6pt) node[below=2pt] {$E^*_0$};
    \fill (2.399,2.957) circle (1.6pt) node[above=2pt] {$E^*_1$};
    \node[below] at (3.3,0) {$y^*_0$};
    \node[below] at (2.3,0) {$y^*_1$};
  \end{scope}
\end{tikzpicture}
