% b4_completitud: cuánto baja la curva de costes con la completitud (bloque 4.3; DE GRAUWE, 2020). Misma base que
% b2_beneficios y b3_umbral (eje phi; C de la unión incompleta = 0,85 - 0,6 phi): igual que una nación integra sus mercados
% mucho más que una moneda común (b2_beneficios), baja sus costes mucho más que una unión incompleta. C_u = 0,85 - 0,6 phi
% (unión mínima); C_e = 0,7 - 0,55 phi (zona del euro en 2026, a medio camino); C_n = 0,42 - 0,37 phi (nación).
% Figura abstracta, sin datos. Piezas como en b1_piezas.
% Generar desde la carpeta del tema: bash Code/generar_figura.sh b4_completitud
\begin{tikzpicture}[font=\footnotesize, x=11cm, y=4.2cm, >={Stealth[length=2mm]}]
  \draw[->] (0,0) -- (1.08,0);
  \node[anchor=north east] at (1.08,-0.14) {comercio con los socios en proporción del PIB, $\phi$};
  \draw[->] (0,0) -- (0,1.12) node[below right] {costes de la unión};
  \draw[black!85, thick] (0,0.85) -- (1,0.25) node[right] {$C_u$};
  \draw[black!60, thick, dashed] (0,0.7) -- (1,0.15) node[right] {$C_e$};
  \draw[black!60, thick, densely dotted] (0,0.42) -- (1,0.05) node[right] {$C_n$};
  \draw[->, black!70, thick] (0.3,0.66) -- (0.3,0.545);
  \draw[->, black!70, thick] (0.3,0.525) -- (0.3,0.32);
  \node[anchor=north west, align=left, font=\scriptsize, text width=6.4cm, execute at begin node=\hyphenpenalty=10000] at (0.43,1.1)
    {$C_u$: unión monetaria mínima\\
     $C_e$: zona del euro en 2026\\
     $C_n$: nación\\[3pt]
     de $C_u$ a $C_e$: supervisión y resolución bancarias comunes y respaldo condicionado de la deuda pública\\[2pt]
     de $C_e$ a $C_n$: presupuesto federal, garantía de depósitos común, movilidad del trabajo y prestamista incondicional del Estado};
\end{tikzpicture}
