% b2_reparto: el reparto privado del riesgo en una unión monetaria funciona en calma y se invierte con desconfianza
% (bloque 2.4; MUNDELL, 1973, y DE GRAUWE, 2020). Base en anx:mundell1973 (anexo I.3.6) y anx:ev_reparto (anexo II.3).
% Generar desde la carpeta del tema: bash Code/generar_figura.sh b2_reparto
\begin{tikzpicture}[font=\footnotesize, x=1cm, y=1cm, >={Stealth[length=2.2mm]},
    pais/.style={draw=black!65, fill=black!6, align=center, font=\scriptsize, text width=2.0cm, minimum height=1.3cm}]
  % en calma
  \node[font=\scriptsize\bfseries] at (3.1,2.05) {en calma};
  \node[pais] (p1) at (0.9,0.6) {país propio\\(perturbación\\negativa)};
  \node[pais] (s1) at (5.3,0.6) {socio};
  \draw[<-, black!70, thick] ([yshift=0.3cm]p1.east) -- ([yshift=0.3cm]s1.west) node[midway, above, font=\scriptsize] {rentas de sus activos};
  \draw[<-, black!70, thick] ([yshift=-0.3cm]p1.east) -- ([yshift=-0.3cm]s1.west) node[midway, below, font=\scriptsize] {préstamos};
  \node[align=center, font=\scriptsize] at (3.1,-0.85) {el consumo cae menos que la renta};
  % con desconfianza
  \begin{scope}[xshift=7.6cm]
    \node[font=\scriptsize\bfseries] at (3.1,2.05) {con desconfianza};
    \node[pais] (p2) at (0.9,0.6) {país propio\\(perturbación\\negativa)};
    \node[pais] (s2) at (5.3,0.6) {socio};
    \draw[->, black!70, thick] ([yshift=0.3cm]p2.east) -- ([yshift=0.3cm]s2.west) node[midway, above, font=\scriptsize] {venta de sus activos};
    \draw[->, black!70, thick] ([yshift=-0.3cm]p2.east) -- ([yshift=-0.3cm]s2.west) node[midway, below, font=\scriptsize] {retirada de préstamos};
    \node[align=center, font=\scriptsize] at (3.1,-0.85) {el consumo y el crédito caen más que la renta};
  \end{scope}
  \draw[black!25] (7.1,-1.1) -- (7.1,2.3);
\end{tikzpicture}
