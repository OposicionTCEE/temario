% b1_diferenciales: diferencial estilizado de la deuda pública de un miembro frente al socio más solvente: el riesgo
% cambiario desaparece con el euro y reaparece como riesgo de impago (bloque 1.1). Figura abstracta, sin datos.
% Los datos reales están en anx2_diferenciales (anexo II.5.1).
% Generar desde la carpeta del tema: bash Code/generar_figura.sh b1_diferenciales
\begin{tikzpicture}[font=\footnotesize, x=1cm, y=1cm, >={Stealth[length=2mm]}]
  \draw[->] (0,0) -- (12.8,0) node[below left] {tiempo};
  \draw[->] (0,0) -- (0,5.4);
  \node[anchor=south west] at (-0.4,5.5) {diferencial del tipo de la deuda pública frente al socio más solvente};
  \draw[black!35, densely dotted] (4.2,0) -- (4.2,5.0) node[above, font=\scriptsize, black!60] {moneda común};
  \draw[black!35, densely dotted] (9.7,0) -- (9.7,5.0) node[above, font=\scriptsize, black!60] {prestamista};
  \draw[black!85, thick] plot[smooth, tension=0.55] coordinates {(0.2,3.4) (1.1,3.6) (2.2,3.1) (3.2,1.4) (4.2,0.35) (5.2,0.15) (6.6,0.12) (7.6,0.22) (8.2,1.5) (8.8,4.0) (9.3,4.4) (9.9,3.0) (10.7,1.7) (11.6,1.15) (12.4,1.0)};
  \node[align=center, font=\scriptsize] at (1.6,4.35) {riesgo de\\devaluación};
  \node[align=center, font=\scriptsize] at (3.95,2.35) {convergencia};
  \node[align=center, font=\scriptsize] at (6.2,0.95) {riesgo de impago\\ignorado};
  \node[align=left, font=\scriptsize, anchor=east] at (8.5,4.3) {riesgo de\\impago};
  \node[align=center, font=\scriptsize] at (11.3,2.3) {riesgo\\contenido};
\end{tikzpicture}
