% anx_phillips: dos curvas de PHILLIPS y una inflación común (CORDEN 1972; FLEMING 1971) (anexo I.2.5).
% Propio: pi = 2,4/(u - 0,5) - 0,3, punto preferido u = 4. Socio: pi* = 3,6/(u - 0,5) - 0,1, punto preferido u = 2,5. Inflación común 1.
% Generar desde la carpeta del tema: bash Code/generar_figura.sh anx_phillips
\begin{tikzpicture}[font=\footnotesize, x=1.55cm, y=1.25cm, >={Stealth[length=2mm]}]
  \draw[->] (0,0) -- (6.6,0) node[below left] {desempleo, $u$};
  \draw[->] (0,0) -- (0,3.5) node[below right] {inflación, $\pi$};
  \draw[black!85, thick, domain=1.25:6.2, samples=60] plot (\x, {2.4/(\x-0.5)-0.3}) node[right] {país propio};
  \draw[black!55, thick, domain=1.75:6.2, samples=60] plot (\x, {3.6/(\x-0.5)-0.1}) node[right] {socio};
  \draw[black!45, dashed] (0,1) -- (6.3,1) node[right] {$\bar\pi$};
  \fill (4,0.386) circle (1.6pt) node[below] {$A$};
  \fill (2.5,1.7) circle (1.6pt) node[above right] {$A^*$};
  \fill (2.346,1) circle (1.6pt) node[below left] {$B$};
  \fill (3.773,1) circle (1.6pt) node[above right] {$B^*$};
  \draw[->, black!60, shorten >=3pt, shorten <=3pt] (4,0.386) to[bend left=12] (2.346,1);
  \draw[->, black!60, shorten >=3pt, shorten <=3pt] (2.5,1.7) to[bend left=12] (3.773,1);
\end{tikzpicture}
