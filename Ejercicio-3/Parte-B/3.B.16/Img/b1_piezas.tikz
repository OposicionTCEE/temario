% b1_piezas: las piezas de una unión monetaria, apiladas de la base a la cima, en una unión mínima, en la zona del euro
% en 2026 y en una nación (bloque 1.4). Versión contextualizada de anx_piezas (anexo I.1.4): sin la movilidad del trabajo,
% que se estudia con los costes.
% Generar desde la carpeta del tema: bash Code/generar_figura.sh b1_piezas
\begin{tikzpicture}[font=\footnotesize, x=1cm, y=1cm]
  % capas, de abajo arriba
  \foreach \r/\l in {1/{Moneda y banco central comunes}, 2/{Prestamista de los bancos}, 3/{Supervisión y resolución bancarias},
                     4/{Respaldo de la deuda pública}, 5/{Presupuesto común con transferencias}, 6/{Garantía de depósitos común},
                     7/{Unión política}} {
    \node[anchor=east, align=right, font=\scriptsize] at (3.9,{0.65*(\r-1)+0.275}) {\l};
  }
  % f = la tiene, p = en parte o con condiciones, n = no la tiene
  \foreach \x/\vals in {5.3/{f,f,n,n,n,n,n}, 8.3/{f,f,f,p,p,n,p}, 11.3/{f,f,f,f,f,f,f}} {
    \foreach \v [count=\r] in \vals {
      \pgfmathsetmacro{\y}{0.65*(\r-1)}
      \if f\v \filldraw[fill=black!45, draw=black!60] (\x-1.1,\y) rectangle (\x+1.1,\y+0.55); \fi
      \if p\v \filldraw[fill=black!14, draw=black!60] (\x-1.1,\y) rectangle (\x+1.1,\y+0.55); \fi
      \if n\v \draw[black!40, densely dashed] (\x-1.1,\y) rectangle (\x+1.1,\y+0.55); \fi
    }
  }
  \foreach \x/\t in {5.3/{Unión monetaria\\mínima}, 8.3/{Zona del euro\\($2026$)}, 11.3/{Nación}} {
    \node[anchor=south, align=center, font=\scriptsize\bfseries] at (\x,4.6) {\t};
  }
  % leyenda
  \filldraw[fill=black!45, draw=black!60] (4.2,-0.75) rectangle (4.7,-0.45); \node[anchor=west, font=\scriptsize] at (4.8,-0.6) {la tiene};
  \filldraw[fill=black!14, draw=black!60] (6.4,-0.75) rectangle (6.9,-0.45); \node[anchor=west, font=\scriptsize] at (7.0,-0.6) {en parte o con condiciones};
  \draw[black!40, densely dashed] (10.4,-0.75) rectangle (10.9,-0.45); \node[anchor=west, font=\scriptsize] at (11.0,-0.6) {le falta};
\end{tikzpicture}
