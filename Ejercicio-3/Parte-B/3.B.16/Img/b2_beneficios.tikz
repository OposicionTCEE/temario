% b2_beneficios: los beneficios de la moneda común crecen con el comercio con los socios, B(phi); la moneda común
% desplaza poco al país a lo largo de la curva y la integración de una nación, mucho más (bloque 2.5; KRUGMAN, 1990;
% McCALLUM, 1995; ANDERSON y VAN WINCOOP, 2003). Figura abstracta, sin datos. Base en anx_beneficios (anexo I.4.6).
% Generar desde la carpeta del tema: bash Code/generar_figura.sh b2_beneficios
\begin{tikzpicture}[font=\footnotesize, x=11cm, y=4.2cm, >={Stealth[length=2mm]}]
  \draw[->] (0,0) -- (1.08,0);
  \node[anchor=north east] at (1.08,-0.14) {comercio con los socios en proporción del PIB, $\phi$};
  \draw[->] (0,0) -- (0,1.12) node[below right] {beneficios de la moneda común};
  \draw[black!85, thick] (0,0) -- (1,1) node[right] {$B(\phi)$};
  \foreach \x/\t in {0.18/{\phi_0}, 0.3/{\phi_1}, 0.85/{\phi_n}} {
    \draw[black!35, densely dotted] (\x,0) -- (\x,\x);
    \fill (\x,\x) circle (1.5pt);
    \node[below] at (\x,0) {$\t$};
  }
  \draw[->, black!65, thick] (0.19,0.07) -- (0.29,0.07);
  \draw[->, black!65, thick] (0.31,0.07) -- (0.84,0.07);
  \node[anchor=south, font=\scriptsize] at (0.575,0.09) {lo que añade la integración de una nación};
  \node[anchor=north west, align=left, font=\scriptsize] at (0.03,0.98) {$\phi_0$: con monedas propias\\$\phi_1$: con moneda común\\$\phi_n$: entre regiones de una nación};
\end{tikzpicture}
