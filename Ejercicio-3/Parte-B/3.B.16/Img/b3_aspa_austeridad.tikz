% b3_aspa_austeridad: austeridad forzada en el país en crisis y margen fiscal del refugio (bloque 3.3; DE GRAUWE, 2011, 2020).
% Parte de b3_aspa_amplificacion: DA'' : p = 2,9 - y, E2 = (1,7; 1,2); DA*'' : p = 6,1 - y, E2* = (3,3; 2,8). La austeridad
% desplaza otra vez la demanda del país en crisis, DA''' : p = 2,3 - y, E3 = (1,4; 0,9). El refugio, con la deuda más barata,
% podría dar un impulso fiscal (punteado, posible): DA*''' : p = 6,7 - y, E3* = (3,6; 3,1), que sube p* y reparte el ajuste.
% Base común en b3_aspa_choque (oferta p = y - 0,5; demanda p = 4,5 - y; E0 = (2,5; 2,0)).
% Generar desde la carpeta del tema: bash Code/generar_figura.sh b3_aspa_austeridad
\begin{tikzpicture}[font=\footnotesize, x=1.05cm, y=0.95cm, >={Stealth[length=2mm]}]
  % país en crisis
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (2.8,4.65) {País en crisis};
    \draw[->] (0,0) -- (5.6,0) node[below left] {$y$};
    \draw[->] (0,0) -- (0,4.3) node[left] {$p$};
    \draw[black!85, thick] (0.9,0.4) -- (4.2,3.7) node[right] {$OA$};
    \draw[black!30, thick] (0.8,3.7) -- (4.0,0.5) node[right] {$DA$};
    \draw[black!60, thick, dashed] (0.1,2.8) -- (2.4,0.5) node[below] {$DA''$};
    \draw[black!80, thick, densely dotted] (0.1,2.2) -- (1.8,0.5) node[below left] {$DA'''$};
    \draw[->, black!70] (1.95,0.95) -- (1.6,0.6);
    \draw[black!35, densely dotted] (1.7,0) -- (1.7,1.2);
    \draw[black!35, densely dotted] (1.4,0) -- (1.4,0.9);
    \fill (2.5,2.0) circle (1.5pt) node[right=1pt] {$E_0$};
    \fill (1.7,1.2) circle (1.5pt) node[right=1pt] {$E_2$};
    \fill (1.4,0.9) circle (1.5pt) node[left=1pt] {$E_3$};
    \node[below] at (1.75,0) {$y_2$}; \node[below] at (1.35,0) {$y_3$};
  \end{scope}
  % refugio
  \begin{scope}[xshift=7.0cm]
    \node[font=\footnotesize\bfseries] at (2.8,4.65) {Socio que sirve de refugio};
    \draw[->] (0,0) -- (6.2,0) node[below left] {$y^*$};
    \draw[->] (0,0) -- (0,4.3) node[left] {$p^*$};
    \draw[black!85, thick] (0.9,0.4) -- (4.2,3.7) node[left] {$OA^*$};
    \draw[black!30, thick] (0.8,3.7) -- (4.0,0.5) node[below] {$DA^*$};
    \draw[black!60, thick, dashed] (2.4,3.7) -- (5.4,0.7) node[below] {$DA^{*\prime\prime}$};
    \draw[black!80, thick, densely dotted] (3.0,3.7) -- (5.8,0.9) node[right] {$DA^{*\prime\prime\prime}$};
    \draw[->, black!70] (4.55,1.45) -- (4.95,1.45);
    \draw[black!35, densely dotted] (3.3,0) -- (3.3,2.8);
    \draw[black!35, densely dotted] (3.6,0) -- (3.6,3.1);
    \draw[black!35, densely dotted] (0,2.8) -- (3.3,2.8);
    \draw[black!35, densely dotted] (0,3.1) -- (3.6,3.1);
    \node[left] at (0,2.8) {$p_2^*$}; \node[left] at (0,3.15) {$p_3^*$};
    \fill (2.5,2.0) circle (1.5pt) node[right=1pt] {$E_0^*$};
    \fill (3.3,2.8) circle (1.5pt) node[below right=1pt] {$E_2^*$};
    \fill (3.6,3.1) circle (1.5pt) node[above left=1pt] {$E_3^*$};
    \node[below] at (3.25,0) {$y_2^*$}; \node[below] at (3.65,0) {$y_3^*$};
  \end{scope}
  % leyenda
  \draw[thick, black!60, dashed] (1.0,-1.0) -- (1.8,-1.0);
  \node[anchor=west] at (1.9,-1.0) {tras la desconfianza (punto de partida)};
  \draw[thick, black!80, densely dotted] (1.0,-1.5) -- (1.8,-1.5);
  \node[anchor=west] at (1.9,-1.5) {austeridad forzada en el país en crisis; impulso fiscal posible en el refugio};
\end{tikzpicture}
