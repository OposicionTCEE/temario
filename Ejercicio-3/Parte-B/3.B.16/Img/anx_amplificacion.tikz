% anx_amplificacion: amplificación de una perturbación asimétrica cuando los inversores desconfían del país en recesión (anexo I.8.3).
% Base del modelo de dos países: OA: y = 0,0444 + 0,7556 x; DA0: y = 4,5217 - 0,6522 x; E0 = (3,18; 2,448).
% País en recesión: la perturbación baja la DA en 0,7 (E1 = (2,683; 2,072)) y la subida de la prima, otros 0,6 (E2 = (2,257; 1,750)).
% País refugio: la perturbación sube la DA en 0,7 (E1 = (3,678; 2,823)) y la bajada de la prima, otros 0,6 (E2 = (4,104; 3,145)).
% Generar desde la carpeta del tema: bash Code/generar_figura.sh anx_amplificacion
\begin{tikzpicture}[font=\footnotesize, x=1cm, y=1cm, >={Stealth[length=2mm]}]
  \begin{scope}
    \node[anchor=base] at (3,5.25) {País en recesión};
    \draw[->] (0,0) -- (6.2,0) node[below left] {$y$};
    \draw[->] (0,0) -- (0,5.1) node[below left] {$p$};
    \draw[black!85, thick] (1.0,0.8) -- (5.5,4.2) node[right] {OA};
    \draw[black!40, thick, dashed] (0.8,4.0) node[left] {DA$_0$} -- (5.6,0.869);
    \draw[black!60, thick] (0.8,3.300) node[left] {DA$_1$} -- (4.6,0.822);
    \draw[black!85, thick] (0.8,2.700) node[left] {DA$_2$} -- (4.1,0.548);
    \draw[->, black!60] (5.45,0.9) -- (4.6,0.9);
    \draw[->, black!60] (4.36,0.9) -- (3.68,0.9);
    \draw[black!40, densely dotted] (3.18,0) -- (3.18,1.95);
    \draw[black!40, densely dotted] (2.683,0) -- (2.683,1.57);
    \draw[black!40, densely dotted] (2.257,0) -- (2.257,1.25);
    \fill (3.18,2.448) circle (1.6pt) node[below=3pt] {$E_0$};
    \fill (2.683,2.072) circle (1.6pt) node[below=3pt] {$E_1$};
    \fill (2.257,1.750) circle (1.6pt) node[below=3pt] {$E_2$};
    \node[below] at (3.22,0) {$y_0$};
    \node[below] at (2.70,0) {$y_1$};
    \node[below] at (2.20,0) {$y_2$};
  \end{scope}
  \begin{scope}[xshift=7.9cm]
    \node[anchor=base] at (3,5.25) {País refugio};
    \draw[->] (0,0) -- (6.6,0) node[below left] {$y^*$};
    \draw[->] (0,0) -- (0,5.1) node[below left] {$p^*$};
    \draw[black!85, thick] (1.0,0.8) -- (5.5,4.2) node[right] {OA$^*$};
    \draw[black!40, thick, dashed] (0.8,4.0) -- (5.4,1.0) node[right] {DA$^*_0$};
    \draw[black!60, thick] (1.6,4.178) -- (6.0,1.309) node[right] {DA$^*_1$};
    \draw[black!85, thick] (2.4,4.256) -- (6.3,1.713) node[right] {DA$^*_2$};
    \draw[->, black!60] (1.05,3.9) -- (1.92,3.9);
    \draw[->, black!60] (2.12,3.9) -- (2.84,3.9);
    \draw[black!40, densely dotted] (3.18,0) -- (3.18,2.448);
    \draw[black!40, densely dotted] (3.678,0) -- (3.678,2.823);
    \draw[black!40, densely dotted] (4.104,0) -- (4.104,3.145);
    \fill (3.18,2.448) circle (1.6pt) node[below=3pt] {$E^*_0$};
    \fill (3.678,2.823) circle (1.6pt) node[below=3pt] {$E^*_1$};
    \fill (4.104,3.145) circle (1.6pt) node[below=3pt] {$E^*_2$};
    \node[below] at (3.14,0) {$y^*_0$};
    \node[below] at (3.68,0) {$y^*_1$};
    \node[below] at (4.16,0) {$y^*_2$};
  \end{scope}
\end{tikzpicture}
