% b3_walters: con un tipo de interés nominal común, la inflación de un miembro por encima de la media activa dos canales:
% el del tipo real, rápido, que amplifica el auge, y el de la competitividad, lento, que lo corrige a través de una crisis
% (bloque 3.2; WALTERS, 1990; DE GRAUWE, 2020). Base en anx:walters (anexo I.7.3), que muestra las trayectorias.
% Generar desde la carpeta del tema: bash Code/generar_figura.sh b3_walters
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=2.2mm]},
    caja/.style={draw=black!70, rounded corners=2pt, fill=black!6, align=center, text width=3.3cm, minimum height=1.05cm, inner sep=3pt},
    centro/.style={draw=black!85, thick, rounded corners=2pt, fill=black!14, align=center, text width=3.1cm, minimum height=1.2cm, inner sep=3pt}]
  \node[centro] (C) at (0,0) {inflación por encima\\de la media, $\pi_j>\bar\pi$};
  % canal del tipo real
  \node[caja] (L1) at (-4.6,1.45) {tipo de interés real\\más bajo, $r_j<\bar r$};
  \node[caja] (L2) at (-4.6,-1.45) {más crédito,\\gasto y actividad};
  \draw[->, thick, black!75] (C.north west) to[out=150, in=0] (L1.east);
  \draw[->, thick, black!75] (L1.south) -- (L2.north);
  \draw[->, thick, black!75] (L2.east) to[out=0, in=210] node[below right, pos=0.55] {$+$} (C.south west);
  \node[font=\scriptsize\bfseries, align=center] at (-4.6,2.55) {canal del tipo real:\\rápido, amplifica el auge};
  % canal de la competitividad
  \node[caja] (R1) at (4.6,1.45) {pérdida acumulada\\de competitividad};
  \node[caja] (R2) at (4.6,-1.45) {menos demanda exterior\\y, al final, crisis};
  \draw[->, thick, black!45, dashed] (C.north east) to[out=30, in=180] (R1.west);
  \draw[->, thick, black!45, dashed] (R1.south) -- (R2.north);
  \draw[->, thick, black!45, dashed] (R2.west) to[out=180, in=-30] node[below left, pos=0.55] {$-$} (C.south east);
  \node[font=\scriptsize\bfseries, align=center] at (4.6,2.55) {canal de la competitividad:\\lento, corrige con una crisis};
\end{tikzpicture}
