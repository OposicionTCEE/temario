% anx_ciclo: ciclos no sincronizados de dos miembros y la media que ve el banco central común (anexo I.3.3).
% Brechas: propio sin(t), socio sin(t - 1,2); media = semisuma. Sombreado: tramos con brechas de signo contrario.
% Generar desde la carpeta del tema: bash Code/generar_figura.sh anx_ciclo
\begin{tikzpicture}[font=\footnotesize]
  \begin{axis}[width=14.5cm, height=5.8cm, xmin=0, xmax=12.566, ymin=-1.3, ymax=1.3,
    axis lines=left, xlabel={tiempo}, ylabel={brecha de producción},
    label style={font=\footnotesize}, xtick=\empty, ytick={0}, yticklabels={$0$},
    legend style={draw=none, font=\footnotesize, at={(0.5,1.03)}, anchor=south, legend columns=3, /tikz/every even column/.append style={column sep=0.6cm}},
    clip=false]
    \foreach \a in {0, 3.1416, 6.2832, 9.4248}{
      \edef\temp{\noexpand\fill[black!10] (axis cs:\a,-1.3) rectangle (axis cs:{\a+1.2},1.3);}
      \temp
    }
    \addplot[black!85, thick, domain=0:12.566, samples=200] {sin(deg(x))};
    \addlegendentry{país propio}
    \addplot[black!50, thick, domain=0:12.566, samples=200] {sin(deg(x-1.2))};
    \addlegendentry{socio}
    \addplot[black!85, very thick, dashed, domain=0:12.566, samples=200] {0.5*sin(deg(x))+0.5*sin(deg(x-1.2))};
    \addlegendentry{media de la unión}
    \draw[black!40] (axis cs:0,0) -- (axis cs:12.566,0);
  \end{axis}
\end{tikzpicture}
