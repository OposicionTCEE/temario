% anx_ciclo: ciclos no sincronizados de dos miembros y la media que ve el banco central común (anexo I.3.3).
% Brechas: propio sin(t), socio sin(t - 1,2); media = semisuma. Sombreado: tramos con brechas de signo contrario.
% Generar desde la carpeta del tema: bash Code/generar_figura.sh anx_ciclo
\begin{tikzpicture}[font=\footnotesize]
  \begin{axis}[width=14.5cm, height=5.6cm, xmin=0, xmax=12.566, ymin=-1.3, ymax=1.35,
    axis lines=middle, xlabel={tiempo}, ylabel={brecha de producción},
    xlabel style={at={(ticklabel* cs:1)}, anchor=north east}, ylabel style={at={(ticklabel* cs:1)}, anchor=south west},
    label style={font=\footnotesize}, xtick=\empty, ytick=\empty, clip=false]
    \foreach \a in {0, 3.1416, 6.2832, 9.4248}{
      \edef\temp{\noexpand\fill[black!10] (axis cs:\a,-1.25) rectangle (axis cs:{\a+1.2},1.25);}
      \temp
    }
    \addplot[black!85, thick, domain=0:12.566, samples=200] {sin(deg(x))};
    \addplot[black!50, thick, domain=0:12.566, samples=200] {sin(deg(x-1.2))};
    \addplot[black!85, very thick, dashed, domain=0:12.566, samples=200] {0.5*sin(deg(x))+0.5*sin(deg(x-1.2))};
    \node[anchor=south, black!85] at (axis cs:1.57,1.0) {país propio};
    \node[anchor=south, black!55] at (axis cs:3.0,1.02) {socio};
    \node[anchor=north] at (axis cs:11.2,-0.85) {media de la unión};
  \end{axis}
\end{tikzpicture}
