% Generar desde la carpeta del tema: bash Code/generar_figura.sh anx_beneficios
\begin{tikzpicture}[font=\footnotesize, x=8cm, y=1.7cm, >={Stealth[length=2mm]}]
  \draw[->] (0,0) -- (1.08,0) node[below left] {apertura hacia los socios, $\phi$};
  \draw[->] (0,0) -- (0,2.75) node[below right] {beneficios, en proporción del PIB};
  \draw[black!85, thick] (0,0) -- (1,2.4) node[right] {$B(\phi)$};
  \node[below] at (0,0) {$0$};
  \node[below] at (1,0) {$1$};
\end{tikzpicture}
