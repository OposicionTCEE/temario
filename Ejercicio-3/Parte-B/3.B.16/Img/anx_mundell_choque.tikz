% anx_mundell_choque: perturbación asimétrica de demanda en el modelo de dos países de MUNDELL (1961) (anexo I.2.1).
% OA: y = 0,0444 + 0,7556 x; DA0: y = 4 - 0,6522 (x - 0,8); la DA se desplaza 0,9 hacia abajo (propio) o hacia arriba (socio).
% Generar desde la carpeta del tema: bash Code/generar_figura.sh anx_mundell_choque
\begin{tikzpicture}[font=\footnotesize, x=1cm, y=1cm, >={Stealth[length=2mm]}]
  % ---------- país propio ----------
  \begin{scope}
    \node[anchor=south] at (3,5.1) {País propio};
    \draw[->] (0,0) -- (6.2,0) node[below left] {$y$};
    \draw[->] (0,0) -- (0,5.1) node[below left] {$p$};
    \draw[black!85, thick] (1.0,0.8) -- (5.5,4.2) node[right] {OA};
    \draw[black!40, thick, dashed] (0.8,4.0) -- (5.4,1.0) node[right] {DA$_0$};
    \draw[black!85, thick] (0.8,3.1) -- (5.0,0.361) node[right] {DA$_1$};
    \draw[->, black!60] (1.9,3.28) -- (1.55,2.7);
    \draw[black!40, densely dotted] (3.18,0) -- (3.18,2.448) -- (0,2.448);
    \draw[black!40, densely dotted] (2.541,0) -- (2.541,1.964) -- (0,1.964);
    \fill (3.18,2.448) circle (1.6pt) node[above=2pt] {$E_0$};
    \fill (2.541,1.964) circle (1.6pt) node[below=2pt] {$E_1$};
    \node[below] at (3.18,0) {$y_0$};
    \node[below] at (2.541,0) {$y_1$};
    \node[left] at (0,2.448) {$p_0$};
    \node[left] at (0,1.964) {$p_1$};
  \end{scope}
  % ---------- país socio ----------
  \begin{scope}[xshift=7.6cm]
    \node[anchor=south] at (3,5.1) {País socio};
    \draw[->] (0,0) -- (6.2,0) node[below left] {$y^*$};
    \draw[->] (0,0) -- (0,5.1) node[below left] {$p^*$};
    \draw[black!85, thick] (1.0,0.8) -- (5.5,4.2) node[right] {OA$^*$};
    \draw[black!40, thick, dashed] (0.8,4.0) -- (5.4,1.0) node[right] {DA$^*_0$};
    \draw[black!85, thick] (0.8,4.9) -- (5.4,1.9) node[right] {DA$^*_1$};
    \draw[->, black!60] (4.6,1.6) -- (4.95,2.15);
    \draw[black!40, densely dotted] (3.18,0) -- (3.18,2.448) -- (0,2.448);
    \draw[black!40, densely dotted] (3.82,0) -- (3.82,2.931) -- (0,2.931);
    \fill (3.18,2.448) circle (1.6pt) node[below=2pt] {$E^*_0$};
    \fill (3.82,2.931) circle (1.6pt) node[right=3pt] {$E^*_1$};
    \node[below] at (3.18,0) {$y^*_0$};
    \node[below] at (3.82,0) {$y^*_1$};
    \node[left] at (0,2.448) {$p^*_0$};
    \node[left] at (0,2.931) {$p^*_1$};
  \end{scope}
\end{tikzpicture}
