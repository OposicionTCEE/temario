% anx_tt_comision: integración, simetría y línea AMO en la visión de la Comisión Europea (anexo I.5.5).
% AMO: de (0,4; 4,4) a (5,2; 0,4). TT creciente desde (1,2; 2,2) con pendiente 0,5; corta la AMO en (2,35; 2,775).
% Generar desde la carpeta del tema: bash Code/generar_figura.sh anx_tt_comision
\begin{tikzpicture}[font=\footnotesize, x=1.4cm, y=1.15cm, >={Stealth[length=2mm]}]
  \draw[->] (0,0) -- (5.9,0) node[below left] {integración comercial};
  \draw[->] (0,0) -- (0,4.9) node[below right] {simetría};
  \draw[black!85, thick] (0.4,4.4) -- (5.2,0.4) node[right] {AMO};
  \draw[black!55, thick] (0.6,1.9) -- (4.8,4.0) node[right] {TT};
  \node at (4.3,2.0) {zona AMO};
  \fill (1.2,2.2) circle (1.6pt) node[below right] {UE-27};
  \fill (2.35,2.775) circle (1.6pt);
  \draw[->, black!60] (1.3,2.33) -- (2.2,2.78);
\end{tikzpicture}
