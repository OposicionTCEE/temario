% b3_camino: el coste de una perturbación asimétrica está en el camino: brecha de producción del país que pierde demanda
% tras una perturbación permanente, con moneda propia (la depreciación ajusta de golpe: brecha nula) y en una unión, con
% precios flexibles y rígidos (bloque 3.1). Base en anx:bloques (anexo I.6.1): brecha propia = -(eta/2) mu^(t+1), eta = 1;
% precios rígidos mu = 0,87 (delta = 0,99, psi*eta = 0,02); precios flexibles mu = 0,55 (psi*eta = 0,37). Figura estilizada.
% Generar desde la carpeta del tema: bash Code/generar_figura.sh b3_camino
\begin{tikzpicture}[font=\footnotesize, x=0.62cm, y=6cm, >={Stealth[length=2mm]}]
  % producción perdida con precios rígidos
  \fill[black!10] (0,0) -- plot[domain=0:16, samples=80] (\x, {-0.5*pow(0.87,\x+1)}) -- (16,0) -- cycle;
  % ejes
  \draw[->] (-1.5,-0.52) -- (17,-0.52) node[below left] {tiempo};
  \draw[->] (-1.5,-0.52) -- (-1.5,0.12);
  \node[anchor=south west, align=left] at (-1.5,0.12) {brecha de producción del país que pierde demanda};
  % con moneda propia: la depreciación lleva el precio relativo a su nuevo nivel de golpe
  \draw[black!50, thick, dashed] (-1.5,0) -- (16.5,0) node[above left, black] {con moneda propia};
  % en la unión
  \draw[black!85, thick] (-1.5,0) -- (0,0);
  \draw[black!85, thick] (0,0) -- (0,{-0.5*0.87}) plot[domain=0:16, samples=80] (\x, {-0.5*pow(0.87,\x+1)});
  \draw[black!60, thick] (0,{-0.5*0.55}) plot[domain=0:16, samples=80] (\x, {-0.5*pow(0.55,\x+1)});
  \node[anchor=north west] at (5.6,-0.21) {unión con precios rígidos};
  \node[anchor=west] at (2.7,-0.075) {unión con precios flexibles};
  \node at (10.6,-0.045) {producción perdida};
  % perturbación
  \draw[<-, black!70] (0,0.015) -- (0,0.085) node[above, align=center, font=\scriptsize] {perturbación\\asimétrica};
\end{tikzpicture}
