% anx_mcdonald_solow: elección salarial de un sindicato con y sin acomodación de la política económica (McDONALD y SOLOW, 1981; DE GRAUWE, 2020) (anexo I.7.1).
% Utilidad del sindicato U = raíz(w N). Restricción sin acomodación: w = 4 - 0,8 N (tangencia A = (2,5; 2)).
% Con acomodación, más inclinada por el mismo punto (4; 0,8): w = 7,2 - 1,6 N (tangencia B = (2,25; 3,6)).
% Generar desde la carpeta del tema: bash Code/generar_figura.sh anx_mcdonald_solow
\begin{tikzpicture}[font=\footnotesize, x=1.5cm, y=1.1cm]
  \draw[->] (0,0) -- (5.6,0) node[below left] {empleo, $N$};
  \draw[->] (0,0) -- (0,5.9) node[below right] {salario real, $w$};
  \draw[black!55, thick] (0.4,3.68) -- (4.9,0.08) node[right] {sin acomodación};
  \draw[black!85, thick] (1.0,5.6) -- (4.3,0.32) node[right] {con acomodación};
  \draw[black!40, domain=1.25:5.0, samples=60] plot (\x, {5/\x});
  \draw[black!40, domain=1.5:5.0, samples=60] plot (\x, {8.1/\x});
  \draw[black!40, densely dotted] (2.5,0) -- (2.5,2) -- (0,2);
  \draw[black!40, densely dotted] (2.25,0) -- (2.25,3.6) -- (0,3.6);
  \fill (2.5,2) circle (1.6pt) node[above right] {$A$};
  \fill (2.25,3.6) circle (1.6pt) node[above right] {$B$};
  \node[left] at (0,2) {$w_A$};
  \node[left] at (0,3.6) {$w_B$};
\end{tikzpicture}
