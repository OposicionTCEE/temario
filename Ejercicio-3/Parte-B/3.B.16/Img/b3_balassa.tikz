% b3_balassa: diferenciales de inflación de equilibrio y de desequilibrio (bloque 3.2; BALASSA, 1964; SAMUELSON, 1964). La
% recta relaciona el nivel de precios relativo con la productividad relativa de los comerciables: y = 0,8 + 0,56 (x - 0,5).
% Desde E0 = (2,0; 1,64), el mismo aumento del nivel de precios (hasta 2,48) es de equilibrio si lo acompaña la productividad
% (A = (3,5; 2,48), sobre la recta) y de desequilibrio si no (B = (2,0; 2,48), por encima: pérdida de competitividad).
% Base en anx:diferenciales (anexo I.7.6). Figura abstracta, sin datos.
% Generar desde la carpeta del tema: bash Code/generar_figura.sh b3_balassa
\begin{tikzpicture}[font=\footnotesize, x=1.6cm, y=1.25cm, >={Stealth[length=2mm]}]
  \draw[->] (0,0) -- (6,0);
  \node[anchor=north east] at (6,-0.1) {productividad relativa de los bienes comerciables};
  \draw[->] (0,0) -- (0,3.6);
  \node[anchor=south west] at (0,3.6) {nivel de precios relativo};
  \draw[black!85, thick] (0.5,0.8) -- (5.4,3.544) node[right] {BALASSA-SAMUELSON};
  \draw[black!35, densely dotted] (2.0,0) -- (2.0,2.48);
  \draw[black!35, densely dotted] (3.5,0) -- (3.5,2.48);
  \draw[black!35, densely dotted] (0,2.48) -- (3.5,2.48);
  \draw[black!35, densely dotted] (0,1.64) -- (2.0,1.64);
  \draw[->, thick, black!75, dashed] (2.08,1.69) -- (3.42,2.43);
  \draw[->, thick, black!75, densely dotted] (2.0,1.72) -- (2.0,2.40);
  \fill (2.0,1.64) circle (1.6pt) node[below right] {$E_0$};
  \fill (3.5,2.48) circle (1.6pt) node[below right] {$A$};
  \fill (2.0,2.48) circle (1.6pt) node[above left] {$B$};
  \draw[decorate, decoration={brace, amplitude=4pt}, black!60] (2.08,2.44) -- (2.08,1.69) node[midway, right=5pt, font=\scriptsize, black, align=left] {pérdida de\\competitividad};
  \draw[thick, black!75, dashed] (0.3,-0.75) -- (0.8,-0.75);
  \node[anchor=west] at (0.85,-0.75) {equilibrio: los precios suben con la productividad};
  \draw[thick, black!75, densely dotted] (0.3,-1.15) -- (0.8,-1.15);
  \node[anchor=west] at (0.85,-1.15) {desequilibrio: los precios suben sin la productividad};
\end{tikzpicture}
