% b2_barro_gordon: sesgo inflacionista con discreción (E) y unión plena con un ancla creíble (F): misma producción y
% menos inflación (bloque 2.3). Versión simplificada de anx_barro_gordon (anexo I.3.4): curva de PHILLIPS
% y = y_n + alpha (pi - pi^e) con alpha = 1; y_n = 2, y* = 4; E = (2, 2), F = (2; 0,6); curvas de indiferencia
% centradas en (4, 0) que pasan por E (radio raíz de 8) y por F (radio raíz de 4,36).
% Generar desde la carpeta del tema: bash Code/generar_figura.sh b2_barro_gordon
\begin{tikzpicture}[font=\footnotesize, x=1.45cm, y=1.45cm, >={Stealth[length=2mm]}]
  \begin{scope}
    \clip (0,-0.02) rectangle (5.6,3.4);
    \draw[black!35] (4,0) circle ({sqrt(8)});
    \draw[black!35] (4,0) circle ({sqrt(4.36)});
  \end{scope}
  \draw[->] (0,0) -- (5.8,0) node[below left] {producción, $y$};
  \draw[->] (0,0) -- (0,3.6) node[below right] {inflación, $\pi$};
  \draw[black!85, thick] (2,0) -- (2,3.35) node[above] {largo plazo};
  \draw[black!85, thick] (0.6,0.6) -- (3.3,3.3) node[right] {$\pi^e=\pi^d$};
  \draw[black!85, thick] (1.4,0) -- (4.3,2.9) node[right] {$\pi^e=\pi_a$};
  \draw[black!40, dashed] (0,2) -- (2,2); \node[left] at (0,2) {$\pi^d=\alpha\beta k$};
  \draw[black!40, dashed] (0,0.6) -- (2,0.6); \node[left] at (0,0.6) {$\pi_a$};
  \fill (2,2) circle (1.6pt); \node[anchor=south east] at (1.97,2.03) {$E$};
  \fill (2,0.6) circle (1.6pt); \node[anchor=north west] at (2.05,0.58) {$F$};
  \draw[->, black!70, thick] (1.82,1.9) -- (1.82,0.72);
  \node[anchor=east, align=right, font=\scriptsize] at (1.75,1.3) {unión plena con\\un ancla creíble};
  \fill (4,0) circle (1.2pt);
  \node[below] at (2,0) {$y_n$}; \node[below] at (4,0) {$y^*=y_n+k$};
\end{tikzpicture}
