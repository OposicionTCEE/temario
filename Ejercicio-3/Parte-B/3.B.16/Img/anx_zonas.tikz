% anx_zonas: crisis de renovación de la deuda pública: zona segura, zona de crisis autocumplidas y zona de insolvencia (anexo I.8.2).
% Pago exigido al Estado: con confianza, (rbar - Dy) b (pendiente 0,375); en una corrida, (1/V + rbar - Dy) b (pendiente 1,2; con V mayor, 0,75).
% Superávit primario máximo SP^máx = 3. Cortes: b1 = 2,5; b1 con V mayor = 4; b2 = 8. Valores estilizados.
% Generar desde la carpeta del tema: bash Code/generar_figura.sh anx_zonas
\begin{tikzpicture}[font=\footnotesize, x=1.2cm, y=0.85cm, >={Stealth[length=2mm]}]
  \fill[black!5] (0,0) rectangle (2.5,5.9);
  \fill[black!13] (2.5,0) rectangle (8,5.9);
  \fill[black!24] (8,0) rectangle (10.4,5.9);
  \draw[->] (0,0) -- (10.7,0) node[below] {$b$};
  \draw[->] (0,0) -- (0,6.2) node[above] {pago exigido};
  \draw[black!85, thick] (0,3) -- (10.4,3) node[right] {$SP^{\text{máx}}$};
  \draw[black!85, thick] (0,0) -- (4.5,5.4) node[above] {$\big(\tfrac{1}{V}+\bar r-\Delta y\big)\,b$};
  \draw[black!60, thick, dashed] (0,0) -- (7.4,5.55) node[above] {$V$ mayor};
  \draw[black!85, thick] (0,0) -- (10.4,3.9) node[right] {$(\bar r-\Delta y)\,b$};
  \foreach \x in {2.5,4,8}{
    \draw[black!50, densely dotted] (\x,0) -- (\x,3);
    \fill (\x,3) circle (1.6pt);
  }
  \node[below] at (2.5,0) {$b_1$};
  \node[below] at (4,0) {$b_1'$};
  \node[below] at (8,0) {$b_2$};
  \draw[decorate, decoration={brace, mirror, amplitude=4pt}] (0.05,-0.62) -- (2.45,-0.62) node[midway, below=4pt] {segura};
  \draw[decorate, decoration={brace, mirror, amplitude=4pt}] (2.55,-0.62) -- (7.95,-0.62) node[midway, below=4pt] {crisis autocumplidas};
  \draw[decorate, decoration={brace, mirror, amplitude=4pt}] (8.05,-0.62) -- (10.4,-0.62) node[midway, below=4pt] {insolvencia};
  \draw[decorate, decoration={brace, mirror, amplitude=4pt}] (0.05,-1.55) -- (7.95,-1.55) node[midway, below=4pt] {segura con prestamista de última instancia};
\end{tikzpicture}
