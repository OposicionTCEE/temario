% anx_linea_amo: línea de área monetaria óptima entre flexibilidad y simetría, con posiciones según DE GRAUWE (2020) (anexo I.5.3).
% Línea: de (0,5; 4,2) a (5,0; 0,5). UE-27 (1,2; 2,0) por debajo; EE. UU. (3,8; 2,1) por encima; zona del euro (2,4; 2,9), discutida.
% Generar desde la carpeta del tema: bash Code/generar_figura.sh anx_linea_amo
\begin{tikzpicture}[font=\footnotesize, x=1.45cm, y=1.2cm, >={Stealth[length=2mm]}]
  \draw[->] (0,0) -- (5.9,0) node[below left] {flexibilidad (salarios y movilidad)};
  \draw[->] (0,0) -- (0,4.8) node[below right] {simetría de las perturbaciones};
  \draw[black!85, thick] (0.5,4.2) -- (5.0,0.5) node[right] {línea AMO};
  \node[align=center] at (4.4,3.4) {zona AMO};
  \fill (1.2,2.0) circle (1.6pt) node[below left] {UE-27};
  \fill (3.8,2.1) circle (1.6pt) node[above right] {EE. UU.};
  \fill (2.4,2.9) circle (1.6pt) node[above right] {zona del euro};
  \draw[->, black!60] (1.2,2.08) -- (1.2,3.45) node[left, align=right, font=\scriptsize] {más\\simetría};
  \draw[->, black!60] (1.28,2.0) -- (2.6,2.0) node[below, font=\scriptsize] {más flexibilidad};
\end{tikzpicture}
