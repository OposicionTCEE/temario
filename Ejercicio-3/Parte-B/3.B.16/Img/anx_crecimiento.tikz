% anx_crecimiento: capital por trabajador de largo plazo con y sin prima de riesgo cambiario (anexo I.4.4).
% f(k) = 2 raíz(k). Tangencia con pendiente r + lambda = 0,75 en k_A = 1,778 (f = 2,667); con pendiente r = 0,5 en k_B = 4 (f = 4).
% Generar desde la carpeta del tema: bash Code/generar_figura.sh anx_crecimiento
\begin{tikzpicture}[font=\footnotesize, x=1.3cm, y=1.1cm, >={Stealth[length=2mm]}]
  \draw[->] (0,0) -- (6.9,0) node[below left] {capital por trabajador, $k$};
  \draw[->] (0,0) -- (0,5.6) node[below right] {producción por trabajador, $f(k)$};
  \draw[black!85, thick, domain=0:6.3, samples=80] plot (\x, {2*sqrt(\x)}) node[right] {$f(k)$};
  \draw[black!55, thick] (0.2,1.483) -- (3.6,4.033) node[above left] {pendiente $r+\lambda$};
  \draw[black!55, thick, dashed] (1.4,2.7) -- (6.6,5.3) node[below right] {pendiente $r$};
  \draw[black!40, densely dotted] (1.778,0) -- (1.778,2.667);
  \draw[black!40, densely dotted] (4,0) -- (4,4);
  \fill (1.778,2.667) circle (1.6pt) node[below right] {$A$};
  \fill (4,4) circle (1.6pt) node[below right] {$B$};
  \node[below] at (1.778,0) {$k_A$};
  \node[below] at (4,0) {$k_B$};
\end{tikzpicture}
