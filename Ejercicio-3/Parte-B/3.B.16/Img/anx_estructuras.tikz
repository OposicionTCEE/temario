% anx_estructuras: estructuras productivas parecidas (comercio intraindustrial) frente a especializadas, y simetría de una perturbación sectorial (anexo I.3.1).
% Generar desde la carpeta del tema: bash Code/generar_figura.sh anx_estructuras
\begin{tikzpicture}[font=\footnotesize, x=1cm, y=1cm]
  % ---------- panel (a): estructuras parecidas ----------
  \begin{scope}
    \node[anchor=south] at (3.1,4.25) {(a) Comercio intraindustrial};
    \draw (0,0) -- (6.2,0);
    \foreach \x/\h/\g in {0.3/1.05/85, 0.9/1.05/50, 1.5/0.90/20}{ \fill[black!\g] (\x,0) rectangle ++(0.5,{3*\h}); }
    \foreach \x/\h/\g in {3.6/0.99/85, 4.2/1.11/50, 4.8/0.90/20}{ \fill[black!\g] (\x,0) rectangle ++(0.5,{3*\h}); }
    \node[below] at (1.3,0) {país propio};
    \node[below] at (4.6,0) {socio};
    \draw[black!60, dashed] (0.1,3.6) -- (2.2,3.6);
    \draw[black!60, dashed] (3.4,3.6) -- (5.5,3.6);
    \node[align=center] at (3.1,-1.0) {perturbación en el sector $1$:\\golpea a los dos por igual};
  \end{scope}
  % ---------- panel (b): especialización ----------
  \begin{scope}[xshift=7.8cm]
    \node[anchor=south] at (3.1,4.25) {(b) Especialización};
    \draw (0,0) -- (6.2,0);
    \foreach \x/\h/\g in {0.3/2.10/85, 0.9/0.30/50, 1.5/0.60/20}{ \fill[black!\g] (\x,0) rectangle ++(0.5,{1.5*\h}); }
    \foreach \x/\h/\g in {3.6/0.30/85, 4.2/2.10/50, 4.8/0.60/20}{ \fill[black!\g] (\x,0) rectangle ++(0.5,{1.5*\h}); }
    \node[below] at (1.3,0) {país propio};
    \node[below] at (4.6,0) {socio};
    \node[align=center] at (3.1,-1.0) {perturbación en el sector $1$:\\golpea sobre todo al país propio};
  \end{scope}
  % ---------- leyenda ----------
  \fill[black!85] (4.0,-2.2) rectangle ++(0.35,0.25); \node[anchor=west] at (4.4,-2.075) {sector $1$};
  \fill[black!50] (6.2,-2.2) rectangle ++(0.35,0.25); \node[anchor=west] at (6.6,-2.075) {sector $2$};
  \fill[black!20] (8.4,-2.2) rectangle ++(0.35,0.25); \node[anchor=west] at (8.8,-2.075) {sector $3$};
  \node[anchor=east] at (3.8,-2.075) {peso en la producción:};
\end{tikzpicture}
