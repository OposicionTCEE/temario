% anx_mckinnon: eficacia real de una devaluación según la apertura (theta) y la indiciación salarial (chi): 1 - chi*theta (anexo I.2.2).
% Generar desde la carpeta del tema: bash Code/generar_figura.sh anx_mckinnon
\begin{tikzpicture}[font=\footnotesize]
  \begin{axis}[width=10.5cm, height=6.2cm, xmin=0, xmax=1, ymin=0, ymax=1.12,
    axis lines=left, xlabel={apertura, $\theta$}, ylabel={eficacia real de la devaluación, $1-\chi\theta$},
    label style={font=\footnotesize}, tick label style={font=\footnotesize},
    xtick={0,0.25,0.5,0.75,1}, xticklabels={$0$,$0{,}25$,$0{,}5$,$0{,}75$,$1$},
    ytick={0,0.5,1}, yticklabels={$0$,$0{,}5$,$1$}, clip=false]
    \addplot[black!85, thick, domain=0:1] {1} node[pos=1, right] {$\chi=0$};
    \addplot[black!55, thick, dashed, domain=0:1] {1-0.5*x} node[pos=1, right] {$\chi=0{,}5$};
    \addplot[black!85, thick, domain=0:1] {1-x} node[pos=1, right] {$\chi=1$};
  \end{axis}
\end{tikzpicture}
