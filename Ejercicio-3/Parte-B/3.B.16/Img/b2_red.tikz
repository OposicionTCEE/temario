% b2_red: la moneda como bien de red: cuatro monedas necesitan seis mercados de cambio; con una moneda vehicular, tres;
% con una moneda común, ninguno (bloque 2.1; KRUGMAN, 1980). Base en anx:transaccion (anexo I.4.1).
% Generar desde la carpeta del tema: bash Code/generar_figura.sh b2_red
\begin{tikzpicture}[font=\footnotesize, x=1cm, y=1cm,
    mon/.style={circle, draw=black!70, fill=white, minimum size=0.62cm, inner sep=0pt, font=\scriptsize}]
  % cuatro monedas, seis mercados
  \begin{scope}
    \node[mon] (a) at (0,1.8) {$A$}; \node[mon] (b) at (1.8,1.8) {$B$};
    \node[mon] (c) at (1.8,0) {$C$}; \node[mon] (d) at (0,0) {$D$};
    \foreach \u/\v in {a/b, b/c, c/d, d/a, a/c, b/d} { \draw[black!60] (\u) -- (\v); }
    \node[align=center, font=\scriptsize] at (0.9,-0.85) {cuatro monedas:\\seis mercados de cambio};
  \end{scope}
  % moneda vehicular, tres mercados
  \begin{scope}[xshift=4.8cm]
    \node[mon, fill=black!15] (a) at (0.9,0.9) {$A$};
    \node[mon] (b) at (0,1.8) {$B$}; \node[mon] (c) at (1.8,1.8) {$C$}; \node[mon] (d) at (0.9,-0.2) {$D$};
    \foreach \v in {b, c, d} { \draw[black!60] (a) -- (\v); }
    \node[align=center, font=\scriptsize] at (0.9,-0.85) {$A$ como moneda vehicular:\\tres mercados de cambio};
  \end{scope}
  % moneda común, ningún mercado
  \begin{scope}[xshift=9.6cm]
    \draw[black!70, fill=black!6] (0.9,0.9) circle (1.25);
    \node[font=\scriptsize] at (0.25,1.45) {$A$}; \node[font=\scriptsize] at (1.55,1.45) {$B$};
    \node[font=\scriptsize] at (1.55,0.35) {$C$}; \node[font=\scriptsize] at (0.25,0.35) {$D$};
    \node[font=\scriptsize\itshape, black!70] at (0.9,0.9) {una moneda};
    \node[align=center, font=\scriptsize] at (0.9,-0.85) {moneda común:\\ningún mercado de cambio};
  \end{scope}
\end{tikzpicture}
