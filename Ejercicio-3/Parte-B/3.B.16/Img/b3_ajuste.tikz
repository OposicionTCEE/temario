% b3_ajuste: persistencia de una diferencia de paro tras una perturbación propia en un estado de Estados Unidos y en un
% miembro de la zona del euro (bloque 3.5). Figura estilizada a partir de las persistencias estimadas en anx:ev_europa
% (anexo II.2): rho = 0,75 en Estados Unidos y 0,91 en la zona del euro; diferencia = rho^t; vidas medias ln 0,5 / ln rho
% = 2,41 y 7,35 años. Sin cifras en la figura (cuerpo).
% Generar desde la carpeta del tema: bash Code/generar_figura.sh b3_ajuste
\begin{tikzpicture}[font=\footnotesize, x=0.72cm, y=4cm, >={Stealth[length=2mm]}]
  \draw[->] (0,0) -- (16,0) node[below left] {años desde la perturbación};
  \draw[->] (0,0) -- (0,1.17);
  \node[anchor=south west] at (0,1.17) {diferencia entre el paro del país o del estado y la media};
  \draw[black!40, dashed] (0,0.5) -- (15.5,0.5) node[right, black, font=\scriptsize] {la mitad};
  \draw[black!85, thick, domain=0:15, samples=80] plot (\x, {pow(0.91,\x)});
  \draw[black!55, thick, domain=0:15, samples=80] plot (\x, {pow(0.75,\x)});
  \fill (2.41,0.5) circle (1.5pt); \fill (7.35,0.5) circle (1.5pt);
  \draw[black!35, densely dotted] (2.41,0) -- (2.41,0.5);
  \draw[black!35, densely dotted] (7.35,0) -- (7.35,0.5);
  \node[below, font=\scriptsize, align=center] at (2.41,0) {vida media\\en EE. UU.};
  \node[below, font=\scriptsize, align=center] at (7.35,0) {vida media en la\\zona del euro};
  \node[anchor=south west, align=left] at (8.6,0.47) {miembro de la zona del euro:\\ajuste con paro e inactividad};
  \node[anchor=north west, align=left] at (3.6,0.24) {estado de Estados Unidos:\\ajuste con migración};
\end{tikzpicture}
