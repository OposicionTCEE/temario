% anx_piezas: piezas de una unión monetaria completa en una unión mínima, en la zona del euro (2026) y en una nación (anexo I.1.4).
% Generar desde la carpeta del tema: bash Code/generar_figura.sh anx_piezas
\begin{tikzpicture}[font=\footnotesize, x=1cm, y=1cm]
  \foreach \t [count=\c] in {{Unión monetaria\\mínima},{Zona del euro\\($2026$)},{Nación\\(EE. UU.)}}{
    \node[anchor=south, align=center, text width=2.4cm] at ({6.8+2.6*(\c-1)},0.35) {\t};
  }
  \draw[black!40] (0.3,0.3) -- (13.3,0.3);
  \foreach \r/\l in {1/{Moneda y banco central comunes},2/{Prestamista de los bancos},3/{Respaldo de la deuda pública},4/{Supervisión y resolución bancarias comunes},5/{Garantía de depósitos común},6/{Presupuesto común con transferencias},7/{Movilidad del trabajo},8/{Unión política}}{
    \node[anchor=east, align=right, text width=5.4cm] at (5.6,{-0.6*(\r-1)}) {\l};
    \draw[black!15] (0.3,{-0.6*(\r-1)-0.3}) -- (13.3,{-0.6*(\r-1)-0.3});
  }
  % s = sí, m = en parte o con condiciones, n = no
  \foreach \r/\vals in {1/{s,s,s},2/{s,s,s},3/{n,m,s},4/{n,s,s},5/{n,n,s},6/{n,m,s},7/{n,m,s},8/{n,m,s}}{
    \foreach \v [count=\c] in \vals {
      \coordinate (P) at ({6.8+2.6*(\c-1)},{-0.6*(\r-1)});
      \if s\v \fill[black!75] (P) circle (0.15); \fi
      \if m\v \fill[black!75] (P) ++(90:0.15) arc[start angle=90, end angle=270, radius=0.15] -- cycle; \draw[black!75, line width=0.6pt] (P) circle (0.15); \fi
      \if n\v \draw[black!75, line width=0.6pt] (P) circle (0.15); \fi
    }
  }
  % leyenda
  \fill[black!75] (3.4,-5.25) circle (0.15); \node[anchor=west] at (3.65,-5.25) {sí};
  \fill[black!75] (4.8,-5.25) ++(90:0.15) arc[start angle=90, end angle=270, radius=0.15] -- cycle; \draw[black!75, line width=0.6pt] (4.8,-5.25) circle (0.15); \node[anchor=west] at (5.05,-5.25) {en parte o con condiciones};
  \draw[black!75, line width=0.6pt] (9.1,-5.25) circle (0.15); \node[anchor=west] at (9.35,-5.25) {no};
\end{tikzpicture}
