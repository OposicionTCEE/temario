% b3_zonas: zonas de la deuda pública de un miembro de una unión sin prestamista de última instancia para el Estado y con
% él: el prestamista borra la zona de crisis autocumplidas, y la zona segura llega hasta el límite de solvencia (bloque 3.3;
% CALVO, 1988; COLE y KEHOE, 2000; DE GRAUWE, 2011). Base en anx_zonas (anexo I.8.2): b1 = 2,5 y b2 = 8, estilizados.
% Generar desde la carpeta del tema: bash Code/generar_figura.sh b3_zonas
\begin{tikzpicture}[font=\footnotesize, x=1.2cm, y=1cm, >={Stealth[length=2mm]},
    fila/.style={align=right, text width=2.9cm, anchor=east}]
  % sin prestamista
  \fill[black!5] (0,1.3) rectangle (2.5,2.2);
  \fill[black!16] (2.5,1.3) rectangle (8,2.2);
  \fill[black!32] (8,1.3) rectangle (10,2.2);
  \draw[black!60] (0,1.3) rectangle (10,2.2);
  \node at (1.25,1.75) {segura};
  \node[align=center] at (5.25,1.75) {crisis autocumplidas: dos equilibrios,\\deciden las expectativas};
  \node at (9,1.75) {insolvencia};
  \node[fila] at (-0.15,1.75) {sin prestamista de última instancia para el Estado};
  % con prestamista
  \fill[black!5] (0,0) rectangle (8,0.9);
  \fill[black!32] (8,0) rectangle (10,0.9);
  \draw[black!60] (0,0) rectangle (10,0.9);
  \node at (4,0.45) {segura};
  \node at (9,0.45) {insolvencia};
  \node[fila] at (-0.15,0.45) {con prestamista de última instancia para el Estado};
  % eje
  \draw[->] (0,-0.35) -- (10.6,-0.35);
  \node[anchor=north east] at (10.6,-0.95) {deuda pública en proporción del PIB, $b$};
  \foreach \x/\t in {2.5/{b_1}, 8/{b_2}} {
    \draw[black!55, densely dotted] (\x,-0.35) -- (\x,2.35);
    \draw (\x,-0.43) -- (\x,-0.27);
  }
  \node[below] at (2.5,-0.43) {$b_1$};
  \node[below] at (8,-0.43) {$b_2$};
  \node[below] at (0,-0.43) {$0$};
\end{tikzpicture}
