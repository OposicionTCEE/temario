% anx_austeridad: efecto a corto plazo de una consolidación fiscal sobre la ratio de deuda según la deuda (b) y el multiplicador (k): eleva la ratio si k b > 1 (anexo I.8.5).
% Generar desde la carpeta del tema: bash Code/generar_figura.sh anx_austeridad
\begin{tikzpicture}[font=\footnotesize, x=4.2cm, y=1.45cm, >={Stealth[length=2mm]}]
  \fill[black!13] (0.3333,3.1) -- plot[domain=0.3333:2.05, samples=80] (\x,{1/\x}) -- (2.05,3.1) -- cycle;
  \draw[->] (0,0) -- (2.15,0) node[below left, yshift=-12pt] {deuda pública en proporción del PIB, $b$};
  \draw[->] (0,0) -- (0,3.3) node[above] {multiplicador, $k$};
  \draw[black!85, thick, domain=0.3333:2.05, samples=80] plot (\x,{1/\x}) node[above right, xshift=-6pt] {$k=1/b$};
  \draw[black!50, densely dotted] (1,0) -- (1,1) -- (0,1);
  \fill (1,1) circle (1.6pt);
  \foreach \x/\t in {0/$0$, 0.5/$0{,}5$, 1/$1$, 1.5/$1{,}5$, 2/$2$}{
    \draw (\x,0.04) -- (\x,-0.04) node[below] {\t};
  }
  \foreach \y in {1,2,3}{
    \draw (0.012,\y) -- (-0.012,\y) node[left] {$\y$};
  }
  \node at (1.45,2.15) {$k\,b>1$: la ratio sube};
  \node at (0.55,0.45) {$k\,b<1$: la ratio baja};
\end{tikzpicture}
