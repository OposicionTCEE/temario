% b4_proyeccion: proyección de los beneficios (bloque 2) y los costes (bloque 3) sobre las curvas de KRUGMAN (1990) en
% función del comercio con los socios, phi (bloque 4.1, Proyección). Misma base que b3_umbral y b2_beneficios (B = phi;
% C = 0,85 - 0,6 phi; umbral 0,53125). Seis rectas: B' = 1,4 phi (más inclinada; umbral 0,425); B'' = 0,15 + phi (más alta;
% 0,4375); C' = 1,05 - 0,6 phi (más alta; 0,65625); C'' = 0,6 - 0,5 phi (más baja; 0,4). Figura abstracta, sin datos.
% Generar desde la carpeta del tema: bash Code/generar_figura.sh b4_proyeccion
\begin{tikzpicture}[font=\footnotesize, x=11cm, y=4.2cm, >={Stealth[length=2mm]}]
  \draw[->] (0,0) -- (1.08,0);
  \node[anchor=north east] at (1.08,-0.14) {comercio con los socios en proporción del PIB, $\phi$};
  \draw[->] (0,0) -- (0,1.2);
  \node[anchor=south west] at (0,1.2) {beneficios y costes};
  % beneficios
  \draw[black!85, thick] (0,0) -- (1,1) node[right] {$B$};
  \draw[black!60, thick, dashed] (0,0) -- (0.8,1.12) node[above] {$B'$};
  \draw[black!60, thick, densely dotted] (0,0.15) -- (0.95,1.1) node[right] {$B''$};
  % costes
  \draw[black!85, thick] (0,0.85) -- (1,0.25) node[right] {$C$};
  \draw[black!60, thick, dashed] (0,1.05) -- (1,0.45) node[right] {$C'$};
  \draw[black!60, thick, densely dotted] (0,0.6) -- (1,0.1) node[right] {$C''$};
  % umbral y desplazamientos
  \draw[black!40, densely dotted] (0.53125,0) -- (0.53125,0.53125);
  \fill (0.53125,0.53125) circle (1.6pt);
  \node[below] at (0.53125,0) {$\phi^*$};
  \foreach \x/\y in {0.425/0.595, 0.4375/0.5875, 0.4/0.4, 0.65625/0.65625} { \draw[black!70] (\x,\y) circle (1.3pt); }
  \draw[->, black!70, thick] (0.52,0.07) -- (0.405,0.07);
  \node[anchor=south east, font=\scriptsize] at (0.52,0.09) {$B'$, $B''$, $C''$: lo bajan};
  \draw[->, black!70, thick] (0.545,0.07) -- (0.655,0.07);
  \node[anchor=south west, font=\scriptsize] at (0.545,0.09) {$C'$: lo sube};
  % leyenda abreviada
  \node[anchor=north west, align=left, font=\scriptsize, text width=5.4cm] at (0.0,-0.3)
    {$B'$, más inclinada: fricciones, devaluaciones, mercados, reservas y papel internacional\\[2pt]
     $B''$, más alta: credibilidad y voz};
  \node[anchor=north west, align=left, font=\scriptsize, text width=5.4cm] at (0.53,-0.3)
    {$C'$, más alta: perturbaciones y rigidez, política común, impuesto inflacionista, riesgo soberano y redenominación\\[2pt]
     $C''$, más baja: flexibilidad, reparto del riesgo y completitud};
\end{tikzpicture}
