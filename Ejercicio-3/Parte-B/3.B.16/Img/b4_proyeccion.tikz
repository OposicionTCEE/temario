% b4_proyeccion: proyección de los beneficios (bloque 2) y los costes (bloque 3) sobre las curvas de beneficios y costes de
% KRUGMAN (1990) en función del comercio con los socios, phi (bloque 4.1). Misma base que b2_beneficios y b3_umbral.
% Beneficios: B = 0,9 phi; B' más inclinada (1,4 phi); B'' desplazada (0,3 + 0,9 phi). Costes: C = 0,9 - 0,6 phi;
% C' más alta (1,2 - 0,6 phi); C'' más baja (0,6 - 0,55 phi). Figura abstracta.
% Generar desde la carpeta del tema: bash Code/generar_figura.sh b4_proyeccion
\begin{tikzpicture}[font=\footnotesize, x=5.6cm, y=3.6cm, >={Stealth[length=2mm]}]
  % beneficios
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (0.5,1.42) {Beneficios};
    \draw[->] (0,0) -- (1.1,0) node[below left] {$\phi$};
    \draw[->] (0,0) -- (0,1.3);
    \draw[black!85, thick] (0,0) -- (1,0.9) node[right] {$B$};
    \draw[black!60, thick, dashed] (0,0) -- (0.82,1.15) node[right, black] {$B'$};
    \draw[black!60, thick, densely dotted] (0,0.3) -- (1,1.2) node[right, black] {$B''$};
    \draw[thick, black!60, dashed] (0.0,-0.2) -- (0.08,-0.2);
    \node[anchor=north west, text width=5.0cm, align=left, font=\scriptsize] at (0.1,-0.13) {más inclinada: costes de cambio, transparencia y comercio, devaluaciones competitivas, integración financiera, reservas y papel internacional};
    \draw[thick, black!60, densely dotted] (0.0,-0.52) -- (0.08,-0.52);
    \node[anchor=north west, text width=5.0cm, align=left, font=\scriptsize] at (0.1,-0.45) {más alta: credibilidad importada por un país de inflación alta};
  \end{scope}
  % costes
  \begin{scope}[xshift=7.6cm]
    \node[font=\footnotesize\bfseries] at (0.5,1.42) {Costes};
    \draw[->] (0,0) -- (1.1,0) node[below left] {$\phi$};
    \draw[->] (0,0) -- (0,1.3);
    \draw[black!85, thick] (0,0.9) -- (1,0.3) node[right] {$C$};
    \draw[black!60, thick, dashed] (0,1.2) -- (1,0.6) node[right, black] {$C'$};
    \draw[black!60, thick, densely dotted] (0,0.6) -- (1,0.05) node[right, black] {$C''$};
    \draw[thick, black!60, dashed] (0.0,-0.2) -- (0.08,-0.2);
    \node[anchor=north west, text width=5.0cm, align=left, font=\scriptsize] at (0.1,-0.13) {más alta: perturbaciones asimétricas y rigidez, política común, impuesto inflacionista, riesgo soberano y redenominación};
    \draw[thick, black!60, densely dotted] (0.0,-0.52) -- (0.08,-0.52);
    \node[anchor=north west, text width=5.0cm, align=left, font=\scriptsize] at (0.1,-0.45) {más baja: flexibilidad, reparto del riesgo y completitud de la unión};
  \end{scope}
  \node[anchor=north, font=\scriptsize] at (1.18,-0.72) {costes de transición y convergencia: un coste fijo de entrada, fuera de las curvas};
\end{tikzpicture}
