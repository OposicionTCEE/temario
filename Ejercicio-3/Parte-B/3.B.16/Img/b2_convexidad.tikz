% b2_convexidad: el beneficio de una empresa exportadora es convexo en el precio mientras produce, de modo que la
% volatilidad ordinaria no reduce su beneficio medio; una apreciación grande y duradera la lleva al cierre, con costes
% que no se recuperan (bloque 2.2). Pi(p) = 0,25 p^2 - 0,6 para p >= 1,1; cierre con Pi = -1,3 por debajo.
% p1 = 2,0 y p2 = 3,4 (media 2,7): Pi(media) = 1,2225 < media de Pi = 1,345. Base en anx:incertidumbre (anexo I.4.3).
% Generar desde la carpeta del tema: bash Code/generar_figura.sh b2_convexidad
\begin{tikzpicture}[font=\footnotesize, x=1.7cm, y=1.1cm, >={Stealth[length=2mm]}]
  \draw[->] (0,0) -- (4.5,0);
  \node[anchor=north east, align=right] at (4.55,-0.05) {precio en moneda\\propia, $p$};
  \draw[->] (0,-1.7) -- (0,2.9) node[below right] {beneficio, $\Pi$};
  \draw[black!85, thick, domain=1.1:4.0, samples=60] plot (\x, {0.25*\x*\x-0.6}) node[right] {$\Pi(p)$};
  \draw[black!85, thick] (0.25,-1.3) -- (1.1,-1.3);
  \draw[black!45, densely dashed] (1.1,{0.25*1.21-0.6}) -- (1.1,-1.3);
  \node[anchor=north west, align=left, font=\scriptsize] at (0.2,-1.38) {cierre: costes que\\no se recuperan};
  % volatilidad ordinaria: cuerda por encima de la curva
  \draw[black!55, thick] (2.0,0.4) -- (3.4,2.29);
  \draw[black!35, densely dotted] (2.0,0) -- (2.0,0.4);
  \draw[black!35, densely dotted] (2.7,0) -- (2.7,1.345);
  \draw[black!35, densely dotted] (3.4,0) -- (3.4,2.29);
  \fill (2.0,0.4) circle (1.5pt); \fill (3.4,2.29) circle (1.5pt);
  \fill (2.7,1.2225) circle (1.5pt) node[below right] {$\Pi(\bar p)$};
  \fill (2.7,1.345) circle (1.5pt) node[above left] {$\mathbb{E}[\Pi]$};
  \node[below] at (2.0,0) {$p_1$}; \node[below] at (2.7,0) {$\bar p$}; \node[below] at (3.4,0) {$p_2$};
  \draw[decorate, decoration={brace, mirror, amplitude=4pt}, black!60] (1.95,-0.45) -- (3.45,-0.45) node[midway, below=5pt, font=\scriptsize, black] {volatilidad ordinaria};
  % riesgo de cola
  \fill (0.7,-1.3) circle (1.5pt);
  \draw[black!35, densely dotted] (0.7,0) -- (0.7,-1.3);
  \node[below, font=\scriptsize] at (0.7,0) {$p_c$};
  \node[anchor=south, align=center, font=\scriptsize] at (0.7,0.15) {apreciación\\grande};
\end{tikzpicture}
