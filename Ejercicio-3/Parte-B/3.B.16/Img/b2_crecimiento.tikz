% b2_crecimiento: prima de riesgo y capital de largo plazo (bloque 2.2; BALDWIN, 1989; DE GRAUWE, 2020). Productividad
% marginal del capital f'(k) = 1 / raíz(k) (de f(k) = 2 raíz(k), la misma base que anx_crecimiento, anexo I.4.4) frente al
% coste del capital: con prima cambiaria, r + lambda_c = 0,75 (k0 = 1,778); sin ella, en la unión, r = 0,5 (k1 = 4); si la
% sustituye una prima de impago, r + lambda_i = 0,9 (k2 = 1,235). Figura abstracta.
% Generar desde la carpeta del tema: bash Code/generar_figura.sh b2_crecimiento
\begin{tikzpicture}[font=\footnotesize, x=1.45cm, y=3.2cm, >={Stealth[length=2mm]}]
  \draw[->] (0,0) -- (6.4,0) node[below left] {capital por trabajador, $k$};
  \draw[->] (0,0) -- (0,1.55);
  \node[anchor=south west] at (0,1.55) {rendimiento y coste del capital};
  \draw[black!85, thick, domain=0.45:6.1, samples=80] plot (\x, {1/sqrt(\x)}) node[above right] {$f'(k)$};
  \draw[black!85, thick] (0,0.75) -- (6.1,0.75) node[right] {$r+\lambda_c$};
  \draw[black!60, thick, dashed] (0,0.5) -- (6.1,0.5) node[right, black] {$r$};
  \draw[black!60, thick, densely dotted] (0,0.9) -- (6.1,0.9) node[right, black] {$r+\lambda_i$};
  \foreach \k/\v in {1.778/0.75, 4/0.5, 1.235/0.9} {
    \draw[black!35, densely dotted] (\k,0) -- (\k,\v);
    \fill (\k,\v) circle (1.5pt);
  }
  \node[below] at (1.778,0) {$k_0$};
  \node[below] at (4,0) {$k_1$};
  \node[below] at (1.235,0) {$k_2$};
  \draw[->, black!70, dashed] (1.95,0.08) -- (3.85,0.08);
  \node[anchor=south, font=\scriptsize] at (2.9,0.1) {sin riesgo cambiario};
  \node[anchor=north west, align=left, font=\scriptsize] at (2.3,1.42) {$\lambda_c$: prima de riesgo cambiario, con moneda propia\\$\lambda_i$: prima de impago, si sustituye a la cambiaria};
\end{tikzpicture}
