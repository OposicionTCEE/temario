% anx_bloques: respuesta del precio relativo y de la brecha de producción propia a una perturbación asimétrica permanente, en una unión y con tipo de cambio flexible (anexo I.6.1).
% Bloque relativo del modelo neokeynesiano de dos países: q_t = 1 - mu^(t+1); brecha propia = -(eta/2) mu^(t+1), con delta = 0,99, psi*eta = 0,02 (mu = 0,8722) y eta = 1.
% Generar desde la carpeta del tema: bash Code/generar_figura.sh anx_bloques
\begin{tikzpicture}[font=\footnotesize]
  \begin{axis}[name=a, width=7.6cm, height=5.6cm, xmin=-2, xmax=16, ymin=-0.05, ymax=1.15,
    axis lines=left, xlabel={periodos}, title={(a) Precio relativo, $q$}, title style={font=\footnotesize},
    label style={font=\footnotesize}, tick label style={font=\footnotesize},
    xtick={0,4,8,12,16}, xticklabels={$0$,$4$,$8$,$12$,$16$}, ytick={0,1}, yticklabels={$0$,$1$}, clip=false]
    \addplot[black!45, thick, dashed] coordinates {(-2,0) (-0.001,0) (0,1) (16,1)};
    \addplot[black!85, thick, mark=*, mark size=1pt] coordinates {(-2,0) (-1,0) (0,0.1278) (1,0.2394) (2,0.3366) (3,0.4215) (4,0.4955) (5,0.5600) (6,0.6163) (7,0.6654) (8,0.7082) (9,0.7455) (10,0.7781) (11,0.8065) (12,0.8312) (13,0.8528) (14,0.8717) (15,0.8881) (16,0.9024)};
    \node[anchor=south west, black!55] at (axis cs:4,1.0) {tipo de cambio flexible};
    \node[anchor=north west] at (axis cs:8.5,0.66) {unión};
  \end{axis}
  \begin{axis}[at={(a.east)}, anchor=west, xshift=1.4cm, width=7.6cm, height=5.6cm, xmin=-2, xmax=16, ymin=-0.55, ymax=0.15,
    axis lines=left, xlabel={periodos}, title={(b) Brecha de producción propia, $\tilde y$}, title style={font=\footnotesize},
    label style={font=\footnotesize}, tick label style={font=\footnotesize},
    xtick={0,4,8,12,16}, xticklabels={$0$,$4$,$8$,$12$,$16$}, ytick={-0.5,0}, yticklabels={$-0{,}5$,$0$}, clip=false]
    \addplot[black!45, thick, dashed] coordinates {(-2,0) (16,0)};
    \addplot[black!85, thick, mark=*, mark size=1pt] coordinates {(-2,0) (-1,0) (0,-0.4361) (1,-0.3803) (2,-0.3317) (3,-0.2893) (4,-0.2523) (5,-0.2200) (6,-0.1919) (7,-0.1673) (8,-0.1459) (9,-0.1273) (10,-0.1110) (11,-0.0968) (12,-0.0844) (13,-0.0736) (14,-0.0642) (15,-0.0560) (16,-0.0488)};
    \node[anchor=south west, black!55] at (axis cs:6,0.01) {tipo de cambio flexible};
