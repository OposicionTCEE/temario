% b3_aspa_devaluacion: una devaluación frente a la perturbación asimétrica y su erosión (bloque 3.1, crítica de la eficacia;
% DE GRAUWE, 2020): la devaluación devuelve la demanda de DA' a DA (E1 -> E0), pero encarece los bienes importados y los
% salarios, y la oferta sube a OA''' : p = y + 0,3, de modo que la producción vuelve a y1 con precios más altos (E3 = (2,1;
% 2,4)). Solo el panel del país propio. Base común en b3_aspa_choque; base del anexo en anx_devaluacion (anexo I.3.2).
% Generar desde la carpeta del tema: bash Code/generar_figura.sh b3_aspa_devaluacion
\begin{tikzpicture}[font=\footnotesize, x=1.15cm, y=0.95cm, >={Stealth[length=2mm]}]
  \node[font=\footnotesize\bfseries] at (2.5,4.65) {País propio};
  \draw[->] (0,0) -- (5,0) node[below left] {$y$};
  \draw[->] (0,0) -- (0,4.3) node[left] {$p$};
  \draw[black!85, thick] (0.9,0.4) -- (4.2,3.7) node[right] {$OA$};
  \draw[black!60, thick, densely dotted] (0.3,0.6) -- (3.6,3.9) node[left, black] {$OA'''$};
  \draw[black!85, thick] (0.8,3.7) -- (4.0,0.5) node[right] {$DA$};
  \draw[black!60, thick] (0.4,3.3) -- (3.2,0.5) node[below left] {$DA'$};
  \draw[black!35, densely dotted] (2.5,0) -- (2.5,2.0);
  \draw[black!35, densely dotted] (2.1,0) -- (2.1,2.4);
  \draw[->, thick, black!75, dashed] (2.12,1.66) -- (2.44,1.98);
  \draw[->, thick, black!75, densely dotted] (2.44,2.06) -- (2.16,2.34);
  \fill (2.1,1.6) circle (1.5pt) node[left=1pt] {$E_1$};
  \fill (2.5,2.0) circle (1.5pt) node[right=1pt] {$E_0$};
  \fill (2.1,2.4) circle (1.5pt) node[left=1pt] {$E_3$};
  \node[below] at (2.1,0) {$y_1$}; \node[below] at (2.5,0) {$y_0$};
  \draw[thick, black!75, dashed] (0.2,-1.0) -- (1.0,-1.0);
  \node[anchor=west] at (1.1,-1.0) {la devaluación devuelve la demanda a $DA$};
  \draw[thick, black!75, densely dotted] (0.2,-1.5) -- (1.0,-1.5);
  \node[anchor=west] at (1.1,-1.5) {los costes y los salarios suben y desplazan la oferta};
\end{tikzpicture}
