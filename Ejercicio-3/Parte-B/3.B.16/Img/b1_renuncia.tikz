% b1_renuncia: qué ocurre con cada instrumento de la soberanía monetaria al pasar de la moneda propia a una unión
% monetaria, y qué queda (bloque 1.3). Base analítica en anx:renuncia (anexo I.1.3).
% Generar desde la carpeta del tema: bash Code/generar_figura.sh b1_renuncia
\begin{tikzpicture}[font=\footnotesize, x=1cm, y=1cm, >={Stealth[length=2mm]}]
  \node[font=\scriptsize\bfseries] at (5.3,0.75) {con moneda propia};
  \node[font=\scriptsize\bfseries] at (11.0,0.75) {en una unión monetaria};
  \foreach \r/\ins/\a/\b in {
     1/{Tipo de cambio}/{ajusta de golpe\\los precios relativos}/{desaparece: los precios relativos\\solo cambian con la inflación},
     2/{Tipo de interés}/{lo fija el banco\\central propio}/{común, $\bar\imath$, y cada Estado\\paga $\bar\imath+\lambda_j$},
     3/{Prestamista de\\última instancia}/{para los bancos\\y para el Estado}/{para los bancos;\\el Estado se queda sin él},
     4/{Señoreaje}/{propio}/{común, repartido según\\la población y el PIB}} {
    \node[anchor=east, align=right, font=\scriptsize\bfseries, text width=2.6cm] at (2.9,{-1.25*(\r-1)}) {\ins};
    \node[draw=black!50, align=center, font=\scriptsize, text width=3.6cm, minimum height=0.95cm] (A\r) at (5.3,{-1.25*(\r-1)}) {\a};
    \node[draw=black!50, fill=black!6, align=center, font=\scriptsize, text width=5.2cm, minimum height=0.95cm] (B\r) at (11.0,{-1.25*(\r-1)}) {\b};
    \draw[->, black!60] (A\r.east) -- (B\r.west);
  }
  \node[draw=black!60, align=center, font=\scriptsize, text width=11.4cm, minimum height=0.7cm] at (8.15,-5.2) {Queda la política fiscal, con más carga como estabilizador y más expuesta a los mercados};
\end{tikzpicture}
