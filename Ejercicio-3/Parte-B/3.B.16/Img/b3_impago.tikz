% b3_impago: equilibrios múltiples en la deuda pública de un miembro de una unión (bloque 3.3). Estructura del modelo de
% crisis de segunda generación de OBSTFELD (1996), trasladada a la deuda como el cálculo de costes y beneficios del impago de
% DE GRAUWE (2011, 2020): coste de seguir pagando si se espera que el Estado pague, L1 = 0,11 b^2, y si se espera el impago,
% L2 = 0,24 b^2; coste del impago Q = 4. Cortes: B en b1 = 4,08 (L2 = Q) y A en b2 = 6,03 (L1 = Q). El prestamista de última
% instancia acerca L2 a L1 y borra la zona de crisis. Formato de los apuntes de VICTOR (figura de OBSTFELD). Base en
% anx_zonas (anexo I.8.2), con otra representación. Figura abstracta.
% Generar desde la carpeta del tema: bash Code/generar_figura.sh b3_impago
\begin{tikzpicture}[font=\footnotesize, x=1.25cm, y=0.6cm, >={Stealth[length=2mm]}]
  \draw[->] (0,0) -- (9.3,0);
  \node[anchor=north east] at (9.3,-1.85) {deuda pública en proporción del PIB, $b$};
  \draw[->] (0,0) -- (0,8.6);
  \node[anchor=south west] at (0,8.6) {coste para el Estado};
  % coste del impago
  \draw[black!85, thick] (0,4) -- (8.6,4) node[right] {$Q$};
  % costes de seguir pagando
  \draw[black!85, thick, domain=0:8.5, samples=60] plot (\x, {0.11*\x*\x}) node[right] {$L_1$};
  \draw[black!60, thick, domain=0:5.85, samples=60] plot (\x, {0.24*\x*\x}) node[right] {$L_2$};
  % cortes
  \draw[black!40, densely dotted] (4.08,0) -- (4.08,4);
  \draw[black!40, densely dotted] (6.03,0) -- (6.03,4);
  \fill (4.08,4) circle (1.6pt) node[above left] {$B$};
  \fill (6.03,4) circle (1.6pt) node[below right] {$A$};
  \node[below] at (4.08,0) {$b_1$};
  \node[below] at (6.03,0) {$b_2$};
  % zonas
  \draw[decorate, decoration={brace, mirror, amplitude=4pt}, black!60] (0.05,-0.75) -- (4.03,-0.75) node[midway, below=4pt, black] {paga siempre};
  \draw[decorate, decoration={brace, mirror, amplitude=4pt}, black!60] (4.13,-0.75) -- (5.98,-0.75) node[midway, below=4pt, black, align=center] {deciden las\\expectativas};
  \draw[decorate, decoration={brace, mirror, amplitude=4pt}, black!60] (6.08,-0.75) -- (9.1,-0.75) node[midway, below=4pt, black] {impago};
  % prestamista de última instancia
  \draw[->, thick, black!70, dashed] (5.0,5.85) -- (5.0,2.95);
  \node[anchor=west, align=left, font=\scriptsize] at (5.12,6.6) {con prestamista de última\\instancia, $L_2$ se acerca a $L_1$};
  % leyenda de las curvas
  \node[anchor=north west, align=left, font=\scriptsize] at (0.25,8.3) {$L_1$: coste de pagar si se espera que el Estado pague\\$L_2$: coste de pagar si se espera el impago\\$Q$: coste del impago};
\end{tikzpicture}
