% anx_convexidad: beneficio de la empresa convexo en el precio: el beneficio esperado con precio incierto supera al beneficio con el precio medio (anexo I.4.3).
% Pi(p) = 0,25 p^2; p1 = 1,5, p2 = 3,5, media 2,5: Pi(media) = 1,5625; media de Pi = 1,8125.
% Generar desde la carpeta del tema: bash Code/generar_figura.sh anx_convexidad
\begin{tikzpicture}[font=\footnotesize, x=1.6cm, y=1.4cm, >={Stealth[length=2mm]}]
  \draw[->] (0,0) -- (4.5,0) node[below left] {precio, $p$};
  \draw[->] (0,0) -- (0,4.0) node[below right] {beneficio, $\Pi(p)$};
  \draw[black!85, thick, domain=0.6:3.9, samples=60] plot (\x, {0.25*\x*\x}) node[right] {$\Pi(p)$};
  \draw[black!55, thick] (1.5,0.5625) -- (3.5,3.0625);
  \draw[black!40, densely dotted] (1.5,0) -- (1.5,0.5625);
  \draw[black!40, densely dotted] (3.5,0) -- (3.5,3.0625);
  \draw[black!40, densely dotted] (2.5,0) -- (2.5,1.8125);
  \fill (1.5,0.5625) circle (1.6pt);
  \fill (3.5,3.0625) circle (1.6pt);
  \fill (2.5,1.5625) circle (1.6pt) node[below right] {$\Pi(\bar p)$};
  \fill (2.5,1.8125) circle (1.6pt) node[above left] {$\mathbb{E}[\Pi(p)]$};
  \node[below] at (1.5,0) {$p_1$};
  \node[below] at (2.5,0) {$\bar p$};
  \node[below] at (3.5,0) {$p_2$};
\end{tikzpicture}
