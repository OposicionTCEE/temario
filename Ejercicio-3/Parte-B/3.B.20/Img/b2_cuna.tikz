% b2_cuna: la cuña de precios entre dos mercados vuelve a abrirse en los años treinta (bloque 2, Mercados). MISMA BASE COMÚN D
% que b1_cuna y mismas curvas: Nuevo Mundo S_N: P = 0,5 + 0,5 Q, D_N: P = 4,0 - 0,5 Q; Europa S_E: P = 2,0 + 0,5 Q,
% D_E: P = 7,0 - 0,5 Q. Con cuña tau: P_N = 3,375 - tau/2, P_E = 3,375 + tau/2, comercio = 4,5 - 2 tau.
% En gris, la cuña de 1913, tau1 = 0,6 (P_N = 3,075, P_E = 3,675, comercio 3,3), con la que acababa b1_cuna. En negro, la de
% los años treinta, tau2 = 2,0, por aranceles, contingentes y control de cambios: P_N = 2,375 (Q_D 3,25 y Q_S 3,75),
% P_E = 4,375 (Q_S 4,75 y Q_D 5,25), comercio 0,5.
% Generar desde la carpeta del tema: bash Code/generar_figura.sh b2_cuna
\begin{tikzpicture}[font=\footnotesize, x=0.72cm, y=0.72cm, >={Stealth[length=2mm]}]
  % ---------- Nuevo Mundo ----------
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (4.2,7.6) {Nuevo Mundo (exportador)};
    \draw[->] (0,0) -- (8.6,0) node[below left] {Trigo};
    \draw[->] (0,0) -- (0,7.2) node[left] {$P$};
    \draw[black!85, thick] (0,0.5) -- (8.4,4.7) node[above left] {$S_N$};
    \draw[black!85, thick] (0,4.0) -- (7.0,0.5) node[above right] {$D_N$};
    % precios con la cuña de 1913 (tau1) y la de los años treinta (tau2)
    \draw[black!45, dashed] (0,3.075) -- (8.4,3.075);
    \draw[black!85] (0,2.375) -- (8.4,2.375);
    \node[left] at (0,3.075) {$P_N^1$};
    \node[left] at (0,2.375) {$P_N^2$};
    % exportaciones
    \draw[line width=2.2pt, black!40] (1.85,3.075) -- (5.15,3.075);
    \draw[line width=2.2pt, black!85] (3.25,2.375) -- (3.75,2.375);
    \draw[decorate, decoration={brace, amplitude=3pt}, black!55] (1.85,3.22) -- (5.15,3.22) node[midway, above=3pt] {$X_1$};
    \draw[decorate, decoration={brace, mirror, amplitude=2pt}] (3.25,2.23) -- (3.75,2.23) node[midway, below=3pt] {$X_2$};
    \draw[->, black!70] (7.6,3.0) -- (7.6,2.45);
  \end{scope}
  % ---------- Europa ----------
  \begin{scope}[xshift=9.2cm]
    \node[font=\footnotesize\bfseries] at (4.2,7.6) {Europa (importador)};
    \draw[->] (0,0) -- (8.6,0) node[below left] {Trigo};
    \draw[->] (0,0) -- (0,7.2) node[left] {$P$};
    \draw[black!85, thick] (0,2.0) -- (8.4,6.2) node[below right] {$S_E$};
    \draw[black!85, thick] (0,7.0) -- (8.4,2.8) node[below left] {$D_E$};
    \draw[black!45, dashed] (0,3.675) -- (8.4,3.675) node[right, black] {$P_E^1$};
    \draw[black!85] (0,4.375) -- (8.4,4.375) node[right] {$P_E^2$};
    % importaciones
    \draw[line width=2.2pt, black!40] (3.35,3.675) -- (6.65,3.675);
    \draw[line width=2.2pt, black!85] (4.75,4.375) -- (5.25,4.375);
    \draw[decorate, decoration={brace, mirror, amplitude=3pt}, black!55] (3.35,3.53) -- (6.65,3.53) node[midway, below=3pt] {$M_1$};
    \draw[decorate, decoration={brace, amplitude=2pt}] (4.75,4.52) -- (5.25,4.52) node[midway, above=3pt] {$M_2$};
    \draw[->, black!70] (7.7,3.75) -- (7.7,4.3);
    % la cuña: los precios del Nuevo Mundo, prolongados hasta el eje de Europa
    \draw[black!45, densely dotted] (-4.38,3.075) -- (0,3.075);
    \draw[black!85, densely dotted] (-4.38,2.375) -- (0,2.375);
    \draw[black!85, densely dotted] (-2.7,4.375) -- (0,4.375);
    \draw[decorate, decoration={brace, amplitude=2.5pt}, black!55] (-0.8,3.075) -- (-0.8,3.675) node[midway, left=3pt] {$\tau_1$};
    \draw[decorate, decoration={brace, amplitude=3pt}] (-2.7,2.375) -- (-2.7,4.375) node[midway, left=4pt] {$\tau_2$};
  \end{scope}
\end{tikzpicture}
