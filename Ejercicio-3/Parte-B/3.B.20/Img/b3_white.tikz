% b3_white: el plan de WHITE (1943) en el cuerpo (bloque 3, Origen, epígrafe Planes). MISMA BASE COMÚN G que b3_keynes (mismos
% ejes, escala y valores ilustrativos: Q = 3,6; F = 1), adaptada de anx_banco_fondo (anexo I.11.1). WHITE (fondo): el Fondo
% solo vende los dólares que tiene, en esencia la aportación del acreedor, min(D, F). La línea de KEYNES queda en gris como
% referencia. Sombreado: lo que tienen que ajustar los deudores, ahora desde F (en b3_keynes empezaba en Q). Sin cifras.
% Generar desde la carpeta del tema: bash Code/generar_figura.sh b3_white
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=2mm]}, x=1.45cm, y=1.0cm]
  % ajuste de los deudores: todo lo que el Fondo no financia
  \fill[black!12] (1.0,1.0) -- (5.0,5.0) -- (5.0,1.0) -- cycle;
  \node[font=\scriptsize, align=center] at (3.75,2.15) {ajuste de\\los deudores};
  % ejes
  \draw[->] (0,0) -- (5.9,0) node[below left] {Déficit, $D$};
  \draw[->] (0,0) -- (0,5.5) node[above] {Financiación automática};
  % déficit por financiar
  \draw[black!45, densely dotted, thick] (0,0) -- (5.0,5.0) node[above right, black!60] {$D$};
  % guías
  \draw[black!40, densely dotted] (1.0,0) -- (1.0,1.0);
  \draw[black!30, densely dotted] (3.6,0) -- (3.6,1.0);
  \node[below] at (1.0,0) {$F$};
  \node[below, text=black!55] at (3.6,0) {$Q$};
  \node[left] at (0,1.0) {$F$};
  \node[left, text=black!55] at (0,3.6) {$Q$};
  % KEYNES, como referencia
  \draw[black!40, thick, dashed] (1.0,1.0) -- (3.6,3.6) -- (5.6,3.6) node[right, text=black!55] {KEYNES};
  % WHITE (fondo): solo financia lo aportado
  \draw[black!90, very thick] (0,0) -- (1.0,1.0) -- (5.6,1.0) node[right] {WHITE};
  \fill (1.0,1.0) circle (1.4pt);
\end{tikzpicture}
