% anx_dilema_aranceles: el dilema del prisionero de los aranceles (anexo II.6.4; se reutiliza en II.10 para el GATT).
% Dos países eligen librecambio o protección. Pagos ilustrativos (A, B): (L, L) = (3, 3); (L, P) = (1, 4); (P, L) = (4, 1);
% (P, P) = (2, 2). Proteger es la estrategia dominante para los dos, y el equilibrio de Nash, (P, P), sombreado, es peor para
% ambos que (L, L), recuadrado con trazo doble.
% Generar desde la carpeta del tema: bash Code/generar_figura.sh anx_dilema_aranceles
\begin{tikzpicture}[font=\footnotesize, celda/.style={draw=black!80, thick, minimum width=3.0cm, minimum height=1.25cm, align=center}]
  % encabezados
  \node[font=\footnotesize\bfseries] at (4.6,2.1) {País $B$};
  \node[font=\footnotesize\bfseries, rotate=90] at (-0.35,-0.65) {País $A$};
  \node at (3.1,1.45) {Librecambio};
  \node at (6.1,1.45) {Protección};
  \node[anchor=east] at (1.45,0.0) {Librecambio};
  \node[anchor=east] at (1.45,-1.3) {Protección};
  % celdas
  \node[celda, double, double distance=1.2pt] at (3.1,0.0) {$(3,\ 3)$};
  \node[celda] at (6.1,0.0) {$(1,\ 4)$};
  \node[celda] at (3.1,-1.3) {$(4,\ 1)$};
  \node[celda, fill=black!15] at (6.1,-1.3) {$(2,\ 2)$};
\end{tikzpicture}
