% b3_triffin: el dilema de TRIFFIN (1960) en el cuerpo (bloque 3, Desenlace, Liquidez y confianza), en su representación
% canónica: el oro de Estados Unidos frente a los dólares en manos de bancos centrales extranjeros, los únicos que podían
% convertirse en oro. Esquema SIN CIFRAS (no es una serie): eje horizontal, tiempo; vertical, dólares (el oro valorado a 35
% la onza). Oro G(x) = 4,4 - 0,12 x, que baja despacio. Dólares oficiales D(x) = 0,8 + 0,25 x + 0,035 x^2, que crecen para dar
% liquidez al mundo. Se cruzan en x = 6,15 (y = 3,662): desde ahí la cobertura es menor que uno y la conversión deja de ser
% creíble. Las defensas (pool del oro, swaps, bonos Roosa), que empiezan en x = 5, reducen los dólares que se presentarían a
% la conversión: D^e(x) = D(5) + 0,2 (D(x) - D(5)) = 2,5 + 0,05 x + 0,007 x^2, discontinua, que cruza el oro más tarde, en
% x = 8,32 (y = 3,402), el fin de la convertibilidad en 1971. Franja entre los dos cruces: el tiempo comprado. La misma idea
% está formalizada en el anexo I.13 como frontera entre liquidez y cobertura (anx_triffin), donde las defensas suben la frontera.
% Generar desde la carpeta del tema: bash Code/generar_figura.sh b3_triffin
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=2mm]}, x=1.15cm, y=0.85cm]
  % tiempo comprado: entre el cruce sin defensas y el cruce con defensas
  \fill[black!8] (6.15,0) rectangle (8.32,6.6);
  \node[font=\scriptsize, align=center] at (7.235,6.15) {tiempo\\comprado};
  % ejes
  \draw[->] (0,0) -- (10.2,0) node[below left] {Tiempo};
  \draw[->] (0,0) -- (0,7.0) node[above] {Dólares (oro a 35 la onza)};
  % oro de Estados Unidos
  \draw[black!90, very thick, domain=0.3:9.6, samples=40] plot (\x, {4.4-0.12*\x});
  \node[anchor=north west, font=\scriptsize] at (9.6,3.248) {Oro de EE. UU.};
  % dólares en bancos centrales extranjeros: la liquidez del mundo
  \draw[black!60, very thick, domain=0.3:9.3, samples=60, smooth] plot (\x, {0.8+0.25*\x+0.035*\x*\x});
  \node[anchor=west, font=\scriptsize, align=left] at (9.3,6.15) {Dólares en bancos\\centrales extranjeros};
  % con defensas: dólares que se presentarían a la conversión
  \draw[black!60, thick, dashed, domain=5:9.6, samples=40, smooth] plot (\x, {2.5+0.05*\x+0.007*\x*\x});
  \node[anchor=south west, font=\scriptsize, align=left, text=black!70] at (9.6,3.625) {presentados a la\\conversión};
  \node[anchor=north west, font=\scriptsize, text=black!70] at (5.1,2.85) {defensas};
  % cruces
  \fill (6.15,3.662) circle (1.6pt);
  \fill (8.32,3.402) circle (1.6pt);
  \draw[black!40, densely dotted] (6.15,0) -- (6.15,3.662);
  \draw[black!40, densely dotted] (8.32,0) -- (8.32,3.402);
  \node[below, align=center, font=\scriptsize] at (6.15,0) {cobertura\\$<1$};
  \node[below, align=center, font=\scriptsize] at (8.32,0) {fin de la\\convertibilidad (1971)};
\end{tikzpicture}
