% Figura (anexo de las reparaciones): el problema de la transferencia en el debate KEYNES-OHLIN (1929).
% El pagador transfiere T: su gasto cae en T y sus importaciones en mT; el gasto del receptor sube en T y sus
% importaciones en m*T. El saldo comercial del pagador mejora en (m + m*)T. Si m + m* = 1 la transferencia se
% realiza sin cambiar los precios (OHLIN); si m + m* < 1 hace falta un deterioro de su relación real de intercambio (KEYNES).
% Generar con: bash Code/generar_figura.sh anx_transferencia
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]},
    caja/.style={draw, align=center, inner sep=3pt, minimum height=0.85cm, text width=3.7cm, execute at begin node={\hyphenpenalty=10000}},
    res/.style={draw, rounded corners=2pt, align=center, inner sep=3pt, text width=4.6cm, execute at begin node={\hyphenpenalty=10000}}]
  % columnas
  \node[font=\footnotesize\bfseries] at (0,2.9) {País pagador (Alemania)};
  \node[font=\footnotesize\bfseries] at (10.4,2.9) {País receptor (aliados)};
  \node[caja] (p1) at (0,2.1) {Sube los impuestos o recorta el gasto en $T$};
  \node[caja] (p2) at (0,0.8) {Su gasto interior cae en $T$};
  \node[caja] (p3) at (0,-0.5) {Sus importaciones caen en $m\,T$};
  \node[caja] (r1) at (10.4,2.1) {Recibe $T$: su renta disponible sube en $T$};
  \node[caja] (r2) at (10.4,0.8) {Su gasto interior sube en $T$};
  \node[caja] (r3) at (10.4,-0.5) {Sus importaciones suben en $m^*T$};
  \draw[->] (p1) -- (p2); \draw[->] (p2) -- (p3);
  \draw[->] (r1) -- (r2); \draw[->] (r2) -- (r3);
  \draw[->, thick] (p1.east) -- (r1.west) node[midway, above] {transferencia $T$};
  % resultado
  \node[res, fill=gray!12] (s) at (5.2,-1.9) {El saldo comercial del pagador mejora en $(m+m^*)\,T$};
  \draw[->] (p3.south) |- (s.west);
  \draw[->] (r3.south) |- (s.east);
  \node[res] (o) at (1.6,-3.5) {Si $m+m^*=1$: el superávit cubre la transferencia sin cambiar los precios (OHLIN)};
  \node[res] (k) at (8.8,-3.5) {Si $m+m^*<1$: hace falta que empeore la relación real de intercambio del pagador (KEYNES)};
  \draw[->] (s.south) -- ++(0,-0.35) -| (o.north);
  \draw[->] (s.south) -- ++(0,-0.35) -| (k.north);
\end{tikzpicture}
