% anx_clausula_escape: el coste político de defender una paridad en el patrón oro clásico (anexo III.3.1; formalización propia
% a partir de OBSTFELD, 1997, y EICHENGREEN, 1992). BASE COMÚN I, que se reutiliza para entreguerras (III.6) y para Bretton
% Woods (III.9). Eje horizontal: tamaño de la perturbación, |epsilon|. Vertical: coste. Coste político de defender:
% theta0 kappa0 epsilon^2 = 0,1 epsilon^2. Coste de abandonar en tiempos de paz: C = 3, umbral epsilon0 = raíz(30) = 5,477.
% Coste de abandonar en una guerra (regla contingente): C_g = 0,4, umbral epsilon_g = 2.
% Generar desde la carpeta del tema: bash Code/generar_figura.sh anx_clausula_escape
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=2mm]}, x=1.2cm, y=1.0cm]
  % ejes
  \draw[->] (0,0) -- (6.9,0) node[below left] {$|\varepsilon|$};
  \draw[->] (0,0) -- (0,4.5) node[left] {coste};
  % coste de abandonar
  \draw[black!90, thick] (0,3) -- (6.4,3) node[right] {$C$};
  \draw[black!60, thick, dashed] (0,0.4) -- (6.4,0.4) node[right] {$C_g$};
  % coste político de defender
  \draw[black!90, very thick] plot[domain=0:6.3, samples=80] (\x,{0.1*\x*\x}) node[above] {$\theta_0\kappa_0\,\varepsilon^2$};
  % umbrales
  \draw[black!40, densely dotted] (5.477,3) -- (5.477,0);
  \node[below] at (5.477,0) {$\bar{\varepsilon}_0$};
  \draw[black!40, densely dotted] (2,0.4) -- (2,0);
  \node[below] at (2,0) {$\bar{\varepsilon}_g$};
  \fill (5.477,3) circle (1.4pt);
  \fill (2,0.4) circle (1.4pt);
\end{tikzpicture}
