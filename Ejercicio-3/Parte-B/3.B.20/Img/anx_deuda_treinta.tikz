% anx_deuda_treinta: por qué dejaron de pagar los Estados en los años treinta (anexo II.7.2). BASE COMÚN F (anx_deuda_soberana).
% Antes (gris): carga real (1+r)B con pendiente 1 y coste de impagar C_R + C_S = 3,6, que permite una deuda de hasta 3,6.
% Después (negro): la deflación eleva la carga real de la misma deuda (pendiente 1,33, precios un 25 % más bajos) y el coste de
% impagar cae a 1,4 (sin sanciones y con impagos generalizados). Deuda existente Bbar = 2,8: antes se pagaba (2,8 < 3,6);
% después, su carga real (3,73) supera con mucho el coste de impagar (1,4). Límite nuevo: 1,4 / 1,33 = 1,05.
% Generar desde la carpeta del tema: bash Code/generar_figura.sh anx_deuda_treinta
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=2mm]}, x=1.15cm, y=1.0cm]
  \draw[->] (0,0) -- (6.4,0) node[below left] {$B$};
  \draw[->] (0,0) -- (0,5.2);
  % antes
  \draw[black!40, very thick] (0,0) -- (4.9,4.9);
  \draw[black!40, thick, dashed] (0,3.6) -- (6.0,3.6) node[right, black!55] {$C_R+C_S$};
  \fill[black!45] (3.6,3.6) circle (1.4pt);
  % después
  \draw[black!90, very thick] (0,0) -- (3.75,5.0) node[above] {$\dfrac{(1+r)\,B}{P}$};
  \draw[black!90, thick, dashed] (0,1.4) -- (6.0,1.4) node[right] {$C_R'$};
  \fill (1.05,1.4) circle (1.4pt);
  \draw[->, thick, black!70] (5.6,3.5) -- (5.6,1.5);
  % deuda existente
  \draw[black!60, densely dotted, thick] (2.8,0) -- (2.8,3.73);
  \fill (2.8,3.73) circle (1.4pt);
  \fill[black!45] (2.8,2.8) circle (1.4pt);
  \node[below] at (2.8,0) {$\bar{B}$};
  \draw[black!40, densely dotted] (3.6,0) -- (3.6,3.6);
  \draw[black!40, densely dotted] (1.05,0) -- (1.05,1.4);
  \node[below] at (3.6,0) {$B^{*}_{1}$};
  \node[below] at (1.05,0) {$B^{*}_{2}$};
\end{tikzpicture}
