% b2_trilema: el trilema de la economía abierta en los años treinta (bloque 2, Desenlace). MISMA BASE COMÚN B que b1_trilema y
% misma geometría. El patrón de cambios oro intentó los tres a la vez (punto interior); tras 1931, cada bloque salió hacia un
% lado: el área de la libra, a la autonomía con movilidad del capital (base, flotación); Alemania y Europa central, al tipo
% fijo con autonomía (lado izquierdo, control de cambios); el bloque oro, al tipo fijo con movilidad del capital (lado derecho,
% sin autonomía, hasta 1936). Distinta de anx_trilema_sistemas (síntesis del anexo I), que da el lado de cada sistema.
% Generar desde la carpeta del tema: bash Code/generar_figura.sh b2_trilema
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=2.2mm]},
    vertice/.style={draw=black!85, thick, fill=black!8, align=center, inner sep=3pt, text width=2.9cm, execute at begin node={\hyphenpenalty=10000}},
    salida/.style={align=center, inner sep=2pt, text width=2.7cm, font=\footnotesize, execute at begin node={\hyphenpenalty=10000}}]
  \coordinate (F) at (0,3.6);
  \coordinate (A) at (-3.6,0);
  \coordinate (M) at (3.6,0);
  \draw[black!35, thin] (F) -- (A) -- (M) -- cycle;
  \node[vertice, anchor=south] at (F) {Tipo de cambio fijo};
  \node[vertice, anchor=north] at (A) {Autonomía monetaria};
  \node[vertice, anchor=north] at (M) {Libre movilidad del capital};
  % el patrón de cambios oro, dentro
  \fill[black!70] (0,1.2) circle (2pt);
  \node[text=black!60, font=\scriptsize\itshape, above=2pt] at (0,1.2) {1925-1931};
  % salidas de los años treinta
  \draw[->, thick, black!75] (0.08,1.12) -- (1.62,1.8);
  \draw[->, thick, black!75] (-0.08,1.12) -- (-1.62,1.8);
  \draw[->, thick, black!75] (0,1.08) -- (0,0.1);
  \node[salida, anchor=west] at (2.0,2.15) {Bloque oro\\(hasta 1936)};
  \node[salida, anchor=east] at (-2.0,2.15) {Control de cambios\\(Alemania)};
  \node[salida, anchor=north] at (0,-0.15) {Área de la libra\\(flotación)};
\end{tikzpicture}
