% anx_clausula_bw: el coste político de defender una paridad ajustable en Bretton Woods (anexo III.9.1; formalización propia a
% partir de OBSTFELD, 1997). MISMA BASE COMÚN I que anx_clausula_escape y anx_clausula_entreguerras. En gris discontinuo, la
% curva de entreguerras, 0,25 epsilon^2, con C = 3 y umbral epsilon1 = raíz(12) = 3,464. En Bretton Woods, la financiación del
% Fondo, f = 1,5, absorbe las perturbaciones menores (coste nulo) y desplaza la curva: 0,25 (|epsilon| - 1,5)^2; el coste de
% abandonar, menor porque la paridad puede cambiarse legalmente, es C_BW = 2, y el umbral, epsilon_BW = 1,5 + raíz(8) = 4,328.
% Llave: perturbaciones habituales, de 0 a 3.
% Generar desde la carpeta del tema: bash Code/generar_figura.sh anx_clausula_bw
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=2mm]}, x=1.2cm, y=1.0cm]
  % ejes
  \draw[->] (0,0) -- (6.9,0) node[below left] {$|\varepsilon|$};
  \draw[->] (0,0) -- (0,4.6) node[left] {coste};
  % coste de abandonar: entreguerras (referencia) y Bretton Woods
  \draw[black!45, thick, dashed] (0,3) -- (6.4,3) node[right, text=black!55] {$C$};
  \draw[black!90, thick] (0,2) -- (6.4,2) node[right] {$C_{BW}$};
  % coste político de defender: entreguerras (referencia)
  \draw[black!45, thick, dashed] plot[domain=0:4.0, samples=80] (\x,{0.25*\x*\x}) node[above, text=black!55] {$\theta_1\kappa_1\,\varepsilon^2$};
  % Bretton Woods: la financiación f absorbe las perturbaciones menores
  \draw[black!90, very thick] (0,0) -- (1.5,0) -- plot[domain=1.5:5.6, samples=80] (\x,{0.25*(\x-1.5)*(\x-1.5)}) node[above] {$\theta_2\kappa_2\,(|\varepsilon|-f)^2$};
  % umbrales
  \draw[black!35, densely dotted] (3.464,3) -- (3.464,0);
  \node[below, text=black!55] at (3.464,0) {$\bar{\varepsilon}_1$};
  \fill[black!45] (3.464,3) circle (1.3pt);
  \draw[black!40, densely dotted] (4.328,2) -- (4.328,0);
  \node[below] at (4.328,0) {$\bar{\varepsilon}_{BW}$};
  \fill (4.328,2) circle (1.4pt);
  % financiación
  \draw[black!70] (1.5,0.08) -- (1.5,-0.08);
  \node[below] at (1.5,0) {$f$};
  % perturbaciones habituales
  \draw[decorate, decoration={brace, mirror, amplitude=4pt}, black!60] (0,-0.62) -- (3.0,-0.62) node[midway, below=4pt, font=\scriptsize, text=black!70] {perturbaciones habituales};
\end{tikzpicture}
