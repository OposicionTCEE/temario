% b1_trilema: el trilema de la economía abierta y el vértice del patrón oro clásico (bloque 1, Moneda). BASE COMÚN B del tema:
% triángulo del trilema (MUNDELL; OBSTFELD, SHAMBAUGH y TAYLOR, 2005) con el lado que elige cada sistema. Se reutiliza en el
% bloque 2 (cada país elige su vértice en los años treinta) y en el bloque 3 (Bretton Woods y el euromercado). Misma geometría
% que b1_trilema_politico: el vértice al que se renuncia va siempre abajo a la izquierda.
% Generar desde la carpeta del tema: bash Code/generar_figura.sh b1_trilema
\begin{tikzpicture}[font=\footnotesize,
    vertice/.style={draw=black!85, thick, fill=black!8, align=center, inner sep=3pt, text width=2.9cm, execute at begin node={\hyphenpenalty=10000}},
    renuncia/.style={draw=black!45, dashed, text=black!55, align=center, inner sep=3pt, text width=2.9cm, execute at begin node={\hyphenpenalty=10000}},
    lado/.style={align=left, inner sep=2pt, text width=3.3cm, execute at begin node={\hyphenpenalty=10000}}]
  \coordinate (F) at (0,4.2);
  \coordinate (A) at (-4.0,0);
  \coordinate (M) at (4.0,0);
  \draw[black!35, thin] (F) -- (A) -- (M);
  \draw[black!90, line width=2.4pt] (F) -- (M);
  \node[vertice, anchor=south] at (F) {Tipo de cambio fijo};
  \node[renuncia, anchor=north] at (A) {Autonomía monetaria};
  \node[font=\scriptsize, text=black!55] at (-4.0,-1.05) {se renuncia};
  \node[vertice, anchor=north] at (M) {Libre movilidad del capital};
  \node[lado, anchor=west, font=\footnotesize\bfseries] at (2.35,2.35) {Patrón oro clásico\\(1880-1914)};
\end{tikzpicture}
