% anx_puntos: el mercado de letras sobre Londres en Nueva York y los puntos del oro como resultado del arbitraje (anexo I.2).
% Misma base que b1_banda (BASE A), sin desplazamientos: lo que añade es de dónde salen los tramos horizontales y el
% ensanchamiento de la banda con los gold devices.
% Eje vertical: e, dólares por libra. Banda: E^M = 1,5; E^par = 2,5; E^X = 3,5. Con gold devices, E^X' = 3,9.
% Oferta: e = 0,6 + 1,036 (Q - 0,8) hasta E^X (Q = 3,6), horizontal después (con gold devices, sigue hasta E^X' en Q = 3,99).
% Demanda: e = 4,6 - 0,816 (Q - 0,6) hasta E^M (Q = 4,4), horizontal después. A = (2,87; 2,75).
% Generar desde la carpeta del tema: bash Code/generar_figura.sh anx_puntos
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=2mm]}, x=1.25cm, y=1.0cm]
  \fill[black!7] (0,1.5) rectangle (7.0,3.5);
  \draw[->] (0,0) -- (7.3,0) node[below left] {Libras};
  \draw[->] (0,0) -- (0,5.0) node[left] {$e$};
  \draw[black!50, dashed] (0,3.5) -- (7.0,3.5);
  \draw[black!50, densely dotted] (0,2.5) -- (7.0,2.5);
  \draw[black!50, dashed] (0,1.5) -- (7.0,1.5);
  \draw[black!35, dashed] (0,3.9) -- (7.0,3.9);
  \node[left] at (0,3.5) {$E^{X}$};
  \node[left] at (0,2.5) {$E^{par}$};
  \node[left] at (0,1.5) {$E^{M}$};
  \node[left, black!55] at (0,3.95) {$E^{X\prime}$};
  % oferta de libras: comerciantes y, en E^X, arbitrajistas que exportan oro
  \draw[black!85, thick] (0.8,0.6) -- (3.6,3.5) -- (6.6,3.5);
  \draw[black!40, thick, dashed] (3.6,3.5) -- (3.99,3.9) -- (6.6,3.9);
  \node at (1.15,1.55) {$S$};
  % demanda de libras: comerciantes y, en E^M, arbitrajistas que importan oro
  \draw[black!85, thick] (0.6,4.6) -- (4.4,1.5) -- (6.6,1.5);
  \node at (0.95,4.75) {$D$};
  \fill (2.87,2.75) circle (1.5pt) node[left=2pt] {$A$};
  % rótulos de los tramos de arbitraje
  \node[above, font=\scriptsize] at (5.4,3.5) {exportación de oro};
  \node[below, font=\scriptsize] at (5.4,1.5) {importación de oro};
  \node[above, font=\scriptsize, black!55] at (5.4,3.9) {con \textit{gold devices}};
\end{tikzpicture}
