% anx_hegemonia_bw: la provisión del orden de posguerra por Estados Unidos (anexo III.7.2; formalización propia a partir de
% OLSON, 1965, y KINDLEBERGER, 1981). MISMA BASE COMÚN H que anx_hegemonia y anx_hegemonia_entreguerras. En gris discontinuo,
% la frontera sin Guerra Fría, y_i o_i = C/B = 0,25. La Guerra Fría añade al beneficio de Estados Unidos un valor estratégico S,
% que desplaza su frontera hasta y_i o_i = (C - S)/B = 0,12 (trazo grueso; zona sombreada encima). Posiciones CUALITATIVAS de
% Estados Unidos: 1925 (0,98; 0,16), en gris, como en anx_hegemonia_entreguerras; 1950 (1,04; 0,175); 1970 (0,72; 0,23).
% Generar desde la carpeta del tema: bash Code/generar_figura.sh anx_hegemonia_bw
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=2mm]}, x=6.2cm, y=4.6cm]
  % zona en la que Estados Unidos provee solo con la Guerra Fría
  \fill[black!10] plot[domain=0.12:1.12, samples=100] (\x,{0.12/\x}) -- (1.12,1.0) -- (0.12,1.0) -- cycle;
  \node[font=\scriptsize, text=black!70] at (0.92,0.86) {provee solo};
  \node[font=\scriptsize, text=black!70] at (0.24,0.10) {no provee solo};
  % ejes
  \draw[->] (0,0) -- (1.2,0) node[below left] {$y_i$};
  \draw[->] (0,0) -- (0,1.08) node[left] {$o_i$};
  \node[below, font=\scriptsize] at (0.6,-0.03) {tamaño relativo};
  \node[rotate=90, font=\scriptsize] at (-0.07,0.5) {dependencia del orden abierto};
  % frontera sin Guerra Fría
  \draw[black!45, thick, dashed] plot[domain=0.25:1.12, samples=80] (\x,{0.25/\x});
  \node[anchor=south west, text=black!55] at (0.255,1.0) {$y_i\,o_i=C/B$};
  % frontera con Guerra Fría
  \draw[black!90, very thick] plot[domain=0.12:1.12, samples=100] (\x,{0.12/\x});
  \node[anchor=west] at (1.12,0.107) {$y_i\,o_i=(C-S)/B$};
  % desplazamiento de la frontera por el valor estratégico
  \draw[->, black!60, thick] (0.5,0.47) -- (0.5,0.27) node[midway, right] {$S$};
  % Estados Unidos
  \fill[black!45] (0.98,0.16) circle (1.4pt) node[left=2pt, text=black!55, font=\scriptsize] {1925};
  \fill (1.04,0.175) circle (1.6pt) node[right=2pt] {1950};
  \fill (0.72,0.23) circle (1.6pt) node[above=2pt] {1970};
  \draw[->, black!60, thick] (1.022,0.178) -- (0.742,0.227);
\end{tikzpicture}
