% b3_banda: la paridad ajustable de Bretton Woods en el mercado de divisas (bloque 3, Moneda). MISMA BASE COMÚN A que b1_banda
% y b2_banda, con las mismas curvas S0 (e = 0,6 + 1,036 (Q - 0,8)), D0 (e = 4,6 - 0,816 (Q - 0,6)) y D1 (desde (3,2; 4,6) con
% pendiente -0,824). La banda es ahora estrecha, en torno a una paridad con el dólar: E^par = 2,6 y límites 2,3 y 2,9 (±1 %,
% exagerado para que se vea). A = (2,87; 2,75). Ante D0 -> D1, el tipo llega al límite superior en B = (3,02; 2,9) y el banco
% central vende divisas hasta C = (5,263; 2,9): el tramo BC lo financia el Fondo. Si el desequilibrio es fundamental, la paridad
% cambia: nueva banda en torno a E^par' = 3,93 (límites 3,63 y 4,23), con el nuevo equilibrio A' = (4,013; 3,93) = S0 ∩ D1.
% Generar desde la carpeta del tema: bash Code/generar_figura.sh b3_banda
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=2mm]}, x=1.2cm, y=1.0cm]
  % bandas: antes y después del cambio de paridad
  \fill[black!7] (0,2.3) rectangle (8.0,2.9);
  \fill[black!13] (0,3.63) rectangle (8.0,4.23);
  \draw[->] (0,0) -- (8.6,0) node[below left] {Divisas};
  \draw[->] (0,0) -- (0,5.2) node[left] {$e$};
  \draw[black!50, dashed] (0,2.9) -- (8.0,2.9);
  \draw[black!50, densely dotted] (0,2.6) -- (8.0,2.6);
  \draw[black!50, dashed] (0,2.3) -- (8.0,2.3);
  \draw[black!60, dashed] (0,4.23) -- (8.0,4.23);
  \draw[black!60, densely dotted] (0,3.93) -- (8.0,3.93);
  \draw[black!60, dashed] (0,3.63) -- (8.0,3.63);
  \node[left] at (0,2.6) {$E^{par}$};
  \node[left] at (0,3.93) {$E^{par\prime}$};
  % oferta y demandas
  \draw[black!85, thick] (0.8,0.6) -- (4.95,4.9);
  \node at (1.05,1.45) {$S_0$};
  \draw[black!40, thick] (0.6,4.6) -- (5.5,0.6);
  \node[black!55] at (0.95,4.78) {$D_0$};
  \draw[black!85, thick] (3.2,4.6) -- (7.6,0.97);
  \node at (3.5,4.78) {$D_1$};
  % puntos
  \fill (2.87,2.75) circle (1.5pt) node[left=2pt] {$A$};
  \fill (3.02,2.9) circle (1.5pt) node[above left] {$B$};
  \fill (5.263,2.9) circle (1.5pt) node[above right] {$C$};
  \fill (4.013,3.93) circle (1.5pt) node[above right=1pt] {$A'$};
  % ajuste: financiación en la banda y cambio de paridad
  \draw[black!80, thick, densely dashed] (3.02,2.9) -- (5.263,2.9);
  \draw[->, black!70, densely dashed] (2.93,2.8) to[out=40, in=170] (5.15,2.95);
  \draw[decorate, decoration={brace, mirror, amplitude=3pt}] (3.02,2.78) -- (5.263,2.78) node[midway, below=3pt, fill=black!7, inner sep=1pt, font=\scriptsize] {financiación};
  \draw[->, thick, black!70] (7.55,2.65) -- (7.55,3.88) node[midway, right, font=\scriptsize, text=black!75] {devaluación};
\end{tikzpicture}
