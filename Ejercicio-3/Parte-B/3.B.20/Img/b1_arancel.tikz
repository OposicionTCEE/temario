% b1_arancel: la invasión del grano y el arancel en un país europeo importador (bloque 1, Desenlace). BASE COMÚN D: mismo mercado
% europeo que el panel derecho de b1_cuna (S_E: P = 1,5 + 0,5 Q; D_E: P = 6,5 - 0,5 Q; autarquía 4,0). Adaptada de arancel_grano.
% Antes de la invasión, P0 = 3,9 (oferta 4,8; demanda 5,2). Después, P_w = 3,0 (oferta 3,0; demanda 7,0).
% Con un arancel t = 0,5, precio interior P_w + t = 3,5 (oferta 4,0; demanda 6,0).
% a: ganancia de los productores (renta de la tierra); b y d: pérdidas de eficiencia; c: recaudación; a+b+c+d: pérdida de los consumidores.
% Generar desde la carpeta del tema: bash Code/generar_figura.sh b1_arancel
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=2mm]}, x=1.0cm, y=0.85cm]
  \draw[->] (0,0) -- (9.3,0) node[below left] {Trigo};
  \draw[->] (0,0) -- (0,6.9) node[left] {$P$};
  % áreas
  \fill[black!30] (0,3.0) -- (3.0,3.0) -- (4.0,3.5) -- (0,3.5) -- cycle;
  \fill[black!12] (3.0,3.0) -- (4.0,3.5) -- (4.0,3.0) -- cycle;
  \fill[black!50] (4.0,3.0) rectangle (6.0,3.5);
  \fill[black!12] (6.0,3.5) -- (7.0,3.0) -- (6.0,3.0) -- cycle;
  \node at (1.6,3.25) {$a$};
  \node at (3.68,3.17) {$b$};
  \node[text=white] at (5.0,3.25) {$c$};
  \node at (6.32,3.17) {$d$};
  % curvas
  \draw[black!85, thick] (0,1.5) -- (9.0,6.0) node[above left] {$S_E$};
  \draw[black!85, thick] (0,6.5) -- (9.0,2.0) node[above right] {$D_E$};
  % precios
  \draw[black!45, densely dotted] (0,3.9) -- (8.2,3.9);
  \draw[black!70, dashed] (0,3.5) -- (8.2,3.5);
  \draw[black!85] (0,3.0) -- (8.2,3.0);
  \node[left] at (0,3.95) {$P_0$};
  \node[left] at (0,3.45) {$P_w+t$};
  \node[left] at (0,3.0) {$P_w$};
  \draw[->, thick, black!70] (8.55,3.85) -- (8.55,3.07) node[midway, right, align=left] {invasión\\ del grano};
  % cantidades
  \draw[black!40, densely dotted] (3.0,0) -- (3.0,3.0);
  \draw[black!40, densely dotted] (4.0,0) -- (4.0,3.0);
  \draw[black!40, densely dotted] (6.0,0) -- (6.0,3.0);
  \draw[black!40, densely dotted] (7.0,0) -- (7.0,3.0);
  \node[below] at (3.0,0) {$Q^S_w$};
  \node[below] at (4.0,0) {$Q^S_t$};
  \node[below] at (6.0,0) {$Q^D_t$};
  \node[below] at (7.0,0) {$Q^D_w$};
\end{tikzpicture}
