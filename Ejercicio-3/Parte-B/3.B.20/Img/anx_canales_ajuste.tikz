% Figura (Anexo I, «El ajuste de la balanza de pagos»): los tres canales de ajuste del patrón oro ante un déficit.
% A la izquierda, el punto de partida común; en cada fila, la cadena de un canal y, a la derecha, su velocidad y su coste.
% Generar con: bash Code/generar_figura.sh anx_canales_ajuste
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]},
    caja/.style={draw, rounded corners=2pt, align=center, inner sep=3pt, minimum height=0.9cm},
    paso/.style={draw, align=center, inner sep=3pt, minimum height=0.9cm, text width=2.4cm, execute at begin node={\hyphenpenalty=10000}},
    nota/.style={align=left, text width=2.75cm, execute at begin node={\hyphenpenalty=10000}}]
  % punto de partida
  \node[caja, text width=2.35cm, execute at begin node={\hyphenpenalty=10000}, fill=gray!12] (ini) at (0,0) {Déficit exterior:\\ el tipo de cambio llega a $E^{X}$\\ y sale oro};
  % canal de precios
  \node[paso] (p1) at (3.75,1.9) {La cantidad de dinero cae};
  \node[paso, right=0.4cm of p1] (p2) {Los precios bajan\\ (teoría cuantitativa)};
  \node[paso, right=0.4cm of p2] (p3) {Sube la competitividad: $X\uparrow$, $M\downarrow$};
  \node[nota, right=0.3cm of p3] (n1) {\textbf{Precios} (HUME 1752).\\ Lento: exige precios flexibles};
  % canal de renta
  \node[paso] (r1) at (3.75,0) {Suben los tipos de interés};
  \node[paso, right=0.4cm of r1] (r2) {Caen la inversión y la renta (multiplicador)};
  \node[paso, right=0.4cm of r2] (r3) {Caen las importaciones};
  \node[nota, right=0.3cm of r3] (n2) {\textbf{Renta}.\\ Corrige a costa de producción y empleo};
  % canal del capital
  \node[paso] (k1) at (3.75,-1.9) {El banco central sube el tipo de descuento};
  \node[paso, right=0.4cm of k1] (k2) {Entra capital a corto plazo};
  \node[paso, right=0.4cm of k2] (k3) {El déficit se financia y $e$ vuelve a la banda};
  \node[nota, right=0.3cm of k3] (n3) {\textbf{Capital}.\\ Inmediato: depende de la credibilidad};
  % flechas
  \foreach \a in {p1,r1,k1} \draw[->] (ini.east) -- (\a.west);
  \draw[->] (p1) -- (p2); \draw[->] (p2) -- (p3);
  \draw[->] (r1) -- (r2); \draw[->] (r2) -- (r3);
  \draw[->] (k1) -- (k2); \draw[->] (k2) -- (k3);
\end{tikzpicture}
