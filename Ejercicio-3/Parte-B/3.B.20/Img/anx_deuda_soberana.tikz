% anx_deuda_soberana: el límite de endeudamiento de un Estado soberano (anexo II.2.2; EATON y GERSOVITZ, 1981; BULOW y ROGOFF,
% 1989). BASE COMÚN F del anexo II (se reutiliza en II.7 para los impagos de los años treinta).
% Eje horizontal: deuda B. Vertical: valor. El Estado paga mientras (1+r)B <= C, el coste de impagar. Con solo reputación,
% C = C_R = 2; con sanciones, C = C_R + C_S = 3,6. Límites: B*_0 = 2 y B*_1 = 3,6 (recta (1+r)B con pendiente 1, ilustrativa).
% Generar desde la carpeta del tema: bash Code/generar_figura.sh anx_deuda_soberana
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=2mm]}, x=1.15cm, y=1.0cm]
  \draw[->] (0,0) -- (6.4,0) node[below left] {$B$};
  \draw[->] (0,0) -- (0,5.2);
  % coste de pagar
  \draw[black!90, very thick] (0,0) -- (4.9,4.9) node[above right] {$(1+r)\,B$};
  % costes de impagar
  \draw[black!55, thick, dashed] (0,2.0) -- (6.0,2.0) node[right] {$C_R$};
  \draw[black!90, thick, dashed] (0,3.6) -- (6.0,3.6) node[right] {$C_R+C_S$};
  \draw[->, thick, black!70] (5.6,2.1) -- (5.6,3.5) node[midway, right] {$C_S$};
  % límites
  \draw[black!40, densely dotted] (2.0,0) -- (2.0,2.0);
  \draw[black!40, densely dotted] (3.6,0) -- (3.6,3.6);
  \fill (2.0,2.0) circle (1.4pt);
  \fill (3.6,3.6) circle (1.4pt);
  \node[below] at (2.0,0) {$B^{*}_{0}$};
  \node[below] at (3.6,0) {$B^{*}_{1}$};
\end{tikzpicture}
