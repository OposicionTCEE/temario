% b1_banda: el mercado de divisas en el patrón oro (bloque 1, Moneda). BASE COMÚN A del tema: mercado de divisas de un país
% con la banda de los puntos del oro. Se reutiliza en el bloque 2 (ajuste asimétrico y especulación desestabilizadora) y en el
% bloque 3 (banda de Bretton Woods, problema de la n-1). Adaptada de oro_puntos_reglas (dos paneles reunidos en uno).
% Eje vertical: e, precio de la divisa en moneda nacional; horizontal: cantidad de divisas.
% Banda: E^M = 1,5 (punto de importación de oro), E^par = 2,5 (paridad), E^X = 3,5 (punto de exportación de oro).
% Oferta S0: e = 0,6 + 1,036 (Q - 0,8) hasta E^X (Q = 3,6) y horizontal después. Demanda D0: e = 4,6 - 0,816 (Q - 0,6) hasta
% E^M y horizontal después. A = (2,87; 2,75).
% Perturbación: la demanda pasa a D1 (desplazada 2,6) y corta la oferta en C = (4,55; 3,5); B = (3,6; 3,5); BC = salida de oro.
% Entrada de capital: la oferta pasa a S1 (desplazada 2,044); nuevo equilibrio A' = (5,16; 3,0), dentro de la banda.
% Generar desde la carpeta del tema: bash Code/generar_figura.sh b1_banda
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=2mm]}, x=1.3cm, y=1.0cm]
  \fill[black!7] (0,1.5) rectangle (7.0,3.5);
  \draw[->] (0,0) -- (7.3,0) node[below left] {Divisas};
  \draw[->] (0,0) -- (0,5.0) node[left] {$e$};
  \draw[black!50, dashed] (0,3.5) -- (7.0,3.5);
  \draw[black!50, densely dotted] (0,2.5) -- (7.0,2.5);
  \draw[black!50, dashed] (0,1.5) -- (7.0,1.5);
  \node[left] at (0,3.5) {$E^{X}$};
  \node[left] at (0,2.5) {$E^{par}$};
  \node[left] at (0,1.5) {$E^{M}$};
  % ofertas: inicial y tras la entrada de capital
  \draw[black!45, thick] (0.8,0.6) -- (3.6,3.5) -- (6.6,3.5);
  \node[black!55] at (1.05,1.45) {$S_0$};
  \draw[black!85, thick] (2.844,0.6) -- (5.644,3.5) -- (6.6,3.5);
  \node at (3.15,0.75) {$S_1$};
  % demandas: inicial y tras la perturbación
  \draw[black!45, thick] (0.6,4.6) -- (4.4,1.5) -- (6.6,1.5);
  \node[black!55] at (0.95,4.75) {$D_0$};
  \draw[black!85, thick] (3.2,4.6) -- (6.84,1.6);
  \node at (3.5,4.75) {$D_1$};
  % puntos y camino de ajuste
  \fill (2.87,2.75) circle (1.5pt) node[left=2pt] {$A$};
  \fill (3.6,3.5) circle (1.5pt) node[above left] {$B$};
  \fill (4.55,3.5) circle (1.5pt) node[above right] {$C$};
  \fill (5.16,3.0) circle (1.5pt) node[right=2pt] {$A'$};
  \draw[decorate, decoration={brace, mirror, amplitude=3pt}] (3.6,3.38) -- (4.55,3.38) node[midway, below=3pt, fill=black!7, inner sep=1pt] {salida de oro};
  \draw[->, black!70, densely dashed] (2.95,2.85) to[out=60, in=200] (4.45,3.45);
  \draw[->, black!70, densely dotted, thick] (4.62,3.38) to[out=-60, in=170] (5.05,3.02);
  \draw[->, thick, black!70] (2.25,2.05) -- (4.1,2.05) node[midway, below, fill=black!7, inner sep=1pt, font=\scriptsize] {entrada de capital};
\end{tikzpicture}
