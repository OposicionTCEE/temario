% anx_bimetalismo: la analogía hidráulica del bimetalismo (FISHER, 1911, cap. VII), simplificada (anexo I.1.1).
% Tres depósitos: oro no monetario, moneda en circulación (con una capa de oro y otra de plata) y plata no monetaria, unidos
% por la casa de la moneda (tuberías) a la relación legal r_L; el nivel común representa que la relación de mercado queda
% anclada a la legal. Tras un descubrimiento de plata: la plata nueva entra en la moneda y desplaza oro hacia los usos no
% monetarios; los niveles siguen unidos mientras quede oro en la circulación.
% Generar desde la carpeta del tema: bash Code/generar_figura.sh anx_bimetalismo
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=2mm]}]
  % depósitos (paredes)
  \foreach \x in {0,4.6,9.2} {
    \draw[black!85, thick] (\x,3.4) -- (\x,0) -- (\x+3.2,0) -- (\x+3.2,3.4);
  }
  % contenidos
  \fill[black!18] (0.03,0.03) rectangle (3.17,2.1);
  \fill[black!18] (4.63,0.03) rectangle (7.77,0.95);
  \fill[black!45] (4.63,0.95) rectangle (7.77,2.1);
  \fill[black!45] (9.23,0.03) rectangle (12.37,2.1);
  % nivel común
  \draw[black!70, dashed] (-0.4,2.1) -- (12.8,2.1) node[right] {nivel común};
  % tuberías: la casa de la moneda
  \draw[black!85, line width=3pt] (3.2,0.45) -- (4.6,0.45);
  \draw[black!85, line width=3pt] (7.8,0.45) -- (9.2,0.45);
  \node[below, align=center, font=\scriptsize] at (3.9,0.3) {casa de la\\moneda};
  \node[below, align=center, font=\scriptsize] at (8.5,0.3) {casa de la\\moneda};
  % flujos tras un descubrimiento de plata
  \draw[->, very thick, black!80] (10.8,4.3) -- (10.8,2.25) node[pos=0.25, right] {plata nueva};
  \draw[->, thick, black!80] (9.05,0.75) -- (7.95,0.75);
  \draw[->, thick, black!80] (4.45,0.75) -- (3.35,0.75);
  % rótulos
  \node[align=center] at (1.6,-0.65) {Oro no monetario};
  \node[align=center] at (6.2,-0.65) {Moneda en circulación};
  \node[align=center] at (10.8,-0.65) {Plata no monetaria};
  \node at (6.2,0.5) {oro};
  \node[text=white] at (6.2,1.52) {plata};
  \node at (1.6,1.05) {oro};
  \node[text=white] at (10.8,1.05) {plata};
\end{tikzpicture}
