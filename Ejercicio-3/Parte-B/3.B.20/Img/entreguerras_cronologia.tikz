% Figura (bloque 1914-1939, apertura): cronología del sistema económico internacional entre 1914 y 1939.
% Sustituye a la imagen antigua de la cronología de entreguerras. Escala: 1 año = 0,58 cm (1914 en x = 0).
% Franjas: guerra (1914-1918), reconstrucción (1919-1924), patrón restaurado (1925-1928), colapso (1929-1933),
% fragmentación (1933-1939). Hitos arriba (monetarios y financieros) y abajo (comerciales y políticos).
% Generar con: bash Code/generar_figura.sh entreguerras_cronologia
\begin{tikzpicture}[font=\footnotesize, x=0.58cm, y=1cm,
    hito/.style={align=center, inner sep=1.5pt, execute at begin node={\hyphenpenalty=10000}}]
  % franjas de fases
  \fill[gray!30] (0,-0.3) rectangle (4.5,0.3);
  \fill[gray!12] (4.5,-0.3) rectangle (10.5,0.3);
  \fill[gray!22] (10.5,-0.3) rectangle (14.5,0.3);
  \fill[gray!40] (14.5,-0.3) rectangle (19.5,0.3);
  \fill[gray!18] (19.5,-0.3) rectangle (25,0.3);
  \node at (2.25,0) {Guerra};
  \node at (7.5,0) {Reconstrucción};
  \node at (12.5,0) {Restauración};
  \node at (17,0) {Colapso};
  \node at (22.25,0) {Fragmentación};
  \draw (0,-0.3) rectangle (25,0.3);
  % años
  \foreach \a in {1914,1919,1924,1929,1934,1939} {
    \pgfmathsetmacro{\x}{\a-1914}
    \draw (\x,-0.3) -- (\x,-0.42) node[below, inner sep=1pt] {\a};
  }
  % hitos arriba: monetarios y financieros
  \draw[gray] (0,0.3) -- (0,2.05);   \node[hito, anchor=south west] at (-0.2,2.0) {Suspensión de\\ la convertibilidad};
  \draw[gray] (4,0.3) -- (4,0.75);   \node[hito, anchor=south] at (4,0.7) {Comité\\ Cunliffe};
  \draw[gray] (8,0.3) -- (8,2.05);   \node[hito, anchor=south] at (8,2.0) {Génova:\\ patrón cambios oro};
  \draw[gray] (10,0.3) -- (10,0.75); \node[hito, anchor=south] at (10,0.7) {Plan Dawes};
  \draw[gray] (11,0.3) -- (11,3.05); \node[hito, anchor=south] at (11,3.0) {La libra vuelve\\ a la paridad};
  \draw[gray] (13.5,0.3) -- (13.5,1.65); \node[hito, anchor=south] at (13.5,1.6) {Franco\\ Poincaré};
  \draw[gray] (15,0.3) -- (15,0.75); \node[hito, anchor=south] at (15,0.7) {Plan Young\\ y crac};
  \draw[gray] (17,0.3) -- (17,2.35); \node[hito, anchor=south] at (17,2.3) {1931: Creditanstalt,\\ la libra sale del oro};
  \draw[gray] (19.5,0.3) -- (19.5,0.75); \node[hito, anchor=south] at (19.5,0.7) {El dólar sale\\ del oro};
  \draw[gray] (22,0.3) -- (22,1.95); \node[hito, anchor=south east] at (25.2,1.9) {Fin del bloque oro;\\ Acuerdo Tripartito};
  \draw[gray] (22,1.95) -- (23.2,1.95);
  % hitos abajo: comerciales y políticos (dos niveles)
  \draw[gray] (5,-0.75) -- (5,-1.05); \node[hito, anchor=north] at (5,-1.0) {Versalles:\\ reparaciones};
  \draw[gray] (9,-0.3) -- (9,-1.05);  \node[hito, anchor=north] at (9,-1.0) {Ruhr e\\ hiperinflación};
  \draw[gray] (16,-0.3) -- (16,-1.05); \node[hito, anchor=north] at (16,-1.0) {Smoot-Hawley};
  \draw[gray] (20,-0.3) -- (20,-1.05); \node[hito, anchor=north] at (20.6,-1.0) {RTAA};
  \draw[gray] (25,-0.75) -- (25,-1.05); \node[hito, anchor=north east] at (25.2,-1.0) {Guerra};
  \draw[gray] (7,-0.3) -- (7,-2.15);  \node[hito, anchor=north] at (7,-2.1) {Calendario\\ de Londres};
  \draw[gray] (14,-0.3) -- (14,-2.15); \node[hito, anchor=north] at (13.4,-2.1) {Frenazo de los\\ préstamos de EE. UU.};
  \draw[gray] (18,-0.3) -- (18,-2.15); \node[hito, anchor=north] at (18,-2.1) {Ottawa;\\ Lausana};
  \draw[gray] (19.5,-0.75) -- (19.5,-2.15); \node[hito, anchor=north west] at (19.3,-2.1) {Conferencia\\ de Londres};
\end{tikzpicture}
