% anx_factores_especificos: el modelo de factores específicos aplicado a la invasión del grano (anexo II.1.3; O'ROURKE, 1997).
% BASE COMÚN E del anexo II (se reutiliza, con la subida del precio primario, en anx_factores_periferia, II.4.2).
% Eje horizontal: trabajo total, el de la agricultura desde O_A y el de la industria desde O_M (longitud 8).
% Valor del producto marginal en la industria: w = 1 + 0,75 L_A. En la agricultura, antes: w = 7 - 0,75 L_A, que cortan en
% E0 = (4; 4). El grano baja un 30 %: w = 0,7 (7 - 0,75 L_A) = 4,9 - 0,525 L_A, y el nuevo equilibrio es E1 = (3,059; 3,294):
% el salario nominal baja un 17,6 %, menos que el grano; el trabajo pasa de la agricultura a la industria.
% Generar desde la carpeta del tema: bash Code/generar_figura.sh anx_factores_especificos
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=2mm]}, x=0.95cm, y=0.62cm]
  % ejes
  \draw[->] (0,0) -- (0,9.6) node[left] {$w$};
  \draw[->] (8,0) -- (8,9.6) node[right] {$w$};
  \draw (0,0) -- (8,0);
  \node[below left] at (0,0) {$O_A$};
  \node[below right] at (8,0) {$O_M$};
  % industria
  \draw[black!90, thick] (0,1) -- (8,7) node[right] {$P_M\cdot PMgL_M$};
  % agricultura antes y después
  \draw[black!90, thick] (0,7) -- (8,1);
  \node[anchor=south west] at (0.05,7.0) {$P_A^0\cdot PMgL_A$};
  \draw[black!60, thick, dashed] (0,4.9) -- (8,0.7);
  \node[anchor=north west, text=black!70] at (5.6,1.95) {$P_A^1\cdot PMgL_A$};
  % equilibrios
  \draw[black!40, densely dotted] (0,4) -- (4,4) -- (4,0);
  \draw[black!40, densely dotted] (0,3.294) -- (3.059,3.294) -- (3.059,0);
  \fill (4,4) circle (1.4pt) node[above=2pt] {$E_0$};
  \fill (3.059,3.294) circle (1.4pt) node[above left] {$E_1$};
  \node[left] at (0,4) {$w_0$};
  \node[left] at (0,3.294) {$w_1$};
  \node[below] at (4,0) {$L_A^0$};
  \node[below] at (3.059,0) {$L_A^1$};
  \draw[->, thick, black!70] (3.85,-0.95) -- (3.2,-0.95);
\end{tikzpicture}
