% anx_pool_oro: el ataque especulativo contra el pool del oro (anexo I.14.2; SALANT y HENDERSON, 1978; FLOOD y GARBER, 1984).
% (a) Precio: el pool fija Pbar (35 dólares) vendiendo de su existencia; el precio sombra P~(S_t), el que habría sin el pool,
% sube al bajar la existencia: P~ = 20 + 2,5 t, que alcanza Pbar en T = 6. Después del ataque, el precio libre parte de Pbar
% sin salto y sigue subiendo (35 + 2,5 (t - 6)).
% (b) Existencia del pool: S = 10 - 0,8 t hasta T (ventas al flujo de demanda privada a Pbar); en T los especuladores compran
% de una vez lo que queda, S* = 5,2 > 0, y la existencia cae a cero.
% Generar desde la carpeta del tema: bash Code/generar_figura.sh anx_pool_oro
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=2mm]}, x=0.62cm, y=0.13cm]
  % ---------- (a) ----------
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (5.2,52) {(a) Precio del oro};
    \draw[->] (0,0) -- (10.6,0) node[below left] {$t$};
    \draw[->] (0,0) -- (0,48) node[left] {$P$};
    \draw[black!50, densely dotted] (6,0) -- (6,35);
    \node[below] at (6,0) {$T$};
    \draw[black!55, dashed, thick] (0,20) -- (6,35) node[pos=0.45, below right] {$\tilde{P}_t$};
    \draw[black!90, very thick] (0,35) -- (6,35) -- (10,45);
    \node[left] at (0,35) {$\bar{P}$};
    \fill (6,35) circle (1.4pt);
  \end{scope}
  % ---------- (b) ----------
  \begin{scope}[xshift=8.4cm]
    \node[font=\footnotesize\bfseries] at (5.2,52) {(b) Oro del pool};
    \draw[->] (0,0) -- (10.6,0) node[below left] {$t$};
    \draw[->] (0,0) -- (0,48) node[left] {$S$};
    \draw[black!90, very thick] (0,40) -- (6,20.8);
    \draw[black!90, very thick, densely dashed] (6,20.8) -- (6,0);
    \draw[black!90, very thick] (6,0) -- (10,0);
    \draw[black!45, densely dotted] (0,20.8) -- (6,20.8);
    \node[left] at (0,20.8) {$S^{*}$};
    \node[left] at (0,40) {$S_0$};
    \node[below] at (6,0) {$T$};
    \fill (6,20.8) circle (1.4pt);
  \end{scope}
\end{tikzpicture}
