% anx_zona_no_creible: la zona objetivo cuando se espera un realineamiento (anexo I.9.4; BERTOLA y CABALLERO, 1992).
% Misma base que anx_zona_objetivo (banda ±0,595; s = f sin banda). En gris, la curva creíble s = f - 0,4251 sinh f (KRUGMAN, 1991).
% En negro, la curva con expectativa de realineamiento, ilustrativa: s = f + 0,02 sinh(5f), convexa hacia fuera y más empinada que
% los fundamentos cerca de los límites; toca la banda en f = ±0,483, antes que la recta s = f (±0,595) y mucho antes que la creíble (±1,5).
% Generar desde la carpeta del tema: bash Code/generar_figura.sh anx_zona_no_creible
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=2mm]}, x=2.6cm, y=4.0cm]
  % banda
  \fill[black!7] (-1.75,-0.595) rectangle (1.75,0.595);
  \draw[black!50, dashed] (-1.75,0.595) -- (1.75,0.595);
  \draw[black!50, dashed] (-1.75,-0.595) -- (1.75,-0.595);
  \node[left] at (-1.75,0.595) {$\bar{s}$};
  \node[left] at (-1.75,-0.595) {$\underline{s}$};
  % ejes
  \draw[->] (-1.75,0) -- (1.9,0) node[below left] {$f$};
  \draw[->] (0,-0.85) -- (0,0.9) node[left] {$s$};
  % flotación libre
  \draw[black!45, thick, densely dashed] (-0.8,-0.8) -- (0.8,0.8) node[above, black!60] {$s=f$ (sin banda)};
  % curva creíble (referencia)
  \draw[black!40, thick, domain=-1.5:1.5, samples=80, smooth] plot (\x, {\x - 0.4251*sinh(\x)});
  \node[text=black!55, anchor=west] at (1.0,0.47) {creíble};
  % curva con expectativa de realineamiento
  \draw[black!90, very thick, domain=-0.483:0.483, samples=80, smooth] plot (\x, {\x + 0.02*sinh(5*\x)});
  \fill (0.483,0.595) circle (1.4pt);
  \fill (-0.483,-0.595) circle (1.4pt);
  \node[font=\footnotesize\bfseries, anchor=east, align=right] at (-0.12,0.33) {con expectativa\\de realineamiento};
\end{tikzpicture}
