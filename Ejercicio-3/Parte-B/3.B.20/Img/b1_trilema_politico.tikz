% b1_trilema_politico: el trilema político de la economía mundial (RODRIK, 2011) y la camisa de fuerza dorada del patrón oro
% (bloque 1, Sociedad). Misma geometría que b1_trilema (BASE COMÚN B): el vértice al que se renuncia va abajo a la izquierda,
% para que se vea que el patrón oro sacrifica la democracia de masas igual que sacrifica la autonomía monetaria. Se reutiliza en
% el bloque 2 (la camisa de fuerza con democracia) y en el bloque 3 (el compromiso de Bretton Woods).
% Generar desde la carpeta del tema: bash Code/generar_figura.sh b1_trilema_politico
\begin{tikzpicture}[font=\footnotesize,
    vertice/.style={draw=black!85, thick, fill=black!8, align=center, inner sep=3pt, text width=2.9cm, execute at begin node={\hyphenpenalty=10000}},
    renuncia/.style={draw=black!45, dashed, text=black!55, align=center, inner sep=3pt, text width=2.9cm, execute at begin node={\hyphenpenalty=10000}},
    lado/.style={align=left, inner sep=2pt, text width=3.3cm, execute at begin node={\hyphenpenalty=10000}}]
  \coordinate (F) at (0,3.6);
  \coordinate (A) at (-3.6,0);
  \coordinate (M) at (3.6,0);
  \draw[black!35, thin] (F) -- (A) -- (M);
  \draw[black!90, line width=2.4pt] (F) -- (M);
  \node[vertice, anchor=south] at (F) {Integración económica profunda};
  \node[renuncia, anchor=north] at (A) {Democracia de masas\\[-1pt]{\scriptsize (se renuncia)}};
  \node[vertice, anchor=north] at (M) {Estado nación};
  \node[lado, anchor=west, font=\footnotesize\bfseries] at (2.05,2.0) {Camisa de fuerza dorada\\(patrón oro clásico)};
\end{tikzpicture}
