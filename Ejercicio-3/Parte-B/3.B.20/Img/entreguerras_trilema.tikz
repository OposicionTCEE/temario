% Figura (bloque 1914-1939, «El desenlace»): el trilema de la economía abierta aplicado a la historia del sistema.
% Vértices: tipo de cambio fijo, libre movilidad del capital y autonomía monetaria; cada lado es un régimen que
% renuncia al vértice opuesto. Entreguerras quiso los tres a la vez, porque la democracia de masas exigía autonomía.
% Generar con: bash Code/generar_figura.sh entreguerras_trilema
\begin{tikzpicture}[font=\footnotesize,
    vertice/.style={draw, thick, fill=gray!12, align=center, inner sep=3pt, text width=3.0cm, execute at begin node={\hyphenpenalty=10000}},
    lado/.style={align=center, inner sep=2pt, text width=4.0cm, execute at begin node={\hyphenpenalty=10000}}]
  \coordinate (F) at (0,4.6);
  \coordinate (A) at (-4.4,0);
  \coordinate (M) at (4.4,0);
  \draw[thick] (F) -- (A) -- (M) -- cycle;
  \node[vertice, anchor=south] at (F) {Tipo de cambio fijo};
  \node[vertice, anchor=north] at (A) {Autonomía monetaria};
  \node[vertice, anchor=north] at (M) {Libre movilidad del capital};
  % lados
  \node[lado, anchor=east] at (-2.45,2.55) {Controles de capital: Alemania (1931-1939); Bretton Woods (1944-1973)};
  \node[lado, anchor=west] at (2.45,2.55) {Patrón oro clásico (1880-1914) y patrón restaurado (1925-1931)};
  \node[lado, anchor=north, text width=5.4cm] at (0,-0.15) {Flotación: la libra desde 1931};
  % centro
  \node[align=center, text width=3.5cm, draw, dashed, rounded corners=2pt, inner sep=3pt, execute at begin node={\hyphenpenalty=10000}] at (0,1.55) {Entreguerras: se quiso volver al lado derecho cuando la democracia de masas exigía autonomía};
\end{tikzpicture}
