% b2_circuito: el circuito de los pagos de los años veinte (bloque 2, Origen). Esquema sin cifras: los préstamos privados
% estadounidenses a Alemania financiaban las reparaciones a Francia y Gran Bretaña, que pagaban con ellas sus deudas de guerra
% a Estados Unidos. El aspa sobre los préstamos marca su corte en 1928, que rompe el circuito. Un solo panel; sustituye a
% entreguerras_circuito (dos paneles, de la otra sesión), que se retira en el cierre.
% Generar desde la carpeta del tema: bash Code/generar_figura.sh b2_circuito
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=2.2mm]},
    pais/.style={draw=black!85, thick, fill=black!8, align=center, inner sep=4pt, text width=2.7cm, execute at begin node={\hyphenpenalty=10000}},
    flujo/.style={align=center, inner sep=2pt, text width=2.4cm, execute at begin node={\hyphenpenalty=10000}}]
  \node[pais] (us) at (0,3.3) {Estados Unidos};
  \node[pais] (de) at (3.9,0) {Alemania};
  \node[pais] (al) at (-3.9,0) {Francia y Gran Bretaña};
  % préstamos privados, cortados en 1928
  \draw[->, very thick, black!85] (us.east) to[bend left=28]
    node[pos=0.42, font=\Large\bfseries] {$\times$}
    node[pos=0.42, above right=1pt and 3pt, font=\scriptsize] {1928}
    node[flujo, pos=0.72, right=6pt] {préstamos privados} (de.north);
  % reparaciones
  \draw[->, very thick, black!85] (de.west) -- node[flujo, below=2pt] {reparaciones} (al.east);
  % deudas de guerra
  \draw[->, very thick, black!85] (al.north) to[bend left=28] node[flujo, pos=0.3, left=6pt] {deudas de guerra} (us.west);
\end{tikzpicture}
