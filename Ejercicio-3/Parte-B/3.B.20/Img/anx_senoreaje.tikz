% anx_senoreaje: la curva de LAFFER del señoreaje con la demanda de dinero de CAGAN (1956) (anexo I.8.1).
% S(pi) = pi e^{-alpha pi} con alpha = 1 (y gamma = 0): máximo en pi = 1/alpha = 1, S = 1/e = 0,368.
% Déficit d = 0,25: dos inflaciones que lo financian, pi_L = 0,357 y pi_H = 2,153. Déficit d' = 0,45 > máximo: ninguna.
% Generar desde la carpeta del tema: bash Code/generar_figura.sh anx_senoreaje
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=2mm]}, x=2.2cm, y=9.0cm]
  \draw[->] (0,0) -- (4.3,0) node[below left] {$\pi$};
  \draw[->] (0,0) -- (0,0.52) node[left] {$S$};
  % curva del señoreaje
  \draw[black!90, very thick, domain=0:4.1, samples=90, smooth] plot (\x, {\x*exp(-\x)});
  \node[anchor=west] at (3.0,0.18) {$S=\pi\,\dfrac{M}{P}(\pi)$};
  % máximo
  \draw[black!40, densely dotted] (1,0) -- (1,0.368);
  \fill (1,0.368) circle (1.3pt);
  \node[below] at (1,0) {$\pi^{\max}=1/\alpha$};
  % déficit financiable
  \draw[black!60, dashed] (0,0.25) -- (4.1,0.25);
  \node[left] at (0,0.25) {$d$};
  \fill (0.357,0.25) circle (1.3pt);
  \fill (2.153,0.25) circle (1.3pt);
  \draw[black!40, densely dotted] (0.357,0) -- (0.357,0.25);
  \draw[black!40, densely dotted] (2.153,0) -- (2.153,0.25);
  \node[below] at (0.357,0) {$\pi_L$};
  \node[below] at (2.153,0) {$\pi_H$};
  % déficit no financiable
  \draw[black!60, dashed] (0,0.45) -- (4.1,0.45);
  \node[left] at (0,0.45) {$d'$};
\end{tikzpicture}
