% anx_factores_periferia: el modelo de factores específicos aplicado a la periferia (anexo II.4.2; WILLIAMSON, 2011).
% Misma BASE COMÚN E que anx_factores_especificos, pero ahora sube el precio del bien primario, un 30 %.
% Sector primario desde O_A y manufacturas desde O_M (longitud 8). Manufacturas: w = 1 + 0,75 L_A. Primario, antes:
% w = 7 - 0,75 L_A (E0 = (4; 4)); después: w = 1,3 (7 - 0,75 L_A) = 9,1 - 0,975 L_A, y E1 = (4,696; 4,522): el trabajo pasa de
% las manufacturas al sector primario (desindustrialización) y el salario nominal sube un 13 %, menos que el precio primario.
% Generar desde la carpeta del tema: bash Code/generar_figura.sh anx_factores_periferia
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=2mm]}, x=0.95cm, y=0.62cm]
  % ejes
  \draw[->] (0,0) -- (0,9.6) node[left] {$w$};
  \draw[->] (8,0) -- (8,9.6) node[right] {$w$};
  \draw (0,0) -- (8,0);
  \node[below left] at (0,0) {$O_A$};
  \node[below right] at (8,0) {$O_M$};
  % manufacturas
  \draw[black!90, thick] (0,1) -- (8,7) node[right] {$P_M\cdot PMgL_M$};
  % primario antes y después
  \draw[black!60, thick, dashed] (0,7) -- (8,1);
  \node[anchor=north east, text=black!70] at (2.3,5.15) {$P_A^0\cdot PMgL_A$};
  \draw[black!90, thick] (0,9.1) -- (8,1.3);
  \node[anchor=south west] at (0.05,9.1) {$P_A^1\cdot PMgL_A$};
  % equilibrios
  \draw[black!40, densely dotted] (0,4) -- (4,4) -- (4,0);
  \draw[black!40, densely dotted] (0,4.522) -- (4.696,4.522) -- (4.696,0);
  \fill (4,4) circle (1.4pt) node[below right] {$E_0$};
  \fill (4.696,4.522) circle (1.4pt) node[above=2pt] {$E_1$};
  \node[left] at (0,4) {$w_0$};
  \node[left] at (0,4.522) {$w_1$};
  \node[below] at (4,0) {$L_A^0$};
  \node[below] at (4.696,0) {$L_A^1$};
  \draw[->, thick, black!70] (4.15,-0.95) -- (4.8,-0.95);
\end{tikzpicture}
