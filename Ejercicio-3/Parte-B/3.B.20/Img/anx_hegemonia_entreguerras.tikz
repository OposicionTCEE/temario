% anx_hegemonia_entreguerras: la condición de provisión de un bien público internacional en los años veinte (anexo III.4.1;
% KINDLEBERGER, 1973). MISMA BASE COMÚN H que anx_hegemonia: frontera y_i o_i = C/B = 0,25, zona sombreada «provee solo»,
% posiciones CUALITATIVAS. En gris, las posiciones hacia 1880 de anx_hegemonia: Gran Bretaña (0,55; 0,75) y Estados Unidos
% (0,62; 0,16). Hacia 1925: Gran Bretaña (0,30; 0,55), por debajo por falta de capacidad (no podía); Estados Unidos
% (0,98; 0,17), por debajo por falta de interés (no quería).
% Generar desde la carpeta del tema: bash Code/generar_figura.sh anx_hegemonia_entreguerras
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=2mm]}, x=6.2cm, y=4.6cm]
  % zona en la que un país provee solo
  \fill[black!10] plot[domain=0.25:1.12, samples=80] (\x,{0.25/\x}) -- (1.12,1.0) -- (0.25,1.0) -- cycle;
  \node[font=\scriptsize, text=black!70] at (0.92,0.86) {provee solo};
  \node[font=\scriptsize, text=black!70] at (0.20,0.10) {no provee solo};
  % ejes
  \draw[->] (0,0) -- (1.2,0) node[below left] {$y_i$};
  \draw[->] (0,0) -- (0,1.08) node[left] {$o_i$};
  \node[below, font=\scriptsize] at (0.6,-0.03) {tamaño relativo};
  \node[rotate=90, font=\scriptsize] at (-0.07,0.5) {dependencia del orden abierto};
  % frontera de provisión
  \draw[black!90, very thick] plot[domain=0.25:1.12, samples=80] (\x,{0.25/\x});
  \node[anchor=south west] at (0.255,1.0) {$y_i\,o_i=C/B$};
  % posiciones hacia 1880, en gris
  \fill[black!45] (0.55,0.75) circle (1.4pt) node[above, text=black!55, font=\scriptsize] {1880};
  \fill[black!45] (0.62,0.16) circle (1.4pt) node[below, text=black!55, font=\scriptsize] {1880};
  % desplazamientos
  \draw[->, black!60, thick] (0.535,0.735) -- (0.318,0.567);
  \draw[->, black!60, thick] (0.64,0.160) -- (0.958,0.160);
  % posiciones hacia 1925
  \fill (0.30,0.55) circle (1.6pt) node[below=3pt, align=center] {Gran Bretaña\\1925};
  \fill (0.98,0.16) circle (1.6pt) node[below=3pt] {Estados Unidos, 1925};
\end{tikzpicture}
