% Figura (bloque 1815-1914, «La práctica», factores): diagrama de dos países (MACDOUGALL 1960) aplicado a las migraciones.
% Eje horizontal: población activa total; la de Europa se mide desde O_E (izquierda) y la del Nuevo Mundo desde O_N (derecha).
% Productividad marginal del trabajo en Europa: w = 5,5 - 0,47 x; en el Nuevo Mundo: w = 1 + 0,4 x (x medido desde O_E).
% Reparto inicial L0 (x = 7,5): w_E = 1,975 y w_N = 4,0. Con libre migración, L1 (x = 5,17) y w* = 3,07.
% Triángulo sombreado: aumento de la producción mundial.
% Generar con: bash Code/generar_figura.sh migracion_macdougall
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1.1cm, y=1cm]
  % ejes
  \draw[->] (0,0) -- (0,6.0) node[left] {$w_E$};
  \draw[->] (10,0) -- (10,6.0) node[right] {$w_N$};
  \draw (0,0) -- (10,0);
  \node[below] at (0,0) {$O_E$};
  \node[below] at (10,0) {$O_N$};
  % ganancia de eficiencia
  \fill[gray!25] (5.172,3.069) -- (7.5,4.0) -- (7.5,1.975) -- cycle;
  % productividades marginales
  \draw[very thick] (0,5.5) -- (10,0.8) node[below left] {$\mathrm{PMgL}_E$};
  \draw[very thick] (0,1.0) -- (10,5.0) node[above left] {$\mathrm{PMgL}_N$};
  % reparto inicial y final
  \draw[dashed] (7.5,0) -- (7.5,4.0);
  \draw[dashed] (5.172,0) -- (5.172,3.069);
  \node[below] at (7.5,0) {$L_0$};
  \node[below] at (5.172,0) {$L_1$};
  % salarios
  \draw[dotted] (0,1.975) -- (7.5,1.975);
  \draw[dotted] (7.5,4.0) -- (10,4.0);
  \draw[dotted] (0,3.069) -- (10,3.069);
  \node[left] at (0,1.975) {$w_E^0$};
  \node[left] at (0,3.069) {$w^*$};
  \node[right] at (10,3.069) {$w^*$};
  \node[right] at (10,4.0) {$w_N^0$};
  \fill (7.5,1.975) circle (1.6pt);
  \fill (7.5,4.0) circle (1.6pt);
  \fill (5.172,3.069) circle (1.6pt);
  % migración
  \draw[->, thick] (7.3,0.55) -- (5.4,0.55) node[midway, above] {emigración};
  \node[align=left, anchor=west] at (7.7,2.55) {aumento de la\\ producción mundial};
  % rótulos de los países
  \node[align=center] at (2.2,-0.75) {población activa de Europa $\rightarrow$};
  \node[align=center] at (8.0,-0.75) {$\leftarrow$ población activa del Nuevo Mundo};
\end{tikzpicture}
