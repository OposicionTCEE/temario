% Figura (bloque 1815-1914, «El desenlace»): arancel sobre el grano en un país europeo importador (equilibrio parcial).
% Oferta interior: P = 0,5 + 0,6 Q; demanda interior: P = 6 - 0,6 Q.
% Antes de la invasión del grano, precio mundial P0 = 2,8. Después, P_w = 1,6: oferta 1,83, demanda 7,33.
% Con un arancel t = 1, precio interior P_w + t = 2,6: oferta 3,5, demanda 5,67.
% a: ganancia de los productores (renta de la tierra); b y d: pérdidas de eficiencia; c: recaudación.
% Generar con: bash Code/generar_figura.sh arancel_grano
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1.15cm, y=1cm]
  \draw[->] (0,0) -- (9.0,0) node[below left] {Trigo};
  \draw[->] (0,0) -- (0,6.4) node[left] {$P$};
  % áreas
  \fill[gray!35] (0,1.6) -- (1.833,1.6) -- (3.5,2.6) -- (0,2.6) -- cycle;
  \fill[gray!15] (1.833,1.6) -- (3.5,2.6) -- (3.5,1.6) -- cycle;
  \fill[gray!55] (3.5,1.6) rectangle (5.667,2.6);
  \fill[gray!15] (5.667,2.6) -- (7.333,1.6) -- (5.667,1.6) -- cycle;
  \node at (1.3,2.1) {$a$};
  \node at (3.05,1.88) {$b$};
  \node at (4.58,2.1) {$c$};
  \node at (6.15,1.88) {$d$};
  % curvas
  \draw[very thick] (0,0.5) -- (8.5,5.6) node[above left] {$S$};
  \draw[very thick] (0,6.0) -- (8.5,0.9) node[above right] {$D$};
  % precios
  \draw[dotted] (0,2.8) -- (8.5,2.8);
  \draw[dashed] (0,2.6) -- (8.5,2.6);
  \draw (0,1.6) -- (8.5,1.6);
  \node[left] at (0,2.85) {$P_0$};
  \node[left] at (0,2.5) {$P_w+t$};
  \node[left] at (0,1.6) {$P_w$};
  \draw[->, thick] (8.2,2.75) -- (8.2,1.65) node[midway, right, align=left] {invasión\\ del grano};
  % cantidades
  \draw[dotted] (1.833,0) -- (1.833,1.6);
  \draw[dotted] (3.5,0) -- (3.5,1.6);
  \draw[dotted] (5.667,0) -- (5.667,1.6);
  \draw[dotted] (7.333,0) -- (7.333,1.6);
  \node[below] at (1.833,0) {$Q^S_w$};
  \node[below] at (3.5,0) {$Q^S_t$};
  \node[below] at (5.667,0) {$Q^D_t$};
  \node[below] at (7.333,0) {$Q^D_w$};
\end{tikzpicture}
