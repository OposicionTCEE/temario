% anx_u_capital: la U de la movilidad del capital, visión estilizada (anexo II.14; OBSTFELD y TAYLOR, 2004, que la presentan
% también como un esquema estilizado, no como una serie de datos). Eje horizontal: años, de 1860 a 2000 (1 unidad = 10 años,
% x = (año - 1860)/10). Vertical: movilidad del capital, sin escala. Bandas: patrón oro (1880-1914), entreguerras (1914-1939),
% Bretton Woods (1945-1971) y flotación (desde 1973).
% Generar desde la carpeta del tema: bash Code/generar_figura.sh anx_u_capital
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=2mm]}, x=0.95cm, y=1.0cm]
  % bandas de los sistemas
  \fill[black!8] (2.0,0) rectangle (5.4,4.2);
  \fill[black!8] (8.5,0) rectangle (11.1,4.2);
  \node[font=\scriptsize, align=center] at (3.7,4.55) {patrón oro};
  \node[font=\scriptsize, align=center] at (6.65,4.55) {entreguerras};
  \node[font=\scriptsize, align=center] at (9.8,4.55) {Bretton Woods};
  \node[font=\scriptsize, align=center] at (12.6,4.55) {flotación};
  % ejes
  \draw[->] (0,0) -- (14.4,0) node[below left] {año};
  \draw[->] (0,0) -- (0,4.4);
  \node[left, align=right, font=\scriptsize] at (0,3.9) {alta};
  \node[left, align=right, font=\scriptsize] at (0,0.4) {baja};
  \node[rotate=90, font=\footnotesize] at (-0.9,2.1) {movilidad del capital};
  % marcas de los años
  \foreach \a/\x in {1860/0, 1880/2, 1914/5.4, 1929/6.9, 1945/8.5, 1971/11.1, 2000/14}
    \draw (\x,0) -- (\x,-0.08) node[below, font=\scriptsize] {\a};
  % curva estilizada
  \draw[black!90, very thick] plot[smooth, tension=0.6] coordinates {(0,1.9) (2,2.8) (4,3.4) (5.3,3.6) (5.8,1.6) (6.9,2.2) (7.6,1.1) (8.5,0.5) (9.6,0.75) (11.1,1.4) (12.3,2.4) (14,3.8)};
\end{tikzpicture}
