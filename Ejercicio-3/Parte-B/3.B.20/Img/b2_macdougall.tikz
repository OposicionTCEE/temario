% b2_macdougall: las cuotas migratorias en el diagrama de dos países (MACDOUGALL, 1960) (bloque 2, Mercados). MISMA BASE COMÚN C
% que b1_macdougall y mismas curvas: Europa w = 5,5 - 0,47 x; Nuevo Mundo w = 1 + 0,4 x (x desde O_E). Reparto inicial L0
% (x = 7,5); con libre migración, L1 (x = 5,172) y w* = 3,069 (en gris). Con la cuota, la migración se detiene en Lq (x = 6,6):
% w_E^q = 2,398 y w_N^q = 3,64. b_q: lo que la cuota preserva para los trabajadores nativos del Nuevo Mundo frente a la libre
% migración (de L0 a O_N, entre w* y w_N^q). d: producción mundial que la cuota impide (entre las curvas, de L1 a Lq).
% Distinta de anx_cuota_migratoria (anexo II.8.1), que reparte la ganancia entre la que se obtiene y la que se pierde.
% Generar desde la carpeta del tema: bash Code/generar_figura.sh b2_macdougall
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=2mm]}, x=1.3cm, y=0.95cm]
  % áreas
  \fill[black!14] (7.5,3.069) rectangle (10,3.64);
  \fill[black!40] (5.172,3.069) -- (6.6,3.64) -- (6.6,2.398) -- cycle;
  \node at (8.75,3.355) {$b_q$};
  \node at (6.1,3.03) {$d$};
  % ejes
  \draw[->] (0,0) -- (0,6.0) node[left] {$w_E$};
  \draw[->] (10,0) -- (10,6.0) node[right] {$w_N$};
  \draw (0,0) -- (10,0);
  \node[below] at (0,0) {$O_E$};
  \node[below] at (10,0) {$O_N$};
  % productividades marginales
  \draw[black!85, thick] (0,5.5) -- (10,0.8) node[below left] {$\mathrm{PMgL}_E$};
  \draw[black!85, thick] (0,1.0) -- (10,5.0) node[above left] {$\mathrm{PMgL}_N$};
  % repartos
  \draw[black!45, densely dotted] (7.5,0) -- (7.5,3.069);
  \draw[black!45, densely dotted] (5.172,0) -- (5.172,3.069);
  \draw[black!70, thick] (6.6,0) -- (6.6,3.64);
  \node[below] at (7.5,0) {$L_0$};
  \node[below] at (5.172,0) {$L_1$};
  \node[below] at (6.6,0) {$L_q$};
  % salarios
  \draw[black!40, densely dotted] (0,3.069) -- (10,3.069);
  \draw[black!45, densely dotted] (0,2.398) -- (6.6,2.398);
  \draw[black!45, densely dotted] (6.6,3.64) -- (10,3.64);
  \node[left, text=black!55] at (0,3.069) {$w^*$};
  \node[left] at (0,2.398) {$w_E^q$};
  \node[right] at (10,3.64) {$w_N^q$};
  \node[right, text=black!55] at (10,3.069) {$w^*$};
  \fill (6.6,2.398) circle (1.5pt);
  \fill (6.6,3.64) circle (1.5pt);
  \fill[black!50] (5.172,3.069) circle (1.3pt);
  % migración permitida
  \draw[->, thick, black!70] (7.4,0.55) -- (6.7,0.55) node[midway, above, font=\scriptsize] {cuota};
  % rótulos de los países
  \node at (2.2,-0.75) {población activa de Europa $\rightarrow$};
  \node at (8.0,-0.75) {$\leftarrow$ población activa del Nuevo Mundo};
\end{tikzpicture}
