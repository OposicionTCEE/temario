% Figura (bloque 1815-1914, «Las reglas»): mercado de divisas de un país en el patrón oro, con los puntos del oro.
% Eje vertical: tipo de cambio e (precio de la divisa en moneda nacional); horizontal: cantidad de divisas.
% Banda: E^M = 1,5 (punto de importación de oro), E^par = 2,5 (paridad), E^X = 3,5 (punto de exportación de oro).
% Oferta S0: e = 0,6 + 1,036 (Q - 0,8) hasta E^X (Q = 3,6) y horizontal después. Demanda D0: e = 4,6 - 0,816 (Q - 0,6)
% hasta E^M y horizontal después. A = (2,87; 2,75).
% (a) Shock: la demanda pasa a D1 (desplazada 2,6): corta S en C = (4,55; 3,5); B = (3,6; 3,5). BC = salida de oro.
% (b) Regla del juego: sube el tipo de descuento, entra capital y la oferta pasa a S1 (desplazada 2,044):
% nuevo equilibrio A' = (5,16; 3,0), dentro de la banda; cesa la salida de oro.
% Generar con: bash Code/generar_figura.sh oro_puntos_reglas
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=0.92cm, y=1cm]
  % ---------- Panel (a) ----------
  \begin{scope}
    \fill[gray!12] (0,1.5) rectangle (6.6,3.5);
    \draw[->] (0,0) -- (6.8,0) node[below left] {Divisas};
    \draw[->] (0,0) -- (0,5.0) node[left] {$e$};
    \draw[dashed, gray] (0,3.5) -- (6.6,3.5);
    \draw[dotted] (0,2.5) -- (6.6,2.5);
    \draw[dashed, gray] (0,1.5) -- (6.6,1.5);
    \node[left] at (0,3.5) {$E^{X}$};
    \node[left] at (0,2.5) {$E^{par}$};
    \node[left] at (0,1.5) {$E^{M}$};
    % oferta y demanda
    \draw[very thick] (0.8,0.6) -- (3.6,3.5) -- (6.4,3.5) node[above left] {$S$};
    \draw[thick] (0.6,4.6) -- (4.4,1.5) -- (6.4,1.5) node[above left] {$D_0$};
    \draw[thick, dashed] (3.2,4.6) node[right] {$D_1$} -- (6.4,1.99);
    % puntos
    \fill (2.87,2.75) circle (1.6pt) node[left=2pt] {$A$};
    \fill (3.6,3.5) circle (1.6pt) node[above left] {$B$};
    \fill (4.55,3.5) circle (1.6pt) node[above right] {$C$};
    \draw[decorate, decoration={brace, mirror, amplitude=3pt}] (3.6,3.38) -- (4.55,3.38) node[midway, below=3pt, fill=white, inner sep=1pt] {sale oro};
    \node[align=center] at (3.3,-0.8) {(a) Un shock: la demanda de divisas\\ llega al punto de exportación y sale oro};
  \end{scope}
  % ---------- Panel (b) ----------
  \begin{scope}[xshift=8.0cm]
    \fill[gray!12] (0,1.5) rectangle (6.6,3.5);
    \draw[->] (0,0) -- (6.8,0) node[below left] {Divisas};
    \draw[->] (0,0) -- (0,5.0) node[left] {$e$};
    \draw[dashed, gray] (0,3.5) -- (6.6,3.5);
    \draw[dotted] (0,2.5) -- (6.6,2.5);
    \draw[dashed, gray] (0,1.5) -- (6.6,1.5);
    \node[left] at (0,3.5) {$E^{X}$};
    \node[left] at (0,2.5) {$E^{par}$};
    \node[left] at (0,1.5) {$E^{M}$};
    % oferta inicial (gris) y desplazada
    \draw[thick, gray] (0.8,0.6) -- (3.6,3.5) -- (5.0,3.5);
    \node[gray, left] at (1.3,1.2) {$S_0$};
    \draw[very thick] (2.84,0.6) -- (5.644,3.5) -- (6.4,3.5) node[above left] {$S_1$};
    \draw[thick, dashed] (3.2,4.6) node[right] {$D_1$} -- (6.4,1.99);
    \draw[->, thick] (2.4,2.0) -- (4.0,2.0) node[midway, above, fill=gray!12, inner sep=1pt] {entra capital};
    % puntos
    \fill (4.55,3.5) circle (1.6pt) node[above] {$C$};
    \fill (5.16,3.0) circle (1.6pt) node[right=2pt] {$A'$};
    \node[align=center] at (3.3,-0.8) {(b) La regla del juego: sube el tipo de descuento,\\ entra capital y el tipo de cambio vuelve a la banda};
  \end{scope}
\end{tikzpicture}
