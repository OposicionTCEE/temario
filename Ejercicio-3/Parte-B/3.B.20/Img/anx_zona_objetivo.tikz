% anx_zona_objetivo: la banda de los puntos del oro como zona objetivo creíble (KRUGMAN, 1991; aplicada por BORDO y MACDONALD,
% 2005) (anexo I.4.3). s(f) = f + A (e^{lambda f} - e^{-lambda f}), con lambda = 1 y bandas simétricas: la tangencia en el
% límite (s'(f_max) = 0 en f_max = 1,5) da A = -1/(2 cosh 1,5) = -0,2126, de modo que s(f) = f - 0,4251 sinh(f) y el límite
% de la banda es s_max = 1,5 - tanh(1,5) = 0,595. La recta s = f es el tipo de cambio sin banda (flotación libre).
% Generar desde la carpeta del tema: bash Code/generar_figura.sh anx_zona_objetivo
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=2mm]}, x=2.6cm, y=4.0cm]
  % banda
  \fill[black!7] (-1.75,-0.595) rectangle (1.75,0.595);
  \draw[black!50, dashed] (-1.75,0.595) -- (1.75,0.595);
  \draw[black!50, dashed] (-1.75,-0.595) -- (1.75,-0.595);
  \node[left] at (-1.75,0.595) {$\bar{s}$};
  \node[left] at (-1.75,-0.595) {$\underline{s}$};
  % ejes
  \draw[->] (-1.75,0) -- (1.9,0) node[below left] {$f$};
  \draw[->] (0,-0.85) -- (0,0.9) node[left] {$s$};
  % flotación libre
  \draw[black!45, thick, densely dashed] (-0.8,-0.8) -- (0.8,0.8) node[above, black!60] {$s=f$ (sin banda)};
  % curva en S de la zona objetivo creíble
  \draw[black!90, very thick, domain=-1.5:1.5, samples=80, smooth] plot (\x, {\x - 0.4251*sinh(\x)});
  % tangencias
  \fill (1.5,0.595) circle (1.4pt);
  \fill (-1.5,-0.595) circle (1.4pt);
  \draw[black!40, densely dotted] (1.5,0) -- (1.5,0.595);
  \draw[black!40, densely dotted] (-1.5,0) -- (-1.5,-0.595);
  \node[below] at (1.5,0) {$\bar{f}$};
  \node[above] at (-1.5,0) {$\underline{f}$};
  \node[font=\footnotesize\bfseries, anchor=west] at (0.55,0.3) {zona objetivo creíble};
\end{tikzpicture}
