% anx_escasez: la escasez de dólares como exceso de demanda a la paridad oficial (anexo I.12.1; MACHLUP, 1950).
% Base común A del tema (mercado de divisas, como b1_banda): eje vertical e, precio del dólar en moneda nacional; horizontal,
% cantidad de dólares. Oferta S0: e = 0,5 + 0,9 Q; demanda D0: e = 5 - 0,9 Q; equilibrio sin restricciones (2,5; 2,75).
% Paridad oficial E0 = 1,85: oferta 1,5 y demanda 3,5, brecha G0 = 2.
% (a) Financiar: la ayuda A desplaza la oferta a S0 + A (desplazada 2), que corta D0 en (3,5; 1,85), a la paridad oficial.
% (b) Cerrar la brecha: por el precio, devaluación de E0 a E1 = 2,45 (oferta 2,167, demanda 2,833, brecha G1 = 0,667);
% por la cantidad, controles o menos absorción desplazan la demanda a D1 (desplazada -2), que corta S0 en (1,5; 1,85).
% Generar desde la carpeta del tema: bash Code/generar_figura.sh anx_escasez
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=2mm]}, x=1.0cm, y=0.95cm]
  % ---------- (a) ----------
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (3.1,5.45) {(a) Financiar la brecha};
    \draw[->] (0,0) -- (6.4,0) node[below left] {Dólares};
    \draw[->] (0,0) -- (0,5.1) node[left] {$e$};
    \draw[black!55, dashed] (0,1.85) -- (6.2,1.85);
    \node[left] at (0,1.85) {$E_0$};
    \draw[black!85, thick] (0.3,0.77) -- (4.6,4.64) node[above] {$S_0$};
    \draw[black!85, thick] (0.3,4.73) -- (4.9,0.59) node[right] {$D_0$};
    \draw[black!85, thick, densely dashed] (2.3,0.77) -- (6.0,4.10) node[above] {$S_0+A$};
    \draw[->, thick, black!70] (0.95,1.3) -- (2.8,1.3) node[midway, below] {$A$};
    \fill (1.5,1.85) circle (1.4pt);
    \fill (3.5,1.85) circle (1.4pt);
    \draw[decorate, decoration={brace, amplitude=3pt}] (1.5,1.97) -- (3.5,1.97) node[midway, above=3pt, fill=white, inner sep=1pt] {$G_0$};
  \end{scope}
  % ---------- (b) ----------
  \begin{scope}[xshift=7.6cm]
    \node[font=\footnotesize\bfseries] at (3.1,5.45) {(b) Cerrar la brecha};
    \draw[->] (0,0) -- (6.4,0) node[below left] {Dólares};
    \draw[->] (0,0) -- (0,5.1) node[left] {$e$};
    \draw[black!45, dashed] (0,1.85) -- (6.2,1.85);
    \node[left] at (0,1.85) {$E_0$};
    \draw[black!85, dashed] (0,2.45) -- (6.2,2.45);
    \node[left] at (0,2.45) {$E_1$};
    \draw[black!85, thick] (0.3,0.77) -- (4.6,4.64) node[above] {$S_0$};
    \draw[black!85, thick] (0.3,4.73) -- (4.9,0.59) node[right] {$D_0$};
    \draw[black!85, thick, densely dashed] (0.2,3.02) -- (3.2,0.32) node[right] {$D_1$};
    \draw[->, thick, black!70] (4.2,1.2) -- (2.35,1.2);
    \draw[->, thick, black!70] (5.9,1.95) -- (5.9,2.35);
    \fill (1.5,1.85) circle (1.4pt);
    \fill (3.5,1.85) circle (1.4pt);
    \fill (2.167,2.45) circle (1.4pt);
    \fill (2.833,2.45) circle (1.4pt);
    \draw[decorate, decoration={brace, mirror, amplitude=3pt}] (1.5,1.73) -- (3.5,1.73) node[midway, below=3pt, fill=white, inner sep=1pt, text=black!60] {$G_0$};
    \draw[decorate, decoration={brace, amplitude=2.5pt}] (2.167,2.57) -- (2.833,2.57) node[midway, above=3pt, fill=white, inner sep=1pt] {$G_1$};
  \end{scope}
\end{tikzpicture}
