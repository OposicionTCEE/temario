% Figura (bloque 1941-1958, «Las reglas»): la arquitectura del sistema de Bretton Woods según el Convenio del FMI (1944).
% Centro: el oro y el dólar (35 dólares la onza; en la práctica, EE. UU. convierte en oro los dólares de los bancos
% centrales) y las demás monedas con paridad frente al dólar, margen de +-1 % y cambio solo ante un desequilibrio
% fundamental (art. IV). Izquierda: el FMI (cuotas, financiación de desequilibrios transitorios, moneda escasa).
% Derecha: convertibilidad por cuenta corriente tras la transición (arts. VIII y XIV) y controles de capital (art. VI).
% Generar con: bash Code/generar_figura.sh bw_arquitectura
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]},
    moneda/.style={draw, thick, align=center, inner sep=3pt, minimum width=1.6cm, minimum height=0.7cm},
    lado/.style={draw, rounded corners=2pt, align=left, inner sep=4pt, text width=4.0cm, execute at begin node={\hyphenpenalty=10000}},
    nota/.style={align=center, inner sep=1.5pt, execute at begin node={\hyphenpenalty=10000}}]
  % centro: oro, dólar y demás monedas
  \node[moneda, fill=gray!25] (oro) at (0,3.3) {Oro};
  \node[moneda, fill=gray!12] (usd) at (0,1.6) {Dólar};
  \draw[<->, thick] (oro) -- node[nota, right, text width=2.6cm] {$35$ dólares la onza} (usd);
  \node[moneda] (gbp) at (-1.9,-0.4) {Libra};
  \node[moneda] (frf) at (0,-0.4) {Franco};
  \node[moneda] (otr) at (1.9,-0.4) {Otras};
  \draw[<->, thick] (usd) -- (gbp);
  \draw[<->, thick] (usd) -- (frf);
  \draw[<->, thick] (usd) -- (otr);
  \node[nota, text width=5.6cm] at (0,-1.35) {Paridad fija frente al dólar, con un margen de $\pm 1\%$; ajustable solo ante un desequilibrio fundamental (art. IV)};
  % izquierda: el FMI
  \node[lado, fill=gray!8] (fmi) at (-5.4,1.4) {\textbf{FMI}\\[2pt]
    Cuotas: $25\%$ en oro y $75\%$ en moneda nacional\\
    Financia desequilibrios transitorios con límites ligados a la cuota\\
    Moneda escasa: se permite discriminar contra el acreedor persistente (art. VII)};
  % derecha: pagos y capital
  \node[lado, fill=gray!8] (cap) at (5.4,1.4) {\textbf{Pagos y capital}\\[2pt]
    Convertibilidad por cuenta corriente (art. VIII), tras un periodo transitorio (art. XIV)\\
    Controles de capital permitidos (art. VI)\\
    Liquidez: oro y dólares};
  \draw[->, dashed] (fmi.east) -- (usd.west |- fmi.east);
  \draw[->, dashed] (cap.west) -- (usd.east |- cap.east);
\end{tikzpicture}
