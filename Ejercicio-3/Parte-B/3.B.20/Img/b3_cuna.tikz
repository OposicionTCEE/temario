% b3_cuna: la cuña de precios entre dos mercados vuelve a cerrarse con el GATT (bloque 3, Mercados). MISMA BASE COMÚN D que
% b1_cuna y b2_cuna y mismas curvas (se conservan los subíndices N y E por continuidad): exportador S_N: P = 0,5 + 0,5 Q,
% D_N: P = 4,0 - 0,5 Q; importador S_E: P = 2,0 + 0,5 Q, D_E: P = 7,0 - 0,5 Q. Con cuña tau: P_N = 3,375 - tau/2,
% P_E = 3,375 + tau/2, comercio = 4,5 - 2 tau. El bien son las manufacturas (la agricultura quedó fuera del GATT).
% En gris, la cuña de los años treinta, tau2 = 2,0 (P_N = 2,375, P_E = 4,375, comercio 0,5), con la que acababa b2_cuna.
% En negro, la de las rondas del GATT, tau3 = 0,4: P_N = 3,175 (Q_D 1,65 y Q_S 5,35), P_E = 3,575 (Q_S 3,15 y Q_D 6,85),
% comercio 3,7.
% Generar desde la carpeta del tema: bash Code/generar_figura.sh b3_cuna
\begin{tikzpicture}[font=\footnotesize, x=0.72cm, y=0.72cm, >={Stealth[length=2mm]}]
  % ---------- Exportador ----------
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (4.2,7.6) {Exportador ($N$)};
    \draw[->] (0,0) -- (8.6,0) node[below left] {Manufacturas};
    \draw[->] (0,0) -- (0,7.2) node[left] {$P$};
    \draw[black!85, thick] (0,0.5) -- (8.4,4.7) node[above left] {$S_N$};
    \draw[black!85, thick] (0,4.0) -- (7.0,0.5) node[above right] {$D_N$};
    % precios con la cuña de los años treinta (tau2) y la del GATT (tau3)
    \draw[black!45, dashed] (0,2.375) -- (8.4,2.375);
    \draw[black!85] (0,3.175) -- (8.4,3.175);
    \node[left] at (0,2.375) {$P_N^2$};
    \node[left] at (0,3.175) {$P_N^3$};
    % exportaciones
    \draw[line width=2.2pt, black!40] (3.25,2.375) -- (3.75,2.375);
    \draw[line width=2.2pt, black!85] (1.65,3.175) -- (5.35,3.175);
    \draw[decorate, decoration={brace, mirror, amplitude=2pt}, black!55] (3.25,2.23) -- (3.75,2.23) node[midway, below=3pt] {$X_2$};
    \draw[decorate, decoration={brace, amplitude=3pt}] (1.65,3.32) -- (5.35,3.32) node[midway, above=3pt] {$X_3$};
    \draw[->, black!70] (7.6,2.45) -- (7.6,3.1);
  \end{scope}
  % ---------- Importador ----------
  \begin{scope}[xshift=9.2cm]
    \node[font=\footnotesize\bfseries] at (4.2,7.6) {Importador ($E$)};
    \draw[->] (0,0) -- (8.6,0) node[below left] {Manufacturas};
    \draw[->] (0,0) -- (0,7.2) node[left] {$P$};
    \draw[black!85, thick] (0,2.0) -- (8.4,6.2) node[below right] {$S_E$};
    \draw[black!85, thick] (0,7.0) -- (8.4,2.8) node[below left] {$D_E$};
    \draw[black!45, dashed] (0,4.375) -- (8.4,4.375) node[right, black] {$P_E^2$};
    \draw[black!85] (0,3.575) -- (8.4,3.575) node[right] {$P_E^3$};
    % importaciones
    \draw[line width=2.2pt, black!40] (4.75,4.375) -- (5.25,4.375);
    \draw[line width=2.2pt, black!85] (3.15,3.575) -- (6.85,3.575);
    \draw[decorate, decoration={brace, amplitude=2pt}, black!55] (4.75,4.52) -- (5.25,4.52) node[midway, above=3pt] {$M_2$};
    \draw[decorate, decoration={brace, mirror, amplitude=3pt}] (3.15,3.43) -- (6.85,3.43) node[midway, below=3pt] {$M_3$};
    \draw[->, black!70] (7.7,4.3) -- (7.7,3.65);
    % la cuña: los precios del exportador, prolongados hasta el eje del importador
    \draw[black!45, densely dotted] (-4.38,2.375) -- (0,2.375);
    \draw[black!85, densely dotted] (-4.38,3.175) -- (0,3.175);
    \draw[black!45, densely dotted] (-2.7,4.375) -- (0,4.375);
    \draw[decorate, decoration={brace, amplitude=3pt}, black!55] (-2.7,2.375) -- (-2.7,4.375) node[midway, left=4pt] {$\tau_2$};
    \draw[decorate, decoration={brace, amplitude=2.5pt}] (-0.8,3.175) -- (-0.8,3.575) node[midway, left=3pt] {$\tau_3$};
  \end{scope}
\end{tikzpicture}
