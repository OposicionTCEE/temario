% anx_canales: los tres canales de ajuste del patrón oro ante un déficit (anexo I.3). Rehace anx_canales_ajuste: solo
% rótulos y notación, sin explicaciones dentro; a la derecha, la velocidad de cada canal.
% Generar desde la carpeta del tema: bash Code/generar_figura.sh anx_canales
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=2mm]},
    ini/.style={draw=black!85, thick, rounded corners=2pt, fill=black!10, align=center, inner sep=3pt, text width=2.3cm, minimum height=1.0cm},
    paso/.style={draw=black!70, rounded corners=2pt, fill=black!4, align=center, inner sep=3pt, text width=2.25cm, minimum height=1.0cm},
    canal/.style={font=\footnotesize\bfseries, anchor=west},
    vel/.style={font=\scriptsize, text=black!60, anchor=west}]
  \node[ini] (ini) at (0,0) {Déficit:\\$e=E^X$, sale oro};
  % precios
  \node[paso] (p1) at (3.6,1.75) {$G\downarrow\ \Rightarrow\ M\downarrow$};
  \node[paso] (p2) at (6.35,1.75) {$P\downarrow$ frente a $P^*$};
  \node[paso] (p3) at (9.1,1.75) {$X\uparrow,\ M\downarrow$};
  % renta
  \node[paso] (r1) at (3.6,0) {$i\uparrow$};
  \node[paso] (r2) at (6.35,0) {$I\downarrow,\ Y\downarrow$};
  \node[paso] (r3) at (9.1,0) {$M\downarrow$};
  % capital
  \node[paso] (k1) at (3.6,-1.75) {tipo de descuento $\uparrow$};
  \node[paso] (k2) at (6.35,-1.75) {entra capital a corto plazo};
  \node[paso] (k3) at (9.1,-1.75) {$e$ vuelve a la banda};
  % flechas
  \foreach \a in {p1,r1,k1} \draw[->, black!75] (ini.east) -- (\a.west);
  \draw[->, black!75] (p1) -- (p2); \draw[->, black!75] (p2) -- (p3);
  \draw[->, black!75] (r1) -- (r2); \draw[->, black!75] (r2) -- (r3);
  \draw[->, black!75] (k1) -- (k2); \draw[->, black!75] (k2) -- (k3);
  % rótulos de canal y velocidad
  \node[canal] at (10.45,1.95) {Precios};
  \node[vel] at (10.45,1.5) {lento};
  \node[canal] at (10.45,0.2) {Renta};
  \node[vel] at (10.45,-0.25) {intermedio};
  \node[canal] at (10.45,-1.55) {Capital};
  \node[vel] at (10.45,-2.0) {inmediato};
\end{tikzpicture}
