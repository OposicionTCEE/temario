% Figura (bloque 1914-1939, «La práctica»): el circuito de pagos de los años veinte.
% Sustituye a la indicación «INSERTAR DIAGRAMA DE FLUJOS» del texto anterior.
% (a) 1924-1928: los préstamos privados de EE. UU. a Alemania financian las reparaciones a los aliados,
% que pagan con ellas sus deudas de guerra a EE. UU. (b) 1928-1931: los préstamos se frenan (1928), Alemania solo puede
% pagar con superávits forzados por la deflación y la moratoria Hoover (1931) suspende reparaciones y deudas de guerra.
% Generar con: bash Code/generar_figura.sh entreguerras_circuito
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=5pt]},
    pais/.style={draw, thick, align=center, inner sep=3pt, minimum width=2.2cm, minimum height=0.8cm, execute at begin node={\hyphenpenalty=10000}},
    flujo/.style={align=center, inner sep=1.5pt, execute at begin node={\hyphenpenalty=10000}}]
  % ---------- Panel (a) ----------
  \begin{scope}
    \node[pais, fill=gray!12] (us) at (3.2,3.6) {Estados Unidos};
    \node[pais] (de) at (5.9,0.6) {Alemania};
    \node[pais, text width=2.3cm] (al) at (0.6,0.6) {Aliados (Gran Bretaña, Francia, Bélgica)};
    \draw[->, very thick] (us.east) to[bend left=30] node[flujo, left, pos=0.55, text width=2.0cm] {préstamos privados} (de.north);
    \draw[->, very thick] (de.west) -- node[flujo, below, text width=2.6cm] {reparaciones (Plan Dawes)} (al.east);
    \draw[->, very thick] (al.north) to[bend left=30] node[flujo, right, pos=0.45, text width=1.6cm] {deudas de guerra} (us.west);
    \node[align=center] at (3.2,-1.0) {(a) 1924-1928: el circuito se cierra\\ con crédito estadounidense};
  \end{scope}
  % ---------- Panel (b) ----------
  \begin{scope}[xshift=8.3cm]
    \node[pais, fill=gray!12] (us) at (3.2,3.6) {Estados Unidos};
    \node[pais] (de) at (5.9,0.6) {Alemania};
    \node[pais, text width=2.3cm] (al) at (0.6,0.6) {Aliados (Gran Bretaña, Francia, Bélgica)};
    \draw[->, very thick, dashed, gray] (us.east) to[bend left=30] node[pos=0.22, sloped, black, font=\large\bfseries] {$\times$} node[flujo, left, pos=0.55, text width=2.0cm, black] {frenazo de los préstamos (1928)} (de.north);
    \draw[->, thick] (de.west) -- node[flujo, below, text width=2.8cm] {reparaciones con superávit forzado por la deflación} (al.east);
    \draw[->, thick, dashed] (al.north) to[bend left=30] node[flujo, right, pos=0.45, text width=1.7cm] {deudas de guerra, suspendidas en 1931} (us.west);
    \node[align=center] at (3.2,-1.0) {(b) 1928-1931: el circuito se rompe; la moratoria\\ Hoover (1931) suspende los pagos};
  \end{scope}
\end{tikzpicture}
