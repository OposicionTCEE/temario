% Figura (bloque 1914-1939, «La práctica»): ajuste simétrico frente a ajuste asimétrico, sobre la base de la figura
% de los puntos del oro del bloque 1815-1914 (oro_puntos_reglas): mercado de divisas del país deficitario.
% Banda: E^M = 1,5, E^par = 2,5, E^X = 3,5. Oferta S0: e = 0,6 + 1,036 (Q - 0,8) hasta E^X (Q = 3,6).
% Demanda tras el shock D1: de (3,2; 4,6) a (6,4; 1,99); corta E^X en C = (4,55; 3,5): sale oro.
% (a) Reglas simétricas: el país con superávit deja que el oro expanda su dinero, importa más y la oferta de divisas
%     del deficitario pasa a S1 (desplazada 2,044): A' = (5,16; 3,0), con más comercio.
% (b) Esterilización: el país con superávit neutraliza el oro y S no se mueve; el deficitario debe deflactar y su demanda
%     de divisas pasa a D2 (D1 desplazada 2,0 a la izquierda): A'' = (3,14; 3,02), con menos comercio.
% Generar con: bash Code/generar_figura.sh entreguerras_asimetria
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=0.92cm, y=1cm]
  % ---------- Panel (a) ----------
  \begin{scope}
    \fill[gray!12] (0,1.5) rectangle (6.6,3.5);
    \draw[->] (0,0) -- (6.8,0) node[below left] {Divisas};
    \draw[->] (0,0) -- (0,5.0) node[left] {$e$};
    \draw[dashed, gray] (0,3.5) -- (6.6,3.5);
    \draw[dotted] (0,2.5) -- (6.6,2.5);
    \draw[dashed, gray] (0,1.5) -- (6.6,1.5);
    \node[left] at (0,3.5) {$E^{X}$};
    \node[left] at (0,2.5) {$E^{par}$};
    \node[left] at (0,1.5) {$E^{M}$};
    \draw[thick, gray] (0.8,0.6) -- (3.6,3.5) -- (5.0,3.5);
    \node[gray, left] at (1.3,1.2) {$S_0$};
    \draw[very thick] (2.84,0.6) -- (5.644,3.5) -- (6.4,3.5) node[above left] {$S_1$};
    \draw[thick] (3.2,4.6) node[right] {$D_1$} -- (6.4,1.99);
    \draw[->, thick] (2.3,2.05) -- (4.05,2.05) node[midway, below, fill=gray!12, inner sep=1pt, align=center] {el superávit\\ expande};
    \fill (4.55,3.5) circle (1.6pt) node[above] {$C$};
    \fill (5.16,3.0) circle (1.6pt) node[right=2pt] {$A'$};
    \node[align=center] at (3.3,-0.8) {(a) Reglas simétricas: el país con superávit\\ importa más y el ajuste se comparte};
  \end{scope}
  % ---------- Panel (b) ----------
  \begin{scope}[xshift=8.0cm]
    \fill[gray!12] (0,1.5) rectangle (6.6,3.5);
    \draw[->] (0,0) -- (6.8,0) node[below left] {Divisas};
    \draw[->] (0,0) -- (0,5.0) node[left] {$e$};
    \draw[dashed, gray] (0,3.5) -- (6.6,3.5);
    \draw[dotted] (0,2.5) -- (6.6,2.5);
    \draw[dashed, gray] (0,1.5) -- (6.6,1.5);
    \node[left] at (0,3.5) {$E^{X}$};
    \node[left] at (0,2.5) {$E^{par}$};
    \node[left] at (0,1.5) {$E^{M}$};
    \draw[very thick] (0.8,0.6) -- (3.6,3.5) -- (6.4,3.5) node[above left] {$S_0$};
    \draw[thick, gray, dashed] (3.2,4.6) node[right] {$D_1$} -- (6.4,1.99);
    \draw[thick] (1.2,4.6) node[left] {$D_2$} -- (4.4,1.99);
    \draw[->, thick] (5.55,2.65) -- (3.75,2.65) node[midway, below, fill=gray!12, inner sep=1pt, align=center] {el deficitario\\ deflacta};
    \fill (4.55,3.5) circle (1.6pt) node[above] {$C$};
    \fill (3.14,3.02) circle (1.6pt) node[left=2pt] {$A''$};
    \node[align=center] at (3.3,-0.8) {(b) Esterilización: la oferta no se mueve\\ y todo el ajuste recae en el deficitario};
  \end{scope}
\end{tikzpicture}
