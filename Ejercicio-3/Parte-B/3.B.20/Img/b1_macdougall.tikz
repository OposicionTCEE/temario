% b1_macdougall: la emigración masiva en el diagrama de dos países (MACDOUGALL, 1960) (bloque 1, Mercados). BASE COMÚN C del tema:
% se reutiliza en el bloque 2 (las cuotas detienen la migración) y en el bloque 3 (trabajadores invitados en Europa). Adaptada
% de migracion_macdougall, con el reparto de la ganancia.
% Eje horizontal: población activa total; la de Europa se mide desde O_E (izquierda) y la del Nuevo Mundo desde O_N (derecha).
% Productividad marginal del trabajo en Europa: w = 5,5 - 0,47 x; en el Nuevo Mundo: w = 1 + 0,4 x (x medido desde O_E).
% Reparto inicial L0 (x = 7,5): w_E^0 = 1,975 y w_N^0 = 4,0. Con libre migración, L1 (x = 5,172) y w* = 3,069.
% a: lo que pasan a cobrar los trabajadores que se quedan en Europa y dejan de ganar los propietarios europeos (0-L1 entre w_E^0 y w*).
% b: lo que dejan de cobrar los trabajadores nativos del Nuevo Mundo y ganan sus propietarios (L0-O_N entre w* y w_N^0).
% c: aumento de la producción mundial (triángulo entre las dos curvas, de L1 a L0).
% Generar desde la carpeta del tema: bash Code/generar_figura.sh b1_macdougall
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=2mm]}, x=1.3cm, y=0.95cm]
  % áreas
  \fill[black!14] (0,1.975) rectangle (5.172,3.069);
  \fill[black!14] (7.5,3.069) rectangle (10,4.0);
  \fill[black!40] (5.172,3.069) -- (7.5,4.0) -- (7.5,1.975) -- cycle;
  \node at (2.6,2.52) {$a$};
  \node at (8.75,3.53) {$b$};
  \node at (6.85,3.0) {$c$};
  % ejes
  \draw[->] (0,0) -- (0,6.0) node[left] {$w_E$};
  \draw[->] (10,0) -- (10,6.0) node[right] {$w_N$};
  \draw (0,0) -- (10,0);
  \node[below] at (0,0) {$O_E$};
  \node[below] at (10,0) {$O_N$};
  % productividades marginales
  \draw[black!85, thick] (0,5.5) -- (10,0.8) node[below left] {$\mathrm{PMgL}_E$};
  \draw[black!85, thick] (0,1.0) -- (10,5.0) node[above left] {$\mathrm{PMgL}_N$};
  % reparto inicial y final
  \draw[black!45, densely dotted] (7.5,0) -- (7.5,1.975);
  \draw[black!45, densely dotted] (5.172,0) -- (5.172,1.975);
  \node[below] at (7.5,0) {$L_0$};
  \node[below] at (5.172,0) {$L_1$};
  % salarios
  \draw[black!45, densely dotted] (0,3.069) -- (10,3.069);
  \node[left] at (0,1.975) {$w_E^0$};
  \node[left] at (0,3.069) {$w^*$};
  \node[right] at (10,3.069) {$w^*$};
  \node[right] at (10,4.0) {$w_N^0$};
  \fill (7.5,1.975) circle (1.5pt);
  \fill (7.5,4.0) circle (1.5pt);
  \fill (5.172,3.069) circle (1.5pt);
  % migración
  \draw[->, thick, black!70] (7.3,0.55) -- (5.4,0.55) node[midway, above] {emigración};
  % rótulos de los países
  \node at (2.2,-0.75) {población activa de Europa $\rightarrow$};
  \node at (8.0,-0.75) {$\leftarrow$ población activa del Nuevo Mundo};
\end{tikzpicture}
