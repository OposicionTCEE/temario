% Figura (anexo de la Gran Guerra): los bandos de 1914-1918 y su ampliación.
% Sustituye a la imagen antigua de las alianzas (GranGuerra.png). Arriba, las alianzas de antes de la guerra
% (Triple Alianza, 1882; Triple Entente, 1907); debajo, los bandos de la guerra con el año de entrada de cada país.
% Italia, miembro de la Triple Alianza, se mantuvo neutral en 1914 y entró con los Aliados en mayo de 1915.
% Generar con: bash Code/generar_figura.sh anx_bandos_guerra
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]},
    alianza/.style={draw, align=center, inner sep=3pt, text width=6.6cm, execute at begin node={\hyphenpenalty=10000}},
    bando/.style={draw, thick, align=left, inner sep=4pt, text width=6.6cm, execute at begin node={\hyphenpenalty=10000}}]
  % alianzas de antes de la guerra
  \node[font=\footnotesize\bfseries] at (0,3.15) {Antes de la guerra};
  \node[alianza, fill=gray!12] (ta) at (-3.9,2.4) {\textbf{Triple Alianza} (1882)\\ Alemania, Austria-Hungría e Italia (neutral en 1914, se une a los Aliados en 1915)};
  \node[alianza, fill=gray!12] (te) at (3.9,2.4) {\textbf{Triple Entente} (1907)\\ Francia, Rusia y Gran Bretaña};
  % bandos de la guerra
  \node[font=\footnotesize\bfseries] at (0,1.2) {Durante la guerra (año de entrada)};
  \node[bando, anchor=north] (ic) at (-3.9,0.8) {\textbf{Imperios Centrales}\\[2pt]
    \textbf{1914}: Alemania y Austria-Hungría; Imperio otomano (noviembre)\\
    \textbf{1915}: Bulgaria (octubre)};
  \node[bando, anchor=north] (al) at (3.9,0.8) {\textbf{Aliados}\\[2pt]
    \textbf{1914}: Serbia, Rusia, Francia, Bélgica, Gran Bretaña, Montenegro y Japón\\
    \textbf{1915}: Italia (mayo)\\
    \textbf{1916}: Portugal y Rumanía\\
    \textbf{1917}: Estados Unidos (abril), Grecia, China, Siam, Brasil y otros países latinoamericanos\\
    \textbf{1917-1918}: Rusia sale de la guerra (paz de Brest-Litovsk)};
  \draw[->] (ta.south) -- (ic.north);
  \draw[->] (te.south) -- (al.north);
  % neutrales
  \node[draw, dashed, align=center, inner sep=3pt, text width=14.4cm, anchor=north] at (0,-2.75) {\textbf{Neutrales en Europa}: España, Países Bajos, Suiza y los países nórdicos};
\end{tikzpicture}
