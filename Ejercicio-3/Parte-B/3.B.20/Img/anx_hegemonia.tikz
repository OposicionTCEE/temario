% anx_hegemonia: la condición de provisión de un bien público internacional por un solo país (anexo III.1.1; formalización
% propia a partir de OLSON, 1965, y KINDLEBERGER, 1981). BASE COMÚN H, que se reutiliza para los años veinte (III.4) y para la
% posguerra (III.7). Eje horizontal: tamaño relativo de la economía, y_i. Vertical: dependencia del orden abierto, o_i (peso del
% comercio y de los activos exteriores). Sin escala: posiciones CUALITATIVAS. Frontera: hipérbola y_i o_i = C/B = 0,25, por encima
% de la cual el país obtiene del bien más de lo que cuesta (zona sombreada). Puntos hacia 1880: Gran Bretaña (0,55; 0,75), por
% encima; Estados Unidos (0,62; 0,16) y Francia (0,36; 0,38), por debajo.
% Generar desde la carpeta del tema: bash Code/generar_figura.sh anx_hegemonia
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=2mm]}, x=6.2cm, y=4.6cm]
  % zona en la que un país provee solo
  \fill[black!10] plot[domain=0.25:1.12, samples=80] (\x,{0.25/\x}) -- (1.12,1.0) -- (0.25,1.0) -- cycle;
  \node[font=\scriptsize, text=black!70] at (0.92,0.86) {provee solo};
  \node[font=\scriptsize, text=black!70] at (0.20,0.10) {no provee solo};
  % ejes
  \draw[->] (0,0) -- (1.2,0) node[below left] {$y_i$};
  \draw[->] (0,0) -- (0,1.08) node[left] {$o_i$};
  \node[below, font=\scriptsize] at (0.6,-0.03) {tamaño relativo};
  \node[rotate=90, font=\scriptsize] at (-0.07,0.5) {dependencia del orden abierto};
  % frontera de provisión
  \draw[black!90, very thick] plot[domain=0.25:1.12, samples=80] (\x,{0.25/\x});
  \node[anchor=west] at (1.12,0.223) {$y_i\,o_i=C/B$};
  % países hacia 1880
  \fill (0.55,0.75) circle (1.6pt) node[above right] {Gran Bretaña};
  \fill (0.62,0.16) circle (1.6pt) node[right=2pt] {Estados Unidos};
  \fill (0.36,0.38) circle (1.6pt) node[right=2pt] {Francia};
\end{tikzpicture}
