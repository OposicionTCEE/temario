% anx_uep_oro: reglas de liquidación de la Unión Europea de Pagos (anexo I.12.5; KAPLAN y SCHLEIMINGER, 1989).
% Eje horizontal: posición acumulada con la Unión en proporción de la cuota (izquierda, deudor; derecha, acreedor).
% Vertical: oro o dólares liquidados acumulados, en proporción de la cuota.
% Deudor (1950): el primer 20 % de la cuota, todo a crédito; después, el oro pasa a ser el 20, 40, 60 y 80 % de cada tramo
% de un 20 %: g_D = 0; 0,04; 0,12; 0,24; 0,40 en |x| = 0,2; 0,4; 0,6; 0,8; 1 (40 % en oro al agotar la cuota).
% Acreedor (1950): el primer 20 %, todo a crédito; después, mitad en oro: g_C = 0,5 (x - 0,2), 0,40 en x = 1.
% Desde 1954 (discontinua): mitad en oro desde el principio, g = 0,5 |x|.
% Generar desde la carpeta del tema: bash Code/generar_figura.sh anx_uep_oro
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=2mm]}, x=4.0cm, y=6.0cm]
  % tramo solo a crédito
  \fill[black!7] (-0.2,0) rectangle (0.2,0.62);
  \node[font=\scriptsize, align=center, fill=black!7, inner sep=1pt] at (0,0.555) {solo\\crédito};
  % ejes
  \draw[->] (-1.12,0) -- (1.17,0);
  \draw[->] (0,0) -- (0,0.68) node[above] {Oro (proporción de la cuota)};
  % marcas del eje horizontal
  \foreach \t/\l in {-1/1, -0.8/0{,}8, -0.6/0{,}6, -0.4/0{,}4, -0.2/0{,}2, 0.2/0{,}2, 0.4/0{,}4, 0.6/0{,}6, 0.8/0{,}8, 1/1}
    \draw (\t,0) -- (\t,-0.015) node[below] {$\l$};
  \node[below=12pt] at (-0.6,0) {Deudor};
  \node[below=12pt] at (0.6,0) {Acreedor};
  % marcas del eje vertical
  \draw[black!40, densely dotted] (-1,0.40) -- (1,0.40);
  \node[fill=white, inner sep=1pt] at (0.08,0.40) {$0{,}4$};
  % desde 1954: mitad en oro
  \draw[black!50, dashed] (-1,0.5) -- (0,0) -- (1,0.5);
  \node[black!60, anchor=south] at (-1,0.5) {1954};
  \node[black!60, anchor=south] at (1,0.5) {1954};
  % deudor (1950)
  \draw[black!90, very thick] (-0.2,0) -- (-0.4,0.04) -- (-0.6,0.12) -- (-0.8,0.24) -- (-1,0.40);
  \draw[black!90, very thick] (-0.2,0) -- (0.2,0);
  \foreach \p in {(-0.4,0.04), (-0.6,0.12), (-0.8,0.24), (-1,0.40)} \fill \p circle (1.2pt);
  % acreedor (1950)
  \draw[black!90, very thick] (0.2,0) -- (1,0.40);
  \fill (1,0.40) circle (1.2pt);
  \node[anchor=east] at (-0.66,0.30) {1950};
  \node[anchor=west] at (0.66,0.18) {1950};
\end{tikzpicture}
