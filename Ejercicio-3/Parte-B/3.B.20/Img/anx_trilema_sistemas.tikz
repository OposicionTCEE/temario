% anx_trilema_sistemas: el lado del trilema que eligió cada sistema monetario internacional (anexo I.14.6, síntesis).
% Variante de la BASE COMÚN B (b1_trilema): misma geometría, pero con los tres lados rotulados. Patrón oro clásico: fijo y
% movilidad del capital (lado derecho); Bretton Woods: fijo y autonomía (lado izquierdo); flotación desde 1973: autonomía y
% movilidad (base). El patrón de cambios oro de entreguerras, en gris dentro del triángulo: intentó los tres a la vez.
% Generar desde la carpeta del tema: bash Code/generar_figura.sh anx_trilema_sistemas
\begin{tikzpicture}[font=\footnotesize,
    vertice/.style={draw=black!85, thick, fill=black!8, align=center, inner sep=3pt, text width=2.9cm, execute at begin node={\hyphenpenalty=10000}},
    lado/.style={align=center, inner sep=2pt, text width=3.1cm, execute at begin node={\hyphenpenalty=10000}}]
  \coordinate (F) at (0,3.6);
  \coordinate (A) at (-3.6,0);
  \coordinate (M) at (3.6,0);
  \draw[black!90, line width=2.4pt] (F) -- (M);
  \draw[black!90, line width=2.4pt] (F) -- (A);
  \draw[black!45, line width=2.4pt, dashed] (-2.0,0) -- (2.0,0);
  \node[vertice, anchor=south] at (F) {Tipo de cambio fijo};
  \node[vertice, anchor=north] at (A) {Autonomía monetaria};
  \node[vertice, anchor=north] at (M) {Libre movilidad del capital};
  \node[lado, font=\footnotesize\bfseries, anchor=west] at (2.0,2.1) {Patrón oro clásico\\(1880-1914)};
  \node[lado, font=\footnotesize\bfseries, anchor=east] at (-2.0,2.1) {Bretton Woods\\(1958-1971)};
  \node[lado, text=black!60, anchor=north] at (0,-0.85) {Flotación (desde 1973)};
  \node[lado, text=black!55, font=\footnotesize\itshape] at (0,1.15) {Patrón de cambios oro (1925-1931): los tres a la vez};
\end{tikzpicture}
