% anx_compensacion: compensación bilateral frente a compensación multilateral (anexo I.12.5; Unión Europea de Pagos, 1950).
% Comercio triangular: A exporta v a B, B exporta v a C y C exporta v a A (flechas continuas). (a) Con acuerdos bilaterales,
% cada par liquida su saldo por separado: tres pagos de v en oro o dólares (flechas discontinuas), aunque la posición neta
% de cada país es cero; sin oro, el comercio se suprime. (b) Con la Unión, los saldos bilaterales se compensan y solo se
% liquida la posición neta de cada país con la Unión, s_i = 0 en los tres casos. Sustituye a bw_compensacion (otra sesión).
% Generar desde la carpeta del tema: bash Code/generar_figura.sh anx_compensacion
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=2mm]},
    pais/.style={draw, thick, circle, minimum size=0.8cm, inner sep=0pt},
    union/.style={draw, thick, rectangle, rounded corners=2pt, minimum width=1.0cm, minimum height=0.6cm, fill=black!8}]
  % ---------- (a) ----------
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (0,2.75) {(a) Compensación bilateral};
    \node[pais] (A) at (0,1.75) {$A$};
    \node[pais] (B) at (-1.75,-1.0) {$B$};
    \node[pais] (C) at (1.75,-1.0) {$C$};
    \draw[->, thick] (A) -- (B) node[midway, above left=-1pt] {$v$};
    \draw[->, thick] (B) -- (C) node[midway, above=-1pt] {$v$};
    \draw[->, thick] (C) -- (A) node[midway, above right=-1pt] {$v$};
    \draw[->, black!60, dashed] (B) to[bend left=32] node[midway, left, font=\scriptsize] {oro} (A);
    \draw[->, black!60, dashed] (C) to[bend left=30] node[midway, below, font=\scriptsize] {oro} (B);
    \draw[->, black!60, dashed] (A) to[bend left=32] node[midway, right, font=\scriptsize] {oro} (C);
  \end{scope}
  % ---------- (b) ----------
  \begin{scope}[xshift=6.2cm]
    \node[font=\footnotesize\bfseries] at (0,2.75) {(b) Compensación multilateral};
    \node[pais] (A2) at (0,1.75) {$A$};
    \node[pais] (B2) at (-1.75,-1.0) {$B$};
    \node[pais] (C2) at (1.75,-1.0) {$C$};
    \node[union] (U) at (0,0.15) {UEP};
    \draw[->, thick] (A2) to[bend right=28] node[midway, above left=-1pt] {$v$} (B2);
    \draw[->, thick] (B2) to[bend right=28] node[midway, below=-1pt] {$v$} (C2);
    \draw[->, thick] (C2) to[bend right=28] node[midway, above right=-1pt] {$v$} (A2);
    \draw[black!55, densely dotted] (A2) -- (U) node[midway, right, font=\scriptsize] {$s_A=0$};
    \draw[black!55, densely dotted] (B2) -- (U) node[midway, below right=-1pt, font=\scriptsize] {$s_B=0$};
    \draw[black!55, densely dotted] (C2) -- (U) node[midway, below left=-1pt, font=\scriptsize] {$s_C=0$};
  \end{scope}
\end{tikzpicture}
