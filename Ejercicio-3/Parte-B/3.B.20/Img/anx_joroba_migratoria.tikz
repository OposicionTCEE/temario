% anx_joroba_migratoria: la joroba de la emigración (anexo II.3.2; HATTON y WILLIAMSON, 1998). BASE COMÚN G del anexo II
% (se reutiliza en II.12 para la Europa del sur de los años sesenta).
% Eje horizontal: renta por habitante del país de origen, y_o. Incentivo a emigrar (diferencia salarial con el destino),
% decreciente: I = 1 - 0,09 y. Capacidad de emigrar (renta para pagar el viaje, generaciones numerosas, emigrados que
% llaman), creciente: K = 1 - exp(-0,35 y). Tasa de emigración: m = I K, con máximo en y = 3,6 (m = 0,48). Formalización propia.
% Generar desde la carpeta del tema: bash Code/generar_figura.sh anx_joroba_migratoria
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=2mm]}, x=0.75cm, y=4.0cm]
  \draw[->] (0,0) -- (10.6,0) node[below left] {$y_o$};
  \draw[->] (0,0) -- (0,1.12);
  % incentivo y capacidad
  \draw[black!50, thick, dashed, domain=0:10, samples=40] plot (\x, {1-0.09*\x});
  \node[anchor=south west, text=black!60] at (0.15,0.99) {$I$};
  \draw[black!50, thick, dashed, domain=0:10, samples=60, smooth] plot (\x, {1-exp(-0.35*\x)}) node[right] {$K$};
  % emigración
  \draw[black!90, very thick, domain=0:10, samples=80, smooth] plot (\x, {(1-0.09*\x)*(1-exp(-0.35*\x))}) node[right] {$m$};
  \draw[black!40, densely dotted] (3.6,0) -- (3.6,0.482);
  \fill (3.6,0.482) circle (1.4pt);
  \node[below] at (3.6,0) {$y_o^{*}$};
\end{tikzpicture}
