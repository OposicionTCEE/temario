% anx_deudas_guerra: la red de deudas de guerra y reparaciones tras la Primera Guerra Mundial (anexo I.6.2). Esquema sin cifras:
% cada flecha va del deudor al acreedor. Línea continua: deudas de guerra entre aliados; discontinua gruesa: reparaciones;
% punteada gris: deuda zarista repudiada en 1918 (sobre todo frente a Francia). La red desemboca en Estados Unidos.
% Generar desde la carpeta del tema: bash Code/generar_figura.sh anx_deudas_guerra
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=2.2mm]},
    pais/.style={draw=black!85, thick, rounded corners=2pt, fill=black!6, align=center, inner sep=4pt, minimum width=2.5cm, minimum height=0.8cm},
    gris/.style={draw=black!40, dashed, rounded corners=2pt, text=black!55, align=center, inner sep=4pt, minimum width=2.5cm, minimum height=0.8cm}]
  \node[pais, fill=black!14] (US) at (0,3.3) {Estados Unidos};
  \node[pais] (GB) at (-3.3,1.2) {Gran Bretaña};
  \node[pais] (FR) at (3.3,1.2) {Francia};
  \node[pais] (IT) at (-5.2,-1.3) {Italia y otros\\aliados};
  \node[pais] (DE) at (0,-1.3) {Alemania};
  \node[gris] (RU) at (5.2,-1.3) {Rusia};
  % deudas de guerra
  \draw[->, thick, black!85] (GB) -- (US);
  \draw[->, thick, black!85] (FR) -- (US);
  \draw[->, thick, black!85] (FR) -- (GB);
  \draw[->, thick, black!85] (IT) -- (GB);
  \draw[->, thick, black!85] (IT.north) |- (US.west);
  % reparaciones
  \draw[->, very thick, black!70, dashed] (DE) -- (FR);
  \draw[->, very thick, black!70, dashed] (DE) -- (GB);
  % deuda repudiada
  \draw[->, thick, black!40, densely dotted] (RU) -- (FR);
  % leyenda
  \begin{scope}[yshift=-2.9cm]
    \draw[thick, black!85] (-5.6,0) -- (-4.6,0); \node[anchor=west] at (-4.5,0) {deudas de guerra};
    \draw[very thick, black!70, dashed] (-1.6,0) -- (-0.6,0); \node[anchor=west] at (-0.5,0) {reparaciones};
    \draw[thick, black!40, densely dotted] (2.2,0) -- (3.2,0); \node[anchor=west] at (3.3,0) {deuda repudiada (1918)};
  \end{scope}
\end{tikzpicture}
