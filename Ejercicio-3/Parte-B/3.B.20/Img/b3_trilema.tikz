% b3_trilema: el trilema de la economía abierta al final de Bretton Woods (bloque 3, Desenlace). MISMA BASE COMÚN B y misma
% geometría que b1_trilema y b2_trilema (mismos vértices en el mismo sitio). Bretton Woods ocupa el lado izquierdo, tipo fijo y
% autonomía monetaria, en trazo grueso; la movilidad del capital, controlada, en recuadro discontinuo. Cuando el capital vuelve a
% moverse, la flecha lleva a la base (autonomía y movilidad: flotación, desde 1973), en gris discontinuo. Distinta de
% anx_trilema_sistemas (síntesis del anexo I), que da el lado de cada sistema.
% Generar desde la carpeta del tema: bash Code/generar_figura.sh b3_trilema
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=2.2mm]},
    vertice/.style={draw=black!85, thick, fill=black!8, align=center, inner sep=3pt, text width=2.9cm, execute at begin node={\hyphenpenalty=10000}},
    renuncia/.style={draw=black!45, dashed, text=black!55, align=center, inner sep=3pt, text width=2.9cm, execute at begin node={\hyphenpenalty=10000}},
    lado/.style={align=center, inner sep=2pt, text width=3.3cm, execute at begin node={\hyphenpenalty=10000}}]
  \coordinate (F) at (0,3.6);
  \coordinate (A) at (-3.6,0);
  \coordinate (M) at (3.6,0);
  \draw[black!35, thin] (F) -- (M);
  \draw[black!90, line width=2.4pt] (F) -- (A);
  \draw[black!45, line width=2.4pt, dashed] (-2.0,0) -- (2.0,0);
  \node[vertice, anchor=south] at (F) {Tipo de cambio fijo};
  \node[vertice, anchor=north] at (A) {Autonomía monetaria};
  \node[renuncia, anchor=north] at (M) {Libre movilidad del capital\\[-1pt]{\scriptsize (se controla)}};
  \node[lado, font=\footnotesize\bfseries, anchor=east] at (-2.05,2.1) {Bretton Woods\\(1958-1971)};
  \node[lado, text=black!60, anchor=north] at (0,-0.15) {Flotación (desde 1973)};
  % salida hacia la flotación al volver el capital
  \draw[->, thick, black!70] (-1.55,2.0) -- (-0.75,0.15);
  \node[anchor=west, font=\scriptsize, text=black!70, align=left] at (-0.95,1.25) {vuelve la movilidad\\del capital: 1973};
\end{tikzpicture}
