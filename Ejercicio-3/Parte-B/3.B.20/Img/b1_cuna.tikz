% b1_cuna: la cuña de precios entre dos mercados (bloque 1, Origen). BASE COMÚN D del tema: dos mercados de un mismo bien
% separados por una cuña tau (coste de transporte; después, también aranceles, contingentes y controles). Se reutiliza en
% b1_arancel (bloque 1, Desenlace), en el bloque 2 (la cuña que vuelve a abrirse en los años treinta) y en el bloque 3 (GATT
% y excepción agrícola).
% Nuevo Mundo (exportador): S_N: P = 0,5 + 0,5 Q; D_N: P = 4,0 - 0,5 Q (autarquía P = 2,25).
% Europa (importador): S_E: P = 2,0 + 0,5 Q; D_E: P = 7,0 - 0,5 Q (autarquía P = 4,5).
% Con cuña tau: P_E = P_N + tau; exportaciones X = 4 P_N - 9 = importaciones M = 18 - 4 P_E, de modo que
% P_N = 3,375 - tau/2, P_E = 3,375 + tau/2, comercio = 4,5 - 2 tau.
% tau0 = 1,6: P_N = 2,575, P_E = 4,175, comercio 1,3 (N: Q_D 2,85 y Q_S 4,15; E: Q_S 4,35 y Q_D 5,65).
% tau1 = 0,6: P_N = 3,075, P_E = 3,675, comercio 3,3 (N: Q_D 1,85 y Q_S 5,15; E: Q_S 3,35 y Q_D 6,65).
% Generar desde la carpeta del tema: bash Code/generar_figura.sh b1_cuna
\begin{tikzpicture}[font=\footnotesize, x=0.72cm, y=0.72cm, >={Stealth[length=2mm]}]
  % ---------- Nuevo Mundo ----------
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (4.2,7.6) {Nuevo Mundo (exportador)};
    \draw[->] (0,0) -- (8.6,0) node[below left] {Trigo};
    \draw[->] (0,0) -- (0,7.2) node[left] {$P$};
    \draw[black!85, thick] (0,0.5) -- (8.4,4.7) node[above left] {$S_N$};
    \draw[black!85, thick] (0,4.0) -- (7.0,0.5) node[above right] {$D_N$};
    % precios con la cuña alta (tau0) y baja (tau1)
    \draw[black!45, dashed] (0,2.575) -- (8.4,2.575);
    \draw[black!85] (0,3.075) -- (8.4,3.075);
    \node[left] at (0,2.575) {$P_N^0$};
    \node[left] at (0,3.075) {$P_N^1$};
    % exportaciones
    \draw[line width=2.2pt, black!40] (2.85,2.575) -- (4.15,2.575);
    \draw[line width=2.2pt, black!85] (1.85,3.075) -- (5.15,3.075);
    \draw[decorate, decoration={brace, mirror, amplitude=3pt}, black!55] (2.85,2.43) -- (4.15,2.43) node[midway, below=3pt] {$X_0$};
    \draw[decorate, decoration={brace, amplitude=3pt}] (1.85,3.22) -- (5.15,3.22) node[midway, above=3pt] {$X_1$};
    \draw[->, black!70] (7.6,2.64) -- (7.6,3.0);
  \end{scope}
  % ---------- Europa ----------
  \begin{scope}[xshift=9.2cm]
    \node[font=\footnotesize\bfseries] at (4.2,7.6) {Europa (importador)};
    \draw[->] (0,0) -- (8.6,0) node[below left] {Trigo};
    \draw[->] (0,0) -- (0,7.2) node[left] {$P$};
    \draw[black!85, thick] (0,2.0) -- (8.4,6.2) node[below right] {$S_E$};
    \draw[black!85, thick] (0,7.0) -- (8.4,2.8) node[below left] {$D_E$};
    \draw[black!45, dashed] (0,4.175) -- (8.4,4.175) node[right, black] {$P_E^0$};
    \draw[black!85] (0,3.675) -- (8.4,3.675) node[right] {$P_E^1$};
    % importaciones
    \draw[line width=2.2pt, black!40] (4.35,4.175) -- (5.65,4.175);
    \draw[line width=2.2pt, black!85] (3.35,3.675) -- (6.65,3.675);
    \draw[decorate, decoration={brace, amplitude=3pt}, black!55] (4.35,4.32) -- (5.65,4.32) node[midway, above=3pt] {$M_0$};
    \draw[decorate, decoration={brace, mirror, amplitude=3pt}] (3.35,3.53) -- (6.65,3.53) node[midway, below=3pt] {$M_1$};
    \draw[->, black!70] (7.7,4.11) -- (7.7,3.75);
    % la cuña: los precios del Nuevo Mundo, prolongados hasta el eje de Europa
    \draw[black!45, densely dotted] (-4.38,2.575) -- (0,2.575);
    \draw[black!85, densely dotted] (-4.38,3.075) -- (0,3.075);
    \draw[black!45, densely dotted] (-2.7,4.175) -- (0,4.175);
    \draw[decorate, decoration={brace, amplitude=3pt}, black!55] (-2.7,2.575) -- (-2.7,4.175) node[midway, left=4pt] {$\tau_0$};
    \draw[decorate, decoration={brace, amplitude=2.5pt}] (-0.8,3.075) -- (-0.8,3.675) node[midway, left=3pt] {$\tau_1$};
  \end{scope}
\end{tikzpicture}
