% b1_cuna: la cuña de precios entre dos mercados (bloque 1, Origen). BASE COMÚN D del tema: dos mercados de un mismo bien
% separados por una cuña tau (coste de transporte; después, también aranceles, contingentes y controles). Se reutiliza en
% b1_arancel (bloque 1, Desenlace), en el bloque 2 (la cuña que vuelve a abrirse en los años treinta) y en el bloque 3 (GATT
% y excepción agrícola).
% Nuevo Mundo (exportador): S_N: P = 0,5 + 0,5 Q; D_N: P = 4,5 - 0,5 Q (autarquía P = 2,5).
% Europa (importador): S_E: P = 1,5 + 0,5 Q; D_E: P = 6,5 - 0,5 Q (autarquía P = 4,0).
% Con cuña tau: P_E = P_N + tau; exportaciones X = 4 P_N - 10 = importaciones M = 16 - 4 P_E, de modo que
% P_N = 3,25 - tau/2, P_E = 3,25 + tau/2, comercio = 3 - 2 tau.
% tau0 = 1,0: P_N = 2,75, P_E = 3,75, comercio 1,0 (N: Q_D 3,5 y Q_S 4,5; E: Q_S 4,5 y Q_D 5,5).
% tau1 = 0,3: P_N = 3,10, P_E = 3,40, comercio 2,4 (N: Q_D 2,8 y Q_S 5,2; E: Q_S 3,8 y Q_D 6,2).
% Generar desde la carpeta del tema: bash Code/generar_figura.sh b1_cuna
\begin{tikzpicture}[font=\footnotesize, x=0.72cm, y=0.72cm, >={Stealth[length=2mm]}]
  % ---------- Nuevo Mundo ----------
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (4.2,7.1) {Nuevo Mundo (exportador)};
    \draw[->] (0,0) -- (8.6,0) node[below left] {Trigo};
    \draw[->] (0,0) -- (0,6.7) node[left] {$P$};
    \draw[black!85, thick] (0,0.5) -- (8.4,4.7) node[above left] {$S_N$};
    \draw[black!85, thick] (0,4.5) -- (8.0,0.5) node[above right] {$D_N$};
    % precios con la cuña alta (tau0) y baja (tau1)
    \draw[black!45, dashed] (0,2.75) -- (8.4,2.75);
    \draw[black!85] (0,3.10) -- (8.4,3.10);
    \node[left] at (0,2.66) {$P_N^0$};
    \node[left] at (0,3.19) {$P_N^1$};
    % exportaciones
    \draw[line width=2.2pt, black!40] (3.5,2.75) -- (4.5,2.75);
    \draw[line width=2.2pt, black!85] (2.8,3.10) -- (5.2,3.10);
    \draw[decorate, decoration={brace, mirror, amplitude=3pt}, black!55] (3.5,2.6) -- (4.5,2.6) node[midway, below=3pt] {$X_0$};
    \draw[decorate, decoration={brace, amplitude=3pt}] (2.8,3.25) -- (5.2,3.25) node[midway, above=3pt] {$X_1$};
    \draw[->, black!70] (7.6,2.80) -- (7.6,3.05);
  \end{scope}
  % ---------- Europa ----------
  \begin{scope}[xshift=9.2cm]
    \node[font=\footnotesize\bfseries] at (4.2,7.1) {Europa (importador)};
    \draw[->] (0,0) -- (8.6,0) node[below left] {Trigo};
    \draw[->] (0,0) -- (0,6.7) node[left] {$P$};
    \draw[black!85, thick] (0,1.5) -- (8.4,5.7) node[below right] {$S_E$};
    \draw[black!85, thick] (0,6.5) -- (8.4,2.3) node[below left] {$D_E$};
    \draw[black!45, dashed] (0,3.75) -- (8.4,3.75) node[right, black] {$P_E^0$};
    \draw[black!85] (0,3.40) -- (8.4,3.40) node[right] {$P_E^1$};
    % importaciones
    \draw[line width=2.2pt, black!40] (4.5,3.75) -- (5.5,3.75);
    \draw[line width=2.2pt, black!85] (3.8,3.40) -- (6.2,3.40);
    \draw[decorate, decoration={brace, amplitude=3pt}, black!55] (4.5,3.9) -- (5.5,3.9) node[midway, above=3pt] {$M_0$};
    \draw[decorate, decoration={brace, mirror, amplitude=3pt}] (3.8,3.25) -- (6.2,3.25) node[midway, below=3pt] {$M_1$};
    \draw[->, black!70] (7.7,3.70) -- (7.7,3.45);
    % la cuña: los precios del Nuevo Mundo, prolongados hasta el eje de Europa
    \draw[black!45, densely dotted] (-4.38,2.75) -- (0,2.75);
    \draw[black!85, densely dotted] (-4.38,3.10) -- (0,3.10);
    \draw[decorate, decoration={brace, amplitude=2.5pt}, black!55] (-2.6,2.75) -- (-2.6,3.75) node[midway, left=3pt] {$\tau_0$};
    \draw[black!45, densely dotted] (-2.6,3.75) -- (0,3.75);
    \draw[decorate, decoration={brace, amplitude=1.8pt}] (-0.75,3.10) -- (-0.75,3.40) node[midway, left=2pt] {$\tau_1$};
  \end{scope}
\end{tikzpicture}
