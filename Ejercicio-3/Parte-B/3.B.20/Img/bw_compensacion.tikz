% Figura (bloque 1941-1958, «La práctica»): compensación bilateral frente a compensación multilateral (Unión Europea de Pagos).
% Comercio triangular: A vende 100 a B, B vende 100 a C y C vende 100 a A. (a) Con acuerdos bilaterales, cada par debe
% equilibrar su comercio o liquidar el saldo en oro o dólares, que nadie tiene: el comercio se reduce. (b) Con la UEP
% (1950), los saldos bilaterales se compensan en la Unión: la posición neta de cada país es cero y solo se liquida el saldo
% neto con la Unión, en parte en oro y en parte a crédito.
% Generar con: bash Code/generar_figura.sh bw_compensacion
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=5pt]},
    pais/.style={draw, thick, circle, minimum size=0.95cm, align=center},
    flujo/.style={align=center, inner sep=1.5pt, execute at begin node={\hyphenpenalty=10000}}]
  % ---------- Panel (a) ----------
  \begin{scope}
    \node[pais] (a) at (0,0) {A};
    \node[pais] (b) at (5.2,0) {B};
    \node[pais] (c) at (2.6,3.4) {C};
    \draw[->, thick] (a) -- node[flujo, below] {exporta $100$} (b);
    \draw[->, thick] (b) -- node[flujo, right] {exporta $100$} (c);
    \draw[->, thick] (c) -- node[flujo, left] {exporta $100$} (a);
    \node[flujo, text width=2.4cm] at (2.6,1.15) {Cada par tiene un saldo de $100$ que hay que pagar en oro o dólares};
    \node[align=center] at (2.6,-1.3) {(a) Bilateralismo: sin dólares para liquidar\\ los saldos, el comercio triangular se reduce};
  \end{scope}
  % ---------- Panel (b) ----------
  \begin{scope}[xshift=8.0cm]
    \node[pais] (a) at (0,0) {A};
    \node[pais] (b) at (5.2,0) {B};
    \node[pais] (c) at (2.6,3.4) {C};
    \node[draw, thick, fill=gray!12, rounded corners=2pt, align=center, inner sep=3pt] (u) at (2.6,1.15) {UEP\\ (agente: BPI)};
    \draw[->, thick] (a) -- node[flujo, below] {exporta $100$} (b);
    \draw[->, thick] (b) -- node[flujo, right] {exporta $100$} (c);
    \draw[->, thick] (c) -- node[flujo, left] {exporta $100$} (a);
    \draw[dashed] (a) -- (u); \draw[dashed] (b) -- (u); \draw[dashed] (c) -- (u);
    \node[align=center] at (2.6,-1.3) {(b) Compensación multilateral: la posición neta\\ de cada país es $+100-100=0$ y no hay que liquidar nada};
  \end{scope}
\end{tikzpicture}
