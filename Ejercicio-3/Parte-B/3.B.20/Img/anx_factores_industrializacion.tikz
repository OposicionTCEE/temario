% anx_factores_industrializacion: la industrialización hacia dentro de los años treinta en el modelo de factores específicos
% (anexo II.9.2; DÍAZ ALEJANDRO, 1984). Misma BASE COMÚN E que anx_factores_especificos y anx_factores_periferia.
% Sector primario desde O_A y manufacturas desde O_M (longitud 8). Primario: w = 7 - 0,75 L_A (sin cambios). Manufacturas,
% antes: w = 1 + 0,75 L_A (E0 = (4; 4)); con devaluación y aranceles, el precio interior de las manufacturas sube un 30 %:
% w = 1,3 (1 + 0,75 L_A) = 1,3 + 0,975 L_A, y E1 = (3,304; 4,522): el trabajo pasa del sector primario a las manufacturas.
% Generar desde la carpeta del tema: bash Code/generar_figura.sh anx_factores_industrializacion
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=2mm]}, x=0.95cm, y=0.62cm]
  % ejes
  \draw[->] (0,0) -- (0,9.6) node[left] {$w$};
  \draw[->] (8,0) -- (8,9.6) node[right] {$w$};
  \draw (0,0) -- (8,0);
  \node[below left] at (0,0) {$O_A$};
  \node[below right] at (8,0) {$O_M$};
  % primario
  \draw[black!90, thick] (0,7) -- (8,1);
  \node[anchor=south west] at (0.05,7.0) {$P_A\cdot PMgL_A$};
  % manufacturas antes y después
  \draw[black!60, thick, dashed] (0,1) -- (8,7) node[pos=0.8, sloped, below, text=black!70] {$P_M^0\cdot PMgL_M$};
  \draw[black!90, thick] (0,1.3) -- (8,9.1) node[pos=0.82, sloped, above] {$P_M^1\cdot PMgL_M$};
  % equilibrios
  \draw[black!40, densely dotted] (0,4) -- (4,4) -- (4,0);
  \draw[black!40, densely dotted] (0,4.522) -- (3.304,4.522) -- (3.304,0);
  \fill (4,4) circle (1.4pt) node[below right] {$E_0$};
  \fill (3.304,4.522) circle (1.4pt) node[above=2pt] {$E_1$};
  \node[left] at (0,4) {$w_0$};
  \node[left] at (0,4.522) {$w_1$};
  \node[below] at (4,0) {$L_A^0$};
  \node[below] at (3.304,0) {$L_A^1$};
  \draw[->, thick, black!70] (3.85,-0.95) -- (3.4,-0.95);
\end{tikzpicture}
