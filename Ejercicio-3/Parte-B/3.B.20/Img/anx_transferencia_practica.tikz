% anx_transferencia_practica: cómo se pagaban las reparaciones alemanas (anexo I.7.3). Identidad de la balanza de pagos con las
% reservas constantes: saldo comercial + entrada neta de capital = reparaciones pagadas. Esquema sin cifras (alturas ilustrativas):
% (a) Plan Dawes, 1924-1928: reparaciones -1, capital +1,6, saldo comercial -0,6 (déficit; el capital lo financia todo, RITSCHL 1998);
% (b) tras la parada súbita, 1929-1932: reparaciones -1, capital -0,3 (salida), saldo comercial +1,3 (superávit arrancado por la deflación).
% Eje vertical: entradas (+) y salidas (-) de divisas. No es la versión general del problema de la transferencia, que está en el 3.B.14.
% Generar desde la carpeta del tema: bash Code/generar_figura.sh anx_transferencia_practica
\begin{tikzpicture}[font=\footnotesize, x=1.0cm, y=1.05cm]
  \foreach \dx/\titulo/\k/\sc in {0/{(a) Plan Dawes (1924-1928)}/1.6/-0.6, 6.4/{(b) Tras la parada súbita (1929-1932)}/-0.3/1.3} {
    \begin{scope}[xshift=\dx cm]
      \node[font=\footnotesize\bfseries] at (2.3,2.25) {\titulo};
      \draw[black!85] (0,0) -- (4.6,0);
      \draw[->, black!60] (0,-1.5) -- (0,2.0);
      \node[font=\scriptsize, text=black!60, anchor=south west] at (0.05,1.65) {entradas};
      \node[font=\scriptsize, text=black!60, anchor=north west] at (0.05,-1.25) {salidas};
      % reparaciones
      \fill[black!55] (0.5,0) rectangle (1.3,-1.0);
      \node[font=\scriptsize, align=center, anchor=south] at (0.9,0.05) {repara-\\ciones};
      % capital
      \fill[black!25] (1.9,0) rectangle (2.7,\k);
      % saldo comercial
      \fill[black!85] (3.3,0) rectangle (4.1,\sc);
    \end{scope}
  }
  % rótulos de capital y saldo según el signo de la barra
  \node[font=\scriptsize, align=center, anchor=north] at (2.3,-0.05) {capital};
  \node[font=\scriptsize, align=center, anchor=south] at (3.7,0.05) {saldo\\comercial};
  \node[font=\scriptsize, align=center, anchor=south] at (8.7,0.05) {capital};
  \node[font=\scriptsize, align=center, anchor=north] at (10.1,-0.05) {saldo\\comercial};
\end{tikzpicture}
