% anx_banco_fondo: quién financia un déficit con el acreedor en los planes de KEYNES (1943) y de WHITE (1943) (anexo I.11.1).
% Eje horizontal: D, déficit acumulado del resto del mundo con el país acreedor (Estados Unidos). Vertical: financiación
% automática de ese déficit. Recta de 45 grados: el déficit por financiar. KEYNES (banco): descubiertos hasta agotar las
% cuotas de los deudores, min(D, Q). WHITE (fondo): solo los dólares que tiene el Fondo, min(D, F). Ilustrativo: F = 1, Q = 3,6
% (en la negociación, Q unos 23 mil millones de dólares y F unos 2 mil millones). Sombreado: ajuste de los deudores con WHITE
% que con KEYNES se habría financiado.
% Generar desde la carpeta del tema: bash Code/generar_figura.sh anx_banco_fondo
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=2mm]}, x=1.45cm, y=1.0cm]
  % zona de ajuste de los deudores con WHITE
  \fill[black!12] (1.0,1.0) -- (3.6,3.6) -- (3.6,1.0) -- cycle;
  \node[font=\scriptsize, align=center] at (2.85,1.75) {ajuste de\\los deudores};
  % ejes
  \draw[->] (0,0) -- (5.7,0) node[below left] {$D$};
  \draw[->] (0,0) -- (0,4.7) node[above] {Financiación};
  % déficit por financiar
  \draw[black!45, densely dotted, thick] (0,0) -- (4.5,4.5) node[above right, black!60] {$D$};
  % guías
  \draw[black!40, densely dotted] (1.0,0) -- (1.0,1.0);
  \draw[black!40, densely dotted] (3.6,0) -- (3.6,1.0);
  \draw[black!40, densely dotted] (0,3.6) -- (3.6,3.6);
  \node[below] at (1.0,0) {$F$};
  \node[below] at (3.6,0) {$Q$};
  \node[left] at (0,1.0) {$F$};
  \node[left] at (0,3.6) {$Q$};
  % WHITE (fondo)
  \draw[black!50, very thick] (0,0) -- (1.0,1.0) -- (5.4,1.0) node[right, black!70] {WHITE: $\min(D,F)$};
  % KEYNES (banco)
  \draw[black!90, very thick] (0,0) -- (3.6,3.6) -- (5.4,3.6) node[right] {KEYNES: $\min(D,Q)$};
  \fill (1.0,1.0) circle (1.4pt);
  \fill (3.6,3.6) circle (1.4pt);
\end{tikzpicture}
