% anx_lewis: la oferta elástica de trabajo de la Edad de Oro en el modelo de LEWIS (1954) (anexo II.10.4; KINDLEBERGER, 1967).
% Eje horizontal: empleo en la industria, L. Vertical: salario, w. Oferta de trabajo S_L: horizontal en w = 2 hasta el punto de
% inflexión T (L = 6) y creciente después, w = 2 + 0,6 (L - 6). Demanda (producto marginal del trabajo en la industria), que se
% desplaza con la inversión: D1: w = 5 - 0,8 L (E1 = (3,75; 2)); D2: w = 6,2 - 0,8 L (E2 = (5,25; 2)); D3: w = 8,4 - 0,8 L,
% que corta la oferta en su tramo creciente, E3 = (7,143; 2,686). Sombreado: beneficio con D1, que se reinvierte.
% Generar desde la carpeta del tema: bash Code/generar_figura.sh anx_lewis
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=2mm]}, x=0.85cm, y=0.95cm]
  % beneficio con D1
  \fill[black!12] (0,2) -- (0,5) -- (3.75,2) -- cycle;
  \node at (1.05,2.9) {$\Pi_1$};
  % ejes
  \draw[->] (0,0) -- (10.6,0) node[below left] {$L$};
  \draw[->] (0,0) -- (0,6.6) node[left] {$w$};
  % oferta de trabajo
  \draw[black!90, very thick] (0,2) -- (6,2) -- (9.6,4.16) node[right] {$S_L$};
  \node[left] at (0,2) {$\bar{w}$};
  % demandas
  \draw[black!45, thick] (0,5) -- (5.625,0.5) node[below left] {$D_1$};
  \draw[black!65, thick] (0,6.2) -- (7.125,0.5) node[below] {$D_2$};
  \draw[black!90, thick] (2.5,6.4) -- (9.875,0.5) node[below] {$D_3$};
  % equilibrios
  \fill (3.75,2) circle (1.4pt) node[above right] {$E_1$};
  \fill (5.25,2) circle (1.4pt) node[above right] {$E_2$};
  \fill (7.143,2.686) circle (1.4pt) node[below right] {$E_3$};
  \fill[black!60] (6,2) circle (1.2pt);
  \draw[black!40, densely dotted] (6,0) -- (6,2);
  \node[below] at (6,0) {$T$};
  \draw[black!40, densely dotted] (0,2.686) -- (7.143,2.686);
  \node[left] at (0,2.686) {$w_3$};
\end{tikzpicture}
