% anx_piramide: la pirámide de reservas del patrón de cambios oro y su contracción (anexo I.9.1; NURKSE, 1944).
% (a) Oro en la base (centros de reserva), divisas encima (derechos sobre ese oro que otros bancos centrales cuentan como
% reserva) y dinero arriba, como múltiplo de las reservas. (b) Si los bancos centrales convierten sus divisas en oro, el oro
% total no cambia (solo cambia de manos), pero las divisas desaparecen y el dinero se contrae; en discontinuo, la pirámide de (a).
% Generar desde la carpeta del tema: bash Code/generar_figura.sh anx_piramide
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=2mm]}]
  % ---------- (a) ----------
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (2.5,3.25) {(a) Pirámide de reservas};
    \fill[black!45] (1.8,0) -- (3.2,0) -- (3.6,0.9) -- (1.4,0.9) -- cycle;
    \fill[black!22] (1.4,0.9) -- (3.6,0.9) -- (4.2,1.8) -- (0.8,1.8) -- cycle;
    \fill[black!8] (0.8,1.8) -- (4.2,1.8) -- (5.0,2.7) -- (0.0,2.7) -- cycle;
    \draw[black!80] (1.8,0) -- (3.2,0) -- (5.0,2.7) -- (0.0,2.7) -- cycle;
    \draw[black!60] (1.4,0.9) -- (3.6,0.9);
    \draw[black!60] (0.8,1.8) -- (4.2,1.8);
    \node[text=white] at (2.5,0.45) {oro};
    \node at (2.5,1.35) {divisas};
    \node at (2.5,2.25) {dinero};
  \end{scope}
  % ---------- (b) ----------
  \begin{scope}[xshift=7.2cm]
    \node[font=\footnotesize\bfseries] at (2.5,3.25) {(b) Tras convertir divisas en oro};
    % contorno de (a)
    \draw[black!45, dashed] (1.8,0) -- (3.2,0) -- (5.0,2.7) -- (0.0,2.7) -- cycle;
    \fill[black!45] (1.8,0) -- (3.2,0) -- (3.6,0.9) -- (1.4,0.9) -- cycle;
    \fill[black!22] (1.4,0.9) -- (3.6,0.9) -- (3.77,1.15) -- (1.23,1.15) -- cycle;
    \fill[black!8] (1.23,1.15) -- (3.77,1.15) -- (4.37,2.05) -- (0.63,2.05) -- cycle;
    \draw[black!80] (1.8,0) -- (3.2,0) -- (4.37,2.05) -- (0.63,2.05) -- cycle;
    \draw[black!60] (1.4,0.9) -- (3.6,0.9);
    \draw[black!60] (1.23,1.15) -- (3.77,1.15);
    \node[text=white] at (2.5,0.45) {oro};
    \node[font=\scriptsize] at (2.5,1.02) {divisas};
    \node at (2.5,1.6) {dinero};
    \draw[->, thick, black!70] (4.6,1.1) -- (3.75,0.55) node[pos=0, right, font=\scriptsize] {conversión en oro};
  \end{scope}
\end{tikzpicture}
