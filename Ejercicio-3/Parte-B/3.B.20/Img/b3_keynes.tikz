% b3_keynes: el plan de KEYNES (1943) en el cuerpo (bloque 3, Origen, epígrafe Planes). BASE COMÚN G (financiación automática
% del déficit con el acreedor), la de anx_banco_fondo (anexo I.11.1) adaptada al cuerpo y partida en dos figuras: esta y
% b3_white, con los mismos ejes, la misma escala y los mismos valores ilustrativos (Q = 3,6; F = 1). Eje horizontal: D, déficit
% acumulado del resto del mundo con el acreedor; vertical: financiación automática. Recta de 45 grados: el déficit por
% financiar. KEYNES (banco): descubiertos en bancor hasta agotar las cuotas de los deudores, min(D, Q). Sombreado: lo que el
% deudor tiene que ajustar, solo a partir de Q. En b3_white el mismo sombreado empieza en F. Sin cifras.
% Generar desde la carpeta del tema: bash Code/generar_figura.sh b3_keynes
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=2mm]}, x=1.45cm, y=1.0cm]
  % ajuste del deudor: solo cuando se agotan los descubiertos
  \fill[black!12] (3.6,3.6) -- (5.0,5.0) -- (5.0,3.6) -- cycle;
  \node[font=\scriptsize, align=center] at (4.62,4.0) {ajuste del\\deudor};
  % ejes
  \draw[->] (0,0) -- (5.9,0) node[below left] {Déficit, $D$};
  \draw[->] (0,0) -- (0,5.5) node[above] {Financiación automática};
  % déficit por financiar
  \draw[black!45, densely dotted, thick] (0,0) -- (5.0,5.0) node[above right, black!60] {$D$};
  % guías
  \draw[black!40, densely dotted] (3.6,0) -- (3.6,3.6);
  \node[below] at (3.6,0) {$Q$};
  \node[left] at (0,3.6) {$Q$};
  % KEYNES (banco): el acreedor financia hasta agotar los descubiertos
  \draw[black!90, very thick] (0,0) -- (3.6,3.6) -- (5.6,3.6) node[right] {KEYNES};
  \fill (3.6,3.6) circle (1.4pt);
  \node[font=\scriptsize, align=left, anchor=west] at (1.75,1.15) {financia el acreedor\\(descubiertos en bancor)};
\end{tikzpicture}
