% Figura (bloque 1958-1973, apertura): cronología del patrón oro-dólar, de la convertibilidad a la flotación.
% Escala: 1 año = 1,0 cm (1958 en x = 0). Franjas: convertibilidad y aviso (1958-1961), apogeo y defensas (1961-1967),
% crisis (1967-1971), ruptura (1971-1973). Hitos arriba: monetarios; abajo: comercio, capital y política.
% Generar con: bash Code/generar_figura.sh bw_cronologia
\begin{tikzpicture}[font=\footnotesize, x=0.98cm, y=1cm,
    hito/.style={align=center, inner sep=1.5pt, execute at begin node={\hyphenpenalty=10000}}]
  % franjas
  \fill[gray!14] (0,-0.3) rectangle (3,0.3);
  \fill[gray!26] (3,-0.3) rectangle (9.85,0.3);
  \fill[gray!40] (9.85,-0.3) rectangle (13.6,0.3);
  \fill[gray!20] (13.6,-0.3) rectangle (15.4,0.3);
  \node at (1.5,0) {Convertibilidad};
  \node at (6.4,0) {Apogeo y defensas};
  \node at (11.7,0) {Crisis};
  \node at (14.5,0) {Ruptura};
  \draw (0,-0.3) rectangle (15.4,0.3);
  \foreach \a in {1958,1961,1964,1967,1970,1973} {
    \pgfmathsetmacro{\x}{\a-1958}
    \draw (\x,-0.3) -- (\x,-0.42) node[below, inner sep=1pt] {\a};
  }
  % hitos arriba: monetarios
  \draw[gray] (0,0.3) -- (0,0.75);    \node[hito, anchor=south west] at (-0.3,0.7) {Convertibilidad\\ (diciembre)};
  \draw[gray] (2,0.3) -- (2,2.05);    \node[hito, anchor=south] at (2,2.0) {TRIFFIN:\\ el dilema};
  \draw[gray] (3,0.3) -- (3,0.75);    \node[hito, anchor=south] at (3.3,0.7) {Art. VIII; pool\\ del oro; AGP};
  \draw[gray] (5,0.3) -- (5,2.05);    \node[hito, anchor=south] at (5,2.0) {Impuesto de\\ igualación (IET)};
  \draw[gray] (7,0.3) -- (7,0.75);    \node[hito, anchor=south] at (7,0.7) {DE GAULLE\\ y el oro};
  \draw[gray] (9.85,0.3) -- (9.85,2.05); \node[hito, anchor=south] at (9.6,2.0) {La libra\\ se devalúa};
  \draw[gray] (10.2,0.3) -- (10.2,0.75); \node[hito, anchor=south] at (10.6,0.7) {Doble mercado\\ del oro};
  \draw[gray] (13.6,0.3) -- (13.6,2.05); \node[hito, anchor=south] at (13.3,2.0) {15 de agosto:\\ fin de la convertibilidad};
  \draw[gray] (13.95,0.3) -- (13.95,1.45); \node[hito, anchor=south west] at (13.6,1.4) {Smithsoniano};
  \draw[gray] (15.2,0.3) -- (15.2,0.75); \node[hito, anchor=south east] at (15.55,0.7) {Flotación\\ (marzo)};
  % hitos abajo: comercio, capital y política
  \draw[gray] (2.5,-0.3) -- (2.5,-1.05);  \node[hito, anchor=north] at (2.5,-1.0) {Ronda\\ Dillon};
  \draw[gray] (7.5,-0.3) -- (7.5,-1.05);  \node[hito, anchor=north] at (7.5,-1.0) {Ronda\\ Kennedy};
  \draw[gray] (7.0,-0.3) -- (7.0,-2.05);  \node[hito, anchor=north] at (6.4,-2.0) {Vietnam: la inflación\\ de EE. UU. se acelera};
  \draw[gray] (11.5,-0.3) -- (11.5,-1.05); \node[hito, anchor=north] at (11.5,-1.0) {Franco y marco;\\ primeros DEG};
  \draw[gray] (13.3,-0.3) -- (13.3,-2.05); \node[hito, anchor=north] at (13.3,-2.0) {El marco\\ flota (mayo)};
  \draw[gray] (0.5,-0.75) -- (0.5,-2.05); \node[hito, anchor=north] at (0.9,-2.0) {Euromercado\\ en Londres};
\end{tikzpicture}
