% anx_triffin: el dilema de TRIFFIN (1960) como frontera entre liquidez y confianza (anexo I.13.3).
% Eje horizontal: crecimiento de las reservas del resto del mundo, l. Vertical: cobertura en oro de los pasivos oficiales en
% dólares, c = G_US / D. Frontera en t: c(l) = G_US / (D_t - gamma G* + l R_t), decreciente en l; al acumularse dólares
% (D_t crece) se desplaza hacia abajo. Ilustrativo: F0: c = 1,8 / (1 + l); F1: c = 1,2 / (1 + l).
% g = 0,6 (liquidez que exige el comercio): A0 = (0,6; 1,125) por encima de c = 1; A1 = (0,6; 0,75) por debajo;
% B1 = (0,2; 1) en F1: confianza a costa de liquidez. Sombreado: c < 1, cobertura insuficiente (retirada posible).
% Generar desde la carpeta del tema: bash Code/generar_figura.sh anx_triffin
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=2mm]}, x=6.0cm, y=2.3cm]
  % zona de cobertura insuficiente
  \fill[black!8] (0,0) rectangle (1.2,1.0);
  \node[font=\scriptsize, text=black!60] at (0.98,0.22) {retirada posible};
  % ejes
  \draw[->] (0,0) -- (1.27,0) node[below left] {$\ell$};
  \draw[->] (0,0) -- (0,2.05) node[left] {$c$};
  % guías
  \draw[black!55, dashed] (0,1.0) -- (1.2,1.0);
  \node[left] at (0,1.0) {$1$};
  \draw[black!55, dashed] (0.6,0) -- (0.6,1.95);
  \node[below] at (0.6,0) {$g$};
  % fronteras
  \draw[black!45, very thick, domain=0:1.15, samples=60, smooth] plot (\x, {1.8/(1+\x)}) node[right, black!60] {$t_0$};
  \draw[black!90, very thick, domain=0:1.15, samples=60, smooth] plot (\x, {1.2/(1+\x)}) node[right] {$t_1$};
  \draw[->, thick, black!60] (0.95,0.89) -- (0.95,0.66);
  % puntos
  \fill (0.6,1.125) circle (1.4pt) node[above right] {$A_0$};
  \fill (0.6,0.75) circle (1.4pt) node[below left] {$A_1$};
  \fill (0.2,1.0) circle (1.4pt) node[above right] {$B_1$};
  \draw[black!45, densely dotted] (0.2,0) -- (0.2,1.0);
  \node[below] at (0.2,0) {$\ell_{B}$};
\end{tikzpicture}
