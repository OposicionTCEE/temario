% b2_banda: el mercado de divisas en el patrón de cambios oro cuando la paridad ya no es creíble (bloque 2, Moneda). MISMA BASE
% COMÚN A que b1_banda: banda E^M = 1,5, E^par = 2,5, E^X = 3,5; S0 y D0 iguales (S0: e = 0,6 + 1,036 (Q - 0,8) hasta E^X;
% D0: e = 4,6 - 0,816 (Q - 0,6) hasta E^M). La misma perturbación lleva la demanda de D0 a D1 y el tipo de cambio al punto de
% exportación de oro, C = (4,535; 3,5). En lugar de entrar capital, sale: los residentes compran divisas por temor a una
% devaluación y la demanda pasa de D1 a D2 (desplazada 1,3), con C' = (5,835; 3,5). La salida de oro pasa de BC a BC'.
% Generar desde la carpeta del tema: bash Code/generar_figura.sh b2_banda
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=2mm]}, x=1.2cm, y=1.0cm]
  \fill[black!7] (0,1.5) rectangle (8.3,3.5);
  \draw[->] (0,0) -- (8.6,0) node[below left] {Divisas};
  \draw[->] (0,0) -- (0,5.0) node[left] {$e$};
  \draw[black!50, dashed] (0,3.5) -- (8.3,3.5);
  \draw[black!50, densely dotted] (0,2.5) -- (8.3,2.5);
  \draw[black!50, dashed] (0,1.5) -- (8.3,1.5);
  \node[left] at (0,3.5) {$E^{X}$};
  \node[left] at (0,2.5) {$E^{par}$};
  \node[left] at (0,1.5) {$E^{M}$};
  % oferta
  \draw[black!85, thick] (0.8,0.6) -- (3.6,3.5) -- (7.9,3.5);
  \node at (1.05,1.45) {$S_0$};
  % demandas: inicial, tras la perturbación y tras la salida de capital
  \draw[black!40, thick] (0.6,4.6) -- (4.4,1.5) -- (7.9,1.5);
  \node[black!55] at (0.95,4.75) {$D_0$};
  \draw[black!60, thick] (3.2,4.6) -- (6.84,1.6);
  \node[black!65] at (3.5,4.75) {$D_1$};
  \draw[black!90, thick] (4.5,4.6) -- (8.14,1.6);
  \node at (4.8,4.75) {$D_2$};
  % puntos y camino
  \fill (2.87,2.75) circle (1.5pt) node[left=2pt] {$A$};
  \fill (3.6,3.5) circle (1.5pt) node[above left] {$B$};
  \fill (4.535,3.5) circle (1.5pt) node[above right] {$C$};
  \fill (5.835,3.5) circle (1.5pt) node[above right] {$C'$};
  \draw[->, black!70, densely dashed] (2.95,2.85) to[out=60, in=200] (4.43,3.45);
  \draw[->, black!70, densely dotted, thick] (4.65,3.58) to[out=30, in=150] (5.72,3.58);
  \draw[decorate, decoration={brace, mirror, amplitude=3pt}] (3.6,3.38) -- (5.835,3.38) node[midway, below=3pt, fill=black!7, inner sep=1pt] {salida de oro};
  \draw[->, thick, black!70] (5.42,2.9) -- (6.45,2.9);
  \node[anchor=west, fill=black!7, inner sep=1pt, font=\scriptsize, text=black!75] at (6.68,2.9) {salida de capital};
\end{tikzpicture}
