% anx_clausula_entreguerras: el coste político de defender una paridad entre las dos guerras (anexo III.6.3; formalización
% propia a partir de OBSTFELD, 1997, y EICHENGREEN, 1992). MISMA BASE COMÚN I que anx_clausula_escape. Eje horizontal: tamaño de
% la perturbación, |epsilon|. Vertical: coste. En gris discontinuo, la curva del patrón oro clásico, 0,1 epsilon^2, con su umbral
% epsilon0 = raíz(30) = 5,477 para C = 3. Entre las dos guerras, la curva se empina: 0,25 epsilon^2, y el umbral baja a
% epsilon1 = raíz(12) = 3,464 con el mismo C = 3. Tras la salida británica de 1931, el coste de abandonar baja a C' = 1,6 y el
% umbral, a epsilon1' = raíz(6,4) = 2,530. Llave: perturbaciones habituales, de 0 a 3.
% Generar desde la carpeta del tema: bash Code/generar_figura.sh anx_clausula_entreguerras
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=2mm]}, x=1.2cm, y=1.0cm]
  % ejes
  \draw[->] (0,0) -- (6.9,0) node[below left] {$|\varepsilon|$};
  \draw[->] (0,0) -- (0,4.6) node[left] {coste};
  % coste de abandonar
  \draw[black!90, thick] (0,3) -- (6.4,3) node[right] {$C$};
  \draw[black!60, thick, dashed] (0,1.6) -- (6.4,1.6) node[right] {$C'$};
  % coste político de defender: patrón oro clásico (referencia) y entreguerras
  \draw[black!45, thick, dashed] plot[domain=0:6.3, samples=80] (\x,{0.1*\x*\x}) node[right, text=black!55] {$\theta_0\kappa_0\,\varepsilon^2$};
  \draw[black!90, very thick] plot[domain=0:4.2, samples=80] (\x,{0.25*\x*\x}) node[above] {$\theta_1\kappa_1\,\varepsilon^2$};
  % umbrales
  \draw[black!35, densely dotted] (5.477,3) -- (5.477,0);
  \node[below, text=black!55] at (5.477,0) {$\bar{\varepsilon}_0$};
  \fill[black!45] (5.477,3) circle (1.3pt);
  \draw[black!40, densely dotted] (3.464,3) -- (3.464,0);
  \node[below] at (3.464,0) {$\bar{\varepsilon}_1$};
  \fill (3.464,3) circle (1.4pt);
  \draw[black!40, densely dotted] (2.530,1.6) -- (2.530,0);
  \node[below] at (2.530,0) {$\bar{\varepsilon}_1'$};
  \fill (2.530,1.6) circle (1.4pt);
  % perturbaciones habituales
  \draw[decorate, decoration={brace, mirror, amplitude=4pt}, black!60] (0,-0.62) -- (3.0,-0.62) node[midway, below=4pt, font=\scriptsize, text=black!70] {perturbaciones habituales};
\end{tikzpicture}
