% b3_macdougall: los trabajadores invitados en el diagrama de dos países (MACDOUGALL, 1960) (bloque 3, Mercados). MISMA BASE
% COMÚN C que b1_macdougall y b2_macdougall y mismas curvas, ahora con el Sur (sur de Europa, Turquía y norte de África) como
% origen y el Norte (Europa industrial) como destino: Sur w = 5,5 - 0,47 x; Norte w = 1 + 0,4 x (x desde O_S). Reparto inicial
% L0 (x = 7,5): w_S^0 = 1,975 y w_N^0 = 4,0. Los acuerdos de trabajadores invitados llevan el reparto a Lg (x = 6,0), sin igualar
% los salarios: w_S^g = 2,68 y w_N^g = 3,4. L1 (x = 5,172), la igualación con libre migración, en gris. b_g: moderación de los
% salarios de los trabajadores nativos del Norte (de L0 a O_N, entre w_N^g y w_N^0), que pasa a los beneficios. c_g: aumento
% de la producción conjunta (entre las curvas, de Lg a L0).
% Generar desde la carpeta del tema: bash Code/generar_figura.sh b3_macdougall
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=2mm]}, x=1.3cm, y=0.95cm]
  % áreas
  \fill[black!14] (7.5,3.4) rectangle (10,4.0);
  \fill[black!40] (6.0,3.4) -- (7.5,4.0) -- (7.5,1.975) -- (6.0,2.68) -- cycle;
  \node at (8.75,3.7) {$b_g$};
  \node at (6.85,3.0) {$c_g$};
  % ejes
  \draw[->] (0,0) -- (0,6.0) node[left] {$w_S$};
  \draw[->] (10,0) -- (10,6.0) node[right] {$w_N$};
  \draw (0,0) -- (10,0);
  \node[below] at (0,0) {$O_S$};
  \node[below] at (10,0) {$O_N$};
  % productividades marginales
  \draw[black!85, thick] (0,5.5) -- (10,0.8) node[below left] {$\mathrm{PMgL}_S$};
  \draw[black!85, thick] (0,1.0) -- (10,5.0) node[above left] {$\mathrm{PMgL}_N$};
  % repartos
  \draw[black!45, densely dotted] (7.5,0) -- (7.5,1.975);
  \draw[black!35, densely dotted] (5.172,0) -- (5.172,3.069);
  \draw[black!45, densely dotted] (6.0,0) -- (6.0,2.68);
  \node[below] at (7.5,0) {$L_0$};
  \node[below] at (6.0,0) {$L_g$};
  \node[below, text=black!55] at (5.172,0) {$L_1$};
  % salarios
  \draw[black!45, densely dotted] (0,1.975) -- (7.5,1.975);
  \draw[black!45, densely dotted] (0,2.68) -- (6.0,2.68);
  \draw[black!45, densely dotted] (6.0,3.4) -- (10,3.4);
  \node[left] at (0,1.975) {$w_S^0$};
  \node[left] at (0,2.68) {$w_S^g$};
  \node[right] at (10,4.0) {$w_N^0$};
  \node[right] at (10,3.4) {$w_N^g$};
  \fill (7.5,1.975) circle (1.5pt);
  \fill (7.5,4.0) circle (1.5pt);
  \fill (6.0,2.68) circle (1.5pt);
  \fill (6.0,3.4) circle (1.5pt);
  \fill[black!45] (5.172,3.069) circle (1.2pt);
  % migración
  \draw[->, thick, black!70] (7.35,0.55) -- (6.15,0.55) node[midway, above, font=\scriptsize] {trabajadores invitados};
  % rótulos de las regiones
  \node at (2.2,-0.75) {población activa del Sur $\rightarrow$};
  \node at (8.0,-0.75) {$\leftarrow$ población activa del Norte};
\end{tikzpicture}
