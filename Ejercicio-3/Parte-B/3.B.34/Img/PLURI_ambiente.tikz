% Comercio y medio ambiente en la OMC: del Acuerdo sobre Bienes Ambientales a las iniciativas ambientales. Elaboración propia con datos de la OMC.
\definecolor{vA}{RGB}{60,120,110}
\definecolor{vB}{RGB}{35,85,80}
\begin{tikzpicture}[font=\scriptsize]
  \node[inner sep=0pt] (tab) {%
    \renewcommand{\arraystretch}{1.25}%
    \begin{tabular}{>{\raggedright\arraybackslash}p{3.1cm}>{\raggedright\arraybackslash}p{1.6cm}>{\raggedright\arraybackslash}p{2.1cm}>{\raggedright\arraybackslash}p{3.5cm}>{\raggedright\arraybackslash}p{4.0cm}}
      \rowcolor{vB}\textcolor{white}{\textbf{Iniciativa}} & \textcolor{white}{\textbf{Inicio}} & \textcolor{white}{\textbf{Naturaleza}} & \textcolor{white}{\textbf{Objeto}} & \textcolor{white}{\textbf{Resultado}} \\
      \textbf{Acuerdo sobre Bienes Ambientales} (EGA) & 2014 & Negociación arancelaria & Suprimir aranceles sobre bienes ambientales & \textbf{Fracasó} en 2016 \\
      \rowcolor{vA!12}\textbf{Comercio y sostenibilidad ambiental} (TESSD) & 2020 & Debate estructurado & Bienes y servicios ambientales, clima, economía circular, subvenciones & Informes y recomendaciones; balance a cinco años en 2026 \\
      \textbf{Contaminación por plásticos} (DPP) & 2020 & Diálogo informal & Comercio de plásticos y de sus sustitutos & Declaraciones ministeriales; $83$ miembros, casi el $90\%$ del comercio de plásticos \\
      \rowcolor{vA!12}\textbf{Reforma de las subvenciones a los combustibles fósiles} (FFSR) & 2021 & Declaración de intenciones & Racionalizar y eliminar las subvenciones ineficientes & Declaraciones ministeriales; $48$ miembros (2024), sin disciplinas \\
    \end{tabular}};
\end{tikzpicture}
