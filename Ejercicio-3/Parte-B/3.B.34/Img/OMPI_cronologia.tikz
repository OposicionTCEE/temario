% Del sistema de la OMPI al ADPIC: cronología de los convenios y de la entrada de la propiedad intelectual en el GATT. Elaboración propia con datos de la OMPI y de la OMC.
\definecolor{pA}{RGB}{150,110,170}
\definecolor{pE}{RGB}{60,30,90}
\definecolor{gI}{RGB}{110,110,110}
\begin{tikzpicture}[font=\scriptsize,
    ev/.style={draw=#1, fill=#1!10, line width=0.5pt, rounded corners=1.5pt, align=left, text width=2.25cm, inner sep=2pt},
    every node/.append style={execute at begin node={\hyphenpenalty=10000}}]
  % Escala no lineal: 1880-1960 comprimido, 1960-2025 ampliado
  \def\X#1{\fpeval{#1<1960 ? (#1-1880)*0.055 : 4.4+(#1-1960)*0.22}}
  \draw[-{Latex[length=2mm]}, line width=0.8pt, black!70] (0,0) -- ({\X{2028}},0);
  \draw[black!40, line width=0.6pt, decorate, decoration={zigzag, amplitude=1.2pt, segment length=4pt}] ({\X{1935}},-0.06) -- ({\X{1950}},-0.06);
  \foreach \a in {1880,1900,1920,1940,1960,1970,1980,1990,2000,2010,2020} {
    \draw[black!70] ({\X{\a}},-0.08) -- ({\X{\a}},0.08);
    \node[below, font=\scriptsize\bfseries, black!70] at ({\X{\a}},-0.08) {\a};
  }
  \node[anchor=south west, font=\footnotesize\bfseries, pA] at (0,3.3) {Sistema de la OMPI: convenios por materia, sin mecanismo de cumplimiento};
  \node[anchor=north west, font=\footnotesize\bfseries, pE] at (0,-4.35) {Paso al GATT: comercio, observancia y solución de diferencias};
  \foreach \a/\h/\t in {
    1883/2.0/{\textbf{1883} \textbf{París}: propiedad industrial; trato nacional y prioridad},
    1886/0.55/{\textbf{1886} \textbf{Berna}: derecho de autor, sin formalidades},
    1958/0.55/{\textbf{1891-1961} Madrid, La Haya, Lisboa, Roma, UPOV: convenios por materia},
    1967/2.0/{\textbf{1967} Convenio que crea la OMPI (en vigor en 1970)},
    1981.5/0.55/{\textbf{1980-1984} Fracasa la revisión de París: el Sur pide más flexibilidad},
    1989/2.0/{\textbf{1970-1989} Tratados de Cooperación en materia de Patentes y de Washington},
    2000/0.55/{\textbf{1996} Tratados «de internet» (derecho de autor en el entorno digital)},
    2013/2.0/{\textbf{2012-2013} Pekín y Marrakech (obras para personas con discapacidad visual)},
    2024/0.55/{\textbf{2024} Recursos genéticos; derecho de los diseños}} {
    \draw[pA, line width=0.5pt] ({\X{\a}},0) -- ({\X{\a}},\h);
    \ifdim\a pt<1890pt \node[ev=pA, anchor=south west] at ({\X{\a}-0.1},\h) {\t};\else \node[ev=pA, anchor=south] at ({\X{\a}},\h) {\t};\fi
  }
  \foreach \a/\h/\t in {
    1979/0.55/{\textbf{1979} Ronda de Tokio: fracasa el código contra la falsificación},
    1984/1.75/{\textbf{1984-1988} EE.UU.: sección 301 y «Especial 301»},
    1988.5/2.95/{\textbf{1986-1991} Punta del Este; acuerdo de abril de 1989; borrador Dunkel},
    1994/0.55/{\textbf{1994} Marrakech: el ADPIC, anexo 1C; en vigor en 1995}} {
    \draw[pE, line width=0.5pt] ({\X{\a}},0) -- ({\X{\a}},-\h);
    \ifdim\a pt=1984pt \node[ev=pE, anchor=north east] at ({\X{\a}+0.1},-\h) {\t};\else \node[ev=pE, anchor=north] at ({\X{\a}},-\h) {\t};\fi
  }
\end{tikzpicture}
