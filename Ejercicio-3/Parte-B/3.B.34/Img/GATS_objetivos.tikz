% Objetivo y funciones del GATS y sus dos diferencias con el GATT. Elaboración propia a partir del preámbulo y de los arts. XVI, XVII, XIX y XXI del GATS.
\definecolor{oP}{RGB}{40,90,150}
\definecolor{oR}{RGB}{46,125,90}
\definecolor{oV}{RGB}{190,110,30}
\definecolor{oA}{RGB}{110,110,110}
\begin{tikzpicture}[font=\footnotesize,
    every node/.append style={execute at begin node={\hyphenpenalty=10000}},
    cab/.style={draw=#1, fill=#1, text=white, font=\footnotesize\bfseries, align=center, rounded corners=2pt, inner sep=3pt, minimum height=0.8cm},
    it/.style={draw=#1, fill=#1!8, line width=0.5pt, rounded corners=1.5pt, align=left, inner sep=3pt},
    pan/.style={font=\footnotesize\bfseries, anchor=south west, inner sep=0pt},
    fl/.style={-{Latex[length=1.8mm]}, line width=0.8pt, #1}]
  % ---------- Panel (a): objetivo y funciones ----------
  \node[pan] at (0,0.35) {(a) Objetivo y funciones};
  \node[cab=oP, text width=4.2cm, anchor=north west] (obj) at (0,0) {Objetivo (como el GATT):\\ expandir el comercio para el crecimiento y el desarrollo};
  \node[it=oP, text width=4.2cm, anchor=north] (f1) at ([yshift=-0.75cm]obj.south) {\textbf{1. Foro de negociación}\\ liberalización progresiva en rondas sucesivas (art. XIX)};
  \node[it=oP, text width=4.2cm, anchor=north] (f2) at ([yshift=-0.3cm]f1.south) {\textbf{2. Normas comunes}\\ más transparencia y menos incertidumbre para los proveedores};
  \draw[fl=oP] (obj.south) -- (f1.north);
  % ---------- Panel (b): diferencias con el GATT ----------
  \node[pan] at (5.0,0.35) {(b) Dos diferencias con el GATT};
  % Diferencia 1: barreras
  \node[cab=oR, text width=5.0cm, anchor=north west] (d1) at (5.0,0) {1. Ámbito: las barreras son \\ normas internas, no aranceles};
  \node[it=oR, text width=5.0cm, anchor=north] (b1) at ([yshift=-0.3cm]d1.south) {\textbf{Acceso al mercado}: monopolio público, licencias limitadas};
  \node[it=oR, text width=5.0cm, anchor=north] (b2) at ([yshift=-0.2cm]b1.south) {\textbf{Trato diferenciado}: requisitos de nacionalidad o de residencia};
  \node[it=oR, text width=5.0cm, anchor=north] (b3) at ([yshift=-0.2cm]b2.south) {\textbf{Licencias}: requisitos opacos, plazos inciertos, trámites en papel};
  \node[it=oA, text width=5.0cm, anchor=north, align=center] (c1) at ([yshift=-0.45cm]b3.south) {Liberalizar exige reformar\\ el \textbf{ordenamiento jurídico interno}};
  \draw[fl=oA] (b3.south) -- (c1.north);
  % Diferencia 2: flexibilidad
  \node[cab=oV, text width=5.0cm, anchor=north west] (d2) at (10.75,0) {2. Flexibilidad: cada miembro \\ elige qué y cuánto liberaliza};
  \node[it=oV, text width=5.0cm, anchor=north] (x1) at ([yshift=-0.3cm]d2.south) {\textbf{Trato nacional negociable}: si se concede, en qué grado, sector y modo};
  \node[it=oV, text width=5.0cm, anchor=north] (x2) at ([yshift=-0.2cm]x1.south) {\textbf{Acceso a los mercados}: concepto propio, también negociable (art. XVI)};
  \node[it=oV, text width=5.0cm, anchor=north] (x3) at ([yshift=-0.2cm]x2.south) {\textbf{Compromisos modificables} a los tres años, con compensación (art. XXI)};
  \node[it=oA, text width=5.0cm, anchor=north, align=center] (c2) at ([yshift=-0.45cm]x3.south) {Respeta los objetivos de política nacional\\ a cambio de \textbf{disciplinas generales comunes}};
  \draw[fl=oA] (x3.south) -- (c2.north);
  % Separador entre paneles
  \draw[oA!50, line width=0.4pt] (4.6,0.45) -- (4.6,-5.2);
\end{tikzpicture}
