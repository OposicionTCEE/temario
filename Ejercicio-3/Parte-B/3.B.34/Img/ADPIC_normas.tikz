% Normas mínimas de protección del ADPIC (Parte II, secciones 1 a 7) y sus excepciones. Elaboración propia a partir de los arts. 9 a 39 del ADPIC.
\definecolor{pA}{RGB}{150,110,170}
\definecolor{pC}{RGB}{100,55,130}
\definecolor{pE}{RGB}{60,30,90}
\definecolor{gI}{RGB}{110,110,110}
\begin{tikzpicture}[font=\scriptsize]
  \node[inner sep=0pt] (tab) {%
    \renewcommand{\arraystretch}{1.25}%
    \begin{tabular}{>{\raggedright\arraybackslash}p{2.35cm}>{\raggedright\arraybackslash}p{4.3cm}>{\raggedright\arraybackslash}p{3.9cm}>{\raggedright\arraybackslash}p{2.25cm}}
      \rowcolor{pE}\textcolor{white}{\textbf{Categoría} (arts.)} & \textcolor{white}{\textbf{Qué se protege y con qué requisitos}} & \textcolor{white}{\textbf{Derechos que confiere}} & \textcolor{white}{\textbf{Duración mínima}} \\
      \rowcolor{pA!25}\multicolumn{4}{l}{\textit{Derecho de autor y derechos conexos}} \\
      \textbf{Derecho de autor} (9-14) & Obras originales: la expresión, no las ideas; programas de ordenador y bases de datos. \textbf{Sin derechos morales} & Reproducción, traducción, comunicación pública; alquiler de programas y películas & Vida del autor + $50$ años; si no, $50$ \\
      \rowcolor{pA!25}\multicolumn{4}{l}{\textit{Propiedad industrial}} \\
      \textbf{Marcas} (15-21) & Signos capaces de distinguir productos o servicios; protección reforzada de las notoriamente conocidas & Uso exclusivo; caduca tras $3$ años sin uso; \textbf{sin licencias obligatorias} & $7$ años, renovables indefinidamente \\
      \rowcolor{black!4}\textbf{Indicaciones geográficas} (22-24) & Productos cuya calidad o reputación se debe a su origen; protección adicional para vinos y bebidas espirituosas (23) & Impedir el uso engañoso o desleal; para vinos y licores, aun sin engaño & Sin plazo \\
      \textbf{Dibujos y modelos} (25-26) & Nuevos u originales; pueden excluirse los dictados por la función técnica & Impedir fabricar, vender o importar copias & $10$ años \\
      \rowcolor{black!4}\textbf{Patentes} (27-34) & Invenciones de productos y procedimientos en \textbf{todos los campos de la tecnología}: nuevas, con actividad inventiva y aplicación industrial; divulgación obligatoria & Fabricar, usar, vender e importar el producto patentado; licencias obligatorias solo con condiciones (31) & $20$ años desde la solicitud \\
      \textbf{Circuitos integrados} (35-38) & Esquemas de trazado (topografías) originales, sobre la base del Tratado de Washington & Impedir reproducir, importar o vender el esquema y los artículos que lo incorporan & $10$ años \\
      \rowcolor{black!4}\textbf{Información no divulgada} (39) & Secretos con valor comercial y protegidos con medidas razonables; datos de pruebas de medicamentos y agroquímicos & Impedir su uso desleal & Mientras sea secreta \\
    \end{tabular}};
  \node[draw=gI, fill=gI!8, line width=0.5pt, rounded corners=1.5pt, align=center, text width=14.9cm, inner sep=3pt, anchor=north] at ([yshift=-0.2cm]tab.south)
    {\textbf{Excepciones}: limitadas, que no atenten contra la explotación normal ni causen un perjuicio injustificado al titular, la «prueba de los tres pasos» (13, 26.2 y 30; más laxa en marcas, 17) $\cdot$ \textbf{licencias obligatorias} de patentes, caso por caso y con remuneración (31 y 31 bis) $\cdot$ exclusiones optativas de la patente: orden público, métodos terapéuticos, plantas y animales (27.2 y 27.3)};
\end{tikzpicture}
