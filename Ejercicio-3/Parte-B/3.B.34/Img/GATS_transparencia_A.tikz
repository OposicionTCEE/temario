% Alternativa A: las cuatro dimensiones de la transparencia como tarjetas. Elaboración propia a partir de los arts. III, III bis y IV.2 del GATS.
\definecolor{oP}{RGB}{40,90,150}
\definecolor{oR}{RGB}{46,125,90}
\definecolor{oV}{RGB}{190,110,30}
\definecolor{oM}{RGB}{120,70,140}
\definecolor{oA}{RGB}{110,110,110}
\begin{tikzpicture}[font=\footnotesize,
    every node/.append style={execute at begin node={\hyphenpenalty=10000}},
    cab/.style={draw=#1, fill=#1, text=white, font=\footnotesize\bfseries, align=center, rounded corners=2pt, inner sep=3pt, text width=3.3cm, minimum height=0.75cm, anchor=north west},
    dest/.style={draw=#1, fill=#1!18, align=center, inner sep=2.5pt, text width=3.3cm, minimum height=0.6cm, anchor=north},
    cuerpo/.style={draw=#1, fill=#1!6, align=left, inner sep=3pt, text width=3.3cm, minimum height=2.35cm, anchor=north}]
  % Problema de partida
  \node[draw=oA, fill=oA!10, rounded corners=2pt, text width=15.1cm, align=center, inner sep=4pt, anchor=north west] (prob) at (0,0)
    {\textbf{Problema}: las barreras a los servicios son normas internas; el primer obstáculo del proveedor extranjero es saber qué requisitos se le aplican};
  % Tarjetas
  \foreach \i/\c/\t/\d/\b in {
    0/oP/{1. Publicar (III.1-2)}/{a todos: público y proveedores}/{Con prontitud, todas las medidas de aplicación general y los acuerdos internacionales sobre servicios. Si no es factible, por otro medio público.},
    1/oR/{2. Notificar (III.3)}/{al Consejo del Comercio de Servicios}/{Al menos una vez al año, los cambios normativos que afecten de forma significativa a los \textbf{sectores comprometidos}.},
    2/oV/{3. Responder (III.4; IV.2)}/{a los demás miembros que pregunten}/{Mediante \textbf{servicios de información}; los países desarrollados, además, \textbf{puntos de contacto} para proveedores de países en desarrollo.},
    3/oM/{4. Contranotificar (III.5)}/{cualquier miembro, sobre otro}/{Puede notificar al Consejo medidas de otro miembro que, a su juicio, afecten al funcionamiento del Acuerdo.}} {
    \node[cab=\c] (h\i) at (\i*3.88,-1.25) {\t};
    \node[dest=\c] (d\i) at (h\i.south) {\d};
    \node[cuerpo=\c] (b\i) at (d\i.south) {\b};
  }
  % Gradación
  \draw[-{Latex[length=2mm]}, oA, line width=0.8pt] (0,-5.85) -- (15.3,-5.85)
    node[pos=0.0, above right, text=oA, inner sep=1pt] {de la información que el miembro da por iniciativa propia\ldots}
    node[pos=1.0, above left, text=oA, inner sep=1pt] {\ldots al control por los demás};
  % Límite
  \node[draw=oA, fill=oA!10, rounded corners=2pt, text width=15.1cm, align=left, inner sep=4pt, anchor=north west] at (0,-6.15)
    {\textbf{Límite (III bis)}: ningún miembro está obligado a revelar información confidencial cuya divulgación impida el cumplimiento de las leyes, sea contraria al interés público o lesione intereses comerciales legítimos.};
\end{tikzpicture}
