% Las negociaciones de servicios desde 1995: vía multilateral y vía plurilateral. Elaboración propia con datos de la OMC.
\definecolor{nM}{RGB}{40,90,150}
\definecolor{nP}{RGB}{46,125,90}
\definecolor{nF}{RGB}{190,70,60}
\definecolor{gI}{RGB}{110,110,110}
\begin{tikzpicture}[font=\footnotesize,
    every node/.append style={execute at begin node={\hyphenpenalty=10000}},
    ev/.style={draw=#1, fill=#1!8, line width=0.5pt, rounded corners=2pt, align=left, inner sep=3pt, text width=2.15cm, anchor=north west, minimum height=2.35cm},
    an/.style={fill=#1, text=white, font=\footnotesize\bfseries, rounded corners=2pt, inner sep=2pt, anchor=south west},
    sig/.style={-{Latex[length=1.8mm]}, line width=0.8pt, #1, bend left=40}]
  \def\paso{2.67}
  % ---------- Vía multilateral ----------
  \node[anchor=west, font=\footnotesize\bfseries, text=nM] at (0,0.95) {Vía multilateral (todos los miembros)};
  \foreach \i/\c/\anio/\t in {
    0/nM/1995/{GATS en vigor; acuerdo provisional en servicios financieros},
    1/nM/1997/{protocolos de telecomunicaciones básicas y de servicios financieros},
    2/nM/2000/{empiezan las negociaciones del art. XIX; en 2001, integradas en Doha},
    3/nM/2005/{Hong Kong: peticiones plurilaterales por sectores},
    4/nF/2008/{conferencia de señales; fracasa el cierre de la Ronda},
    5/nM/2011/{exención para los PMA (prorrogada hasta 2030)}} {
    \node[ev=\c] (m\i) at (\i*\paso,0) {\t};
    \node[an=\c] at ([xshift=2pt]m\i.north west) {\anio};
  }
  \foreach \i [evaluate=\i as \j using int(\i+1)] in {0,...,4} {
    \draw[sig=gI] ([xshift=-0.35cm]m\i.north east) to ([xshift=0.6cm]m\j.north west);
  }
  % ---------- Vía plurilateral ----------
  \node[anchor=west, font=\footnotesize\bfseries, text=nP] at (0,-3.15) {Vía plurilateral (un grupo de miembros)};
  \foreach \i/\c/\anio/\t in {
    1/nP/2013/{empiezan las negociaciones del TiSA ($23$ participantes)},
    2/nF/2016/{el TiSA se paraliza tras $21$ rondas},
    3/nP/2017/{iniciativa conjunta sobre reglamentación nacional ($59$ miembros)},
    4/nP/2021/{concluye con $67$ participantes (documento de referencia)},
    5/nP/2024/{en vigor como compromisos adicionales, con NMF ($57$ miembros)}} {
    \node[ev=\c] (p\i) at (\i*\paso,-4.1) {\t};
    \node[an=\c] at ([xshift=2pt]p\i.north west) {\anio};
  }
  \foreach \i [evaluate=\i as \j using int(\i+1)] in {1,...,4} {
    \draw[sig=gI] ([xshift=-0.35cm]p\i.north east) to ([xshift=0.6cm]p\j.north west);
  }
  % Del bloqueo multilateral a la vía plurilateral
  \draw[-{Latex[length=1.8mm]}, line width=0.8pt, nF, dashed] (m4.south) to[out=-90, in=90, looseness=0.9] ([xshift=0.5cm]p1.north);
  \node[text=nF, font=\footnotesize\itshape, align=center, fill=white, inner sep=1pt] at (7.3,-3.2) {bloqueo multilateral $\Rightarrow$ vía plurilateral};
\end{tikzpicture}
