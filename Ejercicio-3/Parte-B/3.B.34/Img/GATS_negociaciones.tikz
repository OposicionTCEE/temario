% Las negociaciones de servicios desde 1995: vía multilateral y vía plurilateral. Elaboración propia con datos de la OMC.
\definecolor{nM}{RGB}{40,90,150}
\definecolor{nP}{RGB}{46,125,90}
\definecolor{nF}{RGB}{190,70,60}
\definecolor{gI}{RGB}{110,110,110}
\begin{tikzpicture}[font=\scriptsize,
    every node/.append style={execute at begin node={\hyphenpenalty=10000}},
    ev/.style={draw=#1, fill=#1!8, line width=0.5pt, rounded corners=1.5pt, align=left, inner sep=2pt, text width=2.05cm, font=\tiny},
    hito/.style={circle, fill=#1, inner sep=0pt, minimum size=4pt}]
  % Escala: 1995 en x=0, 0,52 cm por año
  \def\ax#1{(#1-1995)*0.52}
  \draw[gI, line width=0.6pt, -{Latex[length=1.6mm]}] (0,0) -- (16.4,0);
  \foreach \a in {1995,2000,2005,2010,2015,2020,2025} {
    \draw[gI] ({\ax{\a}},0.08) -- ({\ax{\a}},-0.08);
    \node[below, font=\tiny, text=gI] at ({\ax{\a}},-0.08) {\a};
  }
  % Etiquetas de las vías
  \node[anchor=west, font=\footnotesize\bfseries, text=nM] at (0,4.35) {Vía multilateral (todos los miembros)};
  \node[anchor=west, font=\footnotesize\bfseries, text=nP] at (0,-1.0) {Vía plurilateral (iniciativas de un grupo de miembros)};
  % Vía multilateral (arriba)
  \foreach \a/\y/\c/\t in {
    1995/1.55/nM/{\textbf{1995}: GATS en vigor; acuerdo provisional en servicios financieros},
    1997/2.75/nM/{\textbf{1997}: protocolos de telecomunicaciones básicas (en vigor en 1998) y de servicios financieros (en vigor en 1999)},
    2000/1.25/nM/{\textbf{2000}: empiezan las negociaciones del art. XIX; en 2001, integradas en la Ronda de Doha},
    2005/2.6/nM/{\textbf{2005}: Hong Kong: peticiones plurilaterales por sectores},
    2008/1.2/nF/{\textbf{2008}: conferencia de señales; fracasa el cierre de la Ronda},
    2011/2.6/nM/{\textbf{2011}: exención para los PMA (prorrogada hasta 2030)}} {
    \node[hito=\c] at ({\ax{\a}},0) {};
    \draw[\c, line width=0.4pt] ({\ax{\a}},0) -- ({\ax{\a}},\y);
    \node[ev=\c, anchor=south west] at ({\ax{\a}-0.08},\y) {\t};
  }
  % Vía plurilateral (abajo)
  \foreach \a/\y/\c/\t in {
    2013/-1.45/nP/{\textbf{2013}: empiezan las negociaciones del TiSA ($23$ participantes)},
    2016/-2.6/nF/{\textbf{2016}: el TiSA se paraliza tras $21$ rondas},
    2017/-3.75/nP/{\textbf{2017}: iniciativa conjunta sobre reglamentación nacional ($59$ miembros)},
    2021/-1.45/nP/{\textbf{2021}: concluye con $67$ participantes (documento de referencia)},
    2024/-2.6/nP/{\textbf{2024}: en vigor, como compromisos adicionales y con NMF ($57$ miembros)}} {
    \node[hito=\c] at ({\ax{\a}},0) {};
    \draw[\c, line width=0.4pt] ({\ax{\a}},0) -- ({\ax{\a}},\y);
    \node[ev=\c, anchor=north west] at ({\ax{\a}-0.08},\y) {\t};
  }
\end{tikzpicture}
