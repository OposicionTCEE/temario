% Estructura y funcionamiento del Acuerdo sobre Contratación Pública (ACP 2012). Elaboración propia a partir del texto del ACP y de la OMC.
\definecolor{vA}{RGB}{60,120,110}
\definecolor{vB}{RGB}{35,85,80}
\definecolor{gI}{RGB}{110,110,110}
\begin{tikzpicture}[font=\scriptsize,
    every node/.append style={execute at begin node={\hyphenpenalty=10000}},
    cab/.style={fill=#1, text=white, font=\footnotesize\bfseries, align=center, text width=6.9cm, inner sep=3pt, rounded corners=2pt},
    it/.style={draw=#1, fill=#1!10, line width=0.5pt, rounded corners=1.5pt, align=left, inner sep=2.5pt}]
  \node[draw=gI, fill=gI!8, line width=0.5pt, rounded corners=1.5pt, align=center, text width=14.6cm, inner sep=3pt, anchor=south west] (top) at (0,4.2)
    {\textbf{Punto de partida}: la contratación pública queda fuera del trato nacional del GATT (art. III.8.a) y del GATS (art. XIII) $\Rightarrow$ solo se abre por acuerdo expreso, y solo entre las partes};
  \node[cab=vA, anchor=north west] (h1) at (0,3.85) {Texto del Acuerdo: \textit{cómo} se contrata};
  \node[it=vA, anchor=north] (b1) at (h1.south) {\parbox[t][2.45cm][t]{6.85cm}{\raggedright
    $\cdot$ \textbf{No discriminación}: trato nacional y NMF entre las partes (IV).\\[2pt]
    $\cdot$ \textbf{Transparencia}: anuncios, plazos mínimos, criterios de adjudicación publicados.\\[2pt]
    $\cdot$ \textbf{Procedimientos}: licitación abierta, selectiva o, por excepción, restringida; contratación electrónica.\\[2pt]
    $\cdot$ Prohibición de las compensaciones (\textit{offsets}), salvo transitoriamente para países en desarrollo.}};
  \node[cab=vB, anchor=north east] (h2) at (14.75,3.85) {Listas de cada parte: \textit{qué} se abre};
  \node[it=vB, anchor=north] (b2) at (h2.south) {\parbox[t][2.45cm][t]{6.85cm}{\raggedright
    $\cdot$ \textbf{Entidades}: centrales (anexo 1), subcentrales (anexo 2) y otras, como empresas públicas (anexo 3).\\[2pt]
    $\cdot$ \textbf{Objeto}: bienes (4), servicios (5) y obras (6), con notas generales (7).\\[2pt]
    $\cdot$ \textbf{Umbrales}: solo los contratos que los superan; para la Administración central, $130.000$ DEG en bienes y servicios y $5$ millones en obras.\\[2pt]
    $\cdot$ Cobertura a menudo \textbf{recíproca}, parte a parte.}};
  \node[draw=gI, fill=gI!8, line width=0.5pt, rounded corners=1.5pt, align=center, text width=14.6cm, inner sep=3pt, anchor=north west] (bot) at ([yshift=-0.25cm]b1.south west)
    {\textbf{Aplicación}: recurso interno ante un órgano independiente (XVIII) $\cdot$ solución de diferencias de la OMC $\cdot$ Comité de Contratación Pública $\cdot$ \textbf{Resultado}: $22$ partes, $49$ miembros, más de $1,7$ billones de dólares al año abiertos a la competencia};
\end{tikzpicture}
