% Principios básicos del ADPIC (Parte I) y dilema de la duración óptima de la protección. Elaboración propia a partir de los arts. 1 a 8 del ADPIC y de NORDHAUS (1969).
\definecolor{pA}{RGB}{150,110,170}
\definecolor{pC}{RGB}{100,55,130}
\definecolor{pE}{RGB}{60,30,90}
\definecolor{gI}{RGB}{110,110,110}
\begin{tikzpicture}[font=\scriptsize,
    every node/.append style={execute at begin node={\hyphenpenalty=10000}},
    cab/.style={fill=#1, text=white, font=\footnotesize\bfseries, align=center, inner sep=3pt, rounded corners=2pt},
    it/.style={draw=#1, fill=#1!10, line width=0.5pt, rounded corners=1.5pt, align=left, inner sep=2.5pt},
    tit/.style={font=\footnotesize\bfseries, anchor=south west}]
  % ---------------- Panel (a): los principios y sus dos dimensiones ----------------
  \node[tit] at (0,5.05) {(a) Dos dimensiones de los principios};
  % Suelo común
  \node[draw=gI, fill=gI!8, line width=0.5pt, rounded corners=1.5pt, align=center, text width=8.6cm, inner sep=3pt, anchor=north west] (suelo) at (0,4.95)
    {\textbf{Punto de partida: normas mínimas comunes} (1.1): cada miembro puede proteger más, no menos $\cdot$ incorpora los convenios de París, Berna y Washington (2, 9 y 35): protección «París-plus» y «Berna-plus»};
  % Columna izquierda: entre miembros
  \node[cab=pA, text width=4.05cm, anchor=north west] (hA) at (0,3.85) {Entre miembros\\{\scriptsize\mdseries no discriminación}};
  \node[it=pA, anchor=north] (bA) at (hA.south) {\parbox[t][3.1cm][t]{4.0cm}{\raggedright
     \textbf{Trato nacional} (3): el titular extranjero, como el nacional; ya existía en París y Berna, ahora se extiende a la observancia.\\[2pt]
     \textbf{Nación más favorecida} (4): \textbf{novedad} en la propiedad intelectual; lo que se conceda a los nacionales de un país, a todos.\\[2pt]
     Excepciones: acuerdos previos a 1995 notificados, ciertas reglas de Berna y Roma (4) y procedimientos de la OMPI (5). Sin excepción regional.}};
  % Columna derecha: entre titulares y sociedad
  \node[cab=pC, text width=4.05cm, anchor=north east] (hC) at (8.8,3.85) {Entre titulares y sociedad\\{\scriptsize\mdseries protección equilibrada}};
  \node[it=pC, anchor=north] (bC) at (hC.south) {\parbox[t][3.1cm][t]{4.0cm}{\raggedright
     \textbf{Objetivos} (7): innovación \emph{y} transferencia y difusión de la tecnología, en beneficio de productores y usuarios.\\[2pt]
     \textbf{Principios} (8): medidas para proteger la salud pública y la nutrición (8.1) y para prevenir el abuso de los derechos (8.2).\\[2pt]
     \textbf{Agotamiento} (6): cada miembro decide si admite las importaciones paralelas.}};
  % Proyección hacia el resto del bloque
  \node[draw=gI, fill=gI!8, line width=0.5pt, rounded corners=1.5pt, align=center, text width=8.6cm, inner sep=3pt, anchor=north west] (proy) at ([yshift=-0.25cm]bA.south west)
    {\textbf{Se proyectan en}: normas mínimas y sus excepciones $\cdot$ control de las prácticas anticompetitivas $\cdot$ observancia $\cdot$ salud pública (Doha, 2001; art. 31 bis)};
  \draw[-{Latex[length=1.6mm]}, black!45, line width=0.5pt] (bA.south) -- (bA.south |- proy.north);
  \draw[-{Latex[length=1.6mm]}, black!45, line width=0.5pt] (bC.south) -- (bC.south |- proy.north);
  % ---------------- Panel (b): el dilema de la duración ----------------
  \node[tit] at (9.6,5.05) {(b) ¿Cuánto debe durar la protección?};
  \begin{scope}[shift={(10.15,0.05)}]
    \begin{axis}[width=6.3cm, height=5.6cm, axis lines=left, xmin=0, xmax=30, ymin=-1, ymax=12.5,
        xtick=\empty, ytick=\empty, xlabel={duración de la protección, $T$}, ylabel={bienestar},
        xlabel style={font=\scriptsize, at={(axis description cs:0.5,-0.13)}}, ylabel style={font=\scriptsize}, clip=false]
      \addplot[domain=0:29, samples=80, very thick, color=pA] {10*(1-exp(-0.15*x))};
      \addplot[domain=0:29, samples=60, very thick, color=gI, dashed] {0.25*x};
      \addplot[domain=0:29, samples=80, very thick, color=pE] {10*(1-exp(-0.15*x))-0.25*x};
      \draw[dotted, black!60] (axis cs:11.95,-1) -- (axis cs:11.95,{10*(1-exp(-0.15*11.95))-0.25*11.95});
      \node[anchor=north, font=\scriptsize] at (axis cs:11.95,-1) {$T^{*}$};
      \node[anchor=west, align=left, font=\scriptsize, text=pA] at (axis cs:29.5,9.9) {beneficio dinámico:\\más innovación};
      \node[anchor=west, align=left, font=\scriptsize, text=gI] at (axis cs:29.5,7.25) {coste estático:\\monopolio};
      \node[anchor=west, align=left, font=\scriptsize, text=pE] at (axis cs:29.5,2.6) {bienestar\\neto};
    \end{axis}
  \end{scope}
\end{tikzpicture}
