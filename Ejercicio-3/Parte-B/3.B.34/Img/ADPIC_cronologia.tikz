% Evolución del ADPIC desde 1995: flexibilidades frente a protección al alza. Elaboración propia con datos de la OMC y la OMPI.
\definecolor{pA}{RGB}{150,110,170}
\definecolor{pE}{RGB}{60,30,90}
\definecolor{gI}{RGB}{110,110,110}
\begin{tikzpicture}[font=\scriptsize,
    ev/.style={draw=#1, fill=#1!10, line width=0.5pt, rounded corners=1.5pt, align=left, text width=2.3cm, inner sep=2pt},
    every node/.append style={execute at begin node={\hyphenpenalty=10000}}]
  \def\ux{0.48}
  % Eje
  \draw[-{Latex[length=2mm]}, line width=0.8pt, black!70] (0,0) -- (32*\ux,0);
  \foreach \a in {1995,2000,2005,2010,2015,2020,2025} {
    \pgfmathsetmacro\xx{(\a-1995)*\ux}
    \draw[black!70] (\xx,-0.08) -- (\xx,0.08);
    \node[below, font=\scriptsize\bfseries, black!70] at (\xx,-0.08) {\a};
  }
  \node[anchor=south west, font=\footnotesize\bfseries, pA] at (0,3.35) {Flexibilidades: salud pública y PMA};
  \node[anchor=north west, font=\footnotesize\bfseries, pE] at (0,-3.75) {Protección al alza: acuerdos ADPIC-plus y diferencias};
  % Arriba: flexibilidades (año, altura, texto)
  \foreach \a/\h/\t in {
    2001/0.55/{\textbf{2001} Declaración de Doha: licencias obligatorias por cualquier motivo},
    2003/2.05/{\textbf{2003} Decisión de 30 de agosto: exportar genéricos con licencia obligatoria},
    2007.5/0.55/{\textbf{2007} Único uso: Canadá exporta a Ruanda un antirretroviral},
    2017/2.05/{\textbf{2017} Entra en vigor el art. 31 bis},
    2020.8/0.55/{\textbf{2020} India y Sudáfrica proponen suspender el ADPIC por la COVID},
    2022.6/2.05/{\textbf{2021-2022} PMA, prórroga hasta 2034; CM12: exención solo para vacunas}} {
    \pgfmathsetmacro\xx{(\a-1995)*\ux}
    \draw[pA, line width=0.5pt] (\xx,0) -- (\xx,\h);
    \node[ev=pA, anchor=south] at (\xx,\h) {\t};
  }
  % Abajo: protección al alza
  \foreach \a/\h/\t in {
    1997/0.55/{\textbf{1997} \textit{India --- Patentes}: obligación del «buzón»},
    2001/2.05/{\textbf{2000-2010} Acuerdos de EE.UU. y la Unión con cláusulas ADPIC-plus},
    2009/0.55/{\textbf{2009} \textit{China --- DPI}: primera diferencia sobre observancia},
    2019.5/2.05/{\textbf{2020} \textit{Australia --- Empaquetado}: la salud justifica limitar marcas},
    2024.2/0.55/{\textbf{2024} Tratado de la OMPI sobre recursos genéticos},
    2026.4/2.05/{\textbf{2025-2026} \textit{China --- Antiprocesos}; expira la moratoria de reclamaciones sin infracción}} {
    \pgfmathsetmacro\xx{(\a-1995)*\ux}
    \draw[pE, line width=0.5pt] (\xx,0) -- (\xx,-\h);
    \node[ev=pE, anchor=north] at (\xx,-\h) {\t};
  }
\end{tikzpicture}
