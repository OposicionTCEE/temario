% Evolución del ADPIC desde 1995: flexibilidades frente a protección al alza. Elaboración propia con datos de la OMC y la OMPI.
\definecolor{pA}{RGB}{150,110,170}
\definecolor{pE}{RGB}{60,30,90}
\definecolor{gI}{RGB}{110,110,110}
\begin{tikzpicture}[font=\footnotesize,
    every node/.append style={execute at begin node={\hyphenpenalty=10000}},
    ev/.style={draw=#1, fill=#1!10, line width=0.5pt, rounded corners=2pt, inner sep=3pt, anchor=north west},
    an/.style={fill=#1, text=white, font=\footnotesize\bfseries, rounded corners=2pt, inner sep=2pt, anchor=center},
    sig/.style={-{Latex[length=1.8mm]}, line width=0.9pt, gI, bend left=55}]
  \def\paso{2.64}
  % ---------- Flexibilidades ----------
  \node[anchor=west, font=\footnotesize\bfseries, text=pA] at (0,0.75) {En la OMC: flexibilidades para la salud pública y los PMA};
  \foreach \i/\anio/\t in {
    0/2001/{Declaración de Doha: licencias obligatorias por cualquier motivo},
    1/2003/{Decisión de 30 de agosto: exportar genéricos con licencia obligatoria},
    2/2007/{único uso: Canadá exporta a Ruanda un antirretroviral},
    3/2017/{entra en vigor el art. $31$ bis},
    4/2020/{India y Sudáfrica proponen suspender el ADPIC por la COVID},
    5/2021-22/{PMA: prórroga hasta 2034; CM12: exención solo para vacunas}} {
    \node[ev=pA] (f\i) at (\i*\paso,0) {\parbox[t][2.05cm][t]{2.15cm}{\raggedright\vspace*{6pt}\t}};
    \node[an=pA] at (f\i.north) {\anio};
  }
  \foreach \i [evaluate=\i as \j using int(\i+1)] in {0,...,4} {
    \draw[sig] ([xshift=-0.25cm]f\i.north east) to ([xshift=0.25cm]f\j.north west);
  }
  % ---------- Protección al alza ----------
  \node[anchor=west, font=\footnotesize\bfseries, text=pE] at (0,-3.3) {Fuera de la OMC y en las diferencias: protección al alza};
  \foreach \i/\anio/\t in {
    0/1997/{\textit{India --- Patentes}: obligación del «buzón»},
    1/2000-10/{acuerdos de EE.UU. y de la Unión con cláusulas ADPIC-plus},
    2/2009/{\textit{China --- DPI}: primera diferencia sobre observancia},
    3/2020/{\textit{Australia --- Empaquetado}: la salud justifica limitar las marcas},
    4/2024/{Tratado de la OMPI sobre recursos genéticos},
    5/2025-26/{\textit{China --- Antiprocesos}; expira la moratoria de reclamaciones sin infracción}} {
    \node[ev=pE] (p\i) at (\i*\paso,-4.15) {\parbox[t][2.05cm][t]{2.15cm}{\raggedright\vspace*{6pt}\t}};
    \node[an=pE] at (p\i.north) {\anio};
  }
  \foreach \i [evaluate=\i as \j using int(\i+1)] in {0,...,4} {
    \draw[sig] ([xshift=-0.25cm]p\i.north east) to ([xshift=0.25cm]p\j.north west);
  }
\end{tikzpicture}
