% Control de las prácticas anticompetitivas en el ADPIC: qué, cómo y con qué límites. Elaboración propia a partir de los arts. 8.2, 31 y 40 del ADPIC.
\definecolor{pA}{RGB}{150,110,170}
\definecolor{pC}{RGB}{100,55,130}
\definecolor{pE}{RGB}{60,30,90}
\definecolor{gI}{RGB}{110,110,110}
\definecolor{rO}{RGB}{170,60,50}
\begin{tikzpicture}[font=\scriptsize,
    every node/.append style={execute at begin node={\hyphenpenalty=10000}},
    cab/.style={fill=#1, text=white, font=\footnotesize\bfseries, align=center, text width=4.35cm, inner sep=3pt, rounded corners=2pt, minimum height=0.95cm},
    it/.style={draw=#1, fill=#1!10, line width=0.5pt, rounded corners=1.5pt, align=left, inner sep=2.5pt},
    pre/.style={font=\scriptsize\itshape, text=black!65, align=center, text width=4.4cm}]
  % Origen: el derecho y la licencia
  \node[draw=gI, fill=gI!8, line width=0.5pt, rounded corners=1.5pt, align=center, text width=14.6cm, inner sep=3pt, anchor=south west] (orig) at (0,4.3)
    {\textbf{Punto de partida}: el titular de un derecho (patente, derecho de autor, \textit{know-how}\ldots) concede \textbf{licencias} a terceros. La licencia difunde la tecnología, pero sus condiciones pueden usarse para restringir la competencia o la transferencia de tecnología (art. $8.2$)};
  \foreach \i/\x/\c/\q/\t/\cuerpo in {
    1/0.0/pA/{¿qué se combate?}/{Prácticas abusivas\\{\scriptsize\mdseries art. 40.2}}/{Ejemplos del propio Acuerdo:\\[1pt]
      $\cdot$ \textbf{retrocesión exclusiva}: el licenciatario debe ceder al titular, en exclusiva, las mejoras que desarrolle;\\[1pt]
      $\cdot$ \textbf{cláusulas de no impugnación} de la validez del derecho;\\[1pt]
      $\cdot$ \textbf{licencias conjuntas obligatorias}: tecnologías que no se quieren, empaquetadas con la que se necesita.\\[1pt]
      Otras, según cada legislación: precios impuestos, reparto de mercados, prohibición de exportar.},
    2/5.12/pC/{¿cómo se combate?}/{Instrumentos\\{\scriptsize\mdseries arts. 40 y 31.k}}/{$\cdot$ El \textbf{derecho nacional de la competencia} define qué es abusivo y lo sanciona (40.2).\\[1pt]
      $\cdot$ \textbf{Licencia obligatoria} como remedio: sin negociación previa y sin limitarse al mercado interno (31.k).\\[1pt]
      $\cdot$ \textbf{Consultas y cooperación} entre autoridades de distintos miembros, con intercambio de información (40.3 y 40.4).},
    3/10.24/pE/{¿con qué límites?}/{Alcance\\{\scriptsize\mdseries asimetría}}/{$\cdot$ Las medidas deben ser \textbf{compatibles con el Acuerdo}: no pueden rebajar las normas mínimas.\\[1pt]
      $\cdot$ El control es \textbf{facultativo}: proteger es obligatorio; vigilar el abuso, no.\\[1pt]
      $\cdot$ \textbf{Sin derecho de la competencia común}: la negociación en la OMC se abandonó en 2004.}} {
    \node[cab=\c, anchor=north west] (h\i) at (\x,3.75) {\t};
    \node[it=\c, anchor=north] (b\i) at (h\i.south) {\parbox[t][3.95cm][t]{4.3cm}{\raggedright\cuerpo}};
    \node[pre, anchor=south] (q\i) at (h\i.north) {\q};
    \draw[-{Latex[length=1.6mm]}, black!45, line width=0.5pt] (orig.south -| q\i.north) -- (q\i.north);
  }
  \draw[-{Latex[length=2mm]}, black!55, line width=0.7pt] (b1.east) -- (b2.west);
  \draw[-{Latex[length=2mm]}, black!55, line width=0.7pt] (b2.east) -- (b3.west);
\end{tikzpicture}
