% Esquema de una página del bloque 2 (Propiedad intelectual: el ADPIC), para el anexo «Material de estudio: Esquemas».
% Se lee de arriba abajo, en el orden del bloque: por qué está en la OMC y su objetivo -> principios (sobre el suelo
% común) -> obligaciones (cuatro preguntas) -> desarrollo en dos direcciones -> balance.
% Colores: el morado de las figuras del ADPIC; verde y rojo para las dos direcciones del desarrollo.
% Tamaño: 16 cm de ancho y menos de 23 cm de alto; letra de 8 pt como mínimo.
% Generar con: bash Code/generar_figura.sh OMC_esquema_2
\definecolor{pA}{RGB}{150,110,170}%
\definecolor{pB}{RGB}{125,80,150}%
\definecolor{pC}{RGB}{100,55,130}%
\definecolor{pD}{RGB}{80,40,110}%
\definecolor{pE}{RGB}{60,30,90}%
\definecolor{gI}{RGB}{110,110,110}%
\definecolor{gTr}{RGB}{60,60,60}%
\definecolor{fV}{RGB}{46,125,90}%
\definecolor{fR}{RGB}{190,70,60}%
\begin{tikzpicture}[font=\footnotesize,
    every node/.append style={execute at begin node={\hyphenpenalty=10000}},
    sec/.style={font=\small\bfseries, text=gI, anchor=south west, inner sep=0pt},
    cab/.style 2 args={fill=#1, text=white, font=\small\bfseries, align=center, text width=#2, inner sep=3pt, rounded corners=2pt, anchor=north},
    it/.style 2 args={draw=#1, fill=#1!8, line width=0.5pt, rounded corners=2pt, align=left, text width=#2, inner sep=3pt},
    clave/.style 2 args={draw=#1, fill=white, line width=1.1pt, rounded corners=2pt, align=left, text width=#2, inner sep=3pt},
    flecha/.style={-{Latex[length=1.6mm]}, line width=0.6pt, black!60}]

  % ===================== 1. Por qué en la OMC y objetivo =====================
  \node[sec] at (0,0) {Un acuerdo que invierte la lógica de la OMC: no elimina barreras, crea derechos exclusivos};
  \node[it={gI}{4.95cm}, anchor=north, minimum height=2.25cm] (o1) at (2.6,-0.2) {\textbf{Por qué en la OMC}: los PD, empujados por grandes empresas farmacéuticas, informáticas y del entretenimiento (SELL), querían corregir las carencias de la OMPI y vincular la protección al comercio};
  \node[it={pC}{4.95cm}, anchor=north, minimum height=2.25cm, line width=1.1pt] (o2) at (8.0,-0.2) {\textbf{El acuerdo más asimétrico de la Ronda Uruguay}: estándares próximos a los de los PD, exigibles ante el OSD (retorsión cruzada). Los PED lo aceptan en el todo único a cambio de agricultura, textiles y plazos};
  \node[it={pE}{4.95cm}, anchor=north, minimum height=2.25cm] (o3) at (13.4,-0.2) {\textbf{Objetivo}: reducir las distorsiones del comercio; protección ni insuficiente (copia) ni excesiva (barrera). Dos objetivos operativos, marco mínimo común y solución de conflictos, y un fin: el equilibrio (art. 7)};
  \draw[flecha] (o1) -- (o2); \draw[flecha] (o2) -- (o3);

  % ===================== 2. Principios =====================
  \node[sec] (sP) at ([yshift=-0.5cm]o1.south west) {Principios (Parte I), sobre un suelo común que se puede superar, pero no rebajar (art. 1.1)};
  \node[it={pA}{7.67cm}, anchor=north west, minimum height=2.05cm] (p1) at ([yshift=-0.2cm]sP.south west) {\textbf{No discriminación} \textit{(entre miembros)}: trato nacional, ya en París y Berna, y \textbf{NMF}, la novedad: impide que la protección de cada titular dependa del poder negociador de su gobierno. Sin excepción regional $\to$ lo ADPIC-plus de los acuerdos posteriores a 1995 beneficia a todos};
  \node[it={pC}{7.67cm}, anchor=north east, minimum height=2.05cm] (p2) at ([yshift=-0.2cm]sP.south west -| 16,0) {\textbf{Equilibrio} \textit{(entre titulares y sociedad)}: incentivo a innovar frente a acceso; duración y amplitud, en parte sustitutivas; el óptimo del Norte no es el del Sur (HELPMAN; GROSSMAN y LAI). Se plasma en el art. 8 (salud, abusos) y en el agotamiento (art. 6: importaciones paralelas)};

  % ===================== 3. Obligaciones: cuatro preguntas =====================
  \node[sec] (sO) at ([yshift=-0.5cm]p1.south west) {Obligaciones: cuatro preguntas};
  \node[cab={pA}{3.64cm}, minimum height=1.2cm] (h1) at ([yshift=-0.2cm]sO.south -| 1.925,0) {Normas mínimas\\{\footnotesize\mdseries\itshape ¿qué se protege? (Parte II)}};
  \node[cab={pB}{3.64cm}, minimum height=1.2cm] (h2) at (h1.north -| 5.975,0) {Competencia\\{\footnotesize\mdseries\itshape ¿cómo se evita el abuso?}};
  \node[cab={pD}{3.64cm}, minimum height=1.2cm] (h3) at (h1.north -| 10.025,0) {Observancia\\{\footnotesize\mdseries\itshape ¿cómo se cumple? (Parte III)}};
  \node[cab={pE}{3.64cm}, minimum height=1.2cm] (h4) at (h1.north -| 14.075,0) {Periodos transitorios\\{\footnotesize\mdseries\itshape ¿desde cuándo?}};
  \foreach \a/\b in {h1/h2, h2/h3, h3/h4} \draw[flecha] (\a) -- (\b);
  \node[it={pA}{3.62cm}, below=0.2cm of h1, minimum height=3.15cm] (n1) {\textbf{Siete derechos}: patentes (nueva, inventiva, aplicación industrial; todos los campos), derecho de autor, marcas, diseños, indicaciones geográficas, circuitos integrados e información no divulgada.\\\textbf{Excepciones}: prueba de los tres pasos y licencias obligatorias: las \textit{flexibilidades}};
  \node[it={pB}{3.62cm}, below=0.2cm of h2, minimum height=3.15cm] (n2) {\textbf{El riesgo}: licencias abusivas (retrocesión, no impugnación, paquetes).\\\textbf{Remedios}, caso por caso: derecho nacional de la competencia, licencia obligatoria y cooperación.\\\textbf{Asimetría}: proteger es obligatorio; controlar los abusos, facultativo};
  \node[it={pD}{3.62cm}, below=0.2cm of h3, minimum height=3.15cm] (n3) {\textbf{La gran novedad} frente a la OMPI: procedimientos justos, rápidos y recurribles.\\Cuatro medidas: civiles, provisionales, en frontera y penales (falsificación y piratería a escala comercial)};
  \node[it={pE}{3.62cm}, below=0.2cm of h4, minimum height=3.15cm] (n4) {\textbf{PD}: 1996.\\\textbf{PED}: 2000 (patentes de producto, 2005).\\\textbf{PMA}: 2006, prorrogado.\\Plazos cortos: no dio tiempo a imitar, como hicieron los PD al industrializarse};

  % ===================== 4. Desarrollo: dos direcciones =====================
  \node[sec] (sD) at ([yshift=-0.5cm]n1.south west) {Desarrollo desde 1995: dos direcciones opuestas};
  \node[it={fV}{7.67cm}, anchor=north west, minimum height=1.6cm] (d1) at ([yshift=-0.2cm]sD.south west) {\textbf{En la OMC, más flexibilidad}: Declaración de Doha sobre salud pública (2001: licencias obligatorias, emergencia, agotamiento) $\to$ art. 31 bis $\to$ CM12 (2022), solo vacunas contra la COVID-19 y de efecto mínimo. El resto de la agenda apenas avanza};
  \node[it={fR}{7.67cm}, anchor=north east, minimum height=1.6cm] (d2) at ([yshift=-0.2cm]sD.south west -| 16,0) {\textbf{Fuera de la OMC, protección al alza}: ADPIC-plus en los acuerdos de EE.UU. y de la Unión; por la NMF se extiende a todos: un trinquete que eleva el suelo sin negociarlo. Con péndulo: Transpacífico (2017) y T-MEC (2019)};

  % ===================== 5. Balance =====================
  \node[sec] (sB) at ([yshift=-0.5cm]d1.south west) {Balance: eficaz como protección, no como equilibrio};
  \node[it={gTr}{4.95cm}, anchor=north west, minimum height=2.3cm] (b1) at ([yshift=-0.2cm]sB.south west) {\textbf{Objetivo comercial, sí}: protección alta, común y exigible; las diferencias se resuelven en la OMC.\\\textbf{Equilibrio, no}: más transferencia dentro de las multinacionales, pero no innovación para las necesidades de los pobres};
  \node[it={gTr}{4.95cm}, anchor=north, minimum height=2.3cm] (b2) at ([yshift=-0.2cm]sB.south -| 8.0,0) {\textbf{Razón}: el conflicto Norte-Sur. Armonizar al nivel de los innovadores maximiza su bienestar, no el mundial (DEARDORFF, 1992); las concesiones en agricultura y textiles valieron menos de lo esperado};
  \node[it={gTr}{4.95cm}, anchor=north east, minimum height=2.3cm] (b3) at ([yshift=-0.2cm]sB.south -| 16,0) {\textbf{Asimetrías}: PD ofensivos (rentas hacia EE.UU.); PED y PMA pagan más y pierden la vía de la imitación; la renta media puede ganar (India, genéricos). \textbf{Críticas} desde los dos lados: acceso y observancia};
  \node[clave={gTr}{15.75cm}, anchor=north west] (b4) at ([yshift=-0.25cm]b1.south west) {$\Rightarrow$ El reto sigue siendo el de 1994: un sistema que incentive la innovación sin excluir de sus frutos a quienes no pueden pagarla};
\end{tikzpicture}%
