% Estructura del GATS como construcción progresiva de la liberalización. Elaboración propia a partir del texto del GATS (anexo 1B del Acuerdo de Marrakech).
\definecolor{gA}{RGB}{120,160,200}
\definecolor{gB}{RGB}{80,130,185}
\definecolor{gC}{RGB}{40,90,150}
\definecolor{gD}{RGB}{25,60,110}
\definecolor{gI}{RGB}{110,110,110}
\begin{tikzpicture}[font=\scriptsize,
    every node/.append style={execute at begin node={\hyphenpenalty=10000}},
    cab/.style={fill=#1, text=white, font=\footnotesize\bfseries, align=center, text width=3.05cm, inner sep=3pt, rounded corners=2pt},
    it/.style={draw=#1, fill=#1!10, line width=0.5pt, rounded corners=1.5pt, align=left, text width=3.0cm, inner sep=2.5pt},
    preg/.style={font=\scriptsize\itshape, text=black!65, align=center, text width=3.1cm}]
  % Peldaños: cada parte añade obligación y reduce cobertura
  \foreach \i/\x/\y/\c/\p/\t/\q/\cuerpo in {
    1/0.0/0.0/gA/{Parte I $\cdot$ art. I}/{Alcance y definición}/{¿qué cubre?}/{Todos los servicios y todas las medidas que los afectan, en los \textbf{cuatro modos de suministro}.\\[1pt] Excluidos: servicios prestados en ejercicio de facultades gubernamentales y derechos de tráfico aéreo.},
    2/3.35/1.2/gB/{Parte II $\cdot$ arts. II-XV}/{Obligaciones generales}/{¿qué obliga siempre?}/{\textbf{En todos los sectores}: NMF (II), con exenciones; transparencia (III); integración económica (V); excepciones (XIV y XIV bis).\\[1pt] \textbf{Solo en los sectores comprometidos}: reglamentación nacional (VI) y pagos y transferencias (XI).},
    3/6.7/2.4/gC/{Parte III $\cdot$ arts. XVI-XVIII}/{Compromisos específicos}/{¿qué se liberaliza?}/{\textbf{Listas positivas}, sector a sector y modo a modo: acceso a los mercados (XVI), trato nacional (XVII) y compromisos adicionales (XVIII).},
    4/10.05/3.6/gD/{Parte IV $\cdot$ arts. XIX-XXI}/{Liberalización progresiva}/{¿cómo se amplía?}/{\textbf{Rondas sucesivas} de negociación, la primera a partir de 2000 (XIX); modificación o retirada de compromisos con compensación (XXI).}} {
    \node[it=\c, anchor=south west, minimum height=2.15cm] (b\i) at (\x,\y) {\cuerpo};
    \node[cab=\c, anchor=south, inner sep=2.5pt] (h\i) at (b\i.north) {{\scriptsize\mdseries \p}\\\t};
    \node[preg, anchor=south] at (h\i.north) {\q};
  }
  % Anexos en el hueco inferior derecho
  \node[draw=gI, fill=gI!8, line width=0.5pt, rounded corners=1.5pt, align=left, text width=6.25cm, inner sep=3pt, anchor=south west] (anx) at (6.75,0.05)
    {\textbf{Anexos y listas} (parte integrante del Acuerdo, arts. XX y XXIX)\\[1pt]
     Exenciones del art. II $\cdot$ movimiento de personas físicas $\cdot$ transporte aéreo $\cdot$ servicios financieros (dos) $\cdot$ transporte marítimo $\cdot$ telecomunicaciones (dos)\\[1pt]
     + la \textbf{lista de compromisos} y la \textbf{lista de exenciones de NMF} de cada miembro};
  % Base institucional
  \node[draw=gI, fill=gI!8, line width=0.5pt, rounded corners=1.5pt, align=center, text width=12.9cm, inner sep=3pt, anchor=north west] (base) at (0.0,-0.8)
    {\textbf{Partes V y VI (arts. XXII-XXIX): disposiciones institucionales y finales}\quad consultas y solución de diferencias (XXII-XXIII) $\cdot$ Consejo del Comercio de Servicios (XXIV) $\cdot$ definiciones (XXVIII)};
  % Flecha: más obligación, menos cobertura
  \draw[-{Latex[length=2mm]}, line width=0.6pt, black!60] (0.0,-0.3) -- (13.1,-0.3);
  \node[anchor=north west, font=\scriptsize\itshape, black!70] at (0.0,-0.33) {cada peldaño obliga más, pero a menos sectores: de todos los servicios a los inscritos en las listas};
\end{tikzpicture}
