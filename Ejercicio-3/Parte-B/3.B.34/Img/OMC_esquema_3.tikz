% Esquema de una página del bloque 3 (Instrumentos plurilaterales), para el anexo «Material de estudio: Esquemas».
% Se lee de arriba abajo, en el orden del bloque: por qué la vía plurilateral -> las cuatro vías -> los casos, por vía
% (anexo 4, iniciativas conjuntas, ambientales), con su resultado en color -> balance.
% Colores: el verde azulado de las figuras PLURI_*; resultado: verde = en vigor, ámbar = provisional,
% rojo = bloqueado o abandonado, gris = solo diálogo. Tamaño: 16 cm de ancho y menos de 23 cm de alto; letra de 8 pt.
% Generar con: bash Code/generar_figura.sh OMC_esquema_3
\definecolor{vA}{RGB}{60,120,110}%
\definecolor{vB}{RGB}{35,85,80}%
\definecolor{gI}{RGB}{110,110,110}%
\definecolor{gTr}{RGB}{60,60,60}%
\definecolor{rV}{RGB}{46,125,90}%
\definecolor{rA}{RGB}{225,170,60}%
\definecolor{rR}{RGB}{190,70,60}%
\begin{tikzpicture}[font=\footnotesize,
    every node/.append style={execute at begin node={\hyphenpenalty=10000}},
    sec/.style={font=\small\bfseries, text=gI, anchor=south west, inner sep=0pt},
    cab/.style 2 args={fill=#1, text=white, font=\small\bfseries, align=center, text width=#2, inner sep=3pt, rounded corners=2pt, anchor=north},
    it/.style 2 args={draw=#1, fill=#1!8, line width=0.5pt, rounded corners=2pt, align=left, text width=#2, inner sep=3pt},
    res/.style 2 args={draw=#1, fill=#1!10, line width=0.9pt, rounded corners=2pt, align=left, text width=#2, inner sep=3pt},
    clave/.style 2 args={draw=#1, fill=white, line width=1.1pt, rounded corners=2pt, align=left, text width=#2, inner sep=3pt},
    flecha/.style={-{Latex[length=1.6mm]}, line width=0.6pt, black!60}]

  % ===================== 1. ¿Por qué la vía plurilateral? =====================
  \node[sec] at (0,0) {Lo que prospera no depende de la materia, sino de la vía: avanza lo que no necesita el consenso de todos};
  \node[it={gI}{4.95cm}, anchor=north, minimum height=1.55cm] (o1) at (2.6,-0.2) {\textbf{El problema}: el todo único, clave en Uruguay, convierte cada materia en rehén de las demás en una OMC de más de $160$ miembros};
  \node[it={gI}{4.95cm}, anchor=north, minimum height=1.55cm] (o2) at (8.0,-0.2) {\textbf{Primera respuesta} (CM8): cerrar acuerdos parciales por consenso antes de concluir el todo único};
  \node[it={vB}{4.95cm}, anchor=north, minimum height=1.55cm, line width=1.1pt] (o3) at (13.4,-0.2) {\textbf{Segunda respuesta}: la vía plurilateral, en la que participa solo una parte de los miembros: más pragmática y más controvertida};
  \draw[flecha] (o1) -- (o2); \draw[flecha] (o2) -- (o3);

  % ===================== 2. Las cuatro vías =====================
  \node[sec] (sV) at ([yshift=-0.5cm]o1.south west) {Cuatro vías: quién se obliga, quién se beneficia y qué hace falta para entrar en la OMC};
  \node[it={gTr}{3.62cm}, anchor=north, minimum height=2.0cm] (v1) at ([yshift=-0.2cm]sV.south -| 1.925,0) {\textbf{Multilateral}: obliga y beneficia a todos; exige el consenso de todos};
  \node[it={vA}{3.62cm}, anchor=north, minimum height=2.0cm] (v2) at (v1.north -| 5.975,0) {\textbf{Masa crítica}: se obligan quienes suman casi todo el comercio del sector; por la NMF, se benefician todos; va a sus listas};
  \node[it={vB}{3.62cm}, anchor=north, minimum height=2.0cm] (v3) at (v1.north -| 10.025,0) {\textbf{Anexo 4}: obliga y beneficia solo a las partes; incorporarlo exige el consenso de todos (art. X.9)};
  \node[it={vA}{3.62cm}, anchor=north, minimum height=2.0cm, line width=1.1pt] (v4) at (v1.north -| 14.075,0) {\textbf{Iniciativas conjuntas} (desde 2017): abiertas a todos; su resultado va a las listas o al anexo 4};
  \node[anchor=north west, font=\footnotesize\itshape, text=gI, inner sep=1pt, text width=15.9cm, align=left] (reg) at ([yshift=-0.08cm]v1.south west) {La regla: a las listas, sin el consenso de todos; al anexo 4, con él. Fuera de la OMC quedan los acuerdos regionales (Tema 3.B.35)};

  % ===================== 3. Los casos, por vía =====================
  \node[sec] (sC) at ([yshift=-0.45cm]reg.south west) {Los casos: el color dice cómo han acabado};
  \node[cab={vB}{4.99cm}, minimum height=0.95cm] (h1) at ([yshift=-0.2cm]sC.south -| 2.6,0) {Anexo 4: contratación pública};
  \node[cab={vA}{4.99cm}, minimum height=0.95cm] (h2) at (h1.north -| 8.0,0) {Iniciativas conjuntas\\{\footnotesize\mdseries\itshape Buenos Aires, 2017}};
  \node[cab={gI}{4.99cm}, minimum height=0.95cm] (h3) at (h1.north -| 13.4,0) {Iniciativas ambientales};
  % Anexo 4
  \node[res={rV}{4.95cm}, below=0.2cm of h1] (c1) {\textbf{ACP} (1994; revisado en 2012): la contratación pública, excluida del GATT y del GATS, se abre entre las partes (no discriminación y transparencia, más de $1{,}7$ billones de dólares al año).\\Listas de cobertura con reciprocidad estricta: sin polizón, pero un club de países desarrollados};
  % Iniciativas conjuntas
  \node[res={rV}{4.95cm}, below=0.2cm of h2] (c2) {\textbf{Reglamentación nacional}: en vigor desde 2024; entra en las listas del GATS como compromiso adicional, con NMF. Modesta: no abre sectores, mejora la administración};
  \node[res={rR}{4.95cm}, below=0.12cm of c2] (c3) {\textbf{Facilitación de las inversiones} (AFID, 2023): mejores esfuerzos; India veta su entrada al anexo 4. Paradoja: pensado para los PED y bloqueado en su nombre};
  \node[res={rA}{4.95cm}, below=0.12cm of c3] (c4) {\textbf{Comercio electrónico}: texto de 2024 sin flujos de datos; sin consenso, se aplica provisionalmente entre una parte, y la moratoria expiró (2026)};
  % Ambientales
  \node[res={rR}{4.95cm}, below=0.2cm of h3] (c5) {\textbf{Bienes ambientales} (EGA, masa crítica, 2014-2016): parado por la lista de productos y el cambio de Gobierno en EE.UU.};
  \node[res={gI}{4.95cm}, below=0.12cm of c5] (c6) {\textbf{Iniciativas de 2020-2021}: foros de debate, sin obligaciones; útiles ante los conflictos que traen las medidas climáticas unilaterales};
  \node[clave={gI}{4.95cm}, below=0.12cm of c6] (c7) {$\Rightarrow$ La pesca, la única obligación ambiental, salió por la vía multilateral: con consenso, no hace falta la plurilateral};
  % Leyenda
  \path let \p1=(c1.south), \p2=(c4.south), \p3=(c7.south), \n1={min(\y1,\y2,\y3)} in coordinate (ley) at (0,\n1-0.1cm);
  \node[anchor=north west, font=\footnotesize, inner sep=1pt] (lg) at (ley) {\textcolor{rV}{$\blacksquare$} en vigor\quad \textcolor{rA}{$\blacksquare$} aplicación provisional\quad \textcolor{rR}{$\blacksquare$} bloqueado o abandonado\quad \textcolor{gI}{$\blacksquare$} solo diálogo};

  % ===================== 4. Balance =====================
  \node[sec] (sB) at ([yshift=-0.45cm]lg.south west) {Balance: complementa la vía multilateral, pero no puede sustituirla};
  \node[it={gTr}{4.95cm}, anchor=north west, minimum height=2.5cm] (b1) at ([yshift=-0.2cm]sB.south west) {\textbf{Produce normas}, pero modestas (mejores esfuerzos; fuera la protección de las inversiones y los flujos de datos) y, en su mayoría, sin poder entrar en la OMC};
  \node[it={gTr}{4.95cm}, anchor=north, minimum height=2.5cm] (b2) at ([yshift=-0.2cm]sB.south -| 8.0,0) {\textbf{Razones}: jurídica (el anexo 4 exige el consenso) y económica: con NMF, el polizón limita la ambición; sin ella, clubes cerrados (HOEKMAN y MAVROIDIS, 2015)};
  \node[it={gTr}{4.95cm}, anchor=north east, minimum height=2.5cm] (b3) at ([yshift=-0.2cm]sB.south -| 16,0) {\textbf{Asimetrías}: para PD y emergentes abiertos, la única forma de actualizar las normas; para muchos PED, un riesgo: pierden la baza del todo único. \textbf{Críticas}: sin base jurídica (India, Sudáfrica) frente al consenso como veto};
  \node[clave={gTr}{15.75cm}, anchor=north west] (b4) at ([yshift=-0.25cm]b1.south west) {$\Rightarrow$ El futuro de estas materias depende menos de su contenido que de reformar las reglas de decisión: condiciones para entrar en el anexo 4 sin unanimidad};
\end{tikzpicture}%
