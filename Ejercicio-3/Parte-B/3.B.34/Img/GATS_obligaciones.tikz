% Mapa de las obligaciones generales del GATS (Parte II). Elaboración propia a partir del texto del GATS.
\definecolor{oP}{RGB}{40,90,150}
\definecolor{oR}{RGB}{46,125,90}
\definecolor{oV}{RGB}{190,110,30}
\definecolor{oA}{RGB}{110,110,110}
\begin{tikzpicture}[font=\scriptsize,
    every node/.append style={execute at begin node={\hyphenpenalty=10000}},
    cab/.style={fill=#1, text=white, font=\footnotesize\bfseries, align=center, text width=3.75cm, inner sep=2.5pt, rounded corners=2pt, anchor=north west},
    it/.style={draw=#1, fill=#1!8, line width=0.5pt, rounded corners=1.5pt, align=left, text width=3.7cm, inner sep=2.5pt, anchor=north},
    rem/.style={font=\tiny\itshape, text=#1!80!black},
    dia/.style={text=oV!90!black}]
  % Banda superior
  \node[draw=oA, fill=oA!8, line width=0.5pt, rounded corners=1.5pt, align=center, text width=16.0cm, inner sep=3pt, anchor=south west] at (0,0.1)
    {\textbf{Obligaciones generales (Parte II, arts. II-XV)}: obligan a todos los miembros en todos los servicios cubiertos, hayan asumido o no compromisos;\\ salvo las marcadas con {\color{oV!90!black}$\blacklozenge$}, que solo operan en los sectores inscritos en la lista de compromisos};
  % Columna 1: pilares
  \node[cab=oP] (h1) at (0,0) {Pilares\\(no discriminar, informar)};
  \node[it=oP] (a1) at ([yshift=-0.1cm]h1.south) {\textbf{Nación más favorecida} (II), con tres excepciones: exenciones (anexo), integración económica (V) y reconocimiento (VII)\\ \hfill{\tiny\itshape $\to$ se desarrolla a continuación}};
  \node[it=oP] (a2) at ([yshift=-0.1cm]a1.south) {\textbf{Transparencia} (III y III bis): publicar, notificar, informar\\ \hfill{\tiny\itshape $\to$ se desarrolla a continuación}};
  \node[it=oP] (a3) at ([yshift=-0.1cm]a2.south) {\textbf{Participación creciente de los países en desarrollo} (IV)};
  % Columna 2: disciplinas sobre la regulación
  \node[cab=oR] (h2) at (4.1,0) {Disciplinas sobre\\la regulación};
  \node[it=oR] (b1) at ([yshift=-0.1cm]h2.south) {\textbf{Reglamentación nacional} (VI): administración razonable, objetiva e imparcial{\color{oV!90!black}$\,\blacklozenge$}; recursos frente a las decisiones administrativas};
  \node[it=oR] (b2) at ([yshift=-0.1cm]b1.south) {\textbf{Reconocimiento} de títulos, licencias y certificados (VII)};
  \node[it=oR] (b3) at ([yshift=-0.1cm]b2.south) {\textbf{Monopolios y proveedores exclusivos} (VIII) y \textbf{prácticas comerciales} restrictivas (IX)};
  \node[it=oR] (b4) at ([yshift=-0.1cm]b3.south) {\textbf{Pagos y transferencias} corrientes (XI){\color{oV!90!black}$\,\blacklozenge$}};
  % Columna 3: válvulas de escape
  \node[cab=oV] (h3) at (8.2,0) {Válvulas de escape\\(cuándo se puede incumplir)};
  \node[it=oV] (c1) at ([yshift=-0.1cm]h3.south) {\textbf{Excepciones generales} (XIV): moral y orden público, salud, cumplimiento de leyes (fraude, privacidad, seguridad), impuestos directos; siempre que no se apliquen como discriminación arbitraria ni restricción encubierta};
  \node[it=oV] (c2) at ([yshift=-0.1cm]c1.south) {\textbf{Seguridad nacional} (XIV bis)};
  \node[it=oV] (c3) at ([yshift=-0.1cm]c2.south) {\textbf{Balanza de pagos} (XII): restricciones temporales y no discriminatorias{\color{oV!90!black}$\,\blacklozenge$}};
  \node[it=oV] (c4) at ([yshift=-0.1cm]c3.south) {\textbf{Medidas cautelares} en servicios financieros (anexo)};
  % Columna 4: agenda pendiente
  \node[cab=oA] (h4) at (12.3,0) {Agenda pendiente\\(mandatos de negociación)};
  \node[it=oA] (d1) at ([yshift=-0.1cm]h4.south) {\textbf{Salvaguardias urgentes} (X)};
  \node[it=oA] (d2) at ([yshift=-0.1cm]d1.south) {\textbf{Contratación pública} (XIII): excluida de la NMF, del acceso a los mercados y del trato nacional};
  \node[it=oA] (d3) at ([yshift=-0.1cm]d2.south) {\textbf{Subvenciones} (XV)};
  \node[it=oA] (d4) at ([yshift=-0.1cm]d3.south) {\textbf{Disciplinas sobre la reglamentación nacional} (VI.4)\\ \hfill{\tiny\itshape $\to$ iniciativa conjunta de 2021}};
  \node[font=\tiny\itshape, text=oA, align=left, text width=3.7cm, anchor=north] at ([yshift=-0.08cm]d4.south) {sin acuerdo multilateral desde 1995};
\end{tikzpicture}
