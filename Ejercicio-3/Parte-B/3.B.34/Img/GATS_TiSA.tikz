% El TiSA: diseño y trayectoria de la negociación. Elaboración propia.
\definecolor{tA}{RGB}{40,90,150}
\definecolor{tV}{RGB}{46,125,90}
\definecolor{tR}{RGB}{190,70,60}
\definecolor{gI}{RGB}{110,110,110}
\begin{tikzpicture}[font=\footnotesize,
    every node/.append style={execute at begin node={\hyphenpenalty=10000}},
    tit/.style={anchor=south west, font=\footnotesize\bfseries, inner sep=0pt},
    ras/.style={draw=#1, fill=#1!8, line width=0.5pt, rounded corners=2pt, align=left, inner sep=3pt, text width=6.45cm, anchor=north west},
    ev/.style={draw=#1, fill=#1!8, line width=0.5pt, rounded corners=2pt, inner sep=3pt, anchor=north west},
    an/.style={fill=#1, text=white, font=\footnotesize\bfseries, rounded corners=2pt, inner sep=2pt, anchor=center},
    sig/.style={-{Latex[length=1.8mm]}, line width=0.9pt, gI, bend left=55}]
  % ---------- Panel (a): cerrar la brecha ----------
  \node[tit] at (0,0.2) {(a) Cerrar la brecha entre consolidado y aplicado};
  \draw[gI, -{Latex[length=1.6mm]}] (0.3,-4.0) -- (0.3,-0.35) node[pos=0.5, rotate=90, above, text=gI] {grado de apertura};
  \draw[gI] (0.3,-4.0) -- (8.0,-4.0);
  % Barras
  \fill[gI!45] (0.9,-4.0) rectangle (2.6,-3.0);
  \node[align=center, anchor=north, text width=2.0cm] at (1.75,-4.05) {Consolidado en el GATS};
  \fill[tA!70] (3.4,-4.0) rectangle (5.1,-2.0);
  \node[align=center, anchor=north, text width=2.0cm] at (4.25,-4.05) {Régimen aplicado hoy};
  \fill[tA!30] (5.9,-4.0) rectangle (7.6,-1.1);
  \node[align=center, anchor=north, text width=2.0cm] at (6.75,-4.05) {Apertura futura};
  % Brecha
  \draw[dashed, gI] (0.9,-2.0) -- (3.4,-2.0);
  \draw[decorate, decoration={brace, amplitude=4pt}, tR, line width=0.7pt] (0.75,-3.0) -- (0.75,-2.0);
  \node[text=tR, anchor=south west, align=left, text width=2.2cm, inner sep=1pt] at (0.9,-2.95) {brecha: el GATS no la protege};
  % Cláusulas
  \draw[-{Latex[length=1.8mm]}, tV, line width=1pt] (1.75,-1.75) to[bend left=25] node[above, text=tV, font=\footnotesize\bfseries, align=center] {\textit{standstill}} (4.25,-1.75);
  \draw[dashed, gI] (5.1,-1.1) -- (5.9,-1.1);
  \draw[-{Latex[length=1.8mm]}, tV, line width=1pt] (4.25,-1.0) to[bend left=25] node[above, text=tV, font=\footnotesize\bfseries] {\textit{ratchet}} (6.75,-0.85);
  % Separador
  \draw[gI!50, line width=0.4pt] (8.45,0.4) -- (8.45,-4.6);
  % ---------- Panel (b): rasgos ----------
  \node[tit] at (8.8,0.2) {(b) Tres rasgos de diseño};
  \node[ras=tA] (r1) at (8.8,-0.15) {\textbf{Base GATS}: los mismos servicios, exclusiones y definiciones; compatible con la OMC};
  \node[ras=tR, anchor=north] (r2) at ([yshift=-0.2cm]r1.south) {\textbf{Sin NMF para terceros}: se concibe como acuerdo de integración (art. V); abierto a nuevos participantes y multilateralizable};
  \node[ras=tV, anchor=north] (r3) at ([yshift=-0.2cm]r2.south) {\textbf{Lista mixta}: positiva para el acceso a los mercados y negativa para el trato nacional, con \textit{standstill} y \textit{ratchet}};
  % ---------- Panel (c): trayectoria ----------
  \node[tit] at (0,-5.3) {(c) La trayectoria};
  \def\paso{3.93}
  \foreach \i/\c/\anio/\t in {
    0/tA/{2013}/{empiezan las negociaciones; $23$ miembros, en torno al $70\%$ del comercio de servicios},
    1/tA/{2013-2016}/{$21$ rondas de negociación},
    2/tR/{nov. 2016}/{se paralizan: giro de EE.UU., flujos de datos, servicios públicos},
    3/tV/{después}/{sus disciplinas reaparecen en acuerdos regionales e iniciativas conjuntas}} {
    \node[ev=\c] (e\i) at (\i*\paso,-5.75) {\parbox[t][1.45cm][t]{3.35cm}{\raggedright\vspace*{6pt}\t}};
    \node[an=\c] at (e\i.north) {\anio};
  }
  \foreach \i [evaluate=\i as \j using int(\i+1)] in {0,1,2} {
    \draw[sig] ([xshift=-0.3cm]e\i.north east) to ([xshift=0.3cm]e\j.north west);
  }
\end{tikzpicture}
