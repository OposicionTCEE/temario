% Cómo se construye una lista de compromisos específicos del GATS. Elaboración propia a partir de los arts. XVI, XVII, XVIII y XX del GATS.
\definecolor{cN}{RGB}{46,125,90}
\definecolor{cL}{RGB}{225,170,60}
\definecolor{cS}{RGB}{190,70,60}
\definecolor{cH}{RGB}{40,90,150}
\definecolor{gI}{RGB}{110,110,110}
\begin{tikzpicture}[font=\scriptsize,
    every node/.append style={execute at begin node={\hyphenpenalty=10000}},
    col/.style={fill=cH, text=white, font=\scriptsize\bfseries, align=center, minimum height=0.95cm, inner sep=1.5pt, anchor=north west},
    fila/.style={draw=gI, fill=gI!6, align=left, inner sep=2pt, anchor=north west, minimum height=#1},
    md/.style={draw=white, fill=#1, text=white, font=\tiny\bfseries, minimum width=0.62cm, minimum height=0.5cm, inner sep=0pt, anchor=north west},
    it/.style={draw=#1, fill=#1!8, line width=0.5pt, rounded corners=1.5pt, align=left, inner sep=2.5pt, text width=4.6cm, anchor=north west}]
  % Cabecera de la lista
  \node[col, text width=2.55cm] at (0,0) {Sector o subsector};
  \node[col, text width=2.6cm] at (2.7,0) {Acceso a los mercados\\(art. XVI)};
  \node[col, text width=2.6cm] at (5.45,0) {Trato nacional\\(art. XVII)};
  \node[col, text width=1.65cm, font=\tiny\bfseries] at (8.2,0) {Compromisos adicionales\\(art. XVIII)};
  % Fila horizontal
  \node[fila=1.05cm, text width=2.5cm] at (0,-1.05) {\textbf{I. Horizontales}: rigen para todos los sectores inscritos};
  \node[fila=1.05cm, text width=2.55cm, font=\tiny] at (2.7,-1.05) {p. ej., modo 4 sin consolidar salvo personal directivo trasladado; autorización para adquirir inmuebles (modo 3)};
  \node[fila=1.05cm, text width=2.55cm, font=\tiny] at (5.45,-1.05) {p. ej., subvenciones: sin consolidar};
  \node[fila=1.05cm, text width=1.6cm] at (8.2,-1.05) {};
  % Filas sectoriales: celdas por modo
  \foreach \r/\y/\nom/\am/\tn in {
    1/-2.2/{\textbf{II. Sector A} (inscrito)}/{cN,cN,cL,cS}/{cN,cN,cL,cS},
    2/-2.95/{\textbf{II. Sector B} (inscrito)}/{cS,cN,cL,cL}/{cS,cN,cN,cS}} {
    \node[fila=0.6cm, text width=2.5cm] at (0,\y) {\nom};
    \foreach \c [count=\m] in \am { \node[md=\c] at (2.7+0.66*\m-0.66,\y-0.05) {\m}; }
    \foreach \c [count=\m] in \tn { \node[md=\c] at (5.45+0.66*\m-0.66,\y-0.05) {\m}; }
  }
  \node[fila=0.6cm, text width=1.6cm, font=\tiny] at (8.2,-2.2) {p. ej., documento de referencia};
  % Sectores no inscritos
  \node[draw=gI, dashed, fill=white, align=left, inner sep=2pt, anchor=north west, text width=9.75cm, text=gI] at (0,-3.7) {\textbf{Sectores no inscritos}: sin compromiso alguno de acceso ni de trato nacional (\textbf{lista positiva}); solo rigen las obligaciones generales};
  % Leyenda de grados
  \node[anchor=north west, font=\scriptsize\bfseries] at (0,-4.45) {Por modo:};
  \foreach \c/\t/\x in {cN/{\textbf{Ninguna} = pleno}/1.45, cL/{\textbf{limitaciones} = parcial}/3.75, cS/{\textbf{Sin consolidar} = ninguno}/6.6} {
    \fill[\c] (\x,-4.78) rectangle ++(0.3,0.22);
    \node[anchor=west, font=\scriptsize] at (\x+0.35,-4.67) {\t};
  }
  % Columna derecha: reglas
  \node[it=cH] (r1) at (10.35,0) {\textbf{Acceso a los mercados}: seis tipos de limitaciones cuantitativas o de forma (art. XVI.2), discriminatorias o no.\\ \hfill{\tiny\itshape $\to$ se desarrolla a continuación}};
  \node[it=cH, anchor=north] (r2) at ([yshift=-0.1cm]r1.south) {\textbf{Trato nacional}: no alterar las condiciones de competencia en favor de los nacionales, de derecho o de hecho (art. XVII).\\ \hfill{\tiny\itshape $\to$ se desarrolla a continuación}};
  \node[it=gI, anchor=north] (r3) at ([yshift=-0.1cm]r2.south) {\textbf{Regla de consignación}: una medida contraria a la vez al acceso y al trato nacional se inscribe en la columna del acceso y vale para ambos (art. XX.2).};
  \node[it=gI, anchor=north] (r4) at ([yshift=-0.1cm]r3.south) {\textbf{Consolidación}: lo inscrito es un techo de restricción; retirarlo exige compensación (art. XXI).};
\end{tikzpicture}
