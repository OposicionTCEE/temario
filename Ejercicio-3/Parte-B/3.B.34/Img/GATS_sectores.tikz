% Clasificación sectorial de los servicios (MTN.GNS/W/120) y compromisos efectivos. Elaboración propia a partir de la lista W/120 y de OMC (2015).
\definecolor{sAl}{RGB}{25,95,110}
\definecolor{sMe}{RGB}{90,150,160}
\definecolor{sBa}{RGB}{200,215,218}
\definecolor{gI}{RGB}{110,110,110}
\begin{tikzpicture}[font=\scriptsize,
    every node/.append style={execute at begin node={\hyphenpenalty=10000}},
    sec/.style={draw=#1!80!black, fill=#1, line width=0.5pt, rounded corners=1.5pt, align=left, text width=2.45cm, minimum height=1.12cm, inner sep=2.5pt, anchor=north west}]
  % Cuadrícula de los 12 sectores (orden de la lista W/120)
  \node[anchor=south west, font=\footnotesize\bfseries] at (0,0.05) {Los $12$ sectores de la lista W/120 (unos $160$ subsectores)};
  \foreach \n/\col/\fila/\c/\tc/\tit/\ej in {
    1/0/0/sAl/white/{1. A empresas}/{profesionales, informática, I+D, inmobiliarios, publicidad},
    2/1/0/sAl/white/{2. Comunicaciones}/{postales, mensajería, telecomunicaciones, audiovisuales},
    3/2/0/sMe/white/{3. Construcción e ingeniería}/{edificación, obra civil, instalación},
    4/3/0/sMe/white/{4. Distribución}/{comisionistas, mayoristas, minoristas, franquicias},
    5/0/1/sBa/black/{5. Enseñanza}/{primaria, secundaria, superior, de adultos},
    6/1/1/sMe/white/{6. Medio ambiente}/{aguas residuales, residuos, saneamiento},
    7/2/1/sAl/white/{7. Financieros}/{seguros, banca y otros servicios financieros},
    8/3/1/sBa/black/{8. Sociales y de salud}/{hospitales, otros servicios de salud, sociales},
    9/0/2/sAl/white/{9. Turismo y viajes}/{hoteles y restaurantes, agencias de viajes, guías},
    10/1/2/sMe/white/{10. Esparcimiento y cultura}/{espectáculos, agencias de noticias, museos, deportes},
    11/2/2/sMe/white/{11. Transporte}/{marítimo, aéreo, ferroviario, por carretera, auxiliares},
    12/3/2/sMe/white/{12. Otros}/{servicios no incluidos en otra parte}} {
    \node[sec=\c, text=\tc] at (\col*2.68,-\fila*1.36) {\textbf{\tit}\\[1pt]{\tiny \ej}};
  }
  % Leyenda
  \foreach \c/\t/\x in {sAl/{los más comprometidos}/0, sMe/{intermedios}/3.35, sBa/{los menos comprometidos}/5.8} {
    \fill[\c, draw=\c!80!black] (\x,-4.5) rectangle ++(0.32,0.22);
    \node[anchor=west, font=\scriptsize] at (\x+0.38,-4.39) {\t};
  }
  % Panel derecho: sectores comprometidos de media, por grupo de miembros
  \begin{scope}[shift={(13.3,-4.05)}]
    \begin{axis}[xbar, width=5.4cm, height=4.6cm, bar width=0.32cm,
        xmin=0, xmax=175, xtick={0,40,80,120,160}, xticklabel style={font=\tiny},
        ytick=data, symbolic y coords={PMA, {En desarrollo (sin PMA)}, Todos, {Adheridos desde 1995}, Desarrollados},
        yticklabel style={font=\scriptsize, align=right},
        axis x line*=bottom, axis y line*=left, enlarge y limits=0.17,
        nodes near coords, nodes near coords style={font=\scriptsize\bfseries},
        title={\footnotesize\bfseries Sectores comprometidos de media}, title style={yshift=-1pt},
        xlabel={\tiny número de sectores (de unos $160$)}, xlabel style={yshift=3pt}]
      \addplot[fill=sAl, draw=sAl!80!black] coordinates {(29,PMA) (48,{En desarrollo (sin PMA)}) (52,Todos) (104,{Adheridos desde 1995}) (110,Desarrollados)};
      \draw[dashed, gI] (axis cs:160,PMA) ++(0,-0.4cm) -- ([yshift=0.4cm]axis cs:160,Desarrollados) node[above, font=\tiny, text=gI] {total};
    \end{axis}
  \end{scope}
\end{tikzpicture}
