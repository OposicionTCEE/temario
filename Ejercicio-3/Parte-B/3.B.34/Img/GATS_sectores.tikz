% Clasificación sectorial de los servicios (MTN.GNS/W/120) y compromisos efectivos. Elaboración propia a partir de la lista W/120 y de OMC (2015).
\definecolor{sAl}{RGB}{25,95,110}
\definecolor{sMe}{RGB}{90,150,160}
\definecolor{sBa}{RGB}{200,215,218}
\definecolor{gI}{RGB}{110,110,110}
\begin{tikzpicture}[font=\footnotesize,
    every node/.append style={execute at begin node={\hyphenpenalty=10000}},
    sec/.style={draw=#1!80!black, fill=#1, line width=0.5pt, rounded corners=1.5pt, align=left, text width=2.05cm, minimum height=1.0cm, inner sep=2.5pt, anchor=north west},
    tit/.style={anchor=south west, font=\footnotesize\bfseries, inner sep=0pt}]
  % ---------- Panel (a): los 12 sectores de la lista W/120 ----------
  \node[tit] at (0,0.15) {(a) Los $12$ sectores de la lista W/120 (unos $160$ subsectores)};
  \foreach \col/\fila/\c/\tc/\tit/\ej in {
    0/0/sAl/white/{1. A empresas}/{profesionales, informática},
    1/0/sAl/white/{2. Comunicaciones}/{telecomunicaciones},
    2/0/sMe/white/{3. Construcción}/{edificación, obra civil},
    3/0/sMe/white/{4. Distribución}/{mayoristas, minoristas},
    0/1/sBa/black/{5. Enseñanza}/{de primaria a superior},
    1/1/sMe/white/{6. Medio ambiente}/{residuos, saneamiento},
    2/1/sAl/white/{7. Financieros}/{seguros, banca},
    3/1/sBa/black/{8. Salud y sociales}/{hospitales},
    0/2/sAl/white/{9. Turismo}/{hoteles, agencias},
    1/2/sMe/white/{10. Esparcimiento}/{espectáculos, deportes},
    2/2/sMe/white/{11. Transporte}/{marítimo, aéreo},
    3/2/sMe/white/{12. Otros}/{no incluidos en otra parte}} {
    \node[sec=\c, text=\tc] at (\col*2.42,-0.1-\fila*1.12) {\textbf{\tit}\\[1pt]\ej};
  }
  % Leyenda
  \foreach \c/\t/\x in {sAl/{los más comprometidos}/0, sMe/{intermedios}/3.3, sBa/{los menos comprometidos}/5.4} {
    \fill[\c, draw=\c!80!black] (\x,-3.72) rectangle ++(0.3,0.22);
    \node[anchor=west] at (\x+0.36,-3.61) {\t};
  }
  % Separador
  \draw[gI!50, line width=0.4pt] (9.85,0.45) -- (9.85,-3.85);
  % ---------- Panel (b): sectores comprometidos de media ----------
  \node[tit] at (10.15,0.15) {(b) Subsectores comprometidos de media};
  \def\esc{0.019}% cm por subsector
  \def\xo{12.55}
  \foreach \y/\g/\v in {0/{Desarrollados}/110, 1/{Adheridos desde 1995}/104, 2/{Todos}/52, 3/{En desarrollo (sin PMA)}/48, 4/{PMA}/29} {
    \pgfmathsetmacro{\yy}{-0.45-\y*0.6}
    \node[anchor=east, align=right, text width=2.35cm] at (\xo-0.08,\yy) {\g};
    \fill[sAl, draw=sAl!80!black] (\xo,\yy-0.17) rectangle ++(\v*\esc,0.34);
    \node[anchor=west, font=\footnotesize\bfseries] at (\xo+\v*\esc,\yy) {$\v$};
  }
  % Eje
  \draw[gI, line width=0.5pt] (\xo,-3.15) -- (\xo+160*\esc,-3.15);
  \foreach \t in {0,40,80,120,160} {
    \draw[gI] (\xo+\t*\esc,-3.15) -- ++(0,-0.07);
    \node[anchor=north, text=gI, inner sep=1pt] at (\xo+\t*\esc,-3.22) {$\t$};
  }
  \draw[dashed, gI] (\xo+160*\esc,-3.15) -- (\xo+160*\esc,0.0) node[below left, text=gI, inner sep=1pt] {total};
  \node[anchor=north, text=gI] at (\xo+80*\esc,-3.5) {número de subsectores (de unos $160$)};
\end{tikzpicture}
