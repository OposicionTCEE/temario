% Ámbito de aplicación del GATS y modos de suministro. Elaboración propia a partir del art. I del GATS, de la Secretaría de Estado de Comercio (2025) y de OMC (2019).
\definecolor{m1}{RGB}{40,90,150}
\definecolor{m2}{RGB}{90,140,190}
\definecolor{m3}{RGB}{46,125,90}
\definecolor{m4}{RGB}{120,80,150}
\definecolor{gI}{RGB}{110,110,110}
\begin{tikzpicture}[font=\scriptsize,
    every node/.append style={execute at begin node={\hyphenpenalty=10000}},
    cab/.style={fill=#1, text=white, font=\footnotesize\bfseries, align=center, text width=3.8cm, inner sep=2.5pt, rounded corners=2pt},
    it/.style={draw=#1, fill=#1!8, line width=0.5pt, rounded corners=1.5pt, align=left, text width=3.7cm, inner sep=2.5pt},
    pr/.style={circle, fill=#1, text=white, font=\tiny\bfseries, inner sep=0pt, minimum size=0.36cm},
    co/.style={circle, draw=black!70, fill=white, font=\tiny\bfseries, inner sep=0pt, minimum size=0.36cm},
    fl/.style={-{Latex[length=1.6mm]}, line width=0.8pt, #1},
    pais/.style={font=\tiny, text=black!60}]
  % Banda superior: ámbito de aplicación
  \node[draw=gI, fill=gI!8, line width=0.5pt, rounded corners=1.5pt, align=left, text width=16.0cm, inner sep=3pt, anchor=south west] (amb) at (0,2.05)
    {\textbf{Ámbito (art. I)}: \textbf{todos los servicios} de cualquier sector y \textbf{todas las medidas} de los miembros que los afecten (gobiernos centrales, regionales y locales, e instituciones con facultades delegadas).\\[1pt]
     \textbf{Excluidos}: los servicios suministrados en ejercicio de facultades gubernamentales (ni en condiciones comerciales ni en competencia) y los derechos de tráfico aéreo y los servicios directamente relacionados con ellos.};
  % Columnas: un modo cada una
  \foreach \i/\x/\c/\tit/\sub/\ej/\bar in {
    1/0.0/m1/{Modo 1\\comercio transfronterizo}/{cruza la frontera el servicio}/{consultoría o estudios de mercado por internet, telemedicina, servicios postales}/{exigencia de establecerse en el país o de usar proveedores locales; restricciones a los pagos; localización de datos},
    2/4.1/m2/{Modo 2\\consumo en el extranjero}/{se desplaza el consumidor}/{turismo, estudiantes y pacientes en el extranjero, reparación de buques y aeronaves}/{límites a la prestación a no residentes; restricciones a los pagos y a la deducibilidad fiscal},
    3/8.2/m3/{Modo 3\\presencia comercial}/{se establece el proveedor (empresa)}/{filial o sucursal bancaria, cadena hotelera, oficina de representación}/{límites al capital extranjero y a la forma jurídica; trabas a la repatriación de beneficios; transferencia obligada de tecnología},
    4/12.3/m4/{Modo 4\\presencia de personas físicas}/{se desplaza temporalmente la persona}/{directivo trasladado a una filial, técnico que instala maquinaria, profesor visitante}/{nacionalidad y residencia; reconocimiento de cualificaciones; licencias; visados y permisos de trabajo}} {
    \node[cab=\c, anchor=north west] (h\i) at (\x,1.95) {\tit};
    \node[font=\scriptsize\itshape, text=\c!80!black, anchor=north] (s\i) at ([yshift=-1.28cm]h\i.south) {\sub};
    \node[it=\c, anchor=north] (e\i) at ([yshift=-0.05cm]s\i.south) {\textbf{Ejemplos}: \ej};
    \node[it=\c, anchor=north, minimum height=1.25cm] (b\i) at ([yshift=-0.08cm]e\i.south) {\textbf{Barreras típicas}: \bar};
    % Marco del diagrama: país A | frontera | país B
    \draw[dashed, black!45] ([xshift=1.95cm,yshift=-0.08cm]h\i.south west) -- ++(0,-1.15);
    \node[pais, anchor=north west] at ([yshift=-0.05cm]h\i.south west) {País A (proveedor)};
    \node[pais, anchor=north east] at ([yshift=-0.05cm]h\i.south east) {País B (consumidor)};
  }
  % Diagramas (coordenadas relativas a cada cabecera)
  % Modo 1: el servicio cruza
  \node[pr=m1] (p1) at ([xshift=0.55cm,yshift=-0.8cm]h1.south west) {P};
  \node[co] (c1) at ([xshift=3.35cm,yshift=-0.8cm]h1.south west) {C};
  \draw[fl=m1] (p1) -- node[above, font=\tiny, text=m1, pos=0.5, fill=white, inner sep=1pt] {servicio} (c1);
  % Modo 2: el consumidor se desplaza
  \node[pr=m2] (p2) at ([xshift=0.55cm,yshift=-0.8cm]h2.south west) {P};
  \node[co] (c2) at ([xshift=1.35cm,yshift=-0.8cm]h2.south west) {C};
  \node[co, draw=black!30, text=black!30] (c2o) at ([xshift=3.35cm,yshift=-0.8cm]h2.south west) {C};
  \draw[fl=m2] (c2o) -- node[above, font=\tiny, text=m2!80!black, fill=white, inner sep=1pt] {viaja} (c2);
  % Modo 3: la empresa se establece
  \node[pr=m3] (p3) at ([xshift=0.55cm,yshift=-0.8cm]h3.south west) {P};
  \node[draw=m3, fill=m3!20, font=\tiny, inner sep=1.5pt, minimum width=0.6cm, minimum height=0.36cm] (f3) at ([xshift=2.6cm,yshift=-0.8cm]h3.south west) {filial};
  \node[co] (c3) at ([xshift=3.45cm,yshift=-0.8cm]h3.south west) {C};
  \draw[fl=m3] (p3) -- node[above, font=\tiny, text=m3] {invierte} (f3);
  \draw[line width=0.6pt, m3] (f3) -- (c3);
  % Modo 4: la persona se desplaza
  \node[pr=m4, fill=m4!30, text=m4!60] (p4o) at ([xshift=0.55cm,yshift=-0.8cm]h4.south west) {P};
  \node[pr=m4] (p4) at ([xshift=2.6cm,yshift=-0.8cm]h4.south west) {P};
  \node[co] (c4) at ([xshift=3.45cm,yshift=-0.8cm]h4.south west) {C};
  \draw[fl=m4] (p4o) -- node[above, font=\tiny, text=m4] {temporal} (p4);
  \draw[line width=0.6pt, m4] (p4) -- (c4);
  % Barra inferior: peso de cada modo en el comercio mundial de servicios (2017)
  \def\yb{-4.0}
  \node[anchor=east, font=\scriptsize\bfseries, align=right] at (-0.05,\yb+0.14) {};
  \fill[m1] (0,\yb) rectangle ++(4.432,0.32);
  \fill[m2] (4.432,\yb) rectangle ++(1.664,0.32);
  \fill[m3] (6.096,\yb) rectangle ++(9.424,0.32);
  \fill[m4] (15.52,\yb) rectangle ++(0.464,0.32);
  \node[font=\scriptsize\bfseries, text=white] at (2.216,\yb+0.16) {$27{,}7\%$};
  \node[font=\scriptsize\bfseries, text=white] at (5.264,\yb+0.16) {$10{,}4\%$};
  \node[font=\scriptsize\bfseries, text=white] at (10.81,\yb+0.16) {$58{,}9\%$};
  \node[font=\scriptsize\bfseries, text=m4, anchor=south] at (15.752,\yb+0.32) {$2{,}9\%$};
  \node[anchor=north west, font=\scriptsize\itshape, text=black!70] at (0,\yb-0.03) {Peso de cada modo en el comercio mundial de servicios, 2017 (total: $13{,}3$ billones de dólares)};
\end{tikzpicture}
