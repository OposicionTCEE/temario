% Esquema de una página del bloque 1 (Servicios: el GATS), para el anexo «Material de estudio: Esquemas».
% Se lee de arriba abajo, en el orden del bloque: objetivos y diferencias con el GATT -> estructura en cuatro peldaños
% (Partes I a IV) -> viñeta de cómo se inscribe un compromiso específico -> desarrollo desde 1995 -> balance. Colores: los de GATS_estructura (Partes) y GATS_negociaciones.
% Tamaño: 16 cm de ancho y menos de 22 cm de alto (cabe bajo el rótulo del anexo); letra de 8 pt como mínimo.
% Generar con: bash Code/generar_figura.sh OMC_esquema_1
\definecolor{gA}{RGB}{120,160,200}%
\definecolor{gB}{RGB}{80,130,185}%
\definecolor{gC}{RGB}{40,90,150}%
\definecolor{gD}{RGB}{25,60,110}%
\definecolor{gI}{RGB}{110,110,110}%
\definecolor{nM}{RGB}{40,90,150}%
\definecolor{nF}{RGB}{190,70,60}%
\definecolor{gTr}{RGB}{60,60,60}%
\definecolor{cN}{RGB}{46,125,90}%
\definecolor{cL}{RGB}{225,170,60}%
\definecolor{cS}{RGB}{190,70,60}%
\begin{tikzpicture}[font=\footnotesize,
    every node/.append style={execute at begin node={\hyphenpenalty=10000}},
    sec/.style={font=\small\bfseries, text=gI, anchor=south west, inner sep=0pt},
    cab/.style 2 args={fill=#1, text=white, font=\small\bfseries, align=center, text width=#2, inner sep=3pt, rounded corners=2pt, anchor=north, minimum height=1.2cm},
    it/.style 2 args={draw=#1, fill=#1!8, line width=0.5pt, rounded corners=2pt, align=left, text width=#2, inner sep=3pt},
    clave/.style 2 args={draw=#1, fill=white, line width=1.1pt, rounded corners=2pt, align=left, text width=#2, inner sep=3pt},
    flecha/.style={-{Latex[length=1.6mm]}, line width=0.6pt, black!60}]

  % ===================== 1. Objetivos: ¿por qué un acuerdo flexible? =====================
  \node[sec] at (0,0) {¿Por qué un acuerdo que abarca casi todos los servicios ha liberalizado tan poco? Por su diseño};
  \node[it={gI}{4.95cm}, anchor=north, minimum height=2.2cm] (o1) at (2.6,-0.2) {\textbf{Por qué importa}: los servicios son casi dos tercios del valor añadido mundial, y el GATS es su primer y único marco multilateral};
  \node[it={gC}{4.95cm}, anchor=north, minimum height=2.2cm] (o2) at (8.0,-0.2) {\textbf{Objetivo}, como el del GATT: expandir el comercio para crecer.\\\textbf{Funciones}: foro de negociación y normas comunes, que dan transparencia y certidumbre};
  \node[it={gD}{4.95cm}, anchor=north, minimum height=2.2cm, line width=1.1pt] (o3) at (13.4,-0.2) {\textbf{Dos diferencias con el GATT}: las barreras son regulación interna (acceso al mercado, trato diferenciado), no aranceles; y es flexible: el trato nacional se negocia y lo comprometido puede retirarse (art. XXI)};
  \draw[flecha] (o1) -- (o2); \draw[flecha] (o2) -- (o3);

  % ===================== 2. Estructura: cuatro peldaños =====================
  \node[sec] (sE) at ([yshift=-0.5cm]o1.south west) {Cuatro peldaños: cada Parte obliga más, pero a menos servicios};
  \node[cab={gA}{3.64cm}] (h1) at ([yshift=-0.2cm]sE.south -| 1.925,0) {Parte I: ámbito\\{\footnotesize\mdseries\itshape ¿qué cubre? (art. I)}};
  \node[cab={gB}{3.64cm}] (h2) at (h1.north -| 5.975,0) {Parte II: obligaciones generales\\{\footnotesize\mdseries\itshape ¿qué obliga siempre?}};
  \node[cab={gC}{3.64cm}] (h3) at (h1.north -| 10.025,0) {Parte III: compromisos específicos\\{\footnotesize\mdseries\itshape ¿qué se liberaliza?}};
  \node[cab={gD}{3.64cm}] (h4) at (h1.north -| 14.075,0) {Parte IV: liberalización progresiva\\{\footnotesize\mdseries\itshape ¿cómo se amplía?}};
  \foreach \a/\b in {h1/h2, h2/h3, h3/h4} \draw[flecha] (\a) -- (\b);

  % --- Parte I ---
  \node[it={gA}{3.62cm}, below=0.2cm of h1] (a1) {\textbf{Todo}: cualquier medida que afecte a los servicios, de cualquier nivel de gobierno};
  \node[it={gA}{3.62cm}, below=0.12cm of a1] (a2) {\textbf{Salvo}: servicios en ejercicio de facultades gubernamentales y derechos de tráfico aéreo};
  \node[it={gA}{3.62cm}, below=0.12cm of a2] (a3) {\textbf{Cuatro modos}, según dónde estén proveedor y consumidor: (1) transfronterizo $\cdot$ (2) consumo en el extranjero $\cdot$ (3) presencia comercial $\cdot$ (4) personas físicas, temporal};
  \node[it={gA}{3.62cm}, below=0.12cm of a3] (a4) {\textbf{Clasificación}: doce sectores, la de 1991, ya obsoleta};

  % --- Parte II ---
  \node[it={gB}{3.62cm}, below=0.2cm of h2] (b1) {\textbf{NMF} (art. II): lo que se da a uno, se da a todos $\to$ polizón. Excepciones: exenciones, integración económica (art. V) y reconocimiento};
  \node[it={gB}{3.62cm}, below=0.12cm of b1] (b2) {\textbf{Transparencia} (art. III): publicar, notificar, responder y contranotificar};
  \node[it={gB}{3.62cm}, below=0.12cm of b2] (b3) {Además: \textbf{disciplinas sobre la regulación}, \textbf{válvulas de escape} y una \textbf{agenda pendiente}};

  % --- Parte III ---
  \node[it={gC}{3.62cm}, below=0.2cm of h3] (c1) {\textbf{Lista positiva}: solo obliga lo inscrito, sector a sector y modo a modo (abajo, cómo se hace)};
  \node[it={gC}{3.62cm}, below=0.12cm of c1] (c2) {\textbf{Acceso a los mercados} (art. XVI): seis limitaciones tasadas (cuantitativas, forma jurídica, capital); prohibir equivale a un contingente cero};
  \node[it={gC}{3.62cm}, below=0.12cm of c2] (c3) {\textbf{Trato nacional} (art. XVII): mismas condiciones de competencia; sin discriminación de derecho ni de hecho};

  % --- Parte IV ---
  \node[it={gD}{3.62cm}, below=0.2cm of h4] (d1) {\textbf{Rondas sucesivas} (art. XIX), la primera desde 2000};
  \node[it={gD}{3.62cm}, below=0.12cm of d1] (d2) {\textbf{Retirar un compromiso} exige compensar (art. XXI)};
  \node[clave={gD}{3.62cm}, below=0.3cm of d2] (d3) {$\Rightarrow$ La liberalización efectiva depende más de las listas que de las reglas};

  % ===================== 2 bis. Viñeta: cómo se hace un compromiso específico =====================
  % Mini-lista con el ejemplo de banca (7.B) del recuadro del cuerpo; colores de grado como en GATS_compromisos.
  \path let \p1=(a4.south), \p2=(b3.south), \p3=(c3.south), \p4=(d3.south), \n1={min(\y1,\y2,\y3,\y4)} in coordinate (vin) at (0,\n1-0.5cm);
  \node[sec] (sV) at (vin) {¿Cómo se hace un compromiso específico y qué se inscribe en la lista?};
  \node[it={gC}{4.95cm}, anchor=north west, minimum height=3.52cm] (v0) at ([yshift=-0.2cm]sV.south west) {\textbf{(1)} Se elige el sector o subsector.\\
    \textbf{(2)} Para cada modo, en cada columna, se inscribe «Ninguna» (pleno), la limitación concreta (parcial) o «Sin consolidar» (nulo).\\
    \textbf{(3)} Los compromisos horizontales valen para todos los sectores inscritos.\\
    Si una medida limita el acceso y el trato nacional, va en la columna del acceso (art. XX.2)};
  \begin{scope}[cel/.style 2 args={draw=gC!60, line width=0.4pt, align=left, inner sep=2pt, anchor=north west, text width=#1, minimum height=#2},
                ce/.style={fill=gC!18, font=\footnotesize\bfseries}]
    \def\N{\textcolor{cN}{$\blacksquare$}}\def\L{\textcolor{cL}{$\blacksquare$}}\def\S{\textcolor{cS}{$\blacksquare$}}
    \coordinate (t0) at (v0.north -| 5.4,0);
    % Cabecera
    \node[cel={1.75cm}{0.62cm}, ce] (k0) at (t0) {Sector};
    \node[cel={3.35cm}{0.62cm}, ce] (k1) at (k0.north east) {Acceso a los mercados};
    \node[cel={2.95cm}{0.62cm}, ce] (k2) at (k1.north east) {Trato nacional};
    \node[cel={1.93cm}{0.62cm}, ce] (k3) at (k2.north east) {Adicionales};
    % Compromisos horizontales
    \node[cel={1.75cm}{0.95cm}, fill=gC!6] (r0) at (k0.south west) {\textbf{Horizontales}};
    \node[cel={3.35cm}{0.95cm}, fill=gC!6] (r1) at (r0.north east) {\L\ 4) solo directivos y especialistas trasladados};
    \node[cel={2.95cm}{0.95cm}, fill=gC!6] (r2) at (r1.north east) {\L\ 3) inmuebles: autorización};
    \node[cel={1.93cm}{0.95cm}, fill=gC!6] (r3) at (r2.north east) {};
    % Un sector: banca
    \node[cel={1.75cm}{1.95cm}] (s0) at (r0.south west) {\textbf{7.B} Banca: depósitos y préstamos};
    \node[cel={3.35cm}{1.95cm}] (s1) at (s0.north east) {\S\ 1) Sin consolidar\\\N\ 2) Ninguna\\\L\ 3) capital extranjero $\leq 49\%$\\\L\ 4) lo horizontal};
    \node[cel={2.95cm}{1.95cm}] (s2) at (s1.north east) {\S\ 1) Sin consolidar\\\N\ 2) Ninguna\\\L\ 3) consejo con mayoría nacional\\\L\ 4) lo horizontal};
    \node[cel={1.93cm}{1.95cm}] (s3) at (s2.north east) {lo que no es acceso ni trato nacional: títulos, normas o licencias};
  \end{scope}
  \node[anchor=north west, font=\footnotesize\itshape, text=gI, inner sep=1pt, text width=10.5cm, align=left] (ley) at ([yshift=-0.08cm]s0.south west) {Lo inscrito es un techo: puede aplicarse un régimen más abierto, nunca más restrictivo. Lo no inscrito: solo obligaciones generales};
  \draw[flecha, dashed] (c3.south) -- (c3.south |- k1.north);

  % ===================== 3. Desarrollo desde 1995 =====================
  \path let \p1=(v0.south), \p2=(ley.south), \n1={min(\y1,\y2)} in coordinate (fondo) at (0,\n1-0.5cm);
  \node[sec] (sD) at (fondo) {Desarrollo desde 1995: de los acuerdos sectoriales al bloqueo};
  \node[it={nM}{3.62cm}, anchor=north, minimum height=1.55cm] (e1) at ([yshift=-0.2cm]sD.south -| 1.925,0) {\textbf{Primeros años}: acuerdos sectoriales (financieros, telecomunicaciones): la masa crítica funciona};
  \node[it={nF}{3.62cm}, anchor=north, minimum height=1.55cm] (e2) at (e1.north -| 5.975,0) {\textbf{Doha} (2000-2001): los servicios, atados a la agricultura; estancada desde 2008};
  \node[it={nM}{3.62cm}, anchor=north, minimum height=1.55cm] (e3) at (e1.north -| 10.025,0) {\textbf{Exención para los PMA} (2011, hasta 2030): preferencias sin NMF, de efecto escaso};
  \node[it={nF}{3.62cm}, anchor=north, minimum height=1.55cm] (e4) at (e1.north -| 14.075,0) {\textbf{TiSA} (2013-2016): plurilateral, sin NMF, con \textit{standstill} y \textit{ratchet}; parado. Prospera la reglamentación nacional (último bloque)};
  \foreach \a/\b in {e1/e2, e2/e3, e3/e4} \draw[flecha] (\a) -- (\b);

  % ===================== 4. Balance =====================
  \node[sec] (sB) at ([yshift=-0.5cm]e1.south west) {Balance: éxito como marco de reglas, no como motor de liberalización};
  \node[clave={gTr}{4.95cm}, anchor=north west, minimum height=2.35cm] (f1) at ([yshift=-0.2cm]sB.south west) {\textbf{Marco, sí}: reglas vinculantes y exigibles; consolidar ya da certidumbre.\\\textbf{Liberalización, no}: compromisos por debajo de lo aplicado; la apertura ha sido unilateral o regional};
  \node[it={gTr}{4.95cm}, anchor=north, minimum height=2.35cm] (f2) at ([yshift=-0.2cm]sB.south -| 8.0,0) {\textbf{Razones}: barreras regulatorias que defienden grupos concentrados (OLSON); diseño flexible; polizón de la NMF; todo único (atado a la agricultura). El compromiso protege de retrocesos extremos, no de los parciales};
  \node[it={gTr}{4.95cm}, anchor=north east, minimum height=2.35cm] (f3) at ([yshift=-0.2cm]sB.south -| 16,0) {\textbf{Asimetrías}: PD ofensivos, PED defensivos; compromisos en el modo 3, que interesa a los inversores de los PD, y mínimos en el modo 4, el que interesa a los PED.\\\textbf{Críticas}: liberaliza poco, o amenaza los servicios públicos; obsoleto ante lo digital};
\end{tikzpicture}%
