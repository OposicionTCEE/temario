% Estructura del ADPIC: las cinco necesidades del preámbulo y las Partes que las atienden. Elaboración propia a partir del texto del ADPIC (anexo 1C del Acuerdo de Marrakech).
\definecolor{pA}{RGB}{150,110,170}
\definecolor{pB}{RGB}{125,80,150}
\definecolor{pC}{RGB}{100,55,130}
\definecolor{pD}{RGB}{80,40,110}
\definecolor{pE}{RGB}{60,30,90}
\definecolor{gI}{RGB}{110,110,110}
\begin{tikzpicture}[font=\scriptsize,
    every node/.append style={execute at begin node={\hyphenpenalty=10000}},
    cab/.style={fill=#1, text=white, font=\footnotesize\bfseries, align=center, text width=2.55cm, inner sep=3pt, rounded corners=2pt, minimum height=1.15cm},
    it/.style={draw=#1, fill=#1!10, line width=0.5pt, rounded corners=1.5pt, align=left, inner sep=2.5pt},
    pre/.style={font=\scriptsize\itshape, text=black!65, align=center, text width=2.6cm}]
  % Preámbulo
  \node[draw=gI, fill=gI!8, line width=0.5pt, rounded corners=1.5pt, align=center, text width=14.4cm, inner sep=3pt, anchor=south] (pream) at (7.25,4.75)
    {\textbf{Preámbulo}: reducir las distorsiones del comercio debidas a una protección insuficiente o dispar, sin que las medidas para hacerla respetar se conviertan en obstáculos al comercio legítimo $\Rightarrow$ cinco necesidades, de a) a e)};
  % Columnas: necesidad del preámbulo, Parte que la atiende y contenido
  \foreach \i/\x/\c/\n/\p/\t/\cuerpo in {
    1/0.0/pA/{a) ¿qué principios?}/{Parte I $\cdot$ arts. 1-8}/{Principios básicos}/{Normas \textbf{mínimas}: se puede proteger más, no menos (1).\\[1pt] Convenios de París y Berna incorporados (2 y 9).\\[1pt] Trato nacional (3) y \textbf{NMF} (4).\\[1pt] Agotamiento: libre (6).\\[1pt] Objetivos y principios: \textbf{equilibrio} (7 y 8).},
    2/2.95/pB/{b) ¿qué se protege?}/{Parte II $\cdot$ arts. 9-40}/{Normas de protección}/{\textbf{Siete categorías}: derecho de autor, marcas, indicaciones geográficas, dibujos y modelos, patentes, circuitos integrados e información no divulgada.\\[1pt] Para cada una: materia, derechos, excepciones y duración.\\[1pt] Control de las prácticas anticompetitivas en las licencias (40).},
    3/5.9/pC/{c) ¿cómo se hace cumplir?}/{Partes III-IV $\cdot$ arts. 41-62}/{Observancia}/{\textbf{Novedad del ADPIC}: procedimientos civiles y administrativos, medidas provisionales, \textbf{medidas en frontera} y procedimientos penales para la falsificación y la piratería a escala comercial.\\[1pt] Adquisición y mantenimiento de los derechos (62).},
    4/8.85/pD/{d) ¿quién resuelve?}/{Parte V $\cdot$ arts. 63-64}/{Solución de diferencias}/{Transparencia: publicación y notificación de leyes (63).\\[1pt] \textbf{Sistema de solución de diferencias de la OMC} (64), con posibilidad de retorsión cruzada.},
    5/11.8/pE/{e) ¿desde cuándo?}/{Parte VI $\cdot$ arts. 65-67}/{Disposiciones transitorias}/{Países desarrollados: 1996.\\[1pt] En desarrollo: 2000 (patentes de producto en sectores antes no protegidos: 2005).\\[1pt] PMA: prorrogado hasta 2034 (medicamentos: 2033).\\[1pt] Cooperación técnica (67).}} {
    \node[cab=\c, anchor=north west, inner sep=2.5pt] (h\i) at (\x,3.9) {{\scriptsize\mdseries \p}\\\t};
    \node[it=\c, anchor=north] (b\i) at (h\i.south) {\parbox[t][3.7cm][t]{2.5cm}{\raggedright\cuerpo}};
    \node[pre, anchor=south] (q\i) at (h\i.north) {\n};
    \draw[-{Latex[length=1.6mm]}, black!45, line width=0.5pt] (pream.south -| q\i.north) -- (q\i.north);
  }
  % Base institucional
  \node[draw=gI, fill=gI!8, line width=0.5pt, rounded corners=1.5pt, align=center, text width=14.4cm, inner sep=3pt, anchor=north] (base) at ([yshift=-0.2cm]b3.south -| pream.south)
    {\textbf{Parte VII (arts. 68-73): disposiciones institucionales y finales}\quad Consejo de los ADPIC (68) $\cdot$ examen de la aplicación (71) $\cdot$ excepciones relativas a la seguridad (73) $\cdot$ art. 31 bis y su anexo, añadidos por la enmienda en vigor desde 2017};
\end{tikzpicture}
