% La cláusula de nación más favorecida en el GATS y sus excepciones. Elaboración propia a partir de los arts. II, V y VII del GATS y del anexo sobre exenciones de las obligaciones del art. II.
\definecolor{oP}{RGB}{40,90,150}
\definecolor{oV}{RGB}{190,110,30}
\definecolor{oA}{RGB}{110,110,110}
\begin{tikzpicture}[font=\scriptsize,
    every node/.append style={execute at begin node={\hyphenpenalty=10000}},
    cab/.style={fill=#1, text=white, font=\footnotesize\bfseries, align=center, inner sep=2.5pt, rounded corners=2pt},
    it/.style={draw=#1, fill=#1!8, line width=0.5pt, rounded corners=1.5pt, align=left, inner sep=2.5pt},
    pa/.style={circle, draw=oP, fill=white, font=\tiny\bfseries, inner sep=0pt, minimum size=0.42cm},
    fl/.style={-{Latex[length=1.6mm]}, line width=0.7pt, #1}]
  % Bloque izquierdo: la regla
  \node[cab=oP, text width=5.6cm, anchor=north west] (hr) at (0,0) {La regla (art. II.1)};
  \node[pa, fill=oP, text=white] (x) at (0.75,-1.35) {X};
  \node[pa] (a) at (3.0,-0.85) {A};
  \node[pa] (b) at (3.0,-1.35) {B};
  \node[pa] (c) at (3.0,-1.85) {C};
  \node[font=\tiny, text=oA] at (3.0,-2.2) {$\vdots$};
  \draw[fl=oP] (x) -- node[above, font=\tiny, sloped] {ventaja} (a);
  \draw[fl=oP, dashed] (x) -- (b);
  \draw[fl=oP, dashed] (x) -- (c);
  \node[align=left, text width=2.3cm, font=\tiny, anchor=west] at (3.35,-1.35) {la misma ventaja, \textbf{inmediata e incondicionalmente}, a los servicios y proveedores similares de \textbf{todos} los miembros};
  \node[it=oP, text width=5.55cm, anchor=north west] (r1) at (0,-2.55) {Rige para \textbf{todas las medidas cubiertas}, haya o no compromisos: si un miembro admite a algunos proveedores extranjeros, debe admitir a los similares de los demás miembros.};
  \node[it=oA, text width=5.55cm, anchor=north west] (r2) at ([yshift=-0.1cm]r1.south west) {\textbf{Coste}: el \textit{polizón} (\textit{free rider}). Quien no ofrece nada se beneficia de lo que ofrecen los demás $\Rightarrow$ menos ambición y negociaciones de \textbf{masa crítica}.};
  % Bloque derecho: tres excepciones
  \node[cab=oV, text width=9.85cm, anchor=north west] (he) at (6.15,0) {Las excepciones: cuándo se puede discriminar entre socios};
  \foreach \i/\x/\tit/\txt in {
    1/6.15/{Exenciones (art. II.2 y anexo)}/{Consignadas en una lista en 1995 o al adherirse a la OMC; después, solo mediante una exención del art. IX.3 del Acuerdo de Marrakech.\\[1pt] Examen periódico por el Consejo; en principio, no más de $10$ años.\\[1pt] Las más frecuentes: audiovisual y transporte.},
    2/9.5/{Integración económica (art. V)}/{Acuerdos que liberalicen entre sus partes si:\\ (i) tienen una \textbf{cobertura sectorial sustancial} (sectores, volumen de comercio y modos, sin excluir ninguno \textit{a priori});\\ (ii) eliminan \textbf{sustancialmente toda discriminación}; y,\\ (iii) no elevan las barreras frente a terceros.},
    3/12.85/{Reconocimiento (art. VII)}/{De títulos, experiencia, licencias o certificados de otros países, unilateral o por acuerdo.\\[1pt] Condiciones: abierto a que otros miembros se adhieran o demuestren su equivalencia; notificado al Consejo; nunca como medio de discriminación ni restricción encubierta.}} {
    \node[cab=oV!75, text width=3.05cm, minimum height=0.85cm, anchor=north west, font=\scriptsize\bfseries] (t\i) at (\x,-0.62) {\tit};
    \node[it=oV, text width=3.0cm, anchor=north, minimum height=3.45cm] (e\i) at ([yshift=-0.08cm]t\i.south) {\txt};
  }
\end{tikzpicture}
