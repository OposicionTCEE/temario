% Las seis limitaciones al acceso a los mercados del art. XVI.2 del GATS. Elaboración propia a partir del art. XVI y de las directrices para la consignación de compromisos (S/L/92).
\definecolor{aQ}{RGB}{40,90,150}
\definecolor{aF}{RGB}{120,80,150}
\definecolor{gI}{RGB}{110,110,110}
\begin{tikzpicture}[font=\scriptsize,
    every node/.append style={execute at begin node={\hyphenpenalty=10000}},
    cab/.style={fill=#1, text=white, font=\footnotesize\bfseries, align=center, inner sep=2.5pt, rounded corners=2pt, anchor=north west},
    it/.style={draw=#1, fill=#1!8, line width=0.5pt, rounded corners=1.5pt, align=left, inner sep=2.5pt, text width=2.4cm, minimum height=2.15cm, anchor=north west}]
  % Grupo 1: limitaciones cuantitativas
  \node[cab=aQ, text width=10.35cm] at (0,0) {Limitaciones cuantitativas: contingentes, monopolios y proveedores exclusivos o pruebas de necesidades económicas};
  \foreach \l/\x/\tit/\ej in {
    a/0/{a) Número de proveedores}/{máximo de $100$ licencias de banca minorista; monopolio público de seguros},
    b/2.65/{b) Valor de los activos o transacciones}/{filiales de bancos extranjeros limitadas a un porcentaje de los activos bancarios totales},
    c/5.3/{c) Número de operaciones o volumen de producción}/{límite al tiempo de emisión de películas extranjeras},
    d/7.95/{d) Número de personas físicas empleadas}/{contingente de trabajadores extranjeros; prueba de necesidades para contratarlos}} {
    \node[it=aQ] at (\x,-0.95) {\textbf{\tit}\\[2pt] {\itshape p. ej.:} \ej};
  }
  % Grupo 2: limitaciones a la forma y a la propiedad
  \node[cab=aF, text width=5.05cm] at (10.85,0) {Limitaciones a la forma jurídica y a la propiedad extranjera};
  \foreach \l/\x/\tit/\ej in {
    e/10.85/{e) Tipo de persona jurídica o empresa conjunta}/{solo sociedades, no sucursales; empresa conjunta obligatoria con socio local},
    f/13.5/{f) Participación de capital extranjero}/{participación extranjera máxima del $49\%$}} {
    \node[it=aF] at (\x,-0.95) {\textbf{\tit}\\[2pt] {\itshape p. ej.:} \ej};
  }
  % Rasgos comunes
  \node[draw=gI, fill=gI!8, line width=0.5pt, rounded corners=1.5pt, align=left, text width=15.75cm, inner sep=3pt, anchor=north west] at (0,-3.25)
    {\textbf{Rasgos}: (i) \textbf{lista cerrada}: solo estas seis medidas están prohibidas en los sectores comprometidos, salvo que se consignen; (ii) pueden ser \textbf{no discriminatorias}, porque afectan por igual a nacionales y extranjeros; (iii) pueden aplicarse a todo el territorio o a una subdivisión regional; y, (iv) una \textbf{prohibición total} equivale a un contingente cero (\textit{Estados Unidos --- Juegos de azar}, 2005).};
\end{tikzpicture}
