% El trato nacional en el GATS: prueba y formas de discriminación. Elaboración propia a partir del art. XVII del GATS.
\definecolor{tP}{RGB}{40,90,150}
\definecolor{tD}{RGB}{190,70,60}
\definecolor{tH}{RGB}{190,110,30}
\definecolor{gI}{RGB}{110,110,110}
\begin{tikzpicture}[font=\scriptsize,
    every node/.append style={execute at begin node={\hyphenpenalty=10000}},
    paso/.style={draw=tP, fill=tP!8, line width=0.5pt, rounded corners=1.5pt, align=left, inner sep=2.5pt, text width=3.0cm, minimum height=1.55cm, anchor=north west},
    cab/.style={fill=#1, text=white, font=\footnotesize\bfseries, align=center, inner sep=2.5pt, rounded corners=2pt, anchor=north west},
    it/.style={draw=#1, fill=#1!8, line width=0.5pt, rounded corners=1.5pt, align=left, inner sep=2.5pt, anchor=north west},
    fl/.style={-{Latex[length=1.6mm]}, line width=0.7pt, tP}]
  % La prueba
  \node[cab=tP, text width=10.35cm] at (0,0) {La prueba: ¿se incumple el trato nacional?};
  \node[paso] (p1) at (0,-0.75) {\textbf{1. ¿Sector y modo inscritos?}\\ Solo hay obligación en lo inscrito en la lista y con las salvedades consignadas (XVII.1)};
  \node[paso] (p2) at (3.65,-0.75) {\textbf{2. ¿Servicios o proveedores similares?}\\ Se compara con los servicios y proveedores nacionales similares};
  \node[paso] (p3) at (7.3,-0.75) {\textbf{3. ¿Trato menos favorable?}\\ Sí, si \textbf{modifica las condiciones de competencia} en favor de los nacionales (XVII.3)};
  \draw[fl] (p1.east) -- (p2.west);
  \draw[fl] (p2.east) -- (p3.west);
  \node[it=gI, text width=10.25cm] at (0,-2.62) {Da igual que el trato sea \textbf{formalmente idéntico o formalmente diferente} (XVII.2): cuenta el efecto. Límite: no obliga a compensar las desventajas competitivas inherentes al carácter extranjero del proveedor (nota 10 del art. XVII).};
  % Formas de discriminación
  \node[cab=tD, text width=5.05cm] at (10.85,0) {Dos formas de discriminación};
  \node[it=tD, text width=4.95cm] (dj) at (10.85,-0.75) {\textbf{De derecho} (trato formalmente diferente)\\ p. ej.: nacionalidad exigida a los consejeros; subvenciones solo para empresas nacionales; impuestos más altos a proveedores extranjeros};
  \node[it=tH, text width=4.95cm, anchor=north] (dh) at ([yshift=-0.1cm]dj.south) {\textbf{De hecho} (trato formalmente idéntico)\\ p. ej.: exigir residencia o experiencia previa en el país, que en la práctica solo cumplen los nacionales};
  % Comparación con el GATT
  \node[it=gI, text width=15.75cm] at (0,-3.7) {\textbf{Frente al GATT}: en las mercancías, el trato nacional es una obligación general (art. III del GATT); en los servicios, solo rige en los sectores y modos que cada miembro inscribe, y con las salvedades que consigna.};
\end{tikzpicture}
