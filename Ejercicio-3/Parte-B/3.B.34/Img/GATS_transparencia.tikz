% La obligación de transparencia en el GATS. Elaboración propia a partir de los arts. III, III bis y IV.2 del GATS.
\definecolor{oP}{RGB}{40,90,150}
\definecolor{oR}{RGB}{46,125,90}
\definecolor{oV}{RGB}{190,110,30}
\definecolor{oM}{RGB}{120,70,140}
\definecolor{oA}{RGB}{110,110,110}
\begin{tikzpicture}[font=\footnotesize,
    every node/.append style={execute at begin node={\hyphenpenalty=10000}},
    act/.style={draw=#1, fill=#1, text=white, font=\footnotesize\bfseries, align=center, rounded corners=2pt, inner sep=3pt, text width=3.0cm, minimum height=1.0cm},
    it/.style={draw=#1, fill=#1!8, line width=0.5pt, rounded corners=1.5pt, align=left, inner sep=3pt, text width=2.45cm},
    fl/.style={-{Latex[length=2mm]}, line width=0.9pt, #1}]
  % Actores en línea
  \node[act=oA] (p) at (1.6,0) {Público y proveedores};
  \node[act=oP] (m) at (6.4,0) {Miembro};
  \node[act=oR] (c) at (12.1,1.9) {Consejo del Comercio de Servicios};
  \node[act=oV] (o) at (12.1,-1.9) {Otros miembros};
  % Flechas
  \draw[fl=oP] (m.west) -- (p.east);
  \draw[fl=oR] (m.east) ++(0,0.2) -| ([xshift=-0.4cm]c.west) -- (c.west);
  \draw[fl=oV, {Latex[length=2mm]}-{Latex[length=2mm]}] (m.east) ++(0,-0.2) -| ([xshift=-0.4cm]o.west) -- (o.west);
  \draw[fl=oM, dashed] (o.north) -- (c.south) node[midway, right, text=oM, font=\footnotesize\bfseries, align=left] {4. Contranotificar\\ \normalfont (III.5)};
  % Rótulos de las obligaciones, cada uno junto a su flecha
  \node[it=oP, anchor=north, text width=3.8cm] at (3.3,-0.75) {\textbf{1. Publicar} (III.1-2): con prontitud, todas las medidas de aplicación general y los acuerdos sobre servicios};
  \node[it=oR, anchor=south] at (8.65,0.65) {\textbf{2. Notificar} (III.3): al menos una vez al año, los cambios que afecten a los \textbf{sectores comprometidos}};
  \node[it=oV, anchor=north] at (8.65,-0.65) {\textbf{3. Responder} (III.4; IV.2): servicios de información; los países desarrollados, además, puntos de contacto para los países en desarrollo};
  % Límite
  \node[draw=oA, fill=oA!10, rounded corners=2pt, text width=15.2cm, align=left, inner sep=4pt, anchor=north west] at (0,-3.85)
    {\textbf{Límite (III bis)}: no obliga a revelar información confidencial cuya divulgación impida el cumplimiento de las leyes, sea contraria al interés público o lesione intereses comerciales legítimos.};
\end{tikzpicture}
