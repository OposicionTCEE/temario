% La obligación de transparencia en el GATS. Elaboración propia a partir de los arts. III, III bis y IV.2 del GATS.
\definecolor{oP}{RGB}{40,90,150}
\definecolor{oR}{RGB}{46,125,90}
\definecolor{oV}{RGB}{190,110,30}
\definecolor{oA}{RGB}{110,110,110}
\begin{tikzpicture}[font=\scriptsize,
    every node/.append style={execute at begin node={\hyphenpenalty=10000}},
    act/.style={draw=#1, fill=#1, text=white, font=\footnotesize\bfseries, align=center, rounded corners=2pt, inner sep=3pt, text width=2.5cm, minimum height=0.85cm},
    it/.style={draw=#1, fill=#1!8, line width=0.5pt, rounded corners=1.5pt, align=left, inner sep=2.5pt, text width=3.9cm},
    fl/.style={-{Latex[length=1.8mm]}, line width=0.8pt, #1}]
  % Actores
  \node[act=oP] (m) at (0,0) {Miembro};
  \node[act=oA] (p) at (-6.6,0) {Público y proveedores};
  \node[act=oR] (c) at (6.6,1.25) {Consejo del Comercio de Servicios};
  \node[act=oV] (o) at (6.6,-1.25) {Otros miembros};
  % Flechas
  \draw[fl=oP] (m.west) -- (p.east);
  \draw[fl=oR] (m.north east) -- (c.west);
  \draw[fl=oV, {Latex[length=1.8mm]}-{Latex[length=1.8mm]}] (m.south east) -- (o.west);
  \draw[fl=oV, dashed] (o.north) -- (c.south);
  % Etiquetas de las obligaciones
  \node[it=oP, anchor=south] at (-3.3,0.2) {\textbf{1. Publicar} con prontitud todas las medidas de aplicación general y los acuerdos internacionales sobre servicios (III.1 y III.2)};
  \node[it=oR, anchor=south] at (2.6,1.4) {\textbf{2. Notificar}, al menos una vez al año, los cambios normativos que afecten significativamente a los \textbf{sectores comprometidos} (III.3)};
  \node[it=oV, anchor=north] at (2.6,-1.4) {\textbf{3. Responder} a sus solicitudes de información, a través de \textbf{servicios de información}; los países desarrollados, además, \textbf{puntos de contacto} para los proveedores de los países en desarrollo (III.4 y IV.2)};
  \node[font=\tiny, text width=2.0cm, align=left, text=oV!80!black, anchor=west] at (6.7,0) {\textbf{4. Contranotificar}: cualquier miembro puede notificar medidas de otro (III.5)};
  % Límite
  \node[it=oA, text width=5.2cm, anchor=north] at (-3.6,-0.6) {\textbf{Límite} (III bis): no obliga a revelar información confidencial cuya divulgación impida el cumplimiento de las leyes, sea contraria al interés público o lesione intereses comerciales legítimos.};
\end{tikzpicture}
