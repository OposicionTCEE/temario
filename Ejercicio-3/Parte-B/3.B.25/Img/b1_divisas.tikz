% Figura (cuerpo, 1.4 «Contrato»): los dos swaps de divisas. Flujos entre A (arriba) y B (abajo); S = euros por dólar.
% (a) Swap de divisas: en 0, A entrega N euros y recibe N/S_0 dólares; en cada fecha paga intereses en dólares, r* N/S_0,
%     y recibe intereses en euros, r N; en T devuelve los dólares y recupera los euros al mismo tipo de cambio.
% (b) FX swap: compraventa al contado en 0 y la contraria a plazo en T al precio F, sin pagos intermedios.
% Igual que anx_swap_divisas: el texto del cuerpo comenta todos sus elementos.
% Generar con: bash Code/generar_figura.sh b1_divisas
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  % ---------------- (a) CCS ----------------
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (3.2,2.55) {(a) Swap de divisas};
    \draw[black!30] (0,1.8) -- (6.6,1.8);
    \draw[black!30] (0,0.3) -- (6.6,0.3);
    \node[anchor=east] at (-0.1,1.8) {$A$};
    \node[anchor=east] at (-0.1,0.3) {$B$};
    \draw[->] (0,-0.3) -- (7.0,-0.3) node[right] {$t$};
    \node[below] at (0.6,-0.3) {$0$};
    \node[below] at (3.3,-0.3) {$t_1,\dots,t_n$};
    \node[below] at (6.0,-0.3) {$T$};
    \draw[->, thick] (0.45,1.7) -- (0.45,0.4);
    \draw[->, thick] (0.75,0.4) -- (0.75,1.7);
    \node[anchor=east, font=\scriptsize] at (0.42,1.05) {$N$\,€};
    \node[anchor=west, font=\scriptsize] at (0.78,1.05) {$N/S_0$\,\$};
    \draw[->, thick, black!60] (3.15,1.7) -- (3.15,0.4);
    \draw[->, thick, black!60] (3.45,0.4) -- (3.45,1.7);
    \node[anchor=east, font=\scriptsize] at (3.12,1.05) {$r^*N/S_0$\,\$};
    \node[anchor=west, font=\scriptsize] at (3.48,1.05) {$rN$\,€};
    \draw[->, thick] (5.85,1.7) -- (5.85,0.4);
    \draw[->, thick] (6.15,0.4) -- (6.15,1.7);
    \node[anchor=east, font=\scriptsize] at (5.82,1.05) {$N/S_0$\,\$};
    \node[anchor=west, font=\scriptsize] at (6.18,1.05) {$N$\,€};
  \end{scope}
  % ---------------- (b) FX swap ----------------
  \begin{scope}[xshift=8.5cm]
    \node[font=\footnotesize\bfseries] at (3.0,2.55) {(b) \textit{FX swap}};
    \draw[black!30] (0,1.8) -- (6.0,1.8);
    \draw[black!30] (0,0.3) -- (6.0,0.3);
    \node[anchor=east] at (-0.1,1.8) {$A$};
    \node[anchor=east] at (-0.1,0.3) {$B$};
    \draw[->] (0,-0.3) -- (6.4,-0.3) node[right] {$t$};
    \node[below] at (0.6,-0.3) {$0$};
    \node[below] at (5.4,-0.3) {$T$};
    \draw[->, thick] (0.45,1.7) -- (0.45,0.4);
    \draw[->, thick] (0.75,0.4) -- (0.75,1.7);
    \node[anchor=east, font=\scriptsize] at (0.42,1.05) {$N$\,€};
    \node[anchor=west, font=\scriptsize] at (0.78,1.05) {$N/S_0$\,\$};
    \draw[->, thick] (5.25,1.7) -- (5.25,0.4);
    \draw[->, thick] (5.55,0.4) -- (5.55,1.7);
    \node[anchor=east, font=\scriptsize] at (5.22,1.05) {$N/S_0$\,\$};
    \node[anchor=west, font=\scriptsize] at (5.58,1.05) {$NF/S_0$\,€};
  \end{scope}
\end{tikzpicture}
