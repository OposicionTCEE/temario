% Figura (cuerpo, 1.2 «Motivos»): fijar el precio elimina las dos colas. (a) A tendrá que comprar una unidad del
% subyacente en T: su exposición es -S_T; con la compra a plazo, S_T - F, su resultado queda en -F. (b) B tendrá que
% venderla: su exposición es S_T; con la venta a plazo, F - S_T, queda en F. Las dos coberturas son una la imagen
% de la otra. Escala: F = 2; x = 0,95 cm, y = 0,5 cm. Valores ilustrativos.
% Generar con: bash Code/generar_figura.sh b1_fijar
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=0.95cm, y=0.5cm]
  % ---------------- (a) A: comprará en T ----------------
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (2.2,5.0) {(a) $A$ comprará en $T$};
    \draw[->] (0,0) -- (4.6,0) node[below] {$S_T$};
    \draw[->] (0,-4.4) -- (0,4.4);
    \draw[thick, dashed] (0,0) -- (4,-4) node[right] {$-S_T$};
    \draw[thick, dotted] (0,-2) -- (4,2) node[right] {$S_T-F$};
    \draw[very thick] (0,-2) -- (4,-2) node[right] {$-F$};
    \draw (2,0.15) -- (2,-0.15);
    \node[above] at (2,0) {$F$};
  \end{scope}
  % ---------------- (b) B: venderá en T ----------------
  \begin{scope}[xshift=7.2cm]
    \node[font=\footnotesize\bfseries] at (2.2,5.0) {(b) $B$ venderá en $T$};
    \draw[->] (0,0) -- (4.6,0) node[below] {$S_T$};
    \draw[->] (0,-4.4) -- (0,4.4);
    \draw[thick, dashed] (0,0) -- (4,4) node[right] {$S_T$};
    \draw[thick, dotted] (0,2) -- (4,-2) node[right] {$F-S_T$};
    \draw[very thick] (0,2) -- (4,2) node[right] {$F$};
    \draw (2,0.15) -- (2,-0.15);
    \node[below] at (2,0) {$F$};
  \end{scope}
\end{tikzpicture}
