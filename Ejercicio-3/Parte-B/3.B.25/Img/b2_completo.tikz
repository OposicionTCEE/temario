% Figura (cuerpo, 2.5 «Completitud»): cuándo es único el precio. (a) Mercado completo: dos estados y dos activos (el
% subyacente y el activo sin riesgo) bastan para fabricar cualquier pago, y el precio que no admite arbitraje es uno solo.
% (b) Mercado incompleto: tres estados y los mismos dos activos; no hay réplica exacta, hay muchas medidas neutrales al
% riesgo compatibles con los precios observados, y el arbitraje solo acota el precio entre dos cotas. Esquema sin valores.
% Generar con: bash Code/generar_figura.sh b2_completo
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  % ---------------- (a) Completo ----------------
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (2.6,2.0) {(a) Mercado completo};
    \coordinate (A) at (0,0.3);
    \draw[thick] (A) -- (1.3,1.1); \draw[thick] (A) -- (1.3,-0.5);
    \foreach \p in {(A),(1.3,1.1),(1.3,-0.5)} \fill \p circle (1.6pt);
    \node[align=center] at (0.65,-1.2) {dos estados,\\dos activos};
    \draw (2.6,0.3) -- (5.4,0.3);
    \fill (4.0,0.3) circle (2.4pt);
    \node[above] at (4.0,0.42) {precio único};
    \node[align=center] at (2.6,-2.3) {la réplica es exacta $\Rightarrow$ una sola\\medida neutral y un solo precio};
  \end{scope}
  % ---------------- (b) Incompleto ----------------
  \begin{scope}[xshift=7.6cm]
    \node[font=\footnotesize\bfseries] at (2.6,2.0) {(b) Mercado incompleto};
    \coordinate (B) at (0,0.3);
    \draw[thick] (B) -- (1.3,1.1); \draw[thick] (B) -- (1.3,0.3); \draw[thick] (B) -- (1.3,-0.5);
    \foreach \p in {(B),(1.3,1.1),(1.3,0.3),(1.3,-0.5)} \fill \p circle (1.6pt);
    \node[align=center] at (0.65,-1.2) {tres estados,\\dos activos};
    \draw (2.6,0.3) -- (5.4,0.3);
    \draw[line width=4pt, black!30] (3.3,0.3) -- (4.7,0.3);
    \draw (3.3,0.15) -- (3.3,0.45); \draw (4.7,0.15) -- (4.7,0.45);
    \node[above] at (4.0,0.48) {horquilla};
    \node[below, align=center] at (3.3,0.12) {cota\\inferior};
    \node[below, align=center] at (4.7,0.12) {cota\\superior};
    \node[align=center] at (2.6,-2.3) {sin réplica exacta $\Rightarrow$ muchas medidas\\neutrales: el arbitraje solo acota el precio};
  \end{scope}
\end{tikzpicture}
