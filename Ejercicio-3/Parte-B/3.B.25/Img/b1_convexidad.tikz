% Figura (cuerpo, 1.1 «Cobertura»): por qué cubrirse crea valor cuando el coste que soporta la empresa es convexo en su
% resultado (impuestos que crecen más que el beneficio, costes de insolvencia, financiación externa cara). Con un
% resultado incierto, w_1 o w_2 con la misma probabilidad, el coste esperado, E[C(w)], está en la cuerda y supera al coste
% del resultado esperado, C(E[w]), que está en la curva; la cobertura, que fija el resultado en E[w], ahorra la
% diferencia (desigualdad de JENSEN). Curva ilustrativa C(w) = 3 exp(-1,1 w) + 0,15; w_1 = 0,8, w_2 = 3,2.
% Generar con: bash Code/generar_figura.sh b1_convexidad
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1.6cm, y=1.9cm]
  \draw[->] (0,0) -- (4.4,0) node[below left] {resultado, $w$};
  \draw[->] (0,0) -- (0,1.8) node[left] {coste};
  \draw[very thick, domain=0.35:4.1, samples=60] plot (\x, {3*exp(-1.1*\x)+0.15});
  \node[right] at (4.1,{3*exp(-1.1*4.1)+0.15}) {$C(w)$};
  \coordinate (A) at (0.8,1.394);
  \coordinate (B) at (3.2,0.239);
  \coordinate (M) at (2.0,0.817);
  \coordinate (Q) at (2.0,0.482);
  \draw[dashed] (A) -- (B);
  \foreach \p in {A,B,M,Q} \fill (\p) circle (1.6pt);
  \draw[dotted] (0.8,0) -- (A);
  \draw[dotted] (3.2,0) -- (B);
  \draw[dotted] (2.0,0) -- (M);
  \draw[dotted] (0,0.817) -- (M);
  \draw[dotted] (0,0.482) -- (Q);
  \node[below] at (0.8,0) {$w_1$};
  \node[below] at (2.0,0) {$E[w]$};
  \node[below] at (3.2,0) {$w_2$};
  \node[left] at (0,0.817) {$E[C(w)]$};
  \node[left] at (0,0.482) {$C(E[w])$};
  \draw[decorate, decoration={brace, amplitude=3pt}] (2.07,0.80) -- (2.07,0.50);
  \draw[gray] (2.16,0.65) -- (2.75,1.12);
  \node[anchor=south west, align=left] at (2.7,1.1) {ahorro de\\la cobertura};
\end{tikzpicture}
