% Figura (cuerpo, 3.4 «Concentración»): protección frente al impago repartida y concentrada. Tres compradores de
% protección (C) frente al impago de un mismo deudor. (a) La compran a tres vendedores distintos (V), que asumen cada uno una
% parte: si el deudor incumple, el pago se reparte y se absorbe. (b) La compran todos al mismo vendedor, que no la ha
% cubierto, como AIG en 2008: si el deudor incumple, el vendedor no puede pagar a todos, y todos se quedan sin protección.
% La flecha va del vendedor al comprador: lo que le pagaría si hay impago. Esquema sin valores.
% Generar con: bash Code/generar_figura.sh b3_proteccion
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]},
    caja/.style={draw, rounded corners=2pt, minimum width=0.9cm, minimum height=0.6cm},
    cae/.style={draw, rounded corners=2pt, minimum width=1.4cm, minimum height=0.6cm, fill=black!30}]
  % ---------------- (a) Repartida ----------------
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (1.5,3.2) {(a) Protección repartida};
    \foreach \i/\x in {1/0, 2/1.5, 3/3.0} {
      \node[caja] (V\i) at (\x,2.2) {$V_\i$};
      \node[caja] (C\i) at (\x,0) {$C_\i$};
      \draw[->, thick] (V\i) -- (C\i);
    }
    \node[align=center] at (1.5,-1.0) {cada vendedor asume una parte\\$\Rightarrow$ el impago se absorbe};
  \end{scope}
  % ---------------- (b) Concentrada ----------------
  \begin{scope}[xshift=7.4cm]
    \node[font=\footnotesize\bfseries] at (1.5,3.2) {(b) Protección concentrada};
    \node[cae] (V) at (1.5,2.2) {$V$};
    \foreach \i/\x in {1/0, 2/1.5, 3/3.0} {
      \node[caja] (C\i) at (\x,0) {$C_\i$};
      \draw[->, thick] (V) -- (C\i);
    }
    \node[align=center] at (1.5,-1.0) {un solo vendedor, sin cubrirse\\$\Rightarrow$ si no puede pagar, todos pierden la protección};
  \end{scope}
\end{tikzpicture}
