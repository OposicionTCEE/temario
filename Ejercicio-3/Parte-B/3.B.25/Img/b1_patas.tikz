% Figura (cuerpo, 1.4 «Contrato»): las patas de un swap frente al contrato a plazo, para A. (a) El contrato a plazo es un
% solo intercambio en T: A recibe S_T, que varía, y paga F, fijado al firmar. (b) El swap de tipos de interés repite el
% intercambio en cada fecha t_i: A recibe tau L_{i-1}, que varía, y paga tau s, el mismo en todas; en cada fecha solo se
% liquida la diferencia. Longitudes ilustrativas. Generar con: bash Code/generar_figura.sh b1_patas
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=0.85cm, y=0.85cm]
  % ---------------- (a) Contrato a plazo ----------------
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (1.0,2.3) {(a) Contrato a plazo};
    \draw[->] (0,0) -- (3.0,0) node[right] {$t$};
    \draw (0,0.1) -- (0,-0.1);
    \node[below left=0pt] at (0,0) {$0$};
    \draw (2.4,0.1) -- (2.4,-0.1);
    \node[below right=0pt] at (2.4,0) {$T$};
    \draw[->, very thick] (2.3,0) -- (2.3,1.3) node[above] {$S_T$};
    \draw[->, very thick, black!55] (2.5,0) -- (2.5,-1.0) node[below] {$F$};
    \node[anchor=east] at (-0.15,0.9) {$A$ recibe};
    \node[anchor=east] at (-0.15,-0.7) {$A$ paga};
    \node[align=center] at (1.0,-2.15) {un precio, $F$, en una fecha\\$\Rightarrow$ fija un pago};
  \end{scope}
  % ---------------- (b) Swap ----------------
  \begin{scope}[xshift=6.0cm]
    \node[font=\footnotesize\bfseries] at (3.2,2.3) {(b) Swap};
    \draw[->] (0,0) -- (6.6,0) node[right] {$t$};
    \draw (0,0.1) -- (0,-0.1);
    \node[below left=0pt] at (0,0) {$0$};
    \foreach \t/\h/\e in {1.2/0.9/0, 2.4/1.3/1, 3.6/0.7/2, 5.8/1.1/{n-1}} {
      \draw (\t,0.1) -- (\t,-0.1);
      \draw[->, very thick] (\t-0.1,0) -- (\t-0.1,\h) node[above] {$\tau L_{\e}$};
      \draw[->, very thick, black!55] (\t+0.1,0) -- (\t+0.1,-1.0) node[below] {$\tau s$};
    }
    \node at (4.7,0.45) {$\cdots$};
    \node[below right=0pt] at (1.2,0) {$t_1$};
    \node[below right=0pt] at (2.4,0) {$t_2$};
    \node[below right=0pt] at (3.6,0) {$t_3$};
    \node[below right=0pt] at (5.8,0) {$t_n$};
    \node[anchor=east] at (-0.15,0.9) {$A$ recibe};
    \node[anchor=east] at (-0.15,-0.7) {$A$ paga};
    \node[align=center] at (3.2,-2.15) {un mismo precio, $s$, en todas las fechas\\$\Rightarrow$ fija un flujo};
  \end{scope}
\end{tikzpicture}
