% Figura (Anexo I, «Reparto del riesgo»): caja de EDGEWORTH con dos estados (1: el subyacente sube; 2: baja) y sin
% riesgo agregado (caja cuadrada de lado 6). A tiene poca riqueza en el estado 1 y mucha en el 2; B, al revés (dotación E =
% (1,5; 4,5) desde O_A). Mismas creencias (pi_1 = pi_2) y utilidad logarítmica: curvas de A w1 w2 = 6,75 (por E) y 9 (por C);
% de B (6 - w1)(6 - w2) = 6,75 y 9. El contrato a plazo lleva de E a C = (3; 3), sobre la diagonal (certeza de los dos).
% Generar con: bash Code/generar_figura.sh anx_reparto
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=0.95cm, y=0.95cm]
  \draw[thick] (0,0) rectangle (6,6);
  \node[below left] at (0,0) {$O_A$};
  \node[above right] at (6,6) {$O_B$};
  \node[below] at (3,-0.05) {$w_1^A$};
  \node[left] at (-0.05,3) {$w_2^A$};
  \node[above] at (3,6.05) {$w_1^B$};
  \node[right] at (6.05,3) {$w_2^B$};
  % Diagonal: certeza para los dos
  \draw[dashed, black!55] (0,0) -- (6,6);
  % Curvas de indiferencia de A
  \draw[thick] plot[domain=1.2:5.6, samples=60] (\x,{6.75/\x});
  \draw[thick] plot[domain=1.55:5.8, samples=60] (\x,{9/\x});
  % Curvas de indiferencia de B
  \draw[thick, black!50] plot[domain=0.4:4.8, samples=60] (\x,{6-6.75/(6-\x)});
  \draw[thick, black!50] plot[domain=0.2:4.45, samples=60] (\x,{6-9/(6-\x)});
  % Contrato
  \draw[->, very thick] (1.5,4.5) -- (2.93,3.07);
  \fill (1.5,4.5) circle (1.8pt) node[above left] {$e$};
  \fill (3,3) circle (1.8pt) node[below right] {$e^*$};
\end{tikzpicture}
