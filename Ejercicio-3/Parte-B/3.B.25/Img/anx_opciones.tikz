% Figura (Anexo I, «Pagos de las opciones»): resultado al vencimiento, neto de la prima, del comprador (continua) y del
% vendedor (discontinua). (a) Call con K = 2 y prima p_c = 0,5: equilibrio en K + p_c. (b) Put con K = 2 y prima
% p_p = 0,5: equilibrio en K - p_p; ganancia máxima del comprador K - p_p. Se ignoran los intereses de la prima.
% Generar con: bash Code/generar_figura.sh anx_opciones
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  % ---------------- (a) Opción de compra ----------------
  \begin{scope}[x=1.2cm, y=0.8cm]
    \node[font=\footnotesize\bfseries] at (2.1,2.45) {(a) Opción de compra};
    \draw[->] (0,0) -- (4.5,0) node[below] {$S_T$};
    \draw[->] (0,-1.9) -- (0,2.1);
    \draw[very thick] (0,-0.5) -- (2,-0.5) -- (4,1.5);
    \draw[very thick, dashed] (0,0.5) -- (2,0.5) -- (4,-1.5);
    \draw[dotted] (2,0.5) -- (2,-0.5);
    \node[below left] at (2,0) {$K$};
    \node[anchor=east] at (0,0.5) {$c$};
    \node[anchor=east] at (0,-0.5) {$-c$};
    \node[anchor=west] at (4,1.5) {comprador};
    \node[anchor=west] at (4,-1.5) {vendedor};
  \end{scope}
  % ---------------- (b) Opción de venta ----------------
  \begin{scope}[xshift=8.3cm, x=1.2cm, y=0.8cm]
    \node[font=\footnotesize\bfseries] at (2.1,2.45) {(b) Opción de venta};
    \draw[->] (0,0) -- (4.5,0) node[below] {$S_T$};
    \draw[->] (0,-1.9) -- (0,2.1);
    \draw[very thick] (0,1.5) -- (2,-0.5) -- (4,-0.5);
    \draw[very thick, dashed] (0,-1.5) -- (2,0.5) -- (4,0.5);
    \draw[dotted] (2,0.5) -- (2,-0.5);
    \node[below right] at (2,0) {$K$};
    \node[anchor=east] at (0,1.5) {$K-p$};
    \node[anchor=east] at (0,-1.5) {$-(K-p)$};
    \node[anchor=west] at (0.9,0.78) {comprador};
    \node[anchor=west] at (4,0.5) {vendedor};
  \end{scope}
\end{tikzpicture}
