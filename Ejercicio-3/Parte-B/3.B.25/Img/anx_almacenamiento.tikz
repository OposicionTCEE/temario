% Figura (Anexo II, «Coste de acarreo»): (a) curva de precios a plazo F(T) = S_0 e^{(r+u-y)T} en contango (r + u > y) y en
% backwardation (y > r + u). (b) Oferta de almacenamiento (KALDOR, 1939; WORKING, 1949; BRENNAN, 1958): el diferencial
% entre el precio a plazo y el de contado frente a las existencias; negativo con existencias escasas (rendimiento de
% conveniencia alto) y próximo al coste completo de mantenerlas, r + u, con existencias abundantes.
% Generar con: bash Code/generar_figura.sh anx_almacenamiento
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  % ---------------- (a) Curva de precios a plazo ----------------
  \begin{scope}[x=1.1cm, y=0.85cm]
    \node[font=\footnotesize\bfseries] at (2.2,3.65) {(a) Curva de precios a plazo};
    \draw[->] (0,0) -- (4.6,0) node[below] {$T$};
    \draw[->] (0,0) -- (0,3.3) node[left] {$F$};
    \draw[very thick] plot[domain=0:4, samples=40] (\x,{1.6*exp(0.17*\x)});
    \draw[very thick, dashed] plot[domain=0:4, samples=40] (\x,{1.6*exp(-0.14*\x)});
    \node[anchor=east] at (0,1.6) {$S_0$};
    \node[anchor=west] at (4,{1.6*exp(0.68)}) {$r+u>y$};
    \node[anchor=west] at (4,{1.6*exp(-0.56)}) {$y>r+u$};
  \end{scope}
  % ---------------- (b) Oferta de almacenamiento ----------------
  \begin{scope}[xshift=8.4cm, x=1.1cm, y=0.85cm]
    \node[font=\footnotesize\bfseries] at (2.2,3.65) {(b) Oferta de almacenamiento};
    \draw[->] (0,1.5) -- (4.6,1.5) node[below] {Existencias};
    \draw[->] (0,0) -- (0,3.3);
    \node[anchor=east] at (0,3.0) {$\dfrac{F-S}{S}$};
    \draw[dashed, black!55] (0,2.55) -- (4.3,2.55);
    \node[anchor=west] at (4.3,2.55) {$r+u$};
    \node[anchor=east] at (0,1.5) {$0$};
    \draw[very thick] plot[domain=0.25:4.2, samples=50] (\x,{2.55-1.9*exp(-0.9*\x)});
  \end{scope}
\end{tikzpicture}
