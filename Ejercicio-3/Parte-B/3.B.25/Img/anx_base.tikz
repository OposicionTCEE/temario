% Figura (Anexo I, «Base»): convergencia del precio del futuro al del subyacente y base al cerrar la cobertura.
% Trayectorias ilustrativas en contango (F_t > S_t), que se igualan en T. En t_1 < T la base es b_{t_1} = S_{t_1} - F_{t_1}.
% Generar con: bash Code/generar_figura.sh anx_base
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  \begin{scope}[x=1.35cm, y=1.1cm]
    \draw[->] (0,0) -- (6.6,0) node[below] {$t$};
    \draw[->] (0,0) -- (0,3.0);
    \draw[very thick, dashed] plot[smooth] coordinates {(0,1.5) (1,1.8) (2,1.4) (3,2.0) (4,1.7) (5,2.2) (6,2.4)};
    \draw[very thick] plot[smooth] coordinates {(0,2.3) (1,2.5) (2,2.05) (3,2.5) (4,2.08) (5,2.38) (6,2.4)};
    \fill (6,2.4) circle (1.6pt);
    \node[anchor=east] at (0,2.3) {$F_0$};
    \node[anchor=east] at (0,1.5) {$S_0$};
    \node[anchor=west] at (6.05,2.4) {$F_T=S_T$};
    \node[anchor=south] at (1,2.55) {$F_t$};
    \node[anchor=north] at (1,1.75) {$S_t$};
    \draw[dotted] (4,0) -- (4,2.08);
    \node[below] at (4,0) {$t_1$};
    \node[below] at (6,0) {$T$};
    \node[below] at (0,0) {$0$};
    \draw[<->, thick] (4.15,1.7) -- (4.15,2.08);
    \node[anchor=west] at (4.2,1.89) {$b_{t_1}$};
  \end{scope}
\end{tikzpicture}
