% Figura (cuerpo, 2.6 «Coberturas Colectivas»): lo que se espera y lo que sucede cuando muchos se cubren en el mismo
% sentido. (a) Lo que supone la réplica: las coberturas no mueven el precio, y una caída inicial se queda en eso. (b) Lo que
% sucede si todas venden cuando el precio cae (gamma negativa, seguro de carteras): cada venta empuja el precio hacia abajo
% y obliga a vender más, y la caída se amplifica. Caminos ilustrativos, sin valores. Generar con: bash Code/generar_figura.sh b2_coberturas
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=0.95cm, y=0.95cm]
  % ---------------- (a) Lo que se espera ----------------
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (2.8,3.55) {(a) Lo que se espera};
    \draw[->] (0,0) -- (5.9,0) node[below] {$t$};
    \draw[->] (0,0) -- (0,3.2) node[left] {precio};
    \draw[very thick] (0.2,2.7) -- (1.5,2.7) -- (1.7,2.1) -- (5.5,2.1);
    \draw[decorate, decoration={brace, amplitude=3pt}] (1.85,2.7) -- (1.85,2.1);
    \node[anchor=west] at (2.0,2.45) {caída inicial};
    \node[align=center] at (2.8,-0.85) {las coberturas no mueven el precio\\$\Rightarrow$ la caída se queda en la inicial};
  \end{scope}
  % ---------------- (b) Lo que sucede ----------------
  \begin{scope}[xshift=7.6cm]
    \node[font=\footnotesize\bfseries] at (2.8,3.55) {(b) Lo que sucede};
    \draw[->] (0,0) -- (5.9,0) node[below] {$t$};
    \draw[->] (0,0) -- (0,3.2) node[left] {precio};
    \draw[very thick] (0.2,2.7) -- (1.5,2.7) -- (1.7,2.1) -- (2.3,2.1) -- (2.5,1.55) -- (3.1,1.55) -- (3.3,1.05) -- (3.9,1.05) -- (4.1,0.6) -- (5.5,0.6);
    \draw[dashed] (1.7,2.1) -- (5.5,2.1);
    \node[anchor=west, black!60] at (3.5,2.3) {sin coberturas};
    \draw[->, gray] (2.45,2.25) to[out=60, in=180] (2.95,2.75);
    \node[anchor=west, align=left] at (2.95,2.85) {las coberturas venden};
    \node[anchor=north west, align=left] at (4.1,0.55) {cada venta\\provoca la siguiente};
    \node[align=center] at (2.8,-0.85) {todas venden a la vez cuando el precio cae\\$\Rightarrow$ la caída se amplifica};
  \end{scope}
\end{tikzpicture}
