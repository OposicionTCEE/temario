% Figura (Anexo II, «Riesgo de contraparte»): exposición esperada positiva EE(t) a lo largo de la vida del contrato.
% (a) Swap de tipos de interés: crece con la incertidumbre acumulada y cae porque quedan menos pagos (forma de joroba):
%     EE(t) proporcional a sqrt(t) (T - t). (b) Swap de divisas: crece hasta el vencimiento por el intercambio final de
%     nominales, expuesto a todo el movimiento acumulado del tipo de cambio: EE(t) proporcional a sqrt(t).
% Generar con: bash Code/generar_figura.sh anx_exposicion
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  % ---------------- (a) IRS ----------------
  \begin{scope}[x=1.1cm, y=1.0cm]
    \node[font=\footnotesize\bfseries] at (2.3,2.75) {(a) Swap de tipos de interés};
    \draw[->] (0,0) -- (4.8,0) node[below] {$t$};
    \draw[->] (0,0) -- (0,2.4) node[left] {$EE(t)$};
    \draw[very thick] plot[domain=0:4.2, samples=60] (\x,{0.62*sqrt(\x)*(4.2-\x)});
    \node[below] at (4.2,0) {$T$};
    \node[below] at (0,0) {$0$};
  \end{scope}
  % ---------------- (b) CCS ----------------
  \begin{scope}[xshift=8.2cm, x=1.1cm, y=1.0cm]
    \node[font=\footnotesize\bfseries] at (2.3,2.75) {(b) Swap de divisas};
    \draw[->] (0,0) -- (4.8,0) node[below] {$t$};
    \draw[->] (0,0) -- (0,2.4) node[left] {$EE(t)$};
    \draw[very thick] plot[domain=0:4.2, samples=60] (\x,{1.0*sqrt(\x)});
    \node[below] at (4.2,0) {$T$};
    \node[below] at (0,0) {$0$};
  \end{scope}
\end{tikzpicture}
