% Figura (cuerpo, 2.3 «Valor»): cómo actúan los demás datos sobre la distribución del precio al vencimiento. (a) El precio
% del subyacente, el tipo sin riesgo y el rendimiento del subyacente la desplazan: si sube S_0 o r_f, o baja delta, pasa de
% la continua a la discontinua y queda más probabilidad por encima de K. (b) El precio de ejercicio no la mueve: mueve el
% umbral, y si sube de K a K', la probabilidad entre los dos (sombreada) deja de pagar en la call y empieza a pagar en la
% put. Lognormales ilustrativas (sigma raíz de T = 0,3). Generar con: bash Code/generar_figura.sh b2_datos
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1.35cm, y=1.6cm,
    declare function={lgC(\s)=exp(-(ln(\s)-0.40)^2/(2*0.3^2))/(\s*0.3*2.5066);
                      lgD(\s)=exp(-(ln(\s)-0.62)^2/(2*0.3^2))/(\s*0.3*2.5066);}]
  % ---------------- (a) Desplazar la distribución ----------------
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (2.2,1.42) {(a) Desplazar la distribución};
    \draw[thick, domain=0.45:4.4, samples=90] plot (\x,{lgC(\x)});
    \draw[thick, dashed, domain=0.6:4.4, samples=90] plot (\x,{lgD(\x)});
    \draw[->] (1.2,1.14) -- (1.75,1.14);
    \node[anchor=west, align=left] at (2.35,1.05) {suben $S_0$ o $r_f$,\\o baja $\delta$};
    \draw[->] (0,0) -- (4.65,0) node[below] {$S_T$};
    \draw (2.4,0.04) -- (2.4,-0.04) node[below] {$K$};
    \node[align=center] at (2.2,-0.62) {más probabilidad por encima de $K$\\$\Rightarrow$ la \textit{call} vale más y la \textit{put} menos};
  \end{scope}
  % ---------------- (b) Mover el umbral ----------------
  \begin{scope}[xshift=7.4cm]
    \node[font=\footnotesize\bfseries] at (2.2,1.42) {(b) Mover el umbral};
    \fill[black!18] plot[domain=1.9:2.6, samples=30] (\x,{lgC(\x)}) -- (2.6,0) -- (1.9,0) -- cycle;
    \draw[thick, domain=0.45:4.4, samples=90] plot (\x,{lgC(\x)});
    \draw[->] (0,0) -- (4.65,0) node[below] {$S_T$};
    \draw (1.9,0.04) -- (1.9,-0.04) node[below] {$K$};
    \draw (2.6,0.04) -- (2.6,-0.04) node[below] {$K'$};
    \draw[->] (1.95,0.92) -- (2.55,0.92);
    \node[anchor=south] at (2.25,0.95) {$K$ sube};
    \node[align=center] at (2.2,-0.62) {menos probabilidad por encima del umbral\\$\Rightarrow$ la \textit{call} vale menos y la \textit{put} más};
  \end{scope}
\end{tikzpicture}
