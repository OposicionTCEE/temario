% Figura (Anexo II, «Varios periodos»): (a) árbol binomial de dos periodos que se recombina (una subida y una bajada llevan al
% mismo precio, S_0 ud); la opción se valora hacia atrás, nodo a nodo, con la fórmula de un periodo. (b) Convergencia: precio
% binomial de una call con n periodos, u = e^{sigma raíz de Delta t} y d = 1/u (COX, ROSS y RUBINSTEIN, 1979), frente al
% precio de BLACK-SCHOLES; oscila según n sea par o impar y se acerca a él. Valores calculados con S_0 = K = 100, r = 5 %,
% sigma = 20 % y T = 1 (c_BS = 10,45); eje vertical desplazado (c_n - 9,3).
% Generar con: bash Code/generar_figura.sh anx_arbol
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  % ---------------- (a) Árbol de dos periodos ----------------
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (2.0,2.75) {(a) Árbol de dos periodos};
    \coordinate (A) at (0,0); \coordinate (U) at (2.0,0.9); \coordinate (D) at (2.0,-0.9);
    \coordinate (UU) at (4.0,1.8); \coordinate (UD) at (4.0,0); \coordinate (DD) at (4.0,-1.8);
    \draw[thick] (A) -- (U) -- (UU); \draw[thick] (A) -- (D) -- (DD);
    \draw[thick] (U) -- (UD) -- (D);
    \foreach \p in {A,U,D,UU,UD,DD} \fill (\p) circle (1.8pt);
    \node[above=2pt] at (A) {$S_0$}; \node[below=2pt] at (A) {$f$};
    \node[above=2pt] at (U) {$S_0u$}; \node[below=2pt] at (U) {$f_u$};
    \node[above=2pt] at (D) {$S_0d$}; \node[below=2pt] at (D) {$f_d$};
    \node[anchor=west] at (UU) {\,$S_0u^2,\ f_{uu}$};
    \node[anchor=west] at (UD) {\,$S_0ud,\ f_{ud}$};
    \node[anchor=west] at (DD) {\,$S_0d^2,\ f_{dd}$};
    \draw[<-] (0,-2.35) -- (4.0,-2.35);
    \node at (2.0,-2.8) {$f_u=e^{-r_f\tau}\left[q\,f_{uu}+(1-q)\,f_{ud}\right]$};
  \end{scope}
  % ---------------- (b) Convergencia ----------------
  \begin{scope}[xshift=7.7cm, yshift=-1.6cm, x=0.1cm, y=1.0cm]
    \node[font=\footnotesize\bfseries] at (32,4.35) {(b) Convergencia};
    \draw[->] (0,0) -- (66,0) node[below] {$n$};
    \draw[->] (0,0) -- (0,3.2) node[left] {$c_n$};
    \foreach \n in {10,20,30,40,50,60} { \draw (\n,0.06) -- (\n,-0.06); \node[below] at (\n,-0.04) {\n}; }
    \draw[dashed] (0,1.1506) -- (62,1.1506) node[right] {$c_{BS}$};
    \draw[black!60] plot coordinates {(1,2.862) (2,0.241) (3,1.744) (4,0.671) (5,1.506) (6,0.826) (7,1.404) (8,0.905) (9,1.347) (10,0.953) (11,1.311) (12,0.986) (13,1.286) (14,1.009) (15,1.268) (16,1.027) (17,1.254) (18,1.040) (19,1.243) (20,1.051) (21,1.234) (22,1.060) (23,1.227) (24,1.068) (25,1.221) (26,1.074) (27,1.216) (28,1.080) (29,1.211) (30,1.084) (31,1.207) (32,1.088) (33,1.204) (34,1.092) (35,1.201) (36,1.095) (37,1.198) (38,1.098) (39,1.196) (40,1.101) (41,1.193) (42,1.103) (43,1.191) (44,1.105) (45,1.190) (46,1.107) (47,1.188) (48,1.109) (49,1.186) (50,1.111) (51,1.185) (52,1.112) (53,1.184) (54,1.114) (55,1.183) (56,1.115) (57,1.181) (58,1.116) (59,1.180) (60,1.117)};
