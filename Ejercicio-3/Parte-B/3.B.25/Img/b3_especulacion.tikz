% Figura (cuerpo, 3.2 «Especulación»): la especulación que estabiliza y la que desestabiliza. (a) FRIEDMAN (1953): el
% especulador compra cuando el precio está por debajo de su valor y vende cuando está por encima, y las oscilaciones se
% reducen. (b) DE LONG, SHLEIFER, SUMMERS y WALDMANN (1990): si hay inversores que compran después de las subidas, al
% especulador racional le conviene comprar antes, y el precio se aleja más de su valor. Discontinua: el valor; punteada: el
% precio sin especuladores; continua: con ellos. Caminos ilustrativos. Generar con: bash Code/generar_figura.sh b3_especulacion
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=0.95cm, y=0.95cm]
  % ---------------- (a) Estabiliza ----------------
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (2.9,3.55) {(a) Especulación que estabiliza};
    \draw[->] (0,0) -- (6.0,0) node[below] {$t$};
    \draw[->] (0,0) -- (0,3.2) node[left] {precio};
    \draw[dashed] (0.1,1.6) -- (5.7,1.6) node[right] {valor};
    \draw[thick, dotted, domain=0.1:5.7, samples=80] plot (\x,{1.6+1.05*sin(deg(1.9*\x))});
    \draw[very thick, domain=0.1:5.7, samples=80] plot (\x,{1.6+0.38*sin(deg(1.9*\x))});
    \node[align=center] at (2.9,-0.85) {compra barato y vende caro\\$\Rightarrow$ acerca el precio a su valor};
  \end{scope}
  % ---------------- (b) Desestabiliza ----------------
  \begin{scope}[xshift=7.7cm]
    \node[font=\footnotesize\bfseries] at (2.9,3.55) {(b) Especulación que desestabiliza};
    \draw[->] (0,0) -- (6.0,0) node[below] {$t$};
    \draw[->] (0,0) -- (0,3.2) node[left] {precio};
    \draw[dashed] (0.1,1.0) -- (5.7,1.0) node[right] {valor};
    \draw[thick, dotted] plot[smooth] coordinates {(0.1,1.0) (1.2,1.05) (2.4,1.6) (3.4,2.0) (4.4,1.6) (5.6,1.15)};
    \draw[very thick] plot[smooth] coordinates {(0.1,1.0) (1.0,1.5) (2.1,2.45) (3.0,2.85) (3.9,2.0) (4.8,1.25) (5.6,1.05)};
    \node[anchor=south east, align=right] at (2.0,2.55) {compra\\antes};
    \node[align=center] at (2.9,-0.85) {compra antes de las subidas\\$\Rightarrow$ aleja el precio de su valor};
  \end{scope}
\end{tikzpicture}
