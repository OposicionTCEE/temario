% Figura (cuerpo, 2.6 «Mercado Incompleto»): lo que supone BLACK-SCHOLES-MERTON y lo que se observa. (a) Distribución de la
% rentabilidad: la normal que supone el modelo (discontinua) y una observada con la misma media y varianza (continua; mezcla
% ilustrativa 0,8 N(0,1; 0,75^2) + 0,2 N(-0,4; 1,7^2)): más concentrada en el centro y con colas más gruesas, sobre todo la de
% las caídas. (b) Volatilidad implícita según el precio de ejercicio: plana en el modelo; decreciente en las opciones sobre
% índices bursátiles (sesgo) y en forma de U en las de divisas (sonrisa). Formas ilustrativas.
% Generar con: bash Code/generar_figura.sh b2_supuesto
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]},
    declare function={nn(\x,\m,\s)=exp(-((\x-\m)^2)/(2*\s*\s))/(\s*2.5066);
                      obs(\x)=0.8*nn(\x,0.1,0.75)+0.2*nn(\x,-0.4,1.7);}]
  % ---------------- (a) Distribución ----------------
  \begin{scope}[x=0.68cm, y=5.2cm]
    \node[font=\footnotesize\bfseries] at (0,0.82) {(a) La rentabilidad};
    \draw[very thick, domain=-4:4, samples=90] plot (\x,{obs(\x)});
    \draw[thick, dashed, domain=-4:4, samples=90] plot (\x,{nn(\x,0,1.033)});
    \draw[->] (-4.3,0) -- (4.5,0) node[below] {rentabilidad};
    \draw[gray] (-2.9,0.03) -- (-3.3,0.17);
    \node[anchor=south, align=center] at (-3.3,0.16) {más caídas\\extremas};
    \node[anchor=west] at (1.25,0.45) {observada};
    \draw[gray] (1.3,0.45) -- (0.62,0.43);
    \node[anchor=west] at (1.6,0.28) {supuesta: normal};
    \draw[gray] (1.65,0.28) -- (1.15,0.21);
    \node[align=center] at (0,-0.12) {colas más gruesas que la normal $\Rightarrow$\\más movimientos extremos de los supuestos};
  \end{scope}
  % ---------------- (b) Volatilidad implícita ----------------
  \begin{scope}[xshift=6.9cm, x=1.0cm, y=1.15cm]
    \node[font=\footnotesize\bfseries] at (2.3,3.7) {(b) La volatilidad implícita};
    \draw[->] (0,0) -- (4.9,0) node[below] {$K$};
    \draw[->] (0,0) -- (0,2.9) node[above] {volatilidad implícita};
    \draw[thick, dashed] (0.3,1.2) -- (4.4,1.2) node[right] {modelo};
    \draw[very thick] plot[smooth] coordinates {(0.3,2.45) (1.2,1.85) (2.2,1.35) (3.3,1.05) (4.4,0.95)} node[right] {acciones};
    \draw[very thick, dotted] plot[smooth] coordinates {(0.3,2.1) (1.2,1.55) (2.3,1.35) (3.4,1.55) (4.4,2.1)} node[right] {divisas};
    \node[align=center] at (2.3,-0.9) {plana en el modelo; sesgo en las acciones\\y sonrisa en las divisas};
  \end{scope}
\end{tikzpicture}
