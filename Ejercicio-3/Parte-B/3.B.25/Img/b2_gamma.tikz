% Figura (cuerpo, 2.4 «Gamma y Theta»): el resultado de cubrir la delta de una opción durante un intervalo corto, según lo
% que se mueva el precio. (a) Quien tiene la opción, con gamma positiva, pierde la theta si el precio se mueve poco y gana
% con los movimientos grandes, en cualquier sentido. (b) Quien la ha vendido, con gamma negativa, al revés. Las dos curvas
% cruzan el cero en el movimiento que supone la volatilidad con que se valoró la opción: el resultado es
% 1/2 Gamma S^2 [(dS/S)^2 - sigma^2 dt] para quien la tiene. Parábolas ilustrativas. Generar con: bash Code/generar_figura.sh b2_gamma
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1.2cm, y=1.1cm]
  % ---------------- (a) Gamma positiva ----------------
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (0,2.35) {(a) Gamma positiva: quien tiene la opción};
    \draw[->] (-2.5,0) -- (2.6,0);
    \node[anchor=north, align=center] at (2.35,-0.08) {movimiento\\del precio};
    \draw[->] (-2.5,-1.0) -- (-2.5,1.85) node[above] {resultado};
    \draw (0,0.06) -- (0,-0.06);
    \node[below] at (0,-0.05) {$0$};
    \draw[very thick, domain=-2.1:2.1, samples=50] plot (\x,{0.4*\x*\x-0.4});
    \draw[decorate, decoration={brace, amplitude=3pt}] (-1,0.12) -- (1,0.12);
    \node[above] at (0,0.22) {lo que supone $\sigma$};
    \node[below] at (0,-0.48) {pierde la theta};
    \node at (0,1.35) {gana por la gamma};
    \node[align=center] at (0,-1.55) {gana si el precio se mueve más\\de lo que supone $\sigma$};
  \end{scope}
  % ---------------- (b) Gamma negativa ----------------
  \begin{scope}[xshift=7.6cm]
    \node[font=\footnotesize\bfseries] at (0,2.35) {(b) Gamma negativa: quien la ha vendido};
    \draw[->] (-2.5,0) -- (2.6,0);
    \node[anchor=north, align=center] at (2.35,-0.08) {movimiento\\del precio};
    \draw[->] (-2.5,-1.85) -- (-2.5,1.0) node[above] {resultado};
    \draw (0,0.06) -- (0,-0.06);
    \draw[very thick, domain=-2.1:2.1, samples=50] plot (\x,{0.4-0.4*\x*\x});
    \draw[decorate, decoration={brace, amplitude=3pt, mirror}] (-1,-0.12) -- (1,-0.12);
    \node[below] at (0,-0.22) {lo que supone $\sigma$};
    \node[above] at (0,0.46) {gana la theta};
    \node at (0,-1.35) {pierde por la gamma};
    \node[align=center] at (0,-2.4) {gana si se mueve menos y pierde con los\\movimientos grandes, en cualquier sentido};
  \end{scope}
\end{tikzpicture}
