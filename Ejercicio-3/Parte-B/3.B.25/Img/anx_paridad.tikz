% Figura (Anexo II, «Paridad cubierta»): dos formas de convertir un euro de hoy en euros en T. Por la izquierda, depósito
% en euros al tipo r; por arriba, abajo y a la derecha, cambio a dólares al contado (S = euros por dólar), depósito en
% dólares al tipo r* y venta a plazo de los dólares al tipo F. Sin arbitraje, las dos dan lo mismo: F = S_0 e^{(r-r*)T}.
% Generar con: bash Code/generar_figura.sh anx_paridad
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]},
    caja/.style={draw, rounded corners=2pt, minimum width=2.9cm, minimum height=0.9cm, align=center}]
  \node[caja] (E0) at (0,2.6) {$1$\,€ en $0$};
  \node[caja] (D0) at (7.0,2.6) {$1/S_0$\,\$ en $0$};
  \node[caja] (DT) at (7.0,0) {$e^{r_f^*T}/S_0$\,\$ en $T$};
  \node[caja] (ET) at (0,0) {€ en $T$};
  \draw[->, thick] (E0) -- node[above] {$\div S_0$} (D0);
  \draw[->, thick] (D0) -- node[right] {$\times\,e^{r_f^*T}$} (DT);
  \draw[->, thick] (DT) -- node[below] {$\times\,F$} (ET);
  \draw[->, thick] (E0) -- node[left] {$\times\,e^{r_fT}$} (ET);
  \node[align=center] at (3.5,1.3) {$e^{r_fT}=\dfrac{F\,e^{r_f^*T}}{S_0}$};
\end{tikzpicture}
