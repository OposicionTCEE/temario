% Figura (cuerpo, 1.2 «Motivos»): por qué la liquidación diaria permite una garantía pequeña. El mismo camino del precio a
% plazo, F_t, que cae de F_0 a F_T. (a) En el contrato a plazo, la pérdida de la parte larga se acumula hasta el vencimiento y
% la garantía tendría que cubrir toda la caída. (b) En el futuro, la caída se paga cada día (trazos gruesos), y la garantía
% inicial solo tiene que cubrir la pérdida de un día. Camino ilustrativo, sin valores. Generar con: bash Code/generar_figura.sh b1_garantia
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=0.8cm, y=0.85cm]
  % ---------------- (a) Contrato a plazo ----------------
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (3.2,4.5) {(a) Contrato a plazo};
    \draw[->] (0,0) -- (6.8,0) node[below] {$t$};
    \draw[->] (0,0) -- (0,4.1) node[left] {$F_t$};
    \draw[thick] plot coordinates {(0,3.4) (0.5,3.1) (1,3.25) (1.5,2.9) (2,2.6) (2.5,2.75) (3,2.4) (3.5,2.1) (4,2.25) (4.5,1.9) (5,1.6) (5.5,1.45) (6,1.2)};
    \draw[dashed] (0,3.4) -- (6,3.4);
    \node[left] at (0,3.4) {$F_0$};
    \draw[dotted] (6,0) -- (6,1.2);
    \node[below] at (6,0) {$T$};
    \draw[decorate, decoration={brace, amplitude=4pt}] (6.12,3.4) -- (6.12,1.2);
    \node[anchor=west, align=left] at (6.3,2.3) {pérdida\\acumulada};
    \node[align=center] at (3.2,-0.95) {se paga en $T$ $\Rightarrow$ la garantía\\debe cubrir toda la caída};
  \end{scope}
  % ---------------- (b) Futuro ----------------
  \begin{scope}[xshift=9.4cm]
    \node[font=\footnotesize\bfseries] at (3.2,4.5) {(b) Futuro};
    \draw[->] (0,0) -- (6.8,0) node[below] {$t$};
    \draw[->] (0,0) -- (0,4.1) node[left] {$F_t$};
    \draw[thin] (0,3.4) -- (0.5,3.4) (0.5,3.1) -- (1,3.1) (1,3.25) -- (1.5,3.25) (1.5,2.9) -- (2,2.9)
      (2,2.6) -- (2.5,2.6) (2.5,2.75) -- (3,2.75) (3,2.4) -- (3.5,2.4) (3.5,2.1) -- (4,2.1)
      (4,2.25) -- (4.5,2.25) (4.5,1.9) -- (5,1.9) (5,1.6) -- (5.5,1.6) (5.5,1.45) -- (6,1.45);
    % pago de cada día: grueso si la parte larga pierde, fino si gana
    \draw[very thick] (0.5,3.4) -- (0.5,3.1) (1.5,3.25) -- (1.5,2.9) (2,2.9) -- (2,2.6) (3,2.75) -- (3,2.4)
      (3.5,2.4) -- (3.5,2.1) (4.5,2.25) -- (4.5,1.9) (5,1.9) -- (5,1.6) (5.5,1.6) -- (5.5,1.45) (6,1.45) -- (6,1.2);
    \draw[thin] (1,3.1) -- (1,3.25) (2.5,2.6) -- (2.5,2.75) (4,2.1) -- (4,2.25);
    \node[left] at (0,3.4) {$F_0$};
    \draw[dotted] (6,0) -- (6,1.2);
    \node[below] at (6,0) {$T$};
    \draw[decorate, decoration={brace, amplitude=2pt}] (4.6,2.25) -- (4.6,1.9);
    \draw[gray] (4.75,2.1) -- (5.3,3.0);
    \node[anchor=south, align=center] at (5.4,2.95) {pérdida de un día,\\pagada ese día};
    \node[align=center] at (3.2,-0.95) {se paga cada día $\Rightarrow$ la garantía\\solo cubre la de un día};
  \end{scope}
\end{tikzpicture}
