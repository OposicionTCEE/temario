% Figura (Anexo III, «Riesgo sistémico»): las dos espirales de liquidez de BRUNNERMEIER y PEDERSEN (2009), que comparten la
% caída de los precios y las ventas forzadas. A la izquierda, la espiral de pérdidas: la caída reduce el capital de quienes
% tienen posiciones financiadas, que deben vender. A la derecha, la espiral de garantías: la caída aumenta la volatilidad,
% se exigen más garantías y la financiación disponible se reduce. Diseño propio.
% Generar con: bash Code/generar_figura.sh anx_espiral
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=5pt]},
    caja/.style={draw, rounded corners=2pt, text width=2.7cm, align=flush center, minimum height=0.85cm},
    eje/.style={draw, rounded corners=2pt, text width=2.7cm, align=flush center, minimum height=0.85cm, fill=black!12}]
  \node[eje] (P) at (0,2.1) {Caída de los precios};
  \node[eje] (V) at (0,-2.1) {Ventas forzadas};
  \node[caja] (L1) at (-3.6,0.85) {Pérdidas en las posiciones};
  \node[caja] (L2) at (-3.6,-0.85) {Menos capital de los intermediarios};
  \node[caja] (R1) at (3.6,0.85) {Más volatilidad};
  \node[caja] (R2) at (3.6,-0.85) {Más garantías exigidas};
  \draw[->, thick] (P.west) to[out=180, in=90] (L1.north);
  \draw[->, thick] (L1) -- (L2);
  \draw[->, thick] (L2.south) to[out=-90, in=180] (V.west);
  \draw[->, thick] (P.east) to[out=0, in=90] (R1.north);
  \draw[->, thick] (R1) -- (R2);
  \draw[->, thick] (R2.south) to[out=-90, in=0] (V.east);
  \draw[->, very thick] (V) -- (P);
  \node[font=\footnotesize\itshape, align=center] at (-1.55,0) {espiral de\\pérdidas};
  \node[font=\footnotesize\itshape, align=center] at (1.55,0) {espiral de\\garantías};
\end{tikzpicture}
