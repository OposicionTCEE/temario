% Figura (Anexo II, «Opciones americanas»): (a) precio de una put americana, P (continua), y de una europea, p (discontinua),
% frente al valor intrínseco, K - S_0 (fina). La americana nunca vale menos que su valor intrínseco y coincide con él por debajo
% de S^*, donde conviene ejercerla; la europea puede quedar por debajo. Valores calculados con un árbol de 300 periodos y con
% BLACK-SCHOLES: K = 100, r = 10 %, sigma = 25 %, T = 1, escalados (K = 2). (b) Frontera de ejercicio S^*(t): por debajo
% conviene ejercer y por encima esperar; sube hasta K al vencimiento. Forma estilizada, ajustada a la del mismo árbol:
% S^*(t) = K [1 - 0,19 ((T - t)/T)^{0,25}].
% Generar con: bash Code/generar_figura.sh anx_frontera
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  % ---------------- (a) Put americana y europea ----------------
  \begin{scope}[x=0.95cm, y=1.0cm]
    \node[font=\footnotesize\bfseries] at (2.0,2.75) {(a) Put americana y europea};
    \draw[->] (0,0) -- (4.3,0) node[below] {$S_0$};
    \draw[->] (0,0) -- (0,2.4);
    \draw (0,2) -- (2,0);
    \draw[very thick] (0,2) -- (1.63,0.37) plot[smooth] coordinates {(1.63,0.370) (1.70,0.307) (1.80,0.233) (1.90,0.175) (2.00,0.131) (2.10,0.097) (2.20,0.072) (2.40,0.038) (2.60,0.020) (2.80,0.010) (3.00,0.005) (3.40,0.001) (4.00,0.000)};
    \draw[thick, dashed] plot[smooth] coordinates {(0,1.810) (0.20,1.610) (0.40,1.410) (0.60,1.210) (0.80,1.010) (1.00,0.811) (1.20,0.617) (1.40,0.441) (1.60,0.294) (1.80,0.184) (2.00,0.109) (2.20,0.062) (2.40,0.034) (2.60,0.018) (2.80,0.009) (3.00,0.005) (3.40,0.001) (4.00,0.000)};
    \draw[dotted] (1.63,0.37) -- (1.63,0);
    \node[anchor=north] at (1.63,0) {$S^*$};
    \node[anchor=north west, inner xsep=1pt] at (2,0) {$K$};
    \node[anchor=east] at (0,2) {$K$};
    \node[anchor=south west] at (1.05,0.97) {$P$};
    \node[anchor=north east] at (0.95,0.78) {$p$};
  \end{scope}
  % ---------------- (b) Frontera de ejercicio ----------------
  \begin{scope}[xshift=7.4cm, x=1.0cm, y=1.2cm]
    \node[font=\footnotesize\bfseries] at (1.8,2.29) {(b) Frontera de ejercicio};
    \fill[black!12] (0,0) -- plot[domain=0:3.59, samples=60] (\x,{2*(1-0.19*((3.6-\x)/3.6)^0.25)}) -- (3.6,2) -- (3.6,0) -- cycle;
    \draw[->] (0,0) -- (4.0,0) node[below] {$t$};
    \draw[->] (0,0) -- (0,2.0*1.0+0.0) -- (0,2.05);
    \draw[very thick] plot[domain=0:3.59, samples=60] (\x,{2*(1-0.19*((3.6-\x)/3.6)^0.25)}) -- (3.6,2);
    \draw[dotted] (0,2) -- (3.6,2);
    \draw[dotted] (3.6,0) -- (3.6,2);
    \node[anchor=east] at (0,2) {$K$};
    \node[below] at (0,0) {$0$};
    \node[below] at (3.6,0) {$T$};
    \node at (1.3,1.84) {$S^*(t)$};
    \node at (1.6,0.75) {ejercer};
    \node at (2.6,2.0) [above=2pt] {esperar};
  \end{scope}
\end{tikzpicture}
