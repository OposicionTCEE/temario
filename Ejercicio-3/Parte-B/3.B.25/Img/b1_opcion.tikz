% Figura (cuerpo, 1.3 «Juego»): resultado al vencimiento, neto de la prima p, del comprador (continua) y del vendedor
% (discontinua) de una opción con precio de ejercicio K. (a) Call: el comprador pierde como mucho p y gana sin límite a partir
% de K + p. (b) Put: el comprador gana como mucho K - p, porque el subyacente no baja de cero. Se ignoran los intereses de la
% prima. Escala: K = 2, p = 0,5; x = 1,15 cm, y = 0,78 cm. Valores ilustrativos.
% Generar con: bash Code/generar_figura.sh b1_opcion
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1.15cm, y=0.78cm]
  % ---------------- (a) Call ----------------
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (2.1,2.6) {(a) \textit{Call}};
    \draw[->] (0,0) -- (4.5,0) node[below] {$S_T$};
    \draw[->] (0,-2.0) -- (0,2.2);
    \draw[very thick] (0,-0.5) -- (2,-0.5) -- (3.9,1.4) node[right] {comprador};
    \draw[very thick, dashed] (0,0.5) -- (2,0.5) -- (3.9,-1.4) node[right] {vendedor};
    \draw (2,0.1) -- (2,-0.1);
    \node[above] at (2,0.5) {$K$};
    \draw[dotted] (2,0) -- (2,0.5);
    \draw (2.5,0.1) -- (2.5,-0.1);
    \node[below right] at (2.4,0) {$K+p$};
    \draw (0.06,0.5) -- (-0.06,0.5) node[left] {$p$};
    \draw (0.06,-0.5) -- (-0.06,-0.5) node[left] {$-p$};
  \end{scope}
  % ---------------- (b) Put ----------------
  \begin{scope}[xshift=7.6cm]
    \node[font=\footnotesize\bfseries] at (2.1,2.6) {(b) \textit{Put}};
    \draw[->] (0,0) -- (4.5,0) node[below] {$S_T$};
    \draw[->] (0,-2.0) -- (0,2.2);
    \draw[very thick] (0,1.5) -- (2,-0.5) -- (3.9,-0.5) node[right] {comprador};
    \draw[very thick, dashed] (0,-1.5) -- (2,0.5) -- (3.9,0.5) node[right] {vendedor};
    \draw (2,0.1) -- (2,-0.1);
    \node[above] at (2,0.5) {$K$};
    \draw[dotted] (2,0) -- (2,0.5);
    \draw (1.5,0.1) -- (1.5,-0.1);
    \node[below left] at (1.6,0) {$K-p$};
    \draw (0.06,1.5) -- (-0.06,1.5) node[left] {$K-p$};
    \draw (0.06,-1.5) -- (-0.06,-1.5) node[left] {$-(K-p)$};
  \end{scope}
\end{tikzpicture}
