% Figura (Anexo I, «Historia»): cronología de los derivados en dos columnas, contratos bilaterales a medida (izquierda)
% y mercados organizados con contratos normalizados (derecha). El eje central es el tiempo (orden, no escala).
% Generar con: bash Code/generar_figura.sh anx_cronologia
\begin{tikzpicture}[font=\scriptsize,
    anno/.style={fill=white, draw=black!45, rounded corners=1pt, inner sep=1.6pt, minimum width=2.05cm, font=\scriptsize\bfseries},
    izq/.style={anchor=east, text width=6.25cm, align=flush right, inner sep=1pt},
    der/.style={anchor=west, text width=6.25cm, align=flush left, inner sep=1pt}]
  \def\dy{0.74}
  % Cabeceras
  \node[font=\footnotesize\bfseries, anchor=east] at (-1.2,0.75) {Contratos bilaterales, a medida};
  \node[font=\footnotesize\bfseries, anchor=west] at (1.2,0.75) {Mercados organizados, normalizados};
  \draw[black!35] (-7.6,0.42) -- (7.6,0.42);
  % Eje del tiempo
  \draw[->, thick, black!55] (0,0.3) -- (0,-15*\dy-0.45);
  % Filas
  \node[anno] at (0,0) {c. 600 a. C.};
  \node[izq] at (-1.2,0) {TALES de Mileto: derecho de uso de las prensas de aceite};
  \node[anno] at (0,-1*\dy) {Siglos XIII-XVI};
  \node[izq] at (-1.2,-1*\dy) {Letra de cambio: préstamo y cambio de moneda a plazo};
  \node[anno] at (0,-2*\dy) {1609-1610};
  \node[izq] at (-1.2,-2*\dy) {Ámsterdam: acciones de la VOC a plazo; primera prohibición};
  \node[anno] at (0,-3*\dy) {1637};
  \node[izq] at (-1.2,-3*\dy) {Tulipanes: contratos a plazo convertidos en opciones};
  \node[anno] at (0,-4*\dy) {1688};
  \node[izq] at (-1.2,-4*\dy) {DE LA VEGA, \textit{Confusión de confusiones}: opciones de compra y de venta};
  \node[anno] at (0,-5*\dy) {1730};
  \node[der] at (1.2,-5*\dy) {Dōjima (Osaka): futuros de arroz liquidados por diferencias};
  \node[anno] at (0,-6*\dy) {1865};
  \node[der] at (1.2,-6*\dy) {Chicago (CBOT): futuros normalizados con márgenes};
  \node[anno] at (0,-7*\dy) {1877};
  \node[der] at (1.2,-7*\dy) {Londres (LME): cobre y estaño a tres meses};
  \node[anno] at (0,-8*\dy) {1925};
  \node[der] at (1.2,-8*\dy) {Chicago: cámara de compensación independiente};
  \node[anno] at (0,-9*\dy) {1972-1973};
  \node[der] at (1.2,-9*\dy) {IMM: futuros sobre divisas. CBOE: opciones sobre acciones. BLACK-SCHOLES y MERTON};
  \node[anno] at (0,-10*\dy) {1981};
  \node[izq] at (-1.2,-10*\dy) {Swap de divisas IBM-Banco Mundial};
  \node[der] at (1.2,-10*\dy) {Futuro sobre el eurodólar, sin entrega posible};
  \node[anno] at (0,-11*\dy) {1982-1992};
  \node[der] at (1.2,-11*\dy) {LIFFE, MATIF, DTB. MEFF: futuro sobre el IBEX 35 (1992)};
  \node[anno] at (0,-12*\dy) {1985};
  \node[izq] at (-1.2,-12*\dy) {ISDA y su contrato marco: compensación bilateral};
  \node[anno] at (0,-13*\dy) {1994};
  \node[izq] at (-1.2,-13*\dy) {Primeros swaps de incumplimiento crediticio (CDS)};
  \node[anno] at (0,-14*\dy) {2000};
  \node[izq] at (-1.2,-14*\dy) {Estados Unidos: swaps entre profesionales fuera de la CFTC};
  \node[anno] at (0,-15*\dy) {2008-2009};
  \node[izq] at (-1.2,-15*\dy) {Quiebra de Lehman y rescate de AIG};
  \node[der] at (1.2,-15*\dy) {G20: compensación central obligatoria};
\end{tikzpicture}
