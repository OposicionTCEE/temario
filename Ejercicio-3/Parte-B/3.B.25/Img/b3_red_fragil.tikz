% Figura (cuerpo, 3.4 «Opacidad»): las redes muy conectadas son robustas y frágiles a la vez (ACEMOGLU, OZDAGLAR y
% TAHBAZ-SALEHI, 2015). La misma red completa ante dos golpes en la entidad 1. (a) Golpe pequeño: repartido, cabe en el
% capital de las demás, que lo absorben. (b) Golpe grande: repartido, supera el capital de todas y arrastra a la red entera.
% En gris, las entidades que incumplen. Esquema sin valores. Generar con: bash Code/generar_figura.sh b3_red_fragil
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]},
    ent/.style={draw, circle, minimum size=0.75cm, inner sep=0pt},
    cae/.style={draw, circle, minimum size=0.75cm, inner sep=0pt, fill=black!30}]
  % ---------------- (a) Golpe pequeño ----------------
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (1.5,3.4) {(a) Golpe pequeño};
    \node[cae] (A) at (0,2.4) {$1$};
    \node[ent] (B) at (3,2.4) {$2$};
    \node[ent] (C) at (3,0) {$3$};
    \node[ent] (D) at (0,0) {$4$};
    \draw[->, thick] (A) -- (B); \draw[->, thick] (A) -- (C); \draw[->, thick] (A) -- (D);
    \draw[thin, black!45] (B) -- (C) -- (D) -- (B);
    \node[align=center] at (1.5,-1.2) {repartido, cabe en el capital de cada una\\$\Rightarrow$ la red lo absorbe};
  \end{scope}
  % ---------------- (b) Golpe grande ----------------
  \begin{scope}[xshift=7.6cm]
    \node[font=\footnotesize\bfseries] at (1.5,3.4) {(b) Golpe grande};
    \node[cae] (A) at (0,2.4) {$1$};
    \node[cae] (B) at (3,2.4) {$2$};
    \node[cae] (C) at (3,0) {$3$};
    \node[cae] (D) at (0,0) {$4$};
    \draw[->, very thick] (A) -- (B); \draw[->, very thick] (A) -- (C); \draw[->, very thick] (A) -- (D);
    \draw[thin, black!45] (B) -- (C) -- (D) -- (B);
    \node[align=center] at (1.5,-1.2) {repartido, supera el capital de todas\\$\Rightarrow$ arrastra a la red entera};
  \end{scope}
\end{tikzpicture}
