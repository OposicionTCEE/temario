% Figura (cuerpo, 1.4 «Por qué jugar»): de deuda variable a deuda fija. A tiene un préstamo a tipo variable (paga L + m al
% prestamista) y contrata un swap con B: paga el fijo K y recibe el variable L. Su coste neto queda en K + m, sin tocar el
% préstamo. Adaptada del panel (a) de anx_swap_tipos. Generar con: bash Code/generar_figura.sh b1_swap
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]},
    caja/.style={draw, minimum width=1.7cm, minimum height=0.8cm, inner sep=2pt}]
  \node[caja] (P) at (0,0) {Prestamista};
  \node[caja] (A) at (3.6,0) {$A$};
  \node[caja] (B) at (7.2,0) {$B$};
  \draw[->, thick] (A.west) -- node[above] {$L+m$} (P.east);
  \draw[->, thick] ([yshift=5pt]A.east) -- node[above] {$K$} ([yshift=5pt]B.west);
  \draw[->, thick] ([yshift=-5pt]B.west) -- node[below] {$L$} ([yshift=-5pt]A.east);
  \node at (3.6,-1.1) {$(L+m)+K-L=K+m$};
\end{tikzpicture}
