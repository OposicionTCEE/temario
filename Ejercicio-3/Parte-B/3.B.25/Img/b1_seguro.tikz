% Figura (cuerpo, 1.1 «Subyacente»): lo que paga un seguro y lo que paga un derivado frente a la pérdida propia de quien
% los contrata. (a) El seguro paga exactamente la pérdida: los puntos caen sobre la diagonal. (b) El derivado paga una
% función del subyacente, que se mueve con la pérdida sin igualarla: los puntos quedan en torno a la diagonal, y la
% distancia es el riesgo de base. Puntos ilustrativos, sin datos. Generar con: bash Code/generar_figura.sh b1_seguro
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1cm, y=1cm]
  % ---------------- (a) Seguro ----------------
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (2.1,4.6) {(a) Seguro};
    \draw[->] (0,0) -- (4.4,0) node[below left] {pérdida propia};
    \draw[->] (0,0) -- (0,4.2) node[left] {pago};
    \draw[gray] (0,0) -- (3.9,3.9);
    \foreach \x in {0.5,0.9,1.3,1.7,2.1,2.5,2.9,3.3,3.7}
      \fill (\x,\x) circle (1.6pt);
    \node[align=center] at (2.1,-1.05) {pago $=$ pérdida propia\\depende de la conducta del asegurado\\$\Rightarrow$ interés asegurable y vigilancia};
  \end{scope}
  % ---------------- (b) Derivado ----------------
  \begin{scope}[xshift=7.2cm]
    \node[font=\footnotesize\bfseries] at (2.1,4.6) {(b) Derivado};
    \draw[->] (0,0) -- (4.4,0) node[below left] {pérdida propia};
    \draw[->] (0,0) -- (0,4.2) node[left] {pago};
    \draw[gray] (0,0) -- (3.9,3.9);
    \foreach \x/\y in {0.5/0.95, 0.9/0.45, 1.3/1.75, 1.7/1.15, 2.1/2.6, 2.5/1.95, 2.9/3.35, 3.3/2.7, 3.7/3.95}
      \fill (\x,\y) circle (1.6pt);
    \draw[decorate, decoration={brace, amplitude=3pt}] (2.62,2.5) -- (2.62,1.95)
      node[midway, right=4pt] {riesgo de base};
    \node[align=center] at (2.1,-1.05) {pago $=f(S_T)\neq$ pérdida propia\\nadie controla $S_T$\\$\Rightarrow$ anónimo y negociable};
  \end{scope}
\end{tikzpicture}
