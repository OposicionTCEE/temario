% Figura (cuerpo, 2.5 «Precios de Estado»): un derivado es un lote de títulos de un solo estado. (a) Lo que paga el derivado
% en cada uno de cinco estados, ordenados de peor a mejor (pagos f_omega, como los de una call: nada en los dos peores).
% (b) El precio hoy de un título que paga una unidad en cada estado, psi_omega: su suma es el precio del bono sin riesgo.
% El precio del derivado es la suma de sus pagos por esos precios. Barras ilustrativas (precios de estado: probabilidades
% 0,1-0,2-0,4-0,2-0,1 por pesos 1,6-1,3-1,0-0,8-0,6). Generar con: bash Code/generar_figura.sh b2_estados
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=0.95cm, y=0.95cm]
  % ---------------- (a) Pagos ----------------
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (2.9,3.25) {(a) Lo que paga el derivado};
    \draw[->] (0,0) -- (5.8,0);
    \draw[->] (0,0) -- (0,2.95) node[left] {pago};
    \foreach \i/\h in {1/0, 2/0, 3/0.8, 4/1.6, 5/2.4} {
      \fill[black!35] ({\i-0.3},0) rectangle ({\i+0.3},\h);
      \node[below] at (\i,0) {$\omega_\i$};
      \node[above] at (\i,\h) {$f_\i$};
    }
    \node[align=center] at (2.9,-1.05) {estados, de peor a mejor\\$\Rightarrow$ el derivado son $f_\omega$ títulos de cada estado};
  \end{scope}
  % ---------------- (b) Precios de estado ----------------
  \begin{scope}[xshift=7.6cm]
    \node[font=\footnotesize\bfseries] at (2.9,3.25) {(b) Lo que cuesta una unidad en cada estado};
    \draw[->] (0,0) -- (5.8,0);
    \draw[->] (0,0) -- (0,2.95) node[left] {precio};
    \foreach \i/\h in {1/0.88, 2/1.43, 3/2.2, 4/0.88, 5/0.33} {
      \fill[black!35] ({\i-0.3},0) rectangle ({\i+0.3},\h);
      \node[below] at (\i,0) {$\omega_\i$};
      \node[above] at (\i,\h) {$\psi_\i$};
    }
    \node[align=center] at (2.9,-1.05) {precios de estado, positivos\\$\Rightarrow$ su suma es el precio del bono sin riesgo, $e^{-r_fT}$};
  \end{scope}
\end{tikzpicture}
