% Figura (cuerpo, 3.4 «Opacidad»): la forma de la red decide si una pérdida se absorbe o se transmite (ALLEN y GALE, 2000).
% (a) Red completa: la entidad 1 incumple, y su pérdida se reparte entre las otras tres, que la absorben. (b) Red en cadena:
% cada entidad está expuesta a una sola, y la pérdida de 1 pasa entera a 2, que incumple y la pasa a 3. La flecha va del
% deudor al acreedor; en gris, las entidades que incumplen. Esquema sin valores. Generar con: bash Code/generar_figura.sh b3_red_absorbe
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]},
    ent/.style={draw, circle, minimum size=0.75cm, inner sep=0pt},
    cae/.style={draw, circle, minimum size=0.75cm, inner sep=0pt, fill=black!30}]
  % ---------------- (a) Red completa ----------------
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (1.5,3.4) {(a) Red completa: reparte};
    \node[cae] (A) at (0,2.4) {$1$};
    \node[ent] (B) at (3,2.4) {$2$};
    \node[ent] (C) at (3,0) {$3$};
    \node[ent] (D) at (0,0) {$4$};
    \draw[->, thick] (A) -- (B);
    \draw[->, thick] (A) -- (C);
    \draw[->, thick] (A) -- (D);
    \draw[thin, black!45] (B) -- (C) -- (D) -- (B);
    \node[align=center] at (1.5,-1.2) {cada entidad, expuesta a muchas\\$\Rightarrow$ la pérdida se reparte y se absorbe};
  \end{scope}
  % ---------------- (b) Red en cadena ----------------
  \begin{scope}[xshift=7.6cm]
    \node[font=\footnotesize\bfseries] at (1.5,3.4) {(b) Red en cadena: contagia};
    \node[cae] (A) at (0,2.4) {$1$};
    \node[cae] (B) at (3,2.4) {$2$};
    \node[cae] (C) at (3,0) {$3$};
    \node[ent] (D) at (0,0) {$4$};
    \draw[->, thick] (A) -- (B);
    \draw[->, thick] (B) -- (C);
    \draw[->, thick] (C) -- (D);
    \draw[->, thin, black!45] (D) -- (A);
    \node[align=center] at (1.5,-1.2) {cada entidad, expuesta a una sola\\$\Rightarrow$ la pérdida pasa entera a la siguiente};
  \end{scope}
\end{tikzpicture}
