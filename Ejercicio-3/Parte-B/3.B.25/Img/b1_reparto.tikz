% Figura (cuerpo, 1.1 «Juego»): caja de EDGEWORTH con dos estados (1: el subyacente sube; 2: baja) y sin riesgo agregado.
% A (tendrá que comprar el subyacente) tiene poca riqueza en el estado 1 y mucha en el 2; B (tendrá que venderlo), al revés:
% dotación e = (1,5; 4,5) desde O_A en una caja de lado 6. Mismas creencias y utilidad logarítmica: curvas de A
% w1 w2 = 6,75 (u_A^0, por e) y 9 (u_A^1, por e*); de B, (6 - w1)(6 - w2) = 6,75 y 9. El contrato a plazo lleva de e a e*,
% sobre la diagonal, que es la línea de certeza de las dos partes. Adaptada de anx_reparto: rótulos de las curvas y de la
% línea de certeza. Valores ilustrativos. Generar con: bash Code/generar_figura.sh b1_reparto
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1cm, y=1cm]
  \draw[thick] (0,0) rectangle (6,6);
  \node[below left] at (0,0) {$O_A$};
  \node[above right] at (6,6) {$O_B$};
  \node[below] at (3,-0.05) {$w_1^A$};
  \node[left] at (-0.05,3) {$w_2^A$};
  \node[above] at (3,6.05) {$w_1^B$};
  \node[right] at (6.05,3) {$w_2^B$};
  % Línea de certeza de las dos partes
  \draw[dashed, black!55] (0,0) -- (6,6);
  \node[black!65, rotate=45, anchor=south] at (4.85,4.85) {certeza};
  % Curvas de indiferencia de A
  \draw[thick] plot[domain=1.2:5.6, samples=60] (\x,{6.75/\x});
  \draw[thick] plot[domain=1.55:5.8, samples=60] (\x,{9/\x});
  \node[anchor=west] at (5.6,1.2) {$u_A^0$};
  \node[anchor=west] at (5.8,1.55) {$u_A^1$};
  % Curvas de indiferencia de B
  \draw[thick, black!50] plot[domain=0.4:4.8, samples=60] (\x,{6-6.75/(6-\x)});
  \draw[thick, black!50] plot[domain=0.2:4.45, samples=60] (\x,{6-9/(6-\x)});
  \node at (0.8,5.12) {$u_B^0$};
  \node at (0.55,3.95) {$u_B^1$};
  % Contrato a plazo
  \draw[->, very thick] (1.5,4.5) -- (2.93,3.07);
  \fill (1.5,4.5) circle (1.8pt) node[above right] {$e$};
  \fill (3,3) circle (1.8pt) node[below right] {$e^*$};
\end{tikzpicture}
