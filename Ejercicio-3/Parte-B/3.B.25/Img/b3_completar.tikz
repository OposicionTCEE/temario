% Figura (cuerpo, 3.2 «Tres Funciones»): completar el mercado. Riqueza, en tres estados, de quien soporta un riesgo que
% solo aparece en el tercero (una helada, un pico del precio de la electricidad, el impago de un deudor). (a) Si ningún activo
% paga justo en ese estado, no puede trasladarlo. (b) Un derivado que paga en él, a cambio de un precio en los otros dos,
% iguala su riqueza: el riesgo pasa a quien lo asume (contorno discontinuo: la riqueza sin el derivado). Barras ilustrativas.
% Generar con: bash Code/generar_figura.sh b3_completar
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1.0cm, y=0.9cm]
  % ---------------- (a) Sin el derivado ----------------
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (2.0,3.75) {(a) Sin el derivado};
    \draw[->] (0,0) -- (4.1,0);
    \draw[->] (0,0) -- (0,3.4) node[left] {riqueza};
    \foreach \i/\h in {1/3.0, 2/3.0, 3/1.0} {
      \fill[black!35] ({\i-0.3},0) rectangle ({\i+0.3},\h);
      \node[below] at (\i,0) {$\omega_\i$};
    }
    \node[below=10pt, black!60] at (3,0) {el riesgo};
    \node[align=center] at (2.0,-1.45) {ningún activo paga solo en $\omega_3$\\$\Rightarrow$ el riesgo se queda donde está};
  \end{scope}
  % ---------------- (b) Con el derivado ----------------
  \begin{scope}[xshift=7.2cm]
    \node[font=\footnotesize\bfseries] at (2.0,3.75) {(b) Con el derivado};
    \draw[->] (0,0) -- (4.1,0);
    \draw[->] (0,0) -- (0,3.4) node[left] {riqueza};
    \foreach \i/\h in {1/2.5, 2/2.5, 3/2.5} {
      \fill[black!35] ({\i-0.3},0) rectangle ({\i+0.3},\h);
      \node[below] at (\i,0) {$\omega_\i$};
    }
    \foreach \i/\h in {1/3.0, 2/3.0, 3/1.0} \draw[dashed] ({\i-0.3},0) rectangle ({\i+0.3},\h);
    \node[anchor=west, align=left] at (3.35,1.75) {lo que paga\\el derivado};
    \node[anchor=south, align=center] at (1.5,3.05) {lo que cuesta};
    \node[below=10pt, black!60] at (3,0) {el riesgo};
    \node[align=center] at (2.0,-1.45) {el derivado paga en $\omega_3$ a cambio de un precio\\$\Rightarrow$ el riesgo pasa a quien lo asume};
  \end{scope}
\end{tikzpicture}
