% Figura (cuerpo, 2.3 «Valor»): por qué la distribución del precio al vencimiento está sesgada. (a) La rentabilidad
% continua, ln(S_T/S_0), es simétrica (normal, desviación típica 0,4): una subida y una bajada del mismo porcentaje son
% igual de probables. (b) El mismo reparto, en precios, S_T = S_0 e^x con S_0 = 1,5: esas dos rentabilidades quedan a
% distancias distintas de S_0 (0,91 y 2,47), el precio no baja de cero y tiene una cola larga en los precios altos.
% Valores ilustrativos. Generar con: bash Code/generar_figura.sh b2_distribucion
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]},
    declare function={nor(\x)=exp(-(\x)^2/(2*0.4^2))/(0.4*2.5066);
                      lgn(\s)=exp(-(ln(\s/1.5))^2/(2*0.4^2))/(\s*0.4*2.5066);}]
  % ---------------- (a) Rentabilidad ----------------
  \begin{scope}[x=1.8cm, y=1.55cm]
    \node[font=\footnotesize\bfseries] at (0,1.42) {(a) La rentabilidad: simétrica};
    \draw[thick, domain=-1.3:1.3, samples=70] plot (\x,{nor(\x)});
    \draw[->] (-1.45,0) -- (1.55,0) node[below] {$\ln(S_T/S_0)$};
    \draw (0,0.04) -- (0,-0.04) node[below] {$0$};
    \draw[dotted] (-0.5,0) -- (-0.5,{nor(-0.5)});
    \draw[dotted] (0.5,0) -- (0.5,{nor(0.5)});
    \node[below] at (-0.5,0) {bajada};
    \node[below] at (0.5,0) {subida};
    \node[align=center] at (0,-0.78) {la misma subida y bajada, en porcentaje,\\igual de probables};
  \end{scope}
  % ---------------- (b) Precio ----------------
  \begin{scope}[xshift=6.3cm, x=1.3cm, y=2.15cm]
    \node[font=\footnotesize\bfseries] at (2.2,1.02) {(b) El precio al vencimiento: sesgado};
    \draw[thick, domain=0.22:4.6, samples=90] plot (\x,{lgn(\x)});
    \draw[->] (0,0) -- (4.9,0) node[below] {$S_T$};
    \draw (0,0.03) -- (0,-0.03) node[below] {$0$};
    \draw (1.5,0.03) -- (1.5,-0.03) node[below] {$S_0$};
    \draw[dotted] (0.91,0) -- (0.91,{lgn(0.91)});
    \draw[dotted] (2.47,0) -- (2.47,{lgn(2.47)});
    \node[below] at (0.91,0) {bajada};
    \node[below] at (2.47,0) {subida};
    \draw[gray] (3.5,0.07) -- (3.85,0.32);
    \node[anchor=south, align=center] at (3.95,0.3) {cola larga};
    \node[align=center] at (2.2,-0.5) {no baja de cero y puede subir sin límite\\$\Rightarrow$ cola larga en los precios altos};
  \end{scope}
\end{tikzpicture}
