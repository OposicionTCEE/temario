% Figura (cuerpo, 3.4 «Concentración»): el acreedor vacío (BOLTON y OEHMKE, 2011). El acreedor que ha comprado protección
% con un CDS sigue cobrando del deudor si paga y del vendedor de protección si incumple, de modo que ya no pierde con el
% impago y puede preferirlo a una renegociación que lo evitaría. Esquema sin valores.
% Generar con: bash Code/generar_figura.sh b3_acreedor_vacio
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]},
    caja/.style={draw, rounded corners=2pt, align=center, minimum width=3.1cm, minimum height=0.95cm}]
  \node[caja] (D) at (0,0) {deudor};
  \node[caja] (A) at (5.4,0) {acreedor\\protegido};
  \node[caja] (V) at (10.8,0) {vendedor\\de protección};
  \draw[->, thick] ([yshift=4pt]D.east) -- node[above] {le paga la deuda} ([yshift=4pt]A.west);
  \draw[->, thick] ([yshift=4pt]A.east) -- node[above] {le paga la prima} ([yshift=4pt]V.west);
  \draw[->, thick] ([yshift=-4pt]V.west) -- node[below, align=center] {le paga la pérdida\\si hay impago} ([yshift=-4pt]A.east);
  \node[align=center] at (5.4,-1.75) {el acreedor cobra igual con impago que sin él\\$\Rightarrow$ deja de tener interés en evitarlo y puede preferirlo a renegociar};
\end{tikzpicture}
