% Figura (cuerpo, 3.4 «Apalancamiento»): el apalancamiento multiplica la rentabilidad del capital en los dos sentidos. Con
% una exposición igual al capital (fina), la rentabilidad del capital es la variación del precio; con una exposición de
% varias veces el capital (gruesa; cinco veces en el dibujo), se multiplica por ese número, y una caída moderada del precio,
% la inversa de ese número, consume todo el capital (discontinua: pérdida del cien por cien). Rectas ilustrativas.
% Generar con: bash Code/generar_figura.sh b3_apalancamiento
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1.6cm, y=1.1cm]
  \draw[->] (-2.6,0) -- (2.8,0) node[below] {variación del precio};
  \draw[->] (0,-2.6) -- (0,2.6) node[above] {rentabilidad del capital};
  \draw[thin] (-2.4,-0.48) -- (2.4,0.48) node[right] {sin apalancamiento};
  \draw[very thick] (-1.0,-2.0) -- (1.0,2.0) node[right] {con apalancamiento};
  \draw[dashed] (-2.5,-2.0) -- (2.5,-2.0) node[right] {se pierde todo el capital};
  \draw[dotted] (-1.0,0) -- (-1.0,-2.0);
  \fill (-1.0,-2.0) circle (1.6pt);
  \node[above] at (-1.0,0.04) {caída que basta};
  \node[align=center] at (0.1,-3.15) {la misma variación del precio, multiplicada en los dos sentidos\\$\Rightarrow$ una caída moderada consume todo el capital};
\end{tikzpicture}
