% Figura (cuerpo, 3.4 «Apalancamiento»): el apalancamiento multiplica la rentabilidad del capital en los dos sentidos. Con
% una exposición igual al capital (fina), la rentabilidad del capital es la variación del precio; con una exposición de
% cinco veces el capital (gruesa), se multiplica por cinco, y una caída del precio del 20 % consume todo el capital
% (discontinua: pérdida del cien por cien). Unidades: 10 % en los dos ejes (x = 1,6 cm, y = 0,22 cm por unidad), de modo que
% las pendientes son 1 y 5. Rectas ilustrativas. Generar con: bash Code/generar_figura.sh b3_apalancamiento
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1.6cm, y=0.22cm]
  \draw[->] (-2.6,0) -- (2.8,0) node[below] {variación del precio};
  \draw[->] (0,-11.6) -- (0,11.8) node[above] {rentabilidad del capital};
  \draw[thin] (-2.4,-2.4) -- (2.4,2.4) node[right] {sin apalancamiento};
  \draw[very thick] (-2.0,-10.0) -- (2.0,10.0) node[right] {con apalancamiento};
  \draw[dashed] (-2.5,-10.0) -- (2.5,-10.0) node[right] {se pierde todo el capital};
  \draw[dotted] (-2.0,0) -- (-2.0,-10.0);
  \fill (-2.0,-10.0) circle (1.6pt);
  \node[above] at (-2.0,0.2) {caída que basta};
  \node[align=center] at (0.1,-14.6) {la misma variación del precio, multiplicada en los dos sentidos\\$\Rightarrow$ una caída moderada consume todo el capital};
\end{tikzpicture}
