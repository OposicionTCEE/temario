% Figura (cuerpo, 1.3 «Por qué jugar»): fijar o asegurar. Ingreso por unidad de B, que venderá el subyacente en T: sin
% cubrir, S_T (discontinua); con la venta a plazo, F (gris); con una put de precio de ejercicio K = F comprada por p,
% max{S_T, K} - p (gruesa): suelo en K - p y subida conservada. Las dos últimas se cortan en S_T = F + p. Se ignoran los
% intereses de la prima. Escala: F = K = 2, p = 0,4; x = y = 1,05 cm. Valores ilustrativos.
% Generar con: bash Code/generar_figura.sh b1_asegurar
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1.05cm, y=1.05cm]
  \draw[->] (0,0) -- (4.8,0) node[below] {$S_T$};
  \draw[->] (0,0) -- (0,4.4) node[left] {ingreso};
  \draw[thick, dashed] (0,0) -- (4.2,4.2) node[right] {$S_T$};
  \draw[very thick, black!45] (0,2) -- (4.2,2) node[right, black] {$F$};
  \draw[very thick] (0,1.6) -- (2,1.6) -- (4.2,3.8) node[right] {$\max\{S_T,K\}-p$};
  \draw[dotted] (2,0) -- (2,1.6);
  \node[below] at (2,0) {$K=F$};
  \draw[dotted] (2.4,0) -- (2.4,2);
  \node[below right] at (2.3,0) {$F+p$};
  \draw (0.06,2) -- (-0.06,2) node[left] {$F$};
  \draw (0.06,1.6) -- (-0.06,1.6) node[left] {$K-p$};
\end{tikzpicture}
