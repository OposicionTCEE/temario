% Figura (Anexo I, «Futuro»): liquidación diaria de un futuro (parte larga, N = 1).
% Precios ilustrativos F_0..F_10 = 100, 101, 99, 97, 98, 95, 96, 98, 101, 103, 104 (en el último día F_T = S_T).
% Cuenta de márgenes: margen inicial M_0 = 10, de mantenimiento M_m = 7; saldo 10, 11, 9, 7, 8, 5 -> reposición a 10,
% 11, 13, 16, 18, 19. Suma de márgenes de variación = F_T - F_0 = 4; aportado 10 + 5; saldo final 19.
% Generar con: bash Code/generar_figura.sh anx_margenes
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  % ---------------- (a) Precio del futuro ----------------
  \begin{scope}[x=0.56cm, y=0.22cm]
    \node[font=\footnotesize\bfseries] at (5,13.6) {(a) Precio del futuro};
    \draw[->] (0,0) -- (10.8,0) node[below] {$t$};
    \draw[->] (0,0) -- (0,12.5);
    % F - 93 para dibujar
    \draw[very thick] (0,7) -- (1,8) -- (2,6) -- (3,4) -- (4,5) -- (5,2) -- (6,3) -- (7,5) -- (8,8) -- (9,10) -- (10,11);
    \foreach \x in {1,...,9} \draw (\x,0.25) -- (\x,-0.25);
    \node[below] at (0,0) {$0$};
    \node[below] at (10,0) {$T$};
    \draw[dotted] (0,7) -- (10,7);
    \node[anchor=east] at (0,7) {$F_0$};
    \node[anchor=west] at (10,11) {$F_T=S_T$};
    \node[anchor=south east] at (3.8,5.2) {$F_t$};
  \end{scope}
  % ---------------- (b) Cuenta de márgenes ----------------
  \begin{scope}[xshift=8.3cm, x=0.56cm, y=0.135cm]
    \node[font=\footnotesize\bfseries] at (5,22.2) {(b) Cuenta de márgenes de $A$};
    \draw[->] (0,0) -- (10.8,0) node[below] {$t$};
    \draw[->] (0,0) -- (0,20.8);
    \draw[dashed, black!60] (0,10) -- (10.4,10);
    \draw[dotted, black!70] (0,7) -- (10.4,7);
    \node[anchor=east] at (0,10) {$M_0$};
    \node[anchor=east] at (0,7) {$M_m$};
    \draw[very thick] (0,10) -- (1,10) -- (1,11) -- (2,11) -- (2,9) -- (3,9) -- (3,7) -- (4,7) -- (4,8) -- (5,8) -- (5,5);
    \draw[->, very thick] (5,5) -- (5,9.7);
    \draw[very thick] (5,10) -- (6,10) -- (6,11) -- (7,11) -- (7,13) -- (8,13) -- (8,16) -- (9,16) -- (9,18) -- (10,18) -- (10,19);
    \foreach \x in {1,...,9} \draw (\x,0.4) -- (\x,-0.4);
    \node[below] at (0,0) {$0$};
    \node[below] at (10,0) {$T$};
  \end{scope}
\end{tikzpicture}
