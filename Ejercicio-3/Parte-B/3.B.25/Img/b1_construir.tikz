% Figura (cuerpo, 1.1 «Dos Piezas»): los derechos construyen los compromisos y cualquier otro pago. (a) Comprar una call
% y vender una put con el mismo precio de ejercicio, K, paga lo mismo que una compra a plazo a K:
% (S_T-K)^+ - (K-S_T)^+ = S_T - K. (b) Comprar una call con precio de ejercicio K_1, vender dos con K_2 y comprar una con
% K_3, a la misma distancia, da un pago que solo llega si S_T acaba cerca de K_2; los números son el cambio de pendiente,
% las calls compradas (+) o vendidas (-) en cada vértice. Escala de los gráficos pequeños: K = 1,1, x = y = 0,62 cm.
% Valores ilustrativos. Generar con: bash Code/generar_figura.sh b1_construir
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=3.5pt]}, x=0.62cm, y=0.62cm]
  % ---------------- (a) Compromiso con derechos ----------------
  \node[font=\footnotesize\bfseries] at (7.2,3.3) {(a) Compromiso con derechos};
  % call comprada
  \begin{scope}
    \draw[->] (0,0) -- (3.1,0) node[right] {$S_T$};
    \draw[->] (0,-1.9) -- (0,2.1);
    \draw[very thick] (0,0) -- (1.1,0) -- (2.9,1.8);
    \node[below=1pt] at (1.1,0) {$K$};
    \node at (1.5,-2.6) {$(S_T-K)^+$};
  \end{scope}
  \node[font=\normalsize] at (4.4,0) {$+$};
  % put vendida
  \begin{scope}[xshift=3.55cm]
    \draw[->] (0,0) -- (3.1,0) node[right] {$S_T$};
    \draw[->] (0,-1.9) -- (0,2.1);
    \draw[very thick] (0,-1.1) -- (1.1,0) -- (2.9,0);
    \node[above=1pt] at (1.1,0) {$K$};
    \node at (1.5,-2.6) {$-(K-S_T)^+$};
  \end{scope}
  \node[font=\normalsize] at (10.1,0) {$=$};
  % compromiso
  \begin{scope}[xshift=7.1cm]
    \draw[->] (0,0) -- (3.1,0) node[right] {$S_T$};
    \draw[->] (0,-1.9) -- (0,2.1);
    \draw[very thick] (0,-1.1) -- (2.9,1.8);
    \node[below right=0pt] at (1.1,0) {$K$};
    \node at (1.5,-2.6) {$S_T-K$};
  \end{scope}
  % ---------------- (b) Cualquier pago con derechos ----------------
  \begin{scope}[xshift=11.3cm]
    \node[font=\footnotesize\bfseries] at (2.6,3.3) {(b) Cualquier pago};
    \draw[->] (0,0) -- (5.6,0) node[right] {$S_T$};
    \draw[->] (0,-1.9) -- (0,2.1) node[left] {pago};
    \draw[very thick] (0,0) -- (1.2,0) -- (2.6,1.4) -- (4.0,0) -- (5.3,0);
    \draw[dotted] (2.6,0) -- (2.6,1.4);
    \node[below=1pt] at (1.2,0) {$K_1$};
    \node[below=1pt] at (2.6,0) {$K_2$};
    \node[below=1pt] at (4.0,0) {$K_3$};
    \node[above left=-1pt] at (1.2,0) {$+1$};
    \node[above=2pt] at (2.6,1.4) {$-2$};
    \node[above right=-1pt] at (4.0,0) {$+1$};
  \end{scope}
\end{tikzpicture}
