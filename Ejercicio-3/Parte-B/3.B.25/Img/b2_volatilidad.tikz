% Figura (cuerpo, 2.3 «Valor»): por qué la volatilidad da valor a una opción. Distribución del precio al vencimiento con
% las probabilidades neutrales al riesgo, con la misma media (1,6) y dos volatilidades: (a) baja, sigma raíz de T = 0,2;
% (b) alta, 0,5. La call paga en la cola a partir de K = 2 (sombreada) y más cuanto más lejos (pago discontinuo): con más
% dispersión hay más probabilidad lejos de K, y en la otra cola la opción no pierde, porque su pago no baja de cero.
% Valores ilustrativos. Generar con: bash Code/generar_figura.sh b2_volatilidad
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1.35cm, y=1.2cm,
    declare function={lgA(\s)=exp(-(ln(\s)-0.4500)^2/(2*0.2^2))/(\s*0.2*2.5066);
                      lgB(\s)=exp(-(ln(\s)-0.3450)^2/(2*0.5^2))/(\s*0.5*2.5066);}]
  % ---------------- (a) Volatilidad baja ----------------
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (2.2,2.05) {(a) Volatilidad baja};
    \fill[black!18] plot[domain=2:4.4, samples=40] (\x,{lgA(\x)}) -- (4.4,0) -- (2,0) -- cycle;
    \draw[thick, domain=0.5:4.4, samples=90] plot (\x,{lgA(\x)});
    \draw[thick, dashed] (0.3,0) -- (2,0) -- (4.4,1.2) node[above left=0pt] {pago};
    \draw[->] (0,0) -- (4.65,0) node[below] {$S_T$};
    \draw (2,0.05) -- (2,-0.05) node[below] {$K$};
    \node[align=center] at (2.2,-0.78) {poca probabilidad lejos de $K$\\$\Rightarrow$ la \textit{call} vale poco};
  \end{scope}
  % ---------------- (b) Volatilidad alta ----------------
  \begin{scope}[xshift=7.4cm]
    \node[font=\footnotesize\bfseries] at (2.2,2.05) {(b) Volatilidad alta};
    \fill[black!18] plot[domain=2:4.4, samples=40] (\x,{lgB(\x)}) -- (4.4,0) -- (2,0) -- cycle;
    \draw[thick, domain=0.2:4.4, samples=90] plot (\x,{lgB(\x)});
    \draw[thick, dashed] (0.3,0) -- (2,0) -- (4.4,1.2) node[above left=0pt] {pago};
    \draw[->] (0,0) -- (4.65,0) node[below] {$S_T$};
    \draw (2,0.05) -- (2,-0.05) node[below] {$K$};
    \node[align=center] at (2.2,-0.78) {más probabilidad lejos de $K$, y la otra cola\\no cuesta $\Rightarrow$ la \textit{call} vale más};
  \end{scope}
\end{tikzpicture}
