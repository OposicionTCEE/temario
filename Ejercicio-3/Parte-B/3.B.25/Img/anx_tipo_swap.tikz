% Figura (Anexo II, «Swap como contratos a plazo»): tipos a plazo crecientes R^F_i (puntos) y tipo swap K* (horizontal),
% su media ponderada por los factores de descuento. Quien paga el fijo paga más que el variable esperado al principio y
% menos al final; el valor actual de los saldos es cero. Valores ilustrativos: R^F = 1,0 1,3 1,6 1,85 2,05 2,2; K* = 1,62.
% Generar con: bash Code/generar_figura.sh anx_tipo_swap
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1.15cm, y=1.1cm]
  \draw[->] (0,0) -- (6.9,0) node[below] {$t$};
  \draw[->] (0,0) -- (0,2.7);
  \foreach \i/\f in {1/1.0, 2/1.3, 3/1.6, 4/1.85, 5/2.05, 6/2.2} {
    \fill[black!18] (\i-0.3,{min(\f,1.62)}) rectangle (\i+0.3,{max(\f,1.62)});
    \fill (\i,\f) circle (1.7pt);
    \node[below] at (\i,0) {$t_{\i}$};
  }
  \draw[very thick] (0,1.62) -- (6.5,1.62);
  \node[anchor=east] at (0,1.62) {$K^*$};
  \draw[thick] plot[smooth] coordinates {(1,1.0) (2,1.3) (3,1.6) (4,1.85) (5,2.05) (6,2.2)};
  \node[anchor=west] at (6.1,2.3) {$R^F_i$};
\end{tikzpicture}
