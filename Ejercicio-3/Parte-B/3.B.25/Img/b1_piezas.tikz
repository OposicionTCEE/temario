% Figura (cuerpo, 1.1 «Dos Piezas»): las dos piezas con que se construyen los derivados. (a) El compromiso, un pago
% lineal en el subyacente que la parte larga (continua) y la corta (discontinua) reciben con signo contrario. (b) El
% derecho, un pago con un vértice en el precio de ejercicio: nulo para su titular (continua) mientras no le conviene
% ejercerlo, y el contrario para quien lo ha vendido (discontinua). Escala: F = K = 2; x = 1,1 cm, y = 0,8 cm.
% Valores ilustrativos. Generar con: bash Code/generar_figura.sh b1_piezas
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1.1cm, y=0.8cm]
  % ---------------- (a) Compromiso ----------------
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (2.1,2.75) {(a) Compromiso};
    \draw[->] (0,0) -- (4.5,0) node[right] {$S_T$};
    \draw[->] (0,-2.3) -- (0,2.3) node[left] {pago};
    \draw[very thick] (0.2,-1.8) -- (3.9,1.9) node[right] {larga};
    \draw[very thick, dashed] (0.2,1.8) -- (3.9,-1.9) node[right] {corta};
    \fill (2,0) circle (1.6pt);
    \node[below=3pt] at (2,0) {$F$};
  \end{scope}
  % ---------------- (b) Derecho ----------------
  \begin{scope}[xshift=7.6cm]
    \node[font=\footnotesize\bfseries] at (2.1,2.75) {(b) Derecho};
    \draw[->] (0,0) -- (4.5,0) node[right] {$S_T$};
    \draw[->] (0,-2.3) -- (0,2.3) node[left] {pago};
    \draw[very thick] (0,0.05) -- (2,0.05) -- (3.9,1.95) node[right] {titular};
    \draw[very thick, dashed] (0,-0.05) -- (2,-0.05) -- (3.9,-1.95) node[right] {vendedor};
    \fill (2,0) circle (1.6pt);
    \node[above=3pt] at (2,0) {$K$};
  \end{scope}
\end{tikzpicture}
