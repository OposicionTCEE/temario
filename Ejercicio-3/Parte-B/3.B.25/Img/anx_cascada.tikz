% Figura (Anexo III, «Organización»): cascada de pérdidas de una cámara de contrapartida central cuando incumple un miembro
% (Reglamento (UE) n.º 648/2012, artículo 45): las pérdidas se cubren, por este orden, con las garantías del miembro que
% incumple, su aportación al fondo de garantía, los recursos propios que la cámara dedica a ello, las aportaciones de los
% demás miembros al fondo y, si no bastan, aportaciones adicionales y herramientas de recuperación y, al final, la
% resolución de la cámara (Reglamento (UE) 2021/23).
% Generar con: bash Code/generar_figura.sh anx_cascada
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=5pt]},
    capa/.style={draw, minimum width=8.6cm, minimum height=0.62cm, align=center}]
  \node[capa, fill=black!40] at (0,0) {Garantías del miembro que incumple};
  \node[capa, fill=black!30] at (0,-0.75) {Su aportación al fondo de garantía};
  \node[capa, fill=black!20] at (0,-1.5) {Recursos propios de la cámara};
  \node[capa, fill=black!12] at (0,-2.25) {Aportaciones de los demás miembros al fondo de garantía};
  \node[capa, fill=black!5] at (0,-3.0) {Aportaciones adicionales y herramientas de recuperación};
  \node[capa] at (0,-3.75) {Resolución de la cámara};
  \draw[->, very thick] (-4.75,0.25) -- (-4.75,-4.0);
  \node[rotate=90, anchor=south] at (-4.85,-1.88) {orden en que se usan};
  \draw[decorate, decoration={brace, amplitude=4pt}] (4.45,0.31) -- (4.45,-1.06) node[midway, right=5pt] {quien incumple};
  \draw[decorate, decoration={brace, amplitude=4pt}] (4.45,-1.19) -- (4.45,-1.81) node[midway, right=5pt] {la cámara};
  \draw[decorate, decoration={brace, amplitude=4pt}] (4.45,-1.94) -- (4.45,-3.31) node[midway, right=5pt] {los demás miembros};
\end{tikzpicture}
