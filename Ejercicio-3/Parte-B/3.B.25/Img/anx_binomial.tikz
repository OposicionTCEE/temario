% Figura (Anexo II, «Un periodo»): modelo binomial de un periodo (COX, ROSS y RUBINSTEIN, 1979). (a) El subyacente pasa de
% S_0 a S_0 u o a S_0 d y la opción paga f_u o f_d; q es la probabilidad neutral al riesgo. (b) Réplica: Delta unidades del
% subyacente y B en el activo sin riesgo valen al final Delta S + B e^{r Delta t}, una recta que pasa por los dos pagos de la
% opción; su pendiente es Delta y su ordenada en el origen, B e^{r Delta t}, es negativa en una call: se compra el
% subyacente con dinero prestado. Valores ilustrativos: K = 2, S_0 d = 1,2, S_0 u = 3, f_d = 0, f_u = 1, Delta = 1/1,8.
% Generar con: bash Code/generar_figura.sh anx_binomial
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  % ---------------- (a) Árbol de un periodo ----------------
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (1.7,2.15) {(a) Árbol de un periodo};
    \coordinate (A) at (0,0); \coordinate (U) at (3.0,1.0); \coordinate (D) at (3.0,-1.0);
    \draw[thick] (A) -- node[above, sloped] {$q$} (U);
    \draw[thick] (A) -- node[below, sloped] {$1-q$} (D);
    \fill (A) circle (1.8pt); \fill (U) circle (1.8pt); \fill (D) circle (1.8pt);
    \node[anchor=east] at (A) {$S_0,\ f$\,};
    \node[anchor=west] at (U) {\,$S_0u,\ f_u$};
    \node[anchor=west] at (D) {\,$S_0d,\ f_d$};
    \draw[->] (0,-1.75) -- (4.3,-1.75) node[right] {$t$};
    \draw (0,-1.68) -- (0,-1.82); \draw (3.0,-1.68) -- (3.0,-1.82);
    \node[below] at (0,-1.8) {$0$};
    \node[below] at (3.0,-1.8) {$\tau$};
  \end{scope}
  % ---------------- (b) Réplica ----------------
  \begin{scope}[xshift=7.9cm, x=0.95cm, y=1.1cm]
    \node[font=\footnotesize\bfseries] at (1.9,1.95) {(b) Réplica};
    \draw[->] (0,0) -- (4.1,0) node[below] {$S_{\tau}$};
    \draw[->] (0,-0.95) -- (0,1.7);
    \draw (0,0) -- (2,0) -- (3.6,1.6);
    \draw[very thick] (0,-0.667) -- (3.6,1.333);
    \draw[dotted] (3,0) -- (3,1);
    \fill (1.2,0) circle (1.8pt); \fill (3,1) circle (1.8pt);
    \node[anchor=east] at (0,-0.667) {$Ze^{r_f\tau}$};
    \node[anchor=west] at (3.6,1.333) {$\Delta S_{\tau}+Ze^{r_f\tau}$};
    \node[anchor=north west, inner xsep=1pt] at (1.2,0) {$S_0d$};
    \node[anchor=north] at (2,0) {$K$};
    \node[anchor=north] at (3,0) {$S_0u$};
    \node[anchor=south] at (1.2,0.04) {$f_d$};
    \node[anchor=south east] at (3,1) {$f_u$};
  \end{scope}
\end{tikzpicture}
