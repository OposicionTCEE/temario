% Figura (cuerpo, 2.6 «Capital del Arbitrajista»): el ciclo que limita el arbitraje (SHLEIFER y VISHNY, 1997). El
% arbitrajista toma una posición para cerrar una desviación entre dos precios del mismo pago; si la desviación crece antes
% de converger, pierde, le piden más garantías y le retiran fondos, y tiene que deshacer la posición, con lo que sus ventas
% agrandan la desviación. Esquema sin valores. Generar con: bash Code/generar_figura.sh b2_arbitrajista
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]},
    caja/.style={draw, rounded corners=2pt, align=center, minimum width=3.6cm, minimum height=1.0cm}]
  \node[caja] (D) at (0,2.2) {la desviación entre dos\\precios del mismo pago crece};
  \node[caja] (P) at (4.3,0) {el arbitrajista pierde\\en su posición};
  \node[caja] (G) at (0,-2.2) {le piden garantías\\y le retiran fondos};
  \node[caja] (V) at (-4.3,0) {deshace la posición:\\vende lo que compró};
  \draw[->, thick] (D.east) to[out=0, in=90] (P.north);
  \draw[->, thick] (P.south) to[out=-90, in=0] (G.east);
  \draw[->, thick] (G.west) to[out=180, in=-90] (V.south);
  \draw[->, thick] (V.north) to[out=90, in=180] (D.west);
  \node[align=center] at (0,0) {cuanto mejor es\\la oportunidad, menos\\capital para aprovecharla};
\end{tikzpicture}
