% Figura (cuerpo, 1.2 «Juego»): pagos al vencimiento de un contrato a plazo. La parte larga (A) cobra N (S_T - F) y la corta
% (B), N (F - S_T): en cada estado, lo que gana una lo pierde la otra. La pérdida máxima de A es N F (si S_T = 0); la de B no
% tiene límite. Escala: F = 2, N = 1; x = 1,2 cm, y = 0,62 cm. Valores ilustrativos.
% Generar con: bash Code/generar_figura.sh b1_plazo
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1.2cm, y=0.62cm]
  \draw[->] (0,0) -- (4.7,0) node[below] {$S_T$};
  \draw[->] (0,-2.9) -- (0,3.0) node[left] {pago};
  \draw[very thick] (0,-2) -- (4.3,2.3) node[right] {$A$ (larga)};
  \draw[very thick, dashed] (0,2) -- (4.3,-2.3) node[right] {$B$ (corta)};
  \draw (2,0.12) -- (2,-0.12);
  \node[below=5pt] at (2,0) {$F$};
  \draw (0.06,2) -- (-0.06,2) node[left] {$N F$};
  \draw (0.06,-2) -- (-0.06,-2) node[left] {$-N F$};
  \node[below left] at (0,0) {$0$};
\end{tikzpicture}
