% Figura (Anexo I, «Elementos»): pagos entre las partes a lo largo de la vida de un derivado.
% (a) Compromiso (contrato a plazo o futuro): nada al contratar; márgenes diarios en el futuro; liquidación simétrica.
% (b) Derecho (opción de compra): prima al contratar; liquidación solo a favor del comprador.
% A = posición larga (arriba), B = posición corta (abajo). Generar con: bash Code/generar_figura.sh anx_anatomia
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  % ---------------- (a) Compromiso ----------------
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (3.1,2.55) {(a) Compromiso: a plazo y futuro};
    \draw[black!30] (0,1.8) -- (6.2,1.8);
    \draw[black!30] (0,0.3) -- (6.2,0.3);
    \node[anchor=east] at (-0.1,1.8) {$A$};
    \node[anchor=east] at (-0.1,0.3) {$B$};
    \draw[->] (0,-0.3) -- (6.6,-0.3) node[right] {$t$};
    \draw (0,-0.22) -- (0,-0.38) node[below] {$0$};
    \draw (5.8,-0.22) -- (5.8,-0.38) node[below] {$T$};
    % Precio pactado, sin pago
    \node[draw, fill=white, inner sep=2pt] at (0.25,1.05) {$F$};
    % Márgenes diarios (solo el futuro)
    \foreach \x in {1.3,2.1,2.9,3.7,4.5} \draw[<->, dashed, black!70] (\x,0.4) -- (\x,1.7);
    \node[fill=white, inner sep=1pt] at (2.9,1.05) {$\pm N\,\Delta F_t$};
    % Liquidación
    \draw[<->, very thick] (5.8,0.4) -- (5.8,1.7);
    \node[anchor=west] at (5.85,1.05) {$N\,(S_T-F)$};
  \end{scope}
  % ---------------- (b) Derecho ----------------
  \begin{scope}[xshift=8.6cm]
    \node[font=\footnotesize\bfseries] at (3.1,2.55) {(b) Derecho: opción de compra};
    \draw[black!30] (0,1.8) -- (5.8,1.8);
    \draw[black!30] (0,0.3) -- (5.8,0.3);
    \node[anchor=east] at (-0.1,1.8) {$A$};
    \node[anchor=east] at (-0.1,0.3) {$B$};
    \draw[->] (0,-0.3) -- (6.2,-0.3) node[right] {$t$};
    \draw (0,-0.22) -- (0,-0.38) node[below] {$0$};
    \draw (5.4,-0.22) -- (5.4,-0.38) node[below] {$T$};
    % Prima al contratar
    \draw[->, very thick] (0.25,1.7) -- (0.25,0.4);
    \node[anchor=west] at (0.3,1.05) {$p$};
    \node[draw, fill=white, inner sep=2pt] at (1.2,1.05) {$K$};
    % Liquidación solo a favor de A
    \draw[->, very thick] (5.4,0.4) -- (5.4,1.7);
    \node[anchor=east] at (5.35,1.05) {$N\,(S_T-K)^+$};
  \end{scope}
\end{tikzpicture}
