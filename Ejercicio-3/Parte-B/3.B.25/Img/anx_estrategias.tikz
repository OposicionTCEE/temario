% Figura (Anexo I, «Estrategias»): pago al vencimiento (sin primas) de seis combinaciones. Discontinua: el subyacente.
% (a) Put protectora max(S,K). (b) Call cubierta min(S,K). (c) Collar min(max(S,K1),K2). (d) Diferencial alcista
% (S-K1)^+ - (S-K2)^+. (e) Cono |S-K|. (f) Mariposa (S-K1)^+ - 2(S-K2)^+ + (S-K3)^+, con K2 = (K1+K3)/2.
% Generar con: bash Code/generar_figura.sh anx_estrategias
\begin{tikzpicture}[font=\scriptsize]
  \tikzset{panel/.style={font=\footnotesize\bfseries}}
  % Fila superior
  \begin{scope}[x=0.9cm, y=0.55cm]
    \node[panel] at (2,4.75) {(a) \textit{Put} protectora};
    \draw[->] (0,0) -- (4.3,0) node[below] {$S_T$};
    \draw[->] (0,0) -- (0,4.3);
    \draw[thick, dashed, black!55] (0,0) -- (4,4);
    \draw[very thick] (0,2) -- (2,2) -- (4,4);
    \draw[dotted] (2,2) -- (2,0) node[below] {$K$};
    \node[anchor=east] at (0,2) {$K$};
  \end{scope}
  \begin{scope}[xshift=5.3cm, x=0.9cm, y=0.55cm]
    \node[panel] at (2,4.75) {(b) \textit{Call} cubierta};
    \draw[->] (0,0) -- (4.3,0) node[below] {$S_T$};
    \draw[->] (0,0) -- (0,4.3);
    \draw[thick, dashed, black!55] (0,0) -- (4,4);
    \draw[very thick] (0,0) -- (2,2) -- (4,2);
    \draw[dotted] (2,2) -- (2,0) node[below] {$K$};
    \node[anchor=east] at (0,2) {$K$};
  \end{scope}
  \begin{scope}[xshift=10.6cm, x=0.9cm, y=0.55cm]
    \node[panel] at (2,4.75) {(c) Collar};
    \draw[->] (0,0) -- (4.3,0) node[below] {$S_T$};
    \draw[->] (0,0) -- (0,4.3);
    \draw[thick, dashed, black!55] (0,0) -- (4,4);
    \draw[very thick] (0,1.3) -- (1.3,1.3) -- (2.7,2.7) -- (4,2.7);
    \draw[dotted] (1.3,1.3) -- (1.3,0) node[below] {$K_1$};
    \draw[dotted] (2.7,2.7) -- (2.7,0) node[below] {$K_2$};
  \end{scope}
  % Fila inferior
  \begin{scope}[yshift=-3.6cm, x=0.9cm, y=0.55cm]
    \node[panel] at (2,4.75) {(d) Diferencial alcista};
    \draw[->] (0,0) -- (4.3,0) node[below] {$S_T$};
    \draw[->] (0,0) -- (0,4.3);
    \draw[very thick] (0,0.03) -- (1.3,0.03) -- (2.7,1.4) -- (4,1.4);
    \draw[dotted] (2.7,1.4) -- (2.7,0);
    \node[below] at (1.3,0) {$K_1$};
    \node[below] at (2.7,0) {$K_2$};
    \node[anchor=east] at (0,1.4) {$K_2-K_1$};
    \draw[dotted] (0,1.4) -- (2.7,1.4);
  \end{scope}
  \begin{scope}[xshift=5.3cm, yshift=-3.6cm, x=0.9cm, y=0.55cm]
    \node[panel] at (2,4.75) {(e) Cono};
    \draw[->] (0,0) -- (4.3,0) node[below] {$S_T$};
    \draw[->] (0,0) -- (0,4.3);
    \draw[very thick] (0,2) -- (2,0.03) -- (4,2);
    \node[below] at (2,0) {$K$};
  \end{scope}
  \begin{scope}[xshift=10.6cm, yshift=-3.6cm, x=0.9cm, y=0.55cm]
    \node[panel] at (2,4.75) {(f) Mariposa};
    \draw[->] (0,0) -- (4.3,0) node[below] {$S_T$};
    \draw[->] (0,0) -- (0,4.3);
    \draw[very thick] (0,0.03) -- (1.2,0.03) -- (2,1.6) -- (2.8,0.03) -- (4,0.03);
    \draw[dotted] (2,1.6) -- (2,0);
    \node[below] at (1.2,0) {$K_1$};
    \node[below] at (2,0) {$K_2$};
    \node[below] at (2.8,0) {$K_3$};
  \end{scope}
\end{tikzpicture}
