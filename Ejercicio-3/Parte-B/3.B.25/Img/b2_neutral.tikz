% Figura (cuerpo, 2.1 «Probabilidades Neutrales al Riesgo»): dos formas de ponderar los estados del subyacente. (a) Con la
% probabilidad real de subida, pi, el subyacente rinde en promedio mu > r_f, porque incluye su prima de riesgo, y su pago
% esperado descontado a r_f supera a S_0. (b) La probabilidad neutral al riesgo, q < pi, da más peso al estado malo, lo justo
% para que rinda r_f: descontado a r_f, su pago esperado es S_0. Barras proporcionales a las probabilidades (ilustrativas:
% pi = 0,6, q = 0,45). Generar con: bash Code/generar_figura.sh b2_neutral
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  % ---------------- (a) Probabilidades reales ----------------
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (1.9,1.85) {(a) Probabilidades reales};
    \node (S0) at (0,0) {$S_0$};
    \node (Su) at (2.4,0.85) {$S_u$};
    \node (Sd) at (2.4,-0.85) {$S_d$};
    \draw[->] (S0) -- node[above left=-1pt] {$\pi$} (Su);
    \draw[->] (S0) -- node[below left=-1pt] {$1-\pi$} (Sd);
    \node[black!60] at (3.6,1.25) {peso de cada estado};
    \fill[black!30] (2.85,0.72) rectangle ++(1.5,0.26);
    \fill[black!30] (2.85,-0.98) rectangle ++(1.0,0.26);
    \node at (1.9,-1.75) {$E[S_T]=S_0\,e^{\mu T}$};
    \node[align=center] at (1.9,-2.55) {con $\pi$, rinde $\mu>r_f$ $\Rightarrow$ descontar\\su pago esperado a $r_f$ no da $S_0$};
  \end{scope}
  % ---------------- (b) Probabilidades neutrales al riesgo ----------------
  \begin{scope}[xshift=7.4cm]
    \node[font=\footnotesize\bfseries] at (1.9,1.85) {(b) Probabilidades neutrales al riesgo};
    \node (S0) at (0,0) {$S_0$};
    \node (Su) at (2.4,0.85) {$S_u$};
    \node (Sd) at (2.4,-0.85) {$S_d$};
    \draw[->] (S0) -- node[above left=-1pt] {$q$} (Su);
    \draw[->] (S0) -- node[below left=-1pt] {$1-q$} (Sd);
    \node[black!60] at (3.6,1.25) {peso de cada estado};
    \fill[black!30] (2.85,0.72) rectangle ++(1.125,0.26);
    \fill[black!30] (2.85,-0.98) rectangle ++(1.375,0.26);
    \node at (1.9,-1.75) {$E^{\mathbb Q}[S_T]=S_0\,e^{r_fT}$};
    \node[align=center] at (1.9,-2.55) {con $q<\pi$, rinde $r_f$ $\Rightarrow$ descontar\\su pago esperado a $r_f$ da $S_0$};
  \end{scope}
\end{tikzpicture}
