% Figura (Anexo I, «Compromiso»): pagos de un contrato a plazo y cobertura.
% (a) Pagos al vencimiento de la parte larga, S_T - F, y de la corta, F - S_T, con F = 2: la pérdida máxima de la larga
%     es F (si S_T = 0); la de la corta no tiene límite.
% (b) Quien venderá el subyacente en T (ingreso S_T) vende a plazo (F - S_T): ingreso total F, sin riesgo de precio.
% Generar con: bash Code/generar_figura.sh anx_compromiso
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  % ---------------- (a) Pagos de las dos partes ----------------
  \begin{scope}[x=1.15cm, y=0.62cm]
    \node[font=\footnotesize\bfseries] at (2.1,4.25) {(a) Pagos de las dos partes};
    \draw[->] (0,0) -- (4.5,0) node[below] {$S_T$};
    \draw[->] (0,-2.5) -- (0,2.6);
    \draw[very thick] (0,-2) -- (4,2);
    \draw[very thick, dashed] (0,2) -- (4,-2);
    \draw[dotted] (2,0) -- (2,-0.35);
    \node[below] at (2,-0.3) {$F$};
    \node[anchor=east] at (0,-2) {$-F$};
    \node[anchor=east] at (0,2) {$F$};
    \node[anchor=west] at (4,2) {$A$: $S_T-F$};
    \node[anchor=west] at (4,-2) {$B$: $F-S_T$};
  \end{scope}
  % ---------------- (b) Cobertura ----------------
  \begin{scope}[xshift=8.4cm, x=1.15cm, y=0.62cm]
    \node[font=\footnotesize\bfseries] at (2.1,4.25) {(b) Cobertura de quien vende en $T$};
    \draw[->] (0,0) -- (4.5,0) node[below] {$S_T$};
    \draw[->] (0,-2.5) -- (0,4.0);
    \draw[thick, dashed] (0,0) -- (4,4);
    \draw[thick, dotted] (0,2) -- (4,-2);
    \draw[very thick] (0,2) -- (4,2);
    \draw[dotted] (2,2) -- (2,0) node[below] {$F$};
    \node[anchor=east] at (0,2) {$F$};
    \node[anchor=west] at (4,4) {$S_T$};
    \node[anchor=west] at (4,-2) {$F-S_T$};
    \node[anchor=west] at (4,2) {$F$};
  \end{scope}
\end{tikzpicture}
