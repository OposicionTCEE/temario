% Figura (Anexo I, «Swaps de tipos de interés»).
% (a) A tiene un préstamo a tipo variable (paga L + m) y contrata un swap con B: paga el fijo K y recibe el variable L.
%     Su coste neto queda fijado en K + m.
% (b) Las dos patas en el tiempo para quien paga fijo: en cada fecha recibe N tau L_{i-1} (variable, fijado al inicio del
%     periodo) y paga N tau K (constante). Valores ilustrativos del variable: 0,6 0,9 1,3 1,1 0,8 1,0; fijo 0,95.
% Generar con: bash Code/generar_figura.sh anx_swap_tipos
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]},
    caja/.style={draw, minimum width=1.4cm, minimum height=0.7cm, inner sep=2pt}]
  % ---------------- (a) Flujos ----------------
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (2.7,1.9) {(a) Préstamo variable y swap};
    \node[caja] (P) at (0,0) {Prestamista};
    \node[caja] (A) at (2.7,0) {$A$};
    \node[caja] (B) at (5.4,0) {$B$};
    \draw[->, thick] (A.west) -- node[above] {$L+m$} (P.east);
    \draw[->, thick] ([yshift=4pt]A.east) -- node[above] {$s$} ([yshift=4pt]B.west);
    \draw[->, thick] ([yshift=-4pt]B.west) -- node[below] {$L$} ([yshift=-4pt]A.east);
    \node at (2.7,-1.0) {$(L+m)+s-L=s+m$};
  \end{scope}
  % ---------------- (b) Patas en el tiempo ----------------
  \begin{scope}[xshift=7.6cm, x=0.95cm, y=1.0cm]
    \node[font=\footnotesize\bfseries] at (3.3,1.9) {(b) Las dos patas de $A$};
    \draw[->] (0,0) -- (6.9,0) node[right] {$t$};
    \foreach \i/\h in {1/0.6, 2/0.9, 3/1.3, 4/1.1, 5/0.8, 6/1.0} {
      \draw[->, very thick] (\i-0.1,0) -- (\i-0.1,\h);
      \draw[->, very thick, black!45] (\i+0.1,0) -- (\i+0.1,-0.95);
      \node[below, font=\scriptsize] at (\i,-1.0) {$t_{\i}$};
    }
    \node[anchor=south] at (0.9,0.62) {$\tau L_{0}$};
    \node[anchor=west] at (6.2,-0.6) {$-\tau s$};
  \end{scope}
\end{tikzpicture}
