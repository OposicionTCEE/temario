% Figura (Anexo I, «Dos piezas»): de qué está hecho cualquier derivado.
% (a) Compra de una call y venta de una put con el mismo K = compra a plazo a K: (S-K)^+ - (K-S)^+ = S - K.
% (b) Pago lineal a tramos con vértices en K1 = 1,3 y K2 = 2,7, pendientes s0 = 0,3, s1 = 1,2 y s2 = 0,2, f(0) = 0,4:
%     recta f(0) + s0 S (bono y compromiso) más (s1 - s0) calls en K1 y (s2 - s1) calls en K2.
% (c) Pago curvo f(S) = 0,25 (S-2)^2 + 0,3 S + 0,2, tangente en kappa = 2 (bono y compromiso) y curvatura cubierta con
%     puts de K < kappa y calls de K > kappa (CARR y MADAN, 1998).
% Generar con: bash Code/generar_figura.sh anx_dos_piezas
\begin{tikzpicture}[font=\scriptsize, >={Stealth[length=3.5pt]}]
  % ---------------- (a) Compromiso y derechos ----------------
  \begin{scope}[yshift=1.45cm, x=0.95cm, y=0.6cm]
    \node[font=\footnotesize\bfseries] at (2,2.6) {(a) Compromiso y derechos};
    \draw[->] (0,0) -- (4.3,0) node[below] {$S_T$};
    \draw[->] (0,-2.3) -- (0,2.4);
    \draw[line width=3.2pt, black!25] (0,-2) -- (4,2);
    \draw[thick] (0,0.02) -- (2,0.02) -- (4,2);
    \draw[thick, dashed] (0,-2) -- (2,-0.02) -- (4,-0.02);
    \draw[dotted] (2,0) -- (2,-0.4) node[below] {$K$};
    % Leyenda
    \draw[thick] (0.15,2.0) -- (0.6,2.0) node[right] {$(S_T-K)^+$};
    \draw[thick, dashed] (0.15,1.45) -- (0.6,1.45) node[right] {$-(K-S_T)^+$};
    \draw[line width=3.2pt, black!25] (0.15,0.9) -- (0.6,0.9) node[right, text=black] {$S_T-K$};
  \end{scope}
  % ---------------- (b) Pago con vértices ----------------
  \begin{scope}[xshift=5.25cm, x=0.9cm, y=0.95cm]
    \node[font=\footnotesize\bfseries] at (2,3.15) {(b) Pago con vértices};
    \draw[->] (0,0) -- (4.3,0) node[below] {$S_T$};
    \draw[->] (0,0) -- (0,3.0);
    \draw[dashed] (0,0.4) -- (4,1.6);
    \draw[very thick] (0,0.4) -- (1.3,0.79) -- (2.7,2.47) -- (4,2.73);
    \draw[dotted] (1.3,0.79) -- (1.3,0) node[below] {$K_1$};
    \draw[dotted] (2.7,2.47) -- (2.7,0) node[below] {$K_2$};
    \node[anchor=west] at (4,2.73) {$f(S_T)$};
    \node[anchor=north west] at (2.85,1.3) {$f(0)+\Delta_0S_T$};
    \node[anchor=east] at (1.25,1.15) {$\Delta_1-\Delta_0$};
    \node[anchor=south] at (2.55,2.62) {$\Delta_2-\Delta_1$};
    \node[anchor=east] at (0,0.4) {$f(0)$};
  \end{scope}
  % ---------------- (c) Pago curvo ----------------
  \begin{scope}[xshift=10.75cm, x=0.9cm, y=0.95cm]
    \node[font=\footnotesize\bfseries] at (2,3.15) {(c) Pago curvo};
    \draw[->] (0,0) -- (4.3,0) node[below] {$S_T$};
    \draw[->] (0,0) -- (0,3.0);
    \fill[black!12] (0,0.2) -- plot[domain=0:2, samples=30] (\x,{0.25*(\x-2)^2+0.3*\x+0.2}) -- cycle;
    \fill[black!30] (2,0.8) -- plot[domain=2:4, samples=30] (\x,{0.25*(\x-2)^2+0.3*\x+0.2}) -- (4,1.4) -- cycle;
    \draw[dashed] (0,0.2) -- (4,1.4);
    \draw[very thick] plot[domain=0:4, samples=60] (\x,{0.25*(\x-2)^2+0.3*\x+0.2});
    \draw[dotted] (2,0.8) -- (2,0) node[below] {$\kappa$};
    \fill (2,0.8) circle (1.3pt);
    \node[anchor=west] at (4,2.4) {$f(S_T)$};
    \node[anchor=west] at (4,1.4) {$f'(\kappa)$};
    \node[anchor=north] at (0.75,-0.45) {$(K-S_T)^+$, $K<\kappa$};
    \node[anchor=north] at (3.3,-0.45) {$(S_T-K)^+$, $K>\kappa$};
    \draw[black!50] (0.55,0.95) -- (0.75,-0.45);
    \draw[black!50] (3.45,1.55) -- (3.3,-0.45);
  \end{scope}
\end{tikzpicture}
