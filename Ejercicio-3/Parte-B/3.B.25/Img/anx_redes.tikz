% Figura (Anexo III, «Organización»): compensación bilateral y multilateral. (a) Sin cámara, tres entidades con deudas en
% círculo (la flecha va del deudor al acreedor), cada una de x frente a la siguiente: ningún par puede compensar nada y quedan
% tres exposiciones de x. (b) Con cámara de contrapartida central (ECC), que se interpone en cada contrato: cada entidad le
% debe x y la cámara le debe x, de modo que su posición neta frente a la cámara es nula.
% Generar con: bash Code/generar_figura.sh anx_redes
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=5pt]},
    ent/.style={draw, circle, minimum size=0.8cm, inner sep=1pt},
    ecc/.style={draw, rounded corners=2pt, minimum width=1.1cm, minimum height=0.7cm, fill=black!10}]
  % ---------------- (a) Bilateral ----------------
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (1.5,3.3) {(a) Bilateral};
    \node[ent] (A) at (1.5,2.4) {$1$};
    \node[ent] (B) at (3.0,0) {$2$};
    \node[ent] (C) at (0,0) {$3$};
    \draw[->, thick] (A) -- node[right] {$x$} (B);
    \draw[->, thick] (B) -- node[below] {$x$} (C);
    \draw[->, thick] (C) -- node[left] {$x$} (A);
  \end{scope}
  % ---------------- (b) Con cámara ----------------
  \begin{scope}[xshift=6.6cm]
    \node[font=\footnotesize\bfseries] at (1.5,3.3) {(b) Con cámara};
    \node[ecc] (K) at (1.5,0.95) {ECC};
    \node[ent] (A) at (1.5,2.6) {$1$};
    \node[ent] (B) at (3.4,-0.2) {$2$};
    \node[ent] (C) at (-0.4,-0.2) {$3$};
    \draw[->, thick] (A) to[bend right=25] node[left] {$x$} (K);
    \draw[->, thick] (K) to[bend right=25] node[right] {$x$} (A);
    \draw[->, thick] (B) to[bend right=20] node[above right=-1pt] {$x$} (K);
    \draw[->, thick] (K) to[bend right=20] node[below left=-1pt] {$x$} (B);
    \draw[->, thick] (C) to[bend right=20] node[below right=-1pt] {$x$} (K);
    \draw[->, thick] (K) to[bend right=20] node[above left=-1pt] {$x$} (C);
    \node[anchor=west] at (A.east) {\ neto $=0$};
    \node[anchor=north] at (B.south) {neto $=0$};
    \node[anchor=north] at (C.south) {neto $=0$};
  \end{scope}
\end{tikzpicture}
