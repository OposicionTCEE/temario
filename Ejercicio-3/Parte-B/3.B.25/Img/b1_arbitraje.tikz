% Figura (cuerpo, 1.1 «Arbitraje»): el arbitraje entre dos precios del mismo pago. El derivado, de precio f, y su
% réplica, una cartera de coste V, pagan lo mismo en T. Si f > V, el arbitrajista vende el derivado y compra la réplica:
% los dos pagos se anulan al vencimiento, se queda f - V sin riesgo, y sus ventas y compras bajan f y suben V hasta que
% se igualan. Esquema sin valores. Generar con: bash Code/generar_figura.sh b1_arbitraje
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]},
    caja/.style={draw, rounded corners=2pt, align=center, minimum width=2.9cm, minimum height=0.95cm}]
  \node[caja, rounded corners=7pt] (A) at (3.4,3.5) {arbitrajista};
  \node[caja] (D) at (0,1.8) {derivado\\precio $f$};
  \node[caja] (R) at (6.8,1.8) {réplica\\coste $V$};
  \node[caja] (P) at (3.4,0) {el mismo pago en $T$};
  \draw[->] (A.west) -| node[pos=0.25, above] {vende si $f>V$} (D.north);
  \draw[->] (A.east) -| node[pos=0.25, above] {compra si $f>V$} (R.north);
  \draw[->] (D.south) |- (P.west);
  \draw[->] (R.south) |- (P.east);
  \node[align=center] at (3.4,1.8) {ganancia sin\\riesgo, $f-V$};
  \node[align=center, below=0.25cm of P] {sus operaciones bajan $f$ y suben $V$ hasta que $f=V$};
\end{tikzpicture}
