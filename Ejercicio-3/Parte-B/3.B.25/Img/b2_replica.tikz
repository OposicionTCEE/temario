% Figura (cuerpo, 2.1 «Réplica y Cobertura»): el mundo de dos estados y la réplica de un derivado. (a) En T, el subyacente
% vale S_u o S_d; el activo sin riesgo convierte cada unidad en e^{r_f T} en los dos estados, y el derivado paga f_u o f_d.
% (b) La réplica, Delta unidades del subyacente y una cantidad Z en el activo sin riesgo, paga Delta S_T + Z e^{r_f T}: es la
% recta que pasa por los dos pagos del derivado; su pendiente es la delta y su ordenada en el origen, lo que paga el activo
% sin riesgo (negativa si se pide prestado). Valores ilustrativos: S_d = 1,2, S_u = 3,2, f_d = 0,6, f_u = 2,0.
% Generar con: bash Code/generar_figura.sh b2_replica
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  % ---------------- (a) Dos estados ----------------
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (1.2,4.35) {(a) Dos estados};
    \node at (0.6,3.75) {hoy};
    \node at (2.6,3.75) {en $T$};
    \node[anchor=east] at (-0.2,2.9) {subyacente};
    \node (S0) at (0.6,2.9) {$S_0$};
    \node (Su) at (2.6,3.3) {$S_u$};
    \node (Sd) at (2.6,2.5) {$S_d$};
    \draw[->] (S0) -- (Su);
    \draw[->] (S0) -- (Sd);
    \node[anchor=west, black!60] at (2.95,3.3) {sube};
    \node[anchor=west, black!60] at (2.95,2.5) {baja};
    \node[anchor=east] at (-0.2,1.5) {sin riesgo};
    \node (B0) at (0.6,1.5) {$1$};
    \node (Bu) at (2.6,1.9) {$e^{r_fT}$};
    \node (Bd) at (2.6,1.1) {$e^{r_fT}$};
    \draw[->] (B0) -- (Bu);
    \draw[->] (B0) -- (Bd);
    \node[anchor=east] at (-0.2,0.1) {derivado};
    \node (f0) at (0.6,0.1) {$f_0$};
    \node (fu) at (2.6,0.5) {$f_u$};
    \node (fd) at (2.6,-0.3) {$f_d$};
    \draw[->] (f0) -- (fu);
    \draw[->] (f0) -- (fd);
  \end{scope}
  % ---------------- (b) La réplica ----------------
  \begin{scope}[xshift=6.0cm, yshift=-0.55cm, x=1.3cm, y=1.45cm]
    \node[font=\footnotesize\bfseries] at (2.0,3.37) {(b) La réplica};
    \draw[->] (0,0) -- (4.2,0) node[below] {$S_T$};
    \draw[->] (0,-0.55) -- (0,2.95) node[left] {pago};
    \draw[thick] (0,-0.24) -- (3.75,2.385);
    \node[anchor=west, align=left] at (3.8,2.3) {réplica:\\$\Delta\,S_T+Z\,e^{r_fT}$};
    \draw[dashed] (1.2,0.6) -- (3.2,0.6) -- (3.2,2.0);
    \draw[dotted] (1.2,0) -- (1.2,0.6);
    \draw[dotted] (3.2,0) -- (3.2,0.6);
    \fill (1.2,0.6) circle (1.8pt) node[above left] {$f_d$};
    \fill (3.2,2.0) circle (1.8pt) node[above left] {$f_u$};
    \node[below] at (1.2,0) {$S_d$};
    \node[below] at (3.2,0) {$S_u$};
    \node[below] at (2.2,0.6) {$S_u-S_d$};
    \node[right] at (3.2,1.3) {$f_u-f_d$};
    \node[anchor=east] at (-0.05,-0.24) {$Z\,e^{r_fT}$};
    \node[anchor=west] at (0.15,2.55) {pendiente: $\Delta=(f_u-f_d)/(S_u-S_d)$};
  \end{scope}
\end{tikzpicture}
