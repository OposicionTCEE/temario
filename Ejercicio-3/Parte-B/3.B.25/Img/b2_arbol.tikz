% Figura (cuerpo, 2.3 «Réplica Dinámica»): la réplica de una call en un árbol de dos periodos de duración tau. El precio
% de ejercicio está entre S_dd y S_ud, de modo que la call paga S_uu - K o S_ud - K tras una subida y solo S_ud - K o nada
% tras una bajada. En cada nudo, la réplica se rehace para el periodo siguiente: tras la subida se ejercerá seguro y tiene
% una unidad del subyacente (Delta_u = 1); tras la bajada, solo una fracción pequeña (Delta_d). La réplica compra subyacente
% cuando el precio sube y lo vende cuando baja. Esquema sin valores. Generar con: bash Code/generar_figura.sh b2_arbol
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  \coordinate (A) at (0,0);
  \coordinate (U) at (3.0,1.25);
  \coordinate (D) at (3.0,-1.25);
  \coordinate (UU) at (6.0,2.5);
  \coordinate (UD) at (6.0,0);
  \coordinate (DD) at (6.0,-2.5);
  \draw[thick] (A) -- (U) -- (UU);
  \draw[thick] (A) -- (D) -- (DD);
  \draw[thick] (U) -- (UD);
  \draw[thick] (D) -- (UD);
  \foreach \p in {A,U,D,UU,UD,DD} \fill (\p) circle (1.8pt);
  \node[anchor=east] at (A) {$S_0$\,};
  \node[anchor=south] at ([yshift=2pt]U) {$S_u$};
  \node[anchor=north] at ([yshift=-2pt]D) {$S_d$};
  \node[anchor=west] at (UU) {\,$S_{uu}$};
  \node[anchor=west] at (UD) {\,$S_{ud}$};
  \node[anchor=west] at (DD) {\,$S_{dd}$};
  % delta de la réplica en cada nudo
  \node[anchor=north, align=center] at ([yshift=-4pt]A) {$\Delta_0$};
  \node[anchor=north, align=center] at ([yshift=-5pt]U) {$\Delta_u=1$:\\se ejercerá};
  \node[anchor=south, align=center] at ([yshift=5pt]D) {$\Delta_d$, pequeña};
  % pagos de la call al vencimiento
  \node[font=\footnotesize\bfseries] at (8.6,3.35) {pago de la \textit{call}};
  \node at (8.6,2.5) {$S_{uu}-K$};
  \node at (8.6,0) {$S_{ud}-K$};
  \node at (8.6,-2.5) {$0$};
  \node[align=center, black!60] at (8.6,-3.25) {($S_{dd}<K<S_{ud}$)};
  % tiempo
  \draw[->] (0,-3.9) -- (6.8,-3.9) node[right] {$t$};
  \foreach \x/\t in {0/0, 3.0/\tau, 6.0/T} {\draw (\x,-3.83) -- (\x,-3.97); \node[below] at (\x,-3.95) {$\t$};}
  \node[align=center] at (3.0,-4.75) {sube $\Rightarrow$ la réplica compra subyacente; baja $\Rightarrow$ lo vende};
\end{tikzpicture}
