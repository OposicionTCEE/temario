% Figura (cuerpo, 1.3 «Juego»): la cola de la distribución que cede el comprador de cada opción. Densidad de S_T (lognormal
% ilustrativa, mediana 2, sigma 0,35) y pago de la opción (discontinuo). (a) A, que tendrá que comprar, pierde si S_T acaba
% alto: con la call traslada al vendedor la cola derecha, S_T > K, que es donde la opción paga. (b) B, que tendrá que vender,
% pierde si acaba bajo: con la put traslada la cola izquierda, S_T < K. La prima es el precio de esa cola.
% Escala: K = 2; x = 1,45 cm, y = 1,3 cm. Generar con: bash Code/generar_figura.sh b1_colas
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1.45cm, y=1.3cm,
    declare function={dens(\s)=2.6*exp(-((ln(\s)-ln(2))^2)/(2*0.35^2))/(\s*0.35*2.5066);}]
  % ---------------- (a) Call ----------------
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (2.3,2.45) {(a) \textit{Call}: la cola derecha};
    \draw[thick] (0.1,2.0) -- (0.45,2.0) node[right] {densidad de $S_T$};
    \draw[thick, dashed] (2.45,2.0) -- (2.8,2.0) node[right] {pago, $(S_T-K)^+$};
    \fill[black!18] plot[domain=2:4.4, samples=40] (\x,{dens(\x)}) -- (4.4,0) -- (2,0) -- cycle;
    \draw[thick, domain=0.45:4.4, samples=70] plot (\x,{dens(\x)});
    \draw[thick, dashed] (0.3,0) -- (2,0) -- (4.4,1.55);
    \draw[->] (0,0) -- (4.65,0) node[below] {$S_T$};
    \draw (2,0.06) -- (2,-0.06) node[below] {$K$};
    \draw[gray] (2.75,0.3) -- (3.5,0.5);
    \node[anchor=west, align=left] at (3.5,0.5) {cola cedida:\\su precio es $c$};
    \node[align=center] at (2.3,-0.75) {$A$ pierde si $S_T$ sube $\Rightarrow$ la cede\\con la \textit{call} a su vendedor};
  \end{scope}
  % ---------------- (b) Put ----------------
  \begin{scope}[xshift=7.6cm]
    \node[font=\footnotesize\bfseries] at (2.3,2.45) {(b) \textit{Put}: la cola izquierda};
    \draw[thick] (0.1,2.0) -- (0.45,2.0) node[right] {densidad de $S_T$};
    \draw[thick, dashed] (2.45,2.0) -- (2.8,2.0) node[right] {pago, $(K-S_T)^+$};
    \fill[black!18] plot[domain=0.45:2, samples=40] (\x,{dens(\x)}) -- (2,0) -- (0.45,0) -- cycle;
    \draw[thick, domain=0.45:4.4, samples=70] plot (\x,{dens(\x)});
    \draw[thick, dashed] (0.3,1.1) -- (2,0) -- (4.4,0);
    \draw[->] (0,0) -- (4.65,0) node[below] {$S_T$};
    \draw (2,0.06) -- (2,-0.06) node[below] {$K$};
    \draw[gray] (1.35,0.55) -- (0.95,1.2);
    \node[anchor=south east, align=right] at (1.0,1.2) {cola cedida:\\su precio es $p$};
    \node[align=center] at (2.3,-0.75) {$B$ pierde si $S_T$ baja $\Rightarrow$ la cede\\con la \textit{put} a su vendedor};
  \end{scope}
\end{tikzpicture}
