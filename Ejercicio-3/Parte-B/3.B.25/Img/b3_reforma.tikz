% Figura (cuerpo, 3.5 «Riesgo Transformado»): el riesgo antes y después de la reforma. (a) Antes de 2008: una red bilateral
% entre bancos (círculos), opaca y sin garantías obligatorias: riesgo de contraparte repartido y que nadie ve entero.
% (b) Después: una estrella con la cámara en el centro, a la vista de los registros; bancos y también fondos, fondos de
% pensiones y empresas (cuadrados) le pagan garantías en efectivo: el riesgo es ahora de liquidez y se concentra en la
% cámara y en quienes deben pagarlas. Esquema sin valores. Generar con: bash Code/generar_figura.sh b3_reforma
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]},
    ban/.style={draw, circle, minimum size=0.55cm, inner sep=0pt},
    nob/.style={draw, minimum size=0.55cm, inner sep=0pt}]
  % ---------------- (a) Antes ----------------
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (1.6,3.3) {(a) Antes de la reforma};
    \foreach \i/\a in {1/90, 2/162, 3/234, 4/306, 5/18} \node[ban] (N\i) at ($(1.6,1.3)+(\a:1.45)$) {};
    \foreach \i/\j in {1/2, 1/3, 1/4, 1/5, 2/3, 2/4, 2/5, 3/4, 3/5, 4/5} \draw[thick] (N\i) -- (N\j);
    \node[align=center, black!60] at (1.6,-0.65) {red opaca, sin garantías obligatorias};
    \node[align=center] at (1.6,-1.45) {riesgo de contraparte repartido\\en la red, que nadie ve entera};
  \end{scope}
  % ---------------- (b) Después ----------------
  \begin{scope}[xshift=7.6cm]
    \node[font=\footnotesize\bfseries] at (1.6,3.3) {(b) Después de la reforma};
    \node[draw, rounded corners=2pt, fill=black!25, minimum width=1.3cm, minimum height=0.6cm] (K) at (1.6,1.3) {cámara};
    \foreach \i/\a in {1/90, 2/162, 5/18} \node[ban] (N\i) at ($(1.6,1.3)+(\a:1.6)$) {};
    \foreach \i/\a in {3/234, 4/306} \node[nob] (N\i) at ($(1.6,1.3)+(\a:1.6)$) {};
    \foreach \i in {1,...,5} \draw[->, thick] (N\i) -- (K);
    \node[align=center, black!60] at (1.6,-0.65) {garantías en efectivo, a la vista de los registros};
    \node[align=center] at (1.6,-1.45) {riesgo de liquidez, concentrado en la\\cámara y en quienes pagan las garantías};
  \end{scope}
  \node[align=center, black!60] at (5.4,-2.3) {círculos: bancos; cuadrados: fondos, fondos de pensiones y empresas};
\end{tikzpicture}
