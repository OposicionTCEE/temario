% Figura (cuerpo, 3.5 «Respuesta del G20»): cada compromiso del G20 (2009 y 2011) contra un rasgo. El capital y las
% garantías obligatorias de lo que no se compensa responden al apalancamiento y a la concentración bilateral; los registros
% de operaciones, a la opacidad, y la compensación en cámaras, al contagio por la red bilateral que la opacidad agravaba. La
% liquidez es el rasgo que la reforma no atacó, sino que aumentó (discontinua), y se estudia a continuación. Esquema sin valores.
% Generar con: bash Code/generar_figura.sh b3_g20
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]},
    rasgo/.style={draw, rounded corners=2pt, align=center, minimum width=2.9cm, minimum height=0.75cm},
    resp/.style={draw, rounded corners=2pt, align=center, minimum width=5.2cm, minimum height=0.75cm, fill=black!8}]
  \node[font=\footnotesize\bfseries] at (0,3.75) {rasgo};
  \node[font=\footnotesize\bfseries] at (7.2,3.75) {respuesta del G20 (2009-2011)};
  \node[rasgo] (A) at (0,3.0) {apalancamiento};
  \node[rasgo] (C) at (0,1.9) {concentración};
  \node[rasgo] (O) at (0,0.8) {opacidad};
  \node[rasgo] (L) at (0,-0.6) {liquidez};
  \node[resp] (K) at (7.2,2.45) {más capital y garantías obligatorias\\para lo que no se compensa};
  \node[resp] (R) at (7.2,1.15) {registros de operaciones};
  \node[resp] (Q) at (7.2,0.25) {compensación en cámaras y\\negociación en plataformas};
  \node[draw, dashed, rounded corners=2pt, align=center, minimum width=5.2cm, minimum height=0.75cm] (M) at (7.2,-0.85) {la reforma la aumenta: garantías\\que se pagan en efectivo};
  \draw[->, thick] (A.east) -- (K.west);
  \draw[->, thick] (C.east) -- (K.west);
  \draw[->, thick] (O.east) -- (R.west);
  \draw[->, thick] (O.east) -- node[below, sloped] {contagio} (Q.west);
  \draw[->, thick, dashed] (L.east) -- (M.west);
  \node[align=center] at (3.6,-2.0) {lo que sigue siendo bilateral se encarece\\$\Rightarrow$ compensar resulta más barato};
\end{tikzpicture}
