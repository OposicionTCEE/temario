% Figura (Anexo II, «Precios implícitos»): (a) precio de una call frente a su precio de ejercicio, decreciente y convexo; la
% cuerda entre K_1 y K_3 queda por encima del precio en K_2, y la diferencia es el precio de la mariposa,
% que no puede ser negativo. (b) Segunda derivada del precio respecto a K: la densidad neutral al riesgo descontada,
% e^{-rT} q(K) (BREEDEN y LITZENBERGER, 1978); el área sombreada, de anchura K_2 - K_1, es el precio de un título que paga si S_T
% termina cerca de K_2. Valores ilustrativos: S_0 = 2, rT = 0,05, sigma raíz de T = 0,35, K_2 = 2,2, K_2 - K_1 = 0,8.
% Generar con: bash Code/generar_figura.sh anx_breeden
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  % ---------------- (a) Precio de la call ----------------
  \begin{scope}[x=1.2cm, y=2.0cm]
    \node[font=\footnotesize\bfseries] at (1.6,1.55) {(a) Precio de la \textit{call}};
    \draw[->] (0,0) -- (3.3,0) node[below] {$K$};
    \draw[->] (0,0) -- (0,1.38) node[left] {$c$};
    \draw[very thick] plot[smooth] coordinates {(0.200,1.239) (0.300,1.145) (0.400,1.052) (0.500,0.960) (0.600,0.871) (0.700,0.785) (0.800,0.703) (0.900,0.625) (1.000,0.553) (1.100,0.487) (1.200,0.426) (1.300,0.372) (1.400,0.323) (1.500,0.279) (1.600,0.240) (1.700,0.206) (1.800,0.177) (1.900,0.151) (2.000,0.129) (2.100,0.110) (2.200,0.093) (2.300,0.079) (2.400,0.067) (2.500,0.057) (2.600,0.048) (2.700,0.041) (2.800,0.034) (2.900,0.029) (3.000,0.024)};
    \draw[dashed] (0.800,0.703) -- (2.400,0.067);
    \foreach \k/\c in {0.800/0.703, 1.600/0.240, 2.400/0.067} { \fill (\k,\c) circle (1.6pt); \draw[dotted] (\k,0) -- (\k,\c); }
    \node[anchor=north] at (0.800,0) {$K_1$};
    \node[anchor=north] at (1.600,0) {$K_2$};
    \node[anchor=north] at (2.400,0) {$K_3$};
  \end{scope}
  % ---------------- (b) Precios de estado ----------------
  \begin{scope}[xshift=6.6cm, x=1.2cm, y=3.0cm]
    \node[font=\footnotesize\bfseries] at (1.6,1.0333) {(b) Precios de estado};
    \fill[black!22] (1.200,0) -- plot[smooth] coordinates {(1.200,0.581) (1.250,0.576) (1.300,0.567) (1.350,0.556) (1.400,0.542) (1.450,0.526) (1.500,0.509) (1.550,0.490) (1.600,0.471) (1.650,0.450) (1.700,0.430) (1.750,0.409) (1.800,0.388) (1.850,0.367) (1.900,0.347) (1.950,0.327) (2.000,0.307)} -- (2.000,0) -- cycle;
    \draw[->] (0,0) -- (3.3,0) node[below] {$K$};
    \draw[->] (0,0) -- (0,0.92);
    \draw[very thick] plot[smooth] coordinates {(0.200,0.048) (0.300,0.096) (0.400,0.163) (0.500,0.242) (0.600,0.326) (0.700,0.407) (0.800,0.476) (0.900,0.529) (1.000,0.564) (1.100,0.581) (1.200,0.581) (1.300,0.567) (1.400,0.542) (1.500,0.509) (1.600,0.471) (1.700,0.430) (1.800,0.388) (1.900,0.347) (2.000,0.307) (2.100,0.270) (2.200,0.236) (2.300,0.206) (2.400,0.178) (2.500,0.153) (2.600,0.132) (2.700,0.113) (2.800,0.096) (2.900,0.082) (3.000,0.070)};
    \draw[dotted] (1.600,0) -- (1.600,0.471);
    \node[anchor=north] at (1.600,0) {$K_2$};
    \node[anchor=south west] at (1.250,0.586) {$e^{-r_fT}q(K)=\dfrac{\partial^2c}{\partial K^2}$};
  \end{scope}
\end{tikzpicture}
