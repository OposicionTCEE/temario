% Cuerpo, apartado 4.1.3: comercio bruto frente a comercio en valor añadido. A fabrica componentes por valor a y los
% exporta a B, que añade b y exporta el producto final, a+b, a C. Saldos bilaterales de C en las dos medidas; el
% multilateral es el mismo. Fuente: OCDE y OMC, comercio en valor añadido (TiVA).
\begin{tikzpicture}[
  font=\footnotesize,
  >={Stealth[length=2mm]},
  every node/.append style={execute at begin node={\hyphenpenalty=10000\exhyphenpenalty=10000}},
  pais/.style={draw, thick, rounded corners=3pt, fill=black!4, align=center, text width=3.0cm, minimum height=1.3cm},
  flujo/.style={fill=white, align=center, inner sep=1.5pt, font=\scriptsize},
  cuadro/.style={draw, rounded corners=2pt, fill=blue!5, align=left, inner sep=4pt, font=\scriptsize},
]
\node[pais] (A) at (0,0) {\textbf{País A}\\ fabrica los componentes};
\node[pais] (B) at (6.0,0) {\textbf{País B}\\ ensambla el producto};
\node[pais] (C) at (12.0,0) {\textbf{País C}\\ compra el producto final};
\draw[->, thick] (A.east) -- (B.west) node[flujo, midway, above=3pt] {componentes, $a$};
\draw[->, thick] (B.east) -- (C.west) node[flujo, midway, above=3pt] {producto final, $a+b$};
\node[font=\scriptsize, align=center] at (6.0,-1.05) {valor añadido por B: $b$};
% Saldos bilaterales de C
\node[cuadro, anchor=north] at (3.0,-1.7) {\textbf{Saldos de C en comercio bruto}\\[2pt] con A: $0$\\ con B: $-(a+b)$\\[2pt] total: $-(a+b)$};
\node[cuadro, anchor=north] at (9.0,-1.7) {\textbf{Saldos de C en valor añadido}\\[2pt] con A: $-a$\\ con B: $-b$\\[2pt] total: $-(a+b)$};
\end{tikzpicture}%
