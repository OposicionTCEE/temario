% Cuerpo, apartado 4.1.1: la conciliación de la PII en una sola fila, con el estilo del esquema de las cuentas
% internacionales del bloque I (b1_cuentas): la posición inicial, más las transacciones de la cuenta financiera, que son lo
% único que pasa por la balanza, más las otras variaciones (revalorizaciones y otros cambios del volumen), da la posición
% final. Sustituye a la cascada (17/11/2026): el usuario pidió un diagrama sencillo como el del bloque I, en horizontal.
% Fuente: FMI (2009), cap. 2 y 7.
\begin{tikzpicture}[
  font=\footnotesize,
  every node/.append style={execute at begin node={\hyphenpenalty=10000\exhyphenpenalty=10000}},
  bloque/.style={draw, rounded corners=3pt, thick},
  caja/.style={draw, rounded corners=2pt, fill=white, align=center, inner sep=3pt},
  titulo/.style={font=\footnotesize\bfseries, align=center},
  op/.style={font=\Large},
]
% ---------------- PII inicial
\draw[bloque, fill=black!6] (0,0) rectangle (2.4,2.6);
\node[titulo] at (1.2,2.05) {PII al final\\ de $t-1$};
\node[align=center] at (1.2,0.85) {$PII_{t-1}$\\ $=AF_{t-1}-P_{t-1}$};
\node[op] at (2.675,1.3) {$+$};
% ---------------- Balanza de pagos: lo único que pasa por ella son las transacciones
\draw[bloque, fill=blue!5] (2.95,0) rectangle (6.35,2.6);
\node[titulo] at (4.65,2.25) {Balanza de pagos};
\node[caja, text width=2.85cm, minimum height=1.75cm] at (4.65,1.0) {\textbf{Transacciones\\ financieras}\\[1pt] cuenta financiera\\[1pt] $CF_t=\Delta AF_t-\Delta P_t$};
\node[op] at (6.625,1.3) {$+$};
% ---------------- Otras variaciones de las posiciones
\draw[bloque, fill=black!4] (6.9,0) rectangle (12.6,2.6);
\node[titulo] at (9.75,2.25) {Otras variaciones de las posiciones};
\node[caja, text width=2.3cm, minimum height=1.75cm] at (8.28,1.0) {Revalorizaciones por tipo de cambio y por precios, $RV_t$};
\node[font=\normalsize] at (9.75,1.0) {$+$};
\node[caja, text width=2.3cm, minimum height=1.75cm] at (11.22,1.0) {Otros cambios\\ del volumen, $OV_t$};
\node[op] at (12.875,1.3) {$=$};
% ---------------- PII final
\draw[bloque, fill=black!6] (13.15,0) rectangle (15.55,2.6);
\node[titulo] at (14.35,2.05) {PII al final\\ de $t$};
\node[align=center] at (14.35,0.85) {$PII_{t}$\\ $=AF_{t}-P_{t}$};
% ---------------- Identidad de la PII integrada, como en b1_cuentas (el usuario pidió la fórmula, 17/11/2026)
\draw[->, thick] (1.2,0) -- (1.2,-0.7) -- (14.35,-0.7) -- (14.35,0);
\node[fill=white, inner sep=2pt] at (7.775,-0.7) {$PII_t=PII_{t-1}+CF_t+RV_t+OV_t$};
\end{tikzpicture}%
