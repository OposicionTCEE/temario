% Anexo, Desequilibrio › Líneas (anx:lineas; en el cuerpo, 4.2.2, hasta el 17/11/2026): dónde se traza la línea. Las partidas de la balanza, de arriba abajo, con las tres líneas clásicas:
% saldo corriente, balanza básica y balanza global (la de la presentación analítica del FMI, que deja debajo las
% reservas, el crédito del FMI y la financiación excepcional). Las entradas netas son las de la cuenta financiera sin
% reservas con el signo cambiado: CC + CK + entradas netas + EO = ΔAF^res.
% Fuente: FMI (2009), apéndice 9 (presentación analítica); MEADE (1951).
\begin{tikzpicture}[
  font=\footnotesize,
  every node/.append style={execute at begin node={\hyphenpenalty=10000\exhyphenpenalty=10000}},
  caja/.style={draw=black!70, minimum width=6.4cm, minimum height=0.66cm, anchor=north west, inner sep=2pt, align=center},
  linea/.style={dashed, black!70},
  pregunta/.style={anchor=west, align=left, text width=7.0cm},
]
\path (0,0.25); % margen superior, para que no se recorte el borde de la primera caja
% Partidas autónomas, por encima de la línea
\node[caja] at (0,0)      {Cuenta corriente, $CC$};
\node[caja] at (0,-0.66)  {Cuenta de capital, $CK$};
\node[caja] at (0,-1.32)  {Inversión directa (entradas netas)};
\node[caja] at (0,-1.98)  {Cartera, derivados y otra inversión (entradas netas)};
\node[caja] at (0,-2.64)  {Errores y omisiones, $EO$};
% Partidas de financiación, por debajo de la línea
\node[caja, fill=black!10] at (0,-3.42) {Activos de reserva, crédito del FMI\\ y financiación excepcional};
% Las tres líneas
\draw[linea] (6.4,-0.66) -- (7.9,-0.66);
\node[pregunta] at (8.0,-0.66) {\textbf{Saldo corriente}: ¿gasta el país más de lo que ingresa?};
\draw[linea] (6.4,-1.98) -- (7.9,-1.98);
\node[pregunta] at (8.0,-1.98) {\textbf{Balanza básica}: ¿se financia con recursos estables?};
\draw[very thick] (-0.2,-3.30) -- (7.9,-3.30);
\node[pregunta] at (8.0,-3.30) {\textbf{Balanza global}: ¿han tenido que financiarlo las autoridades?};
% Llaves de la izquierda
\draw[decorate, decoration={brace, amplitude=4pt}] (-0.35,-3.25) -- (-0.35,0)
  node[midway, left=6pt, align=right] {Partidas\\ autónomas};
\draw[decorate, decoration={brace, amplitude=4pt}] (-0.35,-4.53) -- (-0.35,-3.42)
  node[midway, left=6pt, align=right] {Partidas de\\ financiación};
% Identidad
\node[anchor=north] at (3.2,-4.75) {$CC+CK+\text{entradas netas}+EO=\Delta AF^{res}$};
\end{tikzpicture}%
