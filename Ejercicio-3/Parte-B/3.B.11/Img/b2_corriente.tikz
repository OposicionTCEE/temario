% Cuerpo, apartado 3.1.2: la cuenta corriente en letras. Cada saldo se suma al anterior y cierra un agregado de la
% contabilidad nacional (A = absorción). Primera fase del cuadro que crece cuenta a cuenta (b2_capital, b2_financiera).
% Fuente: FMI (2009); SEC 2010.
\begin{tikzpicture}[
  font=\footnotesize,
  every node/.append style={execute at begin node={\hyphenpenalty=10000\exhyphenpenalty=10000}},
  cab/.style={font=\footnotesize\bfseries, align=center},
  rub/.style={anchor=west, align=left},
  tot/.style={anchor=west, font=\footnotesize\bfseries},
]
% Columnas: rúbrica (desde 0,1), créditos 6,3, débitos 8,4, saldo 10,9, saldo acumulado 14,0
\draw[thick] (0,0.4) -- (15.6,0.4);
\node[cab, anchor=west] at (0.1,0) {Rúbrica};
\node[cab] at (6.3,0) {Créditos};
\node[cab] at (8.4,0) {Débitos};
\node[cab] at (10.9,0) {Saldo};
\node[cab] at (14.0,0) {Saldo acumulado};
\draw (0,-0.32) -- (15.6,-0.32);
% Bienes y servicios
\node[rub] at (0.1,-0.7) {Bienes};
\node at (6.3,-0.7) {$X_b$}; \node at (8.4,-0.7) {$M_b$}; \node at (10.9,-0.7) {$X_b-M_b$};
\node[rub] at (0.1,-1.25) {Servicios};
\node at (6.3,-1.25) {$X_s$}; \node at (8.4,-1.25) {$M_s$}; \node at (10.9,-1.25) {$X_s-M_s$};
\draw[black!40] (0,-1.55) -- (15.6,-1.55);
\node[tot] at (0.1,-1.88) {Bienes y servicios};
\node at (6.3,-1.88) {$X$}; \node at (8.4,-1.88) {$M$}; \node at (10.9,-1.88) {$X-M$}; \node at (14.0,-1.88) {$PIB-A$};
\draw[black!40] (0,-2.2) -- (15.6,-2.2);
% Rentas
\node[rub] at (0.1,-2.55) {Renta primaria};
\node at (6.3,-2.55) {cobros}; \node at (8.4,-2.55) {pagos}; \node at (10.9,-2.55) {$RPN$}; \node at (14.0,-2.55) {$RNB-A$};
\node[rub] at (0.1,-3.1) {Renta secundaria};
\node at (6.3,-3.1) {ingresos}; \node at (8.4,-3.1) {pagos}; \node at (10.9,-3.1) {$TCN$}; \node at (14.0,-3.1) {$RNDB-A$};
\draw[black!40] (0,-3.4) -- (15.6,-3.4);
\node[tot] at (0.1,-3.75) {Cuenta corriente};
\node at (10.9,-3.75) {$CC=X-M+RPN+TCN$}; \node at (14.0,-3.75) {$S-I$};
\draw[thick] (0,-4.1) -- (15.6,-4.1);
\end{tikzpicture}%
