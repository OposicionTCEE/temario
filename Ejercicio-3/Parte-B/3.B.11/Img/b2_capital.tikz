% Cuerpo, apartado 3.2: el cuadro de la balanza crece con la cuenta de capital hasta la capacidad o necesidad de
% financiación. Segunda fase del cuadro (b2_corriente → b2_capital → b2_financiera); la cuenta corriente, ya vista, en gris.
% Notación del 3.A.30: TKN, transferencias de capital netas; NP_RM, cesiones netas de activos no producidos a no residentes.
% Fuente: FMI (2009); SEC 2010.
\begin{tikzpicture}[
  font=\footnotesize,
  every node/.append style={execute at begin node={\hyphenpenalty=10000\exhyphenpenalty=10000}},
  cab/.style={font=\footnotesize\bfseries, align=center},
  rub/.style={anchor=west, align=left},
  tot/.style={anchor=west, font=\footnotesize\bfseries},
  vis/.style={text=black!50},
]
\draw[thick] (0,0.4) -- (15.6,0.4);
\node[cab, anchor=west] at (0.1,0) {Rúbrica};
\node[cab] at (6.3,0) {Créditos};
\node[cab] at (8.4,0) {Débitos};
\node[cab] at (10.9,0) {Saldo};
\node[cab] at (14.0,0) {Saldo acumulado};
\draw (0,-0.32) -- (15.6,-0.32);
% Cuenta corriente, ya vista
\node[rub, vis] at (0.1,-0.7) {Cuenta corriente};
\node[vis] at (10.9,-0.7) {$CC$}; \node[vis] at (14.0,-0.7) {$S-I$};
\draw[black!40] (0,-1.0) -- (15.6,-1.0);
% Cuenta de capital
\node[rub] at (0.1,-1.35) {Transferencias de capital};
\node at (6.3,-1.35) {recibidas}; \node at (8.4,-1.35) {pagadas}; \node at (10.9,-1.35) {$TKN$};
\node[rub] at (0.1,-1.9) {Activos no financieros no producidos};
\node at (6.3,-1.9) {cesiones}; \node at (8.4,-1.9) {adquisiciones}; \node at (10.9,-1.9) {$NP_{RM}$};
\draw[black!40] (0,-2.2) -- (15.6,-2.2);
\node[tot] at (0.1,-2.55) {Cuenta de capital};
\node at (10.9,-2.55) {$CK=TKN+NP_{RM}$};
\draw[black!40] (0,-2.85) -- (15.6,-2.85);
\node[tot] at (0.1,-3.2) {Capacidad ($+$) o necesidad ($-$) de financiación};
\node at (10.9,-3.2) {$CNF=CC+CK$}; \node at (14.0,-3.2) {$S+CK-I$};
\draw[thick] (0,-3.55) -- (15.6,-3.55);
\end{tikzpicture}%
