% Partida cuádruple en la balanza de pagos: exportación española a Francia cobrada en un depósito en un banco francés.
% Anexo I.5.4. Vertical: partida doble en cada economía; horizontal: contrapartida en la otra economía. Fuente: FMI (2009), cap. 3.
\begin{tikzpicture}[
  font=\footnotesize,
  >={Stealth[length=2mm]},
  every node/.append style={execute at begin node={\hyphenpenalty=10000\exhyphenpenalty=10000}},
  tit/.style={font=\footnotesize\bfseries, align=center},
  cab/.style={font=\scriptsize\bfseries, align=center},
  ent/.style={font=\scriptsize, align=center, text width=2.55cm, fill=white, draw, rounded corners=1.5pt, inner sep=2pt},
]
% ---------------- España
\node[tit] at (3.3,6.75) {Balanza de pagos de España};
\node[cab] at (3.3,6.1) {Cuenta corriente: bienes};
\draw[thick] (0.3,5.85) -- (6.3,5.85);
\draw[thick] (3.3,5.85) -- (3.3,4.35);
\node[cab] at (1.8,5.6) {Crédito};
\node[cab] at (4.8,5.6) {Débito};
\node[ent] (esX) at (1.8,4.85) {Exportación\\ de bienes, $x$};
\node[cab] at (3.3,3.55) {Cuenta financiera: otra inversión};
\draw[thick] (0.3,3.3) -- (6.3,3.3);
\draw[thick] (3.3,3.3) -- (3.3,1.8);
\node[cab] at (1.8,3.05) {$\Delta AF$};
\node[cab] at (4.8,3.05) {$\Delta P$};
\node[ent] (esA) at (1.8,2.3) {Depósito en un\\ banco francés, $+x$};
% ---------------- Francia
\node[tit] at (12.3,6.75) {Balanza de pagos de Francia};
\node[cab] at (12.3,6.1) {Cuenta corriente: bienes};
\draw[thick] (9.3,5.85) -- (15.3,5.85);
\draw[thick] (12.3,5.85) -- (12.3,4.35);
\node[cab] at (10.8,5.6) {Crédito};
\node[cab] at (13.8,5.6) {Débito};
\node[ent] (frM) at (13.8,4.85) {Importación\\ de bienes, $x$};
\node[cab] at (12.3,3.55) {Cuenta financiera: otra inversión};
\draw[thick] (9.3,3.3) -- (15.3,3.3);
\draw[thick] (12.3,3.3) -- (12.3,1.8);
\node[cab] at (10.8,3.05) {$\Delta AF$};
\node[cab] at (13.8,3.05) {$\Delta P$};
\node[ent] (frP) at (13.8,2.3) {Depósito de un\\ no residente, $+x$};
% ---------------- Partida doble (vertical) y contrapartida (horizontal)
\draw[<->, thick] (esX.south) -- (esA.north) node[midway, right=2pt, font=\scriptsize, align=left] {partida\\ doble};
\draw[<->, thick] (frM.south) -- (frP.north) node[midway, left=2pt, font=\scriptsize, align=right] {partida\\ doble};
\draw[<->, dashed] (esX.east) -- (frM.west) node[pos=0.5, fill=white, inner sep=1.5pt, font=\scriptsize] {la misma transacción};
\draw[<->, dashed] (esA.east) -- (frP.west) node[pos=0.5, fill=white, inner sep=1.5pt, font=\scriptsize] {el mismo instrumento};
% ---------------- Leyenda
\node[font=\scriptsize, align=left, anchor=west, text width=15.2cm] at (0.3,1.15) {Líneas continuas: partida doble dentro de cada economía. Líneas discontinuas: la misma operación, registrada por la otra economía con el signo cambiado. Las cuatro anotaciones forman la partida cuádruple.};
\end{tikzpicture}%
