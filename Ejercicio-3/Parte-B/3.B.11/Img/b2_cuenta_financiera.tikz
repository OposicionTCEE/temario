% Cuerpo, 3.4.1: la CNF (cuenta de capital, en gris) abre la cuenta financiera, que cierra con los errores y omisiones.
% Generada por Code/cuentas_T.py (no editar a mano). Rúbricas agregadas, en letras; fuente: FMI (2009); SEC 2010.
\begin{tikzpicture}[
  font=\scriptsize,
  >={Stealth[length=1.8mm]},
  every node/.append style={execute at begin node={\hyphenpenalty=10000\exhyphenpenalty=10000}},
  ent/.style={anchor=west, align=left, text width=6.65cm, inner sep=1.5pt},
  vis/.style={text=black!45},
  arr/.style={->, thick, black!55, rounded corners=2pt},
]
\node[font=\footnotesize\bfseries] at (3.50,0.62) {Débitos};
\node[font=\footnotesize\bfseries] at (10.50,0.62) {Créditos};
\node[text=black!60, align=center] at (3.50,0.25) {importaciones, pagos y adquisición neta de activos};
\node[text=black!60, align=center] at (10.50,0.25) {exportaciones, ingresos y contracción neta de pasivos};
\draw[thick] (0,0) -- (14.00,0);
\node[ent, vis] at (0.12,-0.315) {\textbf{Cuenta de capital}};
\node[ent, vis] at (0.12,-0.785) {Transferencias de capital};
\node[ent, vis] at (0.12,-1.255) {Adquisiciones de activos no producidos};
\node[ent, vis] (S0) at (0.12,-1.725) {\textbf{Capacidad o necesidad de financiación, $CNF=CC+CK$}};
\node[ent, vis] (C0) at (7.18,-0.315) {\textit{Saldo de la cuenta corriente, $CC$}};
\node[ent, vis] at (7.18,-0.785) {Transferencias de capital};
\node[ent, vis] at (7.18,-1.255) {Cesiones de activos no producidos};
\draw[black!55] (0,-2.040) -- (14.00,-2.040);
\node[ent] at (0.12,-2.355) {\textbf{Cuenta financiera}};
\node[ent] at (0.12,-2.825) {\textit{Adquisición neta de activos}, $\Delta AF$:};
\node[ent] at (0.12,-3.295) {\hspace*{1em}Inversión directa};
\node[ent] at (0.12,-3.765) {\hspace*{1em}Inversión de cartera};
\node[ent] at (0.12,-4.235) {\hspace*{1em}Derivados financieros (neto)};
\node[ent] at (0.12,-4.705) {\hspace*{1em}Otra inversión};
\node[ent] at (0.12,-5.175) {\hspace*{1em}Activos de reserva};
\node[ent] (C1) at (7.18,-2.355) {\textit{Capacidad o necesidad de financiación, $CNF$}};
\node[ent] at (7.18,-2.825) {\textit{Contracción neta de pasivos}, $\Delta P$:};
\node[ent] at (7.18,-3.295) {\hspace*{1em}Inversión directa};
\node[ent] at (7.18,-3.765) {\hspace*{1em}Inversión de cartera};
\node[ent] at (7.18,-4.235) {\hspace*{1em}Otra inversión};
\node[ent] at (7.18,-5.645) {\textbf{Errores y omisiones, $EO$}};
\draw[arr] (S0.east) to[out=0, in=180] (C1.west);
\draw[thick] (7.00,0) -- (7.00,-5.960);
\node[font=\footnotesize] at (7.00,-6.410) {$\Delta AF=\Delta P+CNF+EO$, \ es decir, \ $CF=\Delta AF-\Delta P=CNF+EO$};
\end{tikzpicture}%
