% Cuerpo, 3.4.1: la CNF (cuenta de capital, en gris) abre la cuenta financiera, que cierra con los errores y omisiones.
% Generada por Code/cuentas_T.py (no editar a mano). Rúbricas agregadas, en letras; fuente: FMI (2009); SEC 2010.
\begin{tikzpicture}[
  font=\footnotesize,
  >={Stealth[length=1.8mm]},
  every node/.append style={execute at begin node={\hyphenpenalty=10000\exhyphenpenalty=10000}},
  ent/.style={anchor=west, align=left, text width=7.45cm, inner sep=1.5pt},
  sal/.style={anchor=west, align=left, inner sep=1.5pt},
  vis/.style={text=black!45},
  arr/.style={->, thick, black!55, rounded corners=2pt},
]
\node[font=\small\bfseries] at (3.90,0.66) {Débitos};
\node[font=\small\bfseries] at (11.70,0.66) {Créditos};
\node[text=black!60, align=center, font=\scriptsize] at (3.90,0.25) {importaciones, pagos y adquisición neta de activos};
\node[text=black!60, align=center, font=\scriptsize] at (11.70,0.25) {exportaciones, ingresos y contracción neta de pasivos};
\draw[thick] (0,0) -- (15.60,0);
\node[ent, vis] at (0.12,-0.345) {\textbf{Cuenta de capital}};
\node[ent, vis] at (0.12,-0.875) {Transferencias de capital};
\node[ent, vis] at (0.12,-1.405) {Adquisiciones de activos no producidos};
\node[sal, vis] (S0) at (0.12,-1.935) {\textbf{Capacidad o necesidad de financiación, $CNF=CC+CK$}};
\node[sal, vis] (C0) at (7.98,-0.345) {\textit{Saldo de la cuenta corriente, $CC$}};
\node[ent, vis] at (7.98,-0.875) {Transferencias de capital};
\node[ent, vis] at (7.98,-1.405) {Cesiones de activos no producidos};
\draw[black!55] (0,-2.280) -- (15.60,-2.280);
\node[ent] at (0.12,-2.625) {\textbf{Cuenta financiera}};
\node[ent] at (0.12,-3.155) {\textit{Adquisición neta de activos}, $\Delta AF$:};
\node[ent] at (0.12,-3.685) {\hspace*{1em}Inversión directa};
\node[ent] at (0.12,-4.215) {\hspace*{1em}Inversión de cartera};
\node[ent] at (0.12,-4.745) {\hspace*{1em}Derivados financieros (neto)};
\node[ent] at (0.12,-5.275) {\hspace*{1em}Otra inversión};
\node[ent] at (0.12,-5.805) {\hspace*{1em}Activos de reserva};
\node[sal] (C1) at (7.98,-2.625) {\textit{Capacidad o necesidad de financiación, $CNF$}};
\node[ent] at (7.98,-3.155) {\textit{Contracción neta de pasivos}, $\Delta P$:};
\node[ent] at (7.98,-3.685) {\hspace*{1em}Inversión directa};
\node[ent] at (7.98,-4.215) {\hspace*{1em}Inversión de cartera};
\node[ent] at (7.98,-4.745) {\hspace*{1em}Otra inversión};
\node[ent] at (7.98,-6.335) {\textbf{Errores y omisiones, $EO$}};
\draw[arr] (S0.east) to[out=0, in=180] (C1.west);
\draw[thick] (7.80,0) -- (7.80,-6.680);
\node[font=\small] at (7.80,-7.180) {$\Delta AF=\Delta P+CNF+EO$, \ es decir, \ $CF=\Delta AF-\Delta P=CNF+EO$};
\end{tikzpicture}%
