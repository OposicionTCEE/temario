% Clasificación de un activo o pasivo exterior por categorías funcionales: secuencia de preguntas.
% Anexo II.6. Fuente: FMI (2009), cap. 6; BdE, nota metodológica.
\begin{tikzpicture}[
  font=\footnotesize,
  >={Stealth[length=2mm]},
  every node/.append style={execute at begin node={\hyphenpenalty=10000\exhyphenpenalty=10000}},
  preg/.style={draw, rounded corners=2pt, fill=white, align=center, text width=8.4cm, inner sep=3pt, minimum height=0.95cm},
  cat/.style={draw, rounded corners=2pt, fill=blue!5, align=center, text width=4.5cm, inner sep=3pt, minimum height=0.95cm, font=\footnotesize\bfseries},
  res/.style={draw, rounded corners=2pt, fill=blue!5, align=left, text width=8.4cm, inner sep=3pt},
  si/.style={font=\scriptsize, above},
  no/.style={font=\scriptsize, right},
]
\node[preg, fill=black!5] (ini) at (4.4,10.3) {Activo o pasivo financiero de un residente frente a un no residente};
\node[preg] (q1) at (4.4,8.65) {¿Es un activo exterior que las autoridades monetarias controlan y del que pueden disponer de inmediato?};
\node[cat] (c1) at (13.25,8.65) {Activos de reserva};
\node[preg] (q2) at (4.4,6.95) {¿Hay una relación de inversión directa: al menos el $10\%$ de los votos, directa o indirectamente, o empresas de un mismo grupo?};
\node[cat] (c2) at (13.25,6.95) {Inversión directa};
\node[preg] (q3) at (4.4,5.25) {¿Es un derivado financiero o una opción sobre acciones concedida a empleados?};
\node[cat] (c3) at (13.25,5.25) {Derivados financieros};
\node[preg] (q4) at (4.4,3.55) {¿Es un valor negociable: una acción, una participación en un fondo de inversión o un valor de deuda?};
\node[cat] (c4) at (13.25,3.55) {Inversión de cartera};
\node[res] (c5) at (4.4,1.65) {\textbf{Otra inversión}: otras participaciones en el capital, efectivo y depósitos, préstamos, seguros y pensiones, créditos comerciales y anticipos, otras cuentas pendientes y asignaciones de DEG};
\draw[->, thick] (ini) -- (q1);
\foreach \a/\b in {q1/q2, q2/q3, q3/q4, q4/c5} \draw[->, thick] (\a) -- node[no] {no} (\b);
\foreach \a/\b in {q1/c1, q2/c2, q3/c3, q4/c4} \draw[->, thick] (\a) -- node[si] {sí} (\b);
\end{tikzpicture}%
