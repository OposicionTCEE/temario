% Cuerpo, apartado 2.3.2: partida cuádruple en la balanza de pagos con el ejemplo conductor del bloque: una exportación
% española a Estados Unidos, por valor x, cobrada en un depósito en un banco estadounidense. Versión del cuerpo de
% anx_partida_cuadruple, sin leyenda explicativa; la mitad izquierda es b1_partida_doble (2.3.1). Convención de las
% cuentas en T del bloque II: débitos a la izquierda y créditos a la derecha. En España, la exportación es un crédito y
% el depósito, un débito; en Estados Unidos, la importación es un débito y el pasivo del banco, un crédito.
% Fuente: FMI (2009), cap. 3.
\begin{tikzpicture}[
  font=\footnotesize,
  >={Stealth[length=2mm]},
  every node/.append style={execute at begin node={\hyphenpenalty=10000\exhyphenpenalty=10000}},
  tit/.style={font=\footnotesize\bfseries, align=center},
  cab/.style={font=\scriptsize\bfseries, align=center},
  cta/.style={font=\scriptsize, align=center, rotate=90, text=black!70},
  ent/.style={font=\scriptsize, align=center, text width=2.45cm, fill=white, draw, rounded corners=1.5pt, inner sep=2pt},
  enl/.style={<->, dashed},
  rot/.style={font=\scriptsize, fill=white, inner sep=1.5pt, align=center},
]
% ---------------- Balanza de pagos de España (izquierda)
\node[tit] at (3.2,2.35) {Balanza de pagos de España};
\node[cab] at (1.6,1.85) {Débitos};
\node[cab] at (4.8,1.85) {Créditos};
\draw[thick] (0,1.6) -- (6.4,1.6);
\draw[thick] (3.2,1.6) -- (3.2,-1.75);
\draw[black!35] (0,0) -- (6.4,0);
\node[cta] at (-0.4,0.8) {Cuenta\\ corriente};
\node[cta] at (-0.4,-0.88) {Cuenta\\ financiera};
\node[ent] (esX) at (4.8,0.65) {Exportación\\ de bienes, $x$};
\node[ent] (esA) at (1.6,-1.05) {Depósito en un banco\\ estadounidense, $\Delta AF=+x$};
\draw[<->, thick] (esX.west) to[out=180, in=90] node[pos=0.3, above left=1pt, font=\scriptsize] {partida doble} (esA.north);
% ---------------- Balanza de pagos de Estados Unidos (derecha)
\node[tit] at (11.0,2.35) {Balanza de pagos de Estados Unidos};
\node[cab] at (9.4,1.85) {Débitos};
\node[cab] at (12.6,1.85) {Créditos};
\draw[thick] (7.8,1.6) -- (14.2,1.6);
\draw[thick] (11.0,1.6) -- (11.0,-1.75);
\draw[black!35] (7.8,0) -- (14.2,0);
\node[cta] at (14.6,0.8) {Cuenta\\ corriente};
\node[cta] at (14.6,-0.88) {Cuenta\\ financiera};
\node[ent] (usM) at (9.4,0.65) {Importación\\ de bienes, $x$};
\node[ent] (usP) at (12.6,-1.05) {Depósito de un no\\ residente, $\Delta P=+x$};
\draw[<->, thick] (usM.east) to[out=0, in=90] node[pos=0.3, above right=1pt, font=\scriptsize] {partida doble} (usP.north);
% ---------------- La misma transacción y el mismo instrumento, anotados por la otra economía en el lado contrario
\draw[enl] (esX.east) -- (usM.west) node[midway, above=2pt, font=\scriptsize, align=center] {la misma\\ transacción};
\draw[enl] (esA.south) -- ++(0,-0.5) -| (usP.south) node[pos=0.25, rot] {el mismo instrumento};
\end{tikzpicture}%
