% Cuerpo, apartado 1.3.2: partida cuádruple en la balanza de pagos con el ejemplo conductor del bloque: una exportación
% española a Estados Unidos, por valor x, cobrada en un depósito en un banco estadounidense. Versión del cuerpo de
% anx_partida_cuadruple, sin leyenda explicativa. Fuente: FMI (2009), cap. 3.
\begin{tikzpicture}[
  font=\footnotesize,
  >={Stealth[length=2mm]},
  every node/.append style={execute at begin node={\hyphenpenalty=10000\exhyphenpenalty=10000}},
  tit/.style={font=\footnotesize\bfseries, align=center},
  cab/.style={font=\scriptsize\bfseries, align=center},
  ent/.style={font=\scriptsize, align=center, text width=2.45cm, fill=white, draw, rounded corners=1.5pt, inner sep=2pt},
]
% ---------------- España
\node[tit] at (3.4,6.75) {Balanza de pagos de España};
\node[cab] at (3.4,6.1) {Cuenta corriente: bienes};
\draw[thick] (0.5,5.85) -- (6.3,5.85);
\draw[thick] (3.4,5.85) -- (3.4,4.35);
\node[cab] at (1.95,5.6) {Crédito};
\node[cab] at (4.85,5.6) {Débito};
\node[ent] (esX) at (1.95,4.85) {Exportación\\ de bienes, $x$};
\node[cab] at (3.4,3.55) {Cuenta financiera: otra inversión};
\draw[thick] (0.5,3.3) -- (6.3,3.3);
\draw[thick] (3.4,3.3) -- (3.4,1.8);
\node[cab] at (1.95,3.05) {$\Delta AF$};
\node[cab] at (4.85,3.05) {$\Delta P$};
\node[ent] (esA) at (1.95,2.3) {Depósito en un banco\\ estadounidense, $+x$};
% ---------------- Estados Unidos
\node[tit] at (12.3,6.75) {Balanza de pagos de Estados Unidos};
\node[cab] at (12.3,6.1) {Cuenta corriente: bienes};
\draw[thick] (9.4,5.85) -- (15.2,5.85);
\draw[thick] (12.3,5.85) -- (12.3,4.35);
\node[cab] at (10.85,5.6) {Crédito};
\node[cab] at (13.75,5.6) {Débito};
\node[ent] (usM) at (13.75,4.85) {Importación\\ de bienes, $x$};
\node[cab] at (12.3,3.55) {Cuenta financiera: otra inversión};
\draw[thick] (9.4,3.3) -- (15.2,3.3);
\draw[thick] (12.3,3.3) -- (12.3,1.8);
\node[cab] at (10.85,3.05) {$\Delta AF$};
\node[cab] at (13.75,3.05) {$\Delta P$};
\node[ent] (usP) at (13.75,2.3) {Depósito de un\\ no residente, $+x$};
% ---------------- Partida doble (vertical) y contrapartida en la otra economía (horizontal)
\draw[<->, thick] (esX.west) -- ++(-0.28,0) |- (esA.west);
\node[font=\scriptsize, rotate=90] at (0.12,3.575) {partida doble};
\draw[<->, thick] (usM.east) -- ++(0.28,0) |- (usP.east);
\node[font=\scriptsize, rotate=-90] at (15.58,3.575) {partida doble};
\draw[<->, dashed] (esX.east) -- (usM.west) node[pos=0.5, fill=white, inner sep=1.5pt, font=\scriptsize] {la misma transacción};
\draw[<->, dashed] (esA.east) -- (usP.west) node[pos=0.5, fill=white, inner sep=1.5pt, font=\scriptsize] {el mismo instrumento};
\end{tikzpicture}%
