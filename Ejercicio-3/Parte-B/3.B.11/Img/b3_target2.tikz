% Cuerpo, 4.2.3: la parada súbita en una unión monetaria vista en los balances. Un banco español devuelve un préstamo,
% x, a un banco extranjero; el pago se liquida en TARGET2 y el Banco de España contrae un pasivo frente al Eurosistema
% de la misma cuantía. En la balanza de España, la otra inversión del sector privado registra ΔP = -x y la del Banco de
% España ΔP = +x: la cuenta financiera no cambia, cambia quién financia. Adaptada de Img/anx_target2 (anexo II.7.2).
% Fuente: FMI (2009); BANCO DE ESPAÑA (s. f.).
\begin{tikzpicture}[
  font=\footnotesize,
  >={Stealth[length=1.8mm]},
  every node/.append style={execute at begin node={\hyphenpenalty=10000\exhyphenpenalty=10000}},
  tit/.style={font=\footnotesize\bfseries},
  cab/.style={font=\scriptsize\itshape, text=black!65},
  ent/.style={anchor=north, align=center, text width=2.25cm, inner sep=1pt},
]
% Flecha del pago
\draw[->, thick, black!60] (0.3,1.55) -- (15.3,1.55)
  node[midway, above, font=\footnotesize] {devolución del préstamo, $x$, liquidada en TARGET2};
% Tres balances en T (ancho 4,9 cm; separación 0,45 cm)
\foreach \x/\t in {0/{Banco español}, 5.35/{Banco de España}, 10.7/{Eurosistema}}{
  \node[tit] at (\x+2.45,0.95) {\t};
  \node[cab] at (\x+1.225,0.45) {Activo};
  \node[cab] at (\x+3.675,0.45) {Pasivo};
  \draw[thick] (\x,0.2) -- (\x+4.9,0.2);
  \draw[thick] (\x+2.45,0.2) -- (\x+2.45,-2.3);
}
% Banco español
\node[ent] at (1.225,0)  {Reservas en el Banco de España, $-x$};
\node[ent] at (3.675,0)  {Préstamo de un banco extranjero, $-x$};
% Banco de España
\node[ent] at (8.025,0)  {Reservas del banco español, $-x$};
\node[ent] at (8.025,-1.05) {Pasivo frente al Eurosistema, $+x$};
% Eurosistema
\node[ent] at (11.925,0) {Activo frente al Banco de España, $+x$};
\node[ent] at (14.375,0) {Pasivo frente al banco central del acreedor, $+x$};
% La anotación en la balanza de pagos de España
\node[draw=black!60, fill=black!5, align=left, text width=14.6cm, inner sep=4pt, anchor=north] at (7.8,-2.65)
  {\textbf{Balanza de pagos de España}, otra inversión: sector privado, $\Delta P=-x$; Banco de España, $\Delta P=+x$; saldo de la cuenta financiera, $CF$, sin cambio.};
\end{tikzpicture}%
