% Residencia frente a nacionalidad: una empresa de un país emergente X emite bonos en dólares a través de una filial
% financiera residente en un centro financiero Y y presta los fondos a su matriz. Qué anota la balanza de cada país
% (MBP6, presentación por activos y pasivos) y qué debe el grupo consolidado. Anexo III.5.2.
% Fuente: AVDJIEV, McCAULEY y SHIN (2016); FMI (2009), cap. 6.
\begin{tikzpicture}[
  font=\scriptsize,
  >={Stealth[length=2mm]},
  every node/.append style={execute at begin node={\hyphenpenalty=10000\exhyphenpenalty=10000}},
  tit/.style={font=\scriptsize\bfseries, align=center},
  ent/.style={draw, fill=white, align=center, text width=2.5cm, minimum height=0.9cm, inner sep=3pt},
  flujo/.style={fill=white, align=center, inner sep=1.5pt},
  bp/.style={draw, rounded corners=2pt, fill=blue!5, align=left, text width=4.1cm, inner sep=3pt},
]
% Países: marcos de residencia (anchura 4,4; separación 1,2)
\foreach \x/\n in {0/País X (emergente), 5.6/Centro financiero Y, 11.2/Resto del mundo Z}{
  \draw[thick, rounded corners=3pt] (\x-2.2,0) rectangle (\x+2.2,-2.7);
  \node[tit] at (\x,-0.3) {\n};
}
% Entidades
\node[ent] (mat) at (0,-1.65) {Empresa matriz, con ingresos en moneda nacional};
\node[ent] (fil) at (5.6,-1.65) {Filial financiera de la empresa};
\node[ent] (inv) at (11.2,-1.65) {Inversores en bonos};
% Grupo consolidado: la nacionalidad atraviesa la frontera de residencia
\draw[dashed, rounded corners=4pt] (-1.55,-0.75) rectangle (7.15,-2.45);
% Flujos
\draw[->, thick] (inv.west) -- (fil.east) node[flujo, midway, above=2pt] {(1) compran bonos\\ en dólares, $x$};
\draw[->, thick] (fil.west) -- (mat.east) node[flujo, midway, above=2pt] {(2) préstamo dentro\\ del grupo, $x$};
% Lo que ve la vista consolidada
\node[font=\scriptsize\itshape, align=center] at (2.8,-3.05) {Grupo de nacionalidad X (vista consolidada): debe $x$ en dólares a inversores de Z};
% Lo que anota cada balanza
\node[bp, anchor=north] at (0,-3.45) {\textbf{Balanza de X}: inversión directa, $\Delta P=+x$, una deuda frente a la propia filial.};
\node[bp, anchor=north] at (5.6,-3.45) {\textbf{Balanza de Y}: inversión de cartera, $\Delta P=+x$ (los bonos); inversión directa, $\Delta AF=+x$ (el préstamo a la matriz).};
\node[bp, anchor=north] at (11.2,-3.45) {\textbf{Balanza de Z}: inversión de cartera, $\Delta AF=+x$, frente a emisores de Y.};
\end{tikzpicture}%
