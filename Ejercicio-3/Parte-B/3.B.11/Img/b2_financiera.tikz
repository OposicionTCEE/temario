% Cuerpo, apartado 3.3.2: el cuadro de la balanza se completa con la cuenta financiera por categorías funcionales y
% con los errores y omisiones. Tercera fase del cuadro (b2_corriente → b2_capital → b2_financiera); lo ya visto, en gris.
% Subíndices: ID, inversión directa; IC, inversión de cartera; OI, otra inversión; AR, activos de reserva.
% Fuente: FMI (2009).
\begin{tikzpicture}[
  font=\footnotesize,
  every node/.append style={execute at begin node={\hyphenpenalty=10000\exhyphenpenalty=10000}},
  cab/.style={font=\footnotesize\bfseries, align=center},
  rub/.style={anchor=west, align=left},
  tot/.style={anchor=west, font=\footnotesize\bfseries},
  vis/.style={text=black!50},
]
\draw[thick] (0,0.4) -- (15.6,0.4);
\node[cab, anchor=west] at (0.1,0) {Rúbrica};
\node[cab] at (10.9,0) {Saldo};
\draw (0,-0.32) -- (15.6,-0.32);
% Lo ya visto
\node[rub, vis] at (0.1,-0.7) {Capacidad ($+$) o necesidad ($-$) de financiación};
\node[vis] at (10.9,-0.7) {$CNF=CC+CK$};
\draw (0,-1.0) -- (15.6,-1.0);
% Cuenta financiera
\node[cab, anchor=west] at (0.1,-1.45) {Cuenta financiera};
\node[cab] at (6.3,-1.45) {Adquisición neta\\ de activos};
\node[cab] at (8.7,-1.45) {Contracción neta\\ de pasivos};
\draw[black!40] (0,-1.9) -- (15.6,-1.9);
\node[rub] at (0.1,-2.25) {Inversión directa};
\node at (6.3,-2.25) {$\Delta AF_{ID}$}; \node at (8.7,-2.25) {$\Delta P_{ID}$};
\node[rub] at (0.1,-2.8) {Inversión de cartera};
\node at (6.3,-2.8) {$\Delta AF_{IC}$}; \node at (8.7,-2.8) {$\Delta P_{IC}$};
\node[rub] at (0.1,-3.35) {Derivados financieros};
\node at (7.5,-3.35) {solo en neto};
\node[rub] at (0.1,-3.9) {Otra inversión};
\node at (6.3,-3.9) {$\Delta AF_{OI}$}; \node at (8.7,-3.9) {$\Delta P_{OI}$};
\node[rub] at (0.1,-4.45) {Activos de reserva};
\node at (6.3,-4.45) {$\Delta AF_{AR}$}; \node at (8.7,-4.45) {---};
\draw[black!40] (0,-4.75) -- (15.6,-4.75);
\node[tot] at (0.1,-5.1) {Saldo de la cuenta financiera};
\node at (6.3,-5.1) {$\Delta AF$}; \node at (8.7,-5.1) {$\Delta P$}; \node at (10.9,-5.1) {$CF=\Delta AF-\Delta P$};
\draw[black!40] (0,-5.4) -- (15.6,-5.4);
\node[tot] at (0.1,-5.75) {Errores y omisiones};
\node at (10.9,-5.75) {$EO=CF-CNF$};
\draw[thick] (0,-6.1) -- (15.6,-6.1);
\end{tikzpicture}%
