% Cuerpo, apartado 4.1.1: conciliación de la PII en cascada horizontal, en letras; se lee de arriba abajo. Una economía
% deudora presta en el periodo (CF_t > 0) y, aun así, su posición empeora porque las revalorizaciones son negativas.
% Recupera la cascada de la primera versión del bloque (b2_pii, de columnas), con las barras en horizontal para que
% ocupe menos alto (17/11/2026). Longitudes solo ilustrativas; RV^tc y RV^p, como en la notación de los anexos.
% Fuente: FMI (2009), cap. 7 y 9.
\begin{tikzpicture}[
  font=\footnotesize,
  every node/.append style={execute at begin node={\hyphenpenalty=10000\exhyphenpenalty=10000}},
  stock/.style={fill=black!45, draw=black!80},
  sube/.style={fill=white, draw=black!80},
  baja/.style={fill=black!18, draw=black!80},
  conec/.style={densely dashed, black!50},
  eti/.style={anchor=east},
]
% Escala: 1 unidad de posición = 2,1 cm; posición nula en x = 0 (una posición deudora se dibuja a la izquierda).
% Filas cada 0,65 cm (centros en 0; -0,65; ...; -3,25); barras de 0,44 cm de alto.
% Valores: PII_{t-1} = -4,0; CF = +1,2; RV^tc = -0,8; RV^p = -0,9; OV = +0,2; PII_t = -4,3.
% ---------------- Conectores (debajo de las barras)
\draw[conec] (-8.40,0) -- (-8.40,-0.65);
\draw[conec] (-5.88,-0.65) -- (-5.88,-1.30);
\draw[conec] (-7.56,-1.30) -- (-7.56,-1.95);
\draw[conec] (-9.45,-1.95) -- (-9.45,-2.60);
\draw[conec] (-9.03,-2.60) -- (-9.03,-3.25);
% ---------------- Barras
\draw[stock] (0,0.22) rectangle (-8.40,-0.22);        \node[text=white] at (-4.20,0) {$PII_{t-1}$};
\draw[sube]  (-8.40,-0.43) rectangle (-5.88,-0.87);   \node at (-7.14,-0.65) {$CF_t>0$};
\draw[baja]  (-5.88,-1.08) rectangle (-7.56,-1.52);   \node at (-6.72,-1.30) {$RV^{tc}_t<0$};
\draw[baja]  (-7.56,-1.73) rectangle (-9.45,-2.17);   \node at (-8.505,-1.95) {$RV^{p}_t<0$};
\draw[sube]  (-9.45,-2.38) rectangle (-9.03,-2.82);   \node[anchor=west] at (-8.95,-2.60) {$OV_t$};
\draw[stock] (0,-3.03) rectangle (-9.03,-3.47);       \node[text=white] at (-4.515,-3.25) {$PII_t$};
% ---------------- Posición nula
\draw[thick] (0,0.45) -- (0,-3.70);
\node[font=\scriptsize, anchor=south] at (0,0.45) {$PII=0$};
% ---------------- Rótulos de las filas
\node[eti] at (-9.75,0)     {PII al final de $t-1$};
\node[eti] at (-9.75,-0.65) {Transacciones: cuenta financiera};
\node[eti] at (-9.75,-1.30) {Revalorizaciones por tipo de cambio};
\node[eti] at (-9.75,-1.95) {Revalorizaciones por otros precios};
\node[eti] at (-9.75,-2.60) {Otros cambios del volumen};
\node[eti] at (-9.75,-3.25) {PII al final de $t$};
\end{tikzpicture}%
