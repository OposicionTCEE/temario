% Tres casos en que las aduanas y la balanza de pagos registran distinto el comercio de bienes:
% (a) transformación sin cambio de propiedad, (b) compraventa (merchanting), (c) reexportación.
% Anexo II.1.2. Sustituye a Merchant_Trading.png (Eurostat). Fuente: FMI (2009), cap. 10; BdE, nota metodológica.
\begin{tikzpicture}[
  font=\footnotesize,
  >={Stealth[length=2mm]},
  every node/.append style={execute at begin node={\hyphenpenalty=10000\exhyphenpenalty=10000}},
  pais/.style={draw, rounded corners=2pt, fill=black!5, minimum width=1.25cm, minimum height=0.6cm, inner sep=2pt, font=\scriptsize\bfseries},
  merc/.style={->, thick},
  prop/.style={->, dashed},
  tit/.style={font=\footnotesize\bfseries, align=center},
  txt/.style={font=\scriptsize, align=left, text width=4.75cm, anchor=north west},
]
% ================= (a) Transformación
\node[tit] at (2.55,5.35) {(a) Transformación};
\node[pais] (es1) at (0.95,3.6) {España};
\node[pais] (ma1) at (4.15,3.6) {Marruecos};
\draw[merc] (es1.north east) to[bend left=25] node[midway, above, font=\scriptsize] {tejido} (ma1.north west);
\draw[merc] (ma1.south west) to[bend left=25] node[midway, below, font=\scriptsize] {prendas} (es1.south east);
\node[txt] at (0.2,2.25) {Propiedad: no cambia; el tejido y las prendas son de la empresa española.\\[2pt]
\textbf{Aduanas:} exportación de tejido e importación de prendas, por su valor.\\[2pt]
\textbf{Balanza de España:} importación del servicio de transformación, por la tarifa.};
% ================= (b) Compraventa
\node[tit] at (7.9,5.35) {(b) Compraventa};
\node[pais] (ch2) at (6.1,4.35) {China};
\node[pais] (es2) at (7.9,3.05) {España};
\node[pais] (us2) at (9.7,4.35) {EE.\,UU.};
\draw[merc] (ch2.east) -- node[midway, above, font=\scriptsize] {mercancía} (us2.west);
\draw[prop] (ch2.south) |- node[pos=0.75, below, font=\scriptsize] {compra} (es2.west);
\draw[prop] (es2.east) -| node[pos=0.25, below, font=\scriptsize] {venta} (us2.south);
\node[txt] at (5.55,2.25) {Propiedad: pasa de China a España y de España a EE.\,UU.; la mercancía no entra en España.\\[2pt]
\textbf{Aduanas españolas:} nada.\\[2pt]
\textbf{Balanza de España:} exportación de bienes por el margen, venta menos compra.};
% ================= (c) Reexportación
\node[tit] at (13.25,5.35) {(c) Reexportación};
\node[pais] (ch3) at (11.45,3.6) {China};
\node[pais] (es3) at (13.25,3.6) {España};
\node[pais] (us3) at (15.05,3.6) {EE.\,UU.};
\draw[merc] (ch3.east) -- (es3.west);
\draw[merc] (es3.east) -- (us3.west);
\draw[prop] (ch3.north) to[bend left=30] (es3.north);
\draw[prop] (es3.north) to[bend left=30] (us3.north);
\node[txt] at (10.9,2.25) {Propiedad: la adquiere un importador español, que la revende.\\[2pt]
\textbf{Aduanas:} importación y exportación, por su valor.\\[2pt]
\textbf{Balanza de España:} importación y exportación de bienes, por sus valores brutos.};
% ================= Leyenda
\draw[merc] (0.2,-0.35) -- ++(0.8,0); \node[font=\scriptsize, anchor=west] at (1.05,-0.35) {movimiento físico de la mercancía};
\draw[prop] (5.6,-0.35) -- ++(0.8,0); \node[font=\scriptsize, anchor=west] at (6.45,-0.35) {cambio de propiedad económica};
\end{tikzpicture}%
