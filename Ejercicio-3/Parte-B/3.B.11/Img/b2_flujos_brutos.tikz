% Cuerpo, apartado 3.4.3 (Flujos brutos): el viaje de ida y vuelta de los dólares a través de los bancos europeos antes de
% 2008. Adaptación de la figura 1 de SHIN (2012), «European global banks add intermediation capacity for connecting US
% savers and borrowers», con la frontera de residencia explícita (las sucursales en EE. UU. son residentes allí) y la
% cuenta financiera de la zona del euro en T debajo (débitos a la izquierda, créditos a la derecha, como en el bloque II):
% la deuda de las sedes con sus sucursales es una entrada (ΔP) y las titulizaciones compradas, una salida (ΔAF), del
% mismo importe, y el saldo es nulo. Fuente: SHIN (2012, sección 1 y figura 1); BORIO y DISYATAT (2011).
\begin{tikzpicture}[
  font=\footnotesize,
  >={Stealth[length=2mm]},
  every node/.append style={execute at begin node={\hyphenpenalty=10000\exhyphenpenalty=10000}},
  caja/.style={draw, rounded corners=2pt, fill=white, align=center, inner sep=3pt},
  reg/.style={font=\footnotesize\bfseries},
  eti/.style={font=\scriptsize, align=center},
  bruto/.style={->, very thick},
  local/.style={->, thick, black!55},
  cab/.style={font=\scriptsize\bfseries, align=center},
  ent/.style={font=\scriptsize, align=center, text width=4.1cm},
]
% ---------------- Regiones y frontera de residencia
\node[reg] at (3.7,3.45) {Estados Unidos};
\node[reg] at (12.5,3.45) {Zona del euro};
\draw[dashed, black!60] (8.55,3.7) -- (8.55,-0.75);
\node[font=\scriptsize, text=black!60] at (8.55,-0.95) {frontera de residencia};
% ---------------- Agentes
\node[caja, text width=2.75cm] (F) at (1.45,2.4) {Fondos del mercado\\ monetario de EE. UU.};
\node[caja, text width=2.7cm] (S) at (6.0,2.4) {Sucursales en EE. UU.\\ de los bancos europeos};
\node[caja, text width=2.4cm] (H) at (12.5,1.2) {Sedes de los\\ bancos europeos};
\node[caja, text width=2.7cm] (T) at (6.0,0.0) {Titulizaciones de\\ hipotecas de EE. UU.};
\node[caja, text width=2.75cm] (P) at (1.45,0.0) {Prestatarios\\ estadounidenses};
% ---------------- Flujos: los locales, en gris; los que cruzan la frontera, en negro (rótulos del lado de la zona del euro)
\draw[local] (F) -- node[eti, above=2pt] {dólares a\\ corto plazo} (S);
\draw[bruto] (S.east) -- node[eti, above=2pt, pos=0.7, sloped] {préstamo a la sede} node[eti, below=2pt, pos=0.7, sloped] {entrada, $\Delta P=+x$} (H.north west);
\draw[bruto] (H.south west) -- node[eti, above=2pt, pos=0.3, sloped] {compra de titulizaciones} node[eti, below=2pt, pos=0.3, sloped] {salida, $\Delta AF=+x$} (T.east);
\draw[local] (T) -- node[eti, below=2pt] {crédito\\ hipotecario} (P);
% ---------------- Cuenta financiera de la zona del euro, en T
\node[font=\footnotesize\bfseries] at (7.0,-1.55) {Cuenta financiera de la zona del euro};
\node[cab] at (4.75,-2.05) {Débitos: $\Delta AF$};
\node[cab] at (9.25,-2.05) {Créditos: $\Delta P$};
\draw[thick] (2.5,-2.3) -- (11.5,-2.3);
\draw[thick] (7.0,-2.3) -- (7.0,-3.35);
\node[ent] at (4.75,-2.8) {Titulizaciones de EE. UU., $+x$};
\node[ent] at (9.25,-2.8) {Deuda de las sedes con sus sucursales en EE. UU., $+x$};
\node[font=\small] at (7.0,-3.8) {$CF=\Delta AF-\Delta P=0$};
\end{tikzpicture}%
