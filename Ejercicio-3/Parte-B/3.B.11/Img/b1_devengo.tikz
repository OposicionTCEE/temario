% Cuerpo, apartado 1.4.1: el momento del registro en la balanza de pagos con el ejemplo conductor del bloque: la
% exportación española de valor x se entrega en t y se cobra en t+1. Adaptación de SCN_devengo (Tema 3.A.30) a una
% operación con un no residente, sin texto explicativo dentro de la figura. Fuente: FMI (2009), cap. 3; SEC 2010.
\begin{tikzpicture}[>=stealth,
  every node/.append style={execute at begin node={\hyphenpenalty=10000\exhyphenpenalty=10000}},
  cj/.style={draw=black!65, rounded corners=3pt, fill=#1, align=left, font=\footnotesize, text width=5.6cm, inner sep=4pt},
  cj/.default=white]
  % Eje temporal
  \draw[->, line width=0.8pt] (-0.5,0) -- (14,0) node[right, font=\footnotesize] {tiempo};
  \foreach \x/\t in {2.9/{Periodo $t$: la empresa española entrega\\ el bien al importador estadounidense}, 10.4/{Periodo $t+1$: el importador paga}} {
    \fill[black!70] (\x,0) circle (2.5pt);
    \node[above=4pt, font=\small\bfseries, align=center] at (\x,0) {\t};
  }
  % Periodo t
  \node[cj=blue!8, anchor=north] (a1) at (2.9,-0.45) {\textbf{Cuenta corriente}\\ crédito de bienes, $x$};
  \node[cj=red!8, anchor=north] (a2) at ([yshift=-0.25cm]a1.south) {\textbf{Cuenta financiera}\\ otra inversión: crédito comercial\\ concedido al importador, $\Delta AF=+x$};
  % Periodo t+1
  \node[cj=black!3, anchor=north, text=black!60] (b1) at (10.4,-0.45) {\textbf{Cuenta corriente}\\ sin anotaciones};
  \node[cj=red!8, anchor=north] (b2) at ([yshift=-0.25cm]b1.south) {\textbf{Cuenta financiera}\\ otra inversión: crédito comercial, $\Delta AF=-x$\\ otra inversión: depósito, $\Delta AF=+x$};
  \draw[->, dashed, line width=0.8pt, red!55!black] (a2.east) -- node[below=2pt, font=\scriptsize, text=red!55!black, align=center] {el crédito se\\ cancela al cobrar} (b2.west);
\end{tikzpicture}%
