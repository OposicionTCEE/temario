% Cuerpo, apartado 4.2.2: parada súbita en una unión monetaria. Con la misma necesidad de financiación, CF = -d, la
% financiación pasa de las entradas privadas, +d, a los pasivos del banco central frente al sistema de pagos común
% (TARGET2), +(d+r), mientras los no residentes retiran r. Alturas solo ilustrativas.
% Fuente: FMI (2009); BANCO DE ESPAÑA (s. f.).
\begin{tikzpicture}[
  font=\footnotesize,
  every node/.append style={execute at begin node={\hyphenpenalty=10000\exhyphenpenalty=10000}},
  priv/.style={fill=black!45, draw=black!80},
  bcn/.style={fill=black!15, draw=black!80},
  sal/.style={fill=white, draw=black!80, densely dashed},
  eti/.style={font=\scriptsize, align=center, text width=2.2cm, anchor=north},
]
% ---------------- (a) Financiación privada
\begin{scope}
  \node[font=\footnotesize\bfseries] at (3.3,3.4) {(a) Financiación privada};
  \draw[thick] (0,0) -- (6.6,0);
  \draw[priv] (0.6,0) rectangle (1.8,2.0);     \node[text=white] at (1.2,1.0) {$+d$};
  \draw[bcn]  (2.7,0) rectangle (3.9,0.06);    \node[anchor=south] at (3.3,0.06) {$0$};
  \draw[sal]  (4.8,0) rectangle (6.0,-2.0);    \node at (5.4,-1.0) {$-d$};
  \node[eti] at (1.2,-2.3) {Entradas privadas:\\ $\Delta P$ sin el banco central};
  \node[eti] at (3.3,-2.3) {Pasivos del banco\\ central (TARGET2)};
  \node[eti] at (5.4,-2.3) {Saldo de la cuenta\\ financiera, $CF$};
\end{scope}
% ---------------- (b) Parada súbita
\begin{scope}[xshift=8.6cm]
  \node[font=\footnotesize\bfseries] at (3.3,3.4) {(b) Parada súbita en una unión monetaria};
  \draw[thick] (0,0) -- (6.6,0);
  \draw[priv] (0.6,0) rectangle (1.8,-1.0);    \node[text=white] at (1.2,-0.5) {$-r$};
  \draw[bcn]  (2.7,0) rectangle (3.9,3.0);     \node at (3.3,1.5) {$+(d+r)$};
  \draw[sal]  (4.8,0) rectangle (6.0,-2.0);    \node at (5.4,-1.0) {$-d$};
  \node[eti] at (1.2,-2.3) {Entradas privadas:\\ $\Delta P$ sin el banco central};
  \node[eti] at (3.3,-2.3) {Pasivos del banco\\ central (TARGET2)};
  \node[eti] at (5.4,-2.3) {Saldo de la cuenta\\ financiera, $CF$};
\end{scope}
\end{tikzpicture}%
