% Economía pequeña y abierta: ahorro e inversión frente al tipo de interés mundial r*.
% El déficit corriente es I - S a r*. (a) cae el ahorro (S_0 -> S_1); (b) sube la inversión (I_0 -> I_1). Mismo déficit final, distinto significado.
% Rectas: I_0: r = 5 - x; S_0: r = 1 + x; r* = 2 (déficit inicial 2,0). S_1: r = 1,8 + x; I_1: r = 5,8 - x (déficit final 2,8 en ambos).
% Anexo III.2.2; base de la figura del cuerpo. Fuente: SACHS (1981); OBSTFELD y ROGOFF (1995).
\begin{tikzpicture}[
  font=\footnotesize,
  >={Stealth[length=2mm]},
  every node/.append style={execute at begin node={\hyphenpenalty=10000\exhyphenpenalty=10000}},
  curva/.style={thick},
  previa/.style={thin, black!45},
]
% ================= (a) Cae el ahorro
\begin{scope}
  \node[font=\footnotesize\bfseries] at (3.1,6.05) {(a) Cae el ahorro};
  \draw[->] (0,0) -- (6.4,0) node[below left] {$S,\ I$};
  \draw[->] (0,0) -- (0,5.7) node[above right] {$r$};
  \draw[curva] (0.3,4.7) -- (4.7,0.3) node[right] {$I_0$};
  \draw[previa] (0,1.0) -- (4.4,5.4) node[right] {$S_0$};
  \draw[curva] (0,1.8) -- (3.6,5.4) node[right] {$S_1$};
  \draw[->, black!60] (3.3,4.4) -- (2.75,4.95);
  \draw[dashed] (0,2) -- (5.9,2) node[right] {$r^*$};
  \fill (1.0,2) circle (1.3pt); \fill (0.2,2) circle (1.3pt); \fill (3.0,2) circle (1.3pt);
  \draw[decorate, decoration={brace, amplitude=4pt, mirror}] (0.2,1.8) -- (3.0,1.8) node[midway, below=5pt, align=center] {déficit corriente\\ $I_0-S_1$};
\end{scope}
% ================= (b) Sube la inversión
\begin{scope}[xshift=8.2cm]
  \node[font=\footnotesize\bfseries] at (3.1,6.05) {(b) Sube la inversión};
  \draw[->] (0,0) -- (6.4,0) node[below left] {$S,\ I$};
  \draw[->] (0,0) -- (0,5.7) node[above right] {$r$};
  \draw[previa] (0.3,4.7) -- (4.7,0.3) node[right] {$I_0$};
  \draw[curva] (0.4,5.4) -- (5.5,0.3) node[right] {$I_1$};
  \draw[curva] (0,1.0) -- (4.4,5.4) node[right] {$S_0$};
  \draw[->, black!60] (2.2,2.85) -- (2.75,3.4);
  \draw[dashed] (0,2) -- (5.9,2) node[right] {$r^*$};
  \fill (1.0,2) circle (1.3pt); \fill (3.0,2) circle (1.3pt); \fill (3.8,2) circle (1.3pt);
  \draw[decorate, decoration={brace, amplitude=4pt, mirror}] (1.0,1.8) -- (3.8,1.8) node[midway, below=5pt, align=center] {déficit corriente\\ $I_1-S_0$};
\end{scope}
\end{tikzpicture}%
