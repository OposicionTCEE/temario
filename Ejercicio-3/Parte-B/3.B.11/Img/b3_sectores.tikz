% Cuerpo, apartado 4.1.2: saldos sectoriales, que suman cero con el resto del mundo. (a) Déficits gemelos: el déficit
% público, -d, se traslada al exterior. (b) Déficit exterior privado con superávit público, s, como en España antes de
% 2008. Barras en letras, alturas solo ilustrativas. Fuente: contabilidad nacional (SEC 2010); GODLEY (1999).
\begin{tikzpicture}[
  font=\footnotesize,
  every node/.append style={execute at begin node={\hyphenpenalty=10000\exhyphenpenalty=10000}},
  priv/.style={fill=black!45, draw=black!80},
  pub/.style={fill=black!15, draw=black!80},
  rm/.style={fill=white, draw=black!80},
  eti/.style={font=\scriptsize, align=center, text width=2.1cm, anchor=north},
]
% ---------------- (a) Déficits gemelos
\begin{scope}
  \node[font=\footnotesize\bfseries] at (3.3,3.0) {(a) Déficits gemelos};
  \draw[thick] (0,0) -- (6.6,0);
  \draw[priv] (0.6,0) rectangle (1.8,0.06);           \node[anchor=south] at (1.2,0.06) {$\approx 0$};
  \draw[pub]  (2.7,0) rectangle (3.9,-2.0);           \node at (3.3,-1.0) {$-d$};
  \draw[rm]   (4.8,0) rectangle (6.0,2.0);            \node at (5.4,1.0) {$+d$};
  \node[eti] at (1.2,-3.05) {Sector privado\\ $S_{priv}-I_{priv}$};
  \node[eti] at (3.3,-3.05) {Administraciones\\ públicas, $S_G-I_G$};
  \node[eti] at (5.4,-3.05) {Resto del mundo\\ $-CC$};
\end{scope}
% ---------------- (b) Déficit exterior privado con superávit público
\begin{scope}[xshift=8.6cm]
  \node[font=\footnotesize\bfseries] at (3.3,3.0) {(b) Déficit exterior con superávit público};
  \draw[thick] (0,0) -- (6.6,0);
  \draw[priv] (0.6,0) rectangle (1.8,-2.8);           \node[text=white] at (1.2,-1.4) {$-(s+d)$};
  \draw[pub]  (2.7,0) rectangle (3.9,0.8);            \node at (3.3,0.4) {$+s$};
  \draw[rm]   (4.8,0) rectangle (6.0,2.0);            \node at (5.4,1.0) {$+d$};
  \node[eti] at (1.2,-3.05) {Sector privado\\ $S_{priv}-I_{priv}$};
  \node[eti] at (3.3,-3.05) {Administraciones\\ públicas, $S_G-I_G$};
  \node[eti] at (5.4,-3.05) {Resto del mundo\\ $-CC$};
\end{scope}
\end{tikzpicture}%
