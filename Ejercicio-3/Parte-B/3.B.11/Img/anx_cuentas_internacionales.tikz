% Sistema integrado de cuentas internacionales: PII inicial + transacciones financieras + otras variaciones = PII final.
% Base común del tema (anexo I.2; se adapta en el cuerpo). Fuente: FMI (2009), cap. 2; BdE, nota metodológica.
\begin{tikzpicture}[
  font=\footnotesize,
  >={Stealth[length=2.2mm]},
  bloque/.style={draw, rounded corners=3pt, thick},
  caja/.style={draw, rounded corners=2pt, fill=white, align=center, inner sep=2.5pt},
  titulo/.style={font=\footnotesize\bfseries, align=center},
  pie/.style={font=\scriptsize, align=center},
]
% ---------------- PII inicial
\draw[bloque, fill=black!6] (0,0.6) rectangle (2.9,5.9);
\node[titulo] at (1.45,5.35) {PII al final\\ de $t-1$};
\node[caja, text width=2.45cm] at (1.45,4.25) {Activos exteriores\\ $AF_{t-1}$};
\node[caja, text width=2.45cm] at (1.45,3.05) {Pasivos exteriores\\ $P_{t-1}$};
\node[align=center] at (1.45,1.55) {Posición neta\\ $PII_{t-1}$\\ $=AF_{t-1}-P_{t-1}$};
% ---------------- Balanza de pagos
\draw[bloque, fill=blue!5] (3.4,3.1) rectangle (12.5,7.9);
\node[titulo] at (7.95,7.5) {Balanza de pagos: transacciones del periodo $t$};
\node[caja, text width=3.3cm, minimum height=1.45cm] (cc) at (5.3,6.25) {\textbf{Cuenta corriente}, $CC$\\[1pt] {\scriptsize bienes y servicios, renta primaria\\ y renta secundaria}};
\node[caja, text width=3.3cm, minimum height=1.45cm] (ka) at (5.3,4.45) {\textbf{Cuenta de capital}, $KA$\\[1pt] {\scriptsize transferencias de capital y activos\\ no financieros no producidos}};
\draw[decorate, decoration={brace, amplitude=5pt}, thick] (7.15,7.0) -- (7.15,3.7);
\node[pie, anchor=west] (cf) at (7.35,5.6) {capacidad ($+$)\\ o necesidad ($-$)\\ de financiación\\[3pt] {\footnotesize $CF=CC+KA$}};
\node[caja, text width=2.55cm, minimum height=3.3cm] (fa) at (10.9,5.35) {\textbf{Cuenta financiera}\\[1pt] $FA=\Delta AF-\Delta P$\\[3pt] {\scriptsize inversión directa,\\ inversión de cartera,\\ derivados financieros,\\ otra inversión y\\ activos de reserva}};
\node[pie, align=center] at (8.35,4.05) {$FA=CF+EO$\\ {\scriptsize errores y}\\ {\scriptsize omisiones}};
% ---------------- Otras variaciones
\draw[bloque, fill=black!4] (3.4,0) rectangle (12.5,2.55);
\node[titulo] at (7.95,2.2) {Otras variaciones de los activos y pasivos financieros};
\node[caja, text width=2.55cm, minimum height=1.05cm] at (4.95,1.0) {Revalorizaciones por\\ tipo de cambio, $RV^{tc}$};
\node[caja, text width=2.55cm, minimum height=1.05cm] at (7.95,1.0) {Revalorizaciones por\\ otros precios, $RV^{p}$};
\node[caja, text width=2.55cm, minimum height=1.05cm] at (10.95,1.0) {Otros cambios\\ del volumen, $OV$};
% ---------------- PII final
\draw[bloque, fill=black!6] (13.0,0.6) rectangle (15.9,5.9);
\node[titulo] at (14.45,5.35) {PII al final\\ de $t$};
\node[caja, text width=2.45cm] at (14.45,4.25) {Activos exteriores\\ $AF_{t}$};
\node[caja, text width=2.45cm] at (14.45,3.05) {Pasivos exteriores\\ $P_{t}$};
\node[align=center] at (14.45,1.55) {Posición neta\\ $PII_{t}$\\ $=AF_{t}-P_{t}$};
% ---------------- Flechas: transacciones financieras y otros flujos llevan a la PII final
\draw[->, thick] (12.5,5.35) -- (13.0,4.65);
\draw[->, thick] (12.5,1.25) -- (13.0,2.45);
% ---------------- Identidad de conciliación
\draw[->, thick] (1.45,0.6) -- (1.45,-0.55) -- (14.45,-0.55) -- (14.45,0.6);
\node[fill=white, inner sep=2pt] at (7.95,-0.55) {$PII_t=PII_{t-1}+FA_t+RV_t+OV_t$};
\end{tikzpicture}%
