% Sectores institucionales: SEC 2010 frente a la balanza de pagos (MBP6; denominaciones del Banco de España).
% Anexo I.3.5. Diferencias como «≠ rasgo ⇒ implicación», sin color. Fuente: SEC 2010, cap. 2; FMI (2009), cap. 4; BdE, nota metodológica.
\begin{tikzpicture}[
  font=\footnotesize,
  >={Stealth[length=2mm]},
  every node/.append style={execute at begin node={\hyphenpenalty=10000\exhyphenpenalty=10000}},
  sec/.style={draw, rounded corners=2pt, fill=black!4, align=left, text width=4.75cm, inner sep=3pt},
  bp/.style={draw, rounded corners=2pt, fill=blue!5, align=left, text width=3.7cm, inner sep=3pt},
  dif/.style={align=left, text width=5.2cm, font=\scriptsize},
]
\node[font=\footnotesize\bfseries] at (2.5,7.75) {SEC 2010};
\node[font=\footnotesize\bfseries] at (8.15,7.75) {Balanza de pagos};
\node[font=\footnotesize\bfseries] at (13.3,7.75) {Diferencia};
% Fila 1: banco central
\node[sec] (s1) at (2.5,6.85) {S.121 Banco central};
\node[bp] (b1) at (8.15,6.85) {Banco central\\ {\scriptsize (en España, Banco de España)}};
\node[dif] at (13.3,6.85) {$\neq$ sector propio $\Rightarrow$ sus activos y pasivos exteriores, entre ellos las reservas y la posición frente al Eurosistema, se presentan aparte};
% Fila 2: instituciones financieras monetarias
\node[sec] (s2) at (2.5,5.2) {S.122 Sociedades de depósito, excepto el banco central\\ S.123 Fondos del mercado monetario};
\node[bp] (b2) at (8.15,5.2) {Otras instituciones financieras monetarias\\ {\scriptsize (MBP6: sociedades captadoras de depósitos, excepto el banco central)}};
\node[dif] at (13.3,5.2) {$\neq$ incluye los fondos del mercado monetario $\Rightarrow$ agrupa a quienes emiten pasivos que sustituyen a los depósitos, como en las estadísticas monetarias del Eurosistema};
% Fila 3: Administraciones públicas
\node[sec] (s3) at (2.5,3.6) {S.13 Administraciones públicas};
\node[bp] (b3) at (8.15,3.6) {Administraciones públicas};
\node[dif] at (13.3,3.6) {Mismo sector};
% Fila 4: otros sectores residentes
\node[sec] (s4) at (2.5,1.75) {S.11 Sociedades no financieras\\ S.124 a S.129 Otras instituciones financieras\\ S.14 Hogares\\ S.15 Instituciones sin fines de lucro al servicio de los hogares};
\node[bp] (b4) at (8.15,1.75) {Otros sectores residentes};
\node[dif] at (13.3,1.75) {$\neq$ reúne cuatro sectores del SEC en uno};
\foreach \i in {1,2,3,4} \draw[->, thick] (s\i.east) -- (b\i.west);
% Leyenda
\node[font=\scriptsize, align=left, anchor=west] at (0,0.2) {$\neq$ rasgo $\Rightarrow$ implicación: diferencia de la balanza de pagos respecto al SEC 2010 y su consecuencia.};
\end{tikzpicture}%
