% Cuerpo, apartado 4.3.4: las seis etapas de la balanza de pagos (CROWTHER, 1957). (a) Signos del saldo de bienes y
% servicios, del de rentas de la inversión y del saldo corriente en cada etapa; (b) la PII que acumulan. Alturas solo
% ilustrativas; el saldo corriente es la suma de los otros dos. Fuente: CROWTHER (1957); cuadro del anexo III.4.3.
\begin{tikzpicture}[
  font=\footnotesize,
  every node/.append style={execute at begin node={\hyphenpenalty=10000\exhyphenpenalty=10000}},
  bs/.style={fill=white, draw=black!80},
  ri/.style={fill=black!20, draw=black!80},
  cc/.style={fill=black!65, draw=black!80},
  sep/.style={densely dotted, black!45},
  eti/.style={font=\scriptsize, align=center, text width=2.1cm, anchor=north},
]
% Escala horizontal: cada etapa ocupa 2,5 cm; centros en 1,25 + 2,5 (i-1)
% ---------------- (a) Saldos
\node[font=\footnotesize\bfseries, anchor=west] at (0,2.55) {(a) Saldos por etapa};
\draw[thick] (0,0) -- (15,0);
\foreach \x in {2.5,5,7.5,10,12.5} \draw[sep] (\x,2.2) -- (\x,-2.0);
% etapa: bienes y servicios, rentas de la inversión, saldo corriente (= suma)
\foreach \c/\b/\r in {1.25/-1.2/-0.4, 3.75/0.8/-1.6, 6.25/1.6/-0.8, 8.75/0.8/0.6, 11.25/-0.6/1.6, 13.75/-1.6/0.8}{
  \pgfmathsetmacro{\s}{\b+\r}
  \draw[bs] (\c-0.75,0) rectangle (\c-0.27,\b);
  \draw[ri] (\c-0.24,0) rectangle (\c+0.24,\r);
  \draw[cc] (\c+0.27,0) rectangle (\c+0.75,\s);
}
% leyenda de (a)
\draw[bs] (8.3,2.4) rectangle (8.6,2.65); \node[anchor=west, font=\scriptsize] at (8.65,2.52) {Bienes y servicios};
\draw[ri] (10.75,2.4) rectangle (11.05,2.65); \node[anchor=west, font=\scriptsize] at (11.1,2.52) {Rentas de la inversión};
\draw[cc] (13.4,2.4) rectangle (13.7,2.65); \node[anchor=west, font=\scriptsize] at (13.75,2.52) {Saldo corriente};
% ---------------- (b) Posición de inversión internacional
\begin{scope}[yshift=-5.0cm]
  \node[font=\footnotesize\bfseries, anchor=west] at (0,2.55) {(b) Posición de inversión internacional, $PII$};
  \draw[thick] (0,0) -- (15,0);
  \foreach \x in {2.5,5,7.5,10,12.5} \draw[sep] (\x,2.2) -- (\x,-2.0);
  \draw[very thick] plot[smooth, tension=0.6] coordinates {(0,0) (2.5,-1.4) (5,-1.9) (7.5,0) (10,1.3) (12.5,1.9) (15,1.2)};
  \node[font=\scriptsize, anchor=north west] at (0.1,-0.05) {deudora};
  \node[font=\scriptsize, anchor=south east] at (14.9,0.05) {acreedora};
  % rótulos de las etapas
  \foreach \c/\t in {1.25/{Deudor\\ joven}, 3.75/{Deudor\\ maduro}, 6.25/{Deudor que\\ amortiza}, 8.75/{Acreedor\\ joven}, 11.25/{Acreedor\\ maduro}, 13.75/{Acreedor que\\ desacumula}}
    \node[eti] at (\c,-2.2) {\t};
\end{scope}
\end{tikzpicture}%
