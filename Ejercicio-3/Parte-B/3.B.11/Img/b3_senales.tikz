% Cuerpo, 4.4.2: las señales del desequilibrio según el régimen y según la cara en que aparecen, el flujo o el stock.
% Los umbrales detallados y las demás reglas de reservas están en el cuadro del anexo III.6.2.
% Fuente: FMI (2011); COMISIÓN EUROPEA (s. f.).
\begin{tikzpicture}[
  font=\footnotesize,
  every node/.append style={execute at begin node={\hyphenpenalty=10000\exhyphenpenalty=10000}},
  cab/.style={font=\footnotesize\bfseries, align=center},
  fila/.style={font=\footnotesize\bfseries, anchor=north west, align=left, text width=3.0cm},
  celda/.style={anchor=north west, align=left, text width=5.8cm},
]
\draw[thick] (0,0.5) -- (15.6,0.5);
\node[cab, anchor=west] at (0.1,0.12) {Régimen};
\node[cab] at (6.4,0.12) {En el flujo};
\node[cab] at (12.6,0.12) {En el stock};
\draw (0,-0.25) -- (15.6,-0.25);
% Tipo de cambio fijo
\node[fila]  at (0.1,-0.4) {Tipo de cambio fijo};
\node[celda] at (3.4,-0.4) {Pérdida de reservas: el saldo de la balanza global, por debajo de la línea, $\Delta AF^{res}<0$};
\node[celda] at (9.6,-0.4) {Reservas frente a la deuda externa a corto plazo y frente a las importaciones};
\draw[black!40] (0,-1.55) -- (15.6,-1.55);
% Unión monetaria
\node[fila]  at (0.1,-1.7) {Unión monetaria};
\node[celda] at (3.4,-1.7) {Aumento de los pasivos del banco central frente al Eurosistema, que sustituyen a la financiación privada};
\node[celda] at (9.6,-1.7) {Saldo de TARGET2 del banco central y su peso en la PII};
\draw[black!40] (0,-2.85) -- (15.6,-2.85);
% Libertad de capitales
\node[fila]  at (0.1,-3.0) {Libertad de capitales};
\node[celda] at (3.4,-3.0) {Distancia entre el saldo corriente y su norma, y saldo corriente medio de tres años frente a los umbrales del procedimiento europeo; flujos brutos};
\node[celda] at (9.6,-3.0) {PII frente al umbral del procedimiento europeo; su composición: deuda externa y PII sin los instrumentos que no pueden impagarse};
\draw[thick] (0,-4.55) -- (15.6,-4.55);
\end{tikzpicture}%
