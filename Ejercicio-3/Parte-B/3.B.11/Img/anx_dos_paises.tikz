% Dos países y un tipo de interés mundial: el exceso de ahorro de B (S_B0 -> S_B1) baja r* (r*_0 -> r*_1) y amplía a la vez
% el déficit de A y el superávit de B, que son iguales. Rectas: I_A = I_B: r = 5 - x; S_A: r = 1 + x; S_B0: r = -0,5 + x; S_B1: r = -2,9 + x.
% r*_0 = 2,625 (déficit = superávit = 0,75); r*_1 = 2,025 (déficit = superávit = 1,95).
% Anexo III.3.1; base de la figura del cuerpo. Fuente: BERNANKE (2005); OBSTFELD y ROGOFF (1996).
\begin{tikzpicture}[
  font=\footnotesize,
  >={Stealth[length=2mm]},
  every node/.append style={execute at begin node={\hyphenpenalty=10000\exhyphenpenalty=10000}},
  curva/.style={thick},
  previa/.style={thin, black!45},
]
% ================= (a) País A
\begin{scope}
  \node[font=\footnotesize\bfseries] at (2.8,6.05) {(a) País A: el déficit aumenta};
  \draw[->] (0,0) -- (5.6,0) node[below left] {$S_A,\ I_A$};
  \draw[->] (0,0) -- (0,5.7) node[above right] {$r$};
  \draw[curva] (0.3,4.7) -- (4.7,0.3) node[right] {$I_A$};
  \draw[curva] (0,1.0) -- (4.4,5.4) node[right] {$S_A$};
  \draw[previa, dashed] (0,2.625) -- (5.2,2.625) node[right, text=black] {$r^*_0$};
  \draw[dashed] (0,2.025) -- (5.2,2.025) node[right] {$r^*_1$};
  \fill (1.025,2.025) circle (1.3pt); \fill (2.975,2.025) circle (1.3pt);
  \draw[decorate, decoration={brace, amplitude=4pt, mirror}] (1.025,1.8) -- (2.975,1.8) node[midway, below=5pt] {déficit};
\end{scope}
% ================= (b) País B
\begin{scope}[xshift=8.0cm]
  \node[font=\footnotesize\bfseries] at (3.3,6.05) {(b) País B: el ahorro aumenta};
  \draw[->] (0,0) -- (7.4,0) node[below left] {$S_B,\ I_B$};
  \draw[->] (0,0) -- (0,5.7) node[above right] {$r$};
  \draw[curva] (0.3,4.7) -- (3.7,1.3) node[left] {$I_B$};
  \draw[previa] (0.9,0.4) -- (5.6,5.1) node[right, text=black!60] {$S_{B,0}$};
  \draw[curva] (3.3,0.4) -- (7.3,4.4) node[right] {$S_{B,1}$};
  \draw[->, black!60] (4.4,3.8) -- (5.6,3.8);
  \draw[previa, dashed] (0,2.625) -- (6.9,2.625);
  \draw[dashed] (0,2.025) -- (6.9,2.025);
  \fill (2.975,2.025) circle (1.3pt); \fill (4.925,2.025) circle (1.3pt);
  \draw[decorate, decoration={brace, amplitude=4pt}] (2.975,2.1) -- (4.925,2.1) node[midway, above=3pt, font=\scriptsize] {superávit};
\end{scope}
% Flecha de la caída del tipo mundial entre los paneles
\draw[->, thick] (6.55,2.625) -- (6.55,2.08);
\node[font=\scriptsize, anchor=west] at (6.6,2.33) {$r^*_0\to r^*_1$};
\end{tikzpicture}%
