% Cuerpo, 3.2.2: CC = S - I en una economía pequeña y abierta frente al tipo de interés mundial r*. Se parte de un
% saldo corriente nulo en E_0 (S_0 = I_0 a r*). (a) Cae el ahorro, S_0 -> S_1: déficit I_0 - S_1, de A a E_0.
% (b) Sube la inversión, I_0 -> I_1: déficit I_1 - S_0, de E_0 a B. El mismo déficit con distinto origen.
% Adaptada de Img/anx_ahorro_inversion (anexo III.2.2). Rectas: I_0: r = 5 - x; S_0: r = x - 0,2; r* = 2,4;
% S_1: r = x + 1,1 (A en x = 1,3); I_1: r = 6,3 - x (B en x = 3,9). Fuente: SACHS (1981); OBSTFELD y ROGOFF (1995).
\begin{tikzpicture}[
  font=\footnotesize,
  >={Stealth[length=2mm]},
  every node/.append style={execute at begin node={\hyphenpenalty=10000\exhyphenpenalty=10000}},
  curva/.style={thick},
  previa/.style={thin, black!45},
  punto/.style={circle, fill, inner sep=1.3pt},
]
% ================= (a) Cae el ahorro
\begin{scope}
  \node[font=\footnotesize\bfseries] at (3.1,5.95) {(a) Cae el ahorro};
  \draw[->] (0,0) -- (6.4,0) node[below left] {$S,\ I$};
  \draw[->] (0,0) -- (0,5.6) node[above right] {$r$};
  \draw[curva] (0.3,4.7) -- (4.8,0.2) node[right] {$I_0$};
  \draw[previa] (0.4,0.2) -- (5.0,4.8) node[right] {$S_0$};
  \draw[curva] (0,1.1) -- (3.9,5.0) node[right] {$S_1$};
  \draw[->, black!60] (3.95,3.75) -- (3.35,4.35);
  \draw[dashed] (0,2.4) -- (5.9,2.4) node[right] {$r^*$};
  \node[punto] (A) at (1.3,2.4) {}; \node[above left=0.5pt] at (A) {$A$};
  \node[punto] (E) at (2.6,2.4) {}; \node[above right=1pt] at (E) {$E_0$};
  \draw[decorate, decoration={brace, amplitude=4pt, mirror}] (1.3,2.2) -- (2.6,2.2)
    node[midway, below=5pt, align=center, fill=white, inner sep=1pt] {déficit corriente\\ $I_0-S_1$};
\end{scope}
% ================= (b) Sube la inversión
\begin{scope}[xshift=8.2cm]
  \node[font=\footnotesize\bfseries] at (3.1,5.95) {(b) Sube la inversión};
  \draw[->] (0,0) -- (6.4,0) node[below left] {$S,\ I$};
  \draw[->] (0,0) -- (0,5.6) node[above right] {$r$};
  \draw[previa] (0.3,4.7) -- (4.8,0.2) node[right] {$I_0$};
  \draw[curva] (0.9,5.4) -- (6.1,0.2) node[right] {$I_1$};
  \draw[curva] (0.4,0.2) -- (5.0,4.8) node[right] {$S_0$};
  \draw[->, black!60] (1.6,3.4) -- (2.2,4.0);
  \draw[dashed] (0,2.4) -- (5.9,2.4) node[right] {$r^*$};
  \node[punto] (E) at (2.6,2.4) {}; \node[above left=0.5pt] at (E) {$E_0$};
  \node[punto] (B) at (3.9,2.4) {}; \node[above right=1pt] at (B) {$B$};
  \draw[decorate, decoration={brace, amplitude=4pt, mirror}] (2.6,2.2) -- (3.9,2.2)
    node[midway, below=5pt, align=center, fill=white, inner sep=1pt] {déficit corriente\\ $I_1-S_0$};
\end{scope}
\end{tikzpicture}%
