% Cuerpo, 3.3.1: la renta secundaria (en gris) cierra el saldo corriente, que abre la cuenta de capital hasta la CNF.
% Generada por Code/cuentas_T.py (no editar a mano). Rúbricas agregadas, en letras; fuente: FMI (2009); SEC 2010.
\begin{tikzpicture}[
  font=\scriptsize,
  >={Stealth[length=1.8mm]},
  every node/.append style={execute at begin node={\hyphenpenalty=10000\exhyphenpenalty=10000}},
  ent/.style={anchor=west, align=left, text width=6.65cm, inner sep=1.5pt},
  sal/.style={anchor=west, align=left, inner sep=1.5pt},
  vis/.style={text=black!45},
  arr/.style={->, thick, black!55, rounded corners=2pt},
]
\node[font=\footnotesize\bfseries] at (3.50,0.62) {Débitos};
\node[font=\footnotesize\bfseries] at (10.50,0.62) {Créditos};
\node[text=black!60, align=center] at (3.50,0.25) {importaciones, pagos y adquisición neta de activos};
\node[text=black!60, align=center] at (10.50,0.25) {exportaciones, ingresos y contracción neta de pasivos};
\draw[thick] (0,0) -- (14.00,0);
\node[ent, vis] at (0.12,-0.315) {\textbf{Cuenta de renta secundaria}};
\node[ent, vis] at (0.12,-0.785) {Transferencias personales};
\node[ent, vis] at (0.12,-1.255) {Otras transferencias corrientes};
\node[sal, vis] (S0) at (0.12,-1.725) {\textbf{Saldo de la cuenta corriente, $CC=XN+RPN+TCN$}};
\node[sal, vis] (C0) at (7.18,-0.315) {\textit{Saldo tras la renta primaria, $XN+RPN$}};
\node[ent, vis] at (7.18,-0.785) {Transferencias personales};
\node[ent, vis] at (7.18,-1.255) {Otras transferencias corrientes};
\draw[black!55] (0,-2.040) -- (14.00,-2.040);
\node[ent] at (0.12,-2.355) {\textbf{Cuenta de capital}};
\node[ent] at (0.12,-2.825) {Transferencias de capital};
\node[ent] at (0.12,-3.295) {Adquisiciones de activos no producidos};
\node[sal] (S1) at (0.12,-3.765) {\textbf{Capacidad o necesidad de financiación, $CNF=CC+CK$}};
\node[sal] (C1) at (7.18,-2.355) {\textit{Saldo de la cuenta corriente, $CC$}};
\node[ent] at (7.18,-2.825) {Transferencias de capital};
\node[ent] at (7.18,-3.295) {Cesiones de activos no producidos};
\draw[arr] (S0.east) to[out=0, in=180] (C1.west);
\draw[thick] (7.00,0) -- (7.00,-4.080);
