% Cuerpo, apartado 3.4.1: conciliación de la PII en cascada, en letras. Una economía deudora presta en el periodo
% (CF_t > 0) y, aun así, su posición empeora porque las revalorizaciones son negativas. Alturas solo ilustrativas.
% Fuente: FMI (2009), cap. 7 y 9.
\begin{tikzpicture}[
  font=\footnotesize,
  every node/.append style={execute at begin node={\hyphenpenalty=10000\exhyphenpenalty=10000}},
  stock/.style={fill=black!45, draw=black!80},
  sube/.style={fill=white, draw=black!80},
  baja/.style={fill=black!18, draw=black!80},
  conec/.style={densely dashed, black!50},
  eti/.style={font=\scriptsize, align=center, text width=2.3cm, anchor=north},
]
% Escala: 1 unidad = 1 cm; posición nula en y = 0
\draw[thick] (-0.3,0) -- (15.3,0);
\node[font=\scriptsize, anchor=south west] at (-0.3,0) {$PII=0$};
% Barras: anchura 1,6; centros cada 2,6
\draw[stock] (0.5,0) rectangle (2.1,-4.0);       \node[text=white] at (1.3,-2.0) {$PII_{t-1}$};
\draw[conec] (2.1,-4.0) -- (3.1,-4.0);
\draw[sube]  (3.1,-4.0) rectangle (4.7,-2.8);    \node at (3.9,-3.4) {$CF_t>0$};
\draw[conec] (4.7,-2.8) -- (5.7,-2.8);
\draw[baja]  (5.7,-2.8) rectangle (7.3,-3.6);    \node at (6.5,-3.2) {$RV^{tc}_t<0$};
\draw[conec] (7.3,-3.6) -- (8.3,-3.6);
\draw[baja]  (8.3,-3.6) rectangle (9.9,-4.5);    \node at (9.1,-4.05) {$RV^{p}_t<0$};
\draw[conec] (9.9,-4.5) -- (10.9,-4.5);
\draw[sube]  (10.9,-4.5) rectangle (12.5,-4.3);  \node[anchor=south] at (11.7,-4.3) {$OV_t$};
\draw[conec] (12.5,-4.3) -- (13.5,-4.3);
\draw[stock] (13.5,0) rectangle (15.1,-4.3);     \node[text=white] at (14.3,-2.15) {$PII_{t}$};
% Rótulos
\node[eti] at (1.3,-4.75) {PII al final\\ de $t-1$};
\node[eti] at (3.9,-4.75) {Transacciones:\\ cuenta financiera};
\node[eti] at (6.5,-4.75) {Revalorizaciones\\ por tipo de cambio};
\node[eti] at (9.1,-4.75) {Revalorizaciones\\ por otros precios};
\node[eti] at (11.7,-4.75) {Otros cambios\\ del volumen};
\node[eti] at (14.3,-4.75) {PII al final\\ de $t$};
\end{tikzpicture}%
