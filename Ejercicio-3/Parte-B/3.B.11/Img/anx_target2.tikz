% TARGET2: un pago de un importador español a un exportador francés en los balances de los bancos y de los bancos centrales,
% y su registro en las balanzas de pagos. Anexo II.7.2. Fuente: BdE, nota metodológica y nota NGEU (2022); FMI (2009), apéndice 3.
\begin{tikzpicture}[
  font=\scriptsize,
  >={Stealth[length=2mm]},
  every node/.append style={execute at begin node={\hyphenpenalty=10000\exhyphenpenalty=10000}},
  tit/.style={font=\scriptsize\bfseries, align=center, text width=2.9cm, text height=1.7ex, text depth=0.45ex},
  ent/.style={font=\scriptsize, align=center, text width=1.35cm},
  bp/.style={draw, rounded corners=2pt, fill=blue!5, align=left, text width=7.3cm, inner sep=3pt, font=\scriptsize},
]
% Cinco balances en T: x0 = borde izquierdo; anchura 3.0; separación 0.2
\foreach \x/\n in {0/Banco español, 3.2/Banco de España, 6.4/BCE, 9.6/Banque de France, 12.8/Banco francés}{
  \node[tit] at (\x+1.5,4.55) {\n};
  \draw[thick] (\x,4.15) -- (\x+3.0,4.15);
  \draw[thick] (\x+1.5,4.15) -- (\x+1.5,1.75);
  \node[font=\scriptsize\itshape] at (\x+0.75,3.95) {Activo};
  \node[font=\scriptsize\itshape] at (\x+2.25,3.95) {Pasivo};
}
% Banco español
\node[ent] at (0.75,3.05) {Reservas en el Banco de España, $-x$};
\node[ent] at (2.25,3.05) {Depósito del importador, $-x$};
% Banco de España
\node[ent] at (5.45,3.25) {Reservas del banco español, $-x$};
\node[ent] at (5.45,2.25) {Pasivo frente al Eurosistema, $+x$};
% BCE
\node[ent] at (7.15,3.05) {Activo frente al Banco de España, $+x$};
\node[ent] at (8.65,3.05) {Pasivo frente a la Banque de France, $+x$};
% Banque de France
\node[ent] at (10.35,3.05) {Activo frente al Eurosistema, $+x$};
\node[ent] at (11.85,3.05) {Reservas del banco francés, $+x$};
% Banco francés
\node[ent] at (13.55,3.05) {Reservas en la Banque de France, $+x$};
\node[ent] at (15.05,3.05) {Depósito del exportador, $+x$};
% Flujo del pago
\draw[->, thick] (1.5,5.0) -- (14.3,5.0) node[midway, above, font=\scriptsize] {pago del importador español al exportador francés, $x$, liquidado en TARGET2};
% Registro en las balanzas
\node[bp, anchor=north west] at (0,1.45) {\textbf{Balanza de pagos de España}: débito de bienes, $x$; cuenta financiera del Banco de España, otra inversión, $\Delta P=+x$ frente al Eurosistema.};
\node[bp, anchor=north west] at (8.3,1.45) {\textbf{Balanza de pagos de Francia}: crédito de bienes, $x$; cuenta financiera de la Banque de France, otra inversión, $\Delta AF=+x$ frente al Eurosistema.};
\end{tikzpicture}%
