% Cuerpo, apartado 1.1.2: las cuentas internacionales como sistema. Versión simplificada de la base común
% (anx_cuentas_internacionales): las dos caras de la balanza, su contrapartida y los dos flujos que mueven la PII.
% Fuente: FMI (2009), cap. 2.
\begin{tikzpicture}[
  font=\footnotesize,
  >={Stealth[length=2.2mm]},
  every node/.append style={execute at begin node={\hyphenpenalty=10000\exhyphenpenalty=10000}},
  bloque/.style={draw, rounded corners=3pt, thick},
  caja/.style={draw, rounded corners=2pt, fill=white, align=center, inner sep=3pt},
  titulo/.style={font=\footnotesize\bfseries, align=center},
]
% ---------------- PII inicial
\draw[bloque, fill=black!6] (0,0.3) rectangle (2.9,5.6);
\node[titulo] at (1.45,5.05) {PII al final\\ de $t-1$};
\node[caja, text width=2.45cm] at (1.45,3.95) {Activos exteriores\\ $AF_{t-1}$};
\node[caja, text width=2.45cm] at (1.45,2.75) {Pasivos exteriores\\ $P_{t-1}$};
\node[align=center] at (1.45,1.25) {$PII_{t-1}$\\ $=AF_{t-1}-P_{t-1}$};
% ---------------- Balanza de pagos
\draw[bloque, fill=blue!5] (3.4,2.85) rectangle (12.5,7.3);
\node[titulo] at (7.95,6.9) {Balanza de pagos: transacciones del periodo $t$};
\node[caja, text width=3.35cm, minimum height=2.3cm] (nf) at (5.45,4.85) {\textbf{Transacciones\\ no financieras}\\[2pt] cuentas corriente\\ y de capital\\[2pt] $CF=CC+KA$};
\node[caja, text width=3.35cm, minimum height=2.3cm] (fi) at (10.45,4.85) {\textbf{Transacciones\\ financieras}\\[2pt] cuenta financiera\\[2pt] $FA=\Delta AF-\Delta P$};
\draw[<->, thick] (nf.east) -- (fi.west) node[midway, above, font=\scriptsize, align=center] {contrapartida\\ (partida doble)};
\node[font=\scriptsize] at (7.95,3.35) {$FA=CF+EO$};
% ---------------- Otras variaciones
\draw[bloque, fill=black!4] (3.4,0) rectangle (12.5,2.35);
\node[titulo] at (7.95,1.95) {Otras variaciones de las posiciones};
\node[caja, text width=3.8cm, minimum height=0.9cm] at (5.85,0.85) {Revalorizaciones por tipo\\ de cambio y por precios, $RV$};
\node[caja, text width=3.8cm, minimum height=0.9cm] at (10.05,0.85) {Otros cambios\\ del volumen, $OV$};
% ---------------- PII final
\draw[bloque, fill=black!6] (13.0,0.3) rectangle (15.9,5.6);
\node[titulo] at (14.45,5.05) {PII al final\\ de $t$};
\node[caja, text width=2.45cm] at (14.45,3.95) {Activos exteriores\\ $AF_{t}$};
\node[caja, text width=2.45cm] at (14.45,2.75) {Pasivos exteriores\\ $P_{t}$};
\node[align=center] at (14.45,1.25) {$PII_{t}$\\ $=AF_{t}-P_{t}$};
% ---------------- Lo que mueve la PII: las transacciones financieras y las otras variaciones
\draw[->, thick] (fi.east) -- (13.0,4.35);
\draw[->, thick] (12.5,1.0) -- (13.0,1.9);
% ---------------- Identidad
\draw[->, thick] (1.45,0.3) -- (1.45,-0.7) -- (14.45,-0.7) -- (14.45,0.3);
\node[fill=white, inner sep=2pt] at (7.95,-0.7) {$PII_t=PII_{t-1}+FA_t+RV_t+OV_t$};
\end{tikzpicture}%
