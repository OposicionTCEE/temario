% anx_ajuste_posiciones: las tres posiciones en que deja el sistema a un país deficitario, según la moneda en que se endeuda
% (anexo I.4.3). REUTILIZA LA BASE COMÚN E del tema (columnas enfrentadas con las mismas preguntas en las filas), aquí con
% tres columnas y tres filas. El corte no es deudor frente a acreedor, que se estudia en el tema 3.B.12, sino el que
% introduce la moneda de denominación de la deuda.
% Sin narración dentro del panel: las etiquetas son nominales y la explicación va en la prosa.
% Generar desde la carpeta del tema: bash Code/generar_figura.sh anx_ajuste_posiciones
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=2.4mm]},
    caja/.style={draw=black!80, thick, align=center, inner sep=4pt, text width=3.5cm, execute at begin node={\hyphenpenalty=10000}},
    cabecera/.style={draw=black!80, thick, fill=black!10, align=center, inner sep=4pt, text width=3.5cm, font=\footnotesize\bfseries},
    fila/.style={anchor=east, align=right, text width=2.9cm, font=\scriptsize, text=black!65}]
  \def\xa{0}
  \def\xb{4.3}
  \def\xc{8.6}
  \node[cabecera] (ca) at (\xa,0) {Emisor de la moneda de reserva};
  \node[cabecera] (cb) at (\xb,0) {Avanzada que se endeuda en su moneda};
  \node[cabecera] (cc) at (\xc,0) {Resto: deuda en moneda ajena};
  \node[caja] (a1) at (\xa,-1.6) {Nada: se financia en la moneda que emite};
  \node[caja] (b1) at (\xb,-1.6) {El precio de su moneda y de su deuda};
  \node[caja] (c1) at (\xc,-1.6) {La pérdida de acceso a la financiación};
  \node[caja, fill=black!5] (a2) at (\xa,-3.0) {No ajusta};
  \node[caja, fill=black!5] (b2) at (\xb,-3.0) {De forma gradual};
  \node[caja, fill=black!5] (c2) at (\xc,-3.0) {De golpe, en una parada súbita};
  \node[caja] (a3) at (\xa,-4.5) {El tenedor extranjero de sus pasivos};
  \node[caja] (b3) at (\xb,-4.5) {El consumidor, por la depreciación};
  \node[caja] (c3) at (\xc,-4.5) {El empleo y la renta internos};
  \foreach \a/\b in {ca/a1, cb/b1, cc/c1, a1/a2, b1/b2, c1/c2, a2/a3, b2/b3, c2/c3}{\draw[->, black!70] (\a) -- (\b);}
  \node[fila] at (-2.0,-1.6) {¿qué lo obliga a ajustar?};
  \node[fila] at (-2.0,-3.0) {¿cuándo ajusta?};
  \node[fila] at (-2.0,-4.5) {¿quién soporta el coste?};
\end{tikzpicture}
