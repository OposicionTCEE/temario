% b2_tres_mercados_1982: la crisis de 1982 como resultado conjunto de las tres dimensiones (cuerpo, bloque 2, finanzas).
% BASE COMÚN M del tema: varias causas que convergen en un resultado. Se reutiliza siempre que la tesis sea que un hecho no lo
% produjo un mercado sino la coincidencia de varios.
% Sin narración dentro del panel: las etiquetas son nominales y la explicación va en la prosa.
% Generar desde la carpeta del tema: bash Code/generar_figura.sh b2_tres_mercados_1982
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=2.6mm]},
    causa/.style={draw=black!80, thick, align=center, inner sep=4pt, text width=4.0cm, execute at begin node={\hyphenpenalty=10000}},
    efecto/.style={draw=black!85, very thick, fill=black!10, align=center, inner sep=5pt, text width=5.0cm, font=\footnotesize\bfseries}]
  \node[causa] (b) at (-4.7,0) {\textbf{Bienes}\\[1pt]se hunde el precio de las materias primas con que se pagaba};
  \node[causa] (m) at (0,0) {\textbf{Moneda}\\[1pt]el emisor sube los tipos para recuperar su ancla interna};
  \node[causa] (k) at (4.7,0) {\textbf{Capital}\\[1pt]crédito sindicado a tipo de interés variable};
  \node[efecto] (r) at (0,-2.4) {Crisis de la deuda, 1982};
  \foreach \n in {b, m, k}{\draw[->, black!80, thick] (\n) -- (r);}
\end{tikzpicture}
