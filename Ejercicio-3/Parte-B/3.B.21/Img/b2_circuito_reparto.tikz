% b2_circuito_reparto: por qué el perdedor pide cierre y no compensación (cuerpo, bloque 2, trabajo y sociedad).
% REUTILIZA LA BASE COMÚN M del tema, aquí al revés: una sola causa con dos efectos que convergen en un mismo resultado.
% La tesis es que la integración y el desmantelamiento de la compensación no son dos procesos que coincidan, sino el mismo.
% Sin narración dentro del panel: las etiquetas son nominales y la explicación va en la prosa.
% Generar desde la carpeta del tema: bash Code/generar_figura.sh b2_circuito_reparto
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=2.6mm]},
    caja/.style={draw=black!80, thick, align=center, inner sep=4pt, text width=4.6cm, execute at begin node={\hyphenpenalty=10000}},
    extremo/.style={draw=black!85, very thick, fill=black!10, align=center, inner sep=5pt, text width=5.6cm, font=\footnotesize\bfseries, execute at begin node={\hyphenpenalty=10000}}]
  \node[extremo] (c) at (0,0) {Movilidad del capital y de la producción};
  \node[caja] (i) at (-3.1,-2.0) {Sube la ganancia de romper el pacto, y solo para una de las partes};
  \node[caja] (d) at (3.1,-2.0) {Se encarece gravar la base móvil y, con ella, compensar};
  \node[extremo] (r) at (0,-4.1) {Se pide protección, que es el remedio que sigue disponible};
  \draw[->, black!80, thick] (c) -- (i);
  \draw[->, black!80, thick] (c) -- (d);
  \draw[->, black!80, thick] (i) -- (r);
  \draw[->, black!80, thick] (d) -- (r);
\end{tikzpicture}
