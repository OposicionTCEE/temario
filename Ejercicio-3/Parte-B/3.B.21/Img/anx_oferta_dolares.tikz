% anx_oferta_dolares: las tres fuentes de liquidez en dólares del sistema y su comportamiento en una tensión (anexo I.2.3).
% Usa la BASE COMÚN E (columnas enfrentadas con las mismas filas), aquí con tres columnas en lugar de dos.
% La fila de abajo es el rasgo que importa para el sistema: cómo se comporta cada fuente cuando llega una tensión.
% Sin narración dentro del panel: etiquetas nominales; la explicación va en la prosa.
% Generar desde la carpeta del tema: bash Code/generar_figura.sh anx_oferta_dolares
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=2.4mm]},
    caja/.style={draw=black!80, thick, align=center, inner sep=4pt, text width=3.3cm, execute at begin node={\hyphenpenalty=10000}},
    cabecera/.style={draw=black!80, thick, fill=black!10, align=center, inner sep=4pt, text width=3.3cm, font=\footnotesize\bfseries},
    fila/.style={anchor=east, align=right, text width=2.4cm, font=\scriptsize, text=black!65}]
  \def\xa{0}
  \def\xb{4.1}
  \def\xc{8.2}
  \node[cabecera] (ca) at (\xa,0) {Déficit exterior del emisor};
  \node[cabecera] (cb) at (\xb,0) {Creación privada fuera del emisor};
  \node[cabecera] (cc) at (\xc,0) {Red oficial de seguridad};
  \node[caja] (a1) at (\xa,-1.3) {Títulos del Tesoro en manos del resto del mundo};
  \node[caja] (b1) at (\xb,-1.3) {Eurodólares y deuda fuera de balance en \textit{swaps}};
  \node[caja] (c1) at (\xc,-1.3) {\textit{Swaps} del banco central emisor, Fondo y reservas propias};
  \foreach \a/\b in {ca/a1, cb/b1, cc/c1}{\draw[->, black!70] (\a) -- (\b);}
  \node[caja, fill=black!5] (a2) at (\xa,-2.75) {Crece con el desequilibrio};
  \node[caja, fill=black!5] (b2) at (\xb,-2.75) {Se contrae de golpe};
  \node[caja, fill=black!5] (c2) at (\xc,-2.75) {Discrecional y selectiva};
  \foreach \a/\b in {a1/a2, b1/b2, c1/c2}{\draw[->, black!70] (\a) -- (\b);}
  \node[fila] at (-1.85,-1.3) {¿en qué consiste?};
  \node[fila] at (-1.85,-2.75) {¿cómo responde a una tensión?};
\end{tikzpicture}
