% anx_ajuste_canales: los dos caminos por los que una depreciación mejora el saldo corriente (anexo I.4.2). BASE COMÚN G del
% tema: un mismo choque arriba, dos rutas paralelas de tres eslabones y un mismo resultado abajo. Se reutiliza siempre que
% haya que mostrar que dos mecanismos distintos llevan al mismo sitio con costes distintos.
% La ruta izquierda es la del libro de texto (facturación en la moneda del productor); la derecha, la del paradigma de la
% moneda dominante. Sin narración dentro del panel: las etiquetas son nominales y la explicación va en la prosa.
% Generar desde la carpeta del tema: bash Code/generar_figura.sh anx_ajuste_canales
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=2.6mm]},
    caja/.style={draw=black!80, thick, align=center, inner sep=4pt, text width=3.9cm, execute at begin node={\hyphenpenalty=10000}},
    cabecera/.style={draw=black!80, thick, fill=black!10, align=center, inner sep=4pt, text width=3.9cm, font=\footnotesize\bfseries, execute at begin node={\hyphenpenalty=10000}},
    extremo/.style={draw=black!80, very thick, align=center, inner sep=5pt, text width=5.4cm, font=\footnotesize\bfseries}]
  \def\xi{0}
  \def\xd{5.0}
  \def\xc{2.5}
  \node[extremo] (sh) at (\xc,0) {Depreciación de la moneda nacional};
  \node[cabecera] (ci) at (\xi,-1.6) {Facturación en moneda\\del productor};
  \node[cabecera] (cd) at (\xd,-1.6) {Facturación en la\\moneda dominante};
  \node[caja] (i1) at (\xi,-3.1) {Bajan los precios de exportación en moneda extranjera};
  \node[caja] (i2) at (\xi,-4.6) {Desvío del gasto mundial hacia los bienes nacionales};
  \node[caja] (i3) at (\xi,-6.1) {Suben las exportaciones y bajan las importaciones};
  \node[caja] (d1) at (\xd,-3.1) {Suben los precios de importación en moneda nacional};
  \node[caja] (d2) at (\xd,-4.6) {Cae la renta real disponible};
  \node[caja] (d3) at (\xd,-6.1) {Cae la absorción interna};
  \node[extremo] (res) at (\xc,-7.6) {Mejora el saldo corriente};
  \draw[->, black!80, thick] (sh) -- (ci);
  \draw[->, black!80, thick] (sh) -- (cd);
  \foreach \a/\b in {ci/i1, i1/i2, i2/i3, cd/d1, d1/d2, d2/d3}{\draw[->, black!70] (\a) -- (\b);}
  \draw[->, black!80, thick] (i3) -- (res);
  \draw[->, black!80, thick] (d3) -- (res);
\end{tikzpicture}
