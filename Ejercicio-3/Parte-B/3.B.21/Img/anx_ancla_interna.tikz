% anx_ancla_interna: la sustitución del ancla externa por un ancla interna (anexo I.1.4). BASE COMÚN E del tema: dos columnas
% enfrentadas con una flecha de sustitución entre ellas y las mismas tres preguntas en las filas. Se reutiliza en el anexo I
% (activo de reserva antes y después) y en el cuerpo (el compromiso de 1944 frente al no sistema).
% Sin narración dentro del panel: las etiquetas son nominales y la explicación va en la prosa.
% Generar desde la carpeta del tema: bash Code/generar_figura.sh anx_ancla_interna
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=2.6mm]},
    caja/.style={draw=black!80, thick, align=center, inner sep=4pt, text width=3.5cm, execute at begin node={\hyphenpenalty=10000}},
    cabecera/.style={draw=black!80, thick, fill=black!10, align=center, inner sep=4pt, text width=3.5cm, font=\footnotesize\bfseries},
    fila/.style={anchor=east, align=right, text width=2.9cm, font=\scriptsize, text=black!65}]
  % columnas
  \def\xi{0}   % izquierda
  \def\xd{5.6} % derecha
  % cabeceras
  \node[cabecera] (ci) at (\xi,0) {Hasta 1971\\[-1pt]{\scriptsize\mdseries Ancla externa}};
  \node[cabecera] (cd) at (\xd,0) {Desde 1979-1990\\[-1pt]{\scriptsize\mdseries Ancla interna}};
  % cadena izquierda
  \node[caja] (i1) at (\xi,-1.25) {Oro, a $35$ \$ la onza};
  \node[caja] (i2) at (\xi,-2.35) {Convertibilidad del dólar};
  \node[caja] (i3) at (\xi,-3.45) {Paridad declarada ante el FMI};
  % cadena derecha
  \node[caja] (d1) at (\xd,-1.25) {Objetivo de inflación};
  \node[caja] (d2) at (\xd,-2.35) {Banco central independiente};
  \node[caja] (d3) at (\xd,-3.45) {Nada};
  \foreach \a/\b in {i1/i2,i2/i3,d1/d2,d2/d3}{\draw[->, black!70] (\a) -- (\b);}
  \draw[->, black!80, thick] (ci) -- (cd);
  % filas de comparación
  \node[fila] at (-2.0,-1.25) {¿qué define el valor del dinero?};
  \node[fila] at (-2.0,-2.35) {¿quién responde de ello?};
  \node[fila] at (-2.0,-3.45) {¿qué ata al tipo de cambio?};
  % recuentos
  \node[anchor=north, font=\footnotesize\bfseries, text width=3.5cm, align=center] at (\xi,-4.1) {Una ancla para todos};
  \node[anchor=north, font=\footnotesize\bfseries, text width=3.5cm, align=center] at (\xd,-4.1) {Una ancla por país};
\end{tikzpicture}
