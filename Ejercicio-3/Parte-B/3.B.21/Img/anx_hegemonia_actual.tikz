% anx_hegemonia_actual: quién tiene hoy incentivo para sostener el orden abierto (anexo III.1.1). CONTINÚA LA BASE de
% anx_hegemonia, anx_hegemonia_entreguerras y anx_hegemonia_bw del 3.B.20 (formalización propia a partir de OLSON, 1965, y
% KINDLEBERGER, 1981): un país provee el bien público si y_i o_i B >= C - S_i, es decir, si y_i o_i >= (C - S_i)/B.
% En gris discontinuo, la frontera con el valor estratégico de la Guerra Fría, y_i o_i = 0,12, que es la que usaba aquel tema.
% En trazo grueso, la frontera sin ese valor estratégico, y_i o_i = C/B = 0,25: es la que rige desde 1991.
% Posiciones CUALITATIVAS, en la misma escala de aquel tema: Estados Unidos 1970 (0,72; 0,23), en gris; Estados Unidos hoy
% (0,45; 0,31), por debajo de la frontera sin valor estratégico; China hoy (0,52; 0,70) y Unión Europea hoy (0,34; 0,86), las
% dos por encima de ella, porque dependen del orden abierto mucho más que el emisor.
% Generar desde la carpeta del tema: bash Code/generar_figura.sh anx_hegemonia_actual
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=2mm]}, x=6.2cm, y=4.6cm]
  % zona en la que se provee por interés propio
  \fill[black!14] plot[domain=0.25:1.12, samples=100] (\x,{0.25/\x}) -- (1.12,1.0) -- (0.25,1.0) -- cycle;
  % zona en la que solo se provee con valor estratégico
  \fill[black!5] plot[domain=0.12:1.12, samples=100] (\x,{0.12/\x}) -- (1.12,0.223) --
      plot[domain=1.12:0.25, samples=100] (\x,{0.25/\x}) -- cycle;
  \node[font=\scriptsize, text=black!70, align=center] at (0.88,0.78) {provee por\\interés propio};
  \node[font=\scriptsize, text=black!70, align=center] at (1.0,0.17) {solo con valor\\estratégico};
  \node[font=\scriptsize, text=black!70] at (0.27,0.09) {no provee};
  % ejes
  \draw[->] (0,0) -- (1.2,0) node[below left] {$y_i$};
  \draw[->] (0,0) -- (0,1.08) node[left] {$o_i$};
  \node[below, font=\scriptsize] at (0.6,-0.03) {tamaño relativo};
  \node[rotate=90, font=\scriptsize] at (-0.07,0.5) {dependencia del orden abierto};
  % frontera con el valor estratégico de la Guerra Fría
  \draw[black!45, thick, dashed] plot[domain=0.12:1.12, samples=100] (\x,{0.12/\x});
  \node[anchor=west, text=black!55, font=\scriptsize] at (1.12,0.107) {$y_i\,o_i=(C-S)/B$};
  % frontera sin valor estratégico
  \draw[black!90, very thick] plot[domain=0.25:1.12, samples=100] (\x,{0.25/\x});
  \node[anchor=south west] at (0.255,1.0) {$y_i\,o_i=C/B$};
  % el fin del valor estratégico
  \draw[->, black!60, thick] (0.30,0.42) -- (0.30,0.81);
  \node[font=\footnotesize, anchor=east] at (0.288,0.62) {$1991$};
  % posiciones
  \fill[black!45] (0.72,0.23) circle (1.4pt) node[above right=1pt and 0pt, text=black!55, font=\scriptsize] {EE. UU. 1970};
  \fill (0.45,0.31) circle (1.6pt) node[below left=1pt and 0pt] {EE. UU. hoy};
  \fill (0.52,0.70) circle (1.6pt) node[above right=1pt and 0pt] {China hoy};
  \fill (0.34,0.86) circle (1.6pt) node[above right=1pt and 0pt] {UE hoy};
  \draw[->, black!60, thick] (0.70,0.237) -- (0.47,0.303);
\end{tikzpicture}
