% anx_macdougall_tareas: la deslocalización de tareas como sustituto de la migración (anexo II.3.3). CONTINÚA LA BASE del
% diagrama de dos países de MACDOUGALL (1960) de b1_macdougall, b2_macdougall y b3_macdougall del 3.B.20, con las mismas
% curvas: PMgL_S: w = 5,5 - 0,47 x; PMgL_N: w = 1 + 0,4 x, con x medido desde O_S.
% Diferencia con aquel tema: tras 1973 el reparto de la población activa deja de moverse y se queda en L0 (x = 7,5), con
% w_S^0 = 1,975 y w_N^0 = 4,0. Lo que se mueve es la curva del Sur: emplear trabajo del Sur con capital, tecnología y demanda
% del Norte eleva su producto marginal, aquí en una unidad (PMgL_S pasa a w = 6,5 - 0,47 x), de modo que al mismo reparto
% w_S^t = 2,975. L1 (x = 5,172, w = 3,069) es la igualación con libre migración, que no se produjo: se conserva en gris.
% c_t: el aumento de producción que añade la deslocalización, entre las dos curvas del Sur a la izquierda de L0.
% Generar desde la carpeta del tema: bash Code/generar_figura.sh anx_macdougall_tareas
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=2mm]}, x=1.3cm, y=0.95cm]
  % área de la ganancia de la deslocalización
  \fill[black!18] (0,5.5) -- (0,6.5) -- (7.5,2.975) -- (7.5,1.975) -- cycle;
  \node at (3.4,4.35) {$c_t$};
  % ejes
  \draw[->] (0,0) -- (0,7.0) node[left] {$w_S$};
  \draw[->] (10,0) -- (10,7.0) node[right] {$w_N$};
  \draw (0,0) -- (10,0);
  \node[below] at (0,0) {$O_S$};
  \node[below] at (10,0) {$O_N$};
  % productividades marginales
  \draw[black!45, thick, dashed] (0,5.5) -- (10,0.8) node[below left, black!55] {$\mathrm{PMgL}_S$};
  \draw[black!85, thick] (0,6.5) -- (10,1.8) node[above right, inner sep=1pt] {$\mathrm{PMgL}_S'$};
  \draw[black!85, thick] (0,1.0) -- (10,5.0) node[above left] {$\mathrm{PMgL}_N$};
  % repartos
  \draw[black!45, densely dotted] (7.5,0) -- (7.5,4.0);
  \draw[black!35, densely dotted] (5.172,0) -- (5.172,3.069);
  \node[below] at (7.5,0) {$L_0$};
  \node[below, text=black!55] at (5.172,0) {$L_1$};
  % salarios
  \draw[black!45, densely dotted] (0,1.975) -- (7.5,1.975);
  \draw[black!45, densely dotted] (0,2.975) -- (7.5,2.975);
  \draw[black!45, densely dotted] (7.5,4.0) -- (10,4.0);
  \node[left, text=black!55] at (0,1.975) {$w_S^0$};
  \node[left] at (0,2.975) {$w_S^t$};
  \node[right] at (10,4.0) {$w_N^0$};
  \fill[black!45] (7.5,1.975) circle (1.3pt);
  \fill (7.5,2.975) circle (1.5pt);
  \fill (7.5,4.0) circle (1.5pt);
  \fill[black!45] (5.172,3.069) circle (1.2pt);
  % el desplazamiento
  \draw[->, thick, black!75] (1.6,4.75) -- (1.6,5.75);
  \node[anchor=west, font=\scriptsize] at (1.75,5.25) {deslocalización de tareas};
  % la migración que no se produjo
  \draw[->, black!45, dashed] (7.35,0.5) -- (5.32,0.5);
  \node[font=\scriptsize, text=black!55, anchor=north] at (6.3,0.42) {migración libre};
  % rótulos de las regiones
  \node at (2.2,-0.8) {población activa del Sur $\rightarrow$};
  \node at (8.0,-0.8) {$\leftarrow$ población activa del Norte};
\end{tikzpicture}
