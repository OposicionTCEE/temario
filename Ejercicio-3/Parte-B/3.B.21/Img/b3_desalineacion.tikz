% b3_desalineacion: las tres condiciones políticas del orden fallaron una tras otra y el orden siguió (cuerpo, bloque 3).
% REUTILIZA LA BASE COMÚN J del tema (línea de tiempo con hitos escalonados y un tramo acotado), aquí con los hitos arriba y la
% continuidad del orden abajo, para que el contraste entre las tres fechas y la banda sea el contenido de la figura.
% OJO: el eje va en años transcurridos desde 1970, no en años absolutos (con años absolutos se supera la dimensión máxima de
% TeX y la figura sale rota).
% Sin narración dentro del panel: las etiquetas son nominales y la explicación va en la prosa.
% Generar desde la carpeta del tema: bash Code/generar_figura.sh b3_desalineacion
\begin{tikzpicture}[x=0.235cm, y=1cm, font=\footnotesize, >={Stealth[length=2.2mm]},
    hito/.style={draw=black!80, thick, fill=white, align=center, inner sep=3pt, text width=2.9cm, font=\scriptsize,
                 execute at begin node={\hyphenpenalty=10000}}]
  \draw[->, black!80, thick] (0,0) -- (60,0);
  \foreach \x/\a in {0/1970, 10/1980, 20/1990, 30/2000, 40/2010, 50/2020}{
    \draw[black!80] (\x,0.07) -- (\x,-0.07) node[below, font=\scriptsize] {\a};
  }
  \foreach \x/\y/\t in {%
      21/0.75/{\textbf{1991}\\El poder deja de pagarlo},
      38/1.60/{\textbf{2008}\\Las ideas se rompen por la mitad},
      46/2.55/{\textbf{Desde 2016}\\La sociedad deja de aceptar su coste}}{
    \draw[black!55] (\x,0) -- (\x,\y-0.32);
    \node[hito] at (\x,\y) {\t};
  }
  \draw[black!85, line width=2.6pt] (3,-0.78) -- (57,-0.78);
  \node[font=\footnotesize\bfseries, anchor=north] at (30,-0.92) {El orden sigue en pie};
\end{tikzpicture}
