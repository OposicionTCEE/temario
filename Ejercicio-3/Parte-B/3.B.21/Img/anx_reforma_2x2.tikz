% anx_reforma_2x2: las dos condiciones que han tenido que coincidir para que el sistema monetario internacional se reformase,
% y los episodios de cada combinación (anexo I.5.3). BASE COMÚN H del tema: matriz de dos condiciones con los casos
% históricos en las celdas. Se reutiliza siempre que la tesis sea que un resultado exige dos condiciones a la vez.
% La celda sombreada es la única que produjo un sistema acordado. Sin narración dentro del panel.
% Generar desde la carpeta del tema: bash Code/generar_figura.sh anx_reforma_2x2
\begin{tikzpicture}[font=\footnotesize,
    celda/.style={draw=black!80, thick, align=center, inner sep=5pt, text width=5.2cm, minimum height=1.9cm,
                  execute at begin node={\hyphenpenalty=10000}},
    eje/.style={font=\scriptsize, text=black!65}]
  \def\xa{0}
  \def\xb{5.9}
  \def\ya{0}
  \def\yb{-2.5}
  \node[celda] (tl) at (\xa,\ya) {\textbf{1971-1976} y \textbf{2008-2009}\\[2pt]{\scriptsize\mdseries El no sistema y la reforma de hecho}};
  \node[celda, fill=black!8] (tr) at (\xb,\ya) {\textbf{1944}\\[2pt]{\scriptsize\mdseries Bretton Woods}};
  \node[celda] (bl) at (\xa,\yb) {\textbf{Desde 1976}\\[2pt]{\scriptsize\mdseries Autoseguro, \textit{swaps} y acuerdos regionales}};
  \node[celda] (br) at (\xb,\yb) {\textbf{1985-1987}\\[2pt]{\scriptsize\mdseries Plaza y Louvre: coordinación reversible}};
  \node[eje, anchor=south, text width=5.2cm, align=center] at (\xa,1.1) {El emisor acepta una restricción\\sobre su política: \textbf{no}};
  \node[eje, anchor=south, text width=5.2cm, align=center] at (\xb,1.1) {El emisor acepta una restricción\\sobre su política: \textbf{sí}};
  \node[eje, anchor=east, text width=3.3cm, align=right] at (-3.1,\ya) {Hay una crisis que\\deslegitima el orden\\vigente: \textbf{sí}};
  \node[eje, anchor=east, text width=3.3cm, align=right] at (-3.1,\yb) {Hay una crisis que\\deslegitima el orden\\vigente: \textbf{no}};
\end{tikzpicture}
