% anx_pacto_asimetrico: por qué el pacto social no se recompuso después de 1973 (anexo III.3.1). CONTINÚA LA BASE del
% equilibrio cooperativo de anx_equilibrio_cooperativo del 3.B.20 (condición de cooperación del dilema del prisionero
% repetido, a partir de EICHENGREEN, 2007): la cooperación se sostiene si delta >= (T - R)/(T - P).
% Aquí se dibuja esa condición como una curva en el plano (T, delta), con R = 3 y P = 1, y se sitúan en ella las dos partes.
% Antes de 1973, delta era alto (0,72) y las dos partes tenían una ganancia de ruptura parecida (T = 4,5): las dos cooperaban.
% Después, la movilidad del capital y la fragmentación productiva elevan T solo para la empresa (hasta 7,0) y los horizontes
% más cortos bajan delta para los dos (hasta 0,50): la condición sigue cumpliéndose para el trabajador y deja de cumplirse
% para la empresa. Valores CUALITATIVOS: lo que importa es el signo de los dos desplazamientos.
% Generar desde la carpeta del tema: bash Code/generar_figura.sh anx_pacto_asimetrico
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=2mm]}, x=1.55cm, y=5cm]
  % zona en la que la cooperación se sostiene
  \fill[black!8] plot[domain=3.1:10.3, samples=120] (\x,{(\x-3)/(\x-1)}) -- (10.3,1.0) -- (3.1,1.0) -- cycle;
  \node[font=\scriptsize, text=black!65, align=center] at (4.9,0.88) {la cooperación\\se sostiene};
  \node[font=\scriptsize, text=black!65, align=center] at (8.9,0.30) {no se sostiene};
  % ejes
  \draw[->] (3,0) -- (10.6,0) node[below left] {$T$};
  \draw[->] (3,0) -- (3,1.05) node[left] {$\delta$};
  \node[anchor=south east, font=\scriptsize] at (10.55,0.015) {ganancia de romper el pacto};
  \node[rotate=90, font=\scriptsize, align=center] at (2.72,0.5) {valoración del futuro};
  % la condición
  \draw[black!90, very thick, domain=3.1:10.3, samples=120, smooth] plot (\x,{(\x-3)/(\x-1)});
  \node[anchor=west] at (10.32,0.79) {$\delta=\dfrac{T-R}{T-P}$};
  % los dos niveles de delta
  \draw[black!45, dashed] (3,0.72) -- (10.3,0.72);
  \node[left, text=black!55, font=\scriptsize] at (3,0.72) {$\delta_0$};
  \draw[black!85] (3,0.50) -- (10.3,0.50);
  \node[left, font=\scriptsize] at (3,0.50) {$\delta_1$};
  \draw[->, black!60, thick] (3.55,0.70) -- (3.55,0.52);
  \node[anchor=west, font=\scriptsize, text=black!65] at (3.62,0.61) {horizontes más cortos};
  % las dos partes
  \draw[black!45, densely dotted] (4.5,0) -- (4.5,0.50);
  \draw[black!45, densely dotted] (7.0,0) -- (7.0,0.667);
  \fill (4.5,0.50) circle (1.6pt);
  \fill (7.0,0.50) circle (1.6pt);
  \node[below] at (4.5,0) {trabajador};
  \node[below] at (7.0,0) {empresa};
  \draw[->, black!60, thick] (4.65,0.14) -- (6.85,0.14);
  \node[anchor=south, font=\scriptsize, text=black!65] at (5.75,0.16) {movilidad del capital};
\end{tikzpicture}
