% anx_erosion: la erosión silenciosa de la cuota del dólar en las reservas asignadas (anexo I.3.2). REUTILIZA LA BASE COMÚN C
% (barras apiladas al 100 %) de anx_clasificaciones, con tres segmentos en vez de dos.
% Datos: COFER del FMI. 1999: dólar 71,0, euro 17,9, resto 11,1. 2021: dólar 58,8, euro 20,6, resto 20,6.
% 2026 T2: dólar 56,7, euro 20,6, resto 22,7 (de los que el renminbi es 2,1). El punto de la figura es que el euro no gana.
% Generar desde la carpeta del tema: bash Code/generar_figura.sh anx_erosion
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=2mm]}, x=0.105cm, y=1.1cm,
    rotulo/.style={anchor=east, align=right, text width=2.2cm, execute at begin node={\hyphenpenalty=10000}}]
  \foreach \y/\dol/\eur/\etiq/\ld/\le/\lr in {%
      2/71.0/17.9/{1999}/{71{,}0}/{17{,}9}/{11{,}1},
      1/58.8/20.6/{2021}/{58{,}8}/{20{,}6}/{20{,}6},
      0/56.7/20.6/{2026, T2}/{56{,}7}/{20{,}6}/{22{,}7}}{
    \fill[black!55] (0,\y) rectangle (\dol,\y+0.46);
    \fill[black!25] (\dol,\y) rectangle ({\dol+\eur},\y+0.46);
    \fill[black!8] ({\dol+\eur},\y) rectangle (100,\y+0.46);
    \draw[black!70] (0,\y) rectangle (100,\y+0.46);
    \draw[black!70, line width=0.9pt] (\dol,\y) -- (\dol,\y+0.46);
    \draw[black!70, line width=0.9pt] ({\dol+\eur},\y) -- ({\dol+\eur},\y+0.46);
    \node[rotulo] at (-4,\y+0.23) {\etiq};
    \node[font=\footnotesize\bfseries, text=white] at (\dol/2,\y+0.23) {$\ld$};
    \node[font=\scriptsize] at ({\dol+\eur/2},\y+0.23) {$\le$};
    \node[font=\scriptsize] at ({(100+\dol+\eur)/2},\y+0.23) {$\lr$};
  }
  \draw[->] (0,-0.22) -- (104,-0.22);
  \foreach \x in {0,25,50,75,100}{\draw (\x,-0.18) -- (\x,-0.26) node[below, font=\scriptsize] {$\x$};}
  % leyenda
  \fill[black!55, draw=black!70] (0,2.72) rectangle (3.2,2.88);
  \node[anchor=west, font=\scriptsize] at (4.5,2.80) {Dólar};
  \fill[black!25, draw=black!70] (20,2.72) rectangle (23.2,2.88);
  \node[anchor=west, font=\scriptsize] at (24.5,2.80) {Euro};
  \fill[black!8, draw=black!70] (42,2.72) rectangle (45.2,2.88);
  \node[anchor=west, font=\scriptsize] at (46.5,2.80) {Resto (renminbi incluido: $2{,}1$ en 2026)};
\end{tikzpicture}
