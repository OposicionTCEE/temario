% b2_reglas_propiedades: por qué hubo reglas en unas materias y no en otras (cuerpo, bloque 2, dimensión comercial).
% REUTILIZA LA BASE COMÚN E del tema, aquí con tres columnas, una por clase de compromiso, y con las tres propiedades en las
% filas, más la fila de resultado. Es la síntesis en el cuerpo de lo que el anexo II desarrolla en dos apartados.
% La primera columna es el sistema monetario internacional porque es el compromiso del que viene el lector (dimensión anterior)
% y el que falla en las tres propiedades: la comparación se lee desde él. Su coste no es el nivel de empleo o de tipos de un
% trimestre, sino que atarse a una paridad hipoteca cualquier ajuste futuro, que es lo que ningún gobierno volvió a firmar.
% Sin narración dentro del panel: las etiquetas son nominales y la explicación va en la prosa.
% Generar desde la carpeta del tema: bash Code/generar_figura.sh b2_reglas_propiedades
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=2.4mm]},
    caja/.style={draw=black!80, thick, align=center, inner sep=4pt, text width=3.3cm, execute at begin node={\hyphenpenalty=10000}},
    cabecera/.style={draw=black!80, thick, fill=black!10, align=center, inner sep=4pt, text width=3.3cm, font=\footnotesize\bfseries, execute at begin node={\hyphenpenalty=10000}},
    veredicto/.style={draw=black!85, very thick, align=center, inner sep=4pt, text width=3.3cm, font=\footnotesize\bfseries, execute at begin node={\hyphenpenalty=10000}},
    fila/.style={anchor=east, align=right, text width=2.9cm, font=\scriptsize, text=black!65}]
  \def\xa{0}
  \def\xb{4.0}
  \def\xc{8.0}
  \node[cabecera] (ca) at (\xa,0) {El sistema monetario internacional};
  \node[cabecera] (cb) at (\xb,0) {Un arancel};
  \node[cabecera] (cc) at (\xc,0) {Una norma interna};
  \node[caja] (a1) at (\xa,-1.4) {La paridad sí; la conducta no};
  \node[caja] (b1) at (\xb,-1.4) {Sí: es un número público};
  \node[caja] (c1) at (\xc,-1.4) {No: proteger y regular se confunden};
  \node[caja, fill=black!5] (a2) at (\xa,-2.8) {No: es indivisible};
  \node[caja, fill=black!5] (b2) at (\xb,-2.8) {Sí: partida por partida};
  \node[caja, fill=black!5] (c2) at (\xc,-2.8) {No: se acepta o no se acepta};
  \node[caja] (a3) at (\xa,-4.2) {Mucho: ata las manos ante los ajustes futuros};
  \node[caja] (b3) at (\xb,-4.2) {Poco: el daño es difuso y tardío};
  \node[caja] (c3) at (\xc,-4.2) {Mucho: afecta a lo que se vende hoy};
  \node[veredicto] (a4) at (\xa,-5.7) {No las hubo: Jamaica};
  \node[veredicto, fill=black!12] (b4) at (\xb,-5.7) {Hubo reglas};
  \node[veredicto] (c4) at (\xc,-5.7) {No las hubo: Doha};
  \foreach \a/\b in {ca/a1, a1/a2, a2/a3, a3/a4, cb/b1, b1/b2, b2/b3, b3/b4, cc/c1, c1/c2, c2/c3, c3/c4}{\draw[->, black!70] (\a) -- (\b);}
  \node[fila] at (-2.0,-1.4) {¿es verificable?};
  \node[fila] at (-2.0,-2.8) {¿es divisible?};
  \node[fila] at (-2.0,-4.2) {¿qué cuesta aceptarlo?};
  \node[fila] at (-2.0,-5.7) {¿hubo reglas?};
\end{tikzpicture}
