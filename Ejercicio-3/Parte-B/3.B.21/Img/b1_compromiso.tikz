% b1_compromiso: el compromiso de 1944, mercado por mercado (cuerpo, bloque 1). REUTILIZA LA BASE COMÚN E del tema (dos
% columnas enfrentadas con filas comunes), aquí con las cuatro dimensiones en las filas y la libertad y la obligación en las
% columnas. Las cuatro filas son las cuatro dimensiones con las que el tema organiza el orden actual.
% Sin narración dentro del panel: las etiquetas son nominales y la explicación va en la prosa.
% Generar desde la carpeta del tema: bash Code/generar_figura.sh b1_compromiso
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=2.4mm]},
    caja/.style={draw=black!80, thick, align=center, inner sep=4pt, text width=4.6cm, execute at begin node={\hyphenpenalty=10000}},
    cabecera/.style={draw=black!80, thick, fill=black!10, align=center, inner sep=4pt, text width=4.6cm, font=\footnotesize\bfseries, execute at begin node={\hyphenpenalty=10000}},
    fila/.style={anchor=east, align=right, text width=1.9cm, font=\footnotesize\bfseries}]
  \def\xi{0}
  \def\xd{5.9}
  \node[cabecera] (ci) at (\xi,0) {Lo que el orden concedía};
  \node[cabecera] (cd) at (\xd,0) {Lo que exigía a cambio};
  \node[caja] (i1) at (\xi,-1.5) {Autonomía de la política monetaria};
  \node[caja] (d1) at (\xd,-1.5) {Paridad declarada, variable solo ante un desequilibrio fundamental};
  \node[caja, fill=black!5] (i2) at (\xi,-3.1) {Apertura gradual, con excepciones y salvaguardias};
  \node[caja, fill=black!5] (d2) at (\xd,-3.1) {Reciprocidad y no discriminación entre los miembros};
  \node[caja] (i3) at (\xi,-4.5) {Controles de capital permitidos};
  \node[caja] (d3) at (\xd,-4.5) {Convertibilidad de la cuenta corriente};
  \node[caja, fill=black!5] (i4) at (\xi,-6.0) {El pleno empleo como objetivo declarado};
  \node[caja, fill=black!5] (d4) at (\xd,-6.0) {Moderación salarial, no escrita en ningún sitio};
  \foreach \a/\b in {ci/i1, cd/d1}{\draw[->, black!70] (\a) -- (\b);}
  \foreach \y in {-1.5, -3.1, -4.5, -6.0}{\draw[<->, black!70] (2.35,\y) -- (3.55,\y);}
  \node[fila] at (-2.5,-1.5) {Moneda};
  \node[fila] at (-2.5,-3.1) {Comercio};
  \node[fila] at (-2.5,-4.5) {Capital};
  \node[fila] at (-2.5,-6.0) {Sociedad};
\end{tikzpicture}
