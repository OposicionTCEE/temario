% anx_cuna_bienes: la cuña de precios entre dos mercados cuando el producto cruza la frontera tres veces (anexo II.1.3).
% CONTINÚA LA BASE COMÚN D de b1_cuna, b2_cuna y b3_cuna del 3.B.20, con las mismas curvas: exportador S_N: P = 0,5 + 0,5 Q,
% D_N: P = 4,0 - 0,5 Q; importador S_E: P = 2,0 + 0,5 Q, D_E: P = 7,0 - 0,5 Q. Con cuña tau: P_N = 3,375 - tau/2,
% P_E = 3,375 + tau/2, comercio = 4,5 - 2 tau.
% La novedad respecto del 3.B.20 es que el arancel se paga en cada cruce: con tres cruces la cuña efectiva es 3 tau.
% En gris, el arancel con el que acabó la Ronda Tokio, tau3 = 0,4 (el de b3_cuna), multiplicado por tres: 3 tau3 = 1,2,
% con P_N = 2,775 (Q_D 2,45 y Q_S 4,55), P_E = 3,975 (Q_S 3,95 y Q_D 6,05) y comercio 2,1.
% En negro, el arancel de hoy, tau4 = 0,1, también por tres: 3 tau4 = 0,3, con P_N = 3,225 (Q_D 1,55 y Q_S 5,45),
% P_E = 3,525 (Q_S 3,05 y Q_D 6,95) y comercio 3,9.
% Generar desde la carpeta del tema: bash Code/generar_figura.sh anx_cuna_bienes
\begin{tikzpicture}[font=\footnotesize, x=0.72cm, y=0.72cm, >={Stealth[length=2mm]}]
  % ---------- Exportador ----------
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (4.2,7.6) {Exportador ($N$)};
    \draw[->] (0,0) -- (8.6,0) node[below left] {Componentes};
    \draw[->] (0,0) -- (0,7.2) node[left] {$P$};
    \draw[black!85, thick] (0,0.5) -- (8.4,4.7) node[above left] {$S_N$};
    \draw[black!85, thick] (0,4.0) -- (7.0,0.5) node[above right] {$D_N$};
    \draw[black!45, dashed] (0,2.775) -- (8.4,2.775);
    \draw[black!85] (0,3.225) -- (8.4,3.225);
    \node[left] at (0,2.775) {$P_N^3$};
    \node[left] at (0,3.225) {$P_N^4$};
    \draw[line width=2.2pt, black!40] (2.45,2.775) -- (4.55,2.775);
    \draw[line width=2.2pt, black!85] (1.55,3.225) -- (5.45,3.225);
    \draw[decorate, decoration={brace, mirror, amplitude=2.5pt}, black!55] (2.45,2.63) -- (4.55,2.63) node[midway, below=3pt] {$X_3$};
    \draw[decorate, decoration={brace, amplitude=3pt}] (1.55,3.37) -- (5.45,3.37) node[midway, above=3pt] {$X_4$};
    \draw[->, black!70] (7.8,2.85) -- (7.8,3.15);
  \end{scope}
  % ---------- Importador ----------
  \begin{scope}[xshift=9.2cm]
    \node[font=\footnotesize\bfseries] at (4.2,7.6) {Importador ($E$)};
    \draw[->] (0,0) -- (8.6,0) node[below left] {Componentes};
    \draw[->] (0,0) -- (0,7.2) node[left] {$P$};
    \draw[black!85, thick] (0,2.0) -- (8.4,6.2) node[below right] {$S_E$};
    \draw[black!85, thick] (0,7.0) -- (8.4,2.8) node[below left] {$D_E$};
    \draw[black!45, dashed] (0,3.975) -- (8.4,3.975) node[right, black] {$P_E^3$};
    \draw[black!85] (0,3.525) -- (8.4,3.525) node[right] {$P_E^4$};
    \draw[line width=2.2pt, black!40] (3.95,3.975) -- (6.05,3.975);
    \draw[line width=2.2pt, black!85] (3.05,3.525) -- (6.95,3.525);
    \draw[decorate, decoration={brace, amplitude=2.5pt}, black!55] (3.95,4.12) -- (6.05,4.12) node[midway, above=3pt] {$M_3$};
    \draw[decorate, decoration={brace, mirror, amplitude=3pt}] (3.05,3.38) -- (6.95,3.38) node[midway, below=3pt] {$M_4$};
    \draw[->, black!70] (7.9,3.9) -- (7.9,3.6);
    % la cuña: los precios del exportador, prolongados hasta el eje del importador
    \draw[black!45, densely dotted] (-4.38,2.775) -- (0,2.775);
    \draw[black!85, densely dotted] (-4.38,3.225) -- (0,3.225);
    \draw[decorate, decoration={brace, amplitude=3pt}, black!55] (-2.7,2.775) -- (-2.7,3.975) node[midway, left=4pt] {$3\tau_3$};
    \draw[decorate, decoration={brace, amplitude=2.5pt}] (-0.8,3.225) -- (-0.8,3.525) node[midway, left=3pt] {$3\tau_4$};
  \end{scope}
\end{tikzpicture}
