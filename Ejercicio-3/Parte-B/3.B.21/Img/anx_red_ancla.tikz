% anx_red_ancla: efectos de red en la elección de ancla y equilibrios múltiples (anexo I.1.5). BASE COMÚN F del tema: ganancia
% neta de adoptar una moneda frente a la proporción que ya la usa, con dos equilibrios estables y un punto de inflexión; se
% reutiliza en el anexo I (moneda de reserva y de facturación) y en el anexo II (moneda de los contratos). Continúa el
% argumento de efectos de red con el que el 3.B.20 explica el paso al oro de 1871-1879.
% G(theta) = 1,2 tanh(5 (theta - 0,42)), escrita con exponenciales para no depender de tanh en pgfmath. theta* = 0,42.
% Generar desde la carpeta del tema: bash Code/generar_figura.sh anx_red_ancla
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=2mm]}, x=9cm, y=1.55cm]
  % ejes
  \draw[black!30, thin] (0,0) -- (1.02,0);
  \draw[->] (0,-1.45) -- (0,1.5) node[above left, align=left] {$G(\theta)$};
  \draw[->] (0,-1.45) -- (1.08,-1.45) node[below left] {$\theta$};
  \foreach \x/\et in {0/0, 0.25/{0{,}25}, 0.5/{0{,}5}, 0.75/{0{,}75}, 1/1}{\draw (\x,-1.42) -- (\x,-1.48) node[below, font=\scriptsize] {$\et$};}
  \node[left, font=\scriptsize] at (0,0) {$0$};
  % curva G
  \draw[black!90, very thick, domain=0:1, samples=120, smooth]
    plot (\x, {1.2*(exp(5*(\x-0.42)) - exp(-5*(\x-0.42)))/(exp(5*(\x-0.42)) + exp(-5*(\x-0.42)))});
  % punto de inflexion
  \fill (0.42,0) circle (1.5pt);
  \draw[black!45, densely dotted] (0.42,0) -- (0.42,-1.45);
  \node[below, font=\scriptsize] at (0.42,-1.45) {$\theta^{*}$};
  % equilibrios estables
  \fill (0,-1.45) circle (2pt);
  \fill (1,-1.45) circle (2pt);
  \node[anchor=north west, font=\scriptsize, align=left, text=black!70] at (0.015,-1.52) {equilibrio\\estable};
  \node[anchor=north east, font=\scriptsize, align=right, text=black!70] at (0.99,-1.52) {equilibrio\\estable};
  % dinamica
  \draw[->, black!70, thick] (0.34,-1.1) -- (0.08,-1.1);
  \draw[->, black!70, thick] (0.50,-1.1) -- (0.92,-1.1);
  \node[font=\scriptsize, text=black!70, anchor=south] at (0.21,-1.08) {se abandona};
  \node[font=\scriptsize, text=black!70, anchor=south] at (0.71,-1.08) {se adopta};
  % posiciones
  \draw[black!55, densely dashed] (0.86,0) -- (0.86,{1.2*(exp(5*(0.86-0.42)) - exp(-5*(0.86-0.42)))/(exp(5*(0.86-0.42)) + exp(-5*(0.86-0.42)))});
  \fill (0.86,{1.2*(exp(5*(0.86-0.42)) - exp(-5*(0.86-0.42)))/(exp(5*(0.86-0.42)) + exp(-5*(0.86-0.42)))}) circle (1.5pt);
  \node[anchor=north, font=\footnotesize\bfseries] at (0.86,0.92) {Dólar};
  \draw[black!55, densely dashed] (0.26,0) -- (0.26,{1.2*(exp(5*(0.26-0.42)) - exp(-5*(0.26-0.42)))/(exp(5*(0.26-0.42)) + exp(-5*(0.26-0.42)))});
  \fill (0.26,{1.2*(exp(5*(0.26-0.42)) - exp(-5*(0.26-0.42)))/(exp(5*(0.26-0.42)) + exp(-5*(0.26-0.42)))}) circle (1.5pt);
  \node[anchor=north west, font=\footnotesize\bfseries] at (0.27,-0.62) {Euro};
  % ejes: nombres
  \node[anchor=west, font=\scriptsize, text width=4.1cm, align=left] at (0.50,1.18)
    {$\theta$: proporción del comercio, la deuda y las reservas del país ya denominada en esa moneda};
\end{tikzpicture}
