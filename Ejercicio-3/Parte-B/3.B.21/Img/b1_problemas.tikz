% b1_problemas: los cuatro problemas que todo sistema monetario internacional tiene que resolver (cuerpo, bloque 1).
% BASE COMÚN L del tema: un concepto central y sus componentes alrededor. Es la figura que anuncia el anexo I, que recorre los
% cuatro problemas uno a uno, y los cuatro son los que el tema anterior usó para comparar los tres sistemas precedentes.
% Sin narración dentro del panel: cada caja lleva el nombre del problema y la pregunta que lo define.
% Generar desde la carpeta del tema: bash Code/generar_figura.sh b1_problemas
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=2.4mm]},
    centro/.style={draw=black!85, very thick, fill=black!10, align=center, inner sep=5pt, text width=3.5cm, font=\footnotesize\bfseries, execute at begin node={\hyphenpenalty=10000}},
    problema/.style={draw=black!80, thick, align=center, inner sep=4pt, text width=3.6cm, execute at begin node={\hyphenpenalty=10000}}]
  \node[centro] (c) at (0,0) {Sistema monetario\\internacional};
  \node[problema] (a) at (0,2.5) {\textbf{Ancla}\\[1pt]¿qué fija el valor del dinero?};
  \node[problema] (l) at (5.1,0) {\textbf{Liquidez}\\[1pt]¿de dónde salen las reservas?};
  \node[problema] (j) at (0,-2.5) {\textbf{Ajuste}\\[1pt]¿quién corrige el desequilibrio?};
  \node[problema] (f) at (-5.1,0) {\textbf{Confianza}\\[1pt]¿por qué nadie huye del activo?};
  \foreach \n in {a, l, j, f}{\draw[->, black!75, thick] (c) -- (\n);}
\end{tikzpicture}
