% anx_dos_aperturas: por qué la apertura comercial se negoció y la financiera no (anexo II.2.2). REUTILIZA LA BASE COMÚN E del
% tema, deliberadamente con la misma rejilla que anx_reglas_bienes_dinero, para que las dos comparaciones se lean juntas.
% Sin narración dentro del panel: las etiquetas son nominales y la explicación va en la prosa.
% Generar desde la carpeta del tema: bash Code/generar_figura.sh anx_dos_aperturas
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=2.4mm]},
    caja/.style={draw=black!80, thick, align=center, inner sep=4pt, text width=4.0cm, execute at begin node={\hyphenpenalty=10000}},
    cabecera/.style={draw=black!80, thick, fill=black!10, align=center, inner sep=4pt, text width=4.0cm, font=\footnotesize\bfseries, execute at begin node={\hyphenpenalty=10000}},
    fila/.style={anchor=east, align=right, text width=3.1cm, font=\scriptsize, text=black!65}]
  \def\xi{0}
  \def\xd{5.3}
  \node[cabecera] (ci) at (\xi,0) {La apertura\\comercial};
  \node[cabecera] (cd) at (\xd,0) {La apertura\\financiera};
  \node[caja] (i1) at (\xi,-1.5) {Por negociación recíproca, ronda tras ronda};
  \node[caja] (d1) at (\xd,-1.5) {Por decisión unilateral de cada Estado};
  \node[caja, fill=black!5] (i2) at (\xi,-2.9) {La apertura del otro};
  \node[caja, fill=black!5] (d2) at (\xd,-2.9) {La entrada de capital};
  \node[caja] (i3) at (\xi,-4.2) {Un órgano de solución de diferencias};
  \node[caja] (d3) at (\xd,-4.2) {Nadie};
  \node[caja, fill=black!5] (i4) at (\xi,-5.6) {Pierde las concesiones ajenas};
  \node[caja, fill=black!5] (d4) at (\xd,-5.6) {Pierde capital frente a quien abre más};
  \foreach \a/\b in {ci/i1, i1/i2, i2/i3, i3/i4, cd/d1, d1/d2, d2/d3, d3/d4}{\draw[->, black!70] (\a) -- (\b);}
  \node[fila] at (-2.3,-1.5) {¿cómo se decidió?};
  \node[fila] at (-2.3,-2.9) {¿qué gana el que abre?};
  \node[fila] at (-2.3,-4.2) {¿quién vigila el cumplimiento?};
  \node[fila] at (-2.3,-5.6) {¿qué le ocurre al que abre menos?};
\end{tikzpicture}
