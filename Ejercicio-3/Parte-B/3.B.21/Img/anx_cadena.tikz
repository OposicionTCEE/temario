% anx_cadena: qué cambió en la producción cuando se fragmentó, y por qué el mismo producto cruza la frontera varias veces
% (anexo II.1.3). BASE COMÚN I del tema: una secuencia de etapas con las fronteras marcadas, frente al mismo proceso sin
% fragmentar. Justifica el supuesto de los tres cruces de anx_cuna_bienes.
% Sin narración dentro del panel: las etiquetas son nominales y la explicación va en la prosa.
% Generar desde la carpeta del tema: bash Code/generar_figura.sh anx_cadena
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=2.4mm]},
    etapa/.style={draw=black!80, thick, align=center, inner sep=4pt, text width=2.5cm, minimum height=0.9cm,
                  execute at begin node={\hyphenpenalty=10000}},
    unica/.style={draw=black!80, thick, fill=black!5, align=center, inner sep=5pt, text width=12.4cm, minimum height=0.9cm},
    rotulo/.style={font=\footnotesize\bfseries},
    pais/.style={font=\scriptsize, text=black!65}]
  \def\xa{-5.25}
  \def\xb{-1.75}
  \def\xc{1.75}
  \def\xd{5.25}
  % ---------- antes ----------
  \node[rotulo, anchor=west] at (-6.75,1.25) {Hasta los años ochenta};
  \node[unica] (u) at (0,0.3) {Todas las etapas dentro de la misma frontera};
  \node[pais, anchor=west] at (-6.75,-0.45) {Un país};
  % ---------- después ----------
  \node[rotulo, anchor=west] at (-6.75,-1.75) {Desde los años noventa};
  \node[etapa] (e1) at (\xa,-2.7) {Diseño};
  \node[etapa] (e2) at (\xb,-2.7) {Componentes};
  \node[etapa] (e3) at (\xc,-2.7) {Ensamblaje};
  \node[etapa] (e4) at (\xd,-2.7) {Distribución};
  \foreach \a/\b in {e1/e2, e2/e3, e3/e4}{\draw[->, black!80, thick] (\a) -- (\b);}
  \foreach \x in {-3.5, 0, 3.5}{
    \draw[black!55, dashed] (\x,-2.05) -- (\x,-3.35);
    \node[pais, anchor=south, text=black!55] at (\x,-2.02) {frontera};
  }
  \node[pais] at (\xa,-3.6) {País A};
  \node[pais] at (\xb,-3.6) {País B};
  \node[pais] at (\xc,-3.6) {País C};
  \node[pais] at (\xd,-3.6) {País D};
  \draw[decorate, decoration={brace, mirror, amplitude=4pt}] (-3.5,-4.05) -- (3.5,-4.05)
    node[midway, below=5pt, font=\scriptsize] {Tres cruces de frontera para un solo producto};
\end{tikzpicture}
