% anx_apertura_cronologia: cómo se abrió la cuenta financiera, jurisdicción por jurisdicción (anexo II.2.1). BASE COMÚN J del
% tema: una línea de tiempo con los hitos escalonados en tres alturas y un tramo acotado debajo. Se reutiliza siempre que la
% tesis sea que una serie de decisiones separadas produjo un resultado que nadie acordó.
% OJO: el eje va en años transcurridos desde 1970, no en años absolutos. Con años absolutos la coordenada supera la dimensión
% máxima de TeX (16384 pt) y la figura sale rota.
% Sin narración dentro del panel: las etiquetas son nominales y la explicación va en la prosa.
% Generar desde la carpeta del tema: bash Code/generar_figura.sh anx_apertura_cronologia
\begin{tikzpicture}[x=0.52cm, y=1cm, font=\footnotesize, >={Stealth[length=2.2mm]},
    hito/.style={draw=black!80, thick, fill=white, align=center, inner sep=3pt, text width=2.0cm, font=\scriptsize,
                 execute at begin node={\hyphenpenalty=10000}},
    intento/.style={draw=black!80, thick, dashed, fill=black!5, align=center, inner sep=3pt, text width=2.2cm,
                    font=\scriptsize, execute at begin node={\hyphenpenalty=10000}}]
  \draw[->, black!80, thick] (2,0) -- (31,0);
  \foreach \x/\a in {5/1975, 10/1980, 15/1985, 20/1990, 25/1995, 30/2000}{
    \draw[black!80] (\x,0.08) -- (\x,-0.08) node[below, font=\scriptsize] {\a};
  }
  \foreach \x/\y/\t in {%
      4/0.75/{\textbf{1974}\\Estados Unidos},
      9/1.55/{\textbf{1979}\\Reino Unido},
      11/2.35/{\textbf{1980-1984}\\Japón},
      20/0.75/{\textbf{1988-1990}\\Comunidad Económica Europea},
      24/1.55/{\textbf{Años noventa}\\Economías emergentes}}{
    \draw[black!55] (\x,0) -- (\x,\y-0.3);
    \node[hito] at (\x,\y) {\t};
  }
  \draw[black!55, dashed] (27,0) -- (27,2.05);
  \node[intento] at (27.6,2.45) {\textbf{1997}\\Enmienda del Convenio del Fondo};
  \draw[decorate, decoration={brace, mirror, amplitude=4pt}] (4,-0.6) -- (26,-0.6)
    node[midway, below=5pt, font=\scriptsize] {Decisiones unilaterales};
  \draw[black!55, dashed] (27,-0.55) -- (27,-0.85);
  \node[font=\scriptsize, anchor=north] at (27,-0.9) {Único intento de regla común};
\end{tikzpicture}
