% b2_incidencia_base: por qué compensar se encareció y proteger no (cuerpo, bloque 2, orden social).
% TRAE LA BASE DE anx_incidencia DEL 3.A.25, donde está el desarrollo de la incidencia de un impuesto y la pérdida de
% eficiencia, y la adapta a este tema. Dos cambios de contexto: allí los dos paneles son el mismo factor con dos
% elasticidades de oferta y la pregunta es quién soporta el impuesto; aquí son dos bases distintas de un mismo país, la que
% puede irse y la que no, y la pregunta es si compensar al perdedor es financiable. Y el triángulo de pérdida de eficiencia
% se sustituye por el rectángulo de recaudación, que es lo que este apartado necesita ver.
% Demanda común: r = 4,5 - 0,5 F. Cuña fiscal tau = 1.
% (a) Base inmóvil, oferta r = 0,5 + 1,2 F: E = (2,353; 3,324); con el impuesto F = 1,765, r_E = 3,618 y r_N = 2,618, de modo
%     que el factor soporta 0,706 de cada unidad y la recaudación es 1,765.
% (b) Base móvil, oferta r = 2,8 + 0,18 F: E = (2,5; 3,25); con el impuesto F = 1,029, r_E = 3,985 y r_N = 2,985: el factor
%     soporta 0,265 y la recaudación cae a 1,029. Rectas ilustrativas, sin datos.
% Sin narración dentro del panel: las etiquetas son nominales y la explicación va en la prosa.
% Generar desde la carpeta del tema: bash Code/generar_figura.sh b2_incidencia_base
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1.25cm, y=1.05cm]
  % ---------------- (a) Base que no puede irse ----------------
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (2.4,5.1) {(a) Base que no puede irse};
    \fill[black!12] (0,2.618) rectangle (1.765,3.618);
    \draw[->] (0,0) -- (4.9,0) node[below] {$F$};
    \draw[->] (0,0) -- (0,4.8) node[left] {$r$};
    \draw[very thick] (0.3,0.86) -- (3.4,4.58) node[above] {oferta};
    \draw[very thick] (0.3,4.35) -- (4.5,2.25) node[right] {demanda};
    \draw[dotted] (0,3.618) -- (1.765,3.618);
    \draw[dotted] (0,2.618) -- (1.765,2.618);
    \draw[dotted] (2.353,3.324) -- (2.353,0);
    \draw[dotted] (1.765,2.618) -- (1.765,0);
    \fill (2.353,3.324) circle (1.6pt) node[above right, inner sep=2pt] {$E$};
    \node[left] at (0,3.618) {$r_E$};
    \node[left] at (0,2.618) {$r_N$};
    \node[font=\scriptsize, anchor=west] at (0.05,2.30) {recaudación};
    \draw[decorate, decoration={brace, amplitude=3pt}] (1.30,3.618) -- (1.30,2.618) node[midway, right=3pt] {$\tau$};
  \end{scope}
  % ---------------- (b) Base que puede irse ----------------
  \begin{scope}[xshift=7.4cm]
    \node[font=\footnotesize\bfseries] at (2.4,5.1) {(b) Base que puede irse};
    \fill[black!12] (0,2.985) rectangle (1.029,3.985);
    \draw[->] (0,0) -- (4.9,0) node[below] {$F$};
    \draw[->] (0,0) -- (0,4.8) node[left] {$r$};
    \draw[very thick] (0.2,2.836) -- (4.6,3.628) node[right] {oferta};
    \draw[very thick] (0.3,4.35) -- (4.5,2.25) node[right] {demanda};
    \draw[dotted] (0,3.985) -- (1.029,3.985);
    \draw[dotted] (0,2.985) -- (1.029,2.985);
    \draw[dotted] (2.5,3.25) -- (2.5,0);
    \draw[dotted] (1.029,2.985) -- (1.029,0);
    \fill (2.5,3.25) circle (1.6pt) node[above right, inner sep=2pt] {$E$};
    \node[left] at (0,3.985) {$r_E$};
    \node[left] at (0,2.985) {$r_N$};
    \node[font=\scriptsize, anchor=west] at (1.2,3.49) {recaudación};
    \draw[decorate, decoration={brace, amplitude=3pt}] (1.25,3.985) -- (1.25,2.985) node[midway, right=3pt] {$\tau$};
  \end{scope}
\end{tikzpicture}
