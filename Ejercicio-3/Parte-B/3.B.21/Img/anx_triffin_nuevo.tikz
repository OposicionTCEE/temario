% anx_triffin_nuevo: el nuevo dilema de TRIFFIN (anexo I.2.4). CONTINÚA LA BASE anx_triffin del 3.B.20, con la misma geometría
% (frontera decreciente que se desplaza hacia abajo, umbral c = 1 y zona sombreada), cambiando lo que miden los ejes.
% Eje horizontal: demanda de activo seguro del resto del mundo, l (crece con el PIB mundial). Vertical: respaldo fiscal de los
% pasivos seguros del emisor, c = capacidad fiscal / pasivos seguros en circulación. Frontera c(l) = kappa / (1 + l),
% decreciente: cuanta más reserva quiere el mundo, más deuda emitida y menor respaldo por unidad. El desplazamiento de F0 a F1
% recoge la caída del peso del emisor en el PIB mundial (kappa de 1,8 a 1,2).
% g = 0,6 (reserva que el mundo quiere hoy): A0 = (0,6; 1,125) por encima de 1; A1 = (0,6; 0,75) por debajo;
% B1 = (0,2; 1) en F1: respaldo a costa de escasez de activo seguro.
% Generar desde la carpeta del tema: bash Code/generar_figura.sh anx_triffin_nuevo
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=2mm]}, x=6.0cm, y=2.3cm]
  % zona de respaldo insuficiente
  \fill[black!8] (0,0) rectangle (1.2,1.0);
  \node[font=\scriptsize, text=black!60] at (0.97,0.22) {el activo deja de ser seguro};
  % ejes
  \draw[->] (0,0) -- (1.27,0) node[below left] {$\ell$};
  \draw[->] (0,0) -- (0,2.05) node[left] {$c$};
  % guías
  \draw[black!55, dashed] (0,1.0) -- (1.2,1.0);
  \node[left] at (0,1.0) {$1$};
  \draw[black!55, dashed] (0.6,0) -- (0.6,1.95);
  \node[below] at (0.6,0) {$g$};
  % fronteras
  \draw[black!45, very thick, domain=0:1.15, samples=60, smooth] plot (\x, {1.8/(1+\x)}) node[right, black!60] {$t_0$};
  \draw[black!90, very thick, domain=0:1.15, samples=60, smooth] plot (\x, {1.2/(1+\x)}) node[right] {$t_1$};
  \draw[->, thick, black!60] (0.95,0.89) -- (0.95,0.66);
  \node[anchor=west, font=\scriptsize, text=black!60, align=left] at (0.99,0.78) {cae el peso\\del emisor};
  % puntos
  \fill (0.6,1.125) circle (1.4pt) node[above right] {$A_0$};
  \fill (0.6,0.75) circle (1.4pt) node[below left] {$A_1$};
  \fill (0.2,1.0) circle (1.4pt) node[above right] {$B_1$};
  \draw[black!45, densely dotted] (0.2,0) -- (0.2,1.0);
  \node[below] at (0.2,0) {$\ell_{B}$};
  \draw[decorate, decoration={brace, mirror, amplitude=3pt}] (0.21,-0.30) -- (0.59,-0.30)
    node[midway, below=3pt, font=\scriptsize, align=center] {escasez de\\activo seguro};
\end{tikzpicture}
