% b3_tres_salidas: las tres salidas del trilema político, con el estado en que está cada una (cuerpo, bloque 3).
% REPITE LA BASE DE b1_trilema_politico de este mismo tema, que a su vez continúa la base común B' del 3.B.20: mismos
% vértices en el mismo sitio y mismo punto central. Lo que añade, y es la razón de repetirla aquí, es que las tres salidas
% dejan de ser simétricas: una se está recorriendo, otra ya se recorrió y la tercera solo existe a escala regional. El
% bloque 1 planteaba la posición; este la resuelve en grados.
% Sin narración dentro del panel: los rótulos son nominales y el coste de cada salida va en la prosa.
% Generar desde la carpeta del tema: bash Code/generar_figura.sh b3_tres_salidas
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=2.2mm]},
    vertice/.style={draw=black!85, thick, fill=black!8, align=center, inner sep=3pt, text width=2.9cm, execute at begin node={\hyphenpenalty=10000}},
    salida/.style={align=center, inner sep=2pt, text width=2.9cm, font=\scriptsize, execute at begin node={\hyphenpenalty=10000}}]
  \coordinate (F) at (0,3.6);
  \coordinate (A) at (-3.6,0);
  \coordinate (M) at (3.6,0);
  \draw[black!35, thin] (A) -- (F) -- (M) -- cycle;
  \node[vertice, anchor=south] at (F) {Integración económica profunda};
  \node[vertice, anchor=north] at (A) {Democracia de masas};
  \node[vertice, anchor=north] at (M) {Estado nación};
  % el punto de partida: los tres a la vez
  \fill[black!85] (0,1.35) circle (2.4pt);
  \node[align=center, font=\footnotesize\bfseries, below=3pt] at (0,1.35) {El orden actual};
  % salida 1: gobierno supranacional, solo a escala regional
  \draw[->, thin, black!40, densely dotted] (-0.30,1.50) -- (-1.25,2.10);
  \node[salida, text width=2.6cm, anchor=east, text=black!55] at (-2.25,2.35) {Gobierno supranacional\\[1pt]\textit{solo a escala regional}};
  % salida 2: democracia acotada, ya recorrida
  \draw[->, thick, black!60, dashed] (0.30,1.50) -- (1.25,2.10);
  \node[salida, text width=2.6cm, anchor=west, text=black!70] at (2.25,2.35) {Democracia acotada\\[1pt]\textit{ya recorrida}};
  % salida 3: cierre, en curso
  \draw[->, very thick, black!90] (0,0.90) -- (0,0.22);
  \node[salida, font=\scriptsize\bfseries, anchor=north] at (0,-0.6) {Cierre: menos integración\\[1pt]\textit{en curso}};
\end{tikzpicture}
