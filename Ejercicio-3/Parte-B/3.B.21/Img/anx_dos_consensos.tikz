% anx_dos_consensos: dónde residía cada consenso y por qué eso determina cuánto dura (anexo III.2.2). REUTILIZA LA BASE COMÚN E
% del tema, con la misma rejilla que anx_reglas_bienes_dinero y anx_dos_aperturas, para que las tres comparaciones se lean
% juntas: la de los compromisos, la de las aperturas y la de los consensos.
% Sin narración dentro del panel: las etiquetas son nominales y la explicación va en la prosa.
% Generar desde la carpeta del tema: bash Code/generar_figura.sh anx_dos_consensos
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=2.4mm]},
    caja/.style={draw=black!80, thick, align=center, inner sep=4pt, text width=4.2cm, execute at begin node={\hyphenpenalty=10000}},
    cabecera/.style={draw=black!80, thick, fill=black!10, align=center, inner sep=4pt, text width=4.2cm, font=\footnotesize\bfseries, execute at begin node={\hyphenpenalty=10000}},
    fila/.style={anchor=east, align=right, text width=3.0cm, font=\scriptsize, text=black!65}]
  \def\xi{0}
  \def\xd{5.6}
  \node[cabecera] (ci) at (\xi,0) {El consenso\\de 1944};
  \node[cabecera] (cd) at (\xd,0) {El consenso\\posterior a 1973};
  \node[caja] (i1) at (\xi,-1.6) {En tratados y en programas de gobierno};
  \node[caja] (d1) at (\xd,-1.6) {En bancos centrales independientes, condicionalidad y cuerpos técnicos};
  \node[caja, fill=black!5] (i2) at (\xi,-3.2) {Negociando entre Estados};
  \node[caja, fill=black!5] (d2) at (\xd,-3.2) {Convenciendo a una profesión};
  \node[caja] (i3) at (\xi,-4.5) {Ante el votante de cada país};
  \node[caja] (d3) at (\xd,-4.5) {Ante nadie en particular};
  \node[caja, fill=black!5] (i4) at (\xi,-5.8) {Lo que dure la mayoría que lo adoptó};
  \node[caja, fill=black!5] (d4) at (\xd,-5.8) {Más que cualquier mayoría};
  \foreach \a/\b in {ci/i1, i1/i2, i2/i3, i3/i4, cd/d1, d1/d2, d2/d3, d3/d4}{\draw[->, black!70] (\a) -- (\b);}
  \node[fila] at (-2.4,-1.6) {¿dónde reside?};
  \node[fila] at (-2.4,-3.2) {¿cómo se cambia?};
  \node[fila] at (-2.4,-4.5) {¿ante quién responde?};
  \node[fila] at (-2.4,-5.8) {¿cuánto dura?};
\end{tikzpicture}
