% Patrones de signos de los flujos de efectivo y fase de la empresa (cuerpo, «Circulación financiera»), a partir de DICKINSON (2011).
% Figura abstracta, sin cifras. Generar con: bash Code/generar_figura.sh patrones_flujos
\begin{tikzpicture}[font=\footnotesize]
% \barra{x}{signo}: signo 1 = positivo, -1 = negativo, 0 = cualquiera (discontinua a ambos lados)
\newcommand{\barra}[3]{% #1 abscisa, #2 signo, #3 letra
  \ifnum#2=1
    \draw[thick, fill=gray!20] (#1,0) rectangle (#1+0.5,0.9);
  \fi
  \ifnum#2=-1
    \draw[thick, fill=white] (#1,0) rectangle (#1+0.5,-0.9);
  \fi
  \ifnum#2=0
    \draw[thick, dashed, fill=white] (#1,-0.9) rectangle (#1+0.5,0.9);
    \node[font=\scriptsize] at (#1+0.25,0) {$\pm$};
  \fi
  \node[font=\scriptsize, anchor=north] at (#1+0.25,-1.0) {#3};}
\newcommand{\panel}[5]{% #1 abscisa, #2 título, #3-#5 signos de E, I, F
  \node[font=\footnotesize\itshape, align=center, anchor=south] at (#1+1.05,1.05) {#2};
  \draw[black!50] (#1-0.15,0) -- (#1+2.25,0);
  \barra{#1}{#3}{E}
  \barra{#1+0.8}{#4}{I}
  \barra{#1+1.6}{#5}{F}}
\panel{0}{(a) Introducción}{-1}{-1}{1}
\panel{2.9}{(b) Crecimiento}{1}{-1}{1}
\panel{5.8}{(c) Madurez}{1}{-1}{-1}
\panel{8.7}{(d) Sacudida}{0}{0}{0}
\panel{11.6}{(e) Declive}{-1}{1}{0}
\node[font=\scriptsize, text=black!60] at (9.75,-1.65) {combinaciones restantes};
\end{tikzpicture}
