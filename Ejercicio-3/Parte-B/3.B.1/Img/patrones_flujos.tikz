% Patrones de signos de los flujos de efectivo y fase de la empresa (cuerpo, «Circulación financiera»), a partir de DICKINSON (2011).
% Figura abstracta, sin cifras. Las alturas respetan la identidad E + I + F = variación del efectivo, que se supone nula:
% la barra de signo contrario iguala la suma de las otras dos. Generar con: bash Code/generar_figura.sh patrones_flujos
\begin{tikzpicture}[font=\footnotesize]
% \bpos{x}{altura}: flujo positivo (gris); \bneg{x}{altura}: flujo negativo (blanco);
% \bdisc{x}{desde}{hasta}: tramo discontinuo, cualquier signo o magnitud compatible con la identidad
\newcommand{\bpos}[2]{\draw[thick, fill=gray!20] (#1,0) rectangle (#1+0.5,#2);}
\newcommand{\bneg}[2]{\draw[thick, fill=white] (#1,0) rectangle (#1+0.5,#2);}
\newcommand{\bdisc}[3]{\draw[thick, dashed, fill=white] (#1,#2) rectangle (#1+0.5,#3);}
\newcommand{\marco}[2]{% #1 abscisa, #2 título: eje y letras E, I, F
  \node[font=\footnotesize\itshape, anchor=south] at (#1+1.05,1.3) {#2};
  \draw[black!50] (#1-0.15,0) -- (#1+2.25,0);
  \node[font=\scriptsize, anchor=north] at (#1+0.25,-1.3) {E};
  \node[font=\scriptsize, anchor=north] at (#1+1.05,-1.3) {I};
  \node[font=\scriptsize, anchor=north] at (#1+1.85,-1.3) {F};}
% (a) Introducción: E y I negativos; F los financia (F = |E| + |I|)
\marco{0}{(a) Introducción}
\bneg{0}{-0.6} \bneg{0.8}{-0.6} \bpos{1.6}{1.2}
% (b) Crecimiento: la inversión absorbe lo que genera la explotación y lo que aporta la financiación
\marco{2.9}{(b) Crecimiento}
\bpos{2.9}{0.6} \bneg{3.7}{-1.2} \bpos{4.5}{0.6}
% (c) Madurez: la explotación cubre la inversión y la devolución a socios y acreedores
\marco{5.8}{(c) Madurez}
\bpos{5.8}{1.2} \bneg{6.6}{-0.6} \bneg{7.4}{-0.6}
% (d) Sacudida: combinaciones restantes
\marco{8.7}{(d) Sacudida}
\bdisc{8.7}{-0.9}{0.9} \bdisc{9.5}{-0.9}{0.9} \bdisc{10.3}{-0.9}{0.9}
\node[font=\scriptsize] at (8.95,0) {$\pm$};
\node[font=\scriptsize] at (9.75,0) {$\pm$};
\node[font=\scriptsize] at (10.55,0) {$\pm$};
% (e) Declive: la desinversión cubre la explotación; F, de cualquier signo, cierra la diferencia
\marco{11.6}{(e) Declive}
\bneg{11.6}{-0.9} \bpos{12.4}{0.6} \bdisc{12.4}{0.6}{1.2} \bdisc{13.2}{-0.3}{0.3}
\node[font=\scriptsize] at (13.45,0) {$\pm$};
\node[font=\scriptsize, text=black!60] at (9.75,-1.75) {combinaciones restantes};
\node[font=\scriptsize, align=center, text width=14cm] at (6.95,-2.35)
  {En todas las fases, $\text{E}+\text{I}+\text{F}=\Delta\,\text{efectivo}$, que aquí se supone nula: la barra de signo contrario iguala la suma de las otras dos.\\
   Tramos discontinuos: cualquier signo o magnitud que respete esa identidad.};
\end{tikzpicture}
