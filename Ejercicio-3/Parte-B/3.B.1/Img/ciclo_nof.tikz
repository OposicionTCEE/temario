% Liquidez: (a) el ciclo de maduración; (b) necesidades operativas de fondos frente al fondo de maniobra (cuerpo, «Liquidez»).
% Figura abstracta, sin cifras. Generar con: bash Code/generar_figura.sh ciclo_nof
\begin{tikzpicture}[font=\footnotesize]
% ---------- (a) Ciclo de maduración ----------
\node[font=\footnotesize\itshape] at (3.5,3.6) {(a) El ciclo de maduración};
\draw[-{Stealth[length=2mm]}, thick] (0,1.6) -- (7.4,1.6) node[below left] {tiempo};
\foreach \x/\e in {0.3/compra, 2.9/pago, 4.4/venta, 6.6/cobro} {
  \fill (\x,1.6) circle (2pt);
  \node[font=\scriptsize, anchor=north] at (\x,1.5) {\e};
}
% periodos sobre la línea
\draw[decorate, decoration={brace, amplitude=4pt}, thick] (0.3,1.8) -- (4.4,1.8) node[midway, above=5pt, font=\scriptsize] {almacén, fabricación y venta};
\draw[decorate, decoration={brace, amplitude=4pt}, thick] (4.45,1.8) -- (6.6,1.8) node[midway, above=5pt, font=\scriptsize] {cobro};
% periodos bajo la línea
\draw[decorate, decoration={brace, amplitude=4pt, mirror}, thick, black!60] (0.3,1.05) -- (2.9,1.05) node[midway, below=5pt, font=\scriptsize\itshape, text=black!60] {pago a proveedores};
\draw[decorate, decoration={brace, amplitude=4pt, mirror}, thick] (2.95,1.05) -- (6.6,1.05) node[midway, below=5pt, font=\scriptsize\itshape, align=center] {ciclo de caja\\(maduración financiera)};
\draw[decorate, decoration={brace, amplitude=4pt, mirror}, thick, black!60] (0.3,0.05) -- (6.6,0.05) node[midway, below=5pt, font=\scriptsize\itshape, text=black!60] {maduración económica};
% ---------- (b) NOF frente a FdM ----------
\begin{scope}[xshift=9.3cm]
\node[font=\footnotesize\itshape] at (2.4,3.6) {(b) Necesidades operativas y fondo de maniobra};
% activo corriente de explotación y pasivo espontáneo
\draw[thick, fill=gray!20] (0,0) rectangle (1.4,3.0);
\node[font=\scriptsize, align=center] at (0.7,1.5) {existencias\\y clientes};
\draw[thick, fill=white, dashed] (1.6,1.9) rectangle (3.0,3.0);
\node[font=\scriptsize, align=center] at (2.3,2.45) {proveedores};
\draw[thick, fill=gray!8] (1.6,0) rectangle (3.0,1.9);
\node[font=\scriptsize] at (2.3,0.95) {NOF};
% fondo de maniobra
\draw[thick, fill=gray!8] (3.6,0) rectangle (5.0,1.4);
\node[font=\scriptsize] at (4.3,0.7) {FdM};
\draw[thick, dashed] (3.6,1.4) rectangle (5.0,1.9);
\node[font=\scriptsize, align=center] at (4.3,1.65) {deuda c/p};
\draw[black!50, thin] (3.0,1.9) -- (3.6,1.9);
\draw[decorate, decoration={brace, amplitude=3pt}, thick, black!60] (5.1,1.9) -- (5.1,1.4) node[midway, right=5pt, font=\scriptsize\itshape, text=black!60, align=left] {NOF $-$ FdM};
\end{scope}
\end{tikzpicture}
