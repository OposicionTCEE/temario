% Beneficio residual de la empresa y de los socios (cuerpo, «Creación de valor»). Figura abstracta, sin cifras.
% Columna izquierda: lo que obtiene el capital invertido, BAII(1-t) = intereses netos + BN.
% Columna derecha: lo que exigen sus financiadores, WACC·CI = k_D(1-t)D + k_E·PN.
% BR - BR_E = (i - k_D)(1-t)D. Generar con: bash Code/generar_figura.sh beneficio_residual
\begin{tikzpicture}[font=\footnotesize]
\newcommand{\seg}[5]{% #1 x, #2 y inicial, #3 y final, #4 relleno, #5 rótulo
  \draw[thick, fill=#4] (#1,#2) rectangle (#1+1.8,#3);
  \node[align=center] at (#1+0.9,{(#2+#3)/2}) {#5};}
\newcommand{\pies}[1]{% #1 abscisa del panel: rótulos de las columnas
  \node[align=center, anchor=north] at (#1+0.9,-0.1) {lo que obtiene\\$\text{BAII}\,(1-t)$};
  \node[align=center, anchor=north] at (#1+3.7,-0.1) {lo que exigen\\$r_\text{WACC}\cdot CI$};
  \draw[black!50] (#1-0.2,0) -- (#1+5.7,0);}

% ---------------- (a) i = k_D ----------------
\node[font=\footnotesize\itshape, anchor=west] at (-0.4,4.1) {(a) La deuda paga lo que exigen los acreedores: $i=k_D$};
\seg{0}{0}{1.0}{gray!40}{intereses netos\\$i\,(1-t)\,D$}
\seg{0}{1.0}{3.4}{gray!10}{resultado neto\\BN}
\seg{2.8}{0}{1.0}{gray!40}{$k_D\,(1-t)\,D$}
\seg{2.8}{1.0}{2.8}{gray!10}{$k_E\cdot\text{PN}$}
\pies{0}
\draw[dashed] (1.8,3.4) -- (4.95,3.4);
\draw[decorate, decoration={brace, amplitude=4pt}] (4.8,3.4) -- (4.8,2.8);
\node[anchor=west] at (5.0,3.1) {$\text{BR}=\text{BR}_E$};

% ---------------- (b) i < k_D ----------------
\node[font=\footnotesize\itshape, anchor=west] at (7.9,4.1) {(b) La deuda paga menos de lo que exigen: $i<k_D$};
\seg{8.3}{0}{0.6}{gray!40}{}
\node[anchor=east] at (8.25,0.3) {$i\,(1-t)\,D$};
\seg{8.3}{0.6}{3.4}{gray!10}{resultado neto\\BN}
\seg{11.1}{0}{1.0}{gray!40}{$k_D\,(1-t)\,D$}
\seg{11.1}{1.0}{2.8}{gray!10}{$k_E\cdot\text{PN}$}
\pies{8.3}
\draw[dashed] (10.1,3.4) -- (13.25,3.4);
\draw[decorate, decoration={brace, amplitude=4pt}] (13.1,3.4) -- (13.1,2.8);
\node[anchor=west] at (13.3,3.1) {BR};
\draw[dashed] (10.1,0.6) -- (11.1,0.6);
\draw[decorate, decoration={brace, amplitude=3pt, mirror}] (10.25,0.6) -- (10.25,1.0);
\node[anchor=west, align=left] at (13.05,1.0) {$\text{BR}_E=\text{BR}$\\$\;+\,(k_D-i)(1-t)\,D$:\\los socios ganan\\lo que pierden\\los acreedores};
\draw[->, black!60] (13.0,0.8) -- (10.4,0.8);

\node[text=black!70, align=center] at (7.4,-1.35) {Gris oscuro: acreedores; gris claro: socios. Ponderaciones del WACC con las magnitudes contables.};
\end{tikzpicture}
