% Beneficio residual de la empresa y de los socios (cuerpo, «Creación de valor»). Figura abstracta, sin cifras.
% Columna izquierda: lo que obtiene el capital invertido, BAII(1-t) = intereses netos + BN.
% Columna derecha: lo que exigen sus financiadores, WACC·CI = k_D(1-t)D + k_E·PN.
% BR - BR_E = (i - k_D)(1-t)D. Generar con: bash Code/generar_figura.sh beneficio_residual
\begin{tikzpicture}[font=\footnotesize]
\newcommand{\seg}[6]{% #1 x, #2 y inicial, #3 y final, #4 relleno, #5 rótulo, #6 tamaño de letra
  \draw[thick, fill=#4] (#1,#2) rectangle (#1+1.7,#3);
  \node[font=#6, align=center] at (#1+0.85,{(#2+#3)/2}) {#5};}
\newcommand{\pies}[1]{% #1 abscisa del panel: rótulos de las columnas
  \node[font=\scriptsize, align=center, anchor=north] at (#1+0.85,-0.1) {lo que obtiene\\$\text{BAII}\,(1-t)$};
  \node[font=\scriptsize, align=center, anchor=north] at (#1+3.55,-0.1) {lo que exigen\\$r_\text{WACC}\cdot CI$};
  \draw[black!50] (#1-0.2,0) -- (#1+5.45,0);}

% ---------------- (a) i = k_D ----------------
\node[font=\footnotesize\itshape, anchor=west] at (-0.4,4.1) {(a) La deuda paga lo que exigen los acreedores};
\seg{0}{0}{1.0}{gray!40}{intereses netos\\$i\,(1-t)\,D$}{\scriptsize}
\seg{0}{1.0}{3.4}{gray!10}{resultado neto\\BN}{\footnotesize}
\seg{2.7}{0}{1.0}{gray!40}{$k_D\,(1-t)\,D$}{\scriptsize}
\seg{2.7}{1.0}{2.8}{gray!10}{$k_E\cdot\text{PN}$}{\footnotesize}
\pies{0}
\draw[dashed] (1.7,3.4) -- (4.75,3.4);
\draw[decorate, decoration={brace, amplitude=4pt}] (4.6,3.4) -- (4.6,2.8);
\node[anchor=west, align=left, font=\scriptsize] at (4.8,3.1) {$\text{BR}=\text{BR}_E$};

% ---------------- (b) i < k_D ----------------
\node[font=\footnotesize\itshape, anchor=west] at (7.6,4.1) {(b) La deuda paga menos de lo que exigen: $i<k_D$};
\seg{8}{0}{0.6}{gray!40}{{\tiny$i\,(1-t)\,D$}}{\scriptsize}
\seg{8}{0.6}{3.4}{gray!10}{resultado neto\\BN}{\footnotesize}
\seg{10.7}{0}{1.0}{gray!40}{$k_D\,(1-t)\,D$}{\scriptsize}
\seg{10.7}{1.0}{2.8}{gray!10}{$k_E\cdot\text{PN}$}{\footnotesize}
\pies{8}
\draw[dashed] (9.7,3.4) -- (12.75,3.4);
\draw[decorate, decoration={brace, amplitude=4pt}] (12.6,3.4) -- (12.6,2.8);
\node[anchor=west, font=\scriptsize] at (12.8,3.1) {BR};
\draw[dashed] (9.7,0.6) -- (10.7,0.6);
\draw[decorate, decoration={brace, amplitude=3pt, mirror}] (9.85,0.6) -- (9.85,1.0);
\node[anchor=west, align=left, font=\scriptsize] at (12.55,0.75) {$\text{BR}_E=\text{BR}+(k_D-i)(1-t)\,D$:\\los socios ganan lo que\\pierden los acreedores};
\draw[->, black!60] (12.5,0.75) -- (10.0,0.8);

\node[font=\scriptsize, text=black!70] at (7.2,-1.25) {Gris oscuro: acreedores; gris claro: socios. Ponderaciones del WACC con las magnitudes contables.};
\end{tikzpicture}
