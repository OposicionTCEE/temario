% Asiento 22 de ALFA en T (cuerpo, «Asiento»). Generar con: bash Code/generar_figura.sh t_asiento
\begin{tikzpicture}[font=\footnotesize]
\newcommand{\cuentaT}[4]{% #1 abscisa, #2 título, #3 debe, #4 haber
  \begin{scope}[xshift=#1cm]
    \node[font=\footnotesize\bfseries, align=center, anchor=south] at (0,0.08) {#2};
    \draw[thick] (-1.9,0) -- (1.9,0);
    \draw[thick] (0,0) -- (0,-1.15);
    \node[font=\scriptsize\itshape, text=black!60] at (-0.95,-0.24) {Debe};
    \node[font=\scriptsize\itshape, text=black!60] at (0.95,-0.24) {Haber};
    \node[align=left, anchor=north west] at (-1.8,-0.42) {#3};
    \node[align=left, anchor=north west] at (0.1,-0.42) {#4};
  \end{scope}}
\cuentaT{0}{(572) Bancos}{}{(22)\enspace $12$}
\cuentaT{4.6}{(520) Deudas a corto plazo\\con entidades de crédito}{(22)\enspace $10$}{(1)\enspace\ $10$}
\cuentaT{9.2}{(662) Intereses de deudas}{(22)\enspace $2$}{}
\node at (0,-1.5) {Activo $\downarrow 12$};
\node at (4.6,-1.5) {Pasivo $\downarrow 10$};
\node at (9.2,-1.5) {Patrimonio neto $\downarrow 2$ (gasto)};
\end{tikzpicture}
