% No compensación: clientes y proveedores de ALFA en el balance (cuerpo, «Principios contables»). Generar con: bash Code/generar_figura.sh t_compensacion
\begin{tikzpicture}[font=\footnotesize]
\newcommand{\cuentaT}[5][2.4]{% [semiancho] abscisa, título, activo, pasivo
  \begin{scope}[xshift=#2cm]
    \node[font=\footnotesize\bfseries, align=center, anchor=south] at (0,0.08) {#3};
    \draw[thick] (-#1,0) -- (#1,0);
    \draw[thick] (0,0) -- (0,-1.15);
    \node[font=\scriptsize\itshape, text=black!60] at (-#1/2,-0.24) {Activo};
    \node[font=\scriptsize\itshape, text=black!60] at (#1/2,-0.24) {Pasivo};
    \node[align=left, anchor=north west] at (-#1+0.1,-0.42) {#4};
    \node[align=left, anchor=north west] at (0.1,-0.42) {#5};
  \end{scope}}
\node[font=\footnotesize\itshape] at (0,1.25) {(a) Partidas separadas};
\node[font=\footnotesize\itshape] at (7,1.25) {(b) Partidas compensadas};
\cuentaT{0}{Balance a $31/12/2026$}{Clientes\enspace $38$}{Proveedores\enspace $25$}
\cuentaT{7}{Balance a $31/12/2026$}{Clientes netos\enspace $13$}{}
\draw[dashed, black!40] (3.5,1.45) -- (3.5,-2.15);
\node at (0,-1.55) {Total activo: $141{,}04$};
\node at (0,-1.95) {Pasivo sobre el total: $46{,}5\,\%$};
\node at (7,-1.55) {Total activo: $116{,}04$};
\node at (7,-1.95) {Pasivo sobre el total: $34{,}9\,\%$};
\end{tikzpicture}
