% Mapa del análisis financiero (cuerpo, apertura de «Análisis financiero»): tres pasos (situación, equilibrio,
% capacidad), cada uno con sus ratios de liquidez (corto plazo) y de solvencia (largo plazo), y la evidencia como síntesis.
% Figura abstracta, sin cifras. Generar con: bash Code/generar_figura.sh mapa_financiero
\begin{tikzpicture}[font=\footnotesize, >=Stealth,
  paso/.style={draw, thick, rounded corners=2pt, fill=gray!20, align=center, text width=3.9cm, minimum height=1.45cm},
  celda/.style={draw, rounded corners=2pt, fill=gray!5, align=center, text width=3.9cm, minimum height=1.35cm},
  fila/.style={align=center, text width=2.0cm, font=\footnotesize\bfseries}]
% cabecera: los tres pasos
\node[paso] (p1) at (3.5,0) {\textbf{1. Situación}\\¿cubre lo que tiene\\lo que debe?\\{\scriptsize\itshape balance}};
\node[paso] (p2) at (8.0,0) {\textbf{2. Equilibrio}\\¿se financia cada inversión\\con recursos de su plazo?\\{\scriptsize\itshape fondo de maniobra y NOF}};
\node[paso] (p3) at (12.5,0) {\textbf{3. Capacidad}\\¿puede pagar\\con lo que genera?\\{\scriptsize\itshape flujos}};
\draw[->, thick] (p1) -- (p2);
\draw[->, thick] (p2) -- (p3);
% filas: los dos horizontes
\node[fila] at (0.4,-1.6) {Liquidez\\{\scriptsize\normalfont corto plazo}};
\node[fila] at (0.4,-3.1) {Solvencia\\{\scriptsize\normalfont largo plazo}};
\node[celda] at (3.5,-1.6) {$\text{AC}/\text{PC}$\\$(\text{AC}-\text{existencias})/\text{PC}$\\$\text{tesorería}/\text{PC}$};
\node[celda] at (8.0,-1.6) {ciclo de maduración\\NOF frente a FdM};
\node[celda] at (12.5,-1.6) {$\text{FE}/\text{PC}$};
\node[celda] at (3.5,-3.1) {endeudamiento\\autonomía financiera\\activo$/$pasivo exigible};
\node[celda] at (8.0,-3.1) {$\text{CBF}=\dfrac{\text{PN}+\text{PNC}}{\text{ANC}+\text{NOF}}$};
\node[celda] at (12.5,-3.1) {$\text{BAII}/\text{intereses}$, cobertura total\\$\text{DFN}/\text{EBITDA}$\\$\text{FE}/\text{deuda}$};
% síntesis
\node[draw, thick, rounded corners=2pt, fill=gray!20, align=center, text width=12.9cm, minimum height=0.8cm] (ev) at (8.0,-4.65)
  {\textbf{Juntas:} la predicción del fracaso (BEAVER, 1966; ALTMAN, 1968)};
\draw[->, thick] (12.5,-3.8) -- (12.5,-4.25);
\draw[->, thick] (8.0,-3.8) -- (8.0,-4.25);
\draw[->, thick] (3.5,-3.8) -- (3.5,-4.25);
\end{tikzpicture}
