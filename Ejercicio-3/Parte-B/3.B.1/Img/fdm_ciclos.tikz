% Circulación financiera: (a) las dos lecturas del fondo de maniobra; (b) los ciclos del efectivo y las tres actividades
% (cuerpo, «Circulación financiera»). Figura abstracta, sin cifras. Generar con: bash Code/generar_figura.sh fdm_ciclos
\begin{tikzpicture}[font=\footnotesize]
% ---------- (a) Las dos lecturas del fondo de maniobra ----------
\node[font=\footnotesize\itshape] at (2.35,4.45) {(a) Las dos lecturas del fondo de maniobra};
\draw[thick, fill=gray!8] (0,4) rectangle (2.2,2.8);   \node at (1.1,3.4) {ANC};
\draw[thick, fill=gray!20] (0,2.8) rectangle (2.2,0);  \node at (1.1,2.0) {AC};
\draw[thick, fill=gray!8] (2.5,4) rectangle (4.7,2.1); \node at (3.6,3.05) {PN};
\draw[thick, fill=gray!8] (2.5,2.1) rectangle (4.7,1.3); \node at (3.6,1.7) {PNC};
\draw[thick, fill=gray!20] (2.5,1.3) rectangle (4.7,0); \node at (3.6,0.65) {PC};
\draw[dashed, thick] (-0.15,2.8) -- (4.85,2.8);
\draw[dashed, thick] (-0.15,1.3) -- (4.85,1.3);
\draw[decorate, decoration={brace, amplitude=5pt}, thick] (4.95,2.8) -- (4.95,1.3) node[midway, right=7pt] {FdM};
\draw[decorate, decoration={brace, amplitude=4pt, mirror}, thick, black!60] (-0.25,2.8) -- (-0.25,0)
  node[midway, left=6pt, font=\scriptsize\itshape, text=black!60, align=right] {corto plazo:\\AC $-$ PC};
\draw[decorate, decoration={brace, amplitude=4pt}, thick, black!60] (2.4,4.25) -- (4.8,4.25);
\node[font=\scriptsize\itshape, text=black!60, align=center] at (6.35,3.85) {largo plazo:\\(PN $+$ PNC) $-$ ANC};
% ---------- (b) Los ciclos del efectivo ----------
\begin{scope}[xshift=10.6cm, yshift=2cm,
  caja/.style={draw, rounded corners=2pt, fill=gray!8, minimum width=2.0cm, minimum height=0.65cm, align=center},
  flecha/.style={-{Stealth[length=2mm]}, thick}]
\node[font=\footnotesize\itshape] at (0.6,2.45) {(b) Los ciclos del efectivo};
\node[caja, fill=gray!20] (t) at (0,0) {Tesorería};
\node[caja] (e) at (2.4,1.25) {Existencias};
\node[caja] (c) at (2.4,-1.25) {Clientes};
\node[caja] (i) at (-2.4,1.25) {Inmovilizado};
\node[caja] (f) at (-2.4,-1.25) {Socios y\\acreedores};
\node[caja, fill=white, dashed] (p) at (4.6,1.25) {Proveedores};
% ciclo de explotación
\draw[flecha] (t) -- node[above left, font=\scriptsize] {compra} (e);
\draw[flecha] (e) -- node[right, font=\scriptsize] {venta} (c);
\draw[flecha] (c) -- node[below left, font=\scriptsize] {cobro} (t);
\draw[flecha, dashed] (p) -- node[above, font=\scriptsize] {aplazan} (e);
\node[font=\scriptsize\itshape, text=black!60] at (1.65,0) {explotación};
% ciclo de inversión
\draw[flecha] (t) -- node[above right, font=\scriptsize] {inversión} (i);
\draw[flecha, dashed] (i.north east) to[bend left=28] node[above, font=\scriptsize] {se recupera con las ventas} (e.north west);
% financiación
\draw[flecha] ([yshift=2pt]f.east) -- node[above, sloped, font=\scriptsize] {entra} ([xshift=-4pt]t.south west);
\draw[flecha] ([xshift=4pt]t.south west) -- node[below, sloped, font=\scriptsize] {sale} ([yshift=-6pt]f.east);
\node[font=\scriptsize\itshape, text=black!60] at (-2.4,-2.05) {financiación};
\node[font=\scriptsize\itshape, text=black!60] at (-2.4,2.05) {inversión};
\end{scope}
\end{tikzpicture}
