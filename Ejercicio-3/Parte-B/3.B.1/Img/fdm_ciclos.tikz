% Circulación financiera: (a) las dos lecturas del fondo de maniobra; (b) los ciclos del efectivo y las tres actividades
% (cuerpo, «Circulación financiera»). Figura abstracta, sin cifras. Generar con: bash Code/generar_figura.sh fdm_ciclos
\begin{tikzpicture}[font=\footnotesize]
% ---------- (a) Las dos lecturas del fondo de maniobra ----------
\node[font=\footnotesize\itshape] at (2.35,5.25) {(a) Las dos lecturas del fondo de maniobra};
\draw[thick, fill=gray!8] (0,4) rectangle (2.2,2.8);   \node at (1.1,3.4) {ANC};
\draw[thick, fill=gray!20] (0,2.8) rectangle (2.2,0);  \node at (1.1,2.0) {AC};
\draw[thick, fill=gray!8] (2.5,4) rectangle (4.7,2.1); \node at (3.6,3.05) {PN};
\draw[thick, fill=gray!8] (2.5,2.1) rectangle (4.7,1.3); \node at (3.6,1.7) {PNC};
\draw[thick, fill=gray!20] (2.5,1.3) rectangle (4.7,0); \node at (3.6,0.65) {PC};
\draw[dashed, thick] (-0.15,2.8) -- (4.85,2.8);
\draw[dashed, thick] (-0.15,1.3) -- (4.85,1.3);
\draw[decorate, decoration={brace, amplitude=5pt}, thick] (4.95,2.8) -- (4.95,1.3) node[midway, right=7pt] {FdM};
\node[font=\scriptsize, anchor=west] at (-0.1,-0.4) {\textit{corto plazo:} FdM $=$ AC $-$ PC};
\node[font=\scriptsize, anchor=west] at (-0.1,-0.8) {\textit{largo plazo:} FdM $=$ (PN $+$ PNC) $-$ ANC};
% ---------- (b) Los ciclos del efectivo ----------
\begin{scope}[xshift=10.4cm, yshift=2cm,
  caja/.style={draw, rounded corners=2pt, fill=gray!8, minimum width=2.0cm, minimum height=0.65cm, align=center},
  flecha/.style={-{Stealth[length=2mm]}, thick},
  rotulo/.style={font=\scriptsize\itshape, text=black!60}]
\node[font=\footnotesize\itshape] at (0.6,3.15) {(b) Los ciclos del efectivo};
\node[caja, fill=gray!20] (t) at (0,0) {Tesorería};
\node[caja] (e) at (2.8,1.4) {Existencias};
\node[caja] (c) at (2.8,-1.4) {Clientes};
\node[caja] (i) at (-2.8,1.4) {Inmovilizado};
\node[caja] (f) at (-2.8,-1.4) {Socios y\\acreedores};
\node[caja, fill=white, dashed] (p) at (5.8,1.4) {Proveedores};
% ciclo de explotación
\draw[flecha] (t.north east) -- node[above left, font=\scriptsize] {compra} (e.south west);
\draw[flecha] (e) -- node[right, font=\scriptsize] {venta} (c);
\draw[flecha] (c.north west) -- node[below left, font=\scriptsize] {cobro} (t.south east);
\draw[flecha, dashed] (p) -- node[above=2pt, font=\scriptsize] {crédito} (e);
\node[rotulo] at (2.05,0) {explotación};
% ciclo de inversión
\draw[flecha] (t.north west) -- node[above right, font=\scriptsize] {pago} (i.south east);
\draw[flecha, dashed] (i.north) to[out=50, in=130] node[above, font=\scriptsize] {se recupera con las ventas} (e.north);
\node[rotulo, anchor=east] at (-3.85,1.4) {inversión};
% financiación
\draw[flecha] (f.north) to[out=70, in=180] node[above left, font=\scriptsize] {entra} (t.west);
\draw[flecha] (t.south) to[out=-90, in=0] node[below right, font=\scriptsize] {sale} (f.east);
\node[rotulo, anchor=east] at (-3.85,-1.4) {financiación};
\end{scope}
\end{tikzpicture}
