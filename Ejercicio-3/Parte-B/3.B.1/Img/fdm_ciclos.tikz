% Circulación financiera: (a) las dos lecturas del fondo de maniobra; (b) los ciclos del efectivo y las tres actividades
% (cuerpo, «Circulación financiera»). Figura abstracta, sin cifras. Generar con: bash Code/generar_figura.sh fdm_ciclos
% En (a), la franja sombreada es el fondo de maniobra en las dos columnas: la parte del AC que excede al PC
% (lectura de corto plazo) es la parte de los recursos permanentes que excede al ANC (lectura de largo plazo).
\begin{tikzpicture}[font=\footnotesize]
% ---------- (a) Las dos lecturas del fondo de maniobra ----------
\node[font=\footnotesize\itshape] at (1.95,5.25) {(a) Las dos lecturas del fondo de maniobra};
% activo
\draw[thick, fill=gray!8] (0,4) rectangle (1.8,2.8);   \node at (0.9,3.4) {ANC};
\fill[gray!20] (0,1.3) rectangle (1.8,0);
\fill[gray!40] (0,2.8) rectangle (1.8,1.3);
\draw[thick] (0,2.8) rectangle (1.8,0);                 \node at (0.9,2.05) {AC};
% patrimonio neto y pasivo
\draw[thick, fill=gray!8] (2.1,4) rectangle (3.9,2.1);
\fill[gray!40] (2.1,2.8) rectangle (3.9,2.1);
\draw[thick] (2.1,4) rectangle (3.9,2.1);               \node at (3.0,3.4) {PN};
\draw[thick, fill=gray!40] (2.1,2.1) rectangle (3.9,1.3); \node at (3.0,1.7) {PNC};
\draw[thick, fill=gray!20] (2.1,1.3) rectangle (3.9,0); \node at (3.0,0.65) {PC};
\draw[dashed, thick] (-0.15,2.8) -- (4.05,2.8);
\draw[dashed, thick] (-0.15,1.3) -- (4.05,1.3);
% una llave a cada lado: la misma franja leída desde el activo y desde la financiación
\draw[decorate, decoration={brace, amplitude=5pt}, thick] (-0.2,1.3) -- (-0.2,2.8) node[midway, left=7pt] {FdM};
\draw[decorate, decoration={brace, amplitude=5pt}, thick] (4.1,2.8) -- (4.1,1.3) node[midway, right=7pt] {FdM};
\node[font=\scriptsize, anchor=west] at (-1.1,-0.4) {\textit{corto plazo} (izquierda): FdM $=$ AC $-$ PC};
\node[font=\scriptsize, anchor=west] at (-1.1,-0.8) {\textit{largo plazo} (derecha): FdM $=$ (PN $+$ PNC) $-$ ANC};
% ---------- (b) Los ciclos del efectivo ----------
\begin{scope}[xshift=9.6cm, yshift=2cm,
  caja/.style={draw, rounded corners=2pt, fill=gray!8, minimum width=2.0cm, minimum height=0.65cm, align=center},
  flecha/.style={-{Stealth[length=2mm]}, thick},
  rotulo/.style={font=\scriptsize\itshape, text=black!60}]
\node[font=\footnotesize\itshape] at (1.5,3.25) {(b) Los ciclos del efectivo};
\node[caja, fill=gray!20] (t) at (0,0) {Tesorería};
\node[caja] (e) at (2.8,1.4) {Existencias};
\node[caja] (c) at (2.8,-1.4) {Clientes};
\node[caja] (i) at (-2.8,1.4) {Inmovilizado};
\node[caja] (f) at (-2.8,-1.4) {Socios y\\acreedores};
\node[caja, fill=white, dashed] (p) at (5.8,1.4) {Proveedores};
% ciclo de explotación
\draw[flecha] (t.north east) -- node[above left, font=\scriptsize] {compra} (e.south west);
\draw[flecha] (e) -- node[right, font=\scriptsize] {venta} (c);
\draw[flecha] (c.north west) -- node[below left, font=\scriptsize] {cobro} (t.south east);
\draw[flecha, dashed] (p) -- node[above=2pt, font=\scriptsize] {crédito} (e);
\node[rotulo] at (2.05,0) {explotación};
% ciclo de inversión
\draw[flecha] (t.north west) -- node[above right, font=\scriptsize] {pago} (i.south east);
\draw[flecha, dashed] (i.north) to[out=35, in=145] node[below, font=\scriptsize] {se recupera con las ventas} (e.north);
\node[rotulo] at (-2.8,0.8) {inversión};
% financiación
\draw[flecha] (f.north) to[out=70, in=180] node[above left, font=\scriptsize] {entra} (t.west);
\draw[flecha] (t.south) to[out=-90, in=0] node[below right, font=\scriptsize] {sale} (f.east);
\node[rotulo] at (-2.8,-2.25) {financiación};
\end{scope}
\end{tikzpicture}
