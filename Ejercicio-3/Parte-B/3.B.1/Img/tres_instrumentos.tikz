% Los tres instrumentos del análisis: vertical, horizontal y ratios (cuerpo, introducción del bloque «Instrumentos»).
% Figura abstracta, sin cifras. Generar con: bash Code/generar_figura.sh tres_instrumentos
\begin{tikzpicture}[font=\footnotesize,
  flecha/.style={-{Stealth[length=2mm]}, thick},
  rotulo/.style={font=\scriptsize\itshape, text=black!60}]
% ---------- (a) Análisis vertical ----------
\node[font=\footnotesize\itshape] at (1.0,4.0) {(a) Vertical: estructura};
\draw[thick, fill=gray!8]  (0.3,3.4) rectangle (1.7,2.4); \node at (1.0,2.9) {$a\,\%$};
\draw[thick, fill=gray!20] (0.3,2.4) rectangle (1.7,1.0); \node at (1.0,1.7) {$b\,\%$};
\draw[thick, fill=gray!8]  (0.3,1.0) rectangle (1.7,0.0); \node at (1.0,0.5) {$c\,\%$};
\draw[decorate, decoration={brace, amplitude=4pt}, thick, black!60] (1.85,3.4) -- (1.85,0) node[midway, right=6pt, rotulo] {$100\,\%$};
\node[rotulo, align=center] at (1.0,-0.45) {un estado, una fecha};
% ---------- (b) Análisis horizontal ----------
\begin{scope}[xshift=4.4cm]
\node[font=\footnotesize\itshape] at (1.35,4.0) {(b) Horizontal: evolución};
\draw[thick, fill=gray!8]  (0,2.8) rectangle (1.0,2.0);
\draw[thick, fill=gray!20] (0,2.0) rectangle (1.0,0.8);
\draw[thick, fill=gray!8]  (0,0.8) rectangle (1.0,0.0);
\draw[thick, fill=gray!8]  (1.7,3.4) rectangle (2.7,2.5);
\draw[thick, fill=gray!20] (1.7,2.5) rectangle (2.7,1.0);
\draw[thick, fill=gray!8]  (1.7,1.0) rectangle (2.7,0.0);
\draw[flecha, black!60] (1.05,2.4) -- (1.65,2.95);
\draw[flecha, black!60] (1.05,1.4) -- (1.65,1.75);
\draw[flecha, black!60] (1.05,0.4) -- (1.65,0.5);
\node[font=\scriptsize] at (0.5,-0.2) {$t-1$};
\node[font=\scriptsize] at (2.2,-0.2) {$t$};
\node[rotulo, align=center] at (1.35,-0.6) {la misma partida, dos fechas};
\end{scope}
% ---------- (c) Ratios ----------
\begin{scope}[xshift=9.2cm]
\node[font=\footnotesize\itshape] at (1.6,4.0) {(c) Ratio: relación};
% cuenta de resultados (flujo)
\draw[thick, fill=gray!8] (0,3.4) rectangle (1.1,1.6);
\draw[thick, fill=gray!20] (0,1.6) rectangle (1.1,1.0);
\node[font=\scriptsize, align=center] at (0.55,2.5) {gastos};
\node[font=\scriptsize] at (0.55,1.3) {resultado};
\node[rotulo, align=center] at (0.55,0.45) {PyG:\\flujo del año};
% balance (stock)
\draw[thick, fill=gray!20] (2.1,3.4) rectangle (3.2,0.0);
\node[font=\scriptsize, align=center] at (2.65,1.7) {activo};
\node[rotulo, align=center] at (2.65,-0.45) {balance:\\\textit{stock} medio};
\draw[flecha] (1.15,1.3) to[out=0, in=180] (2.05,1.3);
\node[font=\scriptsize, fill=white, inner sep=1pt] at (1.6,2.55) {$\dfrac{\text{resultado}}{\text{activo medio}}$};
\end{scope}
\end{tikzpicture}
