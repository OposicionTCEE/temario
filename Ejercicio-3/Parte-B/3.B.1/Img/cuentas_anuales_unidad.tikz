% Las cinco cuentas anuales como unidad: dos estados de situación y, entre ellos, los de circulación (cuerpo, «Cuentas anuales»).
% Adaptación de encadenamiento_documentos (anexo). Generar con: bash Code/generar_figura.sh cuentas_anuales_unidad
\begin{tikzpicture}[
  font=\footnotesize,
  saldo/.style={draw, fill=gray!8, text width=2.6cm, align=center, minimum height=0.8cm, inner sep=2pt},
  doc/.style={draw, rounded corners=2pt, text width=5.0cm, align=center, minimum height=0.95cm, inner sep=3pt},
  flecha/.style={-{Stealth[length=2mm]}, thick},
  rotulo/.style={font=\footnotesize\itshape, text=black!65}
]
% estados de circulación
\node[doc] (pyg)  at (5.3,0)    {\textbf{Cuenta de pérdidas y ganancias}\\ ingresos $-$ gastos};
\node[doc] (ecpn) at (5.3,-1.45) {\textbf{Estado de cambios en el patrimonio neto}\\ resultado, otros ingresos y gastos y socios};
\node[doc] (efe)  at (5.3,-2.9) {\textbf{Estado de flujos de efectivo}\\ explotación $+$ inversión $+$ financiación};
% balances: estados de situación
\node[saldo] (r0) at (0,0)     {gastos e ingresos a cero};
\node[saldo] (p0) at (0,-1.45) {patrimonio neto};
\node[saldo] (e0) at (0,-2.9)  {efectivo};
\node[saldo] (r1) at (10.6,0)     {resultado};
\node[saldo] (p1) at (10.6,-1.45) {patrimonio neto};
\node[saldo] (e1) at (10.6,-2.9)  {efectivo};
\node[draw, thick, rounded corners=3pt, fit=(p0)(e0), inner sep=5pt, label={[font=\footnotesize, align=center]below:\textbf{Balance inicial}\\\textit{estado de situación}}] (b0) {};
\node[draw, thick, rounded corners=3pt, fit=(r1)(p1)(e1), inner sep=5pt, label={[font=\footnotesize, align=center]below:\textbf{Balance final}\\\textit{estado de situación}}] (b1) {};
\foreach \a/\d/\b in {r0/pyg/r1, p0/ecpn/p1, e0/efe/e1} {
  \draw[flecha] (\a) -- (\d);
  \draw[flecha] (\d) -- (\b);
}
\draw[flecha, dashed] (r1.south) -- (p1.north);
% rótulos de la clasificación
\node[rotulo] at (5.3,0.85)  {estados de circulación};
\node[rotulo] at (9.05,0.25) {económica};
\node[rotulo] at (9.05,-2.65) {financiera};
% memoria
\node[doc, text width=12.6cm, minimum height=0.75cm] (mem) at (5.3,-5.05) {\textbf{Memoria}: completa, amplía y comenta los cuatro estados};
\foreach \n in {b0, b1} \draw[dashed, black!50] (\n.south |- 0,-4.45) -- (\n.south |- mem.north);
\draw[dashed, black!50] (efe.south) -- (efe.south |- mem.north);
\end{tikzpicture}
