% Cómo se encadenan los documentos de las cuentas anuales entre dos balances (Anexo II, «Contenido»).
% Generar con: bash Code/generar_figura.sh encadenamiento_documentos
\begin{tikzpicture}[
  font=\footnotesize,
  saldo/.style={draw, fill=gray!8, text width=3.0cm, align=center, minimum height=1.0cm, inner sep=3pt},
  doc/.style={draw, rounded corners=2pt, text width=5.4cm, align=center, minimum height=1.0cm, inner sep=3pt},
  flecha/.style={-{Stealth[length=2.2mm]}, thick}
]
% filas
\node[saldo] (r0) at (0,0)    {cuentas de gastos e ingresos a cero};
\node[saldo] (p0) at (0,-1.6) {patrimonio neto inicial};
\node[saldo] (e0) at (0,-3.2) {efectivo inicial};
\node[doc]   (pyg) at (5.6,0)    {\textbf{Cuenta de pérdidas y ganancias}\\ ingresos $-$ gastos del ejercicio};
\node[doc]   (ecpn) at (5.6,-1.6) {\textbf{Estado de cambios en el patrimonio neto}\\ resultado, ingresos y gastos imputados al patrimonio neto y operaciones con los socios};
\node[doc]   (efe) at (5.6,-3.2) {\textbf{Estado de flujos de efectivo}\\ explotación $+$ inversión $+$ financiación};
\node[saldo] (r1) at (11.2,0)    {resultado del ejercicio};
\node[saldo] (p1) at (11.2,-1.6) {patrimonio neto final};
\node[saldo] (e1) at (11.2,-3.2) {efectivo final};
\foreach \a/\d/\b in {r0/pyg/r1, p0/ecpn/p1, e0/efe/e1} {
  \draw[flecha] (\a) -- (\d);
  \draw[flecha] (\d) -- (\b);
}
\draw[flecha, dashed] (r1.south) -- (p1.north);
% marcos de los dos balances
\node[draw, dashed, rounded corners=3pt, fit=(r0)(p0)(e0), inner sep=6pt, label={[font=\footnotesize\bfseries]above:balance inicial}] {};
\node[draw, dashed, rounded corners=3pt, fit=(r1)(p1)(e1), inner sep=6pt, label={[font=\footnotesize\bfseries]above:balance final}] {};
% memoria
\node[doc, text width=14cm, minimum height=0.8cm] (mem) at (5.6,-4.75) {\textbf{Memoria}: criterios aplicados, detalle de las partidas y lo que las cifras no recogen};
\end{tikzpicture}
