% Fondo de maniobra de ALFA: (a) nivel en el balance a 31/12/2026; (b) variación en 2026 por orígenes y aplicaciones
% (cuerpo, «Estado de circulación»). Alturas proporcionales. Generar con: bash Code/generar_figura.sh fdm_alfa
\begin{tikzpicture}[font=\footnotesize]
% ---------- (a) Nivel: 141,04 = 4 cm ----------
\def\f{0.028361}
\node[font=\footnotesize\itshape] at (2.65,4.75) {(a) Nivel a $31/12/2026$};
\draw[thick, fill=gray!8] (0,4) rectangle (2.5,{4-40.8*\f});
\node at (1.25,{4-40.8*\f/2}) {ANC $40{,}8$};
\draw[thick, fill=gray!20] (0,{4-40.8*\f}) rectangle (2.5,0);
\node at (1.25,{(4-40.8*\f)/2+0.5}) {AC $100{,}24$};
\draw[thick, fill=gray!8] (2.8,4) rectangle (5.3,{4-75.5*\f});
\node at (4.05,{4-75.5*\f/2}) {PN $75{,}5$};
\draw[thick, fill=gray!8] (2.8,{4-75.5*\f}) rectangle (5.3,{4-95.5*\f});
\node at (4.05,{4-85.5*\f}) {PNC $20$};
\draw[thick, fill=gray!20] (2.8,{4-95.5*\f}) rectangle (5.3,0);
\node at (4.05,{(4-95.5*\f)/2}) {PC $45{,}54$};
% franja del fondo de maniobra: entre el techo del PC y el techo del AC
\draw[dashed, thick] (-0.15,{4-40.8*\f}) -- (5.45,{4-40.8*\f});
\draw[dashed, thick] (-0.15,{4-95.5*\f}) -- (5.45,{4-95.5*\f});
\draw[decorate, decoration={brace, amplitude=5pt}, thick] (5.55,{4-40.8*\f}) -- (5.55,{4-95.5*\f})
  node[midway, right=7pt, align=left] {FdM\\$54{,}7$};
% ---------- (b) Variación: cascada, 1 mil euros = 0,04 cm ----------
\begin{scope}[xshift=8cm]
\def\g{0.04}
\node[font=\footnotesize\itshape] at (3.7,4.75) {(b) Variación en 2026};
\draw[black!50] (-0.3,0) -- (7.7,0);
% barras: nombre, base, tope (en miles de euros)
\foreach \i/\b/\t/\v/\r in {0/0/64.5/{64{,}5}/20, 1/64.5/82.7/{+18{,}2}/8, 2/82.7/84.7/{+2}/8, 3/74.7/84.7/{-10}/2, 4/64.7/74.7/{-10}/2, 5/54.7/64.7/{-10}/2, 6/0/54.7/{54{,}7}/20} {
  \pgfmathsetmacro{\x}{\i*1.1}
  \ifnum\r=2
    \draw[thick, dashed, fill=white] (\x,\b*\g) rectangle (\x+0.75,\t*\g);
  \else
    \draw[thick, fill=gray!\r] (\x,\b*\g) rectangle (\x+0.75,\t*\g);
  \fi
  \node[font=\scriptsize, anchor=south] at (\x+0.375,\t*\g) {$\v$};
}
% conectores entre barras
\foreach \i/\y in {0/64.5, 1/82.7, 2/84.7, 3/74.7, 4/64.7, 5/54.7} {
  \pgfmathsetmacro{\x}{\i*1.1+0.75}
  \draw[black!40, thin] (\x,\y*\g) -- (\x+0.35,\y*\g);
}
\foreach \i/\e in {0/{FdM\\2025}, 1/{Recursos\\generados}, 2/{Venta de\\inmovilizado}, 3/{Inversión}, 4/{Dividendos}, 5/{Deuda que\\pasa a corto}, 6/{FdM\\2026}} {
  \node[font=\scriptsize, align=center, anchor=north] at ({\i*1.1+0.375},-0.08) {\e};
}
\node[font=\scriptsize\itshape, text=black!60] at (1.65,-1.05) {orígenes};
\node[font=\scriptsize\itshape, text=black!60] at (4.95,-1.05) {aplicaciones};
\end{scope}
\end{tikzpicture}
