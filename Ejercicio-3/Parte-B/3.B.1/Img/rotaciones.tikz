% Rotaciones: qué miden, cómo se elige el par flujo-saldo y cómo se descompone la rotación del activo
% (cuerpo, «Rentabilidad económica», \paragraph{Rotaciones}). Figura abstracta, sin cifras.
% Generar con: bash Code/generar_figura.sh rotaciones
\begin{tikzpicture}[font=\footnotesize, >=Stealth,
  caja/.style={draw, thick, rounded corners=2pt, align=center, minimum width=2.9cm, minimum height=1cm, fill=white},
  par/.style={font=\footnotesize\bfseries, align=center},
  nota/.style={font=\scriptsize, align=center, text=black!70}]

% ---------------- (a) La partida como depósito ----------------
\node[font=\footnotesize\itshape, anchor=west] at (-0.3,3.55) {(a) Qué mide: la partida como depósito};
% depósito de rotación alta (saldo bajo)
\fill[gray!25] (0.5,0) rectangle (2.0,0.55);
\draw[very thick] (0.5,2.3) -- (0.5,0) -- (2.0,0) -- (2.0,2.3);
\node[font=\scriptsize] at (1.25,0.27) {saldo};
\draw[->, line width=2.2pt, black!60] (1.25,3.15) -- (1.25,2.4);
\draw[->, line width=2.2pt, black!60] (2.0,0.27) -- (2.9,0.27);
\node[font=\scriptsize, anchor=west] at (1.35,2.85) {flujo};
\node[font=\scriptsize, anchor=south] at (2.45,0.38) {flujo};
\node[nota, text=black, anchor=north] at (1.25,-0.1) {rotación alta:\\poco tiempo, poco saldo};
% depósito de rotación baja (saldo alto)
\fill[gray!25] (4.0,0) rectangle (5.5,1.85);
\draw[very thick] (4.0,2.3) -- (4.0,0) -- (5.5,0) -- (5.5,2.3);
\node[font=\scriptsize] at (4.75,0.92) {saldo};
\draw[->, line width=2.2pt, black!60] (4.75,3.15) -- (4.75,2.4);
\draw[->, line width=2.2pt, black!60] (5.5,0.27) -- (6.4,0.27);
\node[font=\scriptsize, anchor=west] at (4.85,2.85) {flujo};
\node[font=\scriptsize, anchor=south] at (5.95,0.38) {flujo};
\node[nota, text=black, anchor=north] at (4.75,-0.1) {rotación baja:\\mucho tiempo, mucho saldo};
\node[align=center] at (3.1,-1.55)
  {$\text{Saldo medio}=\text{Flujo}\times\text{Tiempo de permanencia}$\\[2pt]
   $\text{Rotación}=\dfrac{\text{Flujo}}{\text{Saldo medio}}=\dfrac{1}{\text{Tiempo de permanencia}}$};

% ---------------- (b) Dónde está la diferencia ----------------
\node[font=\footnotesize\itshape, anchor=west] at (8.0,3.55) {(b) Dónde está la diferencia: activo por euro vendido};
\newcommand{\tramo}[5]{% #1 x inicial, #2 x final, #3 y, #4 relleno, #5 rótulo
  \draw[thick, fill=#4] (#1,#3) rectangle (#2,#3+0.6);
  \node[font=\scriptsize] at ({(#1+#2)/2},#3+0.3) {#5};}
\node[anchor=east] at (8.95,2.3) {X};
\tramo{9.0}{10.6}{2.0}{gray!45}{ANC}
\tramo{10.6}{11.9}{2.0}{gray!30}{Exist.}
\tramo{11.9}{12.8}{2.0}{gray!15}{Clientes}
\tramo{12.8}{13.6}{2.0}{white}{Tes.}
\node[anchor=east] at (8.95,1.0) {Y};
\tramo{9.0}{10.6}{0.7}{gray!45}{ANC}
\tramo{10.6}{11.9}{0.7}{gray!30}{Exist.}
\tramo{11.9}{14.0}{0.7}{gray!15}{Clientes}
\tramo{14.0}{14.8}{0.7}{white}{Tes.}
\draw[decorate, decoration={brace, amplitude=4pt, mirror}] (11.9,0.6) -- (14.0,0.6);
\node[font=\scriptsize, anchor=north] at (12.95,0.45) {$\neq$ clientes $\Rightarrow$ B cobra más tarde};
\node[align=center] at (11.9,-1.3)
  {$\dfrac{\text{Activo medio}}{\text{Ventas}}=\sum_i\dfrac{\text{Partida}_i}{\text{Ventas}}$\\[2pt]
   {\scriptsize todas sobre las ventas: suman, pero pierden su significado de plazo}};

% ---------------- (c) Cómo se elige el par ----------------
\node[font=\footnotesize\itshape, anchor=west] at (-0.3,-2.75) {(c) Cómo se elige el par: el flujo que atraviesa la partida, con la misma valoración que el saldo};
\node[caja] (exi) at (3.1,-3.95) {Existencias\\{\scriptsize a coste}};
\node[caja] (cli) at (8.5,-3.95) {Clientes\\{\scriptsize a precio de venta, con IVA}};
\node[caja] (tes) at (13.4,-3.95) {Tesorería};
\node[caja] (pro) at (3.1,-6.15) {Proveedores\\{\scriptsize con IVA}};
\node (com) at (0.2,-5.05) {Compras};
% flujos
\draw[->, thick] (com.north) |- (exi.west);
\draw[->, thick] (com.south) |- (pro.west);
\draw[->, thick] (exi.east) -- node[above, font=\scriptsize] {coste de las ventas} node[below, font=\scriptsize] {$+$ margen $+$ IVA} (cli.west);
\draw[->, thick] (cli.east) -- node[above, font=\scriptsize] {cobros} (tes.west);
\draw[->, thick] (tes.south) |- node[pos=0.75, above, font=\scriptsize] {pagos} (pro.east);
% pares
\node[par] at (3.1,-4.8) {par: coste de las ventas};
\node[nota] at (3.6,-5.2) {$\neq$ ventas: incluyen el margen $\Rightarrow$ rotación sobrestimada};
\node[par] at (8.5,-4.8) {par: ventas con IVA};
\node[par] at (3.1,-7.0) {par: compras con IVA};
\end{tikzpicture}
