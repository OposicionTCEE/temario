% Situaciones patrimoniales en cuatro paneles (cuerpo, «Balance General»). Alturas ilustrativas.
% Generar con: bash Code/generar_figura.sh situaciones_patrimoniales
\begin{tikzpicture}[font=\footnotesize]
% \panel{x}{título}{condición}{bloques del activo}{bloques de la financiación}
% cada bloque: {altura/etiqueta/relleno}, apilados de arriba abajo desde y = 3
\newcommand{\columna}[2]{% #1 abscisa izquierda, #2 lista de bloques
  \def\y{3}
  \foreach \h/\e/\r in {#2} {
    \pgfmathsetmacro{\yb}{\y-\h}
    \ifnum\r=2
      \draw[thick, dashed, fill=white] (#1,\y) rectangle (#1+1.25,\yb);
    \else
      \draw[thick, fill=gray!\r] (#1,\y) rectangle (#1+1.25,\yb);
    \fi
    \node at (#1+0.625,{(\y+\yb)/2}) {\e};
    \global\let\y\yb
  }}
\newcommand{\panel}[5]{%
  \node[font=\footnotesize\itshape, align=center, anchor=south] at (#1+1.3,3.15) {#2};
  \columna{#1}{#4}
  \columna{#1+1.35}{#5}
  \node at (#1+1.3,-0.35) {#3};}
\panel{0}{(a) Estabilidad\\total}{Pasivo $=0$}{1.2/ANC/8, 1.8/AC/20}{3/PN/8}
\panel{3.4}{(b) Equilibrio\\normal}{AC $>$ PC}{1.2/ANC/8, 1.8/AC/20}{1.4/PN/8, 0.6/PNC/8, 1.0/PC/20}
\panel{6.8}{(c) Desequilibrio\\a corto plazo}{AC $<$ PC}{1.8/ANC/8, 1.2/AC/20}{0.9/PN/8, 0.5/PNC/8, 1.6/PC/20}
\panel{10.2}{(d) Quiebra\\técnica}{PN $<0$}{1.6/ANC/8, 1.0/AC/20, 0.4/PN/2}{1.2/PNC/8, 1.8/PC/20}
\end{tikzpicture}
