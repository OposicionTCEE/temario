% Riesgo económico: (a) punto muerto; (b) apalancamiento operativo según la estructura de costes (cuerpo, «Riesgo económico»).
% Figura abstracta, sin cifras. Generar con: bash Code/generar_figura.sh riesgo_economico
\begin{tikzpicture}[font=\footnotesize]
% ---------- (a) Punto muerto ----------
\node[font=\footnotesize\itshape] at (3.4,5.6) {(a) El punto muerto};
\draw[-{Stealth[length=2mm]}, thick] (0,0) -- (6.0,0) node[below left] {ventas};
\draw[-{Stealth[length=2mm]}, thick] (0,0) -- (0,4.9) node[above] {ingresos y costes};
\draw[thick] (0,0) -- (5.6,4.48) node[right, font=\scriptsize] {ingresos};
\draw[thick, dashed] (0,1.5) -- (5.6,3.62) node[right, font=\scriptsize] {costes totales};
\draw[thick, dotted] (0,1.5) -- (5.6,1.5) node[right, font=\scriptsize] {costes fijos};
% punto muerto: 0.8 q = 1.5 + 0.3786 q  =>  q* = 1.5 / 0.4214 = 3.56
\coordinate (PM) at (3.56,2.848);
\fill (PM) circle (2pt);
\draw[black!50, thin] (PM) -- (3.56,0) node[below, font=\scriptsize, text=black] {$V^*$};
\draw[black!50, thin] (4.8,3.84) -- (4.8,0) node[below, font=\scriptsize, text=black] {$V$};
\draw[decorate, decoration={brace, amplitude=3pt, mirror}, thick, black!60] (3.56,-0.45) -- (4.8,-0.45)
  node[midway, below=4pt, font=\scriptsize\itshape, text=black!60] {margen de seguridad};
\node[font=\scriptsize\itshape, text=black!60] at (2.05,1.93) {pérdidas};
\node[font=\scriptsize\itshape, text=black!60] at (5.3,3.82) {beneficio};
% ---------- (b) Apalancamiento operativo ----------
\begin{scope}[xshift=8.9cm]
\node[font=\footnotesize\itshape] at (2.7,5.6) {(b) Dos estructuras de costes};
\draw[-{Stealth[length=2mm]}, thick] (0,2.0) -- (5.6,2.0) node[below left] {ventas};
\draw[-{Stealth[length=2mm]}, thick] (0,0) -- (0,4.9) node[above] {BAII};
% las dos rectas pasan por el mismo BAII en las ventas actuales V
\coordinate (Q) at (3.6,3.1);
\draw[thick] ($(Q)+(-2.6,-2.6)$) -- ($(Q)+(1.6,1.6)$) node[right, font=\scriptsize] {costes fijos altos};
\draw[thick, dashed] ($(Q)+(-3.3,-1.1)$) -- ($(Q)+(1.8,0.6)$) node[right, font=\scriptsize] {costes fijos bajos};
\fill (Q) circle (2pt);
\draw[black!50, thin] (Q) -- (3.6,2.0) node[below, font=\scriptsize, text=black] {$V$};
\end{scope}
\end{tikzpicture}
