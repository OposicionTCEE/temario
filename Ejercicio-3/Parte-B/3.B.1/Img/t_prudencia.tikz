    \node[font=\scriptsize\itshape, text=black!60] at (-#1/2,-0.24) {Debe};
    \node[font=\scriptsize\itshape, text=black!60] at (#1/2,-0.24) {Haber};
    \node[align=left, anchor=north west] at (-#1+0.1,-0.42) {#4};
    \node[align=left, anchor=north west] at (0.1,-0.42) {#5};
  \end{scope}}
\node[font=\footnotesize\itshape] at (2.3,1.25) {(a) Pérdida probable: el cliente dudoso};
\node[font=\footnotesize\itshape] at (10.2,1.25) {(b) Ganancia probable: las existencias};
