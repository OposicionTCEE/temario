% Devengo: el seguro de ALFA en T (cuerpo, «Principios contables»). Generar con: bash Code/generar_figura.sh t_devengo
\begin{tikzpicture}[font=\footnotesize]
\newcommand{\cuentaT}[5][1.9]{% [semiancho] abscisa, título, debe, haber
  \begin{scope}[xshift=#2cm]
    \node[font=\footnotesize\bfseries, align=center, anchor=south] at (0,0.08) {#3};
    \draw[thick] (-#1,0) -- (#1,0);
    \draw[thick] (0,0) -- (0,-1.15);
    \node[font=\scriptsize\itshape, text=black!60] at (-#1/2,-0.24) {Debe};
    \node[font=\scriptsize\itshape, text=black!60] at (#1/2,-0.24) {Haber};
    \node[align=left, anchor=north west] at (-#1+0.1,-0.42) {#4};
    \node[align=left, anchor=north west] at (0.1,-0.42) {#5};
  \end{scope}}
\cuentaT{0}{(572) Bancos}{}{(10)\enspace $2$}
\cuentaT{4.6}{(625) Primas de seguros}{(10)\enspace $2$}{(33)\enspace $1$}
\cuentaT{9.2}{(480) Gastos anticipados}{(33)\enspace $1$}{}
\node at (0,-1.5) {Pago de 2026: $2$};
\node at (4.6,-1.5) {Gasto de 2026: $1$};
\node at (9.2,-1.5) {Activo: gasto de 2027, $1$};
\end{tikzpicture}
