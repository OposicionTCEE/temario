% Calendario del ejercicio 2026 de ALFA, S.L. y de sus cuentas anuales (Anexo II, «Elaboración»).
% Generar con: bash Code/generar_figura.sh calendario_ejercicio. Escala: 0,7 cm por mes desde el 1 de enero de 2026.
\begin{tikzpicture}[
  font=\footnotesize,
  hito/.style={circle, fill=black, inner sep=1.3pt},
  arriba/.style={text width=2.6cm, align=center, anchor=south},
  abajo/.style={text width=2.3cm, align=center, anchor=north, text=black!70}
]
\def\m{0.7}
% eje
\draw[thick, -{Stealth[length=2.2mm]}] (0,0) -- (20*\m,0);
\foreach \i in {0,...,19} \draw (\i*\m,0.06) -- (\i*\m,-0.06);
\draw[thick] (12*\m,0.15) -- (12*\m,-0.15);
\node[font=\footnotesize\bfseries, anchor=north west] at (0.05,-0.08) {2026};
\node[font=\footnotesize\bfseries, anchor=north west] at (12*\m+0.05,-0.08) {2027};
% periodo de registro
\draw[decorate, decoration={brace, amplitude=5pt}] (0.15,0.25) -- (12*\m-0.15,0.25)
  node[midway, above=6pt, text width=6cm, align=center] {registro de las operaciones (asientos $2$ a $28$)};
% hitos contables y mercantiles (arriba)
\node[hito] at (0,0) {};
\draw (0,0) -- (0,1.55) node[arriba, anchor=south west, xshift=-0.1cm, align=left, text width=2cm] {\textbf{apertura}\\ asiento $1$};
\node[hito] at (12*\m,0) {};
\draw (12*\m,0) -- (12*\m,1.55) node[arriba, text width=3cm] {\textbf{cierre}\\ ajustes, regularización\\ y cierre ($29$ a $38$)};
\node[hito] at (15*\m,0) {};
\draw (15*\m,0) -- (15*\m,0.55) node[arriba, text width=2cm] {\textbf{formulación}\\ $3$ meses};
\node[hito] at (18*\m,0) {};
\draw (18*\m,0) -- (18*\m,1.55) node[arriba, anchor=south east, xshift=0.1cm, align=right, text width=2cm] {\textbf{aprobación}\\ junta, $6$ meses};
\node[hito] at (19*\m,0) {};
\draw (19*\m,0) -- (19*\m,2.75) node[arriba, anchor=south east, xshift=0.1cm, align=right, text width=2.6cm] {\textbf{depósito}\\ $1$ mes desde la aprobación};
% plazos fiscales y de los libros (abajo)
\foreach \x/\t in {3.65/1T, 6.65/2T, 9.65/3T} {
  \draw[black!70] (\x*\m,0) -- (\x*\m,-0.7) node[abajo, text width=1.2cm] {IVA \t};
}
\draw[black!70] (13*\m,0) -- (13*\m,-1.55) node[abajo, text width=1.8cm] {IVA 4T\\ $30$ de enero};
\draw[black!70] (16*\m,0) -- (16*\m,-0.7) node[abajo, text width=2.2cm] {legalización de los libros, $4$ meses};
\draw[black!70] (18.8*\m,0) -- (18.8*\m,-1.75) node[abajo, anchor=north east, xshift=0.1cm, align=right, text width=2.4cm] {impuesto sobre sociedades, $1$-$25$ de julio};
\end{tikzpicture}
