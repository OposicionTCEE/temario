% Uniformidad: la amortización de la furgoneta de ALFA con dos vidas útiles (cuerpo, «Principios contables»). Generar con: bash Code/generar_figura.sh t_uniformidad
\begin{tikzpicture}[font=\footnotesize]
\newcommand{\cuentaT}[5][1.6]{% [semiancho] abscisa, título, debe, haber
  \begin{scope}[xshift=#2cm]
    \node[font=\footnotesize\bfseries, align=center, anchor=south] at (0,0.08) {#3};
    \draw[thick] (-#1,0) -- (#1,0);
    \draw[thick] (0,0) -- (0,-1.15);
    \node[font=\scriptsize\itshape, text=black!60] at (-#1/2,-0.24) {Debe};
    \node[font=\scriptsize\itshape, text=black!60] at (#1/2,-0.24) {Haber};
    \node[align=left, anchor=north west] at (-#1+0.1,-0.42) {#4};
    \node[align=left, anchor=north west] at (0.1,-0.42) {#5};
  \end{scope}}
\node[font=\footnotesize\itshape] at (1.8,1.25) {(a) Vida útil de seis años};
\node[font=\footnotesize\itshape] at (9.8,1.25) {(b) Vida útil de diez años, sin cambio en el uso};
\cuentaT{0}{(681) Amortización\\del inmovilizado material}{(21)\enspace $5$}{}
\cuentaT{3.6}{(2818) Amortización acumulada\\de elementos de transporte}{}{(1)\enspace\ \,$5$\\(21)\enspace $5$}
\cuentaT{8}{(681) Amortización\\del inmovilizado material}{$2{,}78$}{}
\cuentaT{11.6}{(2818) Amortización acumulada\\de elementos de transporte}{}{(1)\enspace\ \,$5$\\$2{,}78$}
\draw[dashed, black!40] (5.8,1.45) -- (5.8,-2.15);
\node at (1.8,-1.55) {Resultado antes de impuestos: $10$};
\node at (1.8,-1.95) {Valor contable de la furgoneta: $20$};
\node at (9.8,-1.55) {Resultado antes de impuestos: $12{,}22$};
\node at (9.8,-1.95) {Valor contable de la furgoneta: $22{,}22$};
\end{tikzpicture}
