% Circulación económica: cascada de la cuenta de pérdidas y ganancias y reparto del valor añadido (cuerpo, «Circulación económica»).
% Figura abstracta: alturas ilustrativas, sin cifras. Generar con: bash Code/generar_figura.sh cascada_valor_anadido
\begin{tikzpicture}[font=\footnotesize]
\def\s{1.3}% separación entre barras
\def\w{0.8}% ancho de barra
\def\g{0.42}% cm por unidad ilustrativa
\draw[black!50] (-0.3,0) -- ({9*\s+\w+0.3},0);
% barras: índice, base, tope, relleno (0 = detracción, discontinua)
\foreach \i/\b/\t/\r in {0/0/10/20, 1/7/10/0, 2/0/7/8, 3/4.6/7/0, 4/3.6/4.6/0, 5/0/3.6/8, 6/3.0/3.6/0, 7/2.4/3.0/0} {
  \pgfmathsetmacro{\x}{\i*\s}
  \ifnum\r=0
    \draw[thick, dashed, fill=white] (\x,\b*\g) rectangle (\x+\w,\t*\g);
  \else
    \draw[thick, fill=gray!\r] (\x,\b*\g) rectangle (\x+\w,\t*\g);
  \fi
}
% resultado y su reparto: reservas abajo, dividendos arriba
\draw[thick, fill=gray!8] ({8*\s},0) rectangle ({8*\s+\w},2.4*\g);
\draw[thick, fill=gray!20] ({9*\s},0) rectangle ({9*\s+\w},1.2*\g);
\draw[thick, dashed, fill=white] ({9*\s},1.2*\g) rectangle ({9*\s+\w},2.4*\g);
\node[font=\scriptsize, align=center] at ({9*\s+\w/2},0.6*\g) {re-\\servas};
\node[font=\scriptsize, align=center] at ({9*\s+\w/2},1.8*\g) {divi-\\dendos};
% conectores
\foreach \i/\y in {0/10, 1/7, 2/7, 3/4.6, 4/3.6, 5/3.6, 6/3.0, 7/2.4, 8/2.4} {
  \pgfmathsetmacro{\x}{\i*\s+\w}
  \draw[black!40, thin] (\x,\y*\g) -- (\x+\s-\w,\y*\g);
}
% nombres de las partidas
\foreach \i/\e in {0/{Ingresos}, 1/{Compras y\\servicios}, 2/{Valor\\añadido}, 3/{Personal}, 4/{Amorti-\\zación}, 5/{Resultado de\\explotación}, 6/{Intereses}, 7/{Impuesto}, 8/{Resultado}, 9/{Reparto}} {
  \node[font=\scriptsize, align=center, anchor=north] at ({\i*\s+\w/2},-0.08) {\e};
}
% quién recibe cada parte
\foreach \i/\e in {1/{proveedores}, 3/{trabajadores}, 4/{empresa}, 6/{acreedores}, 7/{Estado}, 9/{socios y\\empresa}} {
  \node[font=\scriptsize\itshape, text=black!60, align=center, anchor=south] at ({\i*\s+\w/2},10.15*\g) {\e};
}
% tramos de la cascada
\draw[decorate, decoration={brace, amplitude=4pt, mirror}, thick, black!60] (-0.05,-0.95) -- ({5*\s+\w+0.05},-0.95)
  node[midway, below=5pt, font=\scriptsize\itshape, text=black!60] {actividad: creación del valor};
\draw[decorate, decoration={brace, amplitude=4pt, mirror}, thick, black!60] ({6*\s-0.05},-0.95) -- ({9*\s+\w+0.05},-0.95)
  node[midway, below=5pt, font=\scriptsize\itshape, text=black!60] {financiación e impuesto: reparto};
\end{tikzpicture}
