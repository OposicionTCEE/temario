% Circulación económica: cascada de la cuenta de pérdidas y ganancias y reparto del valor añadido (cuerpo, «Circulación económica»).
% Figura abstracta: alturas ilustrativas, sin cifras. Generar con: bash Code/generar_figura.sh cascada_valor_anadido
\begin{tikzpicture}[font=\footnotesize]
\def\s{1.3}% separación entre barras
\def\w{0.8}% ancho de barra
\def\g{0.42}% cm por unidad ilustrativa
\draw[black!50] (-0.3,0) -- ({9*\s+1.25},0);
% barras: índice, base, tope, relleno (0 = detracción, discontinua)
\foreach \i/\b/\t/\r in {0/0/10/20, 1/7/10/0, 2/0/7/8, 3/4.8/7/0, 4/4.0/4.8/0, 5/0/4.0/8, 6/3.5/4.0/0, 7/3.0/3.5/0, 8/0/3.0/8} {
  \pgfmathsetmacro{\x}{\i*\s}
  \ifnum\r=0
    \draw[thick, dashed, fill=white] (\x,\b*\g) rectangle (\x+\w,\t*\g);
  \else
    \draw[thick, fill=gray!\r] (\x,\b*\g) rectangle (\x+\w,\t*\g);
  \fi
}
% reparto del resultado: reservas abajo, dividendos arriba (barra más ancha)
\draw[thick, fill=gray!20] ({9*\s},0) rectangle ({9*\s+1.15},1.5*\g);
\draw[thick, dashed, fill=white] ({9*\s},1.5*\g) rectangle ({9*\s+1.15},3.0*\g);
\node[font=\scriptsize] at ({9*\s+0.575},0.75*\g) {reservas};
\node[font=\scriptsize] at ({9*\s+0.575},2.25*\g) {dividendos};
% conectores
\foreach \i/\y in {0/10, 1/7, 2/7, 3/4.8, 4/4.0, 5/4.0, 6/3.5, 7/3.0, 8/3.0} {
  \pgfmathsetmacro{\x}{\i*\s+\w}
  \draw[black!40, thin] (\x,\y*\g) -- (\x+\s-\w,\y*\g);
}
% nombres de las partidas
\foreach \i/\e in {0/{Ingresos}, 1/{Compras y\\servicios}, 2/{Valor\\añadido}, 3/{Personal}, 4/{Amorti-\\zación}, 5/{Resultado de\\explotación}, 6/{Intereses}, 7/{Impuesto}, 8/{Resultado}} {
  \node[font=\scriptsize, align=center, anchor=north] at ({\i*\s+\w/2},-0.08) {\e};
}
\node[font=\scriptsize, align=center, anchor=north] at ({9*\s+0.575},-0.08) {Aplicación};
% quién recibe cada parte del valor añadido
\foreach \i/\e in {3/{trabajadores}, 4/{empresa}, 6/{acreedores}, 7/{Estado}} {
  \node[font=\scriptsize\itshape, text=black!60, anchor=south] at ({\i*\s+\w/2},7.25*\g) {\e};
}
\node[font=\scriptsize\itshape, text=black!60, align=center, anchor=south] at ({9*\s+0.575},7.25*\g) {socios y\\empresa};
\node[font=\scriptsize\itshape, text=black!60, anchor=south] at ({1*\s+\w/2},10.15*\g) {proveedores};
\draw[decorate, decoration={brace, amplitude=4pt}, thick, black!60] ({3*\s-0.05},{9.25*\g}) -- ({9*\s+1.2},{9.25*\g})
  node[midway, above=5pt, font=\scriptsize\itshape, text=black!60] {reparto del valor añadido};
% tramos de la cascada
\draw[decorate, decoration={brace, amplitude=4pt, mirror}, thick, black!60] (-0.05,-0.95) -- ({5*\s+\w+0.05},-0.95)
  node[midway, below=5pt, font=\scriptsize\itshape, text=black!60] {explotación: la actividad};
\draw[decorate, decoration={brace, amplitude=4pt, mirror}, thick, black!60] ({6*\s-0.05},-0.95) -- ({9*\s+1.2},-0.95)
  node[midway, below=5pt, font=\scriptsize\itshape, text=black!60] {financiación, impuesto y aplicación};
\end{tikzpicture}
