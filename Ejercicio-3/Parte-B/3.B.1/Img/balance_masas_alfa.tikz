% Balance de ALFA a 31/12/2026 por masas patrimoniales (cuerpo, «Balance General»). Alturas proporcionales: 141,04 = 5 cm.
% Generar con: bash Code/generar_figura.sh balance_masas_alfa
\begin{tikzpicture}[font=\footnotesize]
\def\f{0.035451}% cm por mil euros
\def\H{5}% alto total
% Activo
\node[font=\footnotesize\bfseries] at (2.1,\H+0.35) {Activo: $141{,}04$};
\draw[thick, fill=gray!8] (0,\H) rectangle (4.2,{\H-40.8*\f});
\node[align=center] at (2.1,{\H-40.8*\f/2}) {Activo no corriente\\$40{,}8$};
\draw[thick, fill=gray!20] (0,{\H-40.8*\f}) rectangle (4.2,0);
\node[align=center] at (2.1,{(\H-40.8*\f)/2}) {Activo corriente\\$100{,}24$};
% Patrimonio neto y pasivo
\node[font=\footnotesize\bfseries] at (6.9,\H+0.35) {Patrimonio neto y pasivo: $141{,}04$};
\draw[thick, fill=gray!8] (4.8,\H) rectangle (9,{\H-75.5*\f});
\node[align=center] at (6.9,{\H-75.5*\f/2}) {Patrimonio neto\\$75{,}5$};
\draw[thick, fill=gray!8] (4.8,{\H-75.5*\f}) rectangle (9,{\H-95.5*\f});
\node at (6.9,{\H-85.5*\f}) {Pasivo no corriente: $20$};
\draw[thick, fill=gray!20] (4.8,{\H-95.5*\f}) rectangle (9,0);
\node[align=center] at (6.9,{(\H-95.5*\f)/2}) {Pasivo corriente\\$45{,}54$};
% Criterios de ordenación
\draw[-{Stealth[length=2mm]}, thick, black!60] (-0.35,\H-0.1) -- (-0.35,0.1);
\node[rotate=90, font=\scriptsize\itshape, text=black!60] at (-0.65,\H/2) {liquidez creciente};
\draw[-{Stealth[length=2mm]}, thick, black!60] (9.35,\H-0.1) -- (9.35,0.1);
\node[rotate=90, font=\scriptsize\itshape, text=black!60] at (9.65,\H/2) {exigibilidad creciente};
\end{tikzpicture}
