% Balance de ALFA a 31/12/2026 por masas patrimoniales (cuerpo, «Balance General»). Alturas proporcionales: 141,04 = 6 cm.
% Generar con: bash Code/generar_figura.sh balance_masas_alfa
\begin{tikzpicture}[font=\footnotesize]
\def\f{0.042541}% cm por mil euros
\tikzset{masa/.style={draw, thick, fill=gray!8, minimum width=4.2cm, align=center, inner sep=0pt}}
% Activo
\node[font=\footnotesize\bfseries] at (2.1,6.35) {Activo: $141{,}04$};
\draw[thick, fill=gray!8] (0,6) rectangle (4.2,{6-40.8*\f});
\node[align=center] at (2.1,{6-40.8*\f/2}) {Activo no corriente\\$40{,}8$};
\draw[thick, fill=gray!20] (0,{6-40.8*\f}) rectangle (4.2,0);
\node[align=center] at (2.1,{(6-40.8*\f)/2}) {Activo corriente\\$100{,}24$};
% Patrimonio neto y pasivo
\node[font=\footnotesize\bfseries] at (6.9,6.35) {Patrimonio neto y pasivo: $141{,}04$};
\draw[thick, fill=gray!8] (4.8,6) rectangle (9,{6-75.5*\f});
\node[align=center] at (6.9,{6-75.5*\f/2}) {Patrimonio neto\\$75{,}5$};
\draw[thick, fill=gray!8] (4.8,{6-75.5*\f}) rectangle (9,{6-95.5*\f});
\node at (6.9,{6-85.5*\f}) {Pasivo no corriente: $20$};
\draw[thick, fill=gray!20] (4.8,{6-95.5*\f}) rectangle (9,0);
\node[align=center] at (6.9,{(6-95.5*\f)/2}) {Pasivo corriente\\$45{,}54$};
% Criterios de ordenación
\draw[-{Stealth[length=2mm]}, thick, black!60] (-0.35,5.9) -- (-0.35,0.1);
\node[rotate=90, font=\scriptsize\itshape, text=black!60] at (-0.65,3) {liquidez creciente};
\draw[-{Stealth[length=2mm]}, thick, black!60] (9.35,5.9) -- (9.35,0.1);
\node[rotate=90, font=\scriptsize\itshape, text=black!60] at (9.65,3) {exigibilidad creciente};
\end{tikzpicture}
