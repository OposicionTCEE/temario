% Efecto apalancamiento: (a) ROE según el endeudamiento; (b) ROE según la rentabilidad económica (cuerpo, «Rentabilidad financiera»).
% Figura abstracta: ROE = [ROA + (ROA - i) D/E](1 - t). Generar con: bash Code/generar_figura.sh apalancamiento
\begin{tikzpicture}[font=\footnotesize]
% ---------- (a) ROE frente a D/E ----------
\node[font=\footnotesize\itshape] at (2.8,4.75) {(a) Según el endeudamiento};
\draw[-{Stealth[length=2mm]}, thick] (0,0) -- (5.9,0) node[below left] {$D/E$};
\draw[-{Stealth[length=2mm]}, thick] (0,0) -- (0,4.5) node[above] {ROE};
\draw[thick] (0,1.8) -- (5.5,4.1) node[right, font=\scriptsize] {ROA $>i$};
\draw[thick, dashed] (0,1.8) -- (5.5,1.8) node[right, font=\scriptsize] {ROA $=i$};
\draw[thick, dotted] (0,1.8) -- (5.5,0.4) node[right, font=\scriptsize] {ROA $<i$};
\node[left, font=\scriptsize] at (0,1.8) {ROA$\,(1-t)$};
% ---------- (b) ROE frente a ROA ----------
\begin{scope}[xshift=8.6cm]
\node[font=\footnotesize\itshape] at (2.6,4.75) {(b) Según la rentabilidad económica};
\draw[-{Stealth[length=2mm]}, thick] (0,1.2) -- (5.6,1.2) node[below left] {ROA};
\draw[-{Stealth[length=2mm]}, thick] (0,0) -- (0,4.5) node[above] {ROE};
% punto común (i, i(1-t))
\coordinate (P) at (2.2,2.0);
\draw[thick, dotted] ($(P)+(-2.0,-0.64)$) -- ($(P)+(3.0,0.96)$) node[right, font=\scriptsize] {$D/E=0$};
\draw[thick, dashed] ($(P)+(-1.6,-1.1)$) -- ($(P)+(3.0,2.06)$) node[right, font=\scriptsize] {$D/E$ bajo};
\draw[thick] ($(P)+(-1.0,-1.25)$) -- ($(P)+(2.0,2.5)$) node[right, font=\scriptsize] {$D/E$ alto};
\fill (P) circle (2pt);
\draw[black!50, thin] (P) -- (2.2,1.2) node[below, font=\scriptsize, text=black] {$i$};
\draw[black!50, thin] (P) -- (0,2.0) node[left, font=\scriptsize, text=black] {$i\,(1-t)$};
\end{scope}
\end{tikzpicture}
