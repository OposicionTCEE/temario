% Circuito de la información contable (Anexo II, «Técnica contable»). Generar con: bash Code/generar_figura.sh circuito_contable
\begin{tikzpicture}[
  font=\footnotesize,
  paso/.style={draw, rounded corners=2pt, fill=gray!8, text width=5.2cm, align=center, minimum height=1.05cm, inner sep=4pt},
  libro/.style={text width=4.4cm, align=left, font=\footnotesize\itshape, text=black!65},
  flecha/.style={-{Stealth[length=2.2mm]}, thick},
  maniobra/.style={text width=4.6cm, align=right, font=\footnotesize}
]
\node[paso] (j) at (0,0)     {\textbf{Justificantes}\\ facturas, nóminas, contratos, extractos};
\node[paso] (d) at (0,-2.0)  {\textbf{Libro Diario}\\ un asiento por operación, por orden de fechas};
\node[paso] (m) at (0,-4.0)  {\textbf{Libro Mayor}\\ una cuenta en T por elemento};
\node[paso] (b) at (0,-6.0)  {\textbf{Balance de comprobación}\\ sumas y saldos de todas las cuentas};
\node[paso] (c) at (0,-8.0)  {\textbf{Cuentas anuales}\\ balance, PyG, ECPN, EFE y memoria};

\draw[flecha] (j) -- (d) node[midway, left=3mm, maniobra] {se registra: qué cuentas se cargan y cuáles se abonan};
\draw[flecha] (d) -- (m) node[midway, left=3mm, maniobra] {pase al Mayor: cada cargo y cada abono, a su cuenta};
\draw[flecha] (m) -- (b) node[midway, left=3mm, maniobra] {se suman el debe y el haber de cada cuenta};
\draw[flecha] (b) -- (c) node[midway, left=3mm, maniobra] {ajustes, regularización y cierre; saldos a los modelos};

\node[libro, right=4mm of j] {soporte de cada anotación; se conserva seis años};
\node[libro, right=4mm of d] {obligatorio};
\node[libro, right=4mm of m] {voluntario};
\node[libro, right=4mm of b] {al menos trimestral, en el Libro de Inventarios y Cuentas Anuales};
\node[libro, right=4mm of c] {en el Libro de Inventarios y Cuentas Anuales};
\end{tikzpicture}
