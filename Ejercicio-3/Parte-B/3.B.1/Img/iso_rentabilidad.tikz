% Rentabilidad económica: curvas de igual rentabilidad en el plano rotación-margen (cuerpo, «Rentabilidad económica»).
% Figura abstracta, sin cifras: margen = ROA / rotación. Generar con: bash Code/generar_figura.sh iso_rentabilidad
\begin{tikzpicture}[font=\footnotesize]
\draw[-{Stealth[length=2mm]}, thick] (0,0) -- (7.2,0) node[below left] {rotación del activo $=\dfrac{\text{ventas}}{\text{activo}}$};
\draw[-{Stealth[length=2mm]}, thick] (0,0) -- (0,4.9) node[above, align=center] {margen $=\dfrac{\text{BAII}}{\text{ventas}}$};
% isocurvas margen = r / rotación (unidades ilustrativas)
\draw[thick, domain=0.45:7.0, samples=80] plot (\x, {1.6/\x});
\draw[thick, dashed, domain=0.75:7.0, samples=80] plot (\x, {3.2/\x});
\node[anchor=west, font=\scriptsize] at (7.0,0.23) {ROA $=r_1$};
\node[anchor=west, font=\scriptsize] at (7.0,0.46) {ROA $=r_2>r_1$};
% dos empresas con la misma rentabilidad
\fill (0.55,{1.6/0.55}) circle (2pt) node[right=3pt] {A};
\fill (5.0,{1.6/5.0}) circle (2pt) node[above=3pt] {B};
% mejora por margen o por rotación
\draw[-{Stealth[length=2mm]}, black!60, thick] (2.0,0.8) -- (2.0,1.6);
\draw[-{Stealth[length=2mm]}, black!60, thick] (2.0,0.8) -- (4.0,0.8);
\fill (2.0,0.8) circle (2pt) node[below left=1pt] {C};
\end{tikzpicture}
