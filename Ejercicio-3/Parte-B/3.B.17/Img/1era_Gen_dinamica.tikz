% Figura del modelo de FLOOD y GARBER (1984): reservas, crédito interno y dinero (izquierda); tipo de cambio fijo y sombra (derecha).
% Fuente de la figura compilada 1era_Gen_dinamica.pdf. Valores ilustrativos: beta=1, alpha=2, mu=1, D(0)=4, s barra=10 => R(0)=6, T=4.
\begin{tikzpicture}[font=\large, >=stealth]
% ---------------- Panel izquierdo: balance del banco central ----------------
\begin{scope}[xscale=0.78, yscale=0.29]
  \draw[->] (0,0) -- (7.6,0) node[below] {$t$};
  \draw[->] (0,0) -- (0,12.8);
  \node[above] at (3.5,12.9) {Balance del banco central};
  \draw[densely dashed, gray] (4,0) -- (4,12.5);
  % Oferta monetaria M(t)
  \draw[very thick] (0,10) -- (4,10);
  \draw[very thick] (4,8) -- (7,11) node[right] {$M(t)$};
  \draw[dotted, thick] (4,10) -- (4,8);
  % Crédito interno D(t) (tras T coincide con M)
  \draw[dashed] (0,4) -- (4,8);
  \node[above left] at (2.9,6.9) {$D(t)$};
  % Reservas R(t)
  \draw[thick, gray] (0,6) -- (4,2);
  \draw[thick, gray, dotted] (4,2) -- (6,0);
  \draw[thick, gray] (4,2) -- (4,0);
  \node[gray, below left] at (2.4,4.0) {$R(t)$};
  % Salto de reservas en el ataque
  \draw[decorate, decoration={brace, amplitude=3pt, mirror}] (4.12,0) -- (4.12,2) node[midway, right=2pt] {$\alpha\mu/\beta$};
  % Etiquetas del eje vertical
  \node[left] at (0,10) {$\beta\bar s$};
  \node[left] at (0,6) {$R(0)$};
  \node[left] at (0,4) {$D(0)$};
  % Etiquetas del eje temporal
  \node[below] at (4,0) {$T$};
  \node[below] at (6,0) {$R(0)/\mu$};
\end{scope}
% ---------------- Panel derecho: tipo de cambio ----------------
\begin{scope}[xshift=7.6cm, xscale=0.78, yscale=0.27]
  \draw[->] (0,0) -- (7.6,0) node[below] {$t$};
  \draw[->] (0,0) -- (0,13.8) node[left] {$s$};
  \node[above] at (3.5,13.9) {Tipo de cambio};
  \draw[densely dashed, gray] (4,0) -- (4,10);
  % Tipo de cambio fijo
  \draw[very thick] (0,10) -- (4,10);
  \draw[dotted] (4,10) -- (7,10);
  \node[left] at (0,10) {$\bar s$};
  % Tipo de cambio sombra
  \draw[dashed] (0,6) -- (4,10);
  \draw[very thick] (4,10) -- (7,13) node[right] {$\tilde s(t)$};
  \node[left] at (0,6) {$\tilde s(0)$};
  % Pendiente
  \draw (5,11) -- (6,11) -- (6,12);
  \node[right] at (6,11.3) {\normalsize$\mu/\beta$};
  % Regiones
  \node at (2,2.2) {\normalsize$\tilde s<\bar s$: región estable};
  \node at (5.8,2.2) {\normalsize$\tilde s>\bar s$: ficticia};
  \fill (4,10) circle (2pt);
  \node[below] at (4,0) {$T$};
\end{scope}
\end{tikzpicture}
