% Figura de la tercera generación: iliquidez internacional en una versión simplificada de CHANG y VELASCO (2001).
% Fuente de 3era_Gen_liquidez.pdf. Valores ilustrativos: k=10, r=0.5 (rk=5), m=2, c1=1.2 por depositante (masa 5 => 6), eta=0.4 (eta*c1*masa=2.4), f=3.
\begin{tikzpicture}[font=\large, >=stealth, yscale=0.42]
% ---------------- Panel A: día normal ----------------
\begin{scope}
  \node[above] at (2.4,10.3) {A. Día normal};
  \draw[->] (0,0) -- (4.9,0);
  \draw[->] (0,0) -- (0,10);
  \fill[gray!45] (0.6,0) rectangle (1.9,2.4);
  \node[above, align=center] at (1.25,2.4) {\normalsize retiran\\\normalsize impacientes};
  \node at (1.25,1.2) {$\eta\,c_1$};
  \fill[gray!15] (2.9,0) rectangle (4.2,5);
  \draw (2.9,0) rectangle (4.2,5);
  \node[above, align=center] at (3.55,5) {\normalsize valor de\\\normalsize liquidación};
  \node at (3.55,2.5) {$r\,k$};
  \node[below] at (2.4,0) {\normalsize obligaciones $<$ recursos};
\end{scope}
% ---------------- Panel B: pánico ----------------
\begin{scope}[xshift=7.6cm]
  \node[above] at (2.4,10.3) {B. Pánico};
  \draw[->] (0,0) -- (4.9,0);
  \draw[->] (0,0) -- (0,10);
  \fill[gray!45] (0.6,0) rectangle (1.9,6);
  \fill[gray!70] (0.6,6) rectangle (1.9,9);
  \node at (1.25,3) {$c_1$};
  \node at (1.25,7.5) {$f$};
  \node[above] at (1.25,9) {\normalsize retiran todos};
  \fill[gray!15] (2.9,0) rectangle (4.2,5);
  \draw (2.9,0) rectangle (4.2,5);
  \fill[gray!30] (2.9,5) rectangle (4.2,7);
  \draw (2.9,5) rectangle (4.2,7);
  \node at (3.55,2.5) {$r\,k$};
  \node at (3.55,6) {$m$};
  \draw[densely dashed] (1.9,9) -- (4.6,9);
  \draw[densely dashed] (4.2,7) -- (4.6,7);
  \draw[decorate, decoration={brace, amplitude=4pt}] (4.7,9) -- (4.7,7) node[midway, right=4pt, align=left] {\normalsize iliquidez\\\normalsize internacional};
  \node[below] at (2.4,0) {\normalsize obligaciones $>$ recursos};
\end{scope}
\end{tikzpicture}
