% Figura de la segunda generación (cláusula de escape): pérdidas de mantener y de devaluar según las expectativas.
% Fuente de 2da_Gen_perdidas.pdf. Valores ilustrativos: rho=1, alpha*d=1, C=3 => u_D=2, u_M=1.
\begin{tikzpicture}[font=\large, >=stealth]
% ---------------- Panel izquierdo: no se espera devaluación ----------------
\begin{scope}[xscale=2.3, yscale=0.3]
  \draw[->] (0,0) -- (2.9,0) node[below] {$u_{t-1}$};
  \draw[->] (0,0) -- (0,13.8) node[left] {$L$};
  \node[above] at (1.4,14.2) {$\mathbb E_{t-1}[\pi_t]=0$};
  \draw[very thick, domain=0:2.6, samples=40] plot (\x,{\x*\x}) node[right] {$L^f$};
  \draw[very thick, dashed, domain=0:2.6, samples=40] plot (\x,{(\x-1)*(\x-1)+3}) node[right] {$L^d$};
  \draw[densely dashed, gray] (2,0) -- (2,4);
  \node[circle, fill, inner sep=1.6pt] at (2,4) {};
  \node[below] at (2,0) {$u_D$};
  \node at (0.95,9.5) {\normalsize mantener};
  \node at (2.35,1.6) {\normalsize devaluar};
\end{scope}
% ---------------- Panel derecho: se espera devaluación ----------------
\begin{scope}[xshift=8.2cm, xscale=2.3, yscale=0.3]
  \draw[->] (0,0) -- (2.9,0) node[below] {$u_{t-1}$};
  \draw[->] (0,0) -- (0,13.8) node[left] {$L$};
  \node[above] at (1.4,14.2) {$\mathbb E_{t-1}[\pi_t]=d$};
  \draw[very thick, domain=0:2.6, samples=40] plot (\x,{(\x+1)*(\x+1)}) node[right] {$L^f$};
  \draw[very thick, dashed, domain=0:2.6, samples=40] plot (\x,{\x*\x+3}) node[right] {$L^d$};
  \draw[densely dashed, gray] (1,0) -- (1,4);
  \node[circle, fill, inner sep=1.6pt] at (1,4) {};
  \node[below] at (1,0) {$u_M$};
  \node at (0.5,9.5) {\normalsize mantener};
  \node at (1.9,1.6) {\normalsize devaluar};
\end{scope}
\end{tikzpicture}
