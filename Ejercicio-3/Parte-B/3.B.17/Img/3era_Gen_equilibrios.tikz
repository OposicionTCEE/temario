% Figura de la tercera generación: equilibrios del modelo de balance de KRUGMAN (1999).
% Fuente de 3era_Gen_equilibrios.pdf. Valores ilustrativos.
% Panel A: plano inversión-tipo de cambio real. GG: p = 9 - i. FF: i = 8 si p<=3; p = 7 - i/2 entre ambos; i = 0 si p>=7. Cortes: H(8,1), U(4,5), L(0,9).
% Panel B: inversión financiable frente a esperada con lambda = 2: i^f = min(8, max(0, 2(i^e-2))). Cortes con la bisectriz: L(0), U(4), H(8).
\begin{tikzpicture}[font=\large, >=stealth]
% ---------------- Panel A ----------------
\begin{scope}[scale=0.52]
  \draw[->] (0,0) -- (10.6,0) node[below] {$i_t$};
  \draw[->] (0,0) -- (0,10.3) node[left] {$p_t$};
  \node[above] at (5,10.4) {A. Bienes ($GG$) y crédito ($FF$)};
  \draw[very thick] (0,9) -- (9,0) node[above right] {$GG$};
  \draw[very thick, dashed] (0,10) -- (0,7) -- (8,3) -- (8,0.0);
  \node[right] at (8,2.2) {$FF$};
  \node[circle, fill, inner sep=1.6pt] at (8,1) {}; \node[left] at (8,1) {$H$};
  \node[circle, fill, inner sep=1.6pt] at (4,5) {}; \node[above right] at (4,5) {$U$};
  \node[circle, fill, inner sep=1.6pt] at (0,9) {}; \node[right] at (0,9.3) {$L$};
  \node[below] at (8,0) {\normalsize $i^{\max}$};
\end{scope}
% ---------------- Panel B ----------------
\begin{scope}[xshift=8.4cm, scale=0.52]
  \draw[->] (0,0) -- (10.6,0) node[below] {$i^e_t$};
  \draw[->] (0,0) -- (0,10.3) node[left] {$i^f_t$};
  \node[above] at (5,10.4) {B. Amplificación ($\lambda>1$)};
  \draw[gray] (0,0) -- (9.8,9.8) node[above left] {\normalsize $45^{\circ}$};
  \draw[very thick] (0,0) -- (2,0) -- (6,8) -- (9.8,8);
  \node[circle, fill, inner sep=1.6pt] at (0,0) {}; \node[above left] at (0,0) {$L$};
  \node[circle, fill, inner sep=1.6pt] at (4,4) {}; \node[left] at (4,4.2) {$U$};
  \node[circle, fill, inner sep=1.6pt] at (8,8) {}; \node[above] at (8,8.1) {$H$};
  % Escalera hacia L
  \draw[->, thick, gray!70!black] (3.6,3.6) -- (3.6,3.2) -- (3.2,3.2) -- (3.2,2.4) -- (2.4,2.4) -- (2.4,0.8) -- (0.8,0.8) -- (0.8,0.1);
  % Escalera hacia H
  \draw[->, thick, gray!70!black] (4.4,4.4) -- (4.4,4.8) -- (4.8,4.8) -- (4.8,5.6) -- (5.6,5.6) -- (5.6,7.2) -- (7.2,7.2) -- (7.2,7.9);
  \node[align=center] at (7.6,3.1) {\normalsize pendiente $\lambda$};
\end{scope}
\end{tikzpicture}
