% Figura de la tercera generación: bucle de retroalimentación del modelo de balance de KRUGMAN (1999).
% Fuente de 3era_Gen_bucle.pdf.
\begin{tikzpicture}[font=\large, >=stealth, node distance=1.2cm,
  caja/.style={draw, rounded corners=3pt, thick, align=center, minimum height=1.5cm, text width=3.1cm}]
  \node[caja] (ie) {$\downarrow i^e_t$\\[2pt]\normalsize inversión esperada\\\normalsize (salida de capitales)};
  \node[caja, right=of ie] (p) {$\uparrow p_t$\\[2pt]\normalsize depreciación\\\normalsize real};
  \node[caja, right=of p] (w) {$\downarrow w_t$\\[2pt]\normalsize riqueza de los\\\normalsize empresarios};
  \node[caja, right=of w] (if) {$\downarrow i^f_t$\\[2pt]\normalsize inversión\\\normalsize financiable};
  \draw[->, very thick] (ie) -- node[above] {\normalsize bienes} node[below] {\small $-\frac{1-\mu}{X_t}$} (p);
  \draw[->, very thick] (p) -- node[above] {\normalsize balance} node[below] {\small $-b^f_t$} (w);
  \draw[->, very thick] (w) -- node[above] {\normalsize crédito} node[below] {\small $1+\theta$} (if);
  \draw[->, very thick, dashed] (if.south) -- ++(0,-0.75) -| node[pos=0.25, below] {\normalsize las expectativas se revisan: $\Delta i^f_t=\lambda\,\Delta i^e_t$,\quad $\lambda=\frac{(1+\theta)(1-\mu)\,b^f_t}{X_t}$} (ie.south);
\end{tikzpicture}
