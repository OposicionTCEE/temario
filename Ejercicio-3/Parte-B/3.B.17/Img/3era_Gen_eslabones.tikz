% Figura de la tercera generación: los tres eslabones del modelo de balance de KRUGMAN (1999).
% Fuente de 3era_Gen_eslabones.pdf. Valores ilustrativos.
\begin{tikzpicture}[font=\large, >=stealth]
% ---------------- Panel 1: mercado de bienes ----------------
\begin{scope}[scale=0.62]
  \draw[->] (0,0) -- (7.2,0) node[below] {$i^e_t$};
  \draw[->] (0,0) -- (0,6.4) node[left] {$p_t$};
  \node[above] at (3.4,6.5) {1. Mercado de bienes};
  \draw[very thick] (0,5.5) -- (6.5,1.0) node[above right] {$GG$};
  \node[align=center] at (4.6,4.6) {\normalsize pendiente\\\normalsize $-\frac{1-\mu}{X_t}$};
\end{scope}
% ---------------- Panel 2: balance ----------------
\begin{scope}[xshift=5.7cm, scale=0.62]
  \draw[->] (0,0) -- (7.2,0) node[below] {$p_t$};
  \draw[->] (0,-1.6) -- (0,6.4) node[left] {$w_t$};
  \node[above] at (3.4,6.5) {2. Balance};
  \draw[very thick] (0,5) -- (6.5,-1.2) node[right] {};
  \node[left] at (0,5) {\normalsize $\alpha y_t-b^d_t$};
  \node[circle, fill, inner sep=1.4pt] at (5.24,0) {};
  \node[above right] at (5.24,0) {\normalsize quiebra};
  \node[align=center] at (4.3,4.0) {\normalsize pendiente\\\normalsize $-b^f_t$};
\end{scope}
% ---------------- Panel 3: restricción de crédito ----------------
\begin{scope}[xshift=11.4cm, scale=0.62]
  \draw[->] (0,0) -- (7.2,0) node[below] {$w_t$};
  \draw[->] (0,0) -- (0,6.4) node[left] {$i^f_t$};
  \node[above] at (3.4,6.5) {3. Crédito};
  \draw[very thick] (0,0) -- (3.2,4.8) -- (6.8,4.8);
  \draw[densely dashed, gray] (0,4.8) -- (3.2,4.8);
  \node[left] at (0,4.8) {\normalsize $i^{\max}$};
  \node[align=center, right] at (1.75,2.0) {\normalsize pendiente\\\normalsize $1+\theta$};
\end{scope}
\end{tikzpicture}
