% Figura de la segunda generación (cláusula de escape): regiones de equilibrio.
% Fuente de 2da_Gen_regiones.pdf.
% Panel A: ganancia neta de devaluar, G = L^f - L^d, según el desempleo heredado (rho=1, alpha*d=1, C=3 => u_M=1, u_D=2).
% Panel B: umbrales según la devaluación esperada alpha*d (C=1, 2*rho=1 => u_D=1/p+p, u_M=1/p-p, sqrt(C)=1).
\begin{tikzpicture}[font=\large, >=stealth]
% ---------------- Panel A ----------------
\begin{scope}[xscale=1.95, yscale=0.62]
  \fill[gray!18] (1,-4.3) rectangle (2,4.3);
  \draw[->] (0,0) -- (3.05,0) node[right] {$u_{t-1}$};
  \draw[->] (0,-4.4) -- (0,4.6) node[left] {$G$};
  \node[above] at (1.5,4.7) {A. Ganancia neta de devaluar};
  \draw[very thick] (0,-4) -- (3,2) node[right] {$G^0$};
  \draw[very thick, dashed] (0,-2) -- (3,4) node[right] {$G^d$};
  \node[circle, fill, inner sep=1.6pt] at (2,0) {}; \node[circle, fill, inner sep=1.6pt] at (1,0) {};
  \node[below right] at (2,0) {$u_D$};
  \node[above left] at (1,0) {$u_M$};
  \node[align=center] at (0.5,2.6) {\normalsize mantener};
  \node[align=center] at (1.5,-3.3) {\normalsize múltiples};
  \node[align=center] at (2.55,-3.3) {\normalsize devaluar};
  \draw[decorate, decoration={brace, amplitude=4pt}] (1,1.1) -- (2,1.1) node[midway, above=3pt] {\normalsize $\alpha d/\rho$};
\end{scope}
% ---------------- Panel B ----------------
\begin{scope}[xshift=8.4cm, xscale=1.95, yscale=0.62]
  \fill[gray!18, domain=0.3:2.4, samples=60] plot (\x,{1/\x+\x}) -- plot[domain=2.4:0.3] (\x,{1/\x-\x}) -- cycle;
  \draw[->] (0,0) -- (2.75,0) node[right] {$\alpha d$};
  \draw[->] (0,-2.3) -- (0,4.6) node[left] {$u_{t-1}$};
  \node[above] at (1.35,4.7) {B. Umbrales y devaluación esperada};
  \draw[very thick, domain=0.27:2.4, samples=60] plot (\x,{1/\x+\x}) node[right] {$u_D$};
  \draw[very thick, dashed, domain=0.3:2.4, samples=60] plot (\x,{1/\x-\x}) node[right] {$u_M$};
  \draw[densely dashed, gray] (1,-2.2) -- (1,2);
  \node[below left] at (1,0) {$\sqrt{C}$};
  \node at (1.95,3.95) {\normalsize devaluar};
  \node at (1.75,1.35) {\normalsize fragilidad};
  \node at (0.6,-1.5) {\normalsize mantener};
\end{scope}
\end{tikzpicture}
