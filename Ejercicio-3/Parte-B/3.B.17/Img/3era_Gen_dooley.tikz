% Figura de la tercera generación: modelo de seguro de DOOLEY (2000), versión simplificada.
% Fuente de 3era_Gen_dooley.pdf. Valores ilustrativos: R=6, L0=2, g=1 => T=4; tras la crisis, las reservas se reconstruyen hasta R'=7 en t=7 y los pasivos vuelven a crecer.
\begin{tikzpicture}[font=\large, >=stealth, xscale=1.25, yscale=0.55]
  \draw[->] (0,0) -- (11.6,0) node[below] {$t$};
  \draw[->] (0,0) -- (0,8.6) node[left] {\normalsize stocks};
  % Reservas
  \draw[very thick] (0,6) -- (4,6);
  \draw[very thick, dotted] (4,6) -- (4,0);
  \draw[very thick] (4,0) -- (7,7) -- (10,7);
  \draw[very thick, dotted] (10,7) -- (10,0);
  \draw[very thick] (10,0) -- (11.2,2.8);
  \node[above] at (2,6) {$R$};
  \node[above] at (8.8,7) {$R'$};
  % Pasivos garantizados
  \draw[very thick, dashed] (0,2) -- (4,6);
  \draw[very thick, dashed] (4,0) -- (5.2,0) -- (10,7);
  \node[below right] at (2.1,4.0) {$L_t$};
  % Ataques
  \node[circle, fill, inner sep=1.6pt] at (4,6) {};
  \node[circle, fill, inner sep=1.6pt] at (10,7) {};
  \node[below] at (4,0) {$T$};
  \node[below] at (10,0) {$T'$};
  \node[left] at (0,2) {$L_0$};
  \node[align=center] at (2.9,1.1) {\normalsize ataque en $T$:\\\normalsize $\Delta R=-R$};
  \node[align=center] (rec) at (5.4,8.0) {\normalsize reconstrucción de reservas};
  \draw[->, thin] (rec.south) -- (5.6,3.9);
\end{tikzpicture}
