% Figura de la tercera generación: qué ocurre con un pánico según el régimen cambiario (CHANG y VELASCO, 2000 y 2001), esquema.
% Fuente de 3era_Gen_regimen.pdf.
\begin{tikzpicture}[font=\normalsize, >=stealth,
  caja/.style={draw, rounded corners=3pt, thick, align=center, text width=4.1cm, minimum height=1.3cm},
  res/.style={draw, rounded corners=3pt, align=center, text width=4.6cm, minimum height=1.3cm, fill=gray!12}]
  \node[caja, text width=3.2cm] (p) at (0,0) {\textbf{Pánico}\\iliquidez internacional};
  \node[caja] (a) at (5,1.8) {Caja de conversión\\(sin prestamista)};
  \node[caja] (b) at (5,0) {Tipo fijo y prestamista\\de última instancia};
  \node[caja] (c) at (5,-1.8) {Tipo flexible y prestamista\\de última instancia};
  \node[res] (ra) at (10.6,1.8) {Quiebra bancaria;\\la paridad se mantiene};
  \node[res] (rb) at (10.6,0) {El rescate se cambia por divisas:\\\textbf{crisis gemelas}};
  \node[res] (rc) at (10.6,-1.8) {Depreciación;\\los bancos sobreviven};
  \draw[->, thick] (p.east) -- (a.west);
  \draw[->, thick] (p.east) -- (b.west);
  \draw[->, thick] (p.east) -- (c.west);
  \draw[->, thick] (a) -- (ra);
  \draw[->, thick] (b) -- (rb);
  \draw[->, thick] (c) -- (rc);
\end{tikzpicture}
