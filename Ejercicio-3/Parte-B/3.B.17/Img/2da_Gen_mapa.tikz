% Figura de la segunda generación (cláusula de escape): mapa de equilibrios. Para cada tramo de desempleo heredado,
% qué hace el Gobierno según lo que esperan los agentes y qué expectativas se autocumplen.
% Fuente de 2da_Gen_mapa.pdf.
\begin{tikzpicture}[font=\normalsize, >=stealth,
  si/.style={draw, rounded corners=2pt, fill=gray!10, minimum width=3.6cm, minimum height=0.8cm, align=center},
  no/.style={draw, rounded corners=2pt, dashed, minimum width=3.6cm, minimum height=0.8cm, align=center, text=gray}]
  % Zona de fragilidad sombreada
  \fill[gray!22] (4.3,-0.55) rectangle (8.3,3.15);
  % Eje de desempleo heredado
  \draw[->, thick] (0.2,-0.55) -- (12.6,-0.55) node[right] {$u_{t-1}$};
  \draw[thick] (4.3,-0.7) -- (4.3,-0.4) node[pos=0, below] {$u_M$};
  \draw[thick] (8.3,-0.7) -- (8.3,-0.4) node[pos=0, below] {$u_D$};
  % Etiquetas de fila
  \node[align=right, anchor=east] at (0.3,2.35) {Se espera\\que mantenga};
  \node[align=right, anchor=east] at (0.3,1.15) {Se espera\\que devalúe};
  % Fila 1: E[pi]=0
  \node[si] at (2.3,2.35) {mantiene \ \checkmark};
  \node[si] at (6.3,2.35) {mantiene \ \checkmark};
  \node[no] at (10.3,2.35) {devalúa \ $\times$};
  % Fila 2: E[pi]=d
  \node[no] at (2.3,1.15) {mantiene \ $\times$};
  \node[si] at (6.3,1.15) {devalúa \ \checkmark};
  \node[si] at (10.3,1.15) {devalúa \ \checkmark};
  % Equilibrios
  \node[font=\bfseries] at (2.3,0.05) {mantenimiento};
  \node[font=\bfseries] at (6.3,0.05) {dos equilibrios};
  \node[font=\bfseries] at (10.3,0.05) {devaluación};
  \node[align=center] at (6.3,3.65) {zona de fragilidad: amplitud $\alpha d/\rho$};
\end{tikzpicture}
