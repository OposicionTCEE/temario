% Acuerdo sobre las Medidas en materia de Inversiones relacionadas con el Comercio: qué prohíbe y qué no. Elaboración propia.
\definecolor{tPro}{RGB}{190,60,50}
\definecolor{tPer}{RGB}{46,125,90}
\definecolor{tOtr}{RGB}{110,110,110}
\begin{tikzpicture}[font=\footnotesize,
    every node/.append style={execute at begin node={\hyphenpenalty=10000}},
    cab/.style={fill=#1, text=white, font=\footnotesize\bfseries, align=center, inner sep=3pt, minimum height=0.6cm},
    caja/.style={draw=#1!60, fill=#1!6, align=left, inner sep=3pt}]
  \node[cab=tPro, text width=9.9cm, anchor=north west] at (0,0) {Prohibidas (lista ilustrativa del anexo)};
  \node[caja=tPro, text width=4.8cm, minimum height=1.75cm, anchor=north west] at (0,-0.75) {\textbf{Contrarias al trato nacional} (art. III.4)\\[2pt]Contenido local mínimo $\cdot$ equilibrio comercial: comprar insumos importados solo en proporción a lo exportado};
  \node[caja=tPro, text width=4.8cm, minimum height=1.75cm, anchor=north west] at (5.1,-0.75) {\textbf{Contrarias a la prohibición de restricciones} (art. XI.1)\\[2pt]Equilibrio comercial en las importaciones $\cdot$ límites al acceso a divisas $\cdot$ restricciones a la exportación};
  \node[cab=tPer, text width=5.2cm, anchor=north west] at (10.4,0) {No prohibidas};
  \node[caja=tPer, text width=5.2cm, minimum height=1.75cm, anchor=north west] at (10.4,-0.75) {Requisitos de exportación, de transferencia de tecnología o de empleo local, que el Acuerdo no menciona};
  \node[caja=tOtr, text width=15.6cm, anchor=north west] at (0,-2.75) {\textbf{Transición}: $2$ años los países desarrollados, $5$ los países en desarrollo y $7$ los menos adelantados para eliminar las medidas notificadas (art. $5.2$)\\[2pt]\textbf{Casos}: \textit{Canadá -- Energía renovable} (2013) e \textit{India -- Células solares} (2016): el contenido local de la política industrial verde};
\end{tikzpicture}
