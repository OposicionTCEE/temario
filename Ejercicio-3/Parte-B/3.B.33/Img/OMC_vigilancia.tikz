% Vigilancia en la OMC: vigilancia continua y Mecanismo de Examen de las Políticas Comerciales (anexo 3). Elaboración propia.
\definecolor{vAdm}{RGB}{46,125,90}
\definecolor{vDes}{RGB}{215,150,20}
\begin{tikzpicture}[font=\scriptsize,
    every node/.append style={execute at begin node={\hyphenpenalty=10000}},
    caja/.style={draw=vAdm, fill=vAdm!10, line width=0.5pt, rounded corners=2pt, align=center, text width=#1, inner sep=3pt},
    flecha/.style={-{Latex[length=1.6mm]}, line width=0.6pt, black!60}]
  % Vigilancia continua
  \node[draw=vAdm, fill=vAdm!25, rounded corners=2pt, align=center, text width=14.2cm, inner sep=4pt] (cont) at (0,0) {\textbf{Vigilancia continua}: notificaciones de leyes y medidas $\cdot$ consejos y comités (preocupaciones comerciales específicas) $\cdot$ informes de vigilancia del comercio (desde la crisis de 2008-2009)};
  % Examen periódico
  \node[caja=2.9cm] (gob) at (-5.6,-1.75) {\textbf{Informe del Gobierno}\\examinado: su política comercial};
  \node[caja=2.9cm] (sec) at (-5.6,-3.2) {\textbf{Informe de la Secretaría}\\independiente: datos, misión al país};
  \node[caja=3.2cm] (reu) at (-1.4,-2.47) {\textbf{Reunión del Órgano de Examen}\\todos los miembros: preguntas por escrito y debate};
  \node[caja=2.9cm] (obs) at (2.65,-2.47) {\textbf{Observaciones finales}\\del presidente; todo se publica};
  \draw[flecha] (gob.east) -- (reu.west); \draw[flecha] (sec.east) -- (reu.west); \draw[flecha] (reu) -- (obs);
  \node[draw=black!40, fill=black!3, rounded corners=2pt, align=left, text width=3.2cm, inner sep=3pt] (cic) at (6.0,-2.47) {\textbf{Ciclo} (desde 2019):\\cada $3$ años: UE, EE.UU., China, Japón\\cada $5$ años: los $16$ siguientes\\cada $7$ años: el resto\\[2pt]\textit{No sirve de base para diferencias}};
  \draw[flecha, dashed] (obs) -- (cic);
  \node[font=\scriptsize\bfseries, vAdm, anchor=south west] at (-7.15,-1.05) {Examen periódico (MEPC, anexo 3)};
  % Desarrollo
  \node[draw=vDes, fill=vDes!12, rounded corners=2pt, align=center, text width=14.2cm, inner sep=3pt] at (0,-4.45) {\textbf{Desarrollo}: intervalo de examen más largo para los PMA $\cdot$ plazos de aplicación y de notificación más largos $\cdot$ asistencia técnica para notificar y aplicar (p. ej., calendario propio en el Acuerdo de Facilitación del Comercio) $\cdot$ Comité de Comercio y Desarrollo};
\end{tikzpicture}
