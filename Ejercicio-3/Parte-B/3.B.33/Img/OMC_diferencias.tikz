% Procedimiento de solución de diferencias (ESD, anexo 2). Elaboración propia.
\definecolor{dJur}{RGB}{190,60,50}
\definecolor{dDes}{RGB}{215,150,20}
\begin{tikzpicture}[font=\scriptsize,
    every node/.append style={execute at begin node={\hyphenpenalty=10000}},
    paso/.style={draw=dJur, fill=dJur!10, line width=0.5pt, rounded corners=2pt, align=center, text width=2.15cm, minimum height=1.35cm, inner sep=2.5pt},
    flecha/.style={-{Latex[length=1.6mm]}, line width=0.6pt, black!60}]
  \node[paso] (c) at (0,0) {\textbf{Consultas}\\$60$ días};
  \node[paso] (g) at (2.55,0) {\textbf{Grupo especial}\\se crea salvo consenso en contra; informe en $6$-$9$ meses};
  \node[paso, dashed, fill=black!5] (a) at (5.1,0) {\textbf{Apelación}\\$60$-$90$ días;\\Órgano de Apelación sin miembros desde 2019};
  \node[paso] (o) at (7.65,0) {\textbf{Adopción por el OSD}\\salvo consenso en contra};
  \node[paso] (p) at (10.2,0) {\textbf{Cumplimiento}\\plazo prudencial (orientativo: $15$ meses)};
  \node[paso] (r) at (12.75,0) {\textbf{Si no cumple}\\compensación o suspensión de concesiones (art. $22$)};
  \draw[flecha] (c) -- (g); \draw[flecha] (g) -- (a); \draw[flecha] (a) -- (o); \draw[flecha] (o) -- (p); \draw[flecha] (p) -- (r);
  % Bypass sin apelación
  \draw[flecha] (g.north) -- ++(0,0.35) -| (o.north) node[pos=0.25, above, font=\tiny] {sin apelación};
  % Problema actual
  \node[draw=dJur, fill=white, rounded corners=2pt, align=center, text width=4.6cm, inner sep=3pt] (vac) at (5.1,-1.85) {\textbf{Desde el 11/12/2019}: un informe apelado no puede adoptarse (apelación «en el vacío»). Alternativa entre sus miembros: el \textbf{MPIA} (arbitraje del art. $25$)};
  \draw[dashed, dJur] (a.south) -- (vac.north);
  % Desarrollo
  \node[draw=dDes, fill=dDes!12, rounded corners=2pt, align=center, text width=14.6cm, inner sep=3pt] at (6.375,-3.2) {\textbf{Desarrollo}: plazos más flexibles y atención a sus intereses (arts. $12.10$, $12.11$ y $21.2$ ESD) $\cdot$ procedimientos especiales y moderación frente a los PMA (art. $24$) $\cdot$ asistencia jurídica del Centro de Asesoría Legal en Asuntos de la OMC (2001)};
\end{tikzpicture}
