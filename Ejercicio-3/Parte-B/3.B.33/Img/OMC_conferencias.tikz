% Eje cronológico de las Conferencias Ministeriales de la OMC (1996-2026). Elaboración propia.
\definecolor{cmExito}{RGB}{46,125,90}
\definecolor{cmFallo}{RGB}{190,60,50}
\definecolor{cmLimit}{RGB}{110,110,110}
\definecolor{cmDes}{RGB}{215,150,20}
\begin{tikzpicture}[x=0.52cm, y=1cm, font=\scriptsize,
    every node/.append style={execute at begin node={\hyphenpenalty=10000}},
    cm/.style={align=center, text width=2.75cm, inner sep=1.5pt, draw=#1, line width=0.5pt, fill=#1!8, rounded corners=1.5pt},
    pt/.style={circle, fill=#1, inner sep=1.5pt},
    des/.style={circle, fill=cmDes, text=white, inner sep=0.6pt, font=\tiny\bfseries}]
  % Eje (x = año - 1995)
  \draw[-{Latex[length=2mm]}, line width=0.8pt] (0,0) -- (32.5,0);
  \foreach \a in {1995,2000,2005,2010,2015,2020,2025}
    \draw (\a-1995,0.07) -- (\a-1995,-0.07) node[below=0pt, font=\tiny] {\a};
  % \cmA{año}{color}{nivel y}{anclaje}{texto}
  \newcommand{\cmA}[5]{\node[pt=#2] at (#1-1995,0) {}; \draw[#2, line width=0.4pt] (#1-1995,0) -- (#1-1995,#3); \node[cm=#2, anchor=#4] at (#1-1995,#3) {#5};}
  \cmA{1996}{cmLimit}{0.5}{south}{\textbf{CM1 Singapur 1996}\\nuevos «temas de Singapur»}
  \cmA{1998}{cmExito}{-0.5}{north}{\textbf{CM2 Ginebra 1998}\\moratoria a los derechos sobre transmisiones electrónicas}
  \cmA{1999}{cmFallo}{2.0}{south}{\textbf{CM3 Seattle 1999}\\fracaso entre protestas: no se lanza la ronda}
  \cmA{2001}{cmExito}{-2.25}{north}{\textbf{CM4 Doha 2001} \tikz\node[des]{D};\\lanza la Agenda de Doha para el Desarrollo; adhesión de China}
  \cmA{2003}{cmFallo}{3.5}{south}{\textbf{CM5 Cancún 2003}\\fracaso: agricultura y temas de Singapur; nace el G-20}
  \cmA{2005}{cmExito}{-4.0}{north}{\textbf{CM6 Hong Kong 2005} \tikz\node[des]{D};\\fin pactado de las subvenciones agrícolas a la exportación; acceso libre para los PMA; Ayuda para el Comercio}
  \cmA{2009}{cmLimit}{0.5}{south}{\textbf{CM7 Ginebra 2009}\\conferencia de balance, sin negociación}
  \cmA{2011}{cmLimit}{-0.5}{north}{\textbf{CM8 Ginebra 2011}\\adhesión de Rusia; Doha en punto muerto}
  \cmA{2013}{cmExito}{2.0}{south}{\textbf{CM9 Bali 2013} \tikz\node[des]{D};\\Acuerdo sobre Facilitación del Comercio; decisiones para los PMA}
  \cmA{2015}{cmExito}{-2.25}{north}{\textbf{CM10 Nairobi 2015} \tikz\node[des]{D};\\eliminación de las subvenciones agrícolas a la exportación; sin consenso sobre Doha}
  \cmA{2017}{cmLimit}{3.5}{south}{\textbf{CM11 Buenos Aires 2017}\\sin declaración; iniciativas plurilaterales}
  \cmA{2022}{cmExito}{-4.0}{north}{\textbf{CM12 Ginebra 2022}\\subvenciones a la pesca; exención ADPIC para vacunas}
  \cmA{2024}{cmLimit}{0.5}{south}{\textbf{CM13 Abu Dabi 2024} \tikz\node[des]{D};\\adhesiones de Comoras y Timor-Leste; transición de los PMA}
  \cmA{2026}{cmFallo}{-0.5}{north}{\textbf{CM14 Yaundé 2026}\\sin declaración; expira la moratoria electrónica}
  % Hechos externos
  \begin{scope}[cmLimit]
    \draw[dashed] (-0.3,-6.0) -- (32.5,-6.0);
    \node[anchor=west, font=\tiny\itshape] at (-0.3,-5.83) {Hechos externos};
    \foreach \a/\t in {2001/{China entra en la OMC}, 2008/{fracasa el «paquete de julio»}, 2019/{Órgano de Apelación paralizado; 2020: COVID-19 aplaza la CM12}}
      \node[font=\tiny\itshape, anchor=north, text width=3.2cm, align=center] at (\a-1995,-6.07) {\textbf{\a:} \t};
  \end{scope}
  % Leyenda
  \begin{scope}[shift={(25.0,4.3)}, font=\tiny]
    \fill[cmExito] (0,0) circle (1.5pt); \node[anchor=west] at (0.15,0) {acuerdo relevante};
    \fill[cmLimit] (5.2,0) circle (1.5pt); \node[anchor=west] at (5.35,0) {resultados limitados};
    \fill[cmFallo] (0,-0.3) circle (1.5pt); \node[anchor=west] at (0.15,-0.3) {fracaso};
    \node[des] at (5.2,-0.3) {D}; \node[anchor=west] at (5.35,-0.3) {resultados para los PED y PMA};
  \end{scope}
\end{tikzpicture}
