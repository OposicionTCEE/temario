% El GATT de 1994: estructura, principios y excepciones. Elaboración propia.
\definecolor{gEst}{RGB}{110,110,110}
\definecolor{gPri}{RGB}{46,125,90}
\definecolor{gExc}{RGB}{190,60,50}
\definecolor{gDes}{RGB}{215,150,20}
\begin{tikzpicture}[font=\scriptsize,
    every node/.append style={execute at begin node={\hyphenpenalty=10000}},
    cab/.style 2 args={fill=#1, text=white, font=\footnotesize\bfseries, align=center, text width=#2, inner sep=3pt, rounded corners=2pt},
    it/.style 2 args={draw=#1, fill=#1!10, line width=0.5pt, rounded corners=1.5pt, align=left, text width=#2, inner sep=2.5pt}]
  % Estructura
  \node[cab={gEst}{3.5cm}] (e) at (0,0) {Estructura\\(cuatro partes)};
  \node[it={gEst}{3.4cm}, below=0.15cm of e] (e1) {\textbf{Parte I} (arts. I-II)\\NMF y listas de concesiones};
  \node[it={gEst}{3.4cm}, below=0.12cm of e1] (e2) {\textbf{Parte II} (arts. III-XXIII)\\resto de reglas y excepciones};
  \node[it={gEst}{3.4cm}, below=0.12cm of e2] (e3) {\textbf{Parte III} (arts. XXIV-XXXV)\\uniones aduaneras y zonas de libre comercio, entre otras};
  \node[it={gDes}{3.4cm}, below=0.12cm of e3] (e4) {\textbf{Parte IV} (arts. XXXVI-XXXVIII, 1965)\\comercio y desarrollo};
  % Principios
  \node[cab={gPri}{4.6cm}] (p) at (4.35,0) {Principios\\(la regla general)};
  \node[it={gPri}{4.5cm}, below=0.15cm of p] (p1) {\textbf{No discriminación entre socios}: nación más favorecida (art. I)};
  \node[it={gPri}{4.5cm}, below=0.12cm of p1] (p2) {\textbf{Arancel como única protección}: consolidación (art. II) y prohibición de restricciones cuantitativas (art. XI)};
  \node[it={gPri}{4.5cm}, below=0.12cm of p2] (p3) {\textbf{No discriminación interna}: trato nacional (art. III)};
  \node[it={gPri}{4.5cm}, below=0.12cm of p3] (p4) {\textbf{Libertad de tránsito} (art. V)};
  % Excepciones
  \node[cab={gExc}{5.1cm}] (x) at (9.55,0) {Excepciones\\(cuándo puede incumplirse)};
  \node[it={gExc}{5.0cm}, below=0.15cm of x] (x1) {\textbf{Generales} (art. XX): salud, recursos naturales, moral pública\ldots, sin discriminación arbitraria};
  \node[it={gExc}{5.0cm}, below=0.12cm of x1] (x2) {\textbf{Seguridad} (art. XXI) $\cdot$ \textbf{balanza de pagos} (arts. XII y XVIII:B) $\cdot$ \textbf{escasez} (art. XI:2)};
  \node[it={gExc}{5.0cm}, below=0.12cm of x2] (x3) {\textbf{Defensa comercial}: antidumping y compensatorios (art. VI), salvaguardias (art. XIX)};
  \node[it={gExc}{5.0cm}, below=0.12cm of x3] (x4) {\textbf{Integración regional} (art. XXIV) $\cdot$ \textbf{exenciones} (art. IX Acuerdo de Marrakech)};
  \node[it={gDes}{5.0cm}, below=0.12cm of x4] (x5) {\textbf{Desarrollo}: industria naciente (art. XVIII), Parte IV y cláusula de habilitación (1979)};
\end{tikzpicture}
