% Esquema de una página del bloque 2 (Acuerdos de mercancías), para el anexo «Material de estudio: Esquemas».
% Se lee de arriba abajo, en el orden del bloque: tipos de acuerdo -> el tronco (GATT: principios, excepciones,
% art. XXIV) -> las ramas (los cuatro grupos del anexo 1A) -> plurilaterales. Colores: los de las figuras del cuerpo
% (OMC_tipos_acuerdos y OMC_anexo1A). Tamaño: 16 cm de ancho y menos de 23 cm de alto; letra de 8 pt como mínimo.
% Generar con: bash Code/generar_figura.sh OMC_esquema_2
\definecolor{tMul}{RGB}{46,125,90}%
\definecolor{tPlu}{RGB}{40,90,150}%
\definecolor{aAdu}{RGB}{40,90,150}%
\definecolor{aNTB}{RGB}{46,125,90}%
\definecolor{aDef}{RGB}{190,60,50}%
\definecolor{aOtr}{RGB}{110,110,110}%
\definecolor{gTr}{RGB}{60,60,60}%
\begin{tikzpicture}[font=\footnotesize,
    every node/.append style={execute at begin node={\hyphenpenalty=10000}},
    sec/.style={font=\small\bfseries, text=aOtr, anchor=south west, inner sep=0pt},
    cab/.style 2 args={fill=#1, text=white, font=\small\bfseries, align=center, text width=#2, inner sep=3pt, rounded corners=2pt, anchor=north},
    it/.style 2 args={draw=#1, fill=#1!8, line width=0.5pt, rounded corners=2pt, align=left, text width=#2, inner sep=3pt},
    clave/.style 2 args={draw=#1, fill=white, line width=1.1pt, rounded corners=2pt, align=left, text width=#2, inner sep=3pt},
    flecha/.style={-{Latex[length=1.6mm]}, line width=0.6pt, black!60}]

  % ===================== 1. Tipos de acuerdo =====================
  \node[sec] at (0,0) {¿Qué tipos de acuerdo hay? De más a menos obligados};
  \node[it={tMul}{3.62cm}, anchor=north, minimum height=1.3cm] (t1) at (1.925,-0.2) {\textbf{Multilaterales} (anexos 1 a 3): todo único; obligan a todos};
  \node[it={tPlu}{3.62cm}, anchor=north, minimum height=1.3cm] (t2) at (5.975,-0.2) {\textbf{Masa crítica}: los negocia un grupo, pero la NMF los extiende a todos};
  \node[it={tPlu}{3.62cm}, anchor=north, minimum height=1.3cm] (t3) at (10.025,-0.2) {\textbf{Plurilaterales} (anexo 4): solo obligan a quien los acepta};
  \node[it={aOtr}{3.62cm}, anchor=north, minimum height=1.3cm] (t4) at (14.075,-0.2) {\textbf{Fuera de la OMC}: acuerdos regionales y bilaterales, con las condiciones del art. XXIV};
  \draw[{Latex[length=1.8mm]}-{Latex[length=1.8mm]}, line width=0.6pt, black!50] ([yshift=-0.2cm]t1.south west) -- ([yshift=-0.2cm]t4.south east);
  \node[anchor=north west, font=\footnotesize\itshape, text=aOtr, inner sep=2pt] at ([yshift=-0.25cm]t1.south west) {obligan a todos};
  \node[anchor=north east, font=\footnotesize\itshape, text=aOtr, inner sep=2pt] at ([yshift=-0.25cm]t4.south east) {fuera del sistema multilateral};

  % ===================== 2. El tronco: GATT de 1994 =====================
  \node[sec] at (0,-2.65) {El tronco: GATT de 1994, una regla general con excepciones tasadas};
  \node[cab={gTr}{15.79cm}, anchor=north west] (g) at (0,-2.85) {El arancel consolidado y no discriminatorio, única forma legítima de protección};
  \node[it={gTr}{4.95cm}, anchor=north west, minimum height=3.85cm] (g1) at ([yshift=-0.2cm]g.south west) {\textbf{Principios}\\[1pt]
    \textbf{NMF} (art. I): lo que se da a uno, se da a todos\\
    \textbf{Consolidación} (art. II): arancel máximo; por debajo, agua arancelaria\\
    \textbf{Trato nacional} (art. III): tras la aduana, como un producto nacional\\
    \textbf{Libre tránsito} (art. V)\\
    \textbf{Sin restricciones cuantitativas} (art. XI): arancel sí, cupo no};
  \node[it={gTr}{4.95cm}, anchor=north, minimum height=3.85cm] (g2) at ([yshift=-0.2cm]g.south) {\textbf{Excepciones}\\[1pt]
    \textbf{Generales} (art. XX): moral, salud, recursos agotables; sin discriminación arbitraria ni restricción encubierta\\
    \textbf{Seguridad} (art. XXI)\\
    \textbf{Balanza de pagos} (arts. XII y XVIII:B) y \textbf{crisis alimentarias} (art. XI:2)\\
    \textbf{Defensa comercial} (arts. VI y XIX)\\
    \textbf{Exenciones}: tres cuartos de los miembros\\
    \textbf{Desarrollo}: cláusula de habilitación (1979)};
  \node[it={gTr}{4.95cm}, anchor=north east, minimum height=3.85cm] (g3) at ([yshift=-0.2cm]g.south east) {\textbf{Integración regional} (art. XXIV)\\[1pt]
    Uniones aduaneras y zonas de libre comercio, si:\\
    $\cdot$ cubren sustancialmente todo el comercio\\
    $\cdot$ no elevan la protección frente a terceros\\
    Entre países en desarrollo: cláusula de habilitación\\
    Control laxo $\to$ \textit{spaghetti bowl}};

  % ===================== 3. Las ramas: anexo 1A =====================
  \node[sec] (sR) at ([yshift=-0.45cm]g1.south west) {Las ramas: catorce acuerdos del anexo 1A (si chocan con el GATT, prevalecen)};
  \node[cab={aAdu}{3.64cm}] (hA) at ([yshift=-0.95cm]sR.north -| 1.925,0) {Aduana\\{\footnotesize\mdseries\itshape ¿cómo se cruza la frontera?}};
  \node[cab={aNTB}{3.64cm}] (hB) at (hA.north -| 5.975,0) {Barreras no arancelarias\\{\footnotesize\mdseries\itshape ¿cuándo protege una norma?}};
  \node[cab={aDef}{3.64cm}] (hC) at (hA.north -| 10.025,0) {Defensa comercial\\{\footnotesize\mdseries\itshape ¿cuándo superar lo consolidado?}};
  \node[cab={aOtr}{3.64cm}] (hD) at (hA.north -| 14.075,0) {Otras materias\\{\footnotesize\mdseries\itshape lo que había quedado fuera}};
  \foreach \h in {hA,hB,hC,hD} \draw[flecha] ([yshift=-0.08cm]\h.north |- sR.south) -- (\h.north);

  % --- Aduana ---
  \node[it={aAdu}{3.62cm}, below=0.2cm of hA] (a1) {\textbf{Origen}: ¿de dónde es?};
  \node[it={aAdu}{3.62cm}, below=0.12cm of a1] (a2) {\textbf{Licencias}: ¿puede entrar? Sin discriminar};
  \node[it={aAdu}{3.62cm}, below=0.12cm of a2] (a3) {\textbf{Valoración} (art. VII): ¿cuánto vale? El valor de transacción};
  \node[it={aAdu}{3.62cm}, below=0.12cm of a3] (a4) {\textbf{Inspección previa}: transparente, rápida y no discriminatoria};
  \node[it={aAdu}{3.62cm}, below=0.12cm of a4] (a5) {\textbf{Facilitación} (Bali, 2013): menos trámites; mejor empeño y plazos a elegir por los PED};
  \node[clave={aAdu}{3.62cm}, below=0.12cm of a5] (a6) {$\Rightarrow$ Un arancel bajo pierde su efecto si la aduana es lenta, cara o arbitraria};

  % --- Barreras no arancelarias ---
  \node[it={aNTB}{3.62cm}, below=0.2cm of hB] (b1) {\textbf{No armonizan}: cada país fija su nivel de protección, con fundamento legítimo y sin restringir más de lo necesario (arts. III y XX)};
  \node[it={aNTB}{3.62cm}, below=0.12cm of b1] (b2) {\textbf{SPS}: alimentos, animales y vegetales; base científica; equivalencia y regionalización};
  \node[it={aNTB}{3.62cm}, below=0.12cm of b2] (b3) {\textbf{TBT}: resto de reglamentos y normas; necesidad y no discriminación; normas internacionales};
  \node[clave={aNTB}{3.62cm}, below=0.12cm of b3] (b4) {$\Rightarrow$ Al bajar los aranceles, la protección se desplaza a la regulación};

  % --- Defensa comercial ---
  \node[it={aDef}{3.62cm}, below=0.2cm of hC] (c1) {\textit{Contra el comercio desleal}, sin coste:\\\textbf{Antidumping} (art. VI): una empresa vende por debajo del valor normal y causa daño};
  \node[it={aDef}{3.62cm}, below=0.12cm of c1] (c2) {\textbf{Subvenciones}: contribución pública que da un beneficio específico; prohibidas o recurribles $\to$ OSD o derechos compensatorios};
  \node[it={aDef}{3.62cm}, below=0.12cm of c2] (c3) {\textit{Contra el comercio leal}, compensando:\\\textbf{Salvaguardias} (art. XIX): aumento súbito y perjuicio grave; a todos y temporales};
  \node[clave={aDef}{3.62cm}, below=0.12cm of c3] (c4) {$\Rightarrow$ El antidumping, el más usado: protección selectiva};

  % --- Otras materias ---
  \node[it={aOtr}{3.62cm}, below=0.2cm of hD] (d1) {\textbf{TRIMs}: sin requisitos de contenido local ni de equilibrio comercial (arts. III y XI)};
  \node[it={aOtr}{3.62cm}, below=0.12cm of d1] (d2) {\textbf{Agricultura}, tres pilares: acceso (arancelización), ayuda interna y subvenciones a la exportación};
  \node[it={aOtr}{3.62cm}, below=0.12cm of d2, dashed] (d3) {\textbf{Textiles}: cuotas hasta 2005 $\to$ la producción se concentra en China};
  \node[it={aOtr}{3.62cm}, below=0.12cm of d3] (d4) {\textbf{Pesca} (2025): prohíbe subvenciones; protege el recurso, no al competidor};

  % ===================== 4. Plurilaterales =====================
  \path let \p1=(a6.south), \p2=(b4.south), \p3=(c4.south), \p4=(d4.south), \n1={min(\y1,\y2,\y3,\y4)} in coordinate (fondo) at (0,\n1-0.5cm);
  \node[sec] (sP) at (fondo) {Plurilaterales: avanzar sin todos (las nuevas iniciativas, en el Tema 3.B.34)};
  \node[it={tPlu}{7.67cm}, anchor=north west, minimum height=1.9cm] (p1) at ([yshift=-0.2cm]sP.south west) {\textbf{Aeronaves civiles} (anexo 4, 1980): pocos fabricantes $\to$ política comercial estratégica (Airbus frente a Boeing). El conflicto se litigó con el Acuerdo de Subvenciones y acabó en retorsiones y una tregua $\Rightarrow$ el acuerdo fue irrelevante; hoy el reto es China};
  \node[it={tPlu}{7.67cm}, anchor=north east, minimum height=1.9cm] (p2) at ([yshift=-0.2cm]sP.south west -| 16,0) {\textbf{Masa crítica} (ITA, farmacéuticos, químicos): todos se benefician por la NMF. Problemas: delimitar los productos (\textit{ex outs}) y los \textit{free riders} $\Rightarrow$ hace falta casi todo el comercio del sector. Fracaso: bienes medioambientales (2016)};
\end{tikzpicture}%
