% Los tres Consejos especializados del Consejo General y sus órganos subsidiarios (organigrama de la OMC). Elaboración propia.
\definecolor{cAdm}{RGB}{46,125,90}
\begin{tikzpicture}[font=\footnotesize,
    every node/.append style={execute at begin node={\hyphenpenalty=10000}},
    cab/.style={fill=cAdm, text=white, font=\footnotesize\bfseries, align=center, text width=4.7cm, inner sep=3pt, minimum height=1.25cm},
    lista/.style={draw=cAdm!50, fill=cAdm!5, align=left, text width=4.7cm, inner sep=3pt, minimum height=#1},
    flecha/.style={-{Latex[length=1.6mm]}, line width=0.5pt, black!60}]
  \node[draw=black!70, fill=black!6, line width=0.6pt, rounded corners=2pt, align=center, text width=6.0cm, inner sep=3pt] (cg) at (5.25,0) {\textbf{Consejo General}};
  \node[cab, anchor=north] (m) at (0,-1.0) {Consejo del Comercio\\de Mercancías\\\normalfont\footnotesize (anexo 1A)};
  \node[cab, anchor=north] (s) at (5.25,-1.0) {Consejo del Comercio\\de Servicios\\\normalfont\footnotesize (AGCS, anexo 1B)};
  \node[cab, anchor=north] (a) at (10.5,-1.0) {Consejo de los ADPIC\\\normalfont\footnotesize (anexo 1C)};
  \foreach \c in {m,s,a} \draw[flecha] (cg.south) -- (\c.north);
  \node[lista=4.1cm, anchor=north] at (0,-2.4) {\textbf{Comités}: Acceso a los Mercados $\cdot$ Agricultura $\cdot$ Medidas Sanitarias y Fitosanitarias $\cdot$ Obstáculos Técnicos al Comercio $\cdot$ Subvenciones y Medidas Compensatorias $\cdot$ Prácticas Antidumping $\cdot$ Salvaguardias $\cdot$ Valoración en Aduana $\cdot$ Normas de Origen $\cdot$ Licencias de Importación $\cdot$ MIC $\cdot$ Facilitación del Comercio $\cdot$ Participantes en el ITA\\[2pt]\textbf{Grupo de trabajo}: Empresas Comerciales del Estado};
  \node[lista=4.1cm, anchor=north] at (5.25,-2.4) {\textbf{Comités}: Comercio de Servicios Financieros $\cdot$ Compromisos Específicos\\[2pt]\textbf{Grupos de trabajo}: Reglamentación Nacional $\cdot$ Normas del AGCS};
  \node[lista=4.1cm, anchor=north] at (10.5,-2.4) {Sin órganos subsidiarios: el propio Consejo examina las legislaciones notificadas y la aplicación del Acuerdo};
  \node[draw=black!40, fill=black!3, rounded corners=2pt, align=left, text width=14.95cm, inner sep=3pt, anchor=north] at (5.25,-6.7) {\textbf{Dependen directamente del Consejo General}: Comités de Comercio y Desarrollo, de Comercio y Medio Ambiente, de Acuerdos Comerciales Regionales, de Restricciones por Balanza de Pagos y de Asuntos Presupuestarios $\cdot$ grupos de trabajo sobre las adhesiones $\cdot$ Comité de Negociaciones Comerciales (Ronda Doha) $\cdot$ comités de los acuerdos plurilaterales (Aeronaves Civiles y Contratación Pública)};
\end{tikzpicture}
