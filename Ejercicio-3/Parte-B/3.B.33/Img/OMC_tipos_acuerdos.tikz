% Clasificación de los acuerdos comerciales respecto de la OMC. Elaboración propia a partir del Acuerdo de Marrakech.
\definecolor{tMul}{RGB}{46,125,90}
\definecolor{tPlu}{RGB}{40,90,150}
\definecolor{tFue}{RGB}{110,110,110}
\begin{tikzpicture}[font=\scriptsize,
    every node/.append style={execute at begin node={\hyphenpenalty=10000}},
    cab/.style 2 args={fill=#1, text=white, font=\footnotesize\bfseries, align=center, text width=#2, inner sep=3pt, rounded corners=2pt},
    it/.style 2 args={draw=#1, fill=#1!10, line width=0.5pt, rounded corners=1.5pt, align=left, text width=#2, inner sep=2.5pt},
    marca/.style={font=\scriptsize\bfseries, text=tMul}]
  % Columna 1: multilaterales
  \node[cab={tMul}{4.3cm}] (m) at (0,0) {Multilaterales\\(anexos 1 a 3: obligan a todos)};
  \node[it={tMul}{4.2cm}, below=0.15cm of m] (m1) {\textbf{Anexo 1A}: mercancías\\GATT de 1994 + $13$ acuerdos específicos en vigor \hfill $\leftarrow$ \textbf{este bloque}};
  \node[it={tMul}{4.2cm}, below=0.12cm of m1] (m2) {\textbf{Anexo 1B}: servicios (GATS)\\\textbf{Anexo 1C}: propiedad intelectual (ADPIC) \hfill $\to$ Tema 3.B.34};
  \node[it={tMul}{4.2cm}, below=0.12cm of m2] (m3) {\textbf{Anexo 2}: solución de diferencias\\\textbf{Anexo 3}: examen de políticas \hfill $\to$ bloque 1};
  % Columna 2: plurilaterales
  \node[cab={tPlu}{4.3cm}] (p) at (4.75,0) {Plurilaterales en la OMC\\(solo una parte de los miembros)};
  \node[it={tPlu}{4.2cm}, below=0.15cm of p] (p1) {\textbf{Anexo 4}: obligan solo a sus firmantes, sin extensión NMF\\aeronaves civiles $\cdot$ contratación pública};
  \node[it={tPlu}{4.2cm}, below=0.12cm of p1] (p2) {\textbf{Masa crítica}: concesiones en las listas, extendidas a todos por la NMF\\ITA $\cdot$ productos farmacéuticos $\cdot$ productos químicos};
  \node[it={tPlu}{4.2cm}, below=0.12cm of p2] (p3) {\textbf{Iniciativas conjuntas} (desde 2017)\\comercio electrónico $\cdot$ inversiones $\cdot$ servicios \hfill $\to$ Tema 3.B.34};
  % Columna 3: fuera de la OMC
  \node[cab={tFue}{4.3cm}] (f) at (9.5,0) {Fuera de la OMC\\(negociados en otros foros)};
  \node[it={tFue}{4.2cm}, below=0.15cm of f] (f1) {\textbf{Con condiciones de la OMC}\\uniones aduaneras y ALC (art. XXIV GATT, art. V GATS, cláusula de habilitación) $\cdot$ SPG (cláusula de habilitación)};
  \node[it={tFue}{4.2cm}, below=0.12cm of f1] (f2) {\textbf{Sin normas de la OMC}\\Consenso OCDE sobre crédito a la exportación $\cdot$ acuerdos de protección de inversiones (APPRI)};
  % Flecha de grado de obligación
  \draw[{Latex[length=2mm]}-{Latex[length=2mm]}, line width=0.6pt, black!60] (-2.15,-4.2) -- (11.65,-4.2);
  \node[anchor=north west, font=\scriptsize\itshape, black!70] at (-2.15,-4.27) {obligación para todos los miembros};
  \node[anchor=north east, font=\scriptsize\itshape, black!70] at (11.65,-4.27) {fuera del sistema multilateral};
\end{tikzpicture}
