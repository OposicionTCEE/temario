% La crisis en los tres pilares de la OMC: función, síntoma, causa y respuesta. Elaboración propia.
\definecolor{cNeg}{RGB}{40,90,150}
\definecolor{cAdm}{RGB}{46,125,90}
\definecolor{cJur}{RGB}{190,60,50}
\definecolor{cFon}{RGB}{110,110,110}
\begin{tikzpicture}[font=\scriptsize,
    every node/.append style={execute at begin node={\hyphenpenalty=10000}},
    fila/.style={fill=black!8, align=left, text width=1.3cm, inner sep=3pt, font=\scriptsize\bfseries, minimum height=#1},
    cel/.style 2 args={draw=#1!50, fill=#1!5, align=left, text width=3.7cm, inner sep=3pt, minimum height=#2},
    cab/.style={fill=#1, text=white, font=\footnotesize\bfseries, align=center, text width=3.7cm, inner sep=3pt, minimum height=0.75cm}]
  \node[cab=cNeg] at (2.08,0) {Pilar negociador};
  \node[cab=cAdm] at (6.13,0) {Pilar administrativo y de vigilancia};
  \node[cab=cJur] at (10.18,0) {Pilar jurisdiccional};
  \newcommand{\fila}[6]{%
    \node[fila=#2, anchor=north west] at (-1.4,#1) {#3};
    \node[cel={cNeg}{#2}, anchor=north west] at (0.1,#1) {#4};
    \node[cel={cAdm}{#2}, anchor=north west] at (4.15,#1) {#5};
    \node[cel={cJur}{#2}, anchor=north west] at (8.2,#1) {#6};}
  \fila{-0.42}{0.75cm}{Función}{Crear normas nuevas}{Aplicar y vigilar los acuerdos}{Resolver las diferencias}
  \fila{-1.22}{1.15cm}{Estado}{\textbf{Bloqueado}: la Ronda Doha (2001) no ha concluido; solo acuerdos sueltos (Facilitación del Comercio, 2013; pesca, 2022)}{\textbf{Funciona, pero pierde utilidad}: foro más dialéctico que práctico; notificaciones incompletas}{\textbf{Paralizado en apelación}: el Órgano de Apelación no resuelve desde el 11/12/2019}
  \fila{-2.42}{1.15cm}{Causa}{Consenso y todo único; poder de bloqueo de las coaliciones; intereses muy dispares}{Normas obsoletas, sin acuerdos nuevos ni informes de apelación que las actualicen}{EE.UU. denuncia la extralimitación judicial y bloquea los nombramientos}
  \fila{-3.62}{0.95cm}{Respuesta}{Vía plurilateral: comercio electrónico, inversión, servicios}{Propuestas de reforma de la transparencia, sin acuerdo}{MPIA: arbitraje de apelación entre $61$ miembros}
  \node[draw=cFon, fill=cFon!8, rounded corners=2pt, align=center, text width=13.25cm, inner sep=3pt, anchor=north west] at (-1.4,-4.72) {\textbf{Causas de fondo}: miembros muy heterogéneos $\cdot$ China y el capitalismo de Estado $\cdot$ rivalidad geopolítica $\cdot$ descontento social con la globalización};
\end{tikzpicture}
