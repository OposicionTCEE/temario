% Fin de las cuotas textiles: (a) cuota de China y México en las importaciones de ropa de EE.UU. (MARTIN, 2007); (b) respuestas de la Unión y de EE.UU., 2005-2008. Elaboración propia.
\definecolor{xChi}{RGB}{190,60,50}
\definecolor{xMex}{RGB}{40,90,150}
\definecolor{xOtr}{RGB}{110,110,110}
\begin{tikzpicture}[font=\footnotesize,
    every node/.append style={execute at begin node={\hyphenpenalty=10000}},
    hito/.style={draw=#1!60, fill=#1!6, align=left, text width=4.0cm, inner sep=3pt, anchor=west}]
  % (a) Cuotas de mercado
  \begin{axis}[at={(0,0)}, anchor=north west, width=6.3cm, height=5.4cm,
      ybar, bar width=9pt, ymin=0, ymax=34, ytick={0,10,20,30},
      symbolic x coords={2004,2005,2006}, xtick=data, enlarge x limits=0.25,
      ylabel={\% de las importaciones}, ylabel style={font=\footnotesize},
      tick label style={font=\footnotesize}, axis lines*=left,
      nodes near coords, nodes near coords style={font=\footnotesize, /pgf/number format/use comma},
      /pgf/number format/use comma,
      area legend, legend style={font=\footnotesize, draw=none, at={(0.02,0.98)}, anchor=north west, legend columns=1},
      title={\textbf{(a)} Importaciones de ropa de EE.UU.}, title style={font=\footnotesize, align=center}]
    \addplot[fill=xChi, draw=xChi] coordinates {(2004,18.1) (2005,25.7) (2006,29.1)};
    \addplot[fill=xMex, draw=xMex] coordinates {(2004,10.1) (2005,8.7) (2006,7.4)};
    \legend{China, México}
  \end{axis}
  % (b) Respuestas
  \node[font=\footnotesize\bfseries, anchor=north west] at (6.6,0.62) {(b) Respuestas, 2005-2008};
  \draw[xOtr, line width=0.8pt] (7.0,-0.6) -- (7.0,-5.0);
  \foreach \y in {-0.95,-1.95,-2.95,-3.85,-4.7} \fill[xOtr] (7.0,\y) circle (2pt);
  \node[font=\footnotesize, anchor=west, text width=1.9cm] at (7.15,-0.95) {\textbf{1 ene. 2005}};
  \node[hito=xOtr, text width=6.3cm] at (9.0,-0.95) {Fin de las cuotas: se integra el $49\%$ restante del comercio};
  \node[font=\footnotesize, anchor=west, text width=1.9cm] at (7.15,-1.95) {\textbf{Jun. 2005}};
  \node[hito=xMex, text width=6.3cm] at (9.0,-1.95) {\textbf{Unión}: memorando con China; límites a $10$ categorías hasta finales de 2007};
  \node[font=\footnotesize, anchor=west, text width=1.9cm] at (7.15,-2.95) {\textbf{Jul.-sep. 2005}};
  \node[hito=xMex, text width=6.3cm] at (9.0,-2.95) {«Guerra de los sujetadores»: mercancías retenidas en aduana; se renegocia en septiembre};
  \node[font=\footnotesize, anchor=west, text width=1.9cm] at (7.15,-3.85) {\textbf{Nov. 2005}};
  \node[hito=xChi, text width=6.3cm] at (9.0,-3.85) {\textbf{EE.UU.}: memorando con China; crecimiento limitado al $10$-$15\%$ anual en 2006-2008};
  \node[font=\footnotesize, anchor=west, text width=1.9cm] at (7.15,-4.7) {\textbf{Fin 2008}};
  \node[hito=xOtr, text width=6.3cm] at (9.0,-4.7) {Expira la salvaguardia textil de la adhesión de China};
\end{tikzpicture}
