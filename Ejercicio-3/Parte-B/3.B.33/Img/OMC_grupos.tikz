% Coaliciones negociadoras en la OMC por tipo. Miembros según OMC, «Groups in the WTO» (18/12/2017). Elaboración propia.
\definecolor{gId}{RGB}{215,150,20}
\definecolor{gAgr}{RGB}{46,125,90}
\definecolor{gInd}{RGB}{40,90,150}
\definecolor{gPod}{RGB}{110,110,110}
\begin{tikzpicture}[font=\scriptsize,
    every node/.append style={execute at begin node={\hyphenpenalty=10000}},
    cab/.style={fill=#1, text=white, font=\footnotesize\bfseries, align=center, text width=3.55cm, minimum height=0.85cm, rounded corners=2pt},
    g/.style={draw=#1, fill=#1!10, line width=0.5pt, rounded corners=1.5pt, align=left, text width=3.45cm, inner sep=2.5pt}]
  \newcommand{\col}[2]{\node[cab=#2] at (#1,0) {};}
  % Cabeceras
  \node[cab=gId]  (c1) at (0,0)    {Por identidad o nivel\\de desarrollo};
  \node[cab=gAgr] (c2) at (4.0,0)  {Por tema:\\agricultura};
  \node[cab=gInd] (c3) at (8.0,0)  {Por tema:\\industria y normas};
  \node[cab=gPod] (c4) at (12.0,0) {Grandes actores\\(núcleo informal)};
  % Columna 1
  \node[g=gId, below=0.2cm of c1] (a1) {\textbf{Grupo Africano} ($43$)\\todos los temas};
  \node[g=gId, below=0.12cm of a1] (a2) {\textbf{ACP} ($62$; desde 1975)\\preferencias en la Unión};
  \node[g=gId, below=0.12cm of a2] (a3) {\textbf{PMA} ($36$)\\lista de Naciones Unidas};
  \node[g=gId, below=0.12cm of a3] (a4) {\textbf{G-90} ($72$; 2003)\\Grupo Africano + ACP + PMA};
  \node[g=gId, below=0.12cm of a4] (a5) {\textbf{Economías pequeñas y vulnerables} ($26$)\\más flexibilidad};
  \node[g=gId, below=0.12cm of a5] (a6) {\textbf{Miembros de reciente adhesión} ($22$)\\menos compromisos nuevos};
  % Columna 2
  \node[g=gAgr, below=0.2cm of c2] (b1) {\textbf{Grupo de Cairns} ($19$; 1986)\\exportadores: liberalizar};
  \node[g=gAgr, below=0.12cm of b1] (b2) {\textbf{G-10} ($9$)\\importadores: preocupaciones no comerciales};
  \node[g=gAgr, below=0.12cm of b2] (b3) {\textbf{G-20} ($23$; 2003)\\PED: reformar la agricultura de los ricos};
  \node[g=gAgr, below=0.12cm of b3] (b4) {\textbf{G-33} ($47$; 2003)\\PED: proteger productos especiales};
  \node[g=gAgr, below=0.12cm of b4] (b5) {\textbf{Algodón-4} ($4$; 2003)\\fin de las subvenciones al algodón};
  % Columna 3
  \node[g=gInd, below=0.2cm of c3] (d1) {\textbf{NAMA-11} ($10$; 2005)\\PED: limitar la apertura industrial};
  \node[g=gInd, below=0.12cm of d1] (d2) {\textbf{Amigos de la Ambición} ($35$)\\maximizar la apertura industrial};
  \node[g=gInd, below=0.12cm of d2] (d3) {\textbf{Amigos del Antidumping} ($15$)\\más disciplina antidumping};
  \node[g=gInd, below=0.12cm of d3] (d4) {\textbf{Amigos del Pescado} ($11$)\\reducir subvenciones a la pesca};
  % Columna 4
  \node[g=gPod, below=0.2cm of c4] (e1) {\textbf{Quad} (GATT)\\EE.UU., CE, Japón, Canadá};
  \node[g=gPod, below=0.12cm of e1] (e2) {\textbf{FIPs} (2004)\\EE.UU., UE, Brasil, India, Australia};
  \node[g=gPod, below=0.12cm of e2] (e3) {\textbf{G-7} (julio de 2008)\\FIPs + China y Japón};
  \node[g=gPod, below=0.12cm of e3] (e4) {\textbf{«G-5»}\\EE.UU., UE, China, India, Brasil};
  % Eje inferior
  \draw[{Latex[length=2mm]}-{Latex[length=2mm]}, line width=0.6pt, black!60] (-1.8,-6.35) -- (9.8,-6.35);
  \node[anchor=north west, font=\scriptsize\itshape, black!70] at (-1.8,-6.45) {estables, pero de posiciones genéricas};
  \node[anchor=north east, font=\scriptsize\itshape, black!70] at (9.8,-6.45) {eficaces, pero frágiles};
  \draw[-{Latex[length=2mm]}, line width=0.6pt, black!60] (10.3,-6.35) -- (13.8,-6.35);
  \node[anchor=north east, font=\scriptsize\itshape, black!70, align=right] at (13.8,-6.45) {del Quad a los emergentes};
\end{tikzpicture}
