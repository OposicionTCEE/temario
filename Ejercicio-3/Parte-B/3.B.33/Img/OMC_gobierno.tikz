% Gobierno de la OMC: Conferencia Ministerial frente a Consejo General (arts. IV, VI, IX y XII del Acuerdo de Marrakech). Elaboración propia.
\definecolor{gAdm}{RGB}{46,125,90}
\begin{tikzpicture}[font=\footnotesize,
    every node/.append style={execute at begin node={\hyphenpenalty=10000}},
    cab/.style={fill=gAdm, text=white, font=\footnotesize\bfseries, align=center, text width=6.2cm, inner sep=3pt, minimum height=0.9cm},
    fila/.style={fill=black!8, align=left, text width=1.9cm, inner sep=3pt, font=\footnotesize\bfseries, minimum height=#1},
    cel/.style={draw=gAdm!50, fill=gAdm!5, align=left, text width=6.2cm, inner sep=3pt, minimum height=#1}]
  \node[cab, anchor=north west] at (2.3,0) {Conferencia Ministerial\\\normalfont\footnotesize (art. IV.1)};
  \node[cab, anchor=north west] at (9.0,0) {Consejo General\\\normalfont\footnotesize (art. IV.2)};
  \newcommand{\fila}[5]{%
    \node[fila=#2, anchor=north west] at (0,#1) {#3};
    \node[cel=#2, anchor=north west] at (2.3,#1) {#4};
    \node[cel=#2, anchor=north west] at (9.0,#1) {#5};}
  \fila{-1.0}{0.85cm}{Quién se sienta}{Los ministros de comercio de todos los miembros}{Los embajadores o jefes de delegación de todos los miembros, en Ginebra}
  \fila{-1.95}{0.85cm}{Cuándo se reúne}{Al menos cada dos años: $14$ conferencias entre 1996 y 2026}{Varias veces al año, de forma continua}
  \fila{-2.9}{1.65cm}{Qué decide}{Cualquier asunto de los acuerdos multilaterales. Aporta el impulso político: lanza rondas y cierra paquetes (Doha, 2001; Bali, 2013; subvenciones a la pesca, 2022)}{Lo mismo, en los intervalos entre conferencias: enmiendas (ADPIC, 2005; Facilitación del Comercio, 2014), adhesiones, exenciones y nombramiento del Director General (2021)}
  \fila{-4.65}{1.25cm}{Otras funciones}{Ninguna: es el órgano supremo}{Se reúne también como Órgano de Solución de Diferencias y como Órgano de Examen de las Políticas Comerciales}
  \fila{-6.0}{1.25cm}{Qué depende de él}{El Consejo General y, a través de él, el resto de la estructura}{Los tres Consejos (Mercancías, Servicios y ADPIC), los comités, los grupos de trabajo y el Comité de Negociaciones Comerciales}
  \node[draw=black!40, fill=black!3, rounded corners=2pt, align=center, text width=15.0cm, inner sep=3pt, anchor=north west] at (0,-7.4) {\textbf{En los dos}: un asiento por miembro (Estados, territorios aduaneros y la Unión) $\cdot$ decisión por consenso: el voto que prevé el art. IX no se utiliza};
\end{tikzpicture}
