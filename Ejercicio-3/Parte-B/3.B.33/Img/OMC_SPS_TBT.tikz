% Comparación de los Acuerdos SPS y TBT. Elaboración propia.
\definecolor{sNTB}{RGB}{46,125,90}
\definecolor{sDes}{RGB}{215,150,20}
\begin{tikzpicture}[font=\scriptsize,
    every node/.append style={execute at begin node={\hyphenpenalty=10000}},
    fila/.style={fill=black!8, align=left, text width=1.3cm, inner sep=3pt, font=\scriptsize\bfseries, minimum height=#1},
    cel/.style={draw=sNTB!60, fill=sNTB!6, align=left, text width=5.6cm, inner sep=3pt, minimum height=#1},
    cab/.style={fill=sNTB, text=white, font=\footnotesize\bfseries, align=center, text width=5.6cm, inner sep=3pt}]
  \node[cab] (h1) at (3.05,0) {Medidas sanitarias y fitosanitarias (SPS)};
  \node[cab] (h2) at (9.0,0) {Obstáculos técnicos al comercio (TBT)};
  \newcommand{\fila}[5]{%
    \node[fila=#2, anchor=north west] at (-1.4,#1) {#3};
    \node[cel=#2, anchor=north west] at (0.1,#1) {#4};
    \node[cel=#2, anchor=north west] at (6.05,#1) {#5};}
  \fila{-0.35}{0.75cm}{Ámbito}{Inocuidad de los alimentos y salud de animales y plantas}{Reglamentos técnicos (obligatorios), normas (voluntarias) y evaluación de la conformidad de cualquier producto}
  \fila{-1.15}{0.75cm}{Origen}{Ronda Uruguay (1994)}{Código de Normas de la Ronda Tokio (1979), ampliado en la Ronda Uruguay}
  \fila{-1.95}{0.95cm}{Condición clave}{Basadas en principios científicos y en una evaluación del riesgo; sin discriminación arbitraria}{No discriminatorias y no más restrictivas del comercio de lo necesario para un objetivo legítimo}
  \fila{-2.95}{0.75cm}{Normas de referencia}{Codex Alimentarius, OMSA, CIPF}{Organismos internacionales de normalización (ISO, CEI\ldots)}
  \fila{-3.75}{0.95cm}{Flexibilidad}{Protección superior si hay justificación científica; medidas provisionales por precaución (art. $5.7$); equivalencia; regionalización}{Cualquier objetivo legítimo (salud, medio ambiente, seguridad, información al consumidor); reconocimiento mutuo}
  \fila{-4.75}{0.75cm}{Casos}{Hormonas (1998); productos biotecnológicos (2006)}{Cigarrillos de clavo, atún y delfines, etiquetado de origen (2012)}
  \node[draw=sDes, fill=sDes!12, rounded corners=2pt, align=center, text width=13.25cm, inner sep=3pt, anchor=north west] at (-1.4,-5.65) {\textbf{Desarrollo}: plazos de aplicación más largos y asistencia técnica en ambos acuerdos; Fondo para la Aplicación de Normas y el Fomento del Comercio (STDF) para las normas sanitarias y fitosanitarias};
\end{tikzpicture}
