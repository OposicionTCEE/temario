% El desarrollo en la OMC: reglas (trato especial y diferenciado) y capacidad (Ayuda para el Comercio). Elaboración propia.
\definecolor{dDes}{RGB}{215,150,20}
\definecolor{dCap}{RGB}{40,90,150}
\definecolor{dDeb}{RGB}{110,110,110}
\begin{tikzpicture}[font=\scriptsize,
    every node/.append style={execute at begin node={\hyphenpenalty=10000}},
    cab/.style 2 args={fill=#1, text=white, font=\footnotesize\bfseries, align=center, text width=#2, inner sep=3pt, rounded corners=2pt},
    it/.style 2 args={draw=#1, fill=#1!10, line width=0.5pt, rounded corners=1.5pt, align=left, text width=#2, inner sep=2.5pt},
    flecha/.style={-{Latex[length=1.5mm]}, line width=0.5pt, black!60}]
  % Reglas
  \node[cab={dDes}{5.6cm}] (r) at (0,0) {Reglas: trato especial y diferenciado\\(cláusulas en los acuerdos)};
  \node[it={dDes}{5.5cm}, below=0.15cm of r] (r1) {(i) más oportunidades comerciales (p. ej., preferencias)\\(ii) salvaguardia de sus intereses\\(iii) flexibilidad en compromisos e instrumentos\\(iv) periodos de transición más largos\\(v) asistencia técnica\\(vi) disposiciones específicas para los PMA};
  \node[it={dDes}{5.5cm}, below=0.12cm of r1, fill=white] (r2) {\textit{Límite}: muchas son cláusulas de «mejor empeño», sin fuerza vinculante};
  % Capacidad
  \node[cab={dCap}{8.0cm}] (c) at (7.6,0) {Capacidad: Ayuda para el Comercio (desde 2005)\\(la OMC moviliza y vigila; financian donantes y bancos)};
  \node[it={dCap}{3.75cm}, anchor=north west] (c1) at ([yshift=-0.15cm]c.south west) {\textbf{Marco Integrado Reforzado}\\$\to$ PMA: diagnóstico y proyectos};
  \node[it={dCap}{3.75cm}, below=0.12cm of c1] (c2) {\textbf{STDF}\\$\to$ normas sanitarias y fitosanitarias};
  \node[it={dCap}{3.75cm}, below=0.12cm of c2] (c3) {\textbf{Mecanismo del AFC}\\$\to$ aplicar la facilitación del comercio};
  \node[it={dCap}{3.75cm}, anchor=north east] (c4) at ([yshift=-0.15cm]c.south east) {\textbf{Centro de Comercio Internacional}\\$\to$ pymes y cadenas de valor};
  \node[it={dCap}{3.75cm}, below=0.12cm of c4] (c5) {\textbf{Formación de la OMC}\\$\to$ funcionarios y negociadores};
  \node[it={dCap}{3.75cm}, below=0.12cm of c5] (c6) {\textbf{Fondo para la Pesca}\\$\to$ aplicar el acuerdo de pesca};
  % Debate
  \node[draw=dDeb, fill=dDeb!8, rounded corners=2pt, align=center, text width=14.1cm, inner sep=3pt] (deb) at (3.8,-4.55) {\textbf{Debate: ¿quién es país en desarrollo?} Autodesignación $\to$ EE.UU. (2019): excluir a OCDE, G-20, renta alta y miembros con $\geq 0{,}5\%$ del comercio mundial $\to$ China (2025): no pedirá nuevo trato especial, sin renunciar a su condición};
  \draw[flecha] (r2.south) -- (r2.south |- deb.north);
\end{tikzpicture}
