% Otras materias del anexo 1A: de dónde vienen, qué establecen y cuál es su situación. Elaboración propia.
\definecolor{oOtr}{RGB}{110,110,110}
\begin{tikzpicture}[font=\footnotesize,
    every node/.append style={execute at begin node={\hyphenpenalty=10000}},
    cab/.style={fill=oOtr, text=white, font=\footnotesize\bfseries, align=center, text width=3.5cm, inner sep=3pt, minimum height=0.95cm},
    fila/.style={fill=black!8, align=left, text width=1.2cm, inner sep=3pt, font=\footnotesize\bfseries, minimum height=#1},
    cel/.style={draw=oOtr!60, fill=oOtr!6, align=left, text width=3.2cm, inner sep=3pt, minimum height=#1}]
  \foreach \x/\t in {1.6/{Medidas en materia de inversiones (TRIMs)}, 5.2/{Agricultura}, 8.8/{Textiles y vestido}, 12.4/{Subvenciones a la pesca}}
    \node[cab, anchor=north west, text width=3.2cm] at (\x,0) {\t};
  \newcommand{\fila}[7]{%
    \node[fila=#2, anchor=north west] at (0,#1) {#3};
    \node[cel=#2, anchor=north west] at (1.6,#1) {#4};
    \node[cel=#2, anchor=north west] at (5.2,#1) {#5};
    \node[cel=#2, anchor=north west] at (8.8,#1) {#6};
    \node[cel=#2, anchor=north west] at (12.4,#1) {#7};}
  \fila{-1.05}{1.25cm}{Antes}{Requisitos a la inversión extranjera sin disciplina expresa}{Exenciones (EE.UU., 1955) y excepciones de los arts. XI y XVI}{Acuerdo Multifibras (1974): contingentes bilaterales}{Ayudas que agotan los caladeros, sin disciplina específica}
  \fila{-2.4}{1.65cm}{Regla}{Prohíbe los requisitos contrarios a los arts. III y XI (lista ilustrativa)}{Tres pilares: acceso a los mercados, ayuda interna y competencia de las exportaciones}{Integración en el GATT en cuatro etapas (1995-2005)}{Prohíbe las ayudas a la pesca ilegal, a poblaciones sobreexplotadas y en alta mar no regulada}
  \fila{-4.15}{1.25cm}{Hoy}{En vigor; los periodos transitorios ya vencieron}{En vigor; su reforma sigue pendiente desde Doha}{Expiró el 1 de enero de 2005}{En vigor desde el 15 de septiembre de 2025}
\end{tikzpicture}
