% Eje cronológico: de la OIC a la OMC (1944-1995). Datos: OMC, «The GATT years: from Havana to Marrakesh».
\definecolor{ejeInst}{RGB}{46,125,90}
\definecolor{ejeRonda}{RGB}{40,90,150}
\definecolor{ejeFallo}{RGB}{190,60,50}
\begin{tikzpicture}[x=0.30cm, y=1cm, font=\footnotesize,
    hito/.style={circle, fill=#1, inner sep=1.6pt},
    txt/.style={align=center, text width=#1, inner sep=1pt},
    ronda/.style={fill=ejeRonda!25, draw=ejeRonda, line width=0.4pt, minimum height=0.28cm}]
  % Eje (x = año - 1944)
  \draw[-{Latex[length=2mm]}, line width=0.8pt] (0,0) -- (53,0);
  \foreach \a in {1945,1955,1965,1975,1985,1995}
    \draw (\a-1944,0.08) -- (\a-1944,-0.08) node[below=1pt, font=\scriptsize] {\a};
  % Hitos institucionales (arriba)
  \node[hito=ejeInst] at (0,0) {};
  \draw[ejeInst] (0,0) -- (0,2.75) node[above, txt=2.4cm] {\textbf{Bretton Woods} (1944)\\FMI y BM};
  \node[hito=ejeInst] at (3,0) {};
  \draw[ejeInst] (3,0) -- (3,2.2) -- (3.4,2.2) node[right, txt=3.4cm, align=left] {\textbf{1947:} GATT ($23$ partes)};
  \node[hito=ejeFallo] at (4,0) {};
  \draw[ejeFallo] (4,0) -- (4,1.5) -- (4.4,1.5) node[right, txt=3.4cm, align=left] {\textbf{1948:} Carta de La Habana (OIC)};
  \node[hito=ejeFallo] at (6,0) {};
  \draw[ejeFallo] (6,0) -- (6,0.7) -- (6.4,0.7) node[right, txt=3.0cm, align=left] {\textbf{1950:} EE.UU. renuncia\\a ratificar la OIC};
  \node[hito=ejeInst] at (21,0) {};
  \draw[ejeInst] (21,0) -- (21,1.25) node[above, txt=2.6cm] {\textbf{1965:} Parte IV\\(comercio y desarrollo)};
  \node[hito=ejeInst] at (35,0) {};
  \draw[ejeInst] (35,0) -- (35,0.95) node[above, txt=2.4cm] {\textbf{1979:} cláusula\\de habilitación};
  \node[hito=ejeInst] at (51,0) {};
  \draw[ejeInst] (51,0) -- (51,1.35) node[above, txt=1.9cm] {\textbf{OMC}\\1/1/1995};
  % Rondas (abajo)
  \fill[ejeRonda!25] (3,-0.89) rectangle (17,-0.61); \draw[ejeRonda] (3,-0.89) rectangle (17,-0.61);
  \foreach \a in {1947,1949,1951,1956,1960} \fill[ejeRonda] (\a-1944,-0.75) circle (1.3pt);
  \node[below, txt=4.4cm] at (10,-0.95) {\textbf{Cinco rondas arancelarias}\\Ginebra, Annecy, Torquay, Ginebra, Dillon\\($13$-$38$ países) · producto a producto};
  \fill[ejeRonda!25] (20,-0.89) rectangle (23,-0.61); \draw[ejeRonda] (20,-0.89) rectangle (23,-0.61);
  \node[below, txt=2.5cm] at (21.5,-0.95) {\textbf{Kennedy}\\1964-1967 · $62$\\recortes lineales\\antidumping};
  \fill[ejeRonda!25] (29,-0.89) rectangle (35,-0.61); \draw[ejeRonda] (29,-0.89) rectangle (35,-0.61);
  \node[below, txt=2.8cm] at (32,-0.95) {\textbf{Tokio}\\1973-1979 · $102$\\barreras no arancelarias\\(«códigos»)};
  \fill[ejeRonda!25] (42,-0.89) rectangle (50,-0.61); \draw[ejeRonda] (42,-0.89) rectangle (50,-0.61);
  \node[below, txt=3.2cm] at (46,-0.95) {\textbf{Uruguay}\\1986-1994 · $123$\\servicios, propiedad intelectual,\\agricultura, textiles,\\solución de diferencias};
\end{tikzpicture}
