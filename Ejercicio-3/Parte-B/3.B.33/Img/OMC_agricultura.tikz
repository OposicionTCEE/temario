% Acuerdo sobre la Agricultura: tres pilares, cajas de la ayuda interna y debates abiertos. Elaboración propia.
\definecolor{agP}{RGB}{46,125,90}
\definecolor{agAmb}{RGB}{215,150,20}
\definecolor{agAzu}{RGB}{40,90,150}
\definecolor{agVer}{RGB}{46,125,90}
\definecolor{agDeb}{RGB}{110,110,110}
\begin{tikzpicture}[font=\scriptsize,
    every node/.append style={execute at begin node={\hyphenpenalty=10000}},
    cab/.style={fill=agP, text=white, font=\footnotesize\bfseries, align=center, text width=4.2cm, inner sep=3pt, rounded corners=2pt, minimum height=0.8cm},
    it/.style 2 args={draw=#1, fill=#1!10, line width=0.5pt, rounded corners=1.5pt, align=left, text width=#2, inner sep=2.5pt}]
  \node[cab] (a) at (0,0) {Acceso a los mercados};
  \node[cab] (b) at (4.6,0) {Ayuda interna};
  \node[cab] (c) at (9.2,0) {Competencia de las exportaciones};
  % Acceso
  \node[it={agP}{4.1cm}, below=0.15cm of a] (a1) {\textbf{Arancelización}: toda barrera no arancelaria se convierte en arancel};
  \node[it={agP}{4.1cm}, below=0.1cm of a1] (a2) {\textbf{Reducción}: PD $-36\%$ en $6$ años (mín. $-15\%$ por línea); PED $-24\%$ en $10$; PMA exentos};
  \node[it={agP}{4.1cm}, below=0.1cm of a2] (a3) {\textbf{Contingentes} de acceso mínimo y \textbf{salvaguardia especial}};
  % Ayuda interna: cajas
  \node[it={agAmb}{4.1cm}, below=0.15cm of b] (b1) {\textbf{Caja ámbar} (distorsiona): MGA reducida $-20\%$ (PD) y $-13\%$ (PED)};
  \node[it={agAzu}{4.1cm}, below=0.1cm of b1] (b2) {\textbf{Caja azul}: pagos ligados a programas que limitan la producción};
  \node[it={agVer}{4.1cm}, below=0.1cm of b2] (b3) {\textbf{Caja verde} (no distorsiona): investigación, pagos desacoplados, medio ambiente; sin límite};
  \node[it={agDeb}{4.1cm}, below=0.1cm of b3] (b4) {\textbf{Exentas}: \textit{de minimis} ($5\%$ PD; $10\%$ PED) y caja de desarrollo (art. $6.2$)};
  % Exportaciones
  \node[it={agP}{4.1cm}, below=0.15cm of c] (c1) {\textbf{1995}: reducción de las subvenciones a la exportación (PD $-36\%$ en valor y $-21\%$ en volumen)};
  \node[it={agP}{4.1cm}, below=0.1cm of c1] (c2) {\textbf{Nairobi 2015}: eliminación, con disciplinas para créditos, empresas comerciales del Estado y ayuda alimentaria};
  % Debates
  \node[draw=agDeb, fill=agDeb!8, rounded corners=2pt, align=center, text width=13.5cm, inner sep=3pt] at (4.6,-4.5) {\textbf{Debates abiertos}: existencias públicas para la seguridad alimentaria (cláusula de paz, 2013-2014) $\cdot$ algodón (Cotton-4) $\cdot$ mecanismo de salvaguardia especial para los PED $\cdot$ reducción de la ayuda ámbar};
\end{tikzpicture}
