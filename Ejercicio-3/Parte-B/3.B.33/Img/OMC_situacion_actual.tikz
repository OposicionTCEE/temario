% Situación actual: (a) tipo arancelario efectivo medio de EE.UU. (Yale Budget Lab); (b) comercio mundial de bienes según su régimen (Okonjo-Iweala, 2026); (c) respuestas de los demás miembros. Elaboración propia.
\definecolor{sUS}{RGB}{190,60,50}
\definecolor{sNMF}{RGB}{40,90,150}
\definecolor{sACR}{RGB}{110,160,210}
\definecolor{sFue}{RGB}{200,200,200}
\definecolor{sVer}{RGB}{46,125,90}
\definecolor{sAmb}{RGB}{215,150,20}
\begin{tikzpicture}[font=\scriptsize,
    every node/.append style={execute at begin node={\hyphenpenalty=10000}}]
  % ---------- Panel (a): arancel medio de EE.UU. ----------
  \begin{scope}
    \node[font=\footnotesize\bfseries, anchor=west] at (-0.3,4.05) {(a) Arancel medio de EE.UU.};
    \begin{axis}[width=5.6cm, height=4.1cm, at={(0,-0.1)}, xmin=0.5, xmax=5.5, ymin=0, ymax=30,
        xtick={1,2,3,4,5}, xticklabels={ene.\\2025, abr.\\2025, ene.\\2026, abr.\\2026, sep.\\2026},
        xticklabel style={align=center, font=\tiny}, ytick={0,10,20,30}, yticklabel={$\pgfmathprintnumber{\tick}\%$},
        tick label style={font=\tiny}, axis lines=left, clip=false]
      \addplot[sUS, line width=1pt, mark=*, mark size=1.5pt] coordinates {(1,2.4) (2,25.3) (3,16.9) (4,11.0) (5,11.0)};
      \node[font=\tiny, sUS, anchor=west] at (axis cs:1.05,3.6) {$2,4\%$};
      \node[font=\tiny, sUS, anchor=south west, align=left] at (axis cs:2.05,25.6) {$25,3\%$: máximo\\desde 1909};
      \node[font=\tiny, sUS, anchor=north east] at (axis cs:2.95,16.4) {$16,9\%$};
      \node[font=\tiny, sUS, anchor=south] at (axis cs:4.5,11.6) {$11\%$};
      \draw[black!50, dashed] (axis cs:3.65,0) -- (axis cs:3.65,22);
      \node[font=\tiny, black!70, align=left, anchor=south west] at (axis cs:3.7,17.5) {Tribunal\\Supremo\\(20/2/2026)};
    \end{axis}
  \end{scope}
  % ---------- Panel (b): comercio según régimen ----------
  \begin{scope}[xshift=6.3cm]
    \node[font=\footnotesize\bfseries, anchor=west] at (-0.3,4.05) {(b) ¿Con qué reglas se comercia?};
    \fill[sNMF] (0.6,0) rectangle (1.5,2.16);
    \fill[sACR] (0.6,2.16) rectangle (1.5,2.64);
    \fill[sFue] (0.6,2.64) rectangle (1.5,3.0);
    \draw[black!60] (0.6,0) rectangle (1.5,3.0);
    \node[text=white, font=\scriptsize\bfseries] at (1.05,1.08) {$72\%$};
    \node[anchor=west, text width=2.5cm, align=left, text=sNMF] at (1.65,1.08) {\textbf{Nación más favorecida} (aranceles OMC)};
    \node[anchor=west, text width=2.5cm, align=left, text=sACR!70!black] at (1.65,2.45) {$16\%$: acuerdos preferenciales amparados por la OMC};
    \node[anchor=west, text width=2.5cm, align=left, text=black!60] at (1.65,3.4) {$12\%$: al margen de sus reglas};
    \draw[sNMF, dashed, line width=0.7pt] (0.45,2.4) -- (1.55,2.4);
    \draw[black!50] (1.5,2.82) -- (1.65,3.25);
    \node[anchor=east, font=\tiny, text=sNMF, align=right] at (0.45,2.4) {$\approx 80\%$\\a inicios\\de 2025};
    \node[font=\tiny, black!60] at (1.05,-0.25) {Comercio mundial de bienes, 2026};
  \end{scope}
  % ---------- Panel (c): respuestas ----------
  \begin{scope}[xshift=11.3cm]
    \node[font=\footnotesize\bfseries, anchor=west] at (-0.2,4.05) {(c) Respuestas de los demás};
    \tikzset{resp/.style={draw=#1, fill=#1!10, rounded corners=2pt, align=left, text width=4.2cm, inner sep=3pt, anchor=north west}}
    \node[resp=sUS] at (0,3.3) {\textbf{Represaliar}: China y Canadá responden con aranceles y demandas en la OMC (2025)};
    \node[resp=sAmb] at (0,2.15) {\textbf{Negociar bilateralmente}: Reino Unido, Japón, la UE\ldots\ aceptan techos del $10$-$15\%$ a cambio de concesiones};
    \node[resp=sVer] at (0,0.95) {\textbf{Coaliciones de voluntarios}: MPIA ($61$), comercio electrónico ($66$), FIT ($19$)};
  \end{scope}
\end{tikzpicture}
