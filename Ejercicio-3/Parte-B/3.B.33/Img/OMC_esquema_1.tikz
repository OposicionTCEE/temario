% Esquema de una página del bloque 1 (Marco jurídico-conceptual), para el anexo «Material de estudio: Esquemas».
% Se lee de arriba abajo, en el orden del bloque: origen -> identidad y misión -> tres pilares (y la carencia del GATT
% que corrige cada uno) -> desarrollo, eje transversal. Colores de los pilares: los de las figuras del cuerpo.
% Tamaño: 16 cm de ancho y menos de 22 cm de alto (cabe bajo el rótulo del anexo); letra de 8 pt como mínimo.
% Generar con: bash Code/generar_figura.sh OMC_esquema_1
\definecolor{pNeg}{RGB}{40,90,150}
\definecolor{pAdm}{RGB}{46,125,90}
\definecolor{pJur}{RGB}{190,60,50}
\definecolor{pDes}{RGB}{215,150,20}
\definecolor{pGri}{RGB}{110,110,110}
\begin{tikzpicture}[font=\footnotesize,
    every node/.append style={execute at begin node={\hyphenpenalty=10000}},
    sec/.style={font=\small\bfseries, text=pGri, anchor=south west, inner sep=0pt},
    hito/.style 2 args={draw=#1, fill=#1!8, line width=0.6pt, rounded corners=2pt, align=center, text width=#2, inner sep=3pt, minimum height=1.6cm, anchor=north},
    cab/.style 2 args={fill=#1, text=white, font=\small\bfseries, align=center, text width=#2, inner sep=3pt, rounded corners=2pt, anchor=north},
    it/.style 2 args={draw=#1, fill=#1!8, line width=0.5pt, rounded corners=2pt, align=left, text width=#2, inner sep=3pt},
    clave/.style 2 args={draw=#1, fill=white, line width=1.1pt, rounded corners=2pt, align=left, text width=#2, inner sep=3pt},
    eti/.style={font=\footnotesize\itshape, text=pGri, anchor=west, inner sep=2pt},
    flecha/.style={-{Latex[length=1.6mm]}, line width=0.6pt, black!60}]

  % ===================== 1. Origen: ¿cómo y por qué aparece? =====================
  \node[sec] at (0,0) {¿Cómo y por qué aparece?};
  \node[hito={pGri}{2.58cm}] (oic) at (1.41,-0.2) {\textbf{OIC} (La Habana, 1948)\\comercio, empleo, inversión\\{\color{pJur}$\times$} EE.UU. no la ratifica};
  \node[hito={pGri}{2.58cm}] (gatt) at (4.70,-0.2) {\textbf{GATT} (1947)\\tratado provisional\\ocho rondas: más países, más materias, más PED};
  \node[hito={pGri}{2.58cm}] (ago) at (7.99,-0.2) {\textbf{Agotamiento} (años 80)\\códigos «a la carta»; agricultura y textiles fuera; zona gris};
  \node[hito={pGri}{2.58cm}] (uru) at (11.28,-0.2) {\textbf{Ronda Uruguay}\\(1986-1994)\\todo único y nuevo sistema de diferencias};
  \node[hito={pGri}{2.58cm}, line width=1.1pt] (omc) at (14.57,-0.2) {\textbf{OMC} (1/1/1995)\\organización permanente con tribunal vinculante};
  \draw[flecha] (oic) -- (gatt); \draw[flecha] (gatt) -- (ago); \draw[flecha] (ago) -- (uru); \draw[flecha] (uru) -- (omc);
  \draw[flecha, dashed] (omc.south) -- ++(0,-0.3) -| (oic.south)
    node[pos=0.25, below, font=\footnotesize\itshape, text=pGri, inner sep=2pt] {recupera la ambición institucional de la OIC, no su contenido social (empleo, normas laborales)};

  % ===================== 2. Identidad y misión =====================
  \node[sec] at (0,-2.95) {Identidad y misión};
  \node[it={pGri}{3.57cm}, anchor=north, minimum height=1.25cm] (id1) at (1.9,-3.15) {\textbf{Organización internacional}: Ginebra, fuera de la ONU; $166$ miembros (basta ser territorio aduanero)};
  \node[it={pGri}{3.57cm}, anchor=north, minimum height=1.25cm] (id2) at (5.96,-3.15) {\textbf{Financiación}: cuotas según el peso en el comercio, con un suelo; sin ajuste por desarrollo};
  \node[it={pGri}{3.57cm}, anchor=north, minimum height=1.25cm] (id3) at (10.02,-3.15) {\textbf{Dirigida por los miembros}: la Directora General administra y media, no dirige};
  \node[it={pGri}{3.57cm}, anchor=north, minimum height=1.25cm, line width=1.1pt] (id4) at (14.08,-3.15) {\textbf{Misión}: el comercio como medio para elevar el nivel de vida y el empleo};

  % ===================== 3. Tres pilares =====================
  \node[sec] at (0,-4.9) {Tres pilares: funciones, no órganos (los mismos miembros, reunidos en el Consejo General)};
  \node[cab={pNeg}{4.99cm}] (hN) at (2.6,-5.1) {Negociador\\{\footnotesize\mdseries\itshape como un legislador; frente a un GATT que solo cambiaba en rondas}};
  \node[cab={pAdm}{4.99cm}] (hA) at (8.0,-5.1) {Administrativo y de vigilancia\\{\footnotesize\mdseries\itshape como una administración; frente a un GATT sin organización}};
  \node[cab={pJur}{4.99cm}] (hJ) at (13.4,-5.1) {Jurisdiccional\\{\footnotesize\mdseries\itshape como un juez; frente a fallos que bloqueaba el condenado}};

  % --- Pilar negociador ---
  \node[it={pNeg}{4.95cm}, anchor=north] (n1) at ([yshift=-0.2cm]hN.south) {\textbf{Consenso tácito}: nadie presente se opone ($\neq$ unanimidad) $\to$ cada miembro tiene veto. El voto (art. IX) existe, pero no se usa};
  \node[it={pNeg}{4.95cm}, below=0.42cm of n1] (n2) {\textbf{Coaliciones}: de bloque (región, desarrollo), estables pero genéricas; temáticas (Cairns, G-20, G-33, Cotton-4), eficaces pero frágiles};
  \node[it={pNeg}{4.95cm}, below=0.42cm of n2] (n3) {\textbf{Círculos concéntricos}: núcleo $\to$ sala verde $\to$ reuniones abiertas $\to$ adopción en el CG o la CM. Eficaz, pero de legitimidad frágil (Seattle, 1999)};
  \node[it={pNeg}{4.95cm}, below=0.42cm of n3] (n4) {\textbf{Conferencias Ministeriales}: Doha 2001 (ronda sin cerrar) $\cdot$ Bali 2013 (facilitación) $\cdot$ Ginebra 2022 (pesca) $\cdot$ Yaundé 2026 (expira la moratoria digital)};
  \node[clave={pNeg}{4.95cm}, below=0.42cm of n4] (n5) {$\Rightarrow$ Acuerdos acotados, pero ni Doha ni la reforma: el Sur gana capacidad de bloqueo, no de fijar la agenda};
  \foreach \a/\b/\t in {n1/n2/nadie negocia solo, n2/n3/así se fragua el consenso, n3/n4/su gran escenario, n4/n5/balance}
    \draw[flecha] ([xshift=0.45cm]\a.south west) -- node[eti] {\t} ([xshift=0.45cm]\b.north west);

  % --- Pilar administrativo y de vigilancia ---
  \node[it={pAdm}{4.95cm}, anchor=north] (a1) at ([yshift=-0.2cm]hA.south) {\textbf{Conferencia Ministerial}: órgano supremo; todos los miembros; al menos cada dos años};
  \node[it={pAdm}{4.95cm}, below=0.42cm of a1] (a2) {\textbf{Consejo General} (Ginebra): decide entre conferencias; es también el Órgano de Solución de Diferencias y el de Examen de Políticas};
  \node[it={pAdm}{4.95cm}, below=0.42cm of a2] (a3) {\textbf{Tres Consejos}: Mercancías $\cdot$ Servicios $\cdot$ ADPIC, con sus comités};
  \node[it={pAdm}{2.32cm}, anchor=north west, minimum height=2.3cm] (a4) at ([yshift=-0.42cm]a3.south west) {\textbf{Continua}: notificaciones y preocupaciones comerciales en consejos y comités};
  \node[it={pAdm}{2.32cm}, anchor=north east, minimum height=2.3cm] (a5) at ([yshift=-0.42cm]a3.south east) {\textbf{Periódica}: examen de las políticas comerciales, más frecuente cuanto mayor el peso};
  \node[clave={pAdm}{4.95cm}, anchor=north west] (a6) at ([yshift=-0.42cm]a4.south west) {$\Rightarrow$ Vigilar es dar transparencia: el examen no es vinculante; actúa la presión entre iguales};
  \draw[flecha] ([xshift=0.45cm]a1.south west) -- node[eti] {actúa en su nombre} ([xshift=0.45cm]a2.north west);
  \draw[flecha] ([xshift=0.45cm]a2.south west) -- node[eti] {de él dependen} ([xshift=0.45cm]a3.north west);
  \draw[flecha] ([xshift=0.45cm]a3.south west) -- node[eti] {vigilan la aplicación, en dos planos} ([xshift=0.45cm]a4.north west);
  \draw[flecha] ([xshift=0.45cm]a4.south west) -- ([xshift=0.45cm]a6.north west);
  \draw[flecha] ([xshift=-0.45cm]a5.south east) -- ([xshift=-0.45cm]a6.north east);

  % --- Pilar jurisdiccional ---
  \node[it={pJur}{4.95cm}, anchor=north, align=center] (j1) at ([yshift=-0.2cm]hJ.south) {\textbf{Órgano de Solución de Diferencias}\\(todos los miembros)};
  \node[it={pJur}{4.95cm}, below=0.3cm of j1, align=center, fill=white] (j2) {Consultas};
  \node[it={pJur}{4.95cm}, below=0.3cm of j2, align=center, fill=white] (j3) {Grupo especial de expertos};
  \node[it={pJur}{4.95cm}, below=0.3cm of j3, align=center, fill=white, dashed] (j4) {Órgano de Apelación: solo derecho\\(sin miembros desde 2019)};
  \node[it={pJur}{4.95cm}, below=0.3cm of j4, align=center, fill=white] (j5) {Adopción del informe por el OSD};
  \node[it={pJur}{4.95cm}, below=0.3cm of j5, align=center, fill=white] (j6) {Cumplimiento o, si no, compensación o retorsión (también cruzada)};
  \node[clave={pJur}{4.95cm}, below=0.42cm of j6] (j7) {$\Rightarrow$ \textbf{Consenso negativo}: solo se bloquea si todos se oponen, también el ganador $\to$ adopción casi automática (GATT: consenso positivo)};
  \foreach \a/\b in {j1/j2, j2/j3, j3/j4, j4/j5, j5/j6, j6/j7} \draw[flecha] (\a) -- (\b);

  % ===================== 4. Desarrollo: eje transversal =====================
  \coordinate (fondo) at (0,-17.0);
  \node[cab={pDes}{15.79cm}, anchor=north west, font=\small\bfseries] (hD) at (fondo) {Desarrollo: eje transversal de los tres pilares (dos tercios de los miembros se declaran en desarrollo)};
  \node[it={pDes}{7.67cm}, anchor=north west, minimum height=1.2cm] (d1) at ([yshift=-0.2cm]hD.south west) {\textbf{Reglas}: trato especial y diferenciado. Problema: ¿quién es país en desarrollo? Se autodesigna; solo los PMA tienen lista (la de la ONU)};
  \node[it={pDes}{7.67cm}, anchor=north east, minimum height=1.2cm] (d2) at ([yshift=-0.2cm]hD.south east) {\textbf{Capacidad}: Ayuda para el Comercio (desde 2005) y Marco Integrado Reforzado; la OMC moviliza y vigila, no financia};
  \node[it={pNeg}{4.95cm}, anchor=north west, fill=white, minimum height=1.55cm] (d3) at ([yshift=-0.25cm]d1.south west) {\textbf{Al negociar}: sin reciprocidad plena; las coaliciones del Sur; resultados para PED y PMA en las conferencias};
  \node[it={pAdm}{4.95cm}, anchor=north, fill=white, minimum height=1.55cm] (d4) at ([yshift=-0.25cm]$(d1.south west)!0.5!(d2.south east)$) {\textbf{Al vigilar}: plazos más largos para aplicar y notificar; exámenes menos frecuentes para los PMA};
  \node[it={pJur}{4.95cm}, anchor=north east, fill=white, minimum height=1.55cm] (d5) at ([yshift=-0.25cm]d2.south east) {\textbf{Al juzgar}: plazos flexibles y moderación con los PMA; asesoría jurídica. Límite: la retorsión de un país pequeño apenas presiona};
\end{tikzpicture}
