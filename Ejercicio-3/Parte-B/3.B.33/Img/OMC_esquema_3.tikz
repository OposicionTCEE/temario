% Esquema de una página del bloque 3 (¿La crisis del multilateralismo?), para el anexo «Material de estudio: Esquemas».
% Se lee de arriba abajo, en el orden del bloque: la crisis en cada pilar -> su causa de fondo -> crisis interna
% (cinco frentes, cada uno con quién se queja) y crisis externa (tres argumentos) -> situación actual.
% Colores: los de los pilares (OMC_crisis_pilares); ámbar = desarrollo, como en el bloque 1; morado = crisis externa.
% Tamaño: 16 cm de ancho y menos de 23 cm de alto; letra de 8 pt como mínimo.
% Generar con: bash Code/generar_figura.sh OMC_esquema_3
\definecolor{pNeg}{RGB}{40,90,150}%
\definecolor{pAdm}{RGB}{46,125,90}%
\definecolor{pJur}{RGB}{190,60,50}%
\definecolor{pDes}{RGB}{215,150,20}%
\definecolor{pGri}{RGB}{110,110,110}%
\definecolor{gTr}{RGB}{60,60,60}%
\definecolor{pExt}{RGB}{120,80,150}%
\begin{tikzpicture}[font=\footnotesize,
    every node/.append style={execute at begin node={\hyphenpenalty=10000}},
    sec/.style={font=\small\bfseries, text=pGri, anchor=south west, inner sep=0pt},
    cab/.style 2 args={fill=#1, text=white, font=\small\bfseries, align=center, text width=#2, inner sep=3pt, rounded corners=2pt},
    it/.style 2 args={draw=#1, fill=#1!8, line width=0.5pt, rounded corners=2pt, align=left, text width=#2, inner sep=3pt},
    clave/.style 2 args={draw=#1, fill=white, line width=1.1pt, rounded corners=2pt, align=left, text width=#2, inner sep=3pt},
    flecha/.style={-{Latex[length=1.6mm]}, line width=0.6pt, black!60}]

  % ===================== 1. La crisis en cada pilar y su causa =====================
  \node[sec] at (0,0) {¿Crisis del multilateralismo? Los tres pilares, con distinta intensidad};
  \node[it={pNeg}{4.95cm}, anchor=north, minimum height=1.3cm] (p1) at (2.6,-0.2) {\textbf{Negociador: bloqueado}\\Doha sin cerrar; desde 2001, solo dos acuerdos multilaterales nuevos (facilitación, pesca)};
  \node[it={pAdm}{4.95cm}, anchor=north, minimum height=1.3cm] (p2) at (8.0,-0.2) {\textbf{Administrativo: funciona, pero pierde utilidad}\\sin normas nuevas ni sentencias, más debate que solución};
  \node[it={pJur}{4.95cm}, anchor=north, minimum height=1.3cm] (p3) at (13.4,-0.2) {\textbf{Jurisdiccional: paralizado en apelación}\\desde 2019 basta apelar «en el vacío» para dejar sin efecto una condena};
  \node[clave={gTr}{15.75cm}, anchor=north west] (cf) at ([yshift=-0.45cm]p1.south west) {\textbf{Causa de fondo}: miembros cada vez más heterogéneos + regla del consenso $\Rightarrow$ cualquiera puede bloquear. China lleva la heterogeneidad al extremo: la mayor potencia comercial es una economía dirigida por el Estado};
  \foreach \p in {p1,p2,p3} \draw[flecha] (cf.north -| \p.south) -- (\p.south);

  % ===================== 2. Crisis interna y crisis externa =====================
  \node[cab={gTr}{9.57cm}, anchor=north west] (hI) at ([yshift=-0.45cm]cf.south west) {Crisis interna: el descontento de los miembros};
  \node[cab={pExt}{5.79cm}, anchor=north east] (hE) at ([yshift=-0.45cm]cf.south east) {Crisis externa: el descontento social};
  \draw[flecha] (cf.south -| hI.north) -- (hI.north);
  \draw[flecha] (cf.south -| hE.north) -- (hE.north);

  % --- Crisis interna: cinco frentes (entre paréntesis, quién se queja) ---
  \node[it={pDes}{9.55cm}, anchor=north west] (i1) at ([yshift=-0.2cm]hI.south west) {\textbf{Desarrollo} \textit{(los PED)}: el consenso como «hipocresía organizada» (STEINBERG, 2002): igualdad soberana en la forma, poder en el fondo (sala verde, todo único). Legitimidad frente a equidad (FRANCK, 1995) $\to$ Agenda de Doha para el Desarrollo. Hoy el consenso es el arma de bloqueo del Sur};
  \node[it={pNeg}{9.55cm}, below=0.15cm of i1] (i2) {\textbf{Negociación} \textit{(todos)}: Doha no se cierra (todo único, agenda de desarrollo, nuevo reparto del poder, ¿quién es PED?) $\to$ las normas envejecen (comercio digital, inversión, competencia, normas laborales y ambientales) $\to$ giro plurilateral: geometría variable, pero un solo miembro puede bloquear su incorporación};
  \node[it={pJur}{9.55cm}, below=0.15cm of i2] (i3) {\textbf{Injerencias} \textit{(EE.UU.)}: el Órgano de Apelación se extralimita (plazos, precedentes; reducción a cero, organismo público, salvaguardias) $\to$ bloqueo de los nombramientos $\to$ sin quórum desde 2019. Parche: el MPIA, un arbitraje que solo vale entre quienes lo suscriben};
  \node[it={gTr}{9.55cm}, below=0.15cm of i3] (i4) {\textbf{China} \textit{(los desarrollados)}: capitalismo de Estado (subvenciones, empresas públicas, transferencia forzada de tecnología). Adhesión (2001) $\to$ certidumbre (PNTR) $\to$ \textit{shock} de China. Sin estatus de economía de mercado; «organismo público» (2011): la propiedad estatal no basta $\to$ guerra comercial (2018)};
  \node[it={gTr}{9.55cm}, below=0.15cm of i4] (i5) {\textbf{Geopolítica} \textit{(todos)}: el comercio, instrumento de poder. Servicios estratégicos (construcción, 5G) y seguridad nacional (art. XXI): controles a la exportación, materias críticas, coerción, aranceles. Dilema: si es autojuzgada, todo cabe; si la juzga un panel, las potencias no lo aceptan};

  % --- Crisis externa: tres argumentos (RODRIK, 2021a) ---
  \node[it={pExt}{5.77cm}, anchor=north east] (e1) at ([yshift=-0.2cm]hE.south east) {\textbf{Distribución}: STOLPER-SAMUELSON: hay perdedores absolutos (efecto magnificación). Cuanto menor el arancel, más renta redistribuida por unidad de ganancia: PCBR $=2/(\varepsilon t)$. Compensación escasa (inconsistencia temporal)};
  \node[it={pExt}{5.77cm}, below=0.15cm of e1] (e2) {\textbf{Justicia}: desigualdad no es injusticia (DEATON); competir con reglas laborales o ambientales más débiles se percibe como injusto};
  \node[it={pExt}{5.77cm}, below=0.15cm of e2] (e3) {\textbf{Integración profunda}: armonizar normas da beneficios ambiguos, y no hay referencia para saber cuándo una norma protege (OGM, hormonas)};
  \node[clave={pExt}{5.77cm}, below=0.25cm of e3] (e4) {$\Rightarrow$ Ganancias pequeñas, redistribución grande y poca compensación: cada paso de apertura encuentra más resistencia y la OMC pierde apoyo político};

  % ===================== 3. Situación actual =====================
  \path let \p1=(i5.south), \p2=(e4.south), \n1={min(\y1,\y2)} in coordinate (fondo) at (0,\n1-0.5cm);
  \node[cab={gTr}{15.79cm}, anchor=north west] (hS) at (fondo) {Situación actual (desde 2025): ¿reforma o fragmentación?};
  \node[it={gTr}{4.95cm}, anchor=north west, minimum height=1.85cm] (s1) at ([yshift=-0.2cm]hS.south west) {\textbf{EE.UU. contra el sistema}: aranceles «recíprocos» que violan la NMF (art. I) y la consolidación (art. II), con una seguridad autojuzgada; deja de pagar sus cuotas. El freno, su Tribunal Supremo (2026)};
  \node[it={gTr}{4.95cm}, anchor=north, minimum height=1.85cm] (s2) at ([yshift=-0.2cm]hS.south) {\textbf{El resto negocia antes que represaliar} (Reino Unido, Japón, UE) y \textbf{el sistema resiste}: la mayor parte del comercio sigue en condiciones NMF};
  \node[it={gTr}{4.95cm}, anchor=north east, minimum height=1.85cm] (s3) at ([yshift=-0.2cm]hS.south east) {\textbf{Tres frentes}: reforma en Ginebra (imposible sin EE.UU.) $\cdot$ coaliciones de voluntarios (MPIA, comercio electrónico, FIT) $\cdot$ fragmentación en bloques};
  \node[clave={gTr}{15.75cm}, anchor=north west] (s4) at ([yshift=-0.25cm]s1.south west) {$\Rightarrow$ La OMC ya no es el lugar donde se escriben las nuevas reglas del comercio, pero sigue siendo el suelo común sobre el que se apoya la mayor parte de él};
\end{tikzpicture}%
