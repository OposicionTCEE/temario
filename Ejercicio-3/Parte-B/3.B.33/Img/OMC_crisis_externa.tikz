% Crisis externa: (a) efecto magnificación de Stolper-Samuelson; (b) ganancias y redistribución según el arancel; (c) relación coste-beneficio político (PCBR). Elaboración propia a partir de STOLPER y SAMUELSON (1941), JONES (1965) y RODRIK (1994, 2021a); formas funcionales estilizadas con elasticidad 2.
\definecolor{eGan}{RGB}{46,125,90}
\definecolor{eRed}{RGB}{190,60,50}
\definecolor{eAzu}{RGB}{40,90,150}
\begin{tikzpicture}[font=\scriptsize,
    every node/.append style={execute at begin node={\hyphenpenalty=10000}}]
  % ---------- Panel (a): magnificación ----------
  \begin{scope}
    \node[font=\footnotesize\bfseries, anchor=west] at (-0.2,3.55) {(a) Stolper-Samuelson};
    \draw[-{Latex[length=1.6mm]}, line width=0.6pt] (0,1.2) -- (4.6,1.2) node[right] {$\%$};
    \draw (2.6,1.12) -- (2.6,1.28) node[above=1pt] {$0$};
    \foreach \x/\c in {0.3/eRed, 1.55/eRed!70, 2.6/black!60, 4.0/eGan}
      \fill[\c] (\x,1.2) circle (2pt);
    \node[above=3pt, text=eRed] at (0.3,1.2) {$\hat w$};
    \node[above=3pt, text=eRed!70] at (1.55,1.2) {$\hat p_M$};
    \node[below=3pt] at (2.6,1.2) {$\hat p_X$};
    \node[above=3pt, text=eGan] at (4.0,1.2) {$\hat r$};
    \node[align=center, text width=1.1cm, text=eRed, font=\tiny] at (0.3,0.5) {salario del trabajo poco cualificado};
    \node[align=center, text width=1.05cm, text=eRed!70, font=\tiny] at (1.6,0.5) {precio del bien importable};
    \node[align=center, text width=1.3cm, text=eGan, font=\tiny] at (4.0,0.45) {remuneración del capital};
    \draw[decorate, decoration={brace, amplitude=4pt}, eRed] (1.55,1.75) -- (0.3,1.75) node[midway, above=5pt, align=center, font=\tiny] {cae \textbf{más}\\que el precio};
    \node[align=center, text width=4.4cm] at (2.2,2.85) {Si cae el precio del bien intensivo en trabajo poco cualificado:\\[2pt] $\hat w < \hat p_M < \hat p_X < \hat r$};
    \node[align=center, text width=4.4cm, font=\tiny, black!70] at (2.2,-0.25) {Pérdida \textbf{absoluta} para un grupo, no solo relativa};
  \end{scope}
  % ---------- Panel (b): ganancia frente a redistribución ----------
  \begin{scope}[xshift=5.6cm]
    \node[font=\footnotesize\bfseries, anchor=west] at (-0.2,3.55) {(b) Ganancia y redistribución};
    \begin{axis}[width=5.3cm, height=3.9cm, at={(0,-0.2)}, xmin=0, xmax=0.42, ymin=0, ymax=0.45,
        xlabel={Arancel $t$}, xlabel style={font=\scriptsize, yshift=3pt},
        xtick={0,0.1,0.2,0.3,0.4}, xticklabels={$0$,$10\%$,$20\%$,$30\%$,$40\%$}, ytick=\empty,
        tick label style={font=\tiny}, axis lines=left, clip=false]
      \addplot[eRed, line width=1pt, domain=0:0.4, samples=2] {x} node[pos=0.78, above left=-1pt, font=\tiny, align=right] {Redistribución\\$R \propto t$};
      \addplot[eGan, line width=1pt, domain=0:0.4, samples=60] {x^2} node[pos=0.97, below=2pt, font=\tiny, align=center] {Ganancia\\$G \propto t^2$};
    \end{axis}
  \end{scope}
  % ---------- Panel (c): PCBR ----------
  \begin{scope}[xshift=11.2cm]
    \node[font=\footnotesize\bfseries, anchor=west] at (-0.2,3.55) {(c) Coste-beneficio político};
    \begin{axis}[width=5.3cm, height=3.9cm, at={(0,-0.2)}, xmin=0, xmax=0.42, ymin=0, ymax=24,
        xlabel={Arancel $t$}, xlabel style={font=\scriptsize, yshift=3pt},
        xtick={0,0.1,0.2,0.3,0.4}, xticklabels={$0$,$10\%$,$20\%$,$30\%$,$40\%$}, ytick={2.5,10,20},
        tick label style={font=\tiny}, axis lines=left, clip=false]
      \addplot[eAzu, line width=1pt, domain=0.042:0.4, samples=80] {1/x} node[pos=0.55, above right=0pt, font=\tiny] {$\text{PCBR}=R/G$};
      \foreach \t/\v in {0.05/20, 0.1/10, 0.4/2.5} {
        \edef\tmp{\noexpand\addplot[only marks, mark=*, mark size=1.4pt, eAzu] coordinates {(\t,\v)};}\tmp }
      \draw[-{Latex[length=1.6mm]}, black!60] (axis cs:0.38,17) -- (axis cs:0.16,17) node[midway, above, font=\tiny, align=center] {avanza la\\liberalización};
    \end{axis}
  \end{scope}
\end{tikzpicture}
