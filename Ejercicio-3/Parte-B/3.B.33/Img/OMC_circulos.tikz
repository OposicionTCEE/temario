% Construcción del consenso en círculos concéntricos (sala verde). Elaboración propia.
\definecolor{ci1}{RGB}{40,90,150}
\definecolor{ci4}{RGB}{200,200,200}
\begin{tikzpicture}[font=\scriptsize,
    every node/.append style={execute at begin node={\hyphenpenalty=10000}},
    et/.style={align=center, text width=#1, inner sep=1pt}]
  % Círculos (de fuera a dentro)
  \fill[ci4!45] (0,0) circle (3.6);
  \fill[ci1!18] (0,0) circle (2.7);
  \fill[ci1!35] (0,0) circle (1.8);
  \fill[ci1!65] (0,0) circle (0.95);
  \draw[white, line width=1pt] (0,0) circle (0.95) (0,0) circle (1.8) (0,0) circle (2.7) (0,0) circle (3.6);
  \node[et=1.6cm, text=white] at (0,0) {\textbf{Núcleo}\\DG + grandes actores};
  \node[et=2.6cm] at (0,1.38) {\textbf{Sala verde}\\$20$-$40$ delegaciones};
  \node[et=3.2cm] at (0,2.25) {\textbf{Reuniones abiertas}\\todos los miembros};
  \node[et=3.6cm] at (0,3.15) {\textbf{Adopción formal}\\CG o CM, por consenso};
  % Flecha: el acuerdo se extiende hacia fuera
  \draw[-{Latex[length=2mm]}, line width=1pt, black!70] (0.35,-0.55) -- (2.7,-2.35);
  \node[et=2.6cm, anchor=north west, black!75] at (2.75,-2.25) {el borrador se fragua dentro y se extiende hacia fuera};
  % Coordinadores de coalición como puente
  \draw[{Latex[length=1.8mm]}-{Latex[length=1.8mm]}, line width=0.8pt, black!60, dashed] (-0.6,-1.2) -- (-2.6,-2.3);
  \node[et=2.8cm, anchor=north east, black!75] at (-2.6,-2.25) {los coordinadores de las coaliciones median entre círculos};
  % Leyenda lateral: crítica
  \node[et=4.2cm, anchor=west, draw=black!40, rounded corners=2pt, inner sep=3pt, fill=black!3] at (4.1,1.2) {\textbf{Ventaja}: hace manejable el consenso entre $166$ miembros.\\[2pt]\textbf{Riesgo}: quien no está dentro recibe el acuerdo hecho (Seattle, 1999).};
\end{tikzpicture}
