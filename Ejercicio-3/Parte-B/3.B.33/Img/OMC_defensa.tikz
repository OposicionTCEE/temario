% Comparación de los instrumentos de defensa comercial. Elaboración propia.
\definecolor{dDef}{RGB}{190,60,50}
\begin{tikzpicture}[font=\scriptsize,
    every node/.append style={execute at begin node={\hyphenpenalty=10000}},
    fila/.style={fill=black!8, align=left, text width=1.3cm, inner sep=3pt, font=\scriptsize\bfseries, minimum height=#1},
    cel/.style={draw=dDef!50, fill=dDef!5, align=left, text width=3.7cm, inner sep=3pt, minimum height=#1},
    cab/.style={fill=dDef, text=white, font=\footnotesize\bfseries, align=center, text width=3.7cm, inner sep=3pt}]
  \node[cab] at (2.08,0) {Antidumping};
  \node[cab] at (6.13,0) {Subvenciones y medidas compensatorias};
  \node[cab] at (10.18,0) {Salvaguardias};
  \newcommand{\fila}[6]{%
    \node[fila=#2, anchor=north west] at (-1.4,#1) {#3};
    \node[cel=#2, anchor=north west] at (0.1,#1) {#4};
    \node[cel=#2, anchor=north west] at (4.15,#1) {#5};
    \node[cel=#2, anchor=north west] at (8.2,#1) {#6};}
  \fila{-0.42}{0.75cm}{Contra qué}{Comercio «desleal»: precio de exportación inferior al valor normal}{Comercio «desleal»: ayuda pública específica}{Comercio leal que aumenta de forma súbita}
  \fila{-1.22}{0.75cm}{Quién lo causa}{Una empresa exportadora}{Un Gobierno}{Nadie: es un ajuste del mercado}
  \fila{-2.02}{0.95cm}{Requisitos}{Dumping, daño importante y relación causal; márgenes y volúmenes mínimos}{Subvención específica, daño o efectos desfavorables y relación causal}{Aumento de importaciones, daño grave y relación causal}
  \fila{-3.02}{0.75cm}{Medida}{Derecho antidumping o compromiso de precios}{Derecho compensatorio unilateral o vía multilateral (OSD)}{Arancel adicional o contingente}
  \fila{-3.82}{0.75cm}{Aplicación}{Selectiva: solo a las empresas y países investigados}{Selectiva: solo a las importaciones subvencionadas}{A todas las importaciones, sea cual sea su origen}
  \fila{-4.62}{0.75cm}{Duración}{$5$ años, prorrogables tras un examen}{$5$ años, prorrogables tras un examen}{$4$ años, hasta $8$ como máximo, con liberalización progresiva}
  \fila{-5.42}{0.75cm}{Precio para quien la usa}{Ninguno}{Ninguno}{Compensar a los afectados o soportar su retorsión (salvo los $3$ primeros años)}
\end{tikzpicture}
