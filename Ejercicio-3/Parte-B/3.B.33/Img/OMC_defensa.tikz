% Comparación de los instrumentos de defensa comercial. Elaboración propia.
\definecolor{dDef}{RGB}{190,60,50}
\begin{tikzpicture}[font=\footnotesize,
    every node/.append style={execute at begin node={\hyphenpenalty=10000}},
    cab/.style={fill=dDef, text=white, font=\footnotesize\bfseries, align=center, text width=4.25cm, inner sep=3pt, minimum height=0.95cm},
    fila/.style={fill=black!8, align=left, text width=1.9cm, inner sep=3pt, font=\footnotesize\bfseries, minimum height=#1},
    cel/.style={draw=dDef!50, fill=dDef!5, align=left, text width=4.25cm, inner sep=3pt, minimum height=#1}]
  \node[cab, anchor=north west] at (2.3,0) {Antidumping};
  \node[cab, anchor=north west] at (6.85,0) {Subvenciones y medidas compensatorias};
  \node[cab, anchor=north west] at (11.4,0) {Salvaguardias};
  \newcommand{\fila}[6]{%
    \node[fila=#2, anchor=north west] at (0,#1) {#3};
    \node[cel=#2, anchor=north west] at (2.3,#1) {#4};
    \node[cel=#2, anchor=north west] at (6.85,#1) {#5};
    \node[cel=#2, anchor=north west] at (11.4,#1) {#6};}
  \fila{-1.05}{0.85cm}{Contra qué}{Dumping: exportar por debajo del valor normal}{Subvención específica concedida por un Gobierno}{Aumento súbito de importaciones, aunque sean leales}
  \fila{-2.0}{0.6cm}{Quién lo causa}{Una empresa}{Un Gobierno}{Nadie: ajuste del mercado}
  \fila{-2.7}{0.85cm}{Requisitos}{Dumping, daño importante y relación causal}{Subvención, daño y relación causal}{Aumento de importaciones, daño grave y relación causal}
  \fila{-3.65}{0.85cm}{Medida}{Derecho antidumping o compromiso de precios}{Derecho compensatorio o vía multilateral (OSD)}{Arancel adicional o contingente}
  \fila{-4.6}{0.85cm}{Aplicación}{Selectiva: empresas y países investigados}{Selectiva: importaciones subvencionadas}{A todos los orígenes por igual}
  \fila{-5.55}{0.85cm}{Duración}{$5$ años, prorrogables tras un examen}{$5$ años, prorrogables tras un examen}{$4$ años, $8$ como máximo, con liberalización progresiva}
  \fila{-6.5}{1.25cm}{Coste para quien la usa}{Ninguno}{Ninguno}{Compensar a los afectados o soportar su retorsión (salvo los $3$ primeros años)}
\end{tikzpicture}
