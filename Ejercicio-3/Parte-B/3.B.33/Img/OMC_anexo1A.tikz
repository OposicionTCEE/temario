% Mapa de los acuerdos del anexo 1A distintos del GATT, por grupos. Elaboración propia.
\definecolor{aAdu}{RGB}{40,90,150}
\definecolor{aNTB}{RGB}{46,125,90}
\definecolor{aDef}{RGB}{190,60,50}
\definecolor{aOtr}{RGB}{110,110,110}
\begin{tikzpicture}[font=\scriptsize,
    every node/.append style={execute at begin node={\hyphenpenalty=10000}},
    cab/.style 2 args={fill=#1, text=white, font=\footnotesize\bfseries, align=center, text width=#2, inner sep=3pt, rounded corners=2pt, minimum height=0.85cm},
    it/.style 2 args={draw=#1, fill=#1!10, line width=0.5pt, rounded corners=1.5pt, align=left, text width=#2, inner sep=2.5pt}]
  \node[fill=black!75, text=white, font=\footnotesize\bfseries, rounded corners=2pt, inner sep=4pt, text width=14.35cm, align=center] (g) at (5.475,1.15) {GATT de 1994: principios (NMF, consolidación, trato nacional, prohibición de restricciones) y excepciones};
  \node[cab={aAdu}{3.3cm}] (a) at (0,0) {Procedimientos\\aduaneros};
  \node[cab={aNTB}{3.3cm}] (b) at (3.65,0) {Barreras\\no arancelarias};
  \node[cab={aDef}{3.3cm}] (c) at (7.3,0) {Defensa\\comercial};
  \node[cab={aOtr}{3.3cm}] (d) at (10.95,0) {Otras\\materias};
  \foreach \x in {a,b,c,d} \draw[-{Latex[length=1.5mm]}, black!50, line width=0.5pt] (\x |- g.south) -- (\x.north);
  % Procedimientos aduaneros
  \node[it={aAdu}{3.2cm}, below=0.15cm of a] (a1) {\textbf{Normas de origen}};
  \node[it={aAdu}{3.2cm}, below=0.1cm of a1] (a2) {\textbf{Licencias de importación} (arts. VIII y XIII)};
  \node[it={aAdu}{3.2cm}, below=0.1cm of a2] (a3) {\textbf{Valoración en aduana} (art. VII)};
  \node[it={aAdu}{3.2cm}, below=0.1cm of a3] (a4) {\textbf{Inspección previa a la expedición}};
  \node[it={aAdu}{3.2cm}, below=0.1cm of a4] (a5) {\textbf{Facilitación del Comercio} (arts. V, VIII y X; 2017)};
  % Barreras no arancelarias
  \node[it={aNTB}{3.2cm}, below=0.15cm of b] (b1) {\textbf{Medidas sanitarias y fitosanitarias} (art. XX.b)};
  \node[it={aNTB}{3.2cm}, below=0.1cm of b1] (b2) {\textbf{Obstáculos técnicos al comercio} (arts. III y XX)};
  % Defensa comercial
  \node[it={aDef}{3.2cm}, below=0.15cm of c] (c1) {\textbf{Antidumping} (art. VI)};
  \node[it={aDef}{3.2cm}, below=0.1cm of c1] (c2) {\textbf{Subvenciones y medidas compensatorias} (arts. VI y XVI)};
  \node[it={aDef}{3.2cm}, below=0.1cm of c2] (c3) {\textbf{Salvaguardias} (art. XIX)};
  % Otras materias
  \node[it={aOtr}{3.2cm}, below=0.15cm of d] (d1) {\textbf{Medidas en materia de inversiones} (TRIMs; arts. III y XI)};
  \node[it={aOtr}{3.2cm}, below=0.1cm of d1] (d2) {\textbf{Agricultura}};
  \node[draw=aOtr, dashed, rounded corners=1.5pt, align=left, text width=3.2cm, inner sep=2.5pt, below=0.1cm of d2] (d3) {\textbf{Textiles y vestido} (expiró en 2005)};
  \node[it={aOtr}{3.2cm}, below=0.1cm of d3] (d4) {\textbf{Subvenciones a la pesca} (2025)};
\end{tikzpicture}
