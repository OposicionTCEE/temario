% El paso de una mercancía por la aduana y los acuerdos que lo rigen. Elaboración propia.
\definecolor{aAdu}{RGB}{40,90,150}
\begin{tikzpicture}[font=\scriptsize,
    every node/.append style={execute at begin node={\hyphenpenalty=10000}},
    paso/.style={draw=aAdu, fill=aAdu!10, line width=0.5pt, rounded corners=2pt, align=center, text width=2.25cm, minimum height=1.25cm, inner sep=2.5pt},
    pre/.style={font=\scriptsize\bfseries, text=aAdu, align=center, text width=2.25cm},
    flecha/.style={-{Latex[length=1.6mm]}, line width=0.7pt, black!60}]
  \node[paso] (s1) at (0,0)    {¿Se verifica antes de embarcar?};
  \node[paso] (s2) at (2.65,0) {¿Necesita permiso para entrar?};
  \node[paso] (s3) at (5.3,0)  {¿De dónde es?\\(qué arancel o preferencia)};
  \node[paso] (s4) at (7.95,0) {¿Cuánto vale?\\(base del arancel)};
  \node[paso] (s5) at (10.6,0) {¿Cuánto tarda y cuesta el despacho?};
  \foreach \a/\b in {s1/s2,s2/s3,s3/s4,s4/s5} \draw[flecha] (\a) -- (\b);
  \node[pre, below=0.12cm of s1] {Inspección previa a la expedición};
  \node[pre, below=0.12cm of s2] {Licencias de importación};
  \node[pre, below=0.12cm of s3] {Normas de origen};
  \node[pre, below=0.12cm of s4] {Valoración en aduana};
  \node[pre, below=0.12cm of s5] {Facilitación del Comercio};
  \node[font=\scriptsize\itshape, black!70, anchor=east] at ([xshift=-0.25cm]s1.west) {Exportación $\to$ importación};
\end{tikzpicture}
