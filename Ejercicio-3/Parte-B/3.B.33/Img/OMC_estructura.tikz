% Estructura de la OMC por pilares (art. IV del Acuerdo de Marrakech). Elaboración propia.
\definecolor{pNeg}{RGB}{40,90,150}
\definecolor{pAdm}{RGB}{46,125,90}
\definecolor{pJur}{RGB}{190,60,50}
\definecolor{pDes}{RGB}{215,150,20}
\begin{tikzpicture}[font=\footnotesize, node distance=0.45cm and 0.35cm,
    caja/.style={draw=#1, fill=#1!12, line width=0.6pt, rounded corners=2pt, align=center, inner sep=3pt},
    org/.style={draw=black!70, fill=black!6, line width=0.6pt, rounded corners=2pt, align=center, inner sep=3pt, text width=#1},
    every node/.append style={execute at begin node={\hyphenpenalty=10000}},
    flecha/.style={-{Latex[length=1.6mm]}, line width=0.5pt, black!60}]
  % Órganos máximos
  \node[org=6.0cm] (CM) at (0,0) {\textbf{Conferencia Ministerial}\\todos los miembros; al menos cada dos años};
  \node[org=3.6cm] (CG) at (0,-1.5) {\textbf{Consejo General}\\embajadores en Ginebra;\\actúa entre conferencias};
  \node[caja=pJur, text width=3.0cm] (OSD) at (-5,-1.5) {\textbf{Órgano de Solución\\de Diferencias}};
  \node[caja=pAdm, text width=3.0cm] (OEPC) at (5,-1.5) {\textbf{Órgano de Examen de\\Políticas Comerciales}};
  \draw[flecha] (CM) -- (CG);
  \draw[dashed, black!50] (OSD) -- (CG) node[midway, above, font=\scriptsize, black!60] {= CG};
  \draw[dashed, black!50] (OEPC) -- (CG) node[midway, above, font=\scriptsize, black!60] {= CG};
  % Pilar jurisdiccional
  \node[caja=pJur, text width=3.0cm] (GE) at (-5,-3.0) {Grupos especiales\\(primera instancia)};
  \node[draw=pJur, dashed, fill=black!5, rounded corners=2pt, align=center, inner sep=3pt, text width=3.0cm] (OA) at (-5,-4.4) {Órgano de Apelación\\{\scriptsize (sin quórum desde 2019)}};
  \draw[flecha] (OSD) -- (GE); \draw[flecha] (GE) -- (OA);
  % Pilar administrativo y de vigilancia
  \node[caja=pAdm, text width=3.6cm] (CONS) at (0,-3.0) {\textbf{Consejos}: Mercancías,\\Servicios y ADPIC\\{\scriptsize (y sus comités)}};
  \node[caja=pAdm, text width=4.0cm] (COM) at (0,-4.75) {\textbf{Comités} del CG: Comercio y Desarrollo, Medio Ambiente, Presupuesto, Acuerdos Regionales...};
  \node[caja=pAdm, text width=3.0cm] (EPC) at (5,-3.0) {Exámenes periódicos\\de cada miembro};
  \draw[flecha] (CG) -- (CONS); \draw[flecha] ([yshift=4pt]CG.south west) -| (-2.75,-4.75) -- (COM.west);
  \draw[flecha] (OEPC) -- (EPC);
  % Pilar negociador
  \node[caja=pNeg, text width=3.0cm] (CNC) at (5,-4.4) {\textbf{Comité de Negociaciones Comerciales}\\{\scriptsize (Ronda Doha)}};
  \draw[flecha] ([yshift=4pt]CG.south east) -| (2.75,-4.4) -- (CNC.west);
  % Secretaría
  \node[draw=black!50, dashed, rounded corners=2pt, align=center, inner sep=3pt, text width=3.2cm] (SEC) at (-5,0) {\textbf{Secretaría y Director/a General}\\{\scriptsize apoyo técnico; sin poder de decisión}};
  \draw[dashed, black!50] (SEC) -- (CM);
  % Franja del desarrollo
  \node[caja=pDes, text width=13.6cm] (DES) at (0,-6.35) {\textbf{Desarrollo, eje transversal}: trato especial y diferenciado en los acuerdos y en las negociaciones · plazos y procedimientos especiales en la vigilancia y en las diferencias · asistencia técnica, Ayuda para el Comercio y Marco Integrado Reforzado};
  % Leyenda
  \begin{scope}[shift={(3.55,0.35)}, font=\scriptsize]
    \fill[pNeg!40] (0,0) rectangle ++(0.25,0.18); \node[anchor=west] at (0.28,0.09) {Pilar negociador};
    \fill[pAdm!40] (0,-0.3) rectangle ++(0.25,0.18); \node[anchor=west] at (0.28,-0.21) {Administración y vigilancia};
    \fill[pJur!40] (0,-0.6) rectangle ++(0.25,0.18); \node[anchor=west] at (0.28,-0.51) {Pilar jurisdiccional};
  \end{scope}
\end{tikzpicture}
