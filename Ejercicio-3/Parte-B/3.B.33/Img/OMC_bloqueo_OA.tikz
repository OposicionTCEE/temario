% Cronología del bloqueo del Órgano de Apelación (2011-2026). Elaboración propia.
\definecolor{bBlq}{RGB}{190,60,50}
\definecolor{bRes}{RGB}{40,90,150}
\begin{tikzpicture}[x=0.85cm, y=1cm, font=\scriptsize,
    every node/.append style={execute at begin node={\hyphenpenalty=10000}},
    hito/.style={circle, fill=#1, inner sep=1.5pt},
    txt/.style={align=left, text width=2.15cm, inner sep=1.5pt}]
  % Eje (x = año - 2010)
  \fill[bBlq!30] (9.95,-0.1) rectangle (16.8,0.1);
  \draw[-{Latex[length=2mm]}, line width=0.8pt] (0,0) -- (17,0);
  \foreach \a in {2010,2012,...,2026}
    \draw (\a-2010,0.1) -- (\a-2010,-0.1);
  \foreach \a in {2010,2012,...,2024}
    \node[below=1pt, font=\scriptsize] at (\a-2010,-0.1) {\a};
  % Bloqueos (arriba): escalera descendente, etiquetas a la derecha
  \newcommand{\arriba}[4]{\node[hito=bBlq] at (#1,0) {}; \draw[bBlq] (#1,0) -- (#1,#2) node[#3, txt] {#4};}
  \arriba{1.4}{1.2}{above right=0pt and -2pt}{\textbf{2011}: EE.UU. veta la renovación de J. Hillman}
  \arriba{6.4}{0.5}{above left=0pt and -2pt}{\textbf{2016}: veta la de S.\,W. Chang}
  \arriba{7.5}{2.6}{above right=0pt and -2pt}{\textbf{2017}: bloquea todo proceso de selección}
  \arriba{8.75}{1.9}{above right=0pt and -2pt}{\textbf{2018}: quedan $3$ miembros, el mínimo}
  \arriba{9.95}{1.2}{above right=0pt and -2pt}{\textbf{11/12/2019}: $1$ miembro, sin quórum}
  \arriba{10.9}{0.5}{above right=0pt and -2pt}{\textbf{30/11/2020}: ningún miembro}
  % Respuestas (abajo)
  \newcommand{\abajo}[4]{\node[hito=bRes] at (#1,0) {}; \draw[bRes] (#1,0) -- (#1,#2) node[#3, txt] {#4};}
  \abajo{9.5}{-2.75}{below right=0pt and -2pt}{\textbf{2019}: proceso Walker, sin apoyo de EE.UU.}
  \abajo{10.4}{-1.85}{below right=0pt and -2pt}{\textbf{2020}: informe del USTR; nace el MPIA}
  \abajo{12.45}{-0.55}{below right=0pt and -2pt}{\textbf{2022}: la CM$12$ promete arreglarlo en 2024; no lo logra}
  \abajo{16.2}{-2.75}{below left=0pt and -2pt}{\textbf{2026}: Yaundé, sin acuerdo; MPIA con $61$ miembros}
  \node[font=\scriptsize\itshape, text=bBlq, anchor=west] at (11.2,0.3) {apelaciones «en el vacío»};
\end{tikzpicture}
