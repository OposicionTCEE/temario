% Anexo I.2 - MUNDELL-FLEMING en dos paises, tipo de cambio flexible:
% expansion monetaria en A -> empobrecimiento del vecino.
\begin{tikzpicture}[>={Stealth[length=2.2mm]}, every node/.style={font=\footnotesize}]
\begin{scope}
  \node[font=\footnotesize\bfseries] at (3.1,5.05) {(a) Pa\'is $A$: expansi\'on monetaria};
  \draw[->] (0,0) -- (6.4,0) node[below=2pt, pos=0.97]{$Y$};
  \draw[->] (0,0) -- (0,4.65) node[left=2pt]{$i$};
  \draw[gray,thick] (0.465,4.1) -- (4.759,0.45) node[below left=-1pt and -4pt]{\textcolor{gray}{$IS_0$}};
  \draw[thick] (1.233,4.1) -- (5.527,0.45) node[below right=-2pt and -3pt]{$IS_1$};
  \draw[gray,thick] (0.80,0.70) -- (4.90,3.98) node[above left=-2pt and -4pt]{\textcolor{gray}{$LM_0$}};
  \draw[thick] (2.20,0.70) -- (6.00,3.74) node[right=-2pt]{$LM_1$};
  \draw[gray,thick] (0.15,2.211) -- (5.90,2.211) node[above right=-3pt and -2pt]{\textcolor{gray}{$i_w^0$}};
  \draw[thick] (0.15,1.950) -- (5.90,1.950) node[below right=-3pt and -2pt]{$i_w^1$};
  \fill (2.687,2.211) circle (1.6pt) node[above left=-2pt and -2pt]{$E_0$};
  \fill[gray] (3.367,1.634) circle (1.4pt) node[below left=-2pt and -2pt]{\textcolor{gray}{$E_1$}};
  \fill (3.7625,1.950) circle (1.6pt) node[above right=-2pt and -1pt]{$E_2$};
  \node[align=left, anchor=north west, font=\scriptsize] at (0.0,-0.35)
    {1 $LM_0\to LM_1$: en $E_1$, $i<i_w^0$\\[-1pt]
     2 sale capital y $A$ se deprecia: $IS_0\to IS_1$\\[-1pt]
     3 hay m\'as liquidez mundial: $i_w^0\to i_w^1$\\[-1pt]
     4 en $E_2$ sube $Y$ y baja $i$, con m\'as $XN$};
\end{scope}
\begin{scope}[xshift=8.0cm]
  \node[font=\footnotesize\bfseries] at (3.1,5.05) {(b) Pa\'is $B$: empobrecer al vecino};
  \draw[->] (0,0) -- (6.4,0) node[below=2pt, pos=0.97]{$Y^{*}$};
  \draw[->] (0,0) -- (0,4.65) node[left=2pt]{$i^{*}$};
  \draw[gray,thick] (0.465,4.1) -- (4.759,0.45) node[below right=-2pt and -3pt]{\textcolor{gray}{$IS^{*}_0$}};
  \draw[thick] (0.05,3.916) -- (4.127,0.45) node[below left=-1pt and -4pt]{$IS^{*}_1$};
  \draw[thick] (0.80,0.70) -- (4.90,3.98) node[above=-1pt]{$LM^{*}_0$};
  \draw[gray,thick] (0.15,2.211) -- (5.90,2.211) node[above right=-3pt and -2pt]{\textcolor{gray}{$i_w^0$}};
  \draw[thick] (0.15,1.950) -- (5.90,1.950) node[below right=-3pt and -2pt]{$i_w^1$};
  \fill (2.687,2.211) circle (1.6pt) node[above right=-2pt and -1pt]{$E^{*}_0$};
  \fill (2.3625,1.950) circle (1.6pt) node[below left=-2pt and -2pt]{$E^{*}_1$};
  \draw[->,thick] (4.35,1.35) -- (3.60,1.35);
  \node[font=\scriptsize, align=center, anchor=north] at (3.97,1.25) {el efecto precio\\[-2pt]vence al de renta};
  \node[align=left, anchor=north west, font=\scriptsize] at (0.0,-0.35)
    {1 $A$ importa m\'as: sube $XN^{*}$ (efecto renta)\\[-1pt]
     2 $B$ se aprecia: cae $XN^{*}$ con m\'as fuerza (efecto precio)\\[-1pt]
     3 $IS^{*}_0\to IS^{*}_1$, hacia la izquierda\\[-1pt]
     4 en $E^{*}_1$ bajan $Y^{*}$ e $i^{*}$ sin haber hecho nada};
\end{scope}
\end{tikzpicture}
