% Anexo I.2 - MUNDELL-FLEMING en dos paises, tipo de cambio fijo:
% expansion monetaria en A -> se revierte en parte en casa y se filtra al socio.
\begin{tikzpicture}[>={Stealth[length=2.2mm]}, every node/.style={font=\footnotesize}]
\begin{scope}
  \node[font=\footnotesize\bfseries] at (3.1,5.05) {(a) Pa\'is $A$: expansi\'on monetaria};
  \draw[->] (0,0) -- (6.4,0) node[below=2pt, pos=0.97]{$Y$};
  \draw[->] (0,0) -- (0,4.65) node[left=2pt]{$i$};
  \draw[thick] (0.465,4.1) -- (4.759,0.45) node[below left=-1pt and -4pt]{$IS_0$};
  \draw[gray,thick] (0.80,0.70) -- (4.90,3.98) node[above left=-2pt and -4pt]{\textcolor{gray}{$LM_0$}};
  \draw[dashed] (2.40,0.70) -- (6.10,3.66) node[right=-2pt]{$LM_1$};
  \draw[thick] (1.60,0.70) -- (5.70,3.98) node[above=-1pt]{$LM_2$};
  \draw[gray,thick] (0.15,2.211) -- (5.90,2.211) node[above right=-3pt and -2pt]{\textcolor{gray}{$i_w^0$}};
  \draw[thick] (0.15,1.881) -- (5.90,1.881) node[below right=-3pt and -2pt]{$i_w^1$};
  \fill (2.687,2.211) circle (1.6pt) node[above left=-2pt and -2pt]{$E_0$};
  \fill[gray] (3.464,1.551) circle (1.4pt) node[below right=-2pt and -2pt]{\textcolor{gray}{$E_1$}};
  \fill (3.076,1.881) circle (1.6pt) node[above right=-2pt and -1pt]{$E_2$};
\end{scope}
\begin{scope}[xshift=8.0cm]
  \node[font=\footnotesize\bfseries] at (3.1,5.05) {(b) Pa\'is $B$: recibe el dinero que $A$ pierde};
  \draw[->] (0,0) -- (6.4,0) node[below=2pt, pos=0.97]{$Y^{*}$};
  \draw[->] (0,0) -- (0,4.65) node[left=2pt]{$i^{*}$};
  \draw[gray,thick] (0.465,4.1) -- (4.759,0.45) node[below left=-1pt and -4pt]{\textcolor{gray}{$IS^{*}_0$}};
  \draw[thick] (0.665,4.1) -- (4.959,0.45) node[below right=-2pt and -3pt]{$IS^{*}_1$};
  \draw[gray,thick] (0.80,0.70) -- (4.90,3.98) node[above left=-2pt and -4pt]{\textcolor{gray}{$LM^{*}_0$}};
  \draw[thick] (1.80,0.70) -- (5.90,3.98) node[right=-2pt]{$LM^{*}_1$};
  \draw[gray,thick] (0.15,2.211) -- (5.90,2.211) node[above right=-3pt and -2pt]{\textcolor{gray}{$i_w^0$}};
  \draw[thick] (0.15,1.881) -- (5.90,1.881) node[below right=-3pt and -2pt]{$i_w^1$};
  \fill (2.687,2.211) circle (1.6pt) node[above left=-2pt and -2pt]{$E^{*}_0$};
  \fill (3.277,1.881) circle (1.6pt) node[above right=-2pt and -1pt]{$E^{*}_1$};
\end{scope}
\end{tikzpicture}
