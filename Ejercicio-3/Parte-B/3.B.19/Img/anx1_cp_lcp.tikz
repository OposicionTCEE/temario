% Anexo I.3 - CORSETTI y PESENTI: expansion monetaria con fijacion en moneda del cliente.
\begin{tikzpicture}[>={Stealth[length=2.2mm]}, every node/.style={font=\footnotesize}]
\begin{scope}
  \node[font=\footnotesize\bfseries] at (2.6,4.75) {(a) Pa\'is $A$: gana margen y bienestar};
  \draw[->] (0,0) -- (5.2,0) node[below=2pt, pos=0.97]{$L$};
  \draw[->] (0,0) -- (0,4.4) node[left=2pt]{$C$};
  \draw[gray,thick] (0,0) -- (4.30,4.085) node[below right=-3pt and -3pt]{\textcolor{gray}{$OA_0$}};
  \draw[thick] (0,0) -- (3.55,4.08) node[above=-2pt]{$OA_1$};
  \draw[gray,thick] (0.15,2.20) -- (4.60,2.20) node[below right=-3pt and -2pt]{\textcolor{gray}{$DA_0$}};
  \draw[thick] (0.15,2.65) -- (4.60,2.65) node[above right=-3pt and -2pt]{$DA_1$};
  \draw[thick, densely dotted] (2.316,0) -- (2.316,4.15) node[above=-1pt]{$\bar L$};
  \draw[gray,thick] plot[domain=1.80:2.90, samples=25] (\x, {1.234+0.18*\x*\x}) node[below right=-3pt and -3pt]{\textcolor{gray}{$U_0$}};
  \draw[thick] plot[domain=1.65:2.80, samples=25] (\x, {1.695+0.18*\x*\x}) node[above left=-3pt and -3pt]{$U_1$};
  \fill (2.316,2.20) circle (1.7pt) node[below right=0pt and -1pt]{$E_0$};
  \fill (2.304,2.65) circle (1.7pt) node[above left=-1pt and -2pt]{$E_1$};
\end{scope}
\begin{scope}[xshift=7.6cm]
  \node[font=\footnotesize\bfseries] at (2.6,4.75) {(b) Pa\'is $B$: empobrecer al vecino};
  \draw[->] (0,0) -- (5.2,0) node[below=2pt, pos=0.97]{$L^{*}$};
  \draw[->] (0,0) -- (0,4.4) node[left=2pt]{$C^{*}$};
  \draw[gray,thick] (0,0) -- (4.30,4.085) node[above left=-3pt and -3pt]{\textcolor{gray}{$OA^{*}_0$}};
  \draw[thick] (0,0) -- (4.95,3.96) node[right=-2pt]{$OA^{*}_1$};
  \draw[thick] (0.15,2.20) -- (4.60,2.20) node[right=-2pt]{$DA^{*}_0=DA^{*}_1$};
  \draw[thick, densely dotted] (2.316,0) -- (2.316,4.15) node[above=-1pt]{$\bar L^{*}$};
  \draw[gray,thick] plot[domain=1.80:2.90, samples=25] (\x, {1.234+0.18*\x*\x}) node[above left=-3pt and -3pt]{\textcolor{gray}{$U^{*}_0$}};
  \draw[thick] plot[domain=2.30:3.40, samples=25] (\x, {0.839+0.18*\x*\x}) node[below right=-3pt and -3pt]{$U^{*}_1$};
  \fill (2.316,2.20) circle (1.7pt) node[above left=-1pt and -2pt]{$E^{*}_0$};
  \fill (2.750,2.20) circle (1.7pt) node[below right=0pt and -1pt]{$E^{*}_1$};
\end{scope}
\end{tikzpicture}
