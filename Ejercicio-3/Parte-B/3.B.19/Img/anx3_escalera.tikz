% Anexo III.6 - La escalera del compromiso: obligacion, precision y delegacion.
\begin{tikzpicture}[>={Stealth[length=2.2mm]}, every node/.style={font=\footnotesize},
  p/.style={draw, thick, rounded corners=2pt, minimum width=3.4cm, minimum height=0.95cm, align=center, font=\scriptsize}]
  \foreach \i/\x/\y/\t/\g in {
    1/0.0/0.0/{Intercambio de informaci\'on}/{2},
    2/1.9/1.15/{Consulta y diagn\'ostico com\'un}/{6},
    3/3.8/2.30/{Est\'andares no vinculantes}/{12},
    4/5.7/3.45/{Compromisos verificados}/{20},
    5/7.6/4.60/{Reglas con sanci\'on}/{30}} {
    \node[p, fill=black!\g] at (\x,\y) {\t};
  }
  \draw[->, very thick] (-1.95,-0.1) -- (-1.95,5.1);
  \node[rotate=90, anchor=south, font=\scriptsize, align=center] at (-2.25,2.5) {obligaci\'on $\cdot$ precisi\'on $\cdot$ delegaci\'on};
  \draw[->, very thick] (-1.7,-0.75) -- (9.4,-0.75);
  \node[anchor=north, font=\scriptsize, align=center] at (3.85,-0.9) {coste de acordar $\cdot$ soberan\'ia cedida};
\end{tikzpicture}
