% Cuerpo, bloque 4 - Cada obstaculo, la tecnologia institucional que lo ataca y lo que esa tecnologia
% consigue. La tercera columna es el resumen de los cuatro parrafos que siguen a la figura en el
% cuerpo, de modo que el esquema completo es el bloque reducido a una pagina.
% Compilar con: bash Code/generar_figura.sh b4_tecnologias
\begin{tikzpicture}[>={Stealth[length=2.0mm]}, every node/.style={font=\footnotesize},
  h/.style={font=\footnotesize\bfseries, align=center},
  o/.style={draw, thick, rounded corners=2pt, align=center, inner sep=4pt,
            text width=3.3cm, minimum height=1.0cm},
  t/.style={draw, thick, fill=black!6, rounded corners=2pt, align=center, inner sep=4pt,
            text width=4.0cm, minimum height=1.0cm},
  c/.style={draw, very thick, rounded corners=2pt, align=center, inner sep=4pt,
            text width=4.2cm, minimum height=1.0cm}]
% --- cabeceras ---
\node[h, text width=3.5cm] at (0,5.55) {Obst\'aculo};
\node[h, text width=4.2cm] at (4.6,5.55) {Herramienta};
\node[h, text width=4.4cm] at (9.8,5.55) {Qu\'e consigue};
\draw[black!45] (-1.70,5.18) -- (11.95,5.18);
% --- filas ---
\foreach \i/\y/\obs/\tec/\con in {
  1/4.35/{No se ve qui\'en cumple}/{Estad\'istica y revisi\'on por pares}/{Disciplina sin sanci\'on: pesa la reputaci\'on},
  2/2.90/{No se comparte el diagn\'ostico}/{Informes y metodolog\'ia com\'un}/{El an\'alisis converge antes de negociar},
  3/1.45/{El acuerdo no obliga}/{Est\'andares y acceso al mercado}/{El bien se vuelve excluible: desarma al polizón},
  4/0/{Nadie decide por el conjunto}/{Cumbre peri\'odica de quienes deciden}/{La relaci\'on no acaba: m\'as acuerdos sostenibles}} {
  \node[o] (o\i) at (0,\y) {\obs};
  \node[t] (t\i) at (4.6,\y) {\tec};
  \node[c] (c\i) at (9.8,\y) {\con};
  \draw[->, black!55] (o\i) -- (t\i);
  \draw[->, black!55] (t\i) -- (c\i);
}
\end{tikzpicture}
