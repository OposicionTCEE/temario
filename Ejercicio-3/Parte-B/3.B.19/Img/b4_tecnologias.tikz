% Cuerpo, bloque 4 - Cada obstaculo y la tecnologia institucional que lo ataca.
\begin{tikzpicture}[>={Stealth[length=2.5mm]}, every node/.style={font=\footnotesize},
  o/.style={draw, thick, rounded corners=2pt, text width=5.3cm, align=center, inner sep=4pt, minimum height=1.0cm},
  t/.style={draw, very thick, fill=black!6, rounded corners=2pt, text width=5.3cm, align=center, inner sep=4pt, minimum height=1.0cm}]
\foreach \i/\y/\obs/\tec in {
  1/3.6/{No se ve qui\'en cumple}/{Estad\'istica y revisi\'on por pares},
  2/2.3/{No se comparte el diagn\'ostico}/{Informes y metodolog\'ia com\'un},
  3/1.0/{El acuerdo no obliga}/{Est\'andares y acceso al mercado},
  4/-0.3/{Nadie decide por el conjunto}/{Cumbre peri\'odica de quienes deciden}} {
  \node[o] (o\i) at (0,\y) {\obs};
  \node[t] (t\i) at (7.4,\y) {\tec};
  \draw[->, very thick] (o\i) -- (t\i);
}
\end{tikzpicture}
