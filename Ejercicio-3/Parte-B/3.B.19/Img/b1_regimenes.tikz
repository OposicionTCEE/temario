% Cuerpo, bloque 1 - Los tres regimenes de fijacion de precios y el signo del desbordamiento.
% Una depreciacion de A llega a un precio distinto segun la moneda en que las empresas fijen los
% suyos, y de ahi sale el signo: con moneda del productor baja el precio que paga el comprador de B
% (favorable para B); con moneda del cliente no se mueve ningun precio y solo cambia el margen
% (transferencia en contra de B); con moneda dominante sube el precio que paga el comprador de A,
% que importa menos de todo (menos comercio, sin desvio).
% Compilar con: bash Code/generar_figura.sh b1_regimenes
\begin{tikzpicture}[>={Stealth[length=2.0mm]}, every node/.style={font=\footnotesize},
  h/.style={font=\footnotesize\bfseries, align=center},
  r/.style={draw, thick, rounded corners=2pt, fill=black!6, align=center, inner sep=4pt,
            text width=2.9cm, minimum height=1.0cm},
  m/.style={draw, thick, rounded corners=2pt, align=center, inner sep=4pt,
            text width=5.0cm, minimum height=1.0cm},
  s/.style={draw, very thick, rounded corners=2pt, align=center, inner sep=4pt,
            text width=3.2cm, minimum height=1.0cm}]
% --- cabeceras ---
\node[h, text width=3.1cm] at (0,3.05) {Moneda en que se\\[-1pt]fijan los precios};
\node[h, text width=4.5cm] at (4.7,3.05) {D\'onde llega la\\[-1pt]depreciaci\'on de $A$};
\node[h, text width=3.4cm] at (9.8,3.05) {Desbordamiento\\[-1pt]sobre $B$};
\draw[black!45] (-1.50,2.52) -- (11.50,2.52);
% --- filas ---
\foreach \i/\y/\reg/\don/\sig in {
  1/1.85/{Del productor}/{al precio que paga el comprador de $B$, que baja}/{favorable},
  2/0.55/{Del cliente}/{a ning\'un precio: solo al margen del exportador}/{adverso: transferencia},
  3/-0.75/{Dominante (una tercera)}/{al precio que paga el comprador de $A$, que sube}/{adverso: menos comercio}} {
  \node[r] (r\i) at (0,\y) {\reg};
  \node[m] (m\i) at (4.7,\y) {\don};
  \node[s] (s\i) at (9.8,\y) {\sig};
  \draw[->, black!55] (r\i) -- (m\i);
  \draw[->, black!55] (m\i) -- (s\i);
}
\end{tikzpicture}
