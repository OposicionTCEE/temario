% Anexo I.1 - Las dos restricciones que entrelazan a dos economias abiertas:
% la de recursos (identidad contable) y la de arbitraje (paridad de intereses).
\begin{tikzpicture}[>={Stealth[length=2.4mm]}, every node/.style={font=\footnotesize},
  pais/.style={draw, thick, rounded corners=2pt, minimum width=4.5cm, minimum height=2.5cm, align=center},
  canal/.style={draw, fill=black!4, rounded corners=2pt, minimum width=5.3cm, align=center, inner sep=4pt}]

\node[pais] (A) at (0,0) {\textbf{Pa\'is $A$}\\[3pt]
  instrumentos: $G$, $M^{s}$\\[2pt]
  objetivos: $Y$, $\pi$, $XN$\\[4pt]
  $\;Y-(C+I+G)=XN\;$};
\node[pais] (B) at (10.6,0) {\textbf{Pa\'is $B$}\\[3pt]
  instrumentos: $G^{*}$, $M^{s*}$\\[2pt]
  objetivos: $Y^{*}$, $\pi^{*}$, $XN^{*}$\\[4pt]
  $\;Y^{*}-(C^{*}+I^{*}+G^{*})=XN^{*}\;$};

\node[canal] (rec) at (5.3,0.80) {\textbf{Restricci\'on de recursos}\\[2pt]$XN+XN^{*}=0$};
\node[canal] (arb) at (5.3,-0.80) {\textbf{Restricci\'on de arbitraje}\\[2pt]$i=i^{*}+\mathbb{E}_t[\Delta s_{t+1}]+\lambda$};

\draw[<->, thick] (A.east|-rec) -- (rec.west);
\draw[<->, thick] (rec.east) -- (B.west|-rec);
\draw[<->, thick] (A.east|-arb) -- (arb.west);
\draw[<->, thick] (arb.east) -- (B.west|-arb);

% canales por los que viaja el desbordamiento
\node[align=center, font=\scriptsize] (canales) at (5.3,-2.55)
  {\textbf{Tres canales}\;\;\;
   renta: $\partial XN^{*}/\partial Y>0$\;\;\;$\cdot$\;\;\;
   precio: $\partial XN^{*}/\partial q<0$\;\;\;$\cdot$\;\;\;
   monetario: $\partial i^{*}/\partial i>0$};
\draw[->, thick] (A.south) -- (0,-2.2) -- (canales.west);
\draw[->, thick] (B.south) -- (10.6,-2.2) -- (canales.east);

\node[align=center, font=\scriptsize] at (5.3,-3.40)
  {$\Longrightarrow$\; el bienestar de cada uno depende de los dos instrumentos:\;
   $W=W(G,M^{s};G^{*},M^{s*})$,\; $W^{*}=W^{*}(G,M^{s};G^{*},M^{s*})$};
\end{tikzpicture}
