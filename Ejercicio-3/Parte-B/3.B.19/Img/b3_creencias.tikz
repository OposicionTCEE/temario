% Cuerpo, bloque 3 - El mismo hecho leido de dos formas incompatibles.
\begin{tikzpicture}[>={Stealth[length=2.5mm]}, every node/.style={font=\footnotesize},
  h/.style={draw, very thick, rounded corners=2pt, text width=4.0cm, align=center, inner sep=4pt, minimum height=1.0cm},
  l/.style={draw, thick, fill=black!5, rounded corners=2pt, text width=4.6cm, align=center, inner sep=4pt, minimum height=1.25cm},
  r/.style={draw, thick, rounded corners=2pt, text width=4.6cm, align=center, inner sep=4pt, minimum height=1.05cm}]
\node[h] (h) at (5.6,3.5) {Un pa\'is amplía su d\'eficit p\'ublico};
\node[l] (l1) at (2.4,1.75) {Es demanda para todos};
\node[l] (l2) at (8.8,1.75) {Compite por el ahorro mundial y crea riesgo moral};
\draw[->, thick] (h) -- (l1); \draw[->, thick] (h) -- (l2);
\node[r] (r1) at (2.4,0.1) {El acuerdo debe pedirle \textbf{más}};
\node[r] (r2) at (8.8,0.1) {El acuerdo debe ponerle \textbf{límites}};
\draw[->, thick] (l1) -- (r1); \draw[->, thick] (l2) -- (r2);
\end{tikzpicture}
