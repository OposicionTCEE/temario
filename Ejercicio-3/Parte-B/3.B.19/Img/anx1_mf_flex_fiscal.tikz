% Anexo I.2 - MUNDELL-FLEMING en dos paises, tipo de cambio flexible:
% expansion fiscal en A -> efecto locomotora sobre B.
\begin{tikzpicture}[>={Stealth[length=2.2mm]}, every node/.style={font=\footnotesize}]
\begin{scope}
  \node[font=\footnotesize\bfseries] at (3.1,5.05) {(a) Pa\'is $A$: expansi\'on fiscal};
  \draw[->] (0,0) -- (6.4,0) node[below=2pt, pos=0.97]{$Y$};
  \draw[->] (0,0) -- (0,4.65) node[left=2pt]{$i$};
  \draw[gray,thick] (0.465,4.1) -- (4.759,0.45) node[below left=-1pt and -4pt]{\textcolor{gray}{$IS_0$}};
  \draw[dashed] (1.715,4.1) -- (5.421,0.95) node[above right=-3pt and -2pt]{$IS_1$};
  \draw[thick] (1.290,4.1) -- (5.584,0.45) node[below right=-2pt and -3pt]{$IS_2$};
  \draw[thick] (0.80,0.70) -- (4.90,3.98) node[above=-1pt]{$LM_0$};
  \draw[gray,thick] (0.15,2.211) -- (5.95,2.211) node[right=-2pt]{\textcolor{gray}{$i_w^0$}};
  \draw[thick] (0.15,2.550) -- (5.95,2.550) node[right=-2pt]{$i_w^1$};
  \fill (2.687,2.211) circle (1.6pt) node[below left=0pt and 0pt]{$E_0$};
  \fill[gray] (3.332,2.726) circle (1.4pt) node[above right=-2pt and -1pt]{\textcolor{gray}{$E_1$}};
  \fill (3.113,2.550) circle (1.6pt) node[below right=1pt and -1pt]{$E_2$};
  \node[align=left, anchor=north west, font=\scriptsize] at (0.0,-0.35)
    {1 el gasto desplaza $IS_0\to IS_1$: en $E_1$, $i>i_w^0$\\[-1pt]
     2 entra capital y $A$ se aprecia: $IS_1\to IS_2$\\[-1pt]
     3 el ahorro mundial no da para todos: $i_w^0\to i_w^1$\\[-1pt]
     4 en $E_2$ suben $Y$ e $i$, con menos $XN$};
\end{scope}
\begin{scope}[xshift=8.0cm]
  \node[font=\footnotesize\bfseries] at (3.1,5.05) {(b) Pa\'is $B$: efecto locomotora};
  \draw[->] (0,0) -- (6.4,0) node[below=2pt, pos=0.97]{$Y^{*}$};
  \draw[->] (0,0) -- (0,4.65) node[left=2pt]{$i^{*}$};
  \draw[gray,thick] (0.465,4.1) -- (4.759,0.45) node[below left=-1pt and -4pt]{\textcolor{gray}{$IS^{*}_0$}};
  \draw[thick] (1.290,4.1) -- (5.584,0.45) node[below right=-2pt and -3pt]{$IS^{*}_1$};
  \draw[thick] (0.80,0.70) -- (4.90,3.98) node[above=-1pt]{$LM^{*}_0$};
  \draw[gray,thick] (0.15,2.211) -- (5.95,2.211) node[right=-2pt]{\textcolor{gray}{$i_w^0$}};
  \draw[thick] (0.15,2.550) -- (5.95,2.550) node[right=-2pt]{$i_w^1$};
  \fill (2.687,2.211) circle (1.6pt) node[below left=0pt and 0pt]{$E^{*}_0$};
  \fill (3.113,2.550) circle (1.6pt) node[below right=1pt and -1pt]{$E^{*}_1$};
  \draw[->,thick] (1.15,3.30) -- (1.98,3.30);
  \node[font=\scriptsize, align=center, anchor=south] at (1.57,3.42) {efecto renta\\[-2pt]+ efecto precio};
  \node[align=left, anchor=north west, font=\scriptsize] at (0.0,-0.35)
    {1 $A$ importa m\'as: sube $XN^{*}$ (efecto renta)\\[-1pt]
     2 $B$ se deprecia: sube otra vez $XN^{*}$ (efecto precio)\\[-1pt]
     3 $IS^{*}_0\to IS^{*}_1$ y el tipo mundial sube\\[-1pt]
     4 en $E^{*}_1$ suben $Y^{*}$ e $i^{*}$ sin gastar un euro};
\end{scope}
\end{tikzpicture}
