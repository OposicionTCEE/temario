% Anexo II.1 - El espacio de politicas de HAMADA: funciones de reaccion,
% equilibrio de NASH, curva de contratos y punto cooperativo.
\begin{tikzpicture}[x=1.45cm, y=1.45cm, >={Stealth[length=2.2mm]}, every node/.style={font=\footnotesize}]
  \draw[->] (0,0) -- (5.7,0) node[below=2pt, pos=0.97]{$z^{*}$};
  \draw[->] (0,0) -- (0,5.7) node[left=2pt]{$z$};
  % curvas de indiferencia que pasan por N
  \draw[gray, thick] plot[domain=-155:-25, samples=60, variable=\t]
      ({4.6+2.667*sin(\t)}, {1.0+2.066*cos(\t)-0.933*sin(\t)});
  \draw[gray, thick, dashed] plot[domain=-155:-25, samples=60, variable=\t]
      ({1.0+2.066*cos(\t)-0.933*sin(\t)}, {4.6+2.667*sin(\t)});
  % funciones de reaccion
  \draw[thick] (0,2.61) -- (5.5,0.685) node[right=-2pt]{$R_A$};
  \draw[thick] (2.61,0) -- (0.685,5.5) node[above=-1pt]{$R_B$};
  % curva de contratos
  \draw[very thick] (4.6,1.0) .. controls (3.6,1.9) and (1.9,3.6) .. (1.0,4.6);
  % puntos
  \fill (1.933,1.933) circle (1.9pt) node[below left=0pt and -2pt]{$N$};
  \fill (2.594,2.594) circle (1.9pt) node[above right=-1pt and 0pt]{$C$};
  \draw[->, very thick] (2.07,2.07) -- (2.46,2.46);
  \draw (4.6,1.0) circle (1.9pt) node[right=3pt]{$B_A$};
  \draw (1.0,4.6) circle (1.9pt) node[above=3pt]{$B_B$};
\end{tikzpicture}
