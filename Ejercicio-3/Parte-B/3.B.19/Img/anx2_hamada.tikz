% Anexo II.1 - El espacio de politicas de HAMADA: funciones de reaccion,
% equilibrio de NASH, curva de contratos y punto cooperativo.
\begin{tikzpicture}[x=1.45cm, y=1.45cm, >={Stealth[length=2.2mm]}, every node/.style={font=\footnotesize}]
  \draw[->] (0,0) -- (5.3,0) node[below=2pt, pos=0.96]{$z^{*}$};
  \draw[->] (0,0) -- (0,5.3) node[left=2pt]{$z$};
  % curvas de indiferencia que pasan por N
  \draw[gray, thick] plot[domain=-126:-27, samples=50, variable=\t]
      ({4.6+2.667*sin(\t)}, {1.0+2.066*cos(\t)-0.933*sin(\t)}) node[below right=-3pt and -3pt]{\textcolor{gray}{$U_A$}};
  \draw[gray, thick, dashed] plot[domain=-126:-27, samples=50, variable=\t]
      ({1.0+2.066*cos(\t)-0.933*sin(\t)}, {4.6+2.667*sin(\t)}) node[above left=-3pt and -3pt]{\textcolor{gray}{$U_B$}};
  % funciones de reaccion
  \draw[thick] (0,2.61) -- (5.1,0.825) node[below right=-2pt and -3pt]{$R_A$};
  \draw[thick] (2.61,0) -- (0.86,5.0) node[above=-1pt]{$R_B$};
  % curva de contratos
  \draw[very thick] (4.6,1.0) .. controls (3.65,1.35) and (1.35,3.65) .. (1.0,4.6);
  % puntos
  \fill (1.933,1.933) circle (1.9pt) node[below right=-1pt and -1pt]{$N$};
  \fill (2.594,2.594) circle (1.9pt) node[above left=-2pt and -1pt]{$C$};
  \draw[->, very thick] (2.09,2.09) -- (2.44,2.44);
  \draw (4.6,1.0) circle (1.9pt) node[above right=-2pt and 0pt]{$B_A$};
  \draw (1.0,4.6) circle (1.9pt) node[left=3pt]{$B_B$};
\end{tikzpicture}
