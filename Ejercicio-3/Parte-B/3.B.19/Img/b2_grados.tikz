% Cuerpo, bloque 2 - Tres resultados, no dos: NASH, coordinacion y cooperacion plena.
\begin{tikzpicture}[x=1.5cm, y=1.5cm, >={Stealth[length=2.4mm]}, every node/.style={font=\footnotesize}]
  \draw[->] (0,0) -- (4.6,0) node[below=2pt, pos=0.95]{$z^{*}$};
  \draw[->] (0,0) -- (0,4.6) node[left=2pt]{$z$};
  \fill[black!9] plot[domain=-90:-30, samples=40, variable=\t]
      ({4.6+2.667*sin(\t)}, {1.0+2.066*cos(\t)-0.933*sin(\t)}) --
      plot[domain=-30:-90, samples=40, variable=\t]
      ({1.0+2.066*cos(\t)-0.933*sin(\t)}, {4.6+2.667*sin(\t)}) -- cycle;
  \draw[thick] (0,2.61) -- (4.45,1.05) node[below right=-2pt and -3pt]{$R_A$};
  \draw[thick] (2.61,0) -- (1.06,4.43) node[above=-1pt]{$R_B$};
  \draw[very thick] (4.3,1.11) .. controls (3.65,1.35) and (1.35,3.65) .. (1.11,4.3);
  \fill (1.933,1.933) circle (2.0pt) node[below left=-1pt and -2pt]{$N$};
  \fill (2.263,2.263) circle (2.0pt) node[below right=-1pt and -2pt]{$K$};
  \fill (2.594,2.594) circle (2.0pt) node[above left=-2pt and -1pt]{$C$};
  \draw[->, very thick] (2.03,2.03) -- (2.17,2.17);
  \draw[->, very thick] (2.36,2.36) -- (2.50,2.50);
