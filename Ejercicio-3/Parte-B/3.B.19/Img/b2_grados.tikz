% Cuerpo, bloque 2 - Tres resultados, no dos, sobre el espacio de politicas de HAMADA (1976).
% Cada pais tiene su optimo (B_A, B_B) y curvas de indiferencia elipticas alrededor de el. La funcion
% de reaccion de A es el lugar de los puntos en que sus curvas tienen tangente vertical (lo mejor que
% A puede hacer dado z*), y la de B, el de tangente horizontal; N es su cruce. W_A y W_B son las
% curvas que pasan por N, y la lente sombreada, la interseccion de los dos conjuntos que lo mejoran.
% La recta gruesa que une los dos optimos es el lugar de tangencia entre ambas familias (los acuerdos
% eficientes); con estas preferencias es exactamente x+y=5,41, y C es su cruce con la diagonal.
% Compilar con: bash Code/generar_figura.sh b2_grados
\begin{tikzpicture}[x=1.5cm, y=1.5cm, >={Stealth[length=2.4mm]}, every node/.style={font=\footnotesize}]
  \draw[->] (0,0) -- (4.6,0) node[below=2pt, pos=0.95]{$z^{*}$};
  \draw[->] (0,0) -- (0,4.6) node[left=2pt]{$z$};
  % --- lente de mejora mutua: interseccion de los conjuntos mejores en N ---
  \fill[black!9] plot[domain=90:159.65, samples=50, variable=\t]
      ({4.3+2.2165*cos(\t)-0.8309*sin(\t)}, {1.11+2.3671*sin(\t)}) --
      plot[domain=159.65:90, samples=50, variable=\t]
      ({1.11+2.3671*sin(\t)}, {4.3+2.2165*cos(\t)-0.8309*sin(\t)}) -- cycle;
  % --- curvas de indiferencia que pasan por N ---
  \draw[black!70, line width=0.7pt] plot[domain=70:170, samples=70, variable=\t]
      ({4.3+2.2165*cos(\t)-0.8309*sin(\t)}, {1.11+2.3671*sin(\t)});
  \draw[black!70, line width=0.7pt] plot[domain=70:170, samples=70, variable=\t]
      ({1.11+2.3671*sin(\t)}, {4.3+2.2165*cos(\t)-0.8309*sin(\t)});
  \node[font=\scriptsize, anchor=south west] at (4.30,3.36) {$W_A$};
  \node[font=\scriptsize, anchor=south west] at (3.30,4.32) {$W_B$};
  % --- funciones de reaccion ---
  \draw[thick] (0,2.61) -- (4.45,1.05);
  \draw[thick] (2.61,0) -- (1.06,4.43);
  \node[font=\footnotesize, anchor=north west] at (3.45,1.30) {$R_A$};
  \node[font=\footnotesize, anchor=south east] at (1.30,3.45) {$R_B$};
  % --- acuerdos eficientes: la recta de tangencia entre las dos familias ---
  \draw[very thick] (4.3,1.11) -- (1.11,4.3);
  % --- optimo de cada pais ---
  \fill (4.3,1.11) circle (2.0pt);
  \fill (1.11,4.3) circle (2.0pt);
  \node[font=\footnotesize, anchor=north] at (4.30,1.00) {$B_A$};
  \node[font=\footnotesize, anchor=east] at (1.00,4.30) {$B_B$};
  % --- los tres resultados ---
  \fill (1.933,1.933) circle (2.0pt) node[below left=-1pt and -2pt]{$N$};
  \fill (2.320,2.320) circle (2.0pt) node[below right=-1pt and -2pt]{$K$};
  \fill (2.705,2.705) circle (2.0pt);
  \node[font=\footnotesize, anchor=south west] at (2.76,2.76) {$C$};
  \draw[->, very thick] (2.03,2.03) -- (2.19,2.19);
  \draw[->, very thick] (2.42,2.42) -- (2.58,2.58);
\end{tikzpicture}
