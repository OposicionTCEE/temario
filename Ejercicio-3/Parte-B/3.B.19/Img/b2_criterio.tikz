% Cuerpo, bloque 2 - Que tiene que fallar para que coordinar mejore las cosas.
\begin{tikzpicture}[>={Stealth[length=2.4mm]}, every node/.style={font=\footnotesize},
  q/.style={draw, very thick, rounded corners=2pt, text width=4.4cm, align=center, inner sep=4pt, minimum height=1.1cm},
  f/.style={draw, thick, fill=black!5, rounded corners=2pt, text width=3.5cm, align=center, inner sep=4pt, minimum height=1.1cm},
  s/.style={draw, thick, rounded corners=2pt, text width=3.5cm, align=center, inner sep=4pt, minimum height=1.1cm}]
\node[q] (q) at (6.0,3.6) {Hay desbordamiento: \textbf{¿hay algo que corregir?}};
\node[f] (f1) at (1.3,1.7) {Poder de mercado};
\node[f] (f2) at (6.0,1.7) {Instrumentos insuficientes};
\node[f] (f3) at (10.7,1.7) {Mercados internacionales imperfectos};
\draw[->, thick] (q) -- (f1); \draw[->, thick] (q) -- (f2); \draw[->, thick] (q) -- (f3);
\node[s] (s1) at (1.3,-0.1) {Desarmar: l\'imites al uso estrat\'egico};
\node[s] (s2) at (6.0,-0.1) {Crear o repartir herramientas};
\node[s] (s3) at (10.7,-0.1) {Producir el bien que falta};
\draw[->, thick] (f1) -- (s1); \draw[->, thick] (f2) -- (s2); \draw[->, thick] (f3) -- (s3);
\end{tikzpicture}
