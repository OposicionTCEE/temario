% Cuerpo, bloque 3 - La frontera entre la eficacia del acuerdo y el control democratico, con las cuatro
% formas institucionales situadas sobre ella: lo que gana en obligacion y precision lo pierde en
% intervencion parlamentaria efectiva. La escalera completa de compromisos esta en el anexo III.
% Compilar con: bash Code/generar_figura.sh b3_limite
\begin{tikzpicture}[>={Stealth[length=2.4mm]}, every node/.style={font=\footnotesize}]
  \draw[->] (0,0) -- (8.9,0);
  \draw[->] (0,0) -- (0,5.0);
  \draw[very thick] plot[domain=0.55:8.1, samples=90] (\x, {4.6*exp(-0.30*\x)+0.35});
  \fill (1.0,3.76) circle (2.0pt);
  \fill (2.8,2.34) circle (2.0pt);
  \fill (5.0,1.38) circle (2.0pt);
  \fill (7.3,0.86) circle (2.0pt);
  \node[anchor=west, font=\scriptsize] at (1.20,4.05) {reglas con sanci\'on y tribunal};
  \node[anchor=west, font=\scriptsize] at (3.00,2.63) {est\'andares verificados};
  \node[anchor=west, font=\scriptsize] at (5.20,1.67) {revisi\'on por pares};
  \node[anchor=west, font=\scriptsize] at (7.50,1.15) {intercambio de informaci\'on};
  \node[anchor=south west, font=\scriptsize, align=left] at (0.05,5.0) {Eficacia\\[-2pt]del acuerdo};
  \node[anchor=north east, font=\scriptsize] at (8.9,-0.15) {Control democr\'atico};
\end{tikzpicture}
