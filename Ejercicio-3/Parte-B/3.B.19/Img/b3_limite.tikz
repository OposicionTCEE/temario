% Cuerpo, bloque 3 - El canje entre eficacia del acuerdo y control democratico.
\begin{tikzpicture}[>={Stealth[length=2.4mm]}, every node/.style={font=\footnotesize}]
  \draw[->] (0,0) -- (8.6,0) node[below=2pt, pos=0.97, align=center]{fuerza del compromiso};
  \draw[->] (0,0) -- (0,4.4);
  \node[font=\scriptsize, anchor=north] at (1.1,-0.15) {informaci\'on};
  \node[font=\scriptsize, anchor=north] at (7.0,-0.15) {reglas con sanci\'on};
  \draw[very thick] plot[domain=0.5:7.9, samples=50] (\x, {0.55+3.3*(1-exp(-0.45*\x))})
      node[right=-2pt, align=left]{eficacia\\[-2pt]del acuerdo};
  \draw[very thick, dashed] plot[domain=0.5:7.9, samples=50] (\x, {0.45+3.4*exp(-0.30*\x)})
      node[right=-2pt, align=left]{control\\[-2pt]democr\'atico};
\end{tikzpicture}
