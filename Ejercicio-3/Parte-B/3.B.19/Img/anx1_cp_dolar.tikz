% Anexo I.3 - CORSETTI y PESENTI: expansion monetaria con fijacion en la moneda dominante.
\begin{tikzpicture}[>={Stealth[length=2.2mm]}, every node/.style={font=\footnotesize}]
\begin{scope}
  \node[font=\footnotesize\bfseries] at (2.6,4.75) {(a) Pa\'is $A$, el de la moneda: solo demanda};
  \draw[->] (0,0) -- (5.2,0) node[below=2pt, pos=0.97]{$L$};
  \draw[->] (0,0) -- (0,4.4) node[left=2pt]{$C$};
  \draw[thick] (0,0) -- (4.30,4.085) node[above left=-3pt and -3pt]{$OA_0=OA_1$};
  \draw[gray,thick] (0.15,2.20) -- (4.60,2.20) node[below right=-3pt and -2pt]{\textcolor{gray}{$DA_0$}};
  \draw[thick] (0.15,2.55) -- (4.60,2.55) node[above right=-3pt and -2pt]{$DA_1$};
  \draw[thick, densely dotted] (2.316,0) -- (2.316,4.15) node[above=-1pt]{$\bar L$};
  \draw[gray,thick] plot[domain=1.80:3.15, samples=25] (\x, {1.234+0.18*\x*\x}) node[below right=-3pt and -3pt]{\textcolor{gray}{$U_0$}};
  \fill (2.316,2.20) circle (1.7pt) node[below right=0pt and -1pt]{$E_0$};
  \fill (2.684,2.55) circle (1.7pt) node[above left=-1pt and -2pt]{$E_1$};
  \node[align=left, anchor=north west, font=\scriptsize] at (0.0,-0.45)
    {1 la relaci\'on real de intercambio no se mueve: $OA$ se queda\\[-1pt]
     \phantom{1 }donde est\'a, porque los dos precios est\'an en la misma moneda\\[-1pt]
     2 solo act\'ua la demanda: $DA_0\to DA_1$\\[-1pt]
     3 en $E_1$ se trabaja y se consume m\'as, sobre la misma $U_0$};
\end{scope}
\begin{scope}[xshift=7.6cm]
  \node[font=\footnotesize\bfseries] at (2.6,4.75) {(b) Pa\'is $B$: importaciones m\'as baratas};
  \draw[->] (0,0) -- (5.2,0) node[below=2pt, pos=0.97]{$L^{*}$};
  \draw[->] (0,0) -- (0,4.4) node[left=2pt]{$C^{*}$};
  \draw[gray,thick] (0,0) -- (4.30,4.085) node[below right=-3pt and -3pt]{\textcolor{gray}{$OA^{*}_0$}};
  \draw[thick] (0,0) -- (3.95,4.148) node[above=-2pt]{$OA^{*}_1$};
  \draw[gray,thick] (0.15,2.20) -- (4.60,2.20) node[below right=-3pt and -2pt]{\textcolor{gray}{$DA^{*}_0$}};
  \draw[thick] (0.15,2.35) -- (4.60,2.35) node[above right=-3pt and -2pt]{$DA^{*}_1$};
  \draw[thick, densely dotted] (2.316,0) -- (2.316,4.15) node[above=-1pt]{$\bar L^{*}$};
  \draw[gray,thick] plot[domain=1.80:2.90, samples=25] (\x, {1.234+0.18*\x*\x}) node[below right=-3pt and -3pt]{\textcolor{gray}{$U^{*}_0$}};
  \draw[thick] plot[domain=1.70:2.80, samples=25] (\x, {1.448+0.18*\x*\x}) node[above left=-3pt and -3pt]{$U^{*}_1$};
  \fill (2.316,2.20) circle (1.7pt) node[below right=0pt and -1pt]{$E^{*}_0$};
  \fill (2.238,2.35) circle (1.7pt) node[above left=-1pt and -2pt]{$E^{*}_1$};
  \node[align=left, anchor=north west, font=\scriptsize] at (0.0,-0.45)
    {1 la cesta de consumo se abarata: $DA^{*}_0\to DA^{*}_1$\\[-1pt]
     2 y rinde m\'as cada hora en consumo: $OA^{*}_0\to OA^{*}_1$\\[-1pt]
     3 en $E^{*}_1$ se consume algo m\'as, pero $B$ ha perdido\\[-1pt]
     \phantom{3 }el tipo de cambio como instrumento};
\end{scope}
\end{tikzpicture}
