% Cuerpo, bloque 1 - Del trilema al dilema. Modificacion parcial de b1_trilema, tres paginas antes:
% con un ciclo financiero global el lado de la flotacion deja de garantizar la politica monetaria
% propia, de modo que la eleccion se reduce a dos: o se gestiona la cuenta financiera, o se aceptan
% las condiciones del centro. La cadena de transmision, paso a paso, esta en el anexo I.
% Compilar con: bash Code/generar_figura.sh b1_ciclo
\begin{tikzpicture}[scale=1.35, >={Stealth[length=2.4mm]}, every node/.style={font=\footnotesize},
  v/.style={draw, very thick, rounded corners=2pt, fill=white, text width=2.6cm, align=center, inner sep=3pt, font=\scriptsize},
  l/.style={font=\scriptsize, align=center, fill=white, inner sep=2pt}]
  \coordinate (A) at (90:3.1);
  \coordinate (B) at (210:3.1);
  \coordinate (C) at (330:3.1);
  \draw[very thick] (A) -- (B);
  \draw[very thick] (B) -- (C);
  \draw[very thick, densely dashed, black!45] (A) -- (C);
  \node[l] at ($(A)!0.52!(B) + (-0.50,0.05)$) {Tipo fijo:\\ se \textbf{importa} la pol\'itica\\ monetaria del centro};
  \node[l] at ($(B)!0.5!(C) + (0,-0.62)$) {Cuenta financiera gestionada: se \textbf{conserva} la autonom\'ia};
  \node[l, text=black!55] at ($(A)!0.52!(C) + (0.78,0.16)$) {Flotaci\'on};
  \node[font=\large] at ($(A)!0.52!(C)$) {$\times$};
  \node[v] at (A) {Libre movilidad del capital};
  \node[v] at (B) {Tipo de cambio fijo};
  \node[v] at (C) {Pol\'itica monetaria aut\'onoma};
\end{tikzpicture}
