% Cuerpo, bloque 1 - El tipo de interes del centro como condicion financiera de todos.
\begin{tikzpicture}[>={Stealth[length=2.5mm]}, every node/.style={font=\footnotesize},
  n/.style={draw, very thick, rounded corners=2pt, text width=3.1cm, align=center, inner sep=4pt, minimum height=1.2cm}]
\node[n] (a) at (0,0)   {Tipo de inter\'es del centro};
\node[n] (b) at (4.6,0) {Apetito global por el riesgo};
\node[n] (c) at (9.2,0) {Cr\'edito y precios de activos en el resto};
\node[n] (d) at (13.8,0){Condiciones financieras que nadie eligi\'o};
\draw[->, very thick] (a) -- (b);
\draw[->, very thick] (b) -- (c);
\draw[->, very thick] (c) -- (d);
\node[font=\scriptsize, align=center, anchor=north] (tc) at (6.9,-1.25) {tipo de cambio flexible};
\draw[thick] (6.9,-0.75) -- (6.9,-0.25);
\draw[very thick] (6.6,-0.75) -- (7.2,-0.25);
\draw[very thick] (6.6,-0.25) -- (7.2,-0.75);
\end{tikzpicture}
