% Anexo IV.6 - Los episodios de coordinacion y su resultado.
\begin{tikzpicture}[>={Stealth[length=2.4mm]}, every node/.style={font=\footnotesize},
  ok/.style={draw, thick, rounded corners=2pt, fill=black!6, inner sep=3pt, font=\scriptsize, align=center},
  no/.style={draw, thick, dashed, rounded corners=2pt, inner sep=3pt, font=\scriptsize, align=center}]

\draw[->, very thick] (0,0) -- (15.3,0);
\foreach \x/\a in {0.6/1944, 3.9/1978, 5.6/1985, 6.5/1987, 9.6/2009, 11.0/2016, 12.4/2021, 14.4/2026} {
  \draw[thick] (\x,-0.16) -- (\x,0.16);
  \node[font=\scriptsize, anchor=north] at (\x,-0.22) {\a};
}
\node[ok] (bw)   at (0.9,1.45)  {Bretton Woods};
\node[no] (bonn) at (3.9,2.45)  {Bonn};
\node[ok] (plaza)at (5.3,1.45)  {Plaza};
\node[no] (louv) at (7.3,2.45)  {Louvre};
\node[ok] (lon)  at (9.6,1.45)  {Londres};
\node[ok] (sha)  at (11.3,2.45) {Shangh\'ai};
\node[ok] (fis)  at (12.6,1.45) {Acuerdo fiscal};
\node[no] (frag) at (14.3,2.45) {Fragmentaci\'on};
\foreach \n/\x in {bw/0.6, bonn/3.9, plaza/5.6, louv/6.5, lon/9.6, sha/11.0, fis/12.4, frag/14.4} {
  \draw[thick] (\n) -- (\x,0.2);
}
\end{tikzpicture}
