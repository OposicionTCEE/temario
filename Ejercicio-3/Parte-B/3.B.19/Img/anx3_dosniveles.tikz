% Anexo III.3 - Juegos de dos niveles: conjuntos ganadores y paradoja de la debilidad.
\begin{tikzpicture}[>={Stealth[length=2.2mm]}, every node/.style={font=\footnotesize}]
\foreach \k/\dy/\tit/\abar in {0/0/{(a) Conjuntos ganadores amplios}/{5.6}, 1/-3.95/{(b) $A$ se ata las manos}/{3.9}} {
  \begin{scope}[yshift=\dy cm]
    \node[font=\footnotesize\bfseries, anchor=west] at (0,1.95) {\tit};
    \draw[->] (0,0) -- (8.4,0);
    \node[font=\scriptsize, anchor=north east] at (0.6,-0.12) {m\'as favorable a $A$};
    \node[font=\scriptsize, anchor=north west] at (7.6,-0.12) {m\'as favorable a $B$};
    % zona de acuerdo
    \fill[black!14] (2.4,-0.22) rectangle (\abar,0.22);
    % conjunto ganador de A: a la izquierda de abar
    \draw[very thick] (0.6,0.95) -- (\abar,0.95);
    \draw[very thick] (\abar,0.78) -- (\abar,1.12);
    \node[anchor=west, font=\scriptsize] at (0.65,1.30) {conjunto ganador de $A$};
    \node[font=\scriptsize, anchor=south] at (\abar,1.16) {$\bar a$};
    % conjunto ganador de B: a la derecha de 2.4
    \draw[very thick] (2.4,-1.05) -- (7.8,-1.05);
    \draw[very thick] (2.4,-1.22) -- (2.4,-0.88);
    \node[anchor=east, font=\scriptsize] at (7.75,-1.42) {conjunto ganador de $B$};
    \node[font=\scriptsize, anchor=north] at (2.4,-1.26) {$\bar b$};
  \end{scope}
}
\end{tikzpicture}
