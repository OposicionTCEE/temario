% Anexo I.3 - CORSETTI y PESENTI: expansion fiscal permanente.
\begin{tikzpicture}[>={Stealth[length=2.2mm]}, every node/.style={font=\footnotesize}]
\begin{scope}
  \node[font=\footnotesize\bfseries] at (2.6,4.75) {(a) Pa\'is $A$: m\'as horas, menos consumo privado};
  \draw[->] (0,0) -- (5.2,0) node[below=2pt, pos=0.97]{$L$};
  \draw[->] (0,0) -- (0,4.4) node[left=2pt]{$C$};
  \draw[gray,thick] (0,0) -- (4.30,4.085) node[above left=-3pt and -3pt]{\textcolor{gray}{$OA_0$}};
  \draw[thick] (0,0) -- (4.90,4.116) node[right=-2pt]{$OA_1$};
  \draw[gray,thick] (0.15,2.20) -- (4.60,2.20) node[above right=-3pt and -2pt]{\textcolor{gray}{$DA_0$}};
  \draw[thick] (0.15,2.10) -- (4.60,2.10) node[below right=-3pt and -2pt]{$DA_1$};
  \draw[gray,thick, densely dotted] (2.316,0) -- (2.316,4.15) node[above left=-3pt and -3pt]{\textcolor{gray}{$\bar L_0$}};
  \draw[thick, densely dotted] (2.750,0) -- (2.750,4.15) node[above right=-3pt and -3pt]{$\bar L_1$};
  \draw[gray,thick] plot[domain=1.80:2.90, samples=25] (\x, {1.234+0.18*\x*\x}) node[above left=-3pt and -3pt]{\textcolor{gray}{$U_0$}};
  \fill (2.316,2.20) circle (1.7pt) node[above left=-1pt and -2pt]{$E_0$};
  \fill (2.500,2.10) circle (1.7pt) node[below right=0pt and -1pt]{$E_1$};
  \node[align=left, anchor=north west, font=\scriptsize] at (0.0,-0.45)
    {1 parte de la producci\'on va al sector p\'ublico: $OA_0\to OA_1$\\[-1pt]
     2 el empleo de precios flexibles sube con $g$: $\bar L_0\to\bar L_1$\\[-1pt]
     3 los precios suben y la moneda se aprecia: $DA_0\to DA_1$\\[-1pt]
     4 en $E_1$ se trabaja m\'as y el consumo privado cae};
\end{scope}
\begin{scope}[xshift=7.6cm]
  \node[font=\footnotesize\bfseries] at (2.6,4.75) {(b) Pa\'is $B$: empobrecer al vecino};
  \draw[->] (0,0) -- (5.2,0) node[below=2pt, pos=0.97]{$L^{*}$};
  \draw[->] (0,0) -- (0,4.4) node[left=2pt]{$C^{*}$};
  \draw[gray,thick] (0,0) -- (4.30,4.085) node[above left=-3pt and -3pt]{\textcolor{gray}{$OA^{*}_0$}};
  \draw[thick] (0,0) -- (4.95,4.059) node[right=-2pt]{$OA^{*}_1$};
  \draw[gray,thick] (0.15,2.20) -- (4.60,2.20) node[above right=-3pt and -2pt]{\textcolor{gray}{$DA^{*}_0$}};
  \draw[thick] (0.15,2.05) -- (4.60,2.05) node[below right=-3pt and -2pt]{$DA^{*}_1$};
  \draw[thick, densely dotted] (2.316,0) -- (2.316,4.15) node[above=-1pt]{$\bar L^{*}$};
  \draw[gray,thick] plot[domain=1.80:2.90, samples=25] (\x, {1.234+0.18*\x*\x}) node[above left=-3pt and -3pt]{\textcolor{gray}{$U^{*}_0$}};
  \draw[thick] plot[domain=2.05:3.15, samples=25] (\x, {0.925+0.18*\x*\x}) node[below right=-3pt and -3pt]{$U^{*}_1$};
  \fill (2.316,2.20) circle (1.7pt) node[above left=-1pt and -2pt]{$E^{*}_0$};
  \fill (2.500,2.05) circle (1.7pt) node[below right=0pt and -1pt]{$E^{*}_1$};
  \node[align=left, anchor=north west, font=\scriptsize] at (0.0,-0.45)
    {1 la apreciaci\'on de $A$ empeora $\tau^{*}$: $OA^{*}_0\to OA^{*}_1$\\[-1pt]
     2 y encarece la cesta de consumo: $DA^{*}_0\to DA^{*}_1$\\[-1pt]
     3 en $E^{*}_1$ se trabaja m\'as y se consume menos: $U^{*}_0\to U^{*}_1$};
\end{scope}
\end{tikzpicture}
