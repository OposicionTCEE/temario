% requiere calc
% Cuerpo, bloque 1 - El trilema leido como tres formas de estar entrelazado.
\begin{tikzpicture}[>={Stealth[length=2.4mm]}, every node/.style={font=\footnotesize},
  v/.style={draw, very thick, rounded corners=2pt, fill=white, text width=2.5cm, align=center, inner sep=3pt, font=\scriptsize},
  l/.style={font=\scriptsize, align=center, fill=white, inner sep=2pt}]
  \coordinate (A) at (90:3.0);
  \coordinate (B) at (210:3.0);
  \coordinate (C) at (330:3.0);
  \draw[very thick] (A) -- (B) -- (C) -- cycle;
  \node[l] at ($(A)!0.5!(B)$) {R\'egimen de tipo fijo:\\ \textbf{importa} la pol\'itica\\ monetaria del ancla};
  \node[l] at ($(A)!0.5!(C)$) {Flotaci\'on:\\ \textbf{exporta} el ajuste\\ por el tipo de cambio};
  \node[l] at ($(B)!0.5!(C)$) {Cuenta financiera cerrada:\\ \textbf{conserva} los dos, y asigna peor el ahorro};
  \node[v] at (A) {Libre movilidad del capital};
  \node[v] at (B) {Tipo de cambio fijo};
  \node[v] at (C) {Pol\'itica monetaria aut\'onoma};
\end{tikzpicture}
