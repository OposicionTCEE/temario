% Cuerpo, bloque 1 - El saldo exterior como espejo: una curva y su reflejo, y el precio relativo que
% los equilibra. El saldo de A crece con su tipo real; el de B es la misma curva cambiada de signo,
% porque lo que uno vende el otro lo compra. Un aumento del gasto de A desplaza su curva a XN_A' y el
% precio que lo deja sin saldo pasa de q_0 (E_0) a q_1 (E_1): A tiene que abaratarse.
% Base comun con b1_equilibrio_externo del 3.B.14 (exportaciones netas frente al tipo de cambio real).
% Compilar con: bash Code/generar_figura.sh b1_espejo
\begin{tikzpicture}
\footnotesize
\begin{axis}[
  scale only axis, width=9.4cm, height=5.0cm, axis lines=middle, tick style={draw=none},
  every axis label/.style={font=\footnotesize}, tick label style={font=\footnotesize},
  xmin=0, xmax=10.4, ymin=-3.3, ymax=3.5, clip=false, xtick=\empty, ytick=\empty,
]
\addplot[black, line width=1pt, domain=0.5:9.9, samples=120] {2.4*tanh((x-4)/1.8)};
\addplot[black, line width=1pt, domain=0.5:9.9, samples=120] {-2.4*tanh((x-4)/1.8)};
\addplot[black, line width=0.8pt, densely dashed, domain=0.5:9.9, samples=120] {2.4*tanh((x-6.4)/1.8)};
\node[anchor=west, font=\footnotesize] at (axis cs:9.95,2.40) {$XN_A$};
\node[anchor=west, font=\footnotesize] at (axis cs:9.95,-2.40) {$XN_B=-XN_A$};
\node[anchor=west, font=\footnotesize] at (axis cs:7.35,0.45) {$XN_A'$};
\draw[black!45, dotted] (axis cs:4,0) -- (axis cs:4,-3.3) node[anchor=north, black, font=\footnotesize] {$q_0$};
\draw[black!45, dotted] (axis cs:6.4,0) -- (axis cs:6.4,-3.3) node[anchor=north, black, font=\footnotesize] {$q_1$};
\fill[black] (axis cs:4,0) circle (1.8pt);
\fill[black] (axis cs:6.4,0) circle (1.8pt);
\node[anchor=center, font=\footnotesize, fill=white, inner sep=1pt] at (axis cs:3.50,0.68) {$E_0$};
\node[anchor=center, font=\footnotesize, fill=white, inner sep=1pt] at (axis cs:5.90,0.68) {$E_1$};
\node[anchor=south west, font=\footnotesize] at (axis cs:0,3.5) {Saldo exterior};
\node[anchor=north east, font=\footnotesize] at (axis cs:10.4,-0.18) {Tipo de cambio real de $A$, $q$};
\end{axis}
\end{tikzpicture}
