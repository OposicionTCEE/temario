% Cuerpo, bloque 1 - La identidad: el aumento del gasto de A abre una brecha.
% Se dibuja solo el lado de A, porque el del socio se sigue sensu contrario: lo que uno compra el
% otro lo vende, de modo que el deficit de A es, con el signo cambiado, el superavit de B. En E_0,
% con q_0, A no tiene saldo; el aumento de su gasto desplaza la curva a XN_A' y al precio de antes
% se abre la brecha. Aqui NO se muestra el ajuste: las dos formas de absorberla van en b1_ajuste.
% Base comun con b1_equilibrio_externo del 3.B.14 (exportaciones netas frente al tipo de cambio real).
% Compilar con: bash Code/generar_figura.sh b1_espejo
\begin{tikzpicture}
\footnotesize
\begin{axis}[
  scale only axis, width=9.4cm, height=4.4cm, axis lines=middle, tick style={draw=none},
  every axis label/.style={font=\footnotesize}, tick label style={font=\footnotesize},
  xmin=0, xmax=10.4, ymin=-2.9, ymax=2.9, clip=false, xtick=\empty, ytick=\empty,
]
\addplot[black, line width=1pt, domain=0.5:9.9, samples=120] {2.4*tanh((x-4)/1.8)};
\addplot[black, line width=0.8pt, densely dashed, domain=0.5:9.9, samples=120] {2.4*tanh((x-4)/1.8)-1.2};
\node[anchor=west, font=\footnotesize] at (axis cs:9.95,2.33) {$XN_A$};
\node[anchor=west, font=\footnotesize] at (axis cs:9.95,1.13) {$XN_A'$};
\draw[black!45, dotted] (axis cs:4,-1.2) -- (axis cs:4,-2.9) node[anchor=north, black, font=\footnotesize] {$q_0$};
\draw[black!45, dotted] (axis cs:0.1,-1.2) -- (axis cs:4,-1.2);
\draw[->, very thick] (axis cs:4,-0.22) -- (axis cs:4,-1.12);
\fill[black] (axis cs:4,0) circle (1.8pt);
\fill[black] (axis cs:4,-1.2) circle (1.8pt);
\node[anchor=south east, font=\footnotesize, fill=white, inner sep=1.5pt] at (axis cs:3.88,0.10) {$E_0$};
\node[anchor=north west, font=\scriptsize, fill=white, inner sep=1.5pt] at (axis cs:0.20,-1.28) {déficit de $A$ $=$ superávit de $B$};
\node[anchor=south west, font=\footnotesize] at (axis cs:0,2.9) {Saldo exterior};
\node[anchor=north east, font=\footnotesize] at (axis cs:10.4,-0.18) {$q_A$};
\end{axis}
\end{tikzpicture}
