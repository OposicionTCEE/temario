% Cuerpo, bloque 1 - El saldo exterior de uno es el espejo del otro y los dos margenes de ajuste.
\begin{tikzpicture}[>={Stealth[length=2.5mm]}, every node/.style={font=\footnotesize},
  p/.style={draw, very thick, rounded corners=2pt, text width=4.0cm, align=center, inner sep=4pt, minimum height=1.15cm},
  m/.style={draw, thick, fill=black!5, rounded corners=2pt, text width=4.4cm, align=center, inner sep=4pt, minimum height=1.25cm}]

\node[p] (a) at (0,3.0) {El pa\'is $A$ gasta por encima de su renta};
\node[p] (b) at (7.8,3.0) {El pa\'is $B$ gasta por debajo de la suya};
\draw[<->, very thick] (a) -- node[above, font=\scriptsize]{$XN+XN^{*}=0$} (b);

\node[m] (m1) at (5.3,0.6) {$B$ produce m\'as:\\ \textbf{efecto locomotora}};
\node[m] (m2) at (10.5,0.6) {$B$ gasta menos:\\ \textbf{empobrecer al vecino}};
\draw[->, thick] (b.south) -- ++(0,-0.55) -| (m1.north);
\draw[->, thick] (b.south) -- ++(0,-0.55) -| (m2.north);
\node[font=\scriptsize, anchor=south east] at (7.55,1.95) {lo decide el precio relativo};
\end{tikzpicture}
