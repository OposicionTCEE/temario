% Cuerpo, bloque 1 - La identidad: el gasto de A abre una brecha que es el superavit de B.
% El saldo de A crece con su tipo real; el de B es la misma curva cambiada de signo, porque lo que uno
% vende el otro lo compra. En E_0, con q_0, ninguno de los dos tiene saldo. Un aumento del gasto de A
% baja su saldo a cada precio (XN_A', y su reflejo XN_B'), de modo que al precio de antes se abre una
% brecha cuyas dos mitades son la misma cosa: el deficit de A es, exactamente, el superavit de B.
% Aqui NO se muestra el ajuste: las dos formas de absorber la brecha van en b1_ajuste.
% Base comun con b1_equilibrio_externo del 3.B.14 (exportaciones netas frente al tipo de cambio real).
% Compilar con: bash Code/generar_figura.sh b1_espejo
\begin{tikzpicture}
\footnotesize
\begin{axis}[
  scale only axis, width=9.4cm, height=5.0cm, axis lines=middle, tick style={draw=none},
  every axis label/.style={font=\footnotesize}, tick label style={font=\footnotesize},
  xmin=0, xmax=10.4, ymin=-3.3, ymax=3.5, clip=false, xtick=\empty, ytick=\empty,
]
\addplot[black, line width=1pt, domain=0.5:9.9, samples=120] {2.4*tanh((x-4)/1.8)};
\addplot[black, line width=1pt, domain=0.5:9.9, samples=120] {-2.4*tanh((x-4)/1.8)};
\addplot[black, line width=0.8pt, densely dashed, domain=0.5:9.9, samples=120] {2.4*tanh((x-4)/1.8)-1.2};
\addplot[black, line width=0.8pt, densely dashed, domain=0.5:9.9, samples=120] {-2.4*tanh((x-4)/1.8)+1.2};
\node[anchor=west, font=\footnotesize] at (axis cs:9.95,2.33) {$XN_A$};
\node[anchor=west, font=\footnotesize] at (axis cs:9.95,1.13) {$XN_A'$};
\node[anchor=west, font=\footnotesize] at (axis cs:9.95,-1.13) {$XN_B'$};
\node[anchor=west, font=\footnotesize] at (axis cs:9.95,-2.33) {$XN_B=-XN_A$};
\draw[black!45, dotted] (axis cs:4,-1.2) -- (axis cs:4,-3.3) node[anchor=north, black, font=\footnotesize] {$q_0$};
\draw[<->, very thick] (axis cs:4,1.08) -- (axis cs:4,-1.08);
\fill[black] (axis cs:4,0) circle (1.8pt);
\fill[black] (axis cs:4,1.2) circle (1.8pt);
\fill[black] (axis cs:4,-1.2) circle (1.8pt);
\node[anchor=west, font=\scriptsize, fill=white, inner sep=1.5pt] at (axis cs:4.14,0.62) {superávit de $B$};
\node[anchor=west, font=\scriptsize, fill=white, inner sep=1.5pt] at (axis cs:4.14,-0.62) {déficit de $A$};
\node[anchor=center, font=\footnotesize, fill=white, inner sep=1pt] at (axis cs:3.46,0.62) {$E_0$};
\node[anchor=south west, font=\footnotesize] at (axis cs:0,3.5) {Saldo exterior};
\node[anchor=north east, font=\footnotesize] at (axis cs:10.4,-0.18) {$q_A$};
\end{axis}
\end{tikzpicture}
