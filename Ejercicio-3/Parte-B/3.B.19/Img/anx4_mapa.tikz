% Anexo IV.1 - El mapa de los foros en dos planos. (a) Composicion y fuerza del compromiso: la nube no
% se ordena, porque hay clubes reducidos sin obligacion alguna y clubes reducidos cuyos estandares se
% cumplen en todas partes. (b) Amplitud de la materia y fuerza del compromiso: ahi si hay canje, porque
% solo puede hacerse exigible lo que puede especificarse, y los foros se alinean sobre la diagonal; la
% Union Europea queda fuera y senala su precio. El cuerpo lleva la version reducida, con menos foros.
% Compilar con: bash Code/generar_figura.sh anx4_mapa
\begin{tikzpicture}[x=1.0cm, y=1.0cm, >={Stealth[length=2.2mm]}, every node/.style={font=\footnotesize},
  f/.style={draw, thick, rounded corners=2pt, fill=white, inner sep=2.5pt, font=\scriptsize}]
% ---------- panel (a): composicion ----------
\begin{scope}
  \node[font=\footnotesize\bfseries, anchor=west] at (0,5.85) {(a) Composici\'on: el n\'umero de miembros no ordena nada};
  \draw[->] (0,0) -- (13.2,0) node[below=3pt, pos=0.985]{\scriptsize composici\'on};
  \draw[->] (0,0) -- (0,5.45);
  \node[font=\scriptsize, anchor=north] at (1.6,-0.15) {club reducido};
  \node[font=\scriptsize, anchor=north] at (11.3,-0.15) {universal};
  \node[font=\scriptsize, rotate=90, anchor=south] at (-0.52,0.35) {compromiso blando};
  \node[font=\scriptsize, rotate=90, anchor=south] at (-0.52,3.55) {compromiso duro};
  \node[f] at (1.5,0.65)  {G-7};
  \node[f] at (4.0,1.05)  {G-20};
  \node[f] at (1.7,2.05)  {Basilea};
  \node[f] at (4.2,2.50)  {FSB};
  \node[f] at (6.6,1.60)  {OCDE};
  \node[f] at (7.2,2.20)  {BPI};
  \node[f] at (9.6,1.40)  {Banco Mundial};
  \node[f] at (10.0,3.05) {FMI};
  \node[f] at (10.3,4.45) {OMC};
  \node[f] at (12.4,0.70) {ONU};
  \node[f] at (3.2,4.60)  {UE};
\end{scope}
% ---------- panel (b): amplitud de la materia ----------
\begin{scope}[yshift=-7.3cm]
  \node[font=\footnotesize\bfseries, anchor=west] at (0,5.85) {(b) Amplitud de la materia: aqu\'i s\'i hay canje};
  \draw[->] (0,0) -- (13.2,0) node[below=3pt, pos=0.985]{\scriptsize materia};
  \draw[->] (0,0) -- (0,5.45);
  \node[font=\scriptsize, anchor=north] at (1.4,-0.15) {acotada};
  \node[font=\scriptsize, anchor=north] at (11.5,-0.15) {general};
  \node[font=\scriptsize, rotate=90, anchor=south] at (-0.52,0.35) {compromiso blando};
  \node[font=\scriptsize, rotate=90, anchor=south] at (-0.52,3.55) {compromiso duro};
  \draw[densely dashed, black!55, thick] (0.5,4.95) -- (12.7,0.40);
  \node[f] at (1.0,4.45)  {OMC};
  \node[f] at (2.3,3.85)  {Basilea};
  \node[f] at (3.4,3.00)  {FSB};
  \node[f] at (2.7,2.05)  {BPI};
  \node[f] at (4.7,3.05)  {FMI};
  \node[f] at (6.4,1.45)  {Banco Mundial};
  \node[f] at (8.4,2.10)  {OCDE};
  \node[f] at (9.3,4.60)  {UE};
  \node[f] at (9.7,1.15)  {G-20};
  \node[f] at (10.9,0.60) {G-7};
  \node[f] at (12.4,0.70) {ONU};
\end{scope}
\end{tikzpicture}
