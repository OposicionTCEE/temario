% Anexo IV.2 - El ciclo de la revision por pares.
\begin{tikzpicture}[>={Stealth[length=2.4mm]}, every node/.style={font=\footnotesize},
  c/.style={draw, thick, rounded corners=2pt, text width=2.35cm, align=center, inner sep=3pt, minimum height=1.0cm}]
  \node[c] (a) at (0,0)    {El pa\'is informa de lo que hace};
  \node[c] (b) at (3.1,0)  {El secretariado lo analiza con datos comparables};
  \node[c] (c) at (6.2,0)  {El comit\'e de pares lo examina y pregunta};
  \node[c] (d) at (9.3,0)  {El informe se publica};
  \node[c] (e) at (12.4,0) {El seguimiento vuelve sobre lo no corregido};
  \draw[->, thick] (a) -- (b); \draw[->, thick] (b) -- (c);
  \draw[->, thick] (c) -- (d); \draw[->, thick] (d) -- (e);
  \draw[->, thick, gray] (e.north) -- ++(0,0.85) -- ++(-12.4,0) -- (a.north);
\end{tikzpicture}
