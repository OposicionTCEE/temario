% Anexo II.4 - ROGOFF (1985): por que cooperar puede elevar el sesgo inflacionista.
\begin{tikzpicture}[>={Stealth[length=2.3mm]}, every node/.style={font=\footnotesize},
  n/.style={draw, thick, rounded corners=2pt, text width=2.45cm, align=center, inner sep=3pt, minimum height=1.05cm},
  g/.style={draw, thick, fill=black!5, rounded corners=2pt, text width=2.45cm, align=center, inner sep=3pt, minimum height=1.05cm}]

\node[font=\footnotesize\bfseries, anchor=west] at (-0.1,2.75) {Sin acuerdo};
\node[n] (a1) at (1.45,1.75) {Expansi\'on de un banco central};
\node[n] (a2) at (4.55,1.75) {Su moneda se deprecia};
\node[n] (a3) at (7.65,1.75) {Suben los precios de importaci\'on};
\node[n] (a4) at (10.75,1.75) {Inflar sale caro};
\node[g] (a5) at (13.85,1.75) {Sesgo inflacionista bajo};
\draw[->, thick] (a1) -- (a2); \draw[->, thick] (a2) -- (a3);
\draw[->, thick] (a3) -- (a4); \draw[->, thick] (a4) -- (a5);

\node[font=\footnotesize\bfseries, anchor=west] at (-0.1,0.35) {Con acuerdo};
\node[n] (b1) at (1.45,-0.65) {Expansi\'on de los dos a la vez};
\node[n] (b2) at (4.55,-0.65) {El tipo de cambio no se mueve};
\node[n] (b3) at (7.65,-0.65) {Los precios de importaci\'on no suben};
\node[n] (b4) at (10.75,-0.65) {Inflar sale barato};
\node[g] (b5) at (13.85,-0.65) {Sesgo inflacionista alto};
\draw[->, thick] (b1) -- (b2); \draw[->, thick] (b2) -- (b3);
\draw[->, thick] (b3) -- (b4); \draw[->, thick] (b4) -- (b5);
\end{tikzpicture}
