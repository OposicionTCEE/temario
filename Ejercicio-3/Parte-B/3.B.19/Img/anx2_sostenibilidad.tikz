% Anexo II.5-II.6 - Sobre la misma base del espacio de politicas: la tentacion
% de desviarse del acuerdo y el tramo de acuerdos que mejoran a los dos.
\begin{tikzpicture}[x=1.15cm, y=1.15cm, >={Stealth[length=2.2mm]}, every node/.style={font=\footnotesize}]
\begin{scope}
  \node[font=\footnotesize\bfseries] at (2.8,5.75) {(a) La tentaci\'on de desviarse};
  \draw[->] (0,0) -- (5.3,0) node[below=2pt, pos=0.96]{$z^{*}$};
  \draw[->] (0,0) -- (0,5.3) node[left=2pt]{$z$};
  \draw[thick] (0,2.61) -- (5.1,0.825) node[below right=-2pt and -3pt]{$R_A$};
  \draw[thick] (2.61,0) -- (0.86,5.0) node[above=-1pt]{$R_B$};
  \draw[very thick] (4.6,1.0) .. controls (3.65,1.35) and (1.35,3.65) .. (1.0,4.6);
  \fill (1.933,1.933) circle (1.9pt) node[below left=-1pt and -2pt]{$N$};
  \fill (2.594,2.594) circle (1.9pt) node[above right=-2pt and -1pt]{$C$};
  \fill (2.594,1.702) circle (1.9pt) node[below right=-1pt and -1pt]{$F$};
  \draw[->, very thick] (2.594,2.47) -- (2.594,1.84);
  \draw[->, very thick, dashed] (2.50,1.68) -- (2.03,1.90);
\end{scope}
\begin{scope}[xshift=7.4cm]
  \node[font=\footnotesize\bfseries] at (2.8,5.75) {(b) Los acuerdos que mejoran a los dos};
  \draw[->] (0,0) -- (5.3,0) node[below=2pt, pos=0.96]{$z^{*}$};
  \draw[->] (0,0) -- (0,5.3) node[left=2pt]{$z$};
  \draw[gray, thick] plot[domain=-126:-27, samples=50, variable=\t]
      ({4.6+2.667*sin(\t)}, {1.0+2.066*cos(\t)-0.933*sin(\t)}) node[below right=-3pt and -3pt]{\textcolor{gray}{$U_A$}};
  \draw[gray, thick, dashed] plot[domain=-126:-27, samples=50, variable=\t]
      ({1.0+2.066*cos(\t)-0.933*sin(\t)}, {4.6+2.667*sin(\t)}) node[above left=-3pt and -3pt]{\textcolor{gray}{$U_B$}};
  \draw[thick] (4.6,1.0) .. controls (3.65,1.35) and (1.35,3.65) .. (1.0,4.6);
  \draw[line width=1.9pt] (2.852,2.305) .. controls (2.72,2.44) and (2.44,2.72) .. (2.305,2.852);
  \fill (1.933,1.933) circle (1.9pt) node[below left=-1pt and -2pt]{$N$};
  \fill (2.852,2.305) circle (1.7pt) node[right=1pt]{$P_A$};
  \fill (2.305,2.852) circle (1.7pt) node[above=1pt]{$P_B$};
  \fill (2.575,2.575) circle (1.9pt) node[above right=-2pt and 0pt]{$C$};
\end{scope}
\end{tikzpicture}
