% Anexo IV.3 - El G-20 como foro que encarga: dos vias y los organismos que ejecutan.
\begin{tikzpicture}[>={Stealth[length=2.4mm]}, every node/.style={font=\footnotesize},
  g/.style={draw, very thick, rounded corners=2pt, text width=3.5cm, align=center, inner sep=4pt, minimum height=1.15cm},
  v/.style={draw, thick, fill=black!5, rounded corners=2pt, text width=3.1cm, align=center, inner sep=3pt, minimum height=0.9cm},
  o/.style={draw, thick, rounded corners=2pt, text width=2.5cm, align=center, inner sep=3pt, minimum height=0.85cm}]

\node[g] (g20) at (6.3,4.3) {\textbf{Cumbre del G-20}\\[1pt]\scriptsize presidencia rotatoria y troika};
\node[v] (fin) at (3.4,2.6) {V\'ia financiera:\\ministros y gobernadores};
\node[v] (sher) at (9.2,2.6) {V\'ia de los sherpas:\\el resto de materias};
\draw[->, thick] (g20) -- (fin);
\draw[->, thick] (g20) -- (sher);

\node[o] (fsb) at (0.8,0.7)  {FSB};
\node[o] (fmi) at (4.0,0.7)  {FMI};
\node[o] (bas) at (7.2,0.7)  {Comit\'e de Basilea};
\node[o] (ocde) at (10.4,0.7) {OCDE};
\draw[->, thick] (fin) -- (fsb);
\draw[->, thick] (fin) -- (fmi);
\draw[->, thick] (fin) -- (bas);
\draw[->, thick] (sher) -- (ocde);
\draw[->, thick] (sher) -- (bas);

\draw[->, thick, gray] (fsb.west) -- (-0.95,0.7) -- (-0.95,4.3) -- (g20.west);
\end{tikzpicture}
