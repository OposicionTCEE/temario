% Cuerpo, bloque 3 - El reparto: lo que mejora a los dos no es un punto, es un tramo.
% Modificacion parcial de b2_grados: la lente sombreada son los acuerdos que mejoran a los dos
% respecto de N, y la recta que une los dos optimos son los eficientes. Su interseccion es el tramo
% grueso, limitado por P_B, donde A esta tan bien como en N y no aceptaria menos, y por P_A, el
% simetrico. Cualquier punto del tramo es eficiente; cual se firma no lo decide la eficiencia.
% C es el punto medio, que solo sale con paises simetricos.
% Compilar con: bash Code/generar_figura.sh b3_reparto
\begin{tikzpicture}[x=1.5cm, y=1.5cm, >={Stealth[length=2.4mm]}, every node/.style={font=\footnotesize}]
  \draw[->] (0,0) -- (4.6,0) node[below=2pt, pos=0.95]{$z_{B}$};
  \draw[->] (0,0) -- (0,4.6) node[left=2pt]{$z_{A}$};
  % --- lente de mejora mutua: interseccion de los conjuntos mejores en N ---
  \fill[black!9] plot[domain=90:159.65, samples=50, variable=\t]
      ({4.3+2.2165*cos(\t)-0.8309*sin(\t)}, {1.11+2.3671*sin(\t)}) --
      plot[domain=159.65:90, samples=50, variable=\t]
      ({1.11+2.3671*sin(\t)}, {4.3+2.2165*cos(\t)-0.8309*sin(\t)}) -- cycle;
  % --- curvas de indiferencia que pasan por N ---
  \draw[black!70, line width=0.7pt] plot[domain=70:170, samples=70, variable=\t]
      ({4.3+2.2165*cos(\t)-0.8309*sin(\t)}, {1.11+2.3671*sin(\t)});
  \draw[black!70, line width=0.7pt] plot[domain=70:170, samples=70, variable=\t]
      ({1.11+2.3671*sin(\t)}, {4.3+2.2165*cos(\t)-0.8309*sin(\t)});
  \node[font=\scriptsize, anchor=south west] at (4.30,3.36) {$W_A$};
  \node[font=\scriptsize, anchor=south west] at (3.30,4.32) {$W_B$};
  % --- acuerdos eficientes y, dentro de ellos, el tramo que mejora a los dos ---
  \draw[black!55, line width=0.7pt] (4.3,1.11) -- (1.11,4.3);
  \draw[line width=1.6pt] (3.056,2.355) -- (2.355,3.056);
  % --- optimo de cada pais ---
  \fill (4.3,1.11) circle (2.0pt);
  \fill (1.11,4.3) circle (2.0pt);
  \node[font=\footnotesize, anchor=north] at (4.30,1.00) {$B_A$};
  \node[font=\footnotesize, anchor=east] at (1.00,4.30) {$B_B$};
  % --- el tramo y sus extremos ---
  \fill (1.933,1.933) circle (2.0pt) node[below left=-1pt and -2pt]{$N$};
  \fill (3.056,2.355) circle (2.0pt);
  \fill (2.355,3.056) circle (2.0pt);
  \fill (2.705,2.705) circle (2.0pt);
  \node[font=\footnotesize, anchor=west] at (3.14,2.30) {$P_A$};
  \node[font=\footnotesize, anchor=east] at (2.27,3.11) {$P_B$};
  \node[font=\footnotesize, anchor=north east] at (2.63,2.63) {$C$};
\end{tikzpicture}
