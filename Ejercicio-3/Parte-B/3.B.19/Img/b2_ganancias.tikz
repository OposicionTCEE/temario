% Cuerpo, bloque 2 - La ganancia de coordinar es de segundo orden y el coste de coordinar no lo es.
% La curva es el bienestar conjunto, casi plana alrededor de su maximo z^C: pasar de z^N a z^C exige
% mover mucho las politicas (corchete horizontal) y sube muy poco (corchete vertical). La recta que
% arranca del punto de partida mide, sobre el mismo eje, lo que cuesta pactar y hacer cumplir lo
% pactado, que crece con lo que se pacta; coordinarse solo compensa donde la curva queda por encima
% de la recta, que es la franja sombreada, y el punto de plena cooperacion ya ha quedado por debajo.
% Los corchetes apuntan hacia los ejes (de ahi el mirror). Compilar con: bash Code/generar_figura.sh b2_ganancias
\begin{tikzpicture}[>={Stealth[length=2.4mm]}, every node/.style={font=\footnotesize},
  decoration={brace, amplitude=5pt}]
  \fill[black!10] plot[domain=2.2:5.601, samples=60] (\x, {2.0-0.03808*(\x-6)*(\x-6)}) --
                  plot[domain=5.601:2.2, samples=60] (\x, {1.45+0.16*(\x-2.2)}) -- cycle;
  \draw[->] (0,0) -- (8.0,0) node[below=2pt, pos=0.97]{$z$};
  \draw[->] (0,0) -- (0,2.7) node[left=2pt, align=center]{bienestar\\[-2pt]conjunto};
  \draw[very thick] plot[domain=1.4:7.6, samples=90] (\x, {2.0-0.03808*(\x-6)*(\x-6)});
  \draw[thick] (2.2,1.45) -- (7.4,2.282);
  \node[font=\scriptsize, anchor=south] at (6.1,2.20) {coste de coordinar};
  \draw[densely dotted] (2.2,0) -- (2.2,1.45);
  \draw[densely dotted] (6.0,0) -- (6.0,2.0);
  \draw[densely dotted] (2.2,1.45) -- (8.0,1.45);
  \draw[densely dotted] (6.0,2.0) -- (8.0,2.0);
  \node[font=\scriptsize, anchor=north] at (2.2,-0.08) {$z^{N}$};
  \node[font=\scriptsize, anchor=north] at (6.0,-0.08) {$z^{C}$};
  \draw[decorate, decoration={brace, mirror, amplitude=5pt}] (8.15,2.0) -- (8.15,1.45);
  \node[font=\scriptsize, anchor=west] at (8.42,1.72) {lo que se gana};
  \draw[decorate, decoration={brace, mirror, amplitude=5pt}] (6.0,-0.62) -- (2.2,-0.62);
  \node[font=\scriptsize, anchor=north] at (4.1,-0.86) {lo que hay que moverse};
  \draw[black!60, line width=0.4pt] (3.52,1.34) -- (3.80,1.74);
  \node[font=\scriptsize, anchor=north] at (3.40,1.30) {lo que queda};
\end{tikzpicture}
