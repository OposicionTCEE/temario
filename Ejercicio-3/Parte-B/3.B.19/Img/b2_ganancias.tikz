% Cuerpo, bloque 2 - El bienestar conjunto es plano alrededor del equilibrio: moverse mucho vale poco.
\begin{tikzpicture}[>={Stealth[length=2.4mm]}, every node/.style={font=\footnotesize},
  decoration={brace, amplitude=5pt}]
  \draw[->] (0,0) -- (8.4,0) node[below=2pt, pos=0.97]{$z$};
  \draw[->] (0,0) -- (0,4.9) node[left=2pt, align=center]{bienestar\\[-2pt]conjunto};
  \draw[very thick] plot[domain=0.6:7.6, samples=80] (\x, {4.05-0.16*(\x-5.4)*(\x-5.4)});
  \draw[densely dotted] (3.2,0) -- (3.2,3.27);
  \draw[densely dotted] (5.4,0) -- (5.4,4.05);
  \node[font=\scriptsize, anchor=north] at (3.2,-0.08) {$z^{N}$};
  \node[font=\scriptsize, anchor=north] at (5.4,-0.08) {$z^{C}$};
  \fill (3.2,3.27) circle (2.0pt);
  \fill (5.4,4.05) circle (2.0pt);
  \draw[decorate] (5.75,3.27) -- (5.75,4.05);
  \node[font=\scriptsize, anchor=west] at (5.95,3.66) {lo que se gana};
  \draw[decorate] (3.2,-0.75) -- (5.4,-0.75);
  \node[font=\scriptsize, anchor=north] at (4.3,-0.95) {lo que hay que moverse};
\end{tikzpicture}
