% Cuerpo, bloque 2 - La ganancia de coordinar es de segundo orden y el coste de coordinar no lo es.
% La curva es el bienestar conjunto, casi plana alrededor de su maximo z^C: pasar de z^N a z^C exige
% mover mucho las politicas (corchete horizontal) y sube muy poco (corchete vertical). La recta mide,
% sobre el mismo eje, lo que cuesta pactar y hacer cumplir lo pactado; arranca POR ENCIMA del punto de
% partida, porque ponerse de acuerdo cuesta algo antes de producir nada, y crece con lo que se pacta.
% De ahi que coordinarse poco sea peor que no coordinarse: la curva solo supera a la recta a partir
% del primer cruce, y lo que queda entre ambas es la franja sombreada.
% Compilar con: bash Code/generar_figura.sh b2_ganancias
\begin{tikzpicture}[>={Stealth[length=2.4mm]}, every node/.style={font=\footnotesize},
  decoration={brace, amplitude=5pt}]
  \fill[black!18] plot[domain=2.829:7.201, samples=80] (\x, {2.0-0.03808*(\x-6)*(\x-6)}) --
                  plot[domain=7.201:2.829, samples=80] (\x, {1.57+0.075*(\x-2.2)}) -- cycle;
  \draw[->] (0,0) -- (8.0,0) node[below=2pt, pos=0.97]{$z$};
  \draw[->] (0,0) -- (0,2.7) node[left=2pt, align=center]{bienestar\\[-2pt]conjunto};
  \draw[very thick] plot[domain=1.4:7.6, samples=90] (\x, {2.0-0.03808*(\x-6)*(\x-6)});
  \draw[thick] (2.2,1.57) -- (7.6,1.975);
  \draw[black!60, line width=0.4pt] (6.10,1.77) -- (6.10,1.855);
  \node[font=\scriptsize, anchor=north east, fill=white, inner sep=1.5pt] at (6.62,1.76) {coste de coordinar};
  \draw[densely dotted] (2.2,0) -- (2.2,1.45);
  \draw[densely dotted] (6.0,0) -- (6.0,2.0);
  \draw[densely dotted] (2.2,1.45) -- (8.0,1.45);
  \draw[densely dotted] (6.0,2.0) -- (8.0,2.0);
  \node[font=\scriptsize, anchor=north] at (2.2,-0.08) {$z^{N}$};
  \node[font=\scriptsize, anchor=north] at (6.0,-0.08) {$z^{C}$};
  \draw[decorate] (8.15,2.0) -- (8.15,1.45);
  \node[font=\scriptsize, anchor=west] at (8.42,1.72) {lo que se gana};
  \draw[decorate] (6.0,-0.62) -- (2.2,-0.62);
  \node[font=\scriptsize, anchor=north] at (4.1,-0.86) {lo que hay que moverse};
  \draw[black!60, line width=0.4pt] (4.45,2.10) -- (4.82,1.87);
  \node[font=\scriptsize, anchor=south] at (4.35,2.14) {lo que queda};
\end{tikzpicture}
