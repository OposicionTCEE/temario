% Anexo III.7 - El mismo hecho, dos lecturas incompatibles.
\begin{tikzpicture}[>={Stealth[length=2.4mm]}, every node/.style={font=\footnotesize},
  hecho/.style={draw, very thick, rounded corners=2pt, text width=3.3cm, align=center, inner sep=4pt, minimum height=1.0cm},
  lec/.style={draw, thick, fill=black!5, rounded corners=2pt, text width=4.6cm, align=center, inner sep=4pt, minimum height=1.35cm},
  rec/.style={draw, thick, rounded corners=2pt, text width=4.6cm, align=center, inner sep=4pt, minimum height=1.0cm}]

\node[hecho] (h) at (5.6,3.6) {El pa\'is $A$ amplía su d\'eficit p\'ublico};
\node[lec] (l1) at (2.2,1.9) {Lectura keynesiana:\\ es demanda para todos};
\node[lec] (l2) at (9.0,1.9) {Lectura ordoliberal:\\ compite por el ahorro mundial y genera riesgo moral};
\draw[->, thick] (h) -- (l1); \draw[->, thick] (h) -- (l2);
\node[rec] (r1) at (2.2,0.15) {Externalidad positiva:\\ el acuerdo debe pedirle m\'as};
\node[rec] (r2) at (9.0,0.15) {Externalidad negativa:\\ el acuerdo debe ponerle l\'imites};
\draw[->, thick] (l1) -- (r1); \draw[->, thick] (l2) -- (r2);
\end{tikzpicture}
