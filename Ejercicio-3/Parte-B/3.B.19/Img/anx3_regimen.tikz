% Anexo III.2 - El regimen como reductor de costes de transaccion.
\begin{tikzpicture}[>={Stealth[length=2.0mm]}, every node/.style={font=\footnotesize},
  p/.style={draw, thick, circle, minimum size=0.62cm, inner sep=0pt, font=\scriptsize},
  h/.style={draw, thick, fill=black!8, rounded corners=2pt, minimum width=1.75cm, minimum height=0.95cm, align=center, font=\scriptsize}]
\begin{scope}
  \node[font=\footnotesize\bfseries] at (0,2.75) {(a) Sin r\'egimen};
  \foreach \i in {1,...,6} {
    \node[p] (a\i) at ({90+60*(\i-1)}:1.85) {\i};
  }
  \foreach \i in {1,...,6} \foreach \j in {\i,...,6} {
    \ifnum\i<\j \draw[gray] (a\i) -- (a\j); \fi
  }
\end{scope}
\begin{scope}[xshift=6.4cm]
  \node[font=\footnotesize\bfseries] at (0,2.75) {(b) Con r\'egimen};
  \foreach \i in {1,...,6} {
    \node[p] (b\i) at ({90+60*(\i-1)}:1.85) {\i};
  }
  \node[h] (hub) at (0,0) {informaci\'on\\verificaci\'on\\reglas};
  \foreach \i in {1,...,6} \draw[thick] (b\i) -- (hub);
\end{scope}
\end{tikzpicture}
