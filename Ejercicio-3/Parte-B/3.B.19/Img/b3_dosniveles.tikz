% Cuerpo, bloque 3 - Conjuntos ganadores, margen de acuerdo y paradoja de la debilidad, en un solo
% panel: cuando A estrecha su conjunto ganador, el margen no solo se reduce, sino que se desplaza
% hacia el extremo que A prefiere. El desarrollo, con la condicion de solapamiento, esta en el anexo III.
% Compilar con: bash Code/generar_figura.sh b3_dosniveles
\begin{tikzpicture}[>={Stealth[length=2.2mm]}, every node/.style={font=\footnotesize}]
  \fill[black!12] (2.6,-0.17) rectangle (6.4,0.17);
  \fill[black!32] (2.6,-0.17) rectangle (4.4,0.17);
  \draw[->] (0,0) -- (9.4,0);
  \node[font=\scriptsize, anchor=north east] at (0.80,-0.14) {favorable a $A$};
  \node[font=\scriptsize, anchor=north west] at (8.70,-0.14) {favorable a $B$};
  \draw[very thick] (0.6,1.05) -- (6.4,1.05);
  \draw[very thick] (6.4,0.89) -- (6.4,1.21);
  \node[anchor=west, font=\scriptsize] at (0.60,1.44) {lo que $A$ puede ratificar};
  \draw[very thick, densely dashed] (0.6,0.55) -- (4.4,0.55);
  \draw[very thick, densely dashed] (4.4,0.39) -- (4.4,0.71);
  \node[anchor=west, font=\scriptsize] at (4.60,0.55) {si $A$ se ata las manos};
  \draw[very thick] (2.6,-1.05) -- (8.6,-1.05);
  \draw[very thick] (2.6,-1.21) -- (2.6,-0.89);
  \node[anchor=east, font=\scriptsize] at (8.60,-1.44) {lo que $B$ puede ratificar};
\end{tikzpicture}
