% Cuerpo, bloque 3 - Conjuntos ganadores y paradoja de la debilidad.
\begin{tikzpicture}[>={Stealth[length=2.2mm]}, every node/.style={font=\footnotesize}]
\foreach \k/\dy/\tit/\abar in {0/0/{(a) Hay margen}/{5.4}, 1/-3.5/{(b) $A$ se ata las manos}/{3.8}} {
  \begin{scope}[yshift=\dy cm]
    \node[font=\footnotesize\bfseries, anchor=west] at (0,1.85) {\tit};
    \draw[->] (0,0) -- (8.1,0);
    \node[font=\scriptsize, anchor=north east] at (0.7,-0.1) {favorable a $A$};
    \node[font=\scriptsize, anchor=north west] at (7.3,-0.1) {favorable a $B$};
    \fill[black!14] (2.4,-0.2) rectangle (\abar,0.2);
    \draw[very thick] (0.7,0.88) -- (\abar,0.88);
    \draw[very thick] (\abar,0.72) -- (\abar,1.04);
    \node[anchor=west, font=\scriptsize] at (0.75,1.22) {lo que $A$ puede ratificar};
    \draw[very thick] (2.4,-0.95) -- (7.5,-0.95);
    \draw[very thick] (2.4,-1.11) -- (2.4,-0.79);
    \node[anchor=east, font=\scriptsize] at (7.45,-1.30) {lo que $B$ puede ratificar};
  \end{scope}
}
\end{tikzpicture}
