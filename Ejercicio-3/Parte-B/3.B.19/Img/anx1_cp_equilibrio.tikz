% Anexo I.3 - CORSETTI y PESENTI: el equilibrio en el espacio empleo-consumo.
\begin{tikzpicture}[>={Stealth[length=2.2mm]}, every node/.style={font=\footnotesize}]
  \draw[->] (0,0) -- (5.5,0) node[below=2pt, pos=0.97]{$L$};
  \draw[->] (0,0) -- (0,4.5) node[left=2pt]{$C$};
  % curva de tecnologia (oferta agregada): rayo desde el origen
  \draw[thick] (0,0) -- (4.40,4.18) node[above left=-2pt and -2pt]{$OA_0$};
  % demanda agregada: recta horizontal
  \draw[thick] (0.15,2.20) -- (4.95,2.20) node[right=-2pt]{$DA_0$};
  % empleo de precios flexibles
  \draw[thick, densely dotted] (2.316,0) -- (2.316,4.25) node[above=-1pt]{$\bar L$};
  % curva de indiferencia U_0: C = 1.234 + 0.18 L^2
  \draw[gray, thick] plot[domain=1.3:3.9, samples=40] (\x, {1.234+0.18*\x*\x})
      node[right=-2pt]{\textcolor{gray}{$U_0$}};
  \fill (2.316,2.20) circle (1.7pt) node[below right=1pt and 1pt]{$E_0$};
  \node[align=left, anchor=north west, font=\scriptsize] at (0.0,-0.45)
    {$OA$: lo que la tecnolog\'ia da por cada hora, $C=\tau\,Z\,L$; gira con la relaci\'on real de intercambio $\tau$\\[-1pt]
     $DA$: lo que los hogares pueden gastar, dado el impulso monetario y el nivel de precios\\[-1pt]
     $\bar L$: el empleo que habr\'ia con precios flexibles; el margen de las empresas lo deja por debajo del eficiente\\[-1pt]
     $U_0$: en $E_0$ la curva de indiferencia es m\'as plana que $OA_0$, se\~nal de que se trabaja menos de lo eficiente};
\end{tikzpicture}
