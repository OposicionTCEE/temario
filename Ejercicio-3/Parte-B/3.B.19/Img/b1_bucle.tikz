% Cuerpo, bloque 1 - El bucle que hace que el riesgo del conjunto no sea la suma.
\begin{tikzpicture}[>={Stealth[length=2.5mm]}, every node/.style={font=\footnotesize},
  n/.style={draw, very thick, rounded corners=2pt, text width=3.2cm, align=center, inner sep=4pt, minimum height=1.15cm}]
\node[n] (a) at (4.6,3.0)  {Cae el precio de un activo};
\node[n] (b) at (8.4,1.5)  {Vale menos la garant\'ia};
\node[n] (c) at (4.6,0.0)  {Hay que vender para cubrir el margen};
\node[n] (d) at (0.8,1.5)  {La venta de uno es el precio de todos};
\draw[->, very thick] (a) -- (b);
\draw[->, very thick] (b) -- (c);
\draw[->, very thick] (c) -- (d);
\draw[->, very thick] (d) -- (a);
\end{tikzpicture}
