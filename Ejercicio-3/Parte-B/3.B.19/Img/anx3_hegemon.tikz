% Anexo III.1 - Cuando compensa proveer el orden en solitario: el umbral del hegemon.
\begin{tikzpicture}[x=1.3cm, y=1.3cm, >={Stealth[length=2.2mm]}, every node/.style={font=\footnotesize}]
  \draw[->] (0,0) -- (5.6,0) node[below=2pt, pos=0.97]{$s$};
  \draw[->] (0,0) -- (0,3.9) node[left=2pt]{valor};
  % coste total de proveer el bien
  \draw[thick] (0.1,1.80) -- (5.3,1.80) node[right=-2pt]{$K$};
  % beneficio del mayor: s B
  \draw[thick] (0,0) -- (5.0,3.50) node[above left=-3pt and -2pt]{$s\,B$};
  % beneficio del grupo de los tres mayores
  \draw[thick, dashed] (0,0) -- (3.4,3.50) node[above=-2pt]{$(s_1{+}s_2{+}s_3)\,B$};
  % umbrales
  \draw[densely dotted] (2.571,0) -- (2.571,1.80);
  \fill (2.571,1.80) circle (1.6pt) node[below right=1pt and 0pt]{$s^{*}$};
  \draw[densely dotted] (1.749,0) -- (1.749,1.80);
  \fill (1.749,1.80) circle (1.6pt) node[above left=-1pt and -2pt]{$s^{*}_{k}$};
\end{tikzpicture}
