% Cuerpo, bloque 1 - Las dos formas de absorber la brecha y lo que decide cual de ellas ocurre.
% Sobre la misma base que b1_espejo (el panel (a) usa su misma curva): el gasto de A desplaza su saldo
% a XN_A' y al precio de antes se abre la brecha. Del punto de la brecha salen las dos ramas. Por
% PRECIO, q_A recorre la distancia de q_0 a q_1 y el saldo vuelve a cero. Por CANTIDADES, el precio no
% se mueve, la brecha se queda abierta y se realiza como flujo comercial: el socio la produce.
% Lo que cambia entre paneles es cuanto tiene que recorrer q_A: con un saldo que responde mucho al
% precio, q_1 esta al lado; con uno que responde poco, lejos, y si no puede llegar manda la otra rama.
% Compilar con: bash Code/generar_figura.sh b1_ajuste
\begin{tikzpicture}
\footnotesize
\begin{axis}[name=ax1,
  title={(a) El saldo responde mucho al precio}, title style={font=\footnotesize\bfseries, yshift=-3pt},
  scale only axis, width=5.6cm, height=4.0cm, axis lines=middle, tick style={draw=none},
  every axis label/.style={font=\footnotesize}, tick label style={font=\footnotesize},
  xmin=1.0, xmax=7.8, ymin=-3.6, ymax=2.6, clip=false, xtick=\empty, ytick=\empty,
]
\addplot[black, line width=1pt, domain=1.0:7.8, samples=120] {2.4*tanh((x-4)/1.8)};
\addplot[black, line width=0.8pt, densely dashed, domain=1.0:7.8, samples=120] {2.4*tanh((x-4)/1.8)-1.2};
\node[anchor=west, font=\footnotesize] at (axis cs:7.85,2.33) {$XN_A$};
\node[anchor=west, font=\footnotesize] at (axis cs:7.85,1.13) {$XN_A'$};
\draw[black!45, dotted] (axis cs:4,-1.2) -- (axis cs:4,-3.6) node[anchor=north, black, font=\footnotesize] {$q_0$};
\draw[black!45, dotted] (axis cs:4.989,0) -- (axis cs:4.989,-3.6) node[anchor=north, black, font=\footnotesize] {$q_1$};
\draw[<->, very thick] (axis cs:4,-0.10) -- (axis cs:4,-1.10);
\draw[->, very thick] (axis cs:4.06,-0.22) -- (axis cs:4.94,-0.22);
\node[anchor=west, font=\scriptsize] at (axis cs:5.08,-0.22) {precio};
\draw[->, thick, densely dotted] (axis cs:3.90,-1.2) -- (axis cs:1.05,-1.2);
\node[anchor=south west, font=\scriptsize] at (axis cs:1.12,-1.14) {cantidades};
\fill[black] (axis cs:4,0) circle (1.8pt);
\fill[black] (axis cs:4,-1.2) circle (1.8pt);
\fill[black] (axis cs:4.989,0) circle (1.8pt);
\node[anchor=north east, font=\footnotesize] at (axis cs:7.8,-0.18) {$q_A$};
\end{axis}
\begin{axis}[name=ax2, at={($(ax1.south east)+(2.0cm,0)$)}, anchor=south west,
  title={(b) El saldo responde poco}, title style={font=\footnotesize\bfseries, yshift=-3pt},
  scale only axis, width=5.6cm, height=4.0cm, axis lines=middle, tick style={draw=none},
  every axis label/.style={font=\footnotesize}, tick label style={font=\footnotesize},
  xmin=1.0, xmax=7.8, ymin=-3.6, ymax=2.6, clip=false, xtick=\empty, ytick=\empty,
]
\addplot[black, line width=1pt, domain=1.0:7.8, samples=120] {2.4*tanh((x-4)/4.5)};
\addplot[black, line width=0.8pt, densely dashed, domain=1.0:7.8, samples=120] {2.4*tanh((x-4)/4.5)-1.2};
\node[anchor=west, font=\footnotesize] at (axis cs:7.85,1.65) {$XN_A$};
\node[anchor=west, font=\footnotesize] at (axis cs:7.85,0.45) {$XN_A'$};
\draw[black!45, dotted] (axis cs:4,-1.2) -- (axis cs:4,-3.6) node[anchor=north, black, font=\footnotesize] {$q_0$};
\draw[black!45, dotted] (axis cs:6.472,0) -- (axis cs:6.472,-3.6) node[anchor=north, black, font=\footnotesize] {$q_1$};
\draw[<->, very thick] (axis cs:4,-0.10) -- (axis cs:4,-1.10);
\draw[->, very thick] (axis cs:4.06,-0.22) -- (axis cs:6.42,-0.22);
\node[anchor=center, font=\scriptsize, fill=white, inner sep=1.5pt] at (axis cs:5.25,-0.22) {precio};
\draw[->, thick, densely dotted] (axis cs:3.90,-1.2) -- (axis cs:1.05,-1.2);
\node[anchor=south west, font=\scriptsize] at (axis cs:2.50,-1.14) {cantidades};
\fill[black] (axis cs:4,0) circle (1.8pt);
\fill[black] (axis cs:4,-1.2) circle (1.8pt);
\fill[black] (axis cs:6.472,0) circle (1.8pt);
\node[anchor=north east, font=\footnotesize] at (axis cs:7.8,-0.18) {$q_A$};
\end{axis}
\end{tikzpicture}
