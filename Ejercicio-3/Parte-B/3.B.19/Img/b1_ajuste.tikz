% Cuerpo, bloque 1 - Las dos formas de absorber la brecha y lo que decide cual de ellas ocurre.
% Sobre la misma base que b1_espejo: el gasto de A desplaza su saldo a XN_A' y al precio de antes se
% abre la brecha. Del punto de la brecha salen las dos ramas, y lo que cambia entre paneles es cual
% de ellas resulta practicable. (a) Si el saldo responde mucho al precio, q_1 esta al lado: basta un
% abaratamiento pequeno y manda la rama del precio (trazo grueso), con la de cantidades en punteado
% fino. (b) Si responde poco, q_1 queda lejisimos y esa rama pasa a trazo fino discontinuo, porque
% exige un recorrido que el precio puede no poder hacer; entonces manda la rama de las cantidades y
% la brecha se queda abierta. Compilar con: bash Code/generar_figura.sh b1_ajuste
\begin{tikzpicture}
\footnotesize
\begin{axis}[name=ax1,
  title={(a) Responde mucho al precio:\\basta moverlo poco},
  title style={font=\footnotesize\bfseries, align=center, yshift=-3pt},
  scale only axis, width=5.6cm, height=4.0cm, axis lines=middle, tick style={draw=none},
  every axis label/.style={font=\footnotesize}, tick label style={font=\footnotesize},
  xmin=1.0, xmax=7.8, ymin=-3.6, ymax=2.6, clip=false, xtick=\empty, ytick=\empty,
]
\addplot[black, line width=1pt, domain=1.0:7.8, samples=160] {2.4*tanh((x-4)/1.2)};
\addplot[black, line width=0.8pt, densely dashed, domain=1.0:7.8, samples=160] {2.4*tanh((x-4)/1.2)-1.2};
\node[anchor=west, font=\footnotesize] at (axis cs:7.85,2.39) {$XN_A$};
\node[anchor=west, font=\footnotesize] at (axis cs:7.85,1.19) {$XN_A'$};
\draw[black!45, dotted] (axis cs:4,-1.2) -- (axis cs:4,-3.6) node[anchor=north east, black, font=\footnotesize] {$q_0$};
\draw[black!45, dotted] (axis cs:4.659,0) -- (axis cs:4.659,-3.6) node[anchor=north west, black, font=\footnotesize] {$q_1$};
\draw[<->, very thick] (axis cs:4,-0.10) -- (axis cs:4,-1.10);
\draw[->, very thick] (axis cs:4.06,-0.22) -- (axis cs:4.60,-0.22);
\node[anchor=west, font=\scriptsize] at (axis cs:4.80,-0.22) {precio};
\draw[->, thin, densely dotted] (axis cs:3.90,-1.2) -- (axis cs:1.05,-1.2);
\node[anchor=south west, font=\scriptsize, black!55] at (axis cs:1.12,-1.14) {cantidades};
\fill[black] (axis cs:4,0) circle (1.8pt);
\fill[black] (axis cs:4,-1.2) circle (1.8pt);
\fill[black] (axis cs:4.659,0) circle (1.8pt);
\node[anchor=north east, font=\footnotesize] at (axis cs:7.8,-0.18) {$q_A$};
\end{axis}
\begin{axis}[name=ax2, at={($(ax1.south east)+(2.0cm,0)$)}, anchor=south west,
  title={(b) Responde poco al precio:\\tendría que moverse mucho},
  title style={font=\footnotesize\bfseries, align=center, yshift=-3pt},
  scale only axis, width=5.6cm, height=4.0cm, axis lines=middle, tick style={draw=none},
  every axis label/.style={font=\footnotesize}, tick label style={font=\footnotesize},
  xmin=1.0, xmax=7.8, ymin=-3.6, ymax=2.6, clip=false, xtick=\empty, ytick=\empty,
]
\addplot[black, line width=1pt, domain=1.0:7.8, samples=160] {2.4*tanh((x-4)/5.0)};
\addplot[black, line width=0.8pt, densely dashed, domain=1.0:7.8, samples=160] {2.4*tanh((x-4)/5.0)-1.2};
\node[anchor=west, font=\footnotesize] at (axis cs:7.85,1.54) {$XN_A$};
\node[anchor=west, font=\footnotesize] at (axis cs:7.85,0.34) {$XN_A'$};
\draw[black!45, dotted] (axis cs:4,-1.2) -- (axis cs:4,-3.6) node[anchor=north, black, font=\footnotesize] {$q_0$};
\draw[black!45, dotted] (axis cs:6.747,0) -- (axis cs:6.747,-3.6) node[anchor=north, black, font=\footnotesize] {$q_1$};
\draw[<->, very thick] (axis cs:4,-0.10) -- (axis cs:4,-1.10);
\draw[->, thin, densely dashed] (axis cs:4.06,-0.22) -- (axis cs:6.68,-0.22);
\node[anchor=south, font=\scriptsize, black!55] at (axis cs:5.35,-0.16) {precio};
\draw[->, very thick, densely dotted] (axis cs:3.90,-1.2) -- (axis cs:1.05,-1.2);
\node[anchor=south west, font=\scriptsize] at (axis cs:2.10,-1.14) {cantidades};
\fill[black] (axis cs:4,0) circle (1.8pt);
\fill[black] (axis cs:4,-1.2) circle (1.8pt);
\fill[black] (axis cs:6.747,0) circle (1.8pt);
\node[anchor=north east, font=\footnotesize] at (axis cs:7.8,-0.18) {$q_A$};
\end{axis}
\end{tikzpicture}
