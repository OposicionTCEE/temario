% Anexo II.7 - Tecnologias de agregacion de un bien publico mundial.
\begin{tikzpicture}[>={Stealth[length=2.2mm]}, every node/.style={font=\footnotesize}]
\def\paises{{1.5,2.6,0.9,2.0}}
\foreach \k/\dx/\tit/\res in {0/0/{(a) Suma}/{7.0}, 1/5.0/{(b) Eslab\'on m\'as d\'ebil}/{0.9}, 2/10.0/{(c) Mejor tiro}/{2.6}} {
  \begin{scope}[xshift=\dx cm]
    \node[font=\footnotesize\bfseries] at (1.9,3.55) {\tit};
    \draw[->] (0,0) -- (4.1,0);
    \draw[->] (0,0) -- (0,3.25);
    \foreach \i/\h in {1/1.5, 2/2.6, 3/0.9, 4/2.0} {
      \pgfmathsetmacro\xx{0.45+0.6*(\i-1)}
      \draw[fill=black!12] (\xx-0.18,0) rectangle (\xx+0.18,\h);
      \node[font=\scriptsize, anchor=north] at (\xx,-0.05) {$\i$};
    }
    \pgfmathsetmacro\hres{min(\res,3.0)}
    \draw[fill=black!45] (3.15,0) rectangle (3.75,\hres);
    \node[font=\scriptsize, anchor=north] at (3.45,-0.05) {total};
    \ifnum\k=0 \node[font=\scriptsize, anchor=south] at (3.45,3.0) {$\sum$}; \fi
  \end{scope}
}
\end{tikzpicture}
