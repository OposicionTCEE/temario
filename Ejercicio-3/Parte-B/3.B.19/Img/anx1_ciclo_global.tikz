% Anexo I.4 - El ciclo financiero global: transmision del centro a la periferia.
\begin{tikzpicture}[>={Stealth[length=2.4mm]}, every node/.style={font=\footnotesize},
  caja/.style={draw, thick, rounded corners=2pt, minimum height=1.1cm, text width=2.5cm, align=center, inner sep=3pt},
  suave/.style={draw, fill=black!4, rounded corners=2pt, minimum height=1.0cm, text width=2.5cm, align=center, inner sep=3pt}]

\node[caja] (pm) at (0,0) {Pol\'itica monetaria del centro};
\node[suave] (riesgo) at (3.25,0) {Apetito global por el riesgo};
\node[suave] (banca) at (6.5,0) {Apalancamiento de la banca global};
\node[caja] (periferia) at (9.75,0) {Cr\'edito y precios de activos en la periferia};
\node[caja] (demanda) at (13.0,0) {Demanda y tipo de cambio de la periferia};

\draw[->, thick] (pm) -- (riesgo);
\draw[->, thick] (riesgo) -- (banca);
\draw[->, thick] (banca) -- (periferia);
\draw[->, thick] (periferia) -- (demanda);

\draw[->, thick, gray] (demanda.north) -- ++(0,0.75) -- node[above, font=\scriptsize]{\textcolor{gray}{retorno sobre el centro, de segundo orden}} ++(-13.0,0) -- (pm.north);

\end{tikzpicture}
