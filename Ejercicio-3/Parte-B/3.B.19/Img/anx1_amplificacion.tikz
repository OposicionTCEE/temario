% Anexo I.5 - La externalidad de riesgo agregado: el bucle de amplificacion y la red de seguridad.
\begin{tikzpicture}[>={Stealth[length=2.4mm]}, every node/.style={font=\footnotesize},
  nodo/.style={draw, thick, rounded corners=2pt, text width=2.9cm, align=center, inner sep=3pt, minimum height=1.0cm},
  capa/.style={draw, rounded corners=2pt, text width=6.4cm, align=center, inner sep=3pt, minimum height=0.72cm}]

\begin{scope}
  \node[font=\footnotesize\bfseries] at (3.1,3.55) {(a) El bucle de amplificaci\'on};
  \node[nodo] (caida) at (3.1,2.55) {Cae el precio del activo};
  \node[nodo] (garantia) at (5.9,0.95) {Vale menos la garant\'ia};
  \node[nodo] (venta) at (3.1,-0.65) {Hay que vender para cubrir el margen};
  \node[nodo] (presion) at (0.3,0.95) {La venta de uno es el precio de todos};
  \draw[->, thick] (caida) -- (garantia);
  \draw[->, thick] (garantia) -- (venta);
  \draw[->, thick] (venta) -- (presion);
  \draw[->, thick] (presion) -- (caida);
\end{scope}

\begin{scope}[xshift=8.0cm]
  \node[font=\footnotesize\bfseries] at (3.2,3.55) {(b) La red de seguridad financiera global};
  \node[capa, fill=black!2] (res) at (3.2,2.55) {Reservas propias};
  \node[capa, fill=black!5] (swap) at (3.2,1.60) {L\'ineas de permuta entre bancos centrales};
  \node[capa, fill=black!8] (reg) at (3.2,0.65) {Acuerdos regionales};
  \node[capa, fill=black!11] (fmi) at (3.2,-0.30) {Fondo Monetario Internacional};
  \draw[->, thick] (res) -- (swap);
  \draw[->, thick] (swap) -- (reg);
  \draw[->, thick] (reg) -- (fmi);
\end{scope}
\end{tikzpicture}
