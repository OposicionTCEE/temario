% Cuerpo, bloque 4 - El G-20 encarga y no ejecuta.
\begin{tikzpicture}[>={Stealth[length=2.5mm]}, every node/.style={font=\footnotesize},
  g/.style={draw, very thick, rounded corners=2pt, text width=3.6cm, align=center, inner sep=4pt, minimum height=1.1cm},
  o/.style={draw, thick, fill=black!5, rounded corners=2pt, text width=2.4cm, align=center, inner sep=3pt, minimum height=0.9cm}]
\node[g] (g) at (5.6,2.6) {\textbf{Cumbre del G-20}\\[1pt]\scriptsize decide y no ejecuta};
\node[o] (a) at (0.0,0.4) {FSB};
\node[o] (b) at (3.7,0.4) {FMI};
\node[o] (c) at (7.4,0.4) {Comit\'e de Basilea};
\node[o] (d) at (11.1,0.4) {OCDE};
\foreach \n in {a,b,c,d} \draw[->, very thick] (g) -- (\n);
\draw[->, thick, gray] (a.west) -- (-1.75,0.4) -- (-1.75,2.6) -- (g.west);
\end{tikzpicture}
