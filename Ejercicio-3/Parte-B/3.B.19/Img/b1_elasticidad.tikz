% Cuerpo, bloque 1 - Modificacion parcial de b1_espejo: cuanto del gasto adicional de A llega de
% verdad al socio. El aumento de la absorcion de A desplaza su curva la misma distancia vertical en
% los dos paneles; lo que cambia es cuanto tiene que moverse q_A para cerrar el hueco. (a) Si el
% saldo responde al precio, basta un abaratamiento pequeno y al socio no le llega casi nada.
% (b) Si responde poco, q_A tendria que moverse mucho; si no puede, el hueco se queda abierto y el
% ajuste sale de las cantidades. Compilar con: bash Code/generar_figura.sh b1_elasticidad
\begin{tikzpicture}
\footnotesize
\begin{axis}[name=ax1,
  title={(a) El saldo responde al precio}, title style={font=\footnotesize\bfseries, yshift=-3pt},
  scale only axis, width=5.6cm, height=4.0cm, axis lines=middle, tick style={draw=none},
  every axis label/.style={font=\footnotesize}, tick label style={font=\footnotesize},
  xmin=1.0, xmax=7.8, ymin=-3.6, ymax=2.6, clip=false, xtick=\empty, ytick=\empty,
]
\addplot[black, line width=1pt, domain=1.0:7.8, samples=120] {2.4*tanh((x-4)/1.4)};
\addplot[black, line width=0.8pt, densely dashed, domain=1.0:7.8, samples=120] {2.4*tanh((x-4)/1.4)-1.2};
\node[anchor=west, font=\footnotesize] at (axis cs:7.85,2.38) {$XN_A$};
\node[anchor=west, font=\footnotesize] at (axis cs:7.85,1.18) {$XN_A'$};
\draw[black!45, dotted] (axis cs:4,0) -- (axis cs:4,-3.6);
\draw[black!45, dotted] (axis cs:4.769,0) -- (axis cs:4.769,-3.6);
\fill[black] (axis cs:4,0) circle (1.8pt);
\fill[black] (axis cs:4.769,0) circle (1.8pt);
\node[anchor=north east, font=\footnotesize] at (axis cs:4,-3.6) {$q_0$};
\node[anchor=north west, font=\footnotesize] at (axis cs:4.769,-3.6) {$q_1$};
\node[anchor=north east, font=\footnotesize] at (axis cs:7.8,-0.18) {$q_A$};
\end{axis}
\begin{axis}[name=ax2, at={($(ax1.south east)+(2.0cm,0)$)}, anchor=south west,
  title={(b) El saldo responde poco}, title style={font=\footnotesize\bfseries, yshift=-3pt},
  scale only axis, width=5.6cm, height=4.0cm, axis lines=middle, tick style={draw=none},
  every axis label/.style={font=\footnotesize}, tick label style={font=\footnotesize},
  xmin=1.0, xmax=7.8, ymin=-3.6, ymax=2.6, clip=false, xtick=\empty, ytick=\empty,
]
\addplot[black, line width=1pt, domain=1.0:7.8, samples=120] {2.4*tanh((x-4)/4.0)};
\addplot[black, line width=0.8pt, densely dashed, domain=1.0:7.8, samples=120] {2.4*tanh((x-4)/4.0)-1.2};
\node[anchor=west, font=\footnotesize] at (axis cs:7.85,1.78) {$XN_A$};
\node[anchor=west, font=\footnotesize] at (axis cs:7.85,0.58) {$XN_A'$};
\draw[black!45, dotted] (axis cs:4,-1.35) -- (axis cs:4,-3.6);
\draw[black!45, dotted] (axis cs:6.197,0) -- (axis cs:6.197,-3.6);
\draw[->, very thick, >={Stealth[length=2.2mm]}] (axis cs:4,0) -- (axis cs:4,-1.2);
\node[anchor=west, font=\scriptsize, align=left] at (axis cs:4.12,-0.68) {ajuste por\\[-1pt]cantidades};
\fill[black] (axis cs:4,0) circle (1.8pt);
\fill[black] (axis cs:6.197,0) circle (1.8pt);
\node[anchor=north, font=\footnotesize] at (axis cs:4,-3.6) {$q_0$};
\node[anchor=north, font=\footnotesize] at (axis cs:6.197,-3.6) {$q_1$};
\node[anchor=north east, font=\footnotesize] at (axis cs:7.8,-0.18) {$q_A$};
\end{axis}
\end{tikzpicture}
