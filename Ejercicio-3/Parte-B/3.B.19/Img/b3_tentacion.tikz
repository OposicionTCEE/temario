% Cuerpo, bloque 2 - La tentacion de incumplir, sobre la misma base que b2_grados.
% Firmado el acuerdo en C, A da por hecha la politica de B (la vertical punteada en z*_C) y se mueve
% por ella hasta F, que esta sobre su funcion de reaccion y, por tanto, en el punto en que esa
% vertical es tangente a una curva de indiferencia suya mas proxima a su optimo B_A: la distancia
% entre W_A y W_A' es la ganancia de incumplir. Si A incumple, B deja de cumplir y se regresa a N.
% Compilar con: bash Code/generar_figura.sh b3_tentacion
\begin{tikzpicture}[x=1.5cm, y=1.5cm, >={Stealth[length=2.4mm]}, every node/.style={font=\footnotesize}]
  \draw[->] (0,0) -- (4.6,0) node[below=2pt, pos=0.95]{$z_{B}$};
  \draw[->] (0,0) -- (0,4.6) node[left=2pt]{$z_{A}$};
  % --- curvas de indiferencia de A: la del acuerdo (por C) y la del incumplimiento (por F) ---
  \draw[black!70, line width=0.7pt] plot[domain=70:195, samples=80, variable=\t]
      ({4.3+1.8171*cos(\t)-0.6811*sin(\t)}, {1.11+1.9405*sin(\t)});
  \draw[black!70, line width=0.7pt] plot[domain=70:195, samples=80, variable=\t]
      ({4.3+1.4936*cos(\t)-0.5598*sin(\t)}, {1.11+1.5950*sin(\t)});
  \node[font=\scriptsize, anchor=west] at (4.33,2.95) {$W_A$};
  \node[font=\scriptsize, anchor=west] at (4.33,2.56) {$W_A'$};
  % --- funciones de reaccion ---
  \draw[thick] (0,2.61) -- (4.45,1.05);
  \draw[thick] (2.61,0) -- (1.06,4.43);
  \node[font=\footnotesize, anchor=north west] at (3.45,1.30) {$R_A$};
  \node[font=\footnotesize, anchor=south east] at (1.30,3.45) {$R_B$};
  % --- acuerdos eficientes ---
  \draw[very thick] (4.3,1.11) -- (1.11,4.3);
  \fill (4.3,1.11) circle (2.0pt);
  \node[font=\footnotesize, anchor=north] at (4.30,1.00) {$B_A$};
  % --- la desviacion: B mantiene z*_C y A baja por la vertical ---
  \draw[black!45, dotted] (2.705,0) -- (2.705,2.705);
  \node[font=\scriptsize, anchor=north] at (2.705,-0.08) {$z_{B}^{C}$};
  \fill (1.933,1.933) circle (2.0pt) node[below left=-1pt and -2pt]{$N$};
  \fill (2.705,2.705) circle (2.0pt);
  \node[font=\footnotesize, anchor=south west] at (2.76,2.76) {$C$};
  \fill (2.705,1.6605) circle (2.0pt) node[below right=-1pt and -1pt]{$F$};
  \draw[->, very thick] (2.705,2.58) -- (2.705,1.80);
  \draw[->, very thick, dashed] (2.61,1.65) -- (2.05,1.88);
\end{tikzpicture}
