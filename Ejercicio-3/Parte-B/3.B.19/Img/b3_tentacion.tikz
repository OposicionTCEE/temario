% Cuerpo, bloque 2 - La tentacion de incumplir, sobre la misma base que b2_grados.
% Firmado el acuerdo en C, A da por hecha la politica de B (la vertical punteada en z*_C) y se mueve
% por ella hasta F, que esta sobre su funcion de reaccion y sobre una curva de indiferencia mas
% proxima a su optimo B_A: esa distancia entre W_A y W_A' es la ganancia de incumplir. Si A incumple,
% B deja de cumplir y el desenlace es el regreso a N.
% Compilar con: bash Code/generar_figura.sh b3_tentacion
\begin{tikzpicture}[x=1.5cm, y=1.5cm, >={Stealth[length=2.4mm]}, every node/.style={font=\footnotesize}]
  \draw[->] (0,0) -- (4.6,0) node[below=2pt, pos=0.95]{$z^{*}$};
  \draw[->] (0,0) -- (0,4.6) node[left=2pt]{$z$};
  % --- curvas de indiferencia de A: la del acuerdo y la del incumplimiento ---
  \draw[black!70, line width=0.7pt] plot[domain=70:195, samples=80, variable=\t]
      ({4.3+1.8271*cos(\t)-0.6850*sin(\t)}, {1.11+1.9512*sin(\t)});
  \draw[black!70, line width=0.7pt] plot[domain=70:195, samples=80, variable=\t]
      ({4.3+1.6022*cos(\t)-0.6007*sin(\t)}, {1.11+1.7111*sin(\t)});
  \node[font=\scriptsize, anchor=west] at (4.33,2.96) {$W_A$};
  \node[font=\scriptsize, anchor=west] at (4.33,2.62) {$W_A'$};
  % --- funciones de reaccion ---
  \draw[thick] (0,2.61) -- (4.45,1.05);
  \draw[thick] (2.61,0) -- (1.06,4.43);
  \node[font=\footnotesize, anchor=north west] at (3.45,1.30) {$R_A$};
  \node[font=\footnotesize, anchor=south east] at (1.30,3.45) {$R_B$};
  % --- optimo de A ---
  \fill (4.3,1.11) circle (2.0pt);
  \node[font=\footnotesize, anchor=north] at (4.30,1.00) {$B_A$};
  % --- acuerdos eficientes ---
  \draw[very thick] (4.3,1.11) .. controls (3.70,1.40) and (1.40,3.70) .. (1.11,4.3);
  % --- la desviacion: B mantiene z*_C y A baja por la vertical ---
  \draw[black!45, dotted] (2.589,0) -- (2.589,2.589);
  \node[font=\scriptsize, anchor=north] at (2.589,-0.08) {$z^{*}_{C}$};
  \fill (1.933,1.933) circle (2.0pt) node[below left=-1pt and -2pt]{$N$};
  \fill (2.589,2.589) circle (2.0pt) node[above left=-2pt and -1pt]{$C$};
  \fill (2.589,1.701) circle (2.0pt) node[below right=-1pt and -1pt]{$F$};
  \draw[->, very thick] (2.589,2.46) -- (2.589,1.84);
  \draw[->, very thick, dashed] (2.50,1.69) -- (2.04,1.90);
\end{tikzpicture}
