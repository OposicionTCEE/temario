% Cuerpo, bloque 2 - La asimetria del ajuste y el sesgo contractivo.
\begin{tikzpicture}[>={Stealth[length=2.5mm]}, every node/.style={font=\footnotesize},
  p/.style={draw, very thick, rounded corners=2pt, text width=3.8cm, align=center, inner sep=4pt, minimum height=1.15cm},
  r/.style={draw, thick, fill=black!5, rounded corners=2pt, text width=3.8cm, align=center, inner sep=4pt, minimum height=1.1cm}]
\node[p] (d) at (0,3.0)   {Pa\'is con d\'eficit:\\ se le acaban las reservas};
\node[p] (s) at (6.4,3.0) {Pa\'is con super\'avit:\\ no tiene l\'imite};
\node[r] (c) at (0,1.0)   {Contrae su gasto};
\node[r] (n) at (6.4,1.0) {No hace nada};
\draw[->, very thick] (d) -- node[right, font=\scriptsize]{obligado} (c);
\draw[->, very thick, gray] (s) -- node[right, font=\scriptsize]{\textcolor{gray}{no obligado}} (n);
\node[p, text width=7.6cm] (w) at (3.2,-0.9) {La demanda mundial cae y nadie consigue el super\'avit que buscaba};
\draw[->, very thick] (c.south) -- ++(0,-0.4) -| (w.west);
\draw[->, very thick] (n.south) -- ++(0,-0.4) -| (w.east);
\end{tikzpicture}
