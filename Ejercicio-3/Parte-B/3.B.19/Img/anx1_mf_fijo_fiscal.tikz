% Anexo I.2 - MUNDELL-FLEMING en dos paises, tipo de cambio fijo:
% expansion fiscal en A -> el socio importa el tipo de interes y parte del impulso.
\begin{tikzpicture}[>={Stealth[length=2.2mm]}, every node/.style={font=\footnotesize}]
\begin{scope}
  \node[font=\footnotesize\bfseries] at (3.1,5.05) {(a) Pa\'is $A$: expansi\'on fiscal};
  \draw[->] (0,0) -- (6.4,0) node[below=2pt, pos=0.97]{$Y$};
  \draw[->] (0,0) -- (0,4.65) node[left=2pt]{$i$};
  \draw[gray,thick] (0.465,4.1) -- (4.759,0.45) node[below left=-1pt and -4pt]{\textcolor{gray}{$IS_0$}};
  \draw[thick] (1.715,4.1) -- (6.009,0.45) node[below right=-2pt and -3pt]{$IS_1$};
  \draw[gray,thick] (0.80,0.70) -- (4.90,3.98) node[above left=-2pt and -3pt]{\textcolor{gray}{$LM_0$}};
  \draw[thick] (1.2255,0.70) -- (5.3255,3.98) node[right=-2pt]{$LM_1$};
  \draw[gray,thick] (0.15,2.211) -- (5.90,2.211) node[right=-2pt]{\textcolor{gray}{$i_w^0$}};
  \draw[thick] (0.15,2.550) -- (5.90,2.550) node[right=-2pt]{$i_w^1$};
  \fill (2.687,2.211) circle (1.6pt) node[below left=0pt and 0pt]{$E_0$};
  \fill[gray] (3.332,2.726) circle (1.4pt) node[left=0pt]{\textcolor{gray}{$E_1$}};
  \fill (3.538,2.550) circle (1.6pt) node[below right=0pt and -1pt]{$E_2$};
\end{scope}
\begin{scope}[xshift=8.0cm]
  \node[font=\footnotesize\bfseries] at (3.1,5.05) {(b) Pa\'is $B$: importa el tipo mundial};
  \draw[->] (0,0) -- (6.4,0) node[below=2pt, pos=0.97]{$Y^{*}$};
  \draw[->] (0,0) -- (0,4.65) node[left=2pt]{$i^{*}$};
  \draw[gray,thick] (0.465,4.1) -- (4.759,0.45) node[below left=-1pt and -4pt]{\textcolor{gray}{$IS^{*}_0$}};
  \draw[thick] (0.965,4.1) -- (5.259,0.45) node[below right=-2pt and -3pt]{$IS^{*}_1$};
  \draw[gray,thick] (0.80,0.70) -- (4.90,3.98) node[above=-1pt]{\textcolor{gray}{$LM^{*}_0$}};
  \draw[thick] (0.4755,0.70) -- (4.5755,3.98) node[left=-1pt]{$LM^{*}_1$};
  \draw[gray,thick] (0.15,2.211) -- (5.90,2.211) node[right=-2pt]{\textcolor{gray}{$i_w^0$}};
  \draw[thick] (0.15,2.550) -- (5.90,2.550) node[right=-2pt]{$i_w^1$};
  \fill (2.687,2.211) circle (1.6pt) node[below right=1pt and -1pt]{$E^{*}_0$};
  \fill (2.788,2.550) circle (1.6pt) node[above left=-1pt and -2pt]{$E^{*}_1$};
\end{scope}
\end{tikzpicture}
