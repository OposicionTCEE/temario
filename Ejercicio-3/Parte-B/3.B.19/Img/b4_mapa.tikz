% Cuerpo, bloque 4 - El mapa de los foros en dos planos. (a) Composicion y obligacion: la nube no se
% ordena, porque hay clubes reducidos sin obligacion alguna (G-7) y clubes reducidos con estandares que
% se cumplen (Basilea). (b) Amplitud de la materia y obligacion: ahi si hay canje, y los foros se alinean
% sobre la diagonal; la UE queda fuera porque obliga duro sobre materia amplia, y lo paga construyendo
% gobierno supranacional. Compilar con: bash Code/generar_figura.sh b4_mapa
\begin{tikzpicture}[x=1.0cm, y=1.0cm, every node/.style={font=\scriptsize},
  f/.style={draw, thick, rounded corners=2pt, fill=white, inner sep=2pt, font=\scriptsize}]
\begin{scope}
  \node[font=\scriptsize\bfseries, anchor=west] at (-0.35,5.60) {(a) Composici\'on};
  \draw[->] (0,0) -- (5.8,0);
  \draw[->] (0,0) -- (0,5.2);
  \node[anchor=north] at (1.15,-0.14) {club reducido};
  \node[anchor=north] at (4.90,-0.14) {universal};
  \node[rotate=90, anchor=south] at (-0.46,0.35) {obligaci\'on blanda};
  \node[rotate=90, anchor=south] at (-0.46,3.55) {obligaci\'on dura};
  \node[f] at (0.85,0.70) {G-7};
  \node[f] at (1.75,1.10) {G-20};
  \node[f] at (1.00,3.40) {Basilea};
  \node[f] at (2.20,2.60) {FSB};
  \node[f] at (3.40,1.90) {OCDE};
  \node[f] at (4.70,3.40) {FMI};
  \node[f] at (5.00,4.70) {OMC};
\end{scope}
\begin{scope}[xshift=7.0cm]
  \node[font=\scriptsize\bfseries, anchor=west] at (-0.35,5.60) {(b) Amplitud de la materia};
  \draw[->] (0,0) -- (5.8,0);
  \draw[->] (0,0) -- (0,5.2);
  \node[anchor=north] at (0.95,-0.14) {acotada};
  \node[anchor=north] at (4.95,-0.14) {general};
  \node[rotate=90, anchor=south] at (-0.46,0.35) {obligaci\'on blanda};
  \node[rotate=90, anchor=south] at (-0.46,3.55) {obligaci\'on dura};
  \draw[densely dashed, black!55, thick] (0.25,4.95) -- (5.65,0.40);
  \node[f] at (0.65,4.65) {OMC};
  \node[f] at (1.55,4.00) {Basilea};
  \node[f] at (1.90,3.05) {FSB};
  \node[f] at (2.80,3.40) {FMI};
  \node[f] at (3.75,1.95) {OCDE};
  \node[f] at (4.75,1.10) {G-20};
  \node[f] at (5.25,0.55) {G-7};
  \node[f] at (4.35,4.70) {UE};
\end{scope}
\end{tikzpicture}
