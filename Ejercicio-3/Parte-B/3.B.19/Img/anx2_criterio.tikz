% Anexo II.2 - El criterio de eficiencia: cuando un desbordamiento justifica coordinar.
\begin{tikzpicture}[>={Stealth[length=2.4mm]}, every node/.style={font=\footnotesize},
  caja/.style={draw, thick, rounded corners=2pt, text width=3.1cm, align=center, inner sep=4pt, minimum height=1.0cm},
  fallo/.style={draw, thick, fill=black!5, rounded corners=2pt, text width=3.1cm, align=center, inner sep=4pt, minimum height=1.0cm},
  salida/.style={draw, rounded corners=2pt, text width=3.1cm, align=center, inner sep=4pt, minimum height=1.25cm}]

\node[caja] (desb) at (7.0,7.3) {Hay desbordamiento: $\partial W^{*}/\partial z\neq0$};
\node[caja] (cond) at (7.0,5.6) {¿Se cumplen las tres condiciones?};
\draw[->, thick] (desb) -- (cond);

\node[salida, fill=black!2] (eficiente) at (1.4,3.6) {El equilibrio es eficiente, aunque cada pa\'is tenga muchas distorsiones internas};
\draw[->, thick] (cond.west) -- ++(-1.5,0) |- node[above, pos=0.75, font=\scriptsize]{s\'i} (eficiente.north);

\node[fallo] (f1) at (5.0,3.6) {(i) Poder de mercado en los mercados internacionales};
\node[fallo] (f2) at (8.6,3.6) {(ii) Instrumentos insuficientes para el margen exterior};
\node[fallo] (f3) at (12.2,3.6) {(iii) Mercados internacionales imperfectos};
\draw[->, thick] (cond.south) -- ++(0,-0.5) -| node[above, pos=0.25, font=\scriptsize]{falla alguna} (f1.north);
\draw[->, thick] (cond.south) -- ++(0,-0.5) -| (f2.north);
\draw[->, thick] (cond.south) -- ++(0,-0.5) -| (f3.north);

\node[salida] (s1) at (5.0,1.5) {Manipular la relaci\'on real de intercambio: la coordinaci\'on limita el uso estrat\'egico};
\node[salida] (s2) at (8.6,1.5) {Se distorsionan los internos: la coordinaci\'on crea o reparte instrumentos};
\node[salida] (s3) at (12.2,1.5) {Nadie puede corregirlos solo: la coordinaci\'on es imprescindible};
\draw[->, thick] (f1) -- (s1);
\draw[->, thick] (f2) -- (s2);
\draw[->, thick] (f3) -- (s3);
\end{tikzpicture}
