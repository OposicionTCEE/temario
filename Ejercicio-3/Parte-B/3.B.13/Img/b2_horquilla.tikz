% Figura (B2, «Horquilla»): los precios de compra, b, y de venta, a, del intermediario alrededor del valor que espera de la
% moneda, m. Cada media horquilla se compone de tres partes: los costes de tramitación, el riesgo de inventario y la pérdida
% esperada frente a los clientes mejor informados (selección adversa).
% Generar con: bash Code/generar_figura.sh b2_horquilla
\begin{tikzpicture}[font=\footnotesize, decoration={brace, amplitude=4pt}]
  \draw[->] (0,-0.2) -- (0,5.4) node[left] {precio};
  % precios
  \draw[very thick] (-0.15,4.6) -- (3.2,4.6) node[right] {$a$, precio de venta};
  \draw[thick, dashed] (-0.15,2.6) -- (3.2,2.6) node[right] {$m$, valor esperado};
  \draw[very thick] (-0.15,0.6) -- (3.2,0.6) node[right] {$b$, precio de compra};
  % componentes de la media horquilla superior
  \fill[black!15] (0.6,2.6) rectangle (1.6,3.2);
  \fill[black!35] (0.6,3.2) rectangle (1.6,3.9);
  \fill[black!60] (0.6,3.9) rectangle (1.6,4.6);
  \fill[black!15] (0.6,2.0) rectangle (1.6,2.6);
  \fill[black!35] (0.6,1.3) rectangle (1.6,2.0);
  \fill[black!60] (0.6,0.6) rectangle (1.6,1.3);
  % leyenda
  \begin{scope}[xshift=6.9cm]
    \fill[black!15] (0,3.3) rectangle (0.35,3.55); \node[anchor=west] at (0.45,3.43) {tramitación};
    \fill[black!35] (0,2.75) rectangle (0.35,3.0); \node[anchor=west] at (0.45,2.88) {inventario};
    \fill[black!60] (0,2.2) rectangle (0.35,2.45); \node[anchor=west] at (0.45,2.33) {selección adversa};
  \end{scope}
  \draw[decorate] (-0.35,0.6) -- (-0.35,4.6) node[midway, left=5pt] {horquilla};
\end{tikzpicture}
