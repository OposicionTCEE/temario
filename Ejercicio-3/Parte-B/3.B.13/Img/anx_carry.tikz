% Figura (Anexo I, «Carry trade»): rentabilidad de una estrategia de carry trade, ilustrativa.
% (a) Rentabilidad acumulada: sube despacio con el diferencial de intereses y cae de golpe cuando la moneda de
%     financiación se aprecia bruscamente. (b) Distribución de la rentabilidad: asimetría negativa, con una cola
%     izquierda más gruesa que la de una normal de la misma media y varianza (en trazos).
% Generar con: bash Code/generar_figura.sh anx_carry
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  % ---------------- (a) ----------------
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (3.2,3.35) {(a) Rentabilidad acumulada};
    \draw[->] (0,0) -- (6.6,0) node[right] {$t$};
    \draw[->] (0,0) -- (0,3.1);
    \draw[thick] plot coordinates {(0,0.3) (0.4,0.45) (0.8,0.62) (1.2,0.78) (1.6,0.97) (2.0,1.15) (2.1,0.55) (2.2,0.5)
      (2.6,0.68) (3.0,0.86) (3.4,1.05) (3.8,1.22) (4.2,1.42) (4.6,1.6) (5.0,1.82) (5.1,0.95) (5.2,0.9) (5.6,1.1) (6.0,1.3) (6.3,1.45)};
  \end{scope}
  % ---------------- (b) ----------------
  \begin{scope}[xshift=8.6cm]
    \node[font=\footnotesize\bfseries] at (2.9,3.35) {(b) Distribución de la rentabilidad};
    \draw[->] (0,0) -- (6.2,0) node[right] {$z$};
    \draw[->] (0,0) -- (0,3.1);
    \draw[thick, domain=0:6, samples=120] plot (\x, {2.6*exp(-((\x-3.9)^2)/0.55) + 0.35*exp(-((\x-1.0)^2)/0.35)});
    \draw[dashed, black!50, domain=0:6, samples=120] plot (\x, {2.0*exp(-((\x-3.55)^2)/1.1)});
    \draw[black!55] (3.55,0.05) -- (3.55,-0.05) node[below] {media};
  \end{scope}
\end{tikzpicture}
