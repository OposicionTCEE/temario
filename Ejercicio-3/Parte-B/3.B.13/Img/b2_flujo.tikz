% Figura (B2, «Información»): el flujo de órdenes lleva al precio información dispersa. A la izquierda, D recibe órdenes
% de compra y de venta de dólares de muchos clientes y las suma: compras menos ventas, el flujo neto. A la derecha, cuanto
% mayor es el flujo neto, más demanda de dólares revela y más sube D su precio; con flujo nulo, el precio no cambia.
% Ilustrativa, sin cifras.
% Generar con: bash Code/generar_figura.sh b2_flujo
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]},
    nodo/.style={draw, circle, minimum size=0.8cm, fill=white, inner sep=0pt},
    cliente/.style={draw, rounded corners=2pt, minimum width=1.3cm, minimum height=0.5cm, fill=black!5}]
  % ---------------- lo que recibe D ----------------
  \node[font=\footnotesize\bfseries] at (1.9,4.05) {Lo que recibe $D$};
  \foreach \i/\y/\t in {1/3.2/compra, 2/2.4/vende, 3/1.6/compra, 4/0.8/compra, 5/0.0/vende} {
    \node[cliente] (c\i) at (0.6,\y) {\t};
  }
  \node[nodo] (d) at (3.3,1.6) {$D$};
  \foreach \i in {1,...,5} { \draw[->] (c\i.east) -- (d); }
  \node[align=center, below] at (3.3,1.1) {suma compras\\menos ventas:\\flujo neto};
  % ---------------- cómo cotiza D ----------------
  \begin{scope}[xshift=7.0cm]
    \node[font=\footnotesize\bfseries] at (2.5,4.05) {Cómo cotiza $D$};
    \draw[->] (0,0) -- (5.0,0) node[right, align=left] {flujo neto\\de órdenes};
    \draw[->] (0,0) -- (0,3.6) node[above] {precio del dólar};
    \draw[very thick] (0.2,0.5) -- (4.6,3.1);
    \draw[densely dotted] (2.2,0) node[below] {$0$} -- (2.2,1.68) -- (0,1.68) node[left] {precio previo};
    \draw[dashed] (3.6,0) -- (3.6,2.51) -- (0,2.51) node[left] {precio nuevo};
    \node[black!65] at (1.1,-0.35) {más ventas};
    \node[black!65] at (3.9,-0.35) {más compras};
  \end{scope}
\end{tikzpicture}
