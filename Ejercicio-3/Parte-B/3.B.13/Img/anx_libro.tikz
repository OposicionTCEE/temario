% Figura (Anexo II, «Liquidez»): libro de órdenes de un par. A la izquierda, las órdenes de compra pendientes por
% nivel de precio (la mejor es b); a la derecha, las de venta (la mejor es a). La distancia entre a y b es la horquilla
% (estrechez) y la altura de las barras, la profundidad. (b) Una orden de compra de tamaño Q consume los niveles de venta
% y se ejecuta a un precio medio p, por encima de a: es el impacto en el precio.
% Generar con: bash Code/generar_figura.sh anx_libro
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  % ---------------- (a) ----------------
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (3.4,3.4) {(a) Libro de órdenes};
    \draw[->] (0,0) -- (6.7,0) node[right] {precio};
    \draw[->] (0,0) -- (0,3.0) node[above] {cantidad};
    \foreach \x/\h in {0.6/2.4, 1.2/2.0, 1.8/1.6, 2.4/1.1, 2.9/0.7} { \fill[black!35] (\x-0.2,0) rectangle (\x+0.2,\h); }
    \foreach \x/\h in {3.9/0.8, 4.4/1.2, 5.0/1.7, 5.6/2.1, 6.2/2.5} { \fill[black!12] (\x-0.2,0) rectangle (\x+0.2,\h); \draw[black!60] (\x-0.2,0) rectangle (\x+0.2,\h); }
    \node[below] at (2.9,0) {$b$};
    \node[below] at (3.9,0) {$a$};
    \draw[decorate, decoration={brace, amplitude=4pt}] (2.9,1.0) -- (3.9,1.0) node[midway, above=5pt] {horquilla};
    \node[black!65] at (1.2,2.75) {compras};
    \node[black!65] at (5.6,2.85) {ventas};
  \end{scope}
  % ---------------- (b) ----------------
  \begin{scope}[xshift=8.1cm]
    \node[font=\footnotesize\bfseries] at (3.4,3.4) {(b) Una compra de tamaño $Q$};
    \draw[->] (0,0) -- (6.7,0) node[right] {precio};
    \draw[->] (0,0) -- (0,3.0) node[above] {cantidad};
    \foreach \x/\h in {0.6/2.4, 1.2/2.0, 1.8/1.6, 2.4/1.1, 2.9/0.7} { \fill[black!35] (\x-0.2,0) rectangle (\x+0.2,\h); }
    \foreach \x/\h in {3.9/0.8, 4.4/1.2, 5.0/1.7} { \fill[black!55] (\x-0.2,0) rectangle (\x+0.2,\h); }
    \foreach \x/\h in {5.6/2.1, 6.2/2.5} { \fill[black!12] (\x-0.2,0) rectangle (\x+0.2,\h); \draw[black!60] (\x-0.2,0) rectangle (\x+0.2,\h); }
    \node[below] at (3.9,0) {$a$};
    \draw[thick, dashed] (4.55,0) -- (4.55,2.3);
    \node[below] at (4.55,0) {$\bar{p}$};
    \draw[decorate, decoration={brace, amplitude=4pt}] (3.7,1.95) -- (5.2,1.95) node[midway, above=5pt] {$Q$};
  \end{scope}
\end{tikzpicture}
