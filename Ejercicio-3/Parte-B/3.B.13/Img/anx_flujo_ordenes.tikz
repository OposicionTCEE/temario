% Figura (Anexo II, «EVANS y LYONS»): variación diaria del tipo de cambio frente al flujo neto de órdenes, ilustrativa.
% Cada punto es un día; la pendiente de la recta es el impacto en el precio de cada unidad de flujo neto.
% Generar con: bash Code/generar_figura.sh anx_flujo_ordenes
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, scale=1.0]
  \draw[->] (-3.3,0) -- (3.5,0) node[right] {flujo neto de órdenes, $y_t$};
  \draw[->] (0,-2.6) -- (0,2.8) node[above] {$\Delta\ln S_t$};
  \foreach \p in {(-2.8,-2.0),(-2.4,-1.4),(-2.1,-1.9),(-1.8,-1.0),(-1.5,-1.3),(-1.2,-0.6),(-1.0,-1.0),(-0.7,-0.2),(-0.5,-0.7),(-0.3,0.1),(-0.1,-0.3),
                  (0.2,0.4),(0.4,-0.1),(0.6,0.6),(0.9,0.3),(1.1,1.0),(1.4,0.7),(1.6,1.4),(1.9,1.0),(2.2,1.7),(2.5,1.4),(2.8,2.1),(-1.9,-0.4),(1.3,1.6),(0.1,0.8),(-0.9,0.2)} {
    \fill[black!65] \p circle (1.5pt);
  }
  \draw[thick] (-3.0,-2.1) -- (3.0,2.1);
\end{tikzpicture}
