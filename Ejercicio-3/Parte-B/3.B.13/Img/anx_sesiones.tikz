% Figura (Anexo III, «Concentración»): sesiones del mercado de divisas en un día laborable del invierno del hemisferio norte,
% en hora UTC (Londres, UTC; Nueva York, UTC - 5; Tokio, UTC + 9; Singapur y Hong Kong, UTC + 8; Sídney, UTC + 11 en su
% verano). Cada barra va, de forma orientativa, de las 8 a las 17 horas locales; la de Sídney empieza la víspera, en hora
% UTC. Sombreado: horas en que Londres y Nueva York negocian a la vez. Líneas discontinuas: fijación de las 16:00 de
% Londres y cierre del día de mercado a las 17:00 de Nueva York.
% Generar con: bash Code/generar_figura.sh anx_sesiones
\begin{tikzpicture}[font=\footnotesize, x=0.48cm, y=0.6cm]
  \fill[black!10] (13,0) rectangle (17,5.6);
  \foreach \y/\nombre/\a/\b in {5/Sídney/21/24, 4/Tokio/0/9, 3/Singapur y Hong Kong/1/10, 2/Londres/8/17, 1/Nueva York/13/22} {
    \fill[black!55] (\a,\y-0.22) rectangle (\b,\y+0.22);
    \node[anchor=east] at (-0.3,\y) {\nombre};
  }
  \fill[black!55] (0,4.78) rectangle (6,5.22);
  \draw[->, >={Stealth[length=4pt]}] (0,0) -- (24.9,0) node[right] {UTC};
  \foreach \h in {0,3,...,24} { \draw (\h,0) -- (\h,-0.12) node[below] {$\h$}; }
  \draw[dashed] (16,0) -- (16,6.1) node[anchor=south east, inner sep=1pt] {fijación de las $16$ en Londres};
  \draw[dashed] (22,0) -- (22,6.1) node[anchor=south, inner sep=1pt] {cierre a las $17$ en Nueva York};
\end{tikzpicture}
