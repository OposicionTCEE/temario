% Figura (Anexo II, «Canales»): por dónde llegan las órdenes al mercado. Los clientes llegan al intermediario por voz,
% por su plataforma propia o por plataformas multibanco; el intermediario casa dentro de casa (internalización) y sale con
% lo que le sobra a las plataformas entre intermediarios, a las que acceden también las empresas no bancarias a través
% del corretaje principal de un banco.
% Generar con: bash Code/generar_figura.sh anx_ejecucion
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]},
    caja/.style={draw, rounded corners=2pt, fill=black!6, minimum width=2.9cm, minimum height=1.0cm, align=center}]
  \node[caja] (C) at (0,0) {Clientes};
  \node[caja, minimum height=1.6cm] (D) at (6.2,0) {Intermediario};
  \node[caja] (P) at (11.9,0.9) {Plataformas entre\\intermediarios};
  \node[caja] (N) at (11.9,-1.6) {Empresas no\\bancarias};
  \draw[->, thick] ([yshift=0.45cm]C.east) -- node[above] {voz} ([yshift=0.45cm]D.west);
  \draw[->, thick] (C.east) -- node[above] {plataforma propia} (D.west);
  \draw[->, thick] ([yshift=-0.45cm]C.east) -- node[below] {plataforma multibanco} ([yshift=-0.45cm]D.west);
  \draw[->, thick] (D.east) -- node[above, sloped] {lo que sobra} (P.west);
  \draw[->, thick, dashed] (N.north) -- node[right] {corretaje principal} (P.south);
  \draw[->, thick] (D.south) .. controls (5.2,-1.6) and (7.2,-1.6) .. node[below] {internalización} ([xshift=0.3cm]D.south);
\end{tikzpicture}
