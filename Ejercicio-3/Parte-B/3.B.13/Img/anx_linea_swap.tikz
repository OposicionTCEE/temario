% Figura (Anexo III, «Bancos centrales»): funcionamiento de una línea swap entre la Reserva Federal y el BCE.
% (a) Al concederla (t = 0): la Reserva Federal entrega N dólares al BCE y recibe S0·N euros al contado; el BCE presta los
%     dólares a los bancos de la zona del euro contra garantías, al mismo plazo y tipo.
% (b) Al vencimiento (T): los bancos devuelven al BCE los dólares con sus intereses, el BCE los devuelve a la Reserva
%     Federal y recupera sus S0·N euros al mismo tipo de cambio, y devuelve las garantías a los bancos.
% Generar con: bash Code/generar_figura.sh anx_linea_swap
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]},
    caja/.style={draw, rounded corners=2pt, minimum width=2.9cm, minimum height=0.85cm, align=center, fill=black!5}]
  % ---------------- (a) t = 0 ----------------
  \begin{scope}
    \node[font=\footnotesize\bfseries\boldmath] at (6.2,1.35) {(a) Al conceder la línea ($t=0$)};
    \node[caja] (f) at (0,0) {Reserva Federal};
    \node[caja] (e) at (6.2,0) {BCE};
    \node[caja] (b) at (12.4,0) {Bancos de la\\zona del euro};
    \draw[->, thick] ([yshift=0.18cm]f.east) -- node[above] {$N$ dólares} ([yshift=0.18cm]e.west);
    \draw[<-, thick] ([yshift=-0.18cm]f.east) -- node[below] {$S_0N$ euros} ([yshift=-0.18cm]e.west);
    \draw[->, thick] ([yshift=0.18cm]e.east) -- node[above] {$N$ dólares} ([yshift=0.18cm]b.west);
    \draw[<-, thick] ([yshift=-0.18cm]e.east) -- node[below] {garantías} ([yshift=-0.18cm]b.west);
  \end{scope}
  % ---------------- (b) T ----------------
  \begin{scope}[yshift=-2.75cm]
    \node[font=\footnotesize\bfseries\boldmath] at (6.2,1.35) {(b) Al vencimiento ($T$)};
    \node[caja] (f) at (0,0) {Reserva Federal};
    \node[caja] (e) at (6.2,0) {BCE};
    \node[caja] (b) at (12.4,0) {Bancos de la\\zona del euro};
    \draw[<-, thick] ([yshift=0.18cm]f.east) -- node[above] {$N$ dólares más intereses} ([yshift=0.18cm]e.west);
    \draw[->, thick] ([yshift=-0.18cm]f.east) -- node[below] {$S_0N$ euros} ([yshift=-0.18cm]e.west);
    \draw[<-, thick] ([yshift=0.18cm]e.east) -- node[above] {$N$ dólares más intereses} ([yshift=0.18cm]b.west);
    \draw[->, thick] ([yshift=-0.18cm]e.east) -- node[below] {garantías} ([yshift=-0.18cm]b.west);
  \end{scope}
\end{tikzpicture}
