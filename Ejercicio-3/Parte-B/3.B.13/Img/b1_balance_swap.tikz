% Figura (B1, «Usos y deuda»): el balance de E cuando obtiene N dólares con un préstamo y cuando los obtiene con un FX
% swap. Con el préstamo, el balance crece por los dos lados: los activos que compra con los dólares y la deuda en dólares.
% Con el swap, E entrega euros que ya tenía: el balance no crece, solo cambia la composición de los activos, y el compromiso
% de devolver los N dólares en T (y recuperar FN euros) queda fuera del balance.
% Generar con: bash Code/generar_figura.sh b1_balance_swap
\begin{tikzpicture}[font=\footnotesize]
  % ---------------- con un préstamo ----------------
  \node at (1.7,3.6) {Con un préstamo en dólares};
  \draw (0,0) rectangle (1.6,2.2); \node[align=center] at (0.8,1.1) {otros\\activos};
  \draw[fill=black!15] (0,2.2) rectangle (1.6,3.2); \node[align=center] at (0.8,2.7) {activos\\en dólares};
  \draw (1.8,0) rectangle (3.4,0.45); \node at (2.6,0.225) {capital};
  \draw (1.8,0.45) rectangle (3.4,2.2); \node[align=center] at (2.6,1.325) {otros\\pasivos};
  \draw[fill=black!15] (1.8,2.2) rectangle (3.4,3.2); \node[align=center] at (2.6,2.7) {préstamo\\en dólares};
  \node[below] at (0.8,0) {activo}; \node[below] at (2.6,0) {pasivo};
  % ---------------- con un FX swap ----------------
  \begin{scope}[xshift=4.9cm]
    \node at (1.7,3.6) {Con un \textit{FX swap}};
    \draw (0,0) rectangle (1.6,1.2); \node[align=center] at (0.8,0.6) {otros\\activos};
    \draw[fill=black!15] (0,1.2) rectangle (1.6,2.2); \node[align=center] at (0.8,1.7) {activos\\en dólares};
    \draw (1.8,0) rectangle (3.4,0.45); \node at (2.6,0.225) {capital};
    \draw (1.8,0.45) rectangle (3.4,2.2); \node[align=center] at (2.6,1.325) {otros\\pasivos};
    \node[below] at (0.8,0) {activo}; \node[below] at (2.6,0) {pasivo};
    \draw[dashed] (0,-0.75) rectangle (3.4,-1.75);
    \node[align=center] at (1.7,-1.25) {fuera del balance: entregar $N$ dólares\\en $T$ y recuperar $FN$ euros};
  \end{scope}
\end{tikzpicture}
