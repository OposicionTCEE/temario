% Figura (Anexo III, «Riesgos»): obligaciones de pago brutas liquidadas en una media diaria de abril de 2025 (unos 14,2
% billones de dólares), por método de liquidación, en porcentaje del total y en billones de dólares. En gris oscuro, el
% pago contra pago, que elimina el riesgo de liquidación; en gris claro, los métodos que lo reducen sin eliminarlo (neteo
% previo, liquidación dentro del grupo y cuentas en que el intermediario controla el momento del pago); en blanco, la
% liquidación bruta bilateral, expuesta por todo el importe.
% Fuente: BPI, encuesta trienal, conjunto WS_DER_OTC_TOV (preguntas de liquidación de 2025), descarga del 04/11/2026.
% Datos y tratamientos en Code/datos_3B13.xlsx; generada con Code/libro_y_figuras.py.
% Generar con: bash Code/generar_figura.sh anx_liquidacion
\begin{tikzpicture}[font=\footnotesize]
  \draw (0,0.1) -- (0,2.95);
  \filldraw[fill=black!70] (0,2.43) rectangle (7.271,2.77);
  \node[anchor=east] at (-0.08,2.60) {pago contra pago};
  \node[anchor=west] at (7.321,2.60) {$36{,}4\%$ ($5{,}2$ billones)};
  \filldraw[fill=black!35] (0,1.88) rectangle (3.055,2.22);
  \node[anchor=east] at (-0.08,2.05) {neteo previo};
  \node[anchor=west] at (3.105,2.05) {$15{,}3\%$ ($2{,}2$ billones)};
  \filldraw[fill=black!35] (0,1.33) rectangle (6.979,1.67);
  \node[anchor=east] at (-0.08,1.50) {dentro del grupo};
  \node[anchor=west] at (7.029,1.50) {$34{,}9\%$ ($4{,}9$ billones)};
  \filldraw[fill=black!35] (0,0.78) rectangle (0.699,1.12);
  \node[anchor=east] at (-0.08,0.95) {cuentas con control del pago};
  \node[anchor=west] at (0.749,0.95) {$3{,}5\%$ ($0{,}5$ billones)};
  \filldraw[fill=white, very thick] (0,0.23) rectangle (1.996,0.57);
  \node[anchor=east] at (-0.08,0.40) {liquidación bruta bilateral};
  \node[anchor=west] at (2.046,0.40) {$10{,}0\%$ ($1{,}4$ billones)};
  \filldraw[fill=black!70] (5.6,2.55) rectangle (5.9,2.75); \node[anchor=west] at (5.95,2.65) {elimina el riesgo};
  \filldraw[fill=black!35] (5.6,2.1) rectangle (5.9,2.3); \node[anchor=west] at (5.95,2.2) {lo reduce};
  \filldraw[fill=white, very thick] (5.6,1.65) rectangle (5.9,1.85); \node[anchor=west] at (5.95,1.75) {expuesta por todo el importe};
\end{tikzpicture}
