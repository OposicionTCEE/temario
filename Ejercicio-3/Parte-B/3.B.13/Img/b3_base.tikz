% Figura (cuerpo, bloque 3, «Arbitraje»): la base de divisas como precio del balance. En el eje vertical, lo que cuesta el
% dólar sintético por encima del tipo del dólar, r_sint - r_f*, que es la base con el signo cambiado (-x); en el horizontal,
% la cantidad de dólares sintéticos. Los arbitrajistas ofrecen dólares sintéticos sin recargo hasta donde su balance lo
% permite, y a partir de ahí solo con un recargo creciente; los bancos e inversores que necesitan dólares los demandan. En
% tiempos normales la base es pequeña; cuando la demanda crece, en tensión, la base se amplía hasta el techo que pone la
% línea swap de la Reserva Federal.
% Generar con: bash Code/generar_figura.sh b3_base
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  \draw[->] (0,0) -- (8.6,0) node[below left] {dólares sintéticos};
  \draw[->] (0,0) -- (0,4.6) node[left] {$r^{\$}_{\mathrm{sint}}-r_f^*$};
  % oferta de los arbitrajistas
  \draw[very thick] (0,0.15) -- (3.6,0.15);
  \draw[very thick, domain=3.6:7.6, samples=60] plot (\x, {0.15 + 0.22*(\x-3.6)^2});
  \node[right] at (7.6,3.67) {oferta de los arbitrajistas};
  % techo de la línea swap
  \draw[dashed] (0,3.0) node[left] {techo} -- (8.2,3.0) node[right] {línea swap};
  % demanda normal y en tensión
  \draw[thick] (0.6,2.4) -- (5.6,0.0) node[below] {demanda normal};
  \draw[thick, densely dashed] (2.6,4.3) -- (8.2,1.6) node[right] {demanda en tensión};
  % equilibrios
  \fill (4.31,0.62) circle (1.8pt);
  \draw[densely dotted] (0,0.62) node[left] {$-x$} -- (4.31,0.62);
  \fill (5.03,3.0) circle (1.8pt);
\end{tikzpicture}
