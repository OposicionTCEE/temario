% Figura (Anexo II, «Fijaciones»): tipo de cambio alrededor de la fijación de las 16:00 de Londres, ilustrativo.
% La zona sombreada es la ventana de cálculo (cinco minutos desde febrero de 2015); el precio sube con fuerza dentro
% de la ventana, cuando se concentran las órdenes, y se revierte después.
% Generar con: bash Code/generar_figura.sh anx_fijacion
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=0.9cm, y=1.0cm]
  \fill[black!8] (4.5,0) rectangle (9.5,3.2);
  \draw[->] (0,0) -- (14.3,0) node[right] {hora};
  \draw[->] (0,0) -- (0,3.4) node[above] {$S$};
  \foreach \x/\t in {2/{15:55}, 7/{16:00}, 12/{16:05}} { \draw (\x,0) -- (\x,-0.1) node[below] {\t}; }
  \draw[thick] plot coordinates {(0,1.2) (0.7,1.25) (1.4,1.15) (2.1,1.3) (2.8,1.25) (3.5,1.4) (4.2,1.45) (4.8,1.75) (5.4,2.1) (6.0,2.45) (6.6,2.7) (7.0,2.85) (7.5,2.7) (8.2,2.5) (9.0,2.2) (9.8,1.9) (10.6,1.7) (11.4,1.6) (12.2,1.55) (13.0,1.5) (13.8,1.5)};
  \node[black!65, align=center] at (7.0,3.55) {ventana de cálculo};
\end{tikzpicture}
