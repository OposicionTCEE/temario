% Figura (Anexo III, «Riesgos»): la quiebra de Herstatt el 26 de junio de 1974, en hora de Europa central. Durante el día,
% las contrapartes pagan marcos a Herstatt en Fráncfort; a las 15:30, cuando Nueva York acaba de abrir (las 10:30 allí),
% las autoridades alemanas cierran el banco, y los dólares que debía pagar en Nueva York ya no se pagan: quienes le
% habían entregado marcos quedan expuestos por todo el importe.
% Fuente: GALATI (2002).
% Generar con: bash Code/generar_figura.sh anx_herstatt
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=0.92cm, y=1cm]
  % eje de horas (Europa central)
  \draw[->] (8,0) -- (21.4,0) node[right] {hora};
  \foreach \h in {8,10,...,20} { \draw (\h,0) -- (\h,-0.1) node[below] {$\h$}; }
  % carriles
  \node[anchor=east, align=right] at (7.85,1.95) {Fráncfort\\(marcos)};
  \node[anchor=east, align=right] at (7.85,0.85) {Nueva York\\(dólares)};
  \fill[black!25] (8.7,1.73) rectangle (15.5,2.17);
  \node at (12.1,1.95) {las contrapartes pagan marcos a Herstatt};
  \draw[dashed, thick] (15.5,0.63) rectangle (20.8,1.07);
  \node at (18.15,0.85) {dólares que ya no se pagan};
  % cierre
  \draw[very thick] (15.5,0) -- (15.5,2.75) node[above, align=center] {$15{:}30$: cierre de Herstatt\\($10{:}30$ en Nueva York)};
\end{tikzpicture}
