% Figura (Anexo III, «Historia»): hitos del mercado de divisas como mercado, de 1866 a 2025, en dos tramos y sin escala
% (los hitos van a la misma distancia aunque los separen años distintos). Primer tramo, del cable transatlántico a la
% flotación general de 1973; segundo tramo, de la quiebra de Herstatt (1974) a la encuesta de abril de 2025.
% Fuentes: MICHIE (2024), NAEF (2022), KEYNES (1923), GALATI (2001), BPI y Reserva Federal (véase el texto).
% Generar con: bash Code/generar_figura.sh anx_cronologia
\begin{tikzpicture}[font=\scriptsize,
    hito/.style={circle, fill=black, inner sep=1.6pt},
    rotulo/.style={align=center, inner sep=1pt}]
  % ---------------- 1866-1973 ----------------
  \draw[thick, ->, >={Stealth[length=4pt]}] (0,0) -- (15.6,0);
  \foreach \i/\anio/\texto in {%
      0/1866/{cable transatlántico\\entre Londres\\y Nueva York},
      1/1923/{KEYNES estudia\\el mercado a plazo},
      2/1939/{se cierra\\el mercado de Londres},
      3/1944/{Bretton Woods:\\paridades fijas\\y controles},
      4/1951/{reabre, controlado,\\el mercado de Londres},
      5/1958/{convertibilidad\\de las monedas\\europeas},
      6/1971/{fin de la\\convertibilidad\\del dólar en oro},
      7/1973/{flotación\\general}} {
    \pgfmathsetmacro{\x}{1.3 + 1.857*\i}
    \node[hito] at (\x,0) {};
    \pgfmathparse{int(mod(\i,2))}
    \ifnum\pgfmathresult=0
      \node[font=\scriptsize\bfseries\boldmath, anchor=north] at (\x,-0.1) {$\anio$};
      \node[rotulo, anchor=north] at (\x,-0.45) {\texto};
    \else
      \node[font=\scriptsize\bfseries\boldmath, anchor=south] at (\x,0.1) {$\anio$};
      \node[rotulo, anchor=south] at (\x,0.45) {\texto};
    \fi
  }
  % ---------------- 1974-2025 ----------------
  \begin{scope}[yshift=-3.5cm]
  \draw[thick, ->, >={Stealth[length=4pt]}] (0,0) -- (15.6,0);
  \foreach \i/\anio/\texto in {%
      0/1974/{quiebra\\de Herstatt},
      1/1979/{el Reino Unido\\suprime\\sus controles},
      2/1981/{negociación\\electrónica\\entre bancos},
      3/1992/{casación\\electrónica\\de órdenes},
      4/1999/{nace\\el euro},
      5/2002/{empieza\\a liquidar CLS},
      6/2008/{líneas swap\\sin límite},
      7/2014/{multas por\\manipular\\las fijaciones},
      8/2017/{código global\\de conducta},
      9/2025/{aranceles\\y récord\\de volumen}} {
    \pgfmathsetmacro{\x}{1.3 + 1.444*\i}
    \node[hito] at (\x,0) {};
    \pgfmathparse{int(mod(\i,2))}
    \ifnum\pgfmathresult=0
      \node[font=\scriptsize\bfseries\boldmath, anchor=north] at (\x,-0.1) {$\anio$};
      \node[rotulo, anchor=north] at (\x,-0.45) {\texto};
    \else
      \node[font=\scriptsize\bfseries\boldmath, anchor=south] at (\x,0.1) {$\anio$};
      \node[rotulo, anchor=south] at (\x,0.45) {\texto};
    \fi
  }
  \end{scope}
\end{tikzpicture}
