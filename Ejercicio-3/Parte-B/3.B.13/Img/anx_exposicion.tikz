% Figura (Anexo I, «Exposición»): las tres exposiciones al tipo de cambio en el tiempo.
% Conversión: los estados de las filiales en otra moneda, a la fecha de cierre (hoy). Transacción: los cobros y pagos
% en divisas ya pactados, con importe y fecha ciertos. Económica: los flujos futuros aún no pactados, inciertos.
% Generar con: bash Code/generar_figura.sh anx_exposicion
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  \draw[->] (0,0) -- (15.2,0) node[right] {$t$};
  \draw (1.0,0.1) -- (1.0,-0.1) node[below] {cierre contable};
  \draw (6.5,0.1) -- (6.5,-0.1) node[below] {último flujo pactado};
  % conversión
  \node[draw, rounded corners=2pt, fill=black!8, minimum width=2.4cm, minimum height=0.8cm, align=center] at (1.0,1.6) {Conversión};
  \draw[thick] (1.0,1.2) -- (1.0,0.15);
  % transacción: flujos ciertos
  \node[draw, rounded corners=2pt, fill=black!8, minimum width=3.6cm, minimum height=0.8cm, align=center] at (4.2,1.6) {Transacción};
  \foreach \x in {2.6,3.7,4.8,5.9} { \draw[->, thick] (\x,0.15) -- (\x,1.0); }
  % económica: flujos inciertos
  \node[draw, rounded corners=2pt, fill=black!8, minimum width=6.4cm, minimum height=0.8cm, align=center] at (10.9,1.6) {Económica};
  \foreach \x/\h in {7.6/0.55,8.7/0.85,9.8/0.45,10.9/0.95,12.0/0.6,13.1/0.8,14.2/0.5} {
    \draw[->, dashed, black!60] (\x,0.15) -- (\x,0.15+\h);
    \draw[black!35] (\x-0.12,0.15+\h+0.25) -- (\x+0.12,0.15+\h+0.25);
    \draw[black!35] (\x-0.12,0.15+\h-0.25) -- (\x+0.12,0.15+\h-0.25);
    \draw[black!35] (\x,0.15+\h-0.25) -- (\x,0.15+\h+0.25);
  }
\end{tikzpicture}
