% Figura (B1, «Precio», primera consecuencia): las expectativas no entran en el tipo a plazo, sino en el contado. Hoy, el
% contado S y los tipos de interés fijan F; el contado esperado para T puede estar en cualquier sitio, y no interviene. Si
% todo el mercado espera que el dólar suba, compra dólares hoy: el contado sube a S' y el tipo a plazo a F', pero la
% distancia proporcional entre los dos sigue siendo la que fijan r_f y r_f^* (aquí, con el dólar pagando más, F < S).
% Generar con: bash Code/generar_figura.sh b1_expectativas
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  \draw[->] (0,0) -- (7.0,0) node[below left] {tiempo};
  \draw[->] (0,0) -- (0,4.5) node[left] {euros por dólar};
  \draw[densely dotted] (1.5,0) node[below] {hoy} -- (1.5,4.1);
  \draw[densely dotted] (5.5,0) node[below] {$T$} -- (5.5,4.1);
  % situación de partida
  \fill (1.5,1.8) circle (2pt) node[left] {$S$};
  \fill (5.5,1.5) circle (2pt) node[right] {$F$};
  \draw[->, thick] (1.6,1.78) -- (5.4,1.52) node[midway, below, sloped] {lo fijan $S$, $r_f$ y $r_f^*$};
  \draw (5.5,0.8) circle (2pt) node[right] {contado esperado};
  % si se espera que el dólar suba
  \fill[black!50] (1.5,3.0) circle (2pt) node[left, black!65] {$S'$};
  \fill[black!50] (5.5,2.5) circle (2pt) node[right, black!65] {$F'$};
  \draw[->, thick, black!50] (1.6,2.98) -- (5.4,2.52);
  \draw[black!50] (5.5,3.7) circle (2pt) node[right, black!65] {contado esperado, más alto};
  \draw[->, dashed, black!50] (1.5,1.95) -- (1.5,2.85);
  \node[right, align=left, black!65] at (1.6,2.35) {se compran\\dólares hoy};
\end{tikzpicture}
