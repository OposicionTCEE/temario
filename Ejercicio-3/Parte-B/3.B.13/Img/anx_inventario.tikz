% Figura (Anexo II, «Precios de reserva»): cotizaciones de un intermediario con aversión al riesgo según su inventario q
% de la divisa base. b(q) = m - θσ²(q + 1/2), a(q) = m - θσ²(q - 1/2): las dos bajan cuando q crece, la horquilla es
% constante (θσ²) y el precio medio, m - θσ²q, solo coincide con m cuando el inventario es nulo.
% Generar con: bash Code/generar_figura.sh anx_inventario
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1.6cm, y=1.0cm]
  \draw[->] (-3.3,0) -- (3.4,0) node[right] {$q$};
  \draw[->] (0,-0.2) -- (0,5.2) node[above] {precio};
  \draw[thick] (-3,4.35) -- (3,1.35) node[right] {$a(q)$};
  \draw[thick] (-3,3.65) -- (3,0.65) node[right] {$b(q)$};
  \draw[dashed, black!50] (-3,4.0) -- (3,1.0) node[right] {precio medio};
  \draw[black!45] (0,2.5) -- (-0.1,2.5) node[left] {$m$};
  \fill (0,2.5) circle (1.4pt);
  \draw[<->, black!70] (2.2,1.75) -- (2.2,1.05);
  \node[right] at (2.22,1.42) {$\theta\sigma^2$};
  \node[below] at (0,0) {$0$};
\end{tikzpicture}
