% Figura (B1, «Divisa»): una operación de cambio entre A, que vende N dólares, y el intermediario D, que se los compra al
% tipo S. En el sistema de pagos del dólar, un depósito de N dólares pasa de A a D; en el del euro, un depósito de SN euros
% pasa de D a A. Cada moneda se mueve en su propio sistema y ningún billete cambia de manos.
% Generar con: bash Code/generar_figura.sh b1_cambio
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]},
    agente/.style={draw, rounded corners=2pt, minimum width=1.5cm, minimum height=0.8cm, fill=black!5},
    sistema/.style={draw, black!45, dashed, rounded corners=6pt}]
  % ---------------- sistema del dólar ----------------
  \draw[sistema] (-0.4,1.05) rectangle (9.4,2.75);
  \node[anchor=north west, black!60] at (-0.3,2.7) {sistema de pagos del dólar};
  \node[agente] (a1) at (1.1,1.65) {$A$};
  \node[agente] (d1) at (7.9,1.65) {$D$};
  \draw[->, thick] (a1) -- node[above] {depósito de $N$ dólares} (d1);
  % ---------------- sistema del euro ----------------
  \draw[sistema] (-0.4,-0.95) rectangle (9.4,0.75);
  \node[anchor=north west, black!60] at (-0.3,0.7) {sistema de pagos del euro};
  \node[agente] (a2) at (1.1,-0.35) {$A$};
  \node[agente] (d2) at (7.9,-0.35) {$D$};
  \draw[<-, thick] (a2) -- node[above] {depósito de $SN$ euros} (d2);
\end{tikzpicture}
