% Figura (Anexo I, «Ciclo de una operación»): de la negociación en T a la liquidación en la fecha valor (T+2).
% Las cuatro etapas: negociación, confirmación, compensación (cálculo y neteo de obligaciones por moneda y fecha valor)
% y liquidación, en la que cada pata se paga en el sistema de su moneda; con pago contra pago (CLS) las dos patas se
% liquidan a la vez, y sin él, cada una por su lado a través de corresponsales.
% Generar con: bash Code/generar_figura.sh anx_contado
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]},
    paso/.style={draw, rounded corners=2pt, minimum width=2.75cm, minimum height=1.05cm, align=center, fill=black!5}]
  % eje temporal
  \draw[->] (-0.2,-1.15) -- (15.4,-1.15) node[right] {$t$};
  \foreach \x/\t in {1.4/$T$, 7.4/$T+1$, 13.3/$T+2$} {
    \draw (\x,-1.05) -- (\x,-1.25);
    \node[below] at (\x,-1.25) {\t};
  }
  % etapas
  \node[paso] (N) at (1.4,0) {Negociación\\(precio y cantidad)};
  \node[paso] (C) at (4.5,0) {Confirmación\\(cotejo de datos)};
  \node[paso] (K) at (7.6,0) {Compensación\\(neteo por moneda)};
  \node[paso] (L) at (11.0,0) {Liquidación};
  \draw[->, thick] (N) -- (C);
  \draw[->, thick] (C) -- (K);
  \draw[->, thick] (K) -- (L);
  % dos patas en la fecha valor
  \node[draw, rounded corners=2pt, minimum width=2.7cm, minimum height=0.75cm, align=center] (PE) at (13.9,0.75) {pata en euros (T2)};
  \node[draw, rounded corners=2pt, minimum width=2.7cm, minimum height=0.75cm, align=center] (PD) at (13.9,-0.4) {pata en dólares\\(Fedwire)};
  \draw[->, thick] (L.east) -- (PE.west);
  \draw[->, thick] (L.east) -- (PD.west);
  % pago contra pago frente a liquidación separada
  \node[black!65, align=center, anchor=south] at (13.9,1.2) {con pago contra pago (CLS): a la vez\\sin él: cada pata por su lado};
\end{tikzpicture}
