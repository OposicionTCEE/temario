% Figura (Anexo I, «Ciclo de una operación»): de la negociación en T a la liquidación en la fecha valor (T+2).
% Las cuatro etapas: negociación, confirmación, compensación (cálculo y neteo de obligaciones por moneda y fecha valor)
% y liquidación, en la que cada pata se paga en el sistema de pagos de su moneda.
% Generar con: bash Code/generar_figura.sh anx_contado
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]},
    paso/.style={draw, rounded corners=2pt, minimum width=2.6cm, minimum height=0.95cm, align=center, fill=black!5}]
  % eje temporal
  \draw[->] (-0.2,-1.2) -- (15.05,-1.2) node[right] {$t$};
  \foreach \x/\t in {1.3/$T$, 7.4/$T+1$, 13.6/$T+2$} {
    \draw (\x,-1.1) -- (\x,-1.3);
    \node[below] at (\x,-1.3) {\t};
  }
  % etapas
  \node[paso] (N) at (1.3,0) {Negociación};
  \node[paso] (C) at (4.35,0) {Confirmación};
  \node[paso] (K) at (7.4,0) {Compensación};
  \node[paso] (L) at (10.45,0) {Liquidación};
  \draw[->, thick] (N) -- (C);
  \draw[->, thick] (C) -- (K);
  \draw[->, thick] (K) -- (L);
  % dos patas en la fecha valor
  \node[draw, rounded corners=2pt, minimum width=2.7cm, minimum height=0.75cm, align=center] (PE) at (13.6,0.55) {Pata en euros (T$2$)};
  \node[draw, rounded corners=2pt, minimum width=2.7cm, minimum height=0.75cm, align=center] (PD) at (13.6,-0.55) {Pata en dólares (Fedwire)};
  \draw[->, thick] (L.east) -- (PE.west);
  \draw[->, thick] (L.east) -- (PD.west);
\end{tikzpicture}
