% Figura (Anexo III, «Participantes»): estructura del mercado en dos niveles. En el nivel entre intermediarios, unos pocos
% grandes bancos (D1 a D4) negocian entre sí, directamente o a través de plataformas y corredores; en el nivel de clientes,
% cada cliente negocia con uno o varios intermediarios, no con los demás clientes. Los bancos no declarantes son clientes
% de los grandes; los particulares llegan a través de intermediarios minoristas; los fondos de cobertura y las empresas de
% negociación por cuenta propia acceden al nivel superior con el crédito de un corredor principal.
% Generar con: bash Code/generar_figura.sh anx_red
\begin{tikzpicture}[font=\footnotesize,
    nodo/.style={draw, circle, minimum size=0.85cm, fill=white, inner sep=0pt},
    cliente/.style={draw, rounded corners=2pt, minimum height=0.8cm, align=center, fill=black!5, inner sep=3pt}]
  % ---------------- nivel entre intermediarios ----------------
  \fill[black!8, rounded corners=14pt] (4.0,1.05) rectangle (10.0,4.05);
  \node[black!65, anchor=north] at (7.0,4.0) {nivel entre intermediarios};
  \node[nodo] (a) at (5.3,2.45) {$D_1$};
  \node[nodo] (b) at (7.0,3.25) {$D_2$};
  \node[nodo] (c) at (8.7,2.45) {$D_3$};
  \node[nodo] (d) at (7.0,1.65) {$D_4$};
  \draw[thick] (a) -- (b) -- (c) -- (d) -- (a);
  \draw[thick] (a) -- (c);
  \draw[thick] (b) -- (d);
  % ---------------- nivel de clientes ----------------
  \node[black!65, anchor=west] at (0.05,-1.95) {nivel de clientes};
  \node[cliente] (nd) at (1.55,2.45) {bancos no\\declarantes};
  \node[cliente] (ii) at (3.2,-0.45) {inversores\\institucionales};
  \node[cliente] (em) at (7.0,-0.45) {empresas};
  \node[cliente] (mi) at (10.6,-0.45) {intermediarios\\minoristas};
  \node[cliente] (pa) at (10.6,-1.95) {particulares};
  \node[cliente] (fc) at (12.55,2.45) {fondos de cobertura\\y negociación por\\cuenta propia};
  \draw (nd) -- (a);
  \draw (ii) -- (a);
  \draw (ii) -- (d);
  \draw (em) -- (d);
  \draw (mi) -- (c);
  \draw (pa) -- (mi);
  \draw[dashed, thick] (fc) -- node[above, black!65] {corretaje} node[below, black!65] {principal} (c);
\end{tikzpicture}
