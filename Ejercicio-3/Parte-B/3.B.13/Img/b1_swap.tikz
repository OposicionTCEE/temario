% Figura (B1, «FX swap»): un banco de la zona del euro, E, consigue N dólares durante un plazo con un FX swap con el
% intermediario D. (a) Hoy, E entrega SN euros y recibe N dólares al contado. (b) En T, devuelve los N dólares y recupera
% FN euros al tipo pactado. Es un préstamo de dólares con garantía en euros, cuyo interés está en la diferencia entre F y S.
% Generar con: bash Code/generar_figura.sh b1_swap
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]},
    agente/.style={draw, rounded corners=2pt, minimum width=1.5cm, minimum height=0.9cm, fill=black!5}]
  % ---------------- (a) hoy ----------------
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (2.6,1.25) {(a) Hoy};
    \node[agente] (e1) at (0,0) {$E$};
    \node[agente] (d1) at (5.2,0) {$D$};
    \draw[->, thick] ([yshift=0.18cm]e1.east) -- node[above] {$SN$ euros} ([yshift=0.18cm]d1.west);
    \draw[<-, thick] ([yshift=-0.18cm]e1.east) -- node[below] {$N$ dólares} ([yshift=-0.18cm]d1.west);
  \end{scope}
  % ---------------- (b) en T ----------------
  \begin{scope}[xshift=7.8cm]
    \node[font=\footnotesize\bfseries\boldmath] at (2.6,1.25) {(b) En $T$};
    \node[agente] (e2) at (0,0) {$E$};
    \node[agente] (d2) at (5.2,0) {$D$};
    \draw[->, thick] ([yshift=0.18cm]e2.east) -- node[above] {$N$ dólares} ([yshift=0.18cm]d2.west);
    \draw[<-, thick] ([yshift=-0.18cm]e2.east) -- node[below] {$FN$ euros} ([yshift=-0.18cm]d2.west);
  \end{scope}
\end{tikzpicture}
