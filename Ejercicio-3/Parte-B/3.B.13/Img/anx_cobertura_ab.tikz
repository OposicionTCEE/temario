% Figura (Anexo I, «Instrumentos de cobertura»): resultado en euros según el tipo de contado al vencimiento, S_T.
% (a) B pagará N dólares: sin cubrir paga S_T N; a plazo, F N; con una call a K = F, como máximo K N más la prima.
% (b) A cobrará N dólares: sin cubrir cobra S_T N; a plazo, F N; con una put a K = F, como mínimo K N menos la prima.
% Valores ilustrativos: N = 1, F = K = 1, prima 0,12.
% Generar con: bash Code/generar_figura.sh anx_cobertura_ab
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=3.2cm, y=1.55cm]
  % ---------------- (a) B ----------------
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (1.05,2.35) {(a) $B$ pagará $N$ dólares: coste en euros};
    \draw[->] (0,0) -- (2.15,0) node[right] {$S_T$};
    \draw[->] (0,0) -- (0,2.2);
    \draw (1,0.04) -- (1,-0.04) node[below] {$F=K$};
    \draw[thick, black!45, dashed] (0,0) -- (2,2) node[right, black] {sin cubrir};
    \draw[thick] (0,1) -- (2,1) node[right] {a plazo};
    \draw[very thick] (0,0.12) -- (1,1.12) -- (2,1.12) node[above right] {con opción};
  \end{scope}
  % ---------------- (b) A ----------------
  \begin{scope}[xshift=8.4cm]
    \node[font=\footnotesize\bfseries] at (1.05,2.35) {(b) $A$ cobrará $N$ dólares: ingreso en euros};
    \draw[->] (0,0) -- (2.15,0) node[right] {$S_T$};
    \draw[->] (0,0) -- (0,2.2);
    \draw (1,0.04) -- (1,-0.04) node[below] {$F=K$};
    \draw[thick, black!45, dashed] (0,0) -- (2,2) node[right, black] {sin cubrir};
    \draw[thick] (0,1) -- (2,1) node[right] {a plazo};
    \draw[very thick] (0,0.88) -- (1,0.88) -- (2,1.88) node[below right] {con opción};
  \end{scope}
\end{tikzpicture}
