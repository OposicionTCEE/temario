% Figura (B1, «Precio»): cómo fabrica el intermediario D los N dólares que vende a plazo a B sin que nadie se los venda a él.
% Hoy pide prestados euros al tipo r_f, los cambia por dólares al contado, al tipo S, y deposita esos dólares al tipo r_f*;
% en T, el depósito vale N dólares, que entrega a B a cambio de FN euros, con los que devuelve el préstamo en euros con sus
% intereses. Si el contrato no deja ganancia sin riesgo, FN iguala lo que cuesta devolver el préstamo: la paridad cubierta.
% Generar con: bash Code/generar_figura.sh b1_replica
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]},
    paso/.style={draw, rounded corners=2pt, minimum width=3.4cm, minimum height=0.95cm, align=center, fill=black!5}]
  \node[font=\footnotesize\bfseries, anchor=east] at (-0.2,1.6) {hoy};
  \node[font=\footnotesize\bfseries\boldmath, anchor=east] at (-0.2,-0.4) {en $T$};
  \node[paso] (p) at (1.9,1.6) {pide prestados euros\\al tipo $r_f$};
  \node[paso] (c) at (6.6,1.6) {los cambia por dólares\\al contado, al tipo $S$};
  \node[paso] (d) at (11.3,1.6) {deposita los dólares\\al tipo $r_f^*$};
  \node[paso] (e) at (11.3,-0.4) {entrega a $B$ los\\$N$ dólares del depósito};
  \node[paso] (f) at (6.6,-0.4) {cobra de $B$\\$FN$ euros};
  \node[paso] (g) at (1.9,-0.4) {devuelve el préstamo\\con sus intereses};
  \draw[->, thick] (p) -- (c);
  \draw[->, thick] (c) -- (d);
  \draw[->, thick] (d) -- (e);
  \draw[->, thick] (e) -- (f);
  \draw[->, thick] (f) -- (g);
\end{tikzpicture}
