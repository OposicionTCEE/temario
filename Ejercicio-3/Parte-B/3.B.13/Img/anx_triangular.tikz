% Figura (Anexo I, «Triangular»): ciclo de arbitraje cuando el precio comprador directo del euro en yenes, b^d,
% supera el precio al que pueden comprarse euros con yenes a través del dólar: se venden euros por yenes al precio
% directo, se compran dólares con los yenes y euros con los dólares, y se termina con más euros de los iniciales.
% Generar con: bash Code/generar_figura.sh anx_triangular
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=5pt]},
    mon/.style={draw, circle, minimum size=1.05cm, fill=black!6}]
  \node[mon] (U) at (3.2,2.6) {USD};
  \node[mon] (E) at (0,0) {EUR};
  \node[mon] (J) at (6.4,0) {JPY};
  \draw[->, thick] (E) -- node[below] {$\times\,b^{d}_{\mathrm{EUR/JPY}}$} (J);
  \draw[->, thick] (J) -- node[above right] {$\div\,a_{\mathrm{USD/JPY}}$} (U);
  \draw[->, thick] (U) -- node[above left] {$\div\,a_{\mathrm{EUR/USD}}$} (E);
  \node[align=center, black!70] at (3.2,0.95) {$b^{d}_{\mathrm{EUR/JPY}}>a_{\mathrm{EUR/USD}}\,a_{\mathrm{USD/JPY}}$};
\end{tikzpicture}
