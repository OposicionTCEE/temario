% Figura (B2, «Especulación»): lo que gana un carry trade según el tipo de contado de la fecha futura, S_T, con el formato
% de la especulación del B1. Endeudarse en la moneda de tipo bajo e invertir en la de tipo alto (el dólar, en el ejemplo)
% equivale a comprar esta a plazo a F, por debajo del contado de hoy, S: gana S_T - F por dólar. Si el cambio no se mueve
% (S_T = S) gana S - F, el diferencial de intereses; solo pierde si el dólar cae por debajo de F, que es lo que, en
% promedio, predice la paridad no cubierta. Lo habitual es quedar cerca de S (zona sombreada); el derrumbe, raro, deja el
% contado muy por debajo de F y una pérdida grande.
% Generar con: bash Code/generar_figura.sh b2_carry
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  % zona habitual
  \fill[black!8] (3.9,-2.3) rectangle (5.0,2.75);
  \node[black!65, align=center, above] at (4.45,2.75) {lo habitual};
  % ejes
  \draw[->] (0,0) -- (7.2,0) node[below left] {$S_T$};
  \draw[->] (0,-2.4) -- (0,3.2) node[left] {ganancia};
  % resultado
  \draw[very thick] (0.3,-1.89) -- (6.6,2.52);
  % F y S
  \draw[densely dotted] (3.0,0) -- (3.0,-0.35) node[below] {$F$};
  \draw[densely dotted] (4.4,0) -- (4.4,-0.35) node[below] {$S$};
  \draw[densely dotted] (4.4,0) -- (4.4,0.98);
  \draw[decorate, decoration={brace, amplitude=3pt}] (4.55,0.98) -- (4.55,0.0);
  \node[anchor=west, align=left] at (5.15,0.45) {$S-F$:\\el diferencial};
  % derrumbe
  \fill (0.9,-1.47) circle (1.6pt);
  \node[anchor=west, align=left] at (1.05,-1.75) {derrumbe: raro,\\pero con una pérdida grande};
\end{tikzpicture}
