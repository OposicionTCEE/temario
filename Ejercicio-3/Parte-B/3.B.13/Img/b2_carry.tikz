% Figura (B2, «Especulación»): forma de la distribución de la rentabilidad de un carry trade, z, que se endeuda en la moneda
% de tipo bajo e invierte en la de tipo alto. Lo más frecuente es ganar algo cercano al diferencial de intereses, r_alto -
% r_bajo, porque el tipo de cambio apenas se mueve; con poca probabilidad, la moneda de tipo alto se deprecia de golpe y la
% pérdida es grande: la distribución tiene una cola larga a la izquierda. Figura ilustrativa, sin datos.
% Generar con: bash Code/generar_figura.sh b2_carry
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  \draw[->] (-0.2,0) -- (9.4,0) node[right] {$z$};
  \draw[->] (6.0,0) -- (6.0,3.6);
  \node[below left] at (6.0,0) {$0$};
  \draw[very thick, smooth, domain=0:9, samples=150] plot (\x, {3.0*exp(-((\x-6.9)^2)/0.35) + 0.16*exp(-((\x-3.4)^2)/4.0)});
  \draw[densely dotted] (6.9,0) -- (6.9,3.0);
  \node[below right] at (6.75,0) {$r_{\mathrm{alto}}-r_{\mathrm{bajo}}$};
  \node[above] at (2.6,0.3) {derrumbe};
\end{tikzpicture}
