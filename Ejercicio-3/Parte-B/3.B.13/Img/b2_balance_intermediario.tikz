% Figura (B2, «Balance»): las tres formas en que el intermediario D pone su balance. Los dólares que compra a A quedan en su
% activo hasta que los vende (inventario: arriesga su precio). Los que presta a E con un swap y la garantía que da por el
% fondo ante otros intermediarios (corretaje principal) quedan fuera del balance, pero lo obligan igual. El capital de D
% respalda las tres, también las que no aparecen en el balance.
% Generar con: bash Code/generar_figura.sh b2_balance_intermediario
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, yscale=0.8]
  \node at (1.9,3.45) {Balance de $D$};
  % activo
  \draw (0,0) rectangle (1.8,2.0); \node[align=center] at (0.9,1.0) {otros\\activos};
  \draw[fill=black!15] (0,2.0) rectangle (1.8,3.0); \node[align=center] at (0.9,2.5) {dólares\\comprados a $A$};
  % pasivo
  \draw[fill=black!15] (2.0,0) rectangle (3.8,0.5); \node at (2.9,0.25) {capital};
  \draw (2.0,0.5) rectangle (3.8,3.0); \node[align=center] at (2.9,1.75) {otros\\pasivos};
  \node[below] at (0.9,0) {activo}; \node[below] at (2.9,0) {pasivo};
  % fuera del balance
  \draw[dashed] (4.4,1.3) rectangle (10.3,3.0);
  \node[align=left, anchor=west] at (4.55,2.15) {fuera del balance:\\los dólares prestados a $E$ con un swap\\y la garantía por el fondo ante otros intermediarios};
  % lo que respalda el capital
  \draw[<-, thick] (3.85,0.25) -- (4.4,0.25);
  \node[anchor=west, align=left] at (4.45,0.25) {respalda lo que está dentro\\y lo que está fuera del balance};
\end{tikzpicture}
