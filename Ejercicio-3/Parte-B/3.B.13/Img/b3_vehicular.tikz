% Figura (cuerpo, bloque 3, «Moneda vehicular»): la horquilla de un mercado de divisas baja con su volumen. El mercado
% directo entre dos monedas poco negociadas, M2 y M3, tiene poco volumen y una horquilla alta, h23; los mercados de cada una
% con la moneda vehicular, M1, tienen mucho volumen y horquillas bajas, h12 y h13. Cambiar a través de M1 cuesta h12 + h13,
% menos que el cambio directo: la moneda vehicular abarata el cambio porque concentra el volumen.
% Generar con: bash Code/generar_figura.sh b3_vehicular
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  % ---------------- horquilla frente a volumen ----------------
  \draw[->] (0,0) -- (7.2,0) node[below left] {volumen del mercado};
  \draw[->] (0,0) -- (0,4.4) node[left] {$h$};
  \draw[very thick, domain=0.55:6.8, samples=80] plot (\x, {0.35 + 2.0/\x});
  % mercado directo M2/M3
  \fill (0.8,2.85) circle (2pt);
  \draw[densely dotted] (0,2.85) node[left] {$h_{23}$} -- (0.8,2.85);
  \node[right] at (0.85,2.95) {$M_2/M_3$};
  % mercados con la moneda vehicular
  \fill (4.6,0.785) circle (2pt);
  \node[above right] at (4.6,0.8) {$M_1/M_3$};
  \fill (5.9,0.689) circle (2pt);
  \node[above right] at (5.9,0.7) {$M_1/M_2$};
  \draw[densely dotted] (0,0.785) -- (4.6,0.785);
  \draw[densely dotted] (0,0.689) -- (5.9,0.689);
  \node[left] at (0,0.93) {$h_{13}$};
  \node[left] at (0,0.55) {$h_{12}$};
  % ---------------- comparación de costes ----------------
  \begin{scope}[xshift=9.0cm]
    \draw (0,0) -- (3.4,0);
    \fill[black!60] (0.4,0) rectangle (1.2,2.85);
    \node[below, align=center] at (0.8,0) {directo\\$h_{23}$};
    \fill[black!25] (2.2,0) rectangle (3.0,0.785);
    \fill[black!45] (2.2,0.785) rectangle (3.0,1.474);
    \node[below, align=center] at (2.6,0) {por $M_1$\\$h_{12}+h_{13}$};
  \end{scope}
\end{tikzpicture}
