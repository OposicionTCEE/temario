% Figura (Anexo II, «GLOSTEN y MILGROM»): el valor de la divisa es alto (V_H) o bajo (V_L) con probabilidad 1/2;
% una fracción μ de los clientes lo conoce y compra si es alto y vende si es bajo; el resto compra o vende con
% probabilidad 1/2. El intermediario, que solo ve si le compran o le venden, fija a = E[V | compra] y b = E[V | venta].
% Generar con: bash Code/generar_figura.sh anx_glosten
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]},
    level distance=2.6cm, sibling distance=1.5cm, grow=right,
    n/.style={draw, rounded corners=2pt, fill=black!6, minimum width=1.3cm, minimum height=0.6cm}]
  \node[n] (R) at (0,0) {Valor};
  \node[n] (H) at (2.8,1.9) {$V_H$};
  \node[n] (L) at (2.8,-1.9) {$V_L$};
  \draw[->] (R) -- node[above left] {$\tfrac12$} (H);
  \draw[->] (R) -- node[below left] {$\tfrac12$} (L);
  \node[n] (HI) at (6.0,2.7) {informado};
  \node[n] (HN) at (6.0,1.1) {no informado};
  \node[n] (LI) at (6.0,-1.1) {informado};
  \node[n] (LN) at (6.0,-2.7) {no informado};
  \draw[->] (H) -- node[above] {$\mu$} (HI);
  \draw[->] (H) -- node[below] {$1-\mu$} (HN);
  \draw[->] (L) -- node[above] {$\mu$} (LI);
  \draw[->] (L) -- node[below] {$1-\mu$} (LN);
  \node[n] (C1) at (9.3,2.7) {compra};
  \node[n] (C2) at (9.3,1.5) {compra};
  \node[n] (V2) at (9.3,0.7) {vende};
  \node[n] (V3) at (9.3,-1.1) {vende};
  \node[n] (C4) at (9.3,-2.3) {compra};
  \node[n] (V4) at (9.3,-3.1) {vende};
  \draw[->] (HI) -- node[above] {$1$} (C1);
  \draw[->] (HN) -- node[above] {$\tfrac12$} (C2);
  \draw[->] (HN) -- node[below] {$\tfrac12$} (V2);
  \draw[->] (LI) -- node[above] {$1$} (V3);
  \draw[->] (LN) -- node[above] {$\tfrac12$} (C4);
  \draw[->] (LN) -- node[below] {$\tfrac12$} (V4);
\end{tikzpicture}
