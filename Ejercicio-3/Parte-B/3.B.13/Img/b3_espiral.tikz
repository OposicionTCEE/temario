% Figura (cuerpo, bloque 3, «Escasez de dólares»): la espiral de una escasez de dólares. Los intermediarios reducen su
% balance, el dólar sintético se encarece y la base se amplía, los bancos e inversores no consiguen renovar sus swaps,
% venden activos en dólares o pagan más por ellos, y la liquidez del mercado cae, lo que lleva a los intermediarios a
% reducir aún más su balance. Las líneas swap de la Reserva Federal cortan la espiral, porque ponen un techo al coste de
% los dólares sintéticos.
% Generar con: bash Code/generar_figura.sh b3_espiral
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]},
    paso/.style={draw, rounded corners=2pt, minimum width=3.6cm, minimum height=0.95cm, align=center, fill=black!5}]
  \node[paso] (a) at (0,2.6) {los intermediarios\\reducen su balance};
  \node[paso] (b) at (6.6,2.6) {el dólar sintético se encarece:\\se amplía la base};
  \node[paso] (c) at (6.6,0) {no se renuevan\\los swaps};
  \node[paso] (d) at (0,0) {ventas de activos\\en dólares};
  \draw[->, thick] (a) -- (b);
  \draw[->, thick] (b) -- (c);
  \draw[->, thick] (c) -- (d);
  \draw[->, thick] (d) -- node[left, align=right] {cae la\\liquidez} (a);
  \node[paso, fill=black!20] (f) at (12.2,2.6) {líneas swap de la\\Reserva Federal};
  \draw[->, very thick] (f) -- node[above] {techo} (b);
\end{tikzpicture}
