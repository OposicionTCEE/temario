% Figura (B1, «Precio», segunda consecuencia): dos formas de tener euros en T sin riesgo. Dejarlos en un depósito en
% euros rinde r_f tau. Cambiarlos por dólares, depositarlos y vender ya a plazo los dólares rinde r_f^* tau en intereses,
% más que en euros si el dólar paga más, pero al volver a euros se pierde el descuento a plazo, (S - F)/S. Como los dos
% caminos no tienen riesgo, deben rendir lo mismo: el descuento devuelve exactamente lo que el dólar rinde de más.
% Generar con: bash Code/generar_figura.sh b1_descuento
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  \draw (0,0) -- (8.2,0);
  % depósito en euros
  \fill[black!35] (0.4,0) rectangle (1.6,1.6);
  \node[above] at (1.0,1.6) {$r_f\,\tau$};
  \node[below, align=center] at (1.0,0) {depósito\\en euros};
  % dólares cubiertos a plazo
  \fill[black!35] (3.6,0) rectangle (5.4,1.6);
  \fill[black!10] (3.6,1.6) rectangle (5.4,2.8);
  \draw[dashed] (3.6,1.6) rectangle (5.4,2.8);
  \node[above] at (4.5,2.8) {$r_f^*\,\tau$};
  \node[align=center, font=\scriptsize] at (4.5,2.2) {lo que el dólar\\rinde de más};
  \draw[->, very thick] (5.7,2.8) -- (5.7,1.6);
  \node[right, align=left] at (5.8,2.2) {se devuelve en el\\descuento a plazo,\\$(S-F)/S$};
  \node[below, align=center] at (4.5,0) {depósito en dólares\\vendidos a plazo};
  \draw[densely dotted] (1.6,1.6) -- (3.6,1.6);
  \node[below, align=center] at (2.6,1.6) {mismo\\resultado};
\end{tikzpicture}
