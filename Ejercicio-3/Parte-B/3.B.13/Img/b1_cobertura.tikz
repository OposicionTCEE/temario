% Figura (B1, «Variantes»): lo que A cobra en euros por sus N dólares, en función del contado en T, S_T, sin cubrirse (N S_T),
% con un contrato a plazo al tipo F (NF, sea cual sea S_T) y con una opción de venta de dólares al precio de ejercicio K,
% por la que paga una prima p por dólar: cobra N(K - p) si el dólar cae por debajo de K y N(S_T - p) si sube.
% Generar con: bash Code/generar_figura.sh b1_cobertura
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, yscale=0.75]
  \draw[->] (0,0) -- (7.4,0) node[right] {$S_T$};
  \draw[->] (0,0) -- (0,5.0) node[left] {euros};
  % sin cubrir
  \draw[thick, black!45] (0,0) -- (6.4,4.48) node[right, black!60] {sin cubrir: $NS_T$};
  % a plazo
  \draw[very thick, dashed] (0,2.45) node[left] {$NF$} -- (6.4,2.45) node[right] {a plazo};
  % opción de venta
  \draw[very thick] (0,1.75) node[left] {$N(K-p)$} -- (3.0,1.75) -- (6.4,4.13) node[right] {con opción de venta};
  \draw[densely dotted] (3.0,0) node[below] {$K$} -- (3.0,1.75);
\end{tikzpicture}
