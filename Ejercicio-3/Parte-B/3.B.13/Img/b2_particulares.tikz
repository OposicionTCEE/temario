% Figura (B2, «Particulares»): resultado de un particular que compra dólares, en proporción a lo que ha depositado, según
% cuánto varíe el dólar. Sin apalancamiento, la recta es poco empinada y, si el dólar no se mueve, solo pierde la horquilla.
% Con apalancamiento, todo se multiplica por igual: la pendiente, la horquilla que paga sobre el importe total y, por eso,
% la pérdida si el dólar no se mueve; un movimiento pequeño en contra le hace perder todo lo depositado, y el
% intermediario cierra la posición (tramo horizontal). Ilustrativa, sin cifras.
% Generar con: bash Code/generar_figura.sh b2_particulares
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, yscale=0.85]
  % ejes
  \draw[->] (-3.2,0) -- (3.4,0) node[right, align=left] {variación\\del dólar};
  \draw[->] (0,-2.6) -- (0,3.0) node[above] {resultado sobre lo depositado};
  % todo lo depositado
  \draw[dashed, black!50] (-3.2,-2.1) -- (3.2,-2.1);
  \node[black!65, anchor=north west] at (-3.2,-2.15) {pierde todo lo depositado};
  % sin apalancamiento
  \draw[very thick, black!45] (-3.0,-1.295) -- (3.0,0.805) node[right, black!60] {sin apalancamiento};
  % con apalancamiento
  \draw[very thick] (-3.0,-2.1) -- (-1.3,-2.1) -- (2.7,2.1) node[right] {con apalancamiento};
  % si el dólar no se mueve
  \fill[black!45] (0,-0.245) circle (1.5pt);
  \fill (0,-0.735) circle (1.5pt);
  \node[anchor=west, align=left] (n1) at (1.2,-0.62) {si el dólar no se mueve,\\pierde la horquilla};
  \node[anchor=west, align=left] (n2) at (1.2,-1.5) {y, con apalancamiento,\\la horquilla multiplicada};
  \draw[->, black!55] (n1.west) -- (0.09,-0.27);
  \draw[->, black!55] (n2.west) -- (0.09,-0.77);
\end{tikzpicture}
