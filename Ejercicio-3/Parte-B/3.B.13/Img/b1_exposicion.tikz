% Figura (B1, «Contado»): lo que A cobrará y lo que B pagará en euros en T si esperan a cambiar sus N dólares al contado de
% ese día, S_T. A cobra N S_T euros y B paga N S_T euros: las dos líneas son simétricas. Si el contado termina por encima del
% de hoy, S_0, gana A y pierde B, y al revés si termina por debajo: sus exposiciones son opuestas.
% Generar con: bash Code/generar_figura.sh b1_exposicion
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  \draw[->] (0,0) -- (6.6,0) node[right] {$S_T$};
  \draw[->] (0,-2.9) -- (0,2.9) node[left] {euros};
  \draw[very thick] (0,0) -- (5.8,2.55) node[right] {$A$: cobra $NS_T$};
  \draw[very thick, dashed] (0,0) -- (5.8,-2.55) node[right] {$B$: paga $NS_T$};
  \draw[densely dotted] (3.2,-1.41) -- (3.2,1.41);
  \draw[densely dotted] (0,1.41) node[left] {$NS_0$} -- (3.2,1.41);
  \draw[densely dotted] (0,-1.41) node[left] {$-NS_0$} -- (3.2,-1.41);
  \node[below right] at (3.2,0) {$S_0$};
\end{tikzpicture}
