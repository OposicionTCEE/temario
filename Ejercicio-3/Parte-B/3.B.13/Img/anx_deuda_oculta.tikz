% Figura (Anexo I, «Deuda oculta»): un banco de la zona del euro, E, con activos en dólares por valor de N.
% (a) Si se financia pidiendo prestados N dólares, la deuda está en su balance.
% (b) Si se financia con depósitos en euros (SN) y un FX swap, en el balance solo aparecen los depósitos en euros;
%     la obligación de entregar N dólares en T queda fuera del balance, junto con el derecho a recibir FN euros.
% Generar con: bash Code/generar_figura.sh anx_deuda_oculta
\begin{tikzpicture}[font=\footnotesize]
  % ---------------- (a) ----------------
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (3.0,2.25) {(a) Deuda en dólares};
    \node at (1.5,1.65) {Activo};
    \node at (4.5,1.65) {Pasivo};
    \draw[thick] (0,1.4) -- (6.0,1.4);
    \draw[thick] (3.0,1.4) -- (3.0,-0.2);
    \node at (1.5,0.75) {Activos en dólares: $N$};
    \node at (4.5,0.75) {Deuda en dólares: $N$};
  \end{scope}
  % ---------------- (b) ----------------
  \begin{scope}[xshift=8.0cm]
    \node[font=\footnotesize\bfseries] at (3.0,2.25) {(b) Depósitos en euros y \textit{FX swap}};
    \node at (1.5,1.65) {Activo};
    \node at (4.5,1.65) {Pasivo};
    \draw[thick] (0,1.4) -- (6.0,1.4);
    \draw[thick] (3.0,1.4) -- (3.0,-0.2);
    \node at (1.5,0.75) {Activos en dólares: $N$};
    \node at (4.5,0.75) {Depósitos en euros: $SN$};
    \draw[black!45, dashed, rounded corners=3pt] (0,-0.55) rectangle (6.0,-1.75);
    \node[black!65, anchor=north west] at (0.1,-0.6) {Fuera de balance};
    \node at (1.5,-1.3) {Cobro en $T$: $FN$ euros};
    \node at (4.5,-1.3) {Pago en $T$: $N$ dólares};
  \end{scope}
\end{tikzpicture}
