% Figura (Anexo II, «Insesgadez»): variación del tipo de cambio frente al margen a plazo, ilustrativa. Si el tipo a
% plazo fuera la previsión insesgada del contado, los puntos se ordenarían sobre la diagonal (pendiente 1); los datos
% dan una pendiente negativa: la moneda que cotiza con descuento tiende a apreciarse.
% Generar con: bash Code/generar_figura.sh anx_fama_regresion
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  \draw[->] (-3.2,0) -- (3.5,0) node[right] {$f_t-s_t$};
  \draw[->] (0,-2.8) -- (0,3.0) node[above] {$\Delta s_{t+1}$};
  \draw[dashed, black!50] (-2.6,-2.6) -- (2.6,2.6) node[above right, black] {$\beta=1$};
  \draw[thick] (-2.8,1.6) -- (2.8,-1.6) node[below right] {$\hat{\beta}<0$};
  \foreach \p in {(-2.5,1.9),(-2.2,0.8),(-1.9,1.6),(-1.6,0.4),(-1.3,1.3),(-1.0,0.2),(-0.8,1.0),(-0.5,-0.2),(-0.3,0.6),(0.0,-0.4),(0.2,0.5),
                  (0.5,-0.9),(0.7,0.1),(1.0,-1.1),(1.2,-0.1),(1.5,-1.4),(1.8,-0.5),(2.0,-1.8),(2.3,-0.9),(2.6,-1.7),(-1.7,2.0),(1.4,0.3),(-0.6,-0.7),(0.9,-1.9)} {
    \fill[black!65] \p circle (1.5pt);
  }
\end{tikzpicture}
