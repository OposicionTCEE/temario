% Figura (Anexo I, «Cotización de las opciones»): volatilidad implícita según el precio de ejercicio expresado en deltas.
% Se cotizan la volatilidad en el dinero (ATM), la reversal de riesgo (RR = vol 25 call - vol 25 put) y la mariposa
% (BF = media de las dos alas de 25 delta - ATM). Sonrisa ilustrativa con las puts más caras que las calls (RR < 0).
% Generar con: bash Code/generar_figura.sh anx_sonrisa_delta
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  % ejes
  \draw[->] (0,0) -- (10.6,0) node[right] {precio de ejercicio, en deltas};
  \draw[->] (0,0) -- (0,4.4) node[above] {$\sigma$ implícita};
  \foreach \x/\t in {1/{$10\Delta$ \textit{put}}, 3/{$25\Delta$ \textit{put}}, 5/{ATM}, 7/{$25\Delta$ \textit{call}}, 9/{$10\Delta$ \textit{call}}} {
    \draw (\x,0) -- (\x,-0.1);
    \node[below, align=center] at (\x,-0.12) {\t};
  }
  % sonrisa
  \draw[thick] plot[smooth] coordinates {(1,3.9) (3,2.85) (5,2.1) (7,2.35) (9,2.95)};
  \foreach \x/\y in {1/3.9, 3/2.85, 5/2.1, 7/2.35, 9/2.95} { \fill (\x,\y) circle (1.6pt); }
  % ATM
  \draw[dashed, black!45] (0,2.1) -- (10.2,2.1);
  \node[left] at (0,2.1) {$\sigma_{ATM}$};
  % RR: diferencia entre 25 call y 25 put
  \draw[black!60] (3,2.85) -- (7.9,2.85);
  \draw[<->, black!70] (7.75,2.85) -- (7.75,2.35);
  \draw[black!60] (7,2.35) -- (7.9,2.35);
  \node[right] at (7.85,2.6) {$RR_{25}$};
  % BF: media de las alas menos ATM
  \draw[black!60, dotted, thick] (3,2.6) -- (7,2.6);
  \draw[<->, black!70] (5,2.6) -- (5,2.1);
  \node[left] at (5,2.35) {$BF_{25}$};
\end{tikzpicture}
