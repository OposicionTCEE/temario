% Figura (Anexo I, «Precio comprador y vendedor»): anatomía de una cotización del par EUR/USD.
% El euro es la divisa base y el dólar la cotizada; el intermediario compra euros a 1,0850 dólares (precio comprador,
% bid) y los vende a 1,0852 (precio vendedor, ask); la horquilla es de 2 pips. «1,08» es la figura grande, que los
% operadores sobrentienden, y los dos últimos dígitos son los pips que se cotizan.
% Generar con: bash Code/generar_figura.sh anx_cotizacion
\begin{tikzpicture}[font=\footnotesize]
  % ---------------- par ----------------
  \node[font=\Large] (base) at (0,0) {EUR};
  \node[font=\Large] at (0.78,0) {/};
  \node[font=\Large] (quote) at (1.56,0) {USD};
  \draw[decorate, decoration={brace, mirror, amplitude=4pt}] (-0.48,-0.38) -- (0.48,-0.38)
    node[midway, below=6pt, align=center] {divisa\\base};
  \draw[decorate, decoration={brace, mirror, amplitude=4pt}] (1.08,-0.38) -- (2.04,-0.38)
    node[midway, below=6pt, align=center] {divisa\\cotizada};
  % ---------------- precios ----------------
  \node[draw, rounded corners=2pt, minimum width=3.0cm, minimum height=1.15cm, fill=black!5] (B) at (5.3,0)
    {\normalsize$1{,}08$\,\Large\textbf{$50$}};
  \node[draw, rounded corners=2pt, minimum width=3.0cm, minimum height=1.15cm, fill=black!5] (A) at (9.0,0)
    {\normalsize$1{,}08$\,\Large\textbf{$52$}};
  \node[above=2pt of B, align=center] {Comprador (\textit{bid}): $b$};
  \node[above=2pt of A, align=center] {Vendedor (\textit{ask}): $a$};
  % figura grande y pips
  \draw[black!55] (4.58,-0.62) -- (4.58,-0.78) -- (5.02,-0.78) -- (5.02,-0.62);
  \node[black!65, anchor=north east] at (5.02,-0.82) {figura grande};
  \draw[black!55] (5.18,-0.62) -- (5.18,-0.78) -- (5.88,-0.78) -- (5.88,-0.62);
  \node[black!65, anchor=north west] at (5.18,-0.82) {pips};
  % horquilla
  \draw[decorate, decoration={brace, mirror, amplitude=5pt}] (5.3,-1.5) -- (9.0,-1.5)
    node[midway, below=7pt] {horquilla: $a-b=0{,}0002$ dólares por euro (2 pips)};
\end{tikzpicture}
