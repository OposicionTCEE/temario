% Figura (Anexo I, «Puntos a plazo»): tipo a plazo F(T) = S (1 + r_f T)/(1 + r_f^* T) en función del plazo, con S
% en euros por dólar. (a) Si el tipo del dólar es mayor que el del euro, F queda por debajo de S y baja con el plazo;
% (b) si es menor, F queda por encima y sube. Valores ilustrativos: S = 1; tipos del 2 % y del 6 %.
% Generar con: bash Code/generar_figura.sh anx_puntos
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=5.2cm, y=3.6cm]
  % ---------------- (a) ----------------
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (0.55,1.18) {(a) $r_f^*>r_f$};
    \draw[->] (0,0.80) -- (1.12,0.80) node[right] {$T$};
    \draw[->] (0,0.80) -- (0,1.10) node[above] {$F$};
    \draw[dashed, black!45] (0,1.0) -- (1.05,1.0);
    \node[left] at (0,1.0) {$S$};
    \draw[thick, domain=0:1, samples=40] plot (\x, {(1+0.02*\x)/(1+0.06*\x)});
    \node[right] at (1.0,{(1+0.02)/(1+0.06)}) {$F(T)$};
    \draw[black!55] (1.0,0.80) -- (1.0,0.775) node[below] {$1$ año};
  \end{scope}
  % ---------------- (b) ----------------
  \begin{scope}[xshift=7.4cm]
    \node[font=\footnotesize\bfseries] at (0.55,1.18) {(b) $r_f^*<r_f$};
    \draw[->] (0,0.80) -- (1.12,0.80) node[right] {$T$};
    \draw[->] (0,0.80) -- (0,1.10) node[above] {$F$};
    \draw[dashed, black!45] (0,1.0) -- (1.05,1.0);
    \node[left] at (0,1.0) {$S$};
    \draw[thick, domain=0:1, samples=40] plot (\x, {(1+0.06*\x)/(1+0.02*\x)});
    \node[right] at (1.0,{(1+0.06)/(1+0.02)}) {$F(T)$};
    \draw[black!55] (1.0,0.80) -- (1.0,0.775) node[below] {$1$ año};
  \end{scope}
\end{tikzpicture}
