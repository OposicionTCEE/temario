% Figura (B2, «Inventario»): los precios del intermediario sin inventario y con un inventario de dólares. (a) Sin inventario,
% q = 0, cotiza b y a alrededor del valor esperado, m. (b) Con un inventario de dólares, q > 0, baja los dos precios, para
% que le compren más y le vendan menos, hasta deshacerse de él.
% Generar con: bash Code/generar_figura.sh b2_inventario
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  % ---------------- (a) sin inventario ----------------
  \begin{scope}
    \node[font=\footnotesize\bfseries\boldmath] at (1.6,4.1) {(a) Sin inventario, $q=0$};
    \draw[->] (0,0) -- (0,3.7) node[left] {precio};
    \draw[thick, dashed] (0,1.85) -- (3.2,1.85) node[right] {$m$};
    \draw[very thick] (0.4,2.65) -- (2.6,2.65) node[right] {$a$};
    \draw[very thick] (0.4,1.05) -- (2.6,1.05) node[right] {$b$};
  \end{scope}
  % ---------------- (b) con inventario ----------------
  \begin{scope}[xshift=6.2cm]
    \node[font=\footnotesize\bfseries\boldmath] at (1.6,4.1) {(b) Con dólares en inventario, $q>0$};
    \draw[->] (0,0) -- (0,3.7) node[left] {precio};
    \draw[thick, dashed] (0,1.85) -- (3.2,1.85) node[right] {$m$};
    \draw[black!35, thick] (0.4,2.65) -- (2.6,2.65);
    \draw[black!35, thick] (0.4,1.05) -- (2.6,1.05);
    \draw[very thick] (0.4,2.0) -- (2.6,2.0) node[right] {$a$};
    \draw[very thick] (0.4,0.4) -- (2.6,0.4) node[right] {$b$};
    \draw[->, thick] (1.5,2.6) -- (1.5,2.08);
    \draw[->, thick] (1.5,1.0) -- (1.5,0.48);
  \end{scope}
\end{tikzpicture}
