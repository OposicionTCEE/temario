% Figura (Anexo III, «Riesgos»): liquidación de pago contra pago en CLS. Cada banco paga a CLS la moneda que vende y CLS
% liquida las dos patas a la vez en sus cuentas, de modo que si uno de los dos no paga no se liquida ninguna de ellas.
% Fuente: GALATI (2002).
% Generar con: bash Code/generar_figura.sh anx_pvp
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]},
    caja/.style={draw, rounded corners=2pt, minimum width=2.6cm, minimum height=0.95cm, align=center, fill=black!5}]
  \node[caja] (b1) at (0,0) {Banco 1\\vende euros};
  \node[caja, fill=black!20, minimum width=3.6cm, minimum height=1.35cm] (c) at (6.2,0) {CLS\\las dos patas a la vez\\o ninguna};
  \node[caja] (b2) at (12.4,0) {Banco 2\\vende dólares};
  \draw[->, thick] ([yshift=0.22cm]b1.east) -- node[above] {euros} ([yshift=0.22cm]c.west);
  \draw[<-, thick] ([yshift=-0.22cm]b1.east) -- node[below] {dólares} ([yshift=-0.22cm]c.west);
  \draw[->, thick] ([yshift=0.22cm]b2.west) -- node[above] {dólares} ([yshift=0.22cm]c.east);
  \draw[<-, thick] ([yshift=-0.22cm]b2.west) -- node[below] {euros} ([yshift=-0.22cm]c.east);
\end{tikzpicture}
