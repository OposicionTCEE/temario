% Figura (B2, «Inventario», internalización): cómo llegan a B los N dólares que vende A. Con la patata caliente, el
% intermediario de A los pasa a otro intermediario, y este a otro, hasta que llegan al de B. Con la internalización, A y B
% son clientes del mismo intermediario, D, que casa la venta de uno con la compra del otro sin ninguna operación en el
% nivel entre intermediarios.
% Generar con: bash Code/generar_figura.sh b2_internalizacion
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]},
    nodo/.style={draw, circle, minimum size=0.8cm, fill=white, inner sep=0pt},
    cliente/.style={draw, rounded corners=2pt, minimum width=1.0cm, minimum height=0.7cm, fill=black!5}]
  % ---------------- patata caliente ----------------
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (3.6,3.75) {Patata caliente};
    \fill[black!8, rounded corners=10pt] (1.0,1.35) rectangle (6.2,3.25);
    \node[black!65, anchor=north] at (3.6,3.2) {nivel entre intermediarios};
    \node[nodo] (d1) at (1.8,2.05) {$D_1$};
    \node[nodo] (d2) at (3.6,2.05) {$D_2$};
    \node[nodo] (d3) at (5.4,2.05) {$D_3$};
    \draw[->, thick] (d1) -- (d2);
    \draw[->, thick] (d2) -- (d3);
    \node[cliente] (a) at (0.5,0.2) {$A$};
    \node[cliente] (b) at (6.7,0.2) {$B$};
    \draw[->, thick] (a) -- node[left] {$N$} (d1);
    \draw[->, thick] (d3) -- node[right] {$N$} (b);
    \node[black!65] at (3.6,0.2) {nivel de clientes};
  \end{scope}
  % ---------------- internalización ----------------
  \begin{scope}[xshift=8.4cm]
    \node[font=\footnotesize\bfseries] at (3.6,3.75) {Internalización};
    \fill[black!8, rounded corners=10pt] (1.0,1.35) rectangle (6.2,3.25);
    \node[black!65, anchor=north] at (3.6,3.2) {nivel entre intermediarios};
    \node[black!65] at (3.6,2.05) {ninguna operación};
    \node[cliente] (a) at (0.5,0.2) {$A$};
    \node[cliente] (b) at (6.7,0.2) {$B$};
    \node[nodo] (d) at (3.6,0.2) {$D$};
    \draw[->, thick] (a) -- node[above] {$N$} (d);
    \draw[->, thick] (d) -- node[above] {$N$} (b);
    \node[black!65, align=center, below] at (3.6,-0.25) {casa la venta de $A$\\con la compra de $B$};
  \end{scope}
\end{tikzpicture}
