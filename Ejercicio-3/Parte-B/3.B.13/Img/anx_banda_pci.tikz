% Figura (Anexo I, «Cubierto de intereses»): margen a plazo anualizado frente a la diferencia de tipos de interés
% (euro menos dólar). La paridad cubierta es la diagonal; los costes de transacción abren alrededor una banda sin
% arbitraje. Por encima, el tipo a plazo es demasiado alto; por debajo, demasiado bajo. Los puntos son ilustrativos.
% Generar con: bash Code/generar_figura.sh anx_banda_pci
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, scale=1.0]
  \draw[->] (-3.2,0) -- (3.4,0) node[right] {$r_f-r_f^*$};
  \draw[->] (0,-2.9) -- (0,3.1) node[above] {$\dfrac{F-S}{S\,\tau}$};
  \fill[black!8] (-2.9,-2.9+0.55) -- (2.9,2.9+0.55) -- (2.9,2.9-0.55) -- (-2.9,-2.9-0.55) -- cycle;
  \draw[thick] (-2.9,-2.9) -- (2.9,2.9) node[right] {paridad cubierta};
  \draw[black!45] (-2.9,-2.35) -- (2.9,3.45);
  \draw[black!45] (-2.9,-3.45) -- (2.9,2.35);
  \node[black!65, anchor=west] at (-3.1,2.2) {$F$ demasiado alto};
  \node[black!65, anchor=east] at (3.3,-2.0) {$F$ demasiado bajo};
  \foreach \p in {(-2.1,-1.9), (-1.6,-1.8), (-1.2,-1.0), (-0.7,-0.5), (-0.3,-0.45), (0.2,0.35), (0.6,0.4), (1.0,1.25), (1.4,1.2), (1.9,2.1), (2.3,2.15), (-0.9,-1.25), (0.9,0.6)} {
    \fill[black!70] \p circle (1.4pt);
  }
  \fill[black!70] (-1.3,0.2) circle (1.4pt);
  \fill[black!70] (1.6,0.3) circle (1.4pt);
\end{tikzpicture}
