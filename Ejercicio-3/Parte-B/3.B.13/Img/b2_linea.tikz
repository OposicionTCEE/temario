% Figura (B2, «Bancos centrales»): cómo llegan a E los dólares de la Reserva Federal cuando el mercado no se los presta. En
% una crisis, el intermediario D deja de renovarle el FX swap; la Reserva Federal presta N dólares al BCE a cambio de euros,
% con una línea swap, y el BCE se los presta a E contra garantías.
% Generar con: bash Code/generar_figura.sh b2_linea
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]},
    caja/.style={draw, rounded corners=2pt, minimum width=2.6cm, minimum height=0.85cm, align=center, fill=black!5}]
  \node[caja] (f) at (0,0) {Reserva Federal};
  \node[caja] (e) at (5.6,0) {BCE};
  \node[caja] (b) at (11.2,0) {$E$};
  \node[caja] (d) at (11.2,2.0) {$D$};
  \draw[->, thick] ([yshift=0.18cm]f.east) -- node[above] {$N$ dólares} ([yshift=0.18cm]e.west);
  \draw[<-, thick] ([yshift=-0.18cm]f.east) -- node[below] {euros} ([yshift=-0.18cm]e.west);
  \draw[->, thick] ([yshift=0.18cm]e.east) -- node[above] {$N$ dólares} ([yshift=0.18cm]b.west);
  \draw[<-, thick] ([yshift=-0.18cm]e.east) -- node[below] {garantías} ([yshift=-0.18cm]b.west);
  \draw[->, dashed, thick] (d) -- node[right=6pt] {sin \textit{FX swap}} (b);
  \draw[thick] ($(d)!0.5!(b)+(-0.18,-0.18)$) -- ++(0.36,0.36);
  \draw[thick] ($(d)!0.5!(b)+(-0.18,0.18)$) -- ++(0.36,-0.36);
\end{tikzpicture}
