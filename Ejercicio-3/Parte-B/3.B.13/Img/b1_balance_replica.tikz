% Figura (B1, «Precio», tercera consecuencia): el balance de D antes y después de fabricar el contrato a plazo. La réplica
% añade un depósito en dólares al activo y un préstamo en euros al pasivo, del mismo importe: el balance crece por los dos
% lados y el capital no cambia, de modo que pesa menos sobre un balance mayor. Ampliar el balance exige capital, que es
% caro: por eso arbitrar tiene un coste.
% Generar con: bash Code/generar_figura.sh b1_balance_replica
\begin{tikzpicture}[font=\footnotesize]
  % ---------------- antes ----------------
  \node at (1.7,3.45) {Antes};
  \draw (0,0) rectangle (1.6,2.0); \node[align=center] at (0.8,1.0) {otros\\activos};
  \draw (1.8,0) rectangle (3.4,0.45); \node at (2.6,0.225) {capital};
  \draw (1.8,0.45) rectangle (3.4,2.0); \node[align=center] at (2.6,1.225) {otros\\pasivos};
  \node[below] at (0.8,0) {activo}; \node[below] at (2.6,0) {pasivo};
  % ---------------- después ----------------
  \begin{scope}[xshift=4.9cm]
    \node at (1.7,3.45) {Después de fabricar el contrato};
    \draw (0,0) rectangle (1.6,2.0); \node[align=center] at (0.8,1.0) {otros\\activos};
    \draw[fill=black!15] (0,2.0) rectangle (1.6,3.0); \node[align=center] at (0.8,2.5) {depósito\\en dólares};
    \draw (1.8,0) rectangle (3.4,0.45); \node at (2.6,0.225) {capital};
    \draw (1.8,0.45) rectangle (3.4,2.0); \node[align=center] at (2.6,1.225) {otros\\pasivos};
    \draw[fill=black!15] (1.8,2.0) rectangle (3.4,3.0); \node[align=center] at (2.6,2.5) {préstamo\\en euros};
    \node[below] at (0.8,0) {activo}; \node[below] at (2.6,0) {pasivo};
  \end{scope}
\end{tikzpicture}
