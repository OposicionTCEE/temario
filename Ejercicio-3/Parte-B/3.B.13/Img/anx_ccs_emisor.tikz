% Figura (Anexo I, «Swap de divisas»): una empresa E emite un bono en dólares (nominal N, cupón c^*) y lo convierte
% en una deuda en euros con un swap de divisas con D al tipo S_0: entrega a D los dólares de la emisión y recibe
% S_0 N euros; D le paga los cupones en dólares y E le paga cupones en euros (c S_0 N); al vencimiento D le entrega
% los N dólares que E devuelve a los inversores y E le paga S_0 N euros. El resultado neto es una deuda en euros.
% Generar con: bash Code/generar_figura.sh anx_ccs_emisor
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]},
    ag/.style={draw, rounded corners=2pt, minimum width=2.4cm, minimum height=0.7cm, align=center, fill=black!6}]
  \foreach \y/\t in {0/{Emisión ($0$)}, -1.55/{Cada cupón}, -3.1/{Vencimiento ($T$)}} {
    \node[anchor=east, font=\footnotesize\bfseries] at (-0.2,\y) {\t};
    \node[ag] (I\y) at (1.3,\y) {Inversores};
    \node[ag] (E\y) at (6.5,\y) {Empresa $E$};
    \node[ag] (D\y) at (11.7,\y) {Intermediario $D$};
  }
  % emisión
  \draw[->, thick] ([yshift=0.12cm]I0.east) -- node[above] {$N$\,\$} ([yshift=0.12cm]E0.west);
  \draw[->, thick] ([yshift=0.12cm]E0.east) -- node[above] {$N$\,\$} ([yshift=0.12cm]D0.west);
  \draw[->, thick] ([yshift=-0.12cm]D0.west) -- node[below] {$S_0N$\,€} ([yshift=-0.12cm]E0.east);
  % cupones
  \draw[->, thick] ([yshift=0.12cm]E-1.55.west) -- node[above] {$c^*N$\,\$} ([yshift=0.12cm]I-1.55.east);
  \draw[->, thick] ([yshift=0.12cm]D-1.55.west) -- node[above] {$c^*N$\,\$} ([yshift=0.12cm]E-1.55.east);
  \draw[->, thick] ([yshift=-0.12cm]E-1.55.east) -- node[below] {$cS_0N$\,€} ([yshift=-0.12cm]D-1.55.west);
  % vencimiento
  \draw[->, thick] ([yshift=0.12cm]E-3.1.west) -- node[above] {$N$\,\$} ([yshift=0.12cm]I-3.1.east);
  \draw[->, thick] ([yshift=0.12cm]D-3.1.west) -- node[above] {$N$\,\$} ([yshift=0.12cm]E-3.1.east);
  \draw[->, thick] ([yshift=-0.12cm]E-3.1.east) -- node[below] {$S_0N$\,€} ([yshift=-0.12cm]D-3.1.west);
\end{tikzpicture}
