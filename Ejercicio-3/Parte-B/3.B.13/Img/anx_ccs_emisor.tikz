% Figura (Anexo I, «Swap de divisas»): una empresa E emite un bono en dólares (nominal N, cupón c^*) y lo convierte
% en una deuda en euros con un swap de divisas con D al tipo S_0: entrega a D los dólares de la emisión y recibe
% S_0 N euros; D le paga los cupones en dólares y E le paga cupones en euros (c S_0 N); al vencimiento D le entrega
% los N dólares que E devuelve a los inversores y E le paga S_0 N euros. El resultado neto es una deuda en euros.
% Generar con: bash Code/generar_figura.sh anx_ccs_emisor
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]},
    ag/.style={draw, rounded corners=2pt, minimum width=2.4cm, minimum height=0.7cm, align=center, fill=black!6}]
  \foreach \y/\n/\t in {0/a/{Emisión ($0$)}, -1.6/b/{Cada cupón}, -3.2/c/{Vencimiento ($T$)}} {
    \node[anchor=east, font=\footnotesize\bfseries] at (-0.1,\y) {\t};
    \node[ag] (I\n) at (1.3,\y) {Inversores};
    \node[ag] (E\n) at (6.6,\y) {Empresa $E$};
    \node[ag] (D\n) at (11.9,\y) {Intermediario $D$};
  }
  % emisión
  \draw[->, thick] ([yshift=0.12cm]Ia.east) -- node[above] {$N$\,\$} ([yshift=0.12cm]Ea.west);
  \draw[->, thick] ([yshift=0.12cm]Ea.east) -- node[above] {$N$\,\$} ([yshift=0.12cm]Da.west);
  \draw[->, thick] ([yshift=-0.12cm]Da.west) -- node[below] {$S_0N$\,€} ([yshift=-0.12cm]Ea.east);
  % cupones
  \draw[->, thick] ([yshift=0.12cm]Eb.west) -- node[above] {$c^*N$\,\$} ([yshift=0.12cm]Ib.east);
  \draw[->, thick] ([yshift=0.12cm]Db.west) -- node[above] {$c^*N$\,\$} ([yshift=0.12cm]Eb.east);
  \draw[->, thick] ([yshift=-0.12cm]Eb.east) -- node[below] {$c\,S_0N$\,€} ([yshift=-0.12cm]Db.west);
  % vencimiento
  \draw[->, thick] ([yshift=0.12cm]Ec.west) -- node[above] {$N$\,\$} ([yshift=0.12cm]Ic.east);
  \draw[->, thick] ([yshift=0.12cm]Dc.west) -- node[above] {$N$\,\$} ([yshift=0.12cm]Ec.east);
  \draw[->, thick] ([yshift=-0.12cm]Ec.east) -- node[below] {$S_0N$\,€} ([yshift=-0.12cm]Dc.west);
\end{tikzpicture}
