% Figura (Anexo I, «Contratos sin entrega»): la moneda local no puede negociarse libremente fuera del país; el mercado
% exterior la cubre con NDF que se liquidan en dólares por diferencias frente al fixing publicado en el interior.
% Los controles de capital separan los dos mercados y el único vínculo es el fixing.
% Generar con: bash Code/generar_figura.sh anx_ndf
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]},
    item/.style={draw, rounded corners=2pt, minimum width=4.6cm, minimum height=0.75cm, align=center, fill=white}]
  % interior
  \draw[black!35, rounded corners=4pt, fill=black!3] (0,-1.9) rectangle (5.6,1.7);
  \node[font=\footnotesize\bfseries] at (2.8,1.35) {Mercado interior};
  \node[item] (I1) at (2.8,0.6) {Contado y plazo con entrega};
  \node[item] (I2) at (2.8,-0.35) {Tipos de interés internos};
  \node[item, fill=black!8] (FIX) at (2.8,-1.3) {Tipo de referencia: $S^{L}_T$};
  % exterior
  \draw[black!35, rounded corners=4pt, fill=black!3] (8.4,-1.9) rectangle (14.6,1.7);
  \node[font=\footnotesize\bfseries] at (11.5,1.35) {Mercado exterior};
  \node[item, minimum width=5.4cm] (E1) at (11.5,0.6) {NDF: compra de $N$\,\$ al tipo $F^{L}$};
  \node[item, minimum width=5.4cm] (E2) at (11.5,-0.35) {Tipo de interés implícito en $F^{L}$};
  \node[item, minimum width=5.4cm, fill=black!8] (E3) at (11.5,-1.3) {Pago en dólares: $N\,(S^{L}_T-F^{L})/S^{L}_T$};
  % barrera
  \draw[line width=1.4pt, black!60, dash pattern=on 5pt off 3pt] (7.0,-2.05) -- (7.0,1.85);
  \node[black!65, align=center, fill=white] at (7.0,0.6) {controles\\de capital};
  % vínculo
  \draw[->, thick] (FIX.east) -- (E3.west);
\end{tikzpicture}
