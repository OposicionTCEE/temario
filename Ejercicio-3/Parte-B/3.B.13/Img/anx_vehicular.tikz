% Figura (Anexo III, «Concentración»): mercados bilaterales necesarios para cambiar entre sí cinco monedas, M1 a M5.
% (a) Sin moneda vehicular, cada par tiene su propio mercado: n(n - 1)/2 = 10 mercados. (b) Con una moneda vehicular, M1,
% todas se negocian solo contra ella y cualquier otro cambio se hace en dos operaciones a través de ella: n - 1 = 4
% mercados, cada uno con más volumen.
% Generar con: bash Code/generar_figura.sh anx_vehicular
\begin{tikzpicture}[font=\footnotesize,
    m/.style={draw, circle, minimum size=0.82cm, fill=white, inner sep=0pt}]
  % ---------------- (a) Sin moneda vehicular ----------------
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (0,2.15) {(a) Sin moneda vehicular};
    \foreach \i in {1,...,5} { \node[m] (a\i) at ({90+72*(\i-1)}:1.5) {$M_{\i}$}; }
    \foreach \i/\j in {1/2,1/3,1/4,1/5,2/3,2/4,2/5,3/4,3/5,4/5} { \draw (a\i) -- (a\j); }
    \node at (0,-1.95) {$\dfrac{n(n-1)}{2}=10$ mercados};
  \end{scope}
  % ---------------- (b) Con moneda vehicular ----------------
  \begin{scope}[xshift=6.8cm]
    \node[font=\footnotesize\bfseries] at (0,2.15) {(b) Con moneda vehicular, $M_1$};
    \node[m, fill=black!20, very thick] (v) at (0,0) {$M_1$};
    \foreach \i/\ang in {2/45,3/135,4/225,5/315} { \node[m] (b\i) at (\ang:1.5) {$M_{\i}$}; \draw[very thick] (v) -- (b\i); }
    \node at (0,-1.95) {$n-1=4$ mercados};
  \end{scope}
\end{tikzpicture}
