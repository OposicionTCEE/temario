% Figura (Anexo III, «Clientes no financieros y minoristas»): los dos modelos de un intermediario minorista.
% (a) A-book: el intermediario traslada cada orden del cliente a un proveedor de liquidez y cobra un margen o una comisión.
% (b) B-book: el intermediario es la contraparte del cliente y solo cubre, si quiere, la posición neta de todos sus
%     clientes con un proveedor de liquidez.
% Generar con: bash Code/generar_figura.sh anx_minorista
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]},
    caja/.style={draw, rounded corners=2pt, minimum width=1.8cm, minimum height=0.85cm, align=center, fill=black!5}]
  % ---------------- (a) A-book ----------------
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (2.95,1.25) {(a) \textit{A-book}};
    \node[caja] (c) at (0,0) {Cliente};
    \node[caja] (i) at (2.95,0) {Intermediario\\minorista};
    \node[caja] (p) at (5.9,0) {Proveedor de\\liquidez};
    \draw[->, thick] (c) -- node[above] {orden} (i);
    \draw[->, thick] (i) -- node[above] {orden} (p);
    \node[black!65] at (2.95,-0.85) {margen o comisión};
  \end{scope}
  % ---------------- (b) B-book ----------------
  \begin{scope}[xshift=8.3cm]
    \node[font=\footnotesize\bfseries] at (2.95,1.25) {(b) \textit{B-book}};
    \node[caja] (c) at (0,0) {Cliente};
    \node[caja] (i) at (2.95,0) {Intermediario\\minorista};
    \node[caja] (p) at (5.9,0) {Proveedor de\\liquidez};
    \draw[<->, thick] (c) -- node[above] {orden} (i);
    \draw[->, dashed] (i) -- node[above] {posición} node[below] {neta} (p);
    \node[black!65] at (2.95,-0.85) {contraparte del cliente};
  \end{scope}
\end{tikzpicture}
