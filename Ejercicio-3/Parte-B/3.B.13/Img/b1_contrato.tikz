% Figura (B1, «Contrato»): el contrato a plazo sobre la exposición de A y de B (la misma imagen que b1_exposicion). Sin
% cubrirse, A cobra N S_T y B paga N S_T; con el contrato, A cobra NF y B paga NF, sea cual sea S_T: las líneas inclinadas
% se vuelven planas. Si el dólar termina por encima de F, A deja de ganar N(S_T - F) y B se ahorra lo mismo: lo que gana
% una lo pierde la otra, pero las dos eliminan la incertidumbre.
% Generar con: bash Code/generar_figura.sh b1_contrato
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  \draw[->] (0,0) -- (6.6,0) node[right] {$S_T$};
  \draw[->] (0,-2.9) -- (0,2.9) node[left] {euros};
  % sin cubrir
  \draw[thick, black!45] (0,0) -- (5.8,2.55) node[right, black!60] {$A$ sin cubrir: cobra $NS_T$};
  \draw[thick, dashed, black!45] (0,0) -- (5.8,-2.55) node[right, black!60] {$B$ sin cubrir: paga $NS_T$};
  % a plazo
  \draw[very thick] (0,1.32) node[left] {$NF$} -- (5.8,1.32) node[right] {$A$ a plazo: cobra $NF$};
  \draw[very thick, dashed] (0,-1.32) node[left] {$-NF$} -- (5.8,-1.32) node[right] {$B$ a plazo: paga $NF$};
  \draw[densely dotted] (3.0,-1.32) -- (3.0,1.32);
  \node[below right] at (3.0,0) {$F$};
  % lo que una deja de ganar y la otra se ahorra
  \draw[<->] (4.6,1.32) -- (4.6,2.02);
  \draw[<->] (4.6,-1.32) -- (4.6,-2.02);
  \node[right] at (4.6,1.67) {$N(S_T-F)$};
  \node[right] at (4.6,-1.67) {$N(S_T-F)$};
\end{tikzpicture}
