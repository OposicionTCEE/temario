% Figura (B1, «Cobertura, especulación y arbitraje»): los tres motivos financieros, por lo que gana cada uno según el
% contado de la fecha futura, S_T. Cobertura: a la exposición (cobra más si el dólar sube) se suma un contrato opuesto, y
% el resultado deja de depender de S_T. Especulación: una posición sin pago detrás, que gana si S_T termina por encima del
% precio pactado y pierde si termina por debajo. Arbitraje: gana lo mismo sea cual sea S_T, sin riesgo y sin capital.
% Generar con: bash Code/generar_figura.sh b1_motivos
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  % ---------------- cobertura ----------------
  \node at (2.0,2.95) {Cobertura};
  \draw[->] (0,0) -- (4.2,0) node[below left] {$S_T$};
  \draw[->] (0,-1.7) -- (0,2.6) node[left] {euros};
  \draw[thick, black!45] (0,0) -- (3.8,2.4);
  \node[below right, black!60] at (3.0,1.9) {exposición};
  \draw[thick, dashed] (0,1.39) -- (3.8,-1.01) node[below left] {contrato opuesto};
  \draw[very thick] (0,1.39) -- (3.8,1.39);
  \node[above] at (1.0,1.39) {cubierta};
  % ---------------- especulación ----------------
  \begin{scope}[xshift=5.3cm]
    \node at (2.0,2.95) {Especulación};
    \draw[->] (0,0) -- (4.2,0) node[below left] {$S_T$};
    \draw[->] (0,-1.7) -- (0,2.6) node[left] {euros};
    \draw[very thick] (0,-1.39) -- (3.8,1.01);
    \draw[densely dotted] (2.2,0) -- (2.2,-0.25);
    \node[below right] at (2.2,0) {precio pactado};
    \node[above left] at (3.8,1.01) {gana};
    \node[above left] at (1.1,-0.7) {pierde};
  \end{scope}
  % ---------------- arbitraje ----------------
  \begin{scope}[xshift=10.6cm]
    \node at (2.0,2.95) {Arbitraje};
    \draw[->] (0,0) -- (4.2,0) node[below left] {$S_T$};
    \draw[->] (0,-1.7) -- (0,2.6) node[left] {euros};
    \draw[very thick] (0,0.8) -- (3.8,0.8);
    \node[above, align=center] at (1.9,0.8) {la misma ganancia,\\sin riesgo ni capital};
  \end{scope}
\end{tikzpicture}
