% Figura (Anexo I, «Tipos cruzados»): el tipo EUR/JPY se obtiene de las cotizaciones de cada moneda frente al dólar.
% (a) Para vender euros a cambio de yenes se venden euros por dólares al precio comprador de EUR/USD y dólares por
%     yenes al precio comprador de USD/JPY: el precio comprador del cruzado es el producto de los dos.
% (b) Para comprar euros con yenes se recorre el camino inverso a los dos precios vendedores.
% Generar con: bash Code/generar_figura.sh anx_cruzado
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]},
    mon/.style={draw, circle, minimum size=1.0cm, fill=black!6}]
  % ---------------- (a) vender euros por yenes ----------------
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (2.9,3.05) {(a) Vender euros a cambio de yenes};
    \node[mon] (U) at (2.9,2.0) {USD};
    \node[mon] (E) at (0.5,0) {EUR};
    \node[mon] (J) at (5.3,0) {JPY};
    \draw[->, thick] (E) -- node[above left] {$\times\,b_{\mathrm{EUR/USD}}$} (U);
    \draw[->, thick] (U) -- node[above right] {$\times\,b_{\mathrm{USD/JPY}}$} (J);
    \draw[->, thick, dashed, black!60] (E) -- node[below] {$b_{\mathrm{EUR/JPY}}=b_{\mathrm{EUR/USD}}\,b_{\mathrm{USD/JPY}}$} (J);
  \end{scope}
  % ---------------- (b) comprar euros con yenes ----------------
  \begin{scope}[xshift=8.6cm]
    \node[font=\footnotesize\bfseries] at (2.9,3.05) {(b) Comprar euros con yenes};
    \node[mon] (U) at (2.9,2.0) {USD};
    \node[mon] (E) at (0.5,0) {EUR};
    \node[mon] (J) at (5.3,0) {JPY};
    \draw[->, thick] (J) -- node[above right] {$\div\,a_{\mathrm{USD/JPY}}$} (U);
    \draw[->, thick] (U) -- node[above left] {$\div\,a_{\mathrm{EUR/USD}}$} (E);
    \draw[->, thick, dashed, black!60] (J) -- node[below] {$a_{\mathrm{EUR/JPY}}=a_{\mathrm{EUR/USD}}\,a_{\mathrm{USD/JPY}}$} (E);
  \end{scope}
\end{tikzpicture}
