% Figura (B2, «Estructura»): cómo se encuentran A, que vende N dólares, y B, que los compra, sin conocerse. Cada uno negocia
% con su intermediario, D1 y D2, que son quienes negocian entre sí, en el nivel superior del mercado.
% Generar con: bash Code/generar_figura.sh b2_encuentro
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]},
    nodo/.style={draw, circle, minimum size=0.9cm, fill=white, inner sep=0pt},
    cliente/.style={draw, rounded corners=2pt, minimum width=1.5cm, minimum height=0.8cm, fill=black!5}]
  % ---------------- nivel entre intermediarios ----------------
  \fill[black!8, rounded corners=12pt] (2.2,1.35) rectangle (9.8,3.25);
  \node[black!65, anchor=north] at (6.0,3.2) {nivel entre intermediarios};
  \node[nodo] (d1) at (3.6,2.05) {$D_1$};
  \node[nodo] (d2) at (8.4,2.05) {$D_2$};
  \draw[->, thick] (d1) -- node[above] {$N$ dólares} (d2);
  % ---------------- nivel de clientes ----------------
  \node[black!65, anchor=west] at (-0.2,-0.95) {nivel de clientes};
  \node[cliente] (a) at (0.6,0.2) {$A$};
  \node[cliente] (b) at (11.4,0.2) {$B$};
  \draw[->, thick] (a) -- node[above left] {$N$ dólares} (d1);
  \draw[->, thick] (d2) -- node[above right] {$N$ dólares} (b);
\end{tikzpicture}
