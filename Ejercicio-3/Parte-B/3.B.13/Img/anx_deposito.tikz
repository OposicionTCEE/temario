% Figura (Anexo I, «Depósitos y sistemas de pago»): B compra N dólares a D al tipo S (euros por dólar).
% Lo que ocurre son dos transferencias independientes, cada una dentro del sistema de pagos de su moneda:
% SN euros pasan de B a D en el sistema del euro (T2) y N dólares pasan de D al corresponsal del banco de B
% en el sistema del dólar (Fedwire, CHIPS). Ningún depósito sale de su sistema: cambia su titular.
% Generar con: bash Code/generar_figura.sh anx_deposito
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]},
    caja/.style={draw, rounded corners=2pt, minimum width=2.7cm, minimum height=0.95cm, align=center, fill=white}]
  % ---------------- acuerdo ----------------
  \node[draw, rounded corners=2pt, fill=black!8, minimum height=0.8cm, align=center] (AC) at (7.6,2.75)
    {Acuerdo: $B$ compra $N$\,\$ a $D$ al tipo $S$};
  % ---------------- sistema del euro ----------------
  \draw[black!35, rounded corners=4pt, fill=black!3] (0,-0.75) rectangle (7.0,1.55);
  \node[font=\footnotesize\bfseries] at (3.5,1.2) {Sistema de pagos del euro (T2)};
  \node[caja] (BB) at (1.55,0.2) {Banco de $B$};
  \node[caja] (DE) at (5.45,0.2) {$D$};
  \draw[->, thick] (BB) -- node[above] {$SN$\,€} (DE);
  % ---------------- sistema del dólar ----------------
  \draw[black!35, rounded corners=4pt, fill=black!3] (8.2,-0.75) rectangle (15.2,1.55);
  \node[font=\footnotesize\bfseries] at (11.7,1.2) {Sistema de pagos del dólar (Fedwire, CHIPS)};
  \node[caja] (DD) at (9.75,0.2) {$D$};
  \node[caja] (CB) at (13.65,0.2) {Corresponsal\\del banco de $B$};
  \draw[->, thick] (DD) -- node[above] {$N$\,\$} (CB);
  % ---------------- del acuerdo a cada pata ----------------
  \draw[->, dashed, black!55] (AC.south) ++(-1.2,0) -- (3.5,1.55);
  \draw[->, dashed, black!55] (AC.south) ++(1.2,0) -- (11.7,1.55);
  \node[black!65, anchor=north] at (3.5,-0.8) {pata en euros};
  \node[black!65, anchor=north] at (11.7,-0.8) {pata en dólares};
\end{tikzpicture}
