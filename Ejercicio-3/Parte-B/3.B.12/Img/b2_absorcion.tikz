% Cuerpo, bloque 2 — Absorcion sobre la base del multiplicador (plano renta-saldo), con S-I = Y-A.
% Desde E0 (paro y deficit), la depreciacion desplaza (X-M)0 -> (X-M)1: con recursos ociosos la
% economia avanza por (S-I)0 de E0 a E1 (pleno empleo Yf). Cerrar el deficit solo con la desviacion
% exigiria llegar a E', mas alla de Yf (inflacion). Con pleno empleo hace falta reducir la absorcion,
% (S-I)0 -> (S-I)1, de E1 a E2. Reducir sin desviar, con (X-M)0, lleva de E0 a E3 (menos renta).
% Rectas: (S-I)1: y = 0,6(x-6,6) ; (S-I)0: y = 0,6(x-6,6) - 0,8 ; (X-M)1: y = -0,5(x-6,6) ;
% (X-M)0: y = 0,74 - 0,5x. Puntos: E0 (5;-1,76), E1 (6,6;-0,8), E2 (6,6;0), E' (7,327;-0,364),
% E3 (4,273;-1,396).
\begin{tikzpicture}[>={Stealth[length=2.2mm]}, every node/.style={font=\footnotesize}]
  % ejes
  \draw[->] (0,-3.6) -- (0,2.8) node[left=2pt]{saldo};
  \draw[->] (0,0) -- (9.8,0) node[below=2pt, pos=0.95]{renta $Y$};
  \node[left] at (0,0) {$0$};
  % pleno empleo
  \draw[dashed, gray] (6.6,-3.4) -- (6.6,2.5);
  \node[below, gray] at (6.6,-3.4) {$Y_f$};
  % rectas
  \draw[thick] (3.0,-2.96) -- (9.0,0.64) node[right=1pt]{$(S-I)_0$};
  \draw[thick, dashed] (1.9,-2.82) -- (8.8,1.32) node[right=1pt]{$(S-I)_1$};
  \draw[thick] (0.8,0.34) -- (7.8,-3.16) node[right=1pt]{$(X-M)_0$};
  \draw[thick, dashed] (1.4,2.6) -- (8.8,-1.1) node[right=1pt]{$(X-M)_1$};
  % renta inicial
  \draw[dotted] (5.0,-1.76) -- (5.0,0);
  \node[above] at (5.0,0) {$Y_0$};
  % puntos
  \fill (5.0,-1.76) circle (1.6pt);
  \node[below right=1pt and 0pt] at (5.0,-1.76) {$E_0$};
  \fill (6.6,-0.8) circle (1.6pt);
  \node[below right=0pt and 1pt] at (6.6,-0.8) {$E_1$};
  \fill (6.6,0) circle (1.6pt);
  \node[above right=1pt and 1pt] at (6.6,0) {$E_2$};
  \fill (4.273,-1.396) circle (1.6pt);
  \node[above left=1pt and 0pt] at (4.273,-1.396) {$E_3$};
  \draw[fill=white] (7.327,-0.364) circle (1.8pt);
  \node[right=3pt, align=left] at (7.36,-0.5) {$E'$: \scriptsize inflaci\'on};
  % caminos
  \draw[->, very thick, gray] (5.2,-1.64) -- (6.4,-0.92);
  \node[anchor=north west, align=left] at (5.75,-1.42) {\scriptsize desviaci\'on\\[-2pt]\scriptsize con paro};
  \draw[->, very thick, gray] (6.6,-0.62) -- (6.6,-0.16);
  \node[anchor=east, align=right] at (6.5,-0.3) {\scriptsize reducci\'on};
  \draw[->, very thick, gray] (4.86,-1.69) -- (4.43,-1.475);
  \node[anchor=north east, align=right] at (4.6,-1.75) {\scriptsize reducci\'on\\[-2pt]\scriptsize sin desviaci\'on};
\end{tikzpicture}
