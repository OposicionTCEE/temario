% Cuerpo, bloque 3 — Persistencia sobre la base del diagrama de FISHER (con beta(1+r)=1 el pais
% quiere consumir lo mismo en los dos periodos, sobre la diagonal c1=c2). (a) Caida transitoria de
% y1: de Y0 (=C0) a Y1; el consumo se reparte en C1 y aparece un deficit. (b) Caida permanente: de
% Y0 a Y2 (=C2) sobre la diagonal; el saldo no cambia.
\begin{tikzpicture}[>={Stealth[length=2.0mm]}, every node/.style={font=\footnotesize}, x=0.9cm, y=0.9cm]
  % ======================= (a) transitoria =======================
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (2.9,6.15) {(a) Ca\'ida transitoria};
    \draw[->] (0,0) -- (5.9,0) node[below=2pt]{$c_1$};
    \draw[->] (0,0) -- (0,5.8) node[left=2pt]{$c_2$};
    \draw[gray, dotted] (0,0) -- (4.6,4.6);
    \node[anchor=west, gray] at (4.62,4.5) {\scriptsize $c_1=c_2$};
    % rectas presupuestarias
    \draw[thick] (1.7,5.48) -- (5.3,1.52);
    \draw[thick, dashed] (0.9,5.04) -- (4.6,0.97);
    % indiferencia
    \draw[gray] plot[smooth] coordinates {(2.55,4.958) (3.0,4.147) (3.5,3.5) (4.2,2.864) (5.2,2.264)};
    \draw[gray] plot[smooth] coordinates {(1.95,4.395) (2.4,3.498) (2.871,2.872) (3.5,2.31) (4.4,1.796)};
    % puntos
    \fill (3.5,3.5) circle (1.6pt);
    \node at (3.97,3.48) {$Y_0$};
    \fill (2.3,3.5) circle (1.6pt);
    \node[anchor=east] at (2.2,3.5) {$Y_1$};
    \draw[->, thick] (3.4,3.5) -- (2.42,3.5);
    \fill (2.871,2.871) circle (1.6pt);
    \node at (3.28,2.86) {$C_1$};
    % deficit
    \draw[dotted] (2.3,3.5) -- (2.3,0);
    \draw[dotted] (2.871,2.871) -- (2.871,0);
    \draw[decorate,decoration={brace,mirror,amplitude=3pt}] (2.31,-0.5) -- (2.86,-0.5)
      node[midway, below=4pt]{\scriptsize d\'eficit};
    \node[below] at (2.3,0) {\scriptsize $y_1$};
    \node[below] at (2.871,0) {\scriptsize $c_1$};
  \end{scope}
  % ======================= (b) permanente =======================
  \begin{scope}[xshift=7.6cm]
    \node[font=\footnotesize\bfseries] at (2.9,6.15) {(b) Ca\'ida permanente};
    \draw[->] (0,0) -- (5.9,0) node[below=2pt]{$c_1$};
    \draw[->] (0,0) -- (0,5.8) node[left=2pt]{$c_2$};
    \draw[gray, dotted] (0,0) -- (4.6,4.6);
    \node[anchor=west, gray] at (4.62,4.5) {\scriptsize $c_1=c_2$};
    \draw[thick] (1.7,5.48) -- (5.3,1.52);
    \draw[thick, dashed] (0.7,4.06) -- (4.2,0.21);
    \draw[gray] plot[smooth] coordinates {(2.55,4.958) (3.0,4.147) (3.5,3.5) (4.2,2.864) (5.2,2.264)};
    \draw[gray] plot[smooth] coordinates {(1.55,3.55) (1.9,2.838) (2.3,2.3) (3.0,1.717) (3.9,1.287)};
    \fill (3.5,3.5) circle (1.6pt);
    \node at (3.97,3.48) {$Y_0$};
    \fill (2.3,2.3) circle (1.6pt);
    \node at (2.78,2.3) {$Y_2$};
    \draw[->, thick] (3.42,3.42) -- (2.38,2.38);
    \node[anchor=west, align=left] at (4.3,0.8) {\scriptsize la renta y el consumo\\[-2pt]\scriptsize caen lo mismo: sin d\'eficit};
  \end{scope}
\end{tikzpicture}
