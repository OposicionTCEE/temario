% Anexo III.1 — Diagrama de FISHER con produccion (misma base que a3_fisher): la apertura separa
% produccion (P, donde f'(k2)=r) y consumo (C); en autarquia todo coincidia en A.
\begin{tikzpicture}[>={Stealth[length=2.2mm]}, every node/.style={font=\footnotesize}]
  \draw[->] (0,0) -- (7.2,0) node[below=2pt]{$c_1$};
  \draw[->] (0,0) -- (0,6.4) node[left=2pt]{$c_2$};
  % FPP
  \draw[thick] plot[smooth] coordinates {(6.0,0.4) (5.2,2.0) (4.2,3.4) (3.0,4.6) (1.6,5.5) (0.6,6.0)};
  \node[above right=0pt and -30pt] at (1.6,5.55) {\scriptsize FPP};
  % recta presupuestaria tangente a la FPP en P
  \draw[thick] (2.35,6.175) -- (6.35,0.175);
  \node[right=2pt] at (2.95,5.45) {\scriptsize pendiente $-(1+r)$};
  % curva de indiferencia tangente en C
  \draw[thick] plot[smooth] coordinates {(4.3,3.85) (4.8,2.6) (5.2,1.9) (5.9,1.45) (6.7,1.25)};
  \node[right] at (6.75,1.25) {$U$};
  % autarquia (gris)
  \fill[gray] (4.55,2.9) circle (1.6pt);
  \node[gray, below left=1pt and 0pt] at (4.55,2.9) {$A$ (autarqu\'ia)};
  % produccion y consumo con apertura
  \fill (4.2,3.4) circle (1.7pt);
  \node[above right=5pt and -2pt] at (4.3,3.42) {$P$: $f'(k_2)=r$};
  \fill (5.2,1.9) circle (1.7pt);
  \node[above right=1pt and 2pt] at (5.22,1.92) {$C$};
  % guias
  \draw[dashed] (4.2,3.4) -- (4.2,0) node[below]{$c_1^{P}$};
  \draw[dashed] (5.2,1.9) -- (5.2,0) node[below]{$c_1^{C}$};
  \draw[decorate,decoration={brace,mirror,amplitude=3pt}] (4.22,-0.55) -- (5.18,-0.55)
    node[midway, below=4pt, align=center]{\scriptsize d\'eficit del periodo 1:\\[-2pt]\scriptsize consumo e inversi\'on sobre la producci\'on};
\end{tikzpicture}
