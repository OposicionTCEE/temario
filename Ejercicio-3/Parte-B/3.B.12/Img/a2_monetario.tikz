% Anexo II.1 — Enfoque monetario: el balance del banco central y el ajuste por reservas.
% Una expansion del credito interno crea un exceso de saldos que se gasta fuera; el deficit
% obliga a vender divisas y las reservas caen hasta devolver la oferta de dinero a la demanda.
\begin{tikzpicture}[>={Stealth[length=2.2mm]}, every node/.style={font=\footnotesize}]
  % ---- balance del banco central ----
  \node[font=\footnotesize\bfseries] at (2.3,4.05) {Balance del banco central};
  \draw (0,0.6) rectangle (4.6,3.6);
  \draw (2.3,0.6) -- (2.3,3.6);
  \draw (0,2.1) -- (2.3,2.1);
  \fill[gray!30] (0.02,2.12) rectangle (2.28,3.58);
  \fill[gray!12] (0.02,0.62) rectangle (2.28,2.08);
  \fill[gray!20] (2.32,0.62) rectangle (4.58,3.58);
  \node[align=center] at (1.15,2.85) {reservas\\[-2pt]$R$};
  \node[align=center] at (1.15,1.35) {cr\'edito\\[-2pt]interno $CI$};
  \node[align=center] at (3.45,2.1) {base\\[-2pt]monetaria\\[-2pt]$M^{s}$};
  \node at (1.15,3.78) {\scriptsize activo};
  \node at (3.45,3.78) {\scriptsize pasivo};
  % ---- cadena causal ----
  \draw[rounded corners=2pt] (6.4,2.5) rectangle (9.5,3.7);
  \node[align=center] at (7.95,3.1) {exceso de saldos:\\[-2pt]$M^{s}>M^{d}$};
  \draw[rounded corners=2pt] (10.3,2.5) rectangle (14.1,3.7);
  \node[align=center] at (12.2,3.1) {m\'as gasto: importaciones\\[-2pt]y activos exteriores};
  \draw[rounded corners=2pt] (8.3,0.35) rectangle (12.2,1.55);
  \node[align=center] at (10.25,0.95) {d\'eficit de balanza de pagos:\\[-2pt]se venden divisas};
  % flechas
  \draw[->, thick] (1.15,1.35) -| (5.5,3.1) -- (6.35,3.1);
  \node[above] at (5.0,3.55) {\scriptsize 1 $\uparrow CI$};
  \draw[->, thick] (9.55,3.1) -- node[above]{\scriptsize 2} (10.25,3.1);
  \draw[->, thick] (12.2,2.45) -- node[right=2pt]{\scriptsize 3} (11.3,1.6);
  \draw[->, thick] (8.25,0.95) -| node[below left=2pt and -48pt]{\scriptsize 4 $\downarrow R$: $M^{s}$ vuelve a $M^{d}$} (1.15,0.55);
\end{tikzpicture}
