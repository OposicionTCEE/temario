% Anexo I.5 — Mundell-Fleming con tipo de cambio fijo (movilidad alta, BP mas plana que LM):
% (a) la expansion monetaria se deshace (perdida de reservas); (b) la expansion fiscal se refuerza.
\begin{tikzpicture}[>={Stealth[length=2.2mm]}, every node/.style={font=\footnotesize}]
% ---------- (a) politica monetaria ----------
\begin{scope}
  \node[font=\footnotesize\bfseries] at (3.3,5.75) {(a) Pol\'itica monetaria: ineficaz};
  \draw[->] (0,0) -- (6.9,0) node[below=2pt, pos=0.93]{$Y$};
  \draw[->] (0,0) -- (0,5.4) node[left=2pt]{$i$};
  \draw[thick] (0.8,4.6) -- (5.6,0.9) node[right]{IS};
  \draw[thick] (0.9,0.8) -- (5.4,4.7) node[above]{$LM_0$};
  \draw[thick] (2.1,0.8) -- (6.3,4.44) node[right]{$LM_1$};
  \draw[thick] (0.8,1.70) -- (6.0,4.04) node[right]{BP};
  \fill (3.17,2.77) circle (1.6pt) node[above left=1pt and 0pt]{$E_0$};
  \fill (3.81,2.28) circle (1.6pt) node[below right=1pt and 0pt]{$E_1$};
  \draw[->] (1.78,1.5) -- node[below=1pt]{\scriptsize 1} (2.85,1.5);
  \draw[->] (5.25,3.6) -- node[above=1pt]{\scriptsize 3} (4.2,3.6);
  \node[align=left, anchor=north west] at (0.1,-0.55) {\scriptsize 1 expansi\'on monetaria: $LM_0\to LM_1$\\[-2pt]\scriptsize 2 $E_1$ bajo BP: d\'eficit y venta de divisas\\[-2pt]\scriptsize 3 $M^{s}$ cae y la econom\'ia vuelve a $E_0$};
\end{scope}
% ---------- (b) politica fiscal ----------
\begin{scope}[xshift=8.1cm]
  \node[font=\footnotesize\bfseries] at (3.3,5.75) {(b) Pol\'itica fiscal: reforzada};
  \draw[->] (0,0) -- (6.9,0) node[below=2pt, pos=0.93]{$Y$};
  \draw[->] (0,0) -- (0,5.4) node[left=2pt]{$i$};
  \draw[thick] (0.8,4.6) -- (5.6,0.9) node[right]{$IS_0$};
  \draw[thick] (2.2,4.99) -- (6.6,1.59) node[right]{$IS_1$};
  \draw[thick] (0.9,0.8) -- (5.35,4.66) node[above]{$LM_0$};
  \draw[thick] (1.48,0.8) -- (5.98,4.70) node[right]{$LM_1$};
  \draw[thick] (0.8,1.70) -- (6.0,4.04) node[below right=-1pt]{BP};
  \fill (3.17,2.77) circle (1.6pt) node[below left=1pt and 0pt]{$E_0$};
  \fill (4.07,3.55) circle (1.6pt) node[above left=1pt and 0pt]{$E_1$};
  \fill (4.37,3.31) circle (1.6pt) node[below right=1pt and 0pt]{$E_2$};
  \node[align=left, anchor=north west] at (0.1,-0.55) {\scriptsize 1 expansi\'on fiscal: $IS_0\to IS_1$, con $E_1$ sobre BP\\[-2pt]\scriptsize 2 super\'avit: compra de divisas, $M^{s}$ sube ($LM_0\to LM_1$)\\[-2pt]\scriptsize 3 $E_2$: la expansi\'on monetaria inducida refuerza la fiscal};
\end{scope}
\end{tikzpicture}
