% Cuerpo, bloque 4 — Aritmética (1/2): diagrama de fases de la posición exterior sobre el PIB cuando r>g.
% Sin valoración, Delta pii_t = k pii_{t-1} + b, con k=(r-g)/(1+g)>0: recta creciente de pendiente k
% (triángulo) y ordenada en el origen b. Con b>0 corta el eje en pii-bar<0, que es inestable (flechas
% sobre el eje hacia fuera); con b=0 (discontinua) pasa por el origen y toda posición deudora diverge.
% Valores de dibujo: k=0,4; b=1,2; pii-bar=-3. Sustituye, con b4_dinamica_convergente, a b4_dinamica.
\begin{tikzpicture}[scale=0.8, >={Stealth[length=2.2mm]}, every node/.style={font=\footnotesize}]
  % ejes
  \draw[->] (-5.6,0) -- (2.0,0) node[below=2pt]{$pii_{t-1}$};
  \draw[->] (0,-2.2) -- (0,2.3) node[left=2pt]{$\Delta pii_t$};
  \node[below right=0pt and 0pt] at (0,0) {$0$};
  % rectas
  \draw[thick] (-5.0,-0.8) -- (1.5,1.8) node[right=1pt]{$b>0$};
  \draw[thick, dashed] (-5.0,-2.0) -- (1.5,0.6) node[right=1pt]{$b=0$};
  % ordenada en el origen
  \fill (0,1.2) circle (1.4pt);
  \node[right=1pt] at (0.02,0.9) {$b$};
  % pendiente
  \draw[gray] (-5.0,-0.8) -- (-3.8,-0.8) -- (-3.8,-0.32);
  \node[right=1pt] at (-3.8,-0.62) {$\tfrac{r-g}{1+g}$};
  % posición estable y movimiento
  \draw[->, very thick, gray] (-3.15,0) -- (-4.7,0);
  \draw[->, very thick, gray] (-2.85,0) -- (-1.2,0);
  \fill (-3,0) circle (1.6pt);
  \node[above left=1pt and 0pt] at (-3,0) {$\overline{pii}$};
\end{tikzpicture}
