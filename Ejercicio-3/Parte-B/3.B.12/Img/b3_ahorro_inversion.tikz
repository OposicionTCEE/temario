% Cuerpo, bloque 3 — Ahorro e inversion de una economia pequena y abierta frente al tipo de
% interes mundial r*: en autarquia el equilibrio seria A (tipo rA); al tipo r* el pais ahorra M e
% invierte N0, y la diferencia es el deficit corriente; si mejoran sus oportunidades de inversion
% (I0 -> I1) invierte N1 y el deficit se amplia sin que cambie el ahorro.
% Funciones: x_S(r) = 0,5 + 0,9 r ; x_I0(r) = 6,0 - 0,9 r ; x_I1(r) = 7,0 - 0,9 r.
\begin{tikzpicture}[>={Stealth[length=2.2mm]}, every node/.style={font=\footnotesize}]
  \draw[->] (0,0) -- (8.6,0) node[below=2pt, pos=0.9]{ahorro e inversi\'on};
  \draw[->] (0,0) -- (0,5.4) node[left=2pt]{$r$};
  % curvas
  \draw[thick] (0.77,0.3) -- (4.82,4.8) node[above]{$S$};
  \draw[thick] (5.73,0.3) -- (1.68,4.8) node[above]{$I_0$};
  \draw[thick, dashed] (6.73,0.3) -- (2.68,4.8) node[above]{$I_1$};
  % autarquia
  \fill (3.25,3.056) circle (1.6pt);
  \node[above=2pt] at (3.25,3.056) {$A$};
  \draw[dotted] (0,3.056) node[left]{$r_A$} -- (3.25,3.056);
  % tipo mundial
  \draw[dashed] (0,2.5) node[left]{$r^{*}$} -- (7.6,2.5);
  \draw[line width=3pt, gray!30] (2.75,2.5) -- (4.75,2.5);
  \draw[line width=3pt, gray!65] (2.75,2.5) -- (3.75,2.5);
  \fill (2.75,2.5) circle (1.6pt);
  \node[below left=0pt and 0pt] at (2.75,2.5) {$M$};
  \fill (3.75,2.5) circle (1.6pt);
  \node[below=2pt] at (3.75,2.48) {$N_0$};
  \fill (4.75,2.5) circle (1.6pt);
  \node[below=2pt] at (4.75,2.48) {$N_1$};
  % desplazamiento de la inversion
  \draw[->, thick] (2.5,4.3) -- (3.25,4.3);
  % rotulo
  \node[anchor=west, align=left] at (5.0,3.2) {\scriptsize d\'eficit corriente al tipo $r^{*}$:\\[-2pt]\scriptsize de $M$ a $N_0$, y de $M$ a $N_1$\\[-2pt]\scriptsize si mejora la inversi\'on};
\end{tikzpicture}
