% Anexo IV.2 — El procedimiento de desequilibrios macroeconomicos (PDM) de la UE:
% del cuadro de indicadores al examen a fondo y sus tres desenlaces.
\begin{tikzpicture}[>={Stealth[length=2.2mm]}, every node/.style={font=\footnotesize}]
  % fila superior: deteccion
  \draw[rounded corners=3pt, fill=gray!10] (0,3.1) rectangle (4.5,4.7);
  \node[align=center] at (2.25,3.9) {\textbf{cuadro de indicadores}\\[-2pt]\scriptsize 14 indicadores con umbrales\\[-2pt]\scriptsize (PIIN, CC, TCER, CLU, cr\'edito\ldots)};
  \draw[->, thick] (4.55,3.9) -- (5.45,3.9);
  \draw[rounded corners=3pt, fill=gray!10] (5.5,3.1) rectangle (10.0,4.7);
  \node[align=center] at (7.75,3.9) {\textbf{informe del mecanismo}\\[-2pt]\textbf{de alerta} \scriptsize(Comisi\'on, noviembre)\\[-2pt]\scriptsize selecciona pa\'ises a examinar};
  \draw[->, thick] (10.05,3.9) -- (10.95,3.9);
  \draw[rounded corners=3pt, fill=gray!10] (11.0,3.1) rectangle (14.6,4.7);
  \node[align=center] at (12.8,3.9) {\textbf{examen a fondo}\\[-2pt]\scriptsize de cada pa\'is se\~nalado};
  % desenlaces
  \draw[->, thick] (12.8,3.05) -- (2.25,2.15);
  \draw[->, thick] (12.8,3.05) -- (7.75,2.15);
  \draw[->, thick] (12.8,3.05) -- (12.8,2.15);
  \draw[rounded corners=3pt] (0.3,0.9) rectangle (4.2,2.1);
  \node[align=center] at (2.25,1.5) {\scriptsize sin desequilibrio:\\[-2pt]\scriptsize fin del procedimiento};
  \draw[rounded corners=3pt] (5.8,0.9) rectangle (9.7,2.1);
  \node[align=center] at (7.75,1.5) {\scriptsize desequilibrio:\\[-2pt]\scriptsize vigilancia y recomendaciones\\[-2pt]\scriptsize del Semestre Europeo};
  \draw[rounded corners=3pt] (10.9,0.9) rectangle (14.7,2.1);
  \node[align=center] at (12.8,1.5) {\scriptsize desequilibrio excesivo:\\[-2pt]\scriptsize procedimiento corrector,\\[-2pt]\scriptsize con sanciones posibles};
\end{tikzpicture}
