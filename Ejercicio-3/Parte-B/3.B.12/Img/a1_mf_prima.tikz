% Anexo I.5 — Mundell-Fleming con prima de riesgo (crisis de balanza de pagos tipo 1997):
% (a) defender el tipo fijo exige una contraccion monetaria; (b) dejar flotar deprecia y recupera demanda.
\begin{tikzpicture}[>={Stealth[length=2.2mm]}, every node/.style={font=\footnotesize}]
% ---------- (a) defender el tipo ----------
\begin{scope}
  \node[font=\footnotesize\bfseries] at (3.3,5.75) {(a) Defender el tipo fijo};
  \draw[->] (0,0) -- (6.9,0) node[below=2pt, pos=0.93]{$Y$};
  \draw[->] (0,0) -- (0,5.4) node[left=2pt]{$i$};
  \draw[thick] (0.8,4.6) -- (5.6,0.9) node[right]{IS};
  \draw[thick] (0.9,0.8) -- (5.35,4.66) node[below right=-1pt and -4pt]{$LM_0$};
  \draw[thick] (0.2,1.67) -- (4.2,5.13) node[above]{$LM_1$};
  \draw[gray, thick] (0.8,1.70) -- (6.0,4.04) node[right]{\textcolor{gray}{$BP_0$}};
  \draw[thick] (0.8,2.80) -- (5.9,5.10) node[right]{$BP_1$};
  \fill (3.17,2.77) circle (1.6pt) node[below right=1pt and 0pt]{$E_0$};
  \fill (2.27,3.47) circle (1.6pt) node[below left=1pt and 0pt]{$E_1$};
  \node[align=left, anchor=north west] at (0.1,-0.55) {\scriptsize 1 sube la prima de riesgo $\rho$: $BP_0\to BP_1$\\[-2pt]\scriptsize 2 defensa del tipo: contracci\'on monetaria ($LM_0\to LM_1$)\\[-2pt]\scriptsize 3 $E_1$: recesi\'on con tipos de inter\'es altos};
\end{scope}
% ---------- (b) dejar flotar ----------
\begin{scope}[xshift=8.1cm]
  \node[font=\footnotesize\bfseries] at (3.3,5.75) {(b) Dejar flotar};
  \draw[->] (0,0) -- (6.9,0) node[below=2pt, pos=0.93]{$Y$};
  \draw[->] (0,0) -- (0,5.4) node[left=2pt]{$i$};
  \draw[gray, thick] (0.8,4.6) -- (5.6,0.9) node[right]{\textcolor{gray}{$IS_0$}};
  \draw[thick] (1.9,4.95) -- (6.4,1.47) node[right]{$IS_1$};
  \draw[thick] (0.9,0.8) -- (5.35,4.66) node[above]{$LM_0$};
  \draw[gray, thick] (0.8,2.80) -- (5.5,4.92) node[above right=-1pt and -4pt]{\textcolor{gray}{$BP_1$}};
  \draw[thick] (0.8,2.01) -- (6.0,4.35) node[right]{$BP_2$};
  \fill (2.27,3.47) circle (1.6pt) node[above left=1pt and 0pt]{$E_1$};
  \fill (3.9,3.40) circle (1.6pt) node[below right=1pt and 0pt]{$E_2$};
  \node[align=left, anchor=north west] at (0.1,-0.55) {\scriptsize 4 flotar: la depreciaci\'on desplaza IS a la derecha y BP abajo\\[-2pt]\scriptsize 5 $E_2$: la demanda se recupera con el tipo depreciado\\[-2pt]\scriptsize \phantom{5} (secuencia de la crisis asi\'atica de 1997)};
\end{scope}
\end{tikzpicture}
