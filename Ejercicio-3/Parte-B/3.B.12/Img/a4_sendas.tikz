% Anexo IV.1 — Sendas de la posicion exterior neta segun el signo de r−g y el saldo primario:
% explosiva (r>g sin superavit), estable con esfuerzo permanente (b*), y licuacion con r<g.
\begin{tikzpicture}[>={Stealth[length=2.2mm]}, every node/.style={font=\footnotesize}]
  % ejes: f en vertical (zona negativa = deuda), t en horizontal sobre f=0
  \draw[->] (0,0.4) -- (0,-4.4) node[left=2pt]{$f$ (deuda)};
  \draw[->] (0,0) -- (10.8,0) node[above=2pt, pos=0.96]{$t$};
  \node[above left=1pt and 1pt] at (0,0) {$0$};
  % posicion inicial
  \fill (0,-2.2) circle (1.6pt);
  \node[left=3pt] at (0,-2.2) {$pii_0$};
  % (c) r<g, b=0: la deuda se licua
  \draw[thick] plot[smooth] coordinates {(0,-2.2) (2.5,-1.75) (5.0,-1.4) (7.5,-1.12) (10.0,-0.9)};
  \node[right=2pt, align=left] at (10.0,-0.9) {\scriptsize (c) $r<g$, sin super\'avit:\\[-2pt]\scriptsize el crecimiento lic\'ua la deuda};
  % (b) r>g con b* estabilizador: plana
  \draw[thick, dashed] (0,-2.2) -- (10.0,-2.2);
  \node[right=2pt, align=left] at (10.0,-2.2) {\scriptsize (b) $r>g$ con el super\'avit\\[-2pt]\scriptsize primario $b^{*}$: estable};
  % (a) r>g, b=0: explosiva
  \draw[thick] plot[smooth] coordinates {(0,-2.2) (2.5,-2.62) (5.0,-3.15) (7.5,-3.8) (9.4,-4.35)};
  \node[right=2pt, align=left] at (9.4,-4.35) {\scriptsize (a) $r>g$ sin super\'avit:\\[-2pt]\scriptsize deuda explosiva};
\end{tikzpicture}
