% Anexo II.2 — Equilibrio de cartera (McKINNON-BRANSON): los tres mercados de activos
% en el plano (F, r). Sustituye a la PNG copiada de CECO (EquilibrioCartera_Activos.png).
\begin{tikzpicture}[>={Stealth[length=2.2mm]}, every node/.style={font=\footnotesize}]
  \draw[->] (0,0) -- (6.9,0) node[below=2pt, pos=0.78]{activos exteriores privados $F$};
  \draw[->] (0,0) -- (0,5.2) node[left=2pt]{$r$};
  \draw[thick] (0.5,2.6) -- (6.0,2.6) node[right]{BB};
  \draw[thick] (0.7,1.07) -- (5.8,4.13) node[right]{MM};
  \draw[thick] (0.7,4.13) -- (5.8,1.07) node[right]{FF};
  \fill (3.25,2.6) circle (1.7pt) node[above right=2pt and 2pt]{$E$};
  \draw[dashed] (0,2.6) node[left]{$r_0$} -- (0.5,2.6);
  \draw[dashed] (3.25,2.6) -- (3.25,0) node[below]{$F_0$};
  \node[gray] at (3.45,-0.75) {\scriptsize MM vac\'ia el mercado de dinero; BB, el de bonos nacionales; FF, el de activos exteriores};
\end{tikzpicture}
