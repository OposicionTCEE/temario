% Cuerpo, bloque 1 — La brecha de la balanza de pagos en el mercado de divisas y los tres margenes
% que la cierran: precio (e0 -> e1, equilibrio E1), cantidad (D0 -> D1, equilibrio E2 = A) y
% financiacion (reservas o credito oficial que cubren A-B al tipo e0).
\begin{tikzpicture}[>={Stealth[length=2.2mm]}, every node/.style={font=\footnotesize}]
  % ejes
  \draw[->] (0,0) -- (8.4,0) node[below=2pt, pos=0.9]{divisas por periodo};
  \draw[->] (0,0) -- (0,5.4) node[left=2pt]{$e$};
  % oferta y demandas de divisas
  \draw[thick] (1.0,0.8) -- (7.6,4.7) node[right=1pt]{$S$};
  \node[anchor=west, align=left] at (7.95,4.25) {\scriptsize exportaciones y\\[-2pt]\scriptsize entradas de capital};
  \draw[thick] (1.0,4.9) -- (7.6,0.9) node[right=1pt]{$D_0$};
  \node[anchor=west, align=left] at (7.95,1.35) {\scriptsize importaciones y\\[-2pt]\scriptsize salidas de capital};
  \draw[thick, dashed] (0.6,3.473) -- (5.2,0.685) node[right=1pt]{$D_1$};
  % tipos de cambio
  \draw[dashed] (0,2.0) node[left]{$e_0$} -- (5.785,2.0);
  \draw[dashed] (0,2.824) node[left]{$e_1$} -- (4.425,2.824);
  % brecha A-B (financiacion)
  \draw[line width=3pt, gray!45] (3.031,2.0) -- (5.785,2.0);
  \node at (4.40,2.20) {\scriptsize brecha};
  \node at (4.60,1.80) {\scriptsize financiaci\'on};
  % puntos
  \fill (3.031,2.0) circle (1.6pt);
  \node at (3.03,1.55) {$A=E_2$};
  \fill (5.785,2.0) circle (1.6pt);
  \node at (5.98,2.20) {$B$};
  \fill (4.425,2.824) circle (1.6pt);
  \node at (4.43,3.07) {$E_1$};
  % margen del precio: e0 -> e1
  \draw[->, thick] (0.3,2.07) -- (0.3,2.75);
  \node[anchor=west] at (0.36,2.41) {\scriptsize precio};
  % margen de la cantidad: D0 -> D1
  \draw[->, thick] (3.72,3.2) -- (1.14,3.2);
  \node at (2.43,3.38) {\scriptsize cantidad};
\end{tikzpicture}
