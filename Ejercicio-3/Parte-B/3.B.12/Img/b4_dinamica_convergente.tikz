% Cuerpo, bloque 4 — Aritmética (2/2): diagrama de fases de la posición exterior sobre el PIB cuando r<g.
% Sin valoración, Delta pii_t = k pii_{t-1} + b, con k=(r-g)/(1+g)<0: recta decreciente de pendiente k
% (triángulo) y ordenada en el origen b<0 (déficit comercial). Corta el eje en pii-bar<0, que es estable
% (flechas sobre el eje hacia dentro). Valores de dibujo: k=-0,4; b=-1,2; pii-bar=-3.
% Misma geometría que b4_dinamica_divergente, a la que acompaña.
\begin{tikzpicture}[scale=0.8, >={Stealth[length=2.2mm]}, every node/.style={font=\footnotesize}]
  % ejes
  \draw[->] (-5.6,0) -- (2.0,0) node[below=2pt]{$pii_{t-1}$};
  \draw[->] (0,-2.2) -- (0,2.3) node[left=2pt]{$\Delta pii_t$};
  \node[above right=0pt and 0pt] at (0,0) {$0$};
  % recta
  \draw[thick] (-5.0,0.8) -- (1.5,-1.8) node[right=1pt]{$b<0$};
  % ordenada en el origen
  \fill (0,-1.2) circle (1.4pt);
  \node[right=1pt] at (0.02,-0.9) {$b$};
  % pendiente
  \draw[gray] (-5.0,0.8) -- (-3.8,0.8) -- (-3.8,0.32);
  \node[right=1pt] at (-3.8,0.62) {$\tfrac{r-g}{1+g}$};
  % posición estable y movimiento
  \draw[->, very thick, gray] (-4.8,0) -- (-3.15,0);
  \draw[->, very thick, gray] (-1.2,0) -- (-2.85,0);
  \fill (-3,0) circle (1.6pt);
  \node[below left=1pt and 0pt] at (-3,0) {$\overline{pii}$};
\end{tikzpicture}
