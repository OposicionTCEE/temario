% Cuerpo, bloque 2 — Enfoque monetario sobre la base del mercado de divisas del bloque 1:
% al tipo fijo e0, las reservas cubren la brecha A-B0; la venta de reservas retira dinero,
% reduce el gasto y desplaza la demanda D0 -> D' -> D1 hasta cerrar la brecha en A.
\begin{tikzpicture}[>={Stealth[length=2.2mm]}, every node/.style={font=\footnotesize}]
  % ejes
  \draw[->] (0,0) -- (8.4,0) node[below=2pt, pos=0.9]{divisas por periodo};
  \draw[->] (0,0) -- (0,5.4) node[left=2pt]{$e$};
  % oferta y demandas
  \draw[thick] (1.0,0.8) -- (7.6,4.7) node[right=1pt]{$S$};
  \draw[thick] (1.0,4.9) -- (7.6,0.9) node[right=1pt]{$D_0$};
  \draw[thick, dashed, gray] (1.0,4.066) -- (6.8,0.550) node[right=1pt, black]{$D'$};
  \draw[thick, dashed] (0.6,3.473) -- (5.2,0.685) node[right=1pt]{$D_1$};
  % tipo fijo
  \draw[dashed] (0,2.0) node[left]{$e_0$} -- (5.785,2.0);
  % brechas sucesivas
  \draw[line width=3pt, gray!30] (3.031,2.0) -- (5.785,2.0);
  \draw[line width=3pt, gray!65] (3.031,2.0) -- (4.408,2.0);
  % puntos
  \fill (3.031,2.0) circle (1.6pt);
  \node at (3.03,1.58) {$A$};
  \fill (5.785,2.0) circle (1.6pt);
  \node at (6.02,2.22) {$B_0$};
  \fill (4.408,2.0) circle (1.6pt);
  \node at (4.62,2.24) {$B'$};
  % desplazamientos de la demanda
  \draw[->, thick] (4.06,3.0) -- (2.84,3.0);
  \draw[->, thick] (2.68,3.0) -- (1.46,3.0);
  \node[align=center] at (3.75,4.65) {\scriptsize las reservas que se venden\\[-2pt]\scriptsize retiran dinero y reducen el gasto};
  % rotulo de las brechas
  \node[anchor=west, align=left] at (6.95,1.75) {\scriptsize reservas perdidas en\\[-2pt]\scriptsize cada periodo};
\end{tikzpicture}
