% Anexo I.5 — Mundell-Fleming con tipo de cambio flexible (movilidad alta):
% (a) la expansion monetaria se refuerza con la depreciacion; (b) la fiscal se expulsa via apreciacion.
\begin{tikzpicture}[>={Stealth[length=2.2mm]}, every node/.style={font=\footnotesize}]
% ---------- (a) politica monetaria ----------
\begin{scope}
  \node[font=\footnotesize\bfseries] at (3.3,5.75) {(a) Pol\'itica monetaria: reforzada};
  \draw[->] (0,0) -- (6.9,0) node[below=2pt, pos=0.93]{$Y$};
  \draw[->] (0,0) -- (0,5.4) node[left=2pt]{$i$};
  \draw[gray, thick] (0.8,4.6) -- (5.6,0.9) node[right]{\textcolor{gray}{$IS_0$}};
  \draw[thick] (1.5,4.75) -- (6.2,1.13) node[right]{$IS_1$};
  \draw[gray, thick] (0.9,0.8) -- (5.35,4.66) node[above]{\textcolor{gray}{$LM_0$}};
  \draw[thick] (2.1,0.8) -- (6.3,4.44) node[right]{$LM_1$};
  \draw[gray, thick] (0.8,1.70) -- (5.5,3.82) node[above right=-1pt and -4pt]{\textcolor{gray}{$BP_0$}};
  \draw[thick] (0.9,1.15) -- (6.1,3.49) node[right]{$BP_1$};
  \fill (3.17,2.77) circle (1.6pt) node[above left=1pt and 0pt]{$E_0$};
  \fill (3.81,2.28) circle (1.6pt) node[below left=1pt and 0pt]{$E_1$};
  \fill (4.23,2.65) circle (1.6pt) node[below right=1pt and 0pt]{$E_2$};
  \node[align=left, anchor=north west] at (0.1,-0.55) {\scriptsize 1 expansi\'on monetaria: $LM_0\to LM_1$, con $E_1$ bajo $BP_0$\\[-2pt]\scriptsize 2 d\'eficit incipiente: el tipo de cambio se deprecia\\[-2pt]\scriptsize 3 la depreciaci\'on desplaza IS y BP: $E_2$, con m\'as renta};
\end{scope}
% ---------- (b) politica fiscal ----------
\begin{scope}[xshift=8.1cm]
  \node[font=\footnotesize\bfseries] at (3.3,5.75) {(b) Pol\'itica fiscal: expulsada};
  \draw[->] (0,0) -- (6.9,0) node[below=2pt, pos=0.93]{$Y$};
  \draw[->] (0,0) -- (0,5.4) node[left=2pt]{$i$};
  \draw[gray, thick] (0.8,4.6) -- (5.6,0.9) node[right]{\textcolor{gray}{$IS_0$}};
  \draw[dashed] (2.2,4.99) -- (6.6,1.59) node[right]{$IS_1$};
  \draw[thick] (1.6,4.6) -- (6.1,1.13) node[right]{$IS_2$};
  \draw[thick] (0.9,0.8) -- (5.35,4.66) node[above]{$LM_0$};
  \draw[gray, thick] (0.8,1.70) -- (5.5,3.82) node[below right=-1pt and -4pt]{\textcolor{gray}{$BP_0$}};
  \draw[thick] (0.8,1.86) -- (5.9,4.16) node[right]{$BP_1$};
  \fill (3.17,2.77) circle (1.6pt) node[below left=1pt and 0pt]{$E_0$};
  \fill (4.07,3.55) circle (1.6pt) node[above right=1pt and 0pt]{$E_1$};
  \fill (3.55,3.10) circle (1.6pt) node[below right=1pt and 1pt]{$E_2$};
  \node[align=left, anchor=north west] at (0.1,-0.55) {\scriptsize 1 expansi\'on fiscal: $IS_0\to IS_1$, con $E_1$ sobre $BP_0$\\[-2pt]\scriptsize 2 super\'avit incipiente: el tipo de cambio se aprecia\\[-2pt]\scriptsize 3 la apreciaci\'on expulsa demanda: $E_2$ (con $\beta\to\infty$, vuelta a $Y_0$)};
\end{scope}
\end{tikzpicture}
