% Cuerpo, bloque 1 — Las cuatro lecturas de la identidad del saldo corriente, la variable que
% ajusta cada una, el margen que mueve y el enfoque que la estudia.
\begin{tikzpicture}[>={Stealth[length=2.0mm]}, every node/.style={font=\footnotesize},
    caja/.style={draw, rounded corners=2pt, align=center, text width=2.95cm, inner sep=3pt},
    etiqueta/.style={align=right, text width=1.35cm, font=\scriptsize\itshape}]
  % fila superior: la identidad, termino a termino sobre su columna
  \node at (-0.45,5.3) {$CC\;\equiv$};
  \foreach \x/\t in {1.9/{(X-M)+RP}, 5.3/{Y-A}, 8.7/{CF-CK}, 12.1/{S-I}} {
    \node (t\x) at (\x,5.3) {$\t$};
    \draw[->] (\x,5.05) -- (\x,4.78);
  }
  \foreach \x in {3.6, 7.0, 10.4} { \node at (\x,5.3) {$\equiv$}; }
  % etiquetas de las filas
  \node[etiqueta] at (-0.55,4.45) {lectura};
  \node[etiqueta] at (-0.55,3.40) {qu\'e se ajusta};
  \node[etiqueta] at (-0.55,2.42) {margen};
  \node[etiqueta] at (-0.55,1.38) {enfoque};
  % columna 1: comercio y rentas
  \node[caja, fill=gray!15, minimum height=0.62cm] at (1.9,4.45) {\textbf{comercio y rentas}};
  \node[caja, minimum height=1.05cm] at (1.9,3.40) {\scriptsize los precios relativos:\\[-1pt]\scriptsize el tipo de cambio real};
  \node[caja, minimum height=0.55cm] at (1.9,2.42) {\scriptsize precio};
  \node[caja, minimum height=1.12cm] at (1.9,1.38) {\scriptsize elasticidades\\[-1pt]\scriptsize (MARSHALL,\\[-1pt]\scriptsize LERNER)};
  % columna 2: renta y gasto
  \node[caja, fill=gray!15, minimum height=0.62cm] at (5.3,4.45) {\textbf{renta y gasto}};
  \node[caja, minimum height=1.05cm] at (5.3,3.40) {\scriptsize la producci\'on\\[-1pt]\scriptsize y la absorci\'on};
  \node[caja, minimum height=0.55cm] at (5.3,2.42) {\scriptsize cantidad};
  \node[caja, minimum height=1.12cm] at (5.3,1.38) {\scriptsize multiplicador y absorci\'on\\[-1pt]\scriptsize (MACHLUP,\\[-1pt]\scriptsize ALEXANDER)};
  % columna 3: financiacion
  \node[caja, fill=gray!15, minimum height=0.62cm] at (8.7,4.45) {\textbf{financiaci\'on}};
  \node[caja, minimum height=1.05cm] at (8.7,3.40) {\scriptsize el dinero, las reservas\\[-1pt]\scriptsize y las carteras};
  \node[caja, minimum height=0.55cm] at (8.7,2.42) {\scriptsize financiaci\'on};
  \node[caja, minimum height=1.12cm] at (8.7,1.38) {\scriptsize monetario y de cartera\\[-1pt]\scriptsize (POLAK, JOHNSON,\\[-1pt]\scriptsize BRANSON)};
  % columna 4: ahorro e inversion
  \node[caja, fill=gray!15, minimum height=0.62cm] at (12.1,4.45) {\textbf{ahorro e inversi\'on}};
  \node[caja, minimum height=1.05cm] at (12.1,3.40) {\scriptsize el consumo y la inversi\'on\\[-1pt]\scriptsize a lo largo del tiempo};
  \node[caja, minimum height=0.55cm] at (12.1,2.42) {\scriptsize ninguno (elecci\'on)};
  \node[caja, minimum height=1.12cm] at (12.1,1.38) {\scriptsize intertemporal\\[-1pt]\scriptsize (SACHS, OBSTFELD,\\[-1pt]\scriptsize ROGOFF)};
\end{tikzpicture}
