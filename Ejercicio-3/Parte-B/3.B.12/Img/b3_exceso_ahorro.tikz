% Cuerpo, bloque 3 — Exceso de ahorro mundial en el diagrama de ahorro e inversion de dos
% economias (misma base que b3_ahorro_inversion). Al tipo r*0 el deficit de Estados Unidos iguala
% el superavit del resto del mundo; si el ahorro del resto del mundo sube (S0 -> S1), el tipo baja
% a r*1 y el deficit estadounidense se amplia hasta igualar el mayor superavit.
% EE. UU.: x_S = 0,5 + 0,9 r ; x_I = 6,0 - 0,9 r. Resto: x_I = 5,0 - 0,9 r ; x_S0 = 1,5 + 0,9 r ;
% x_S1 = 2,5 + 0,9 r. Equilibrios: r*0 = 2,5 (saldos de 1,0) y r*1 = 2,222 (saldos de 1,5).
\begin{tikzpicture}[>={Stealth[length=2.0mm]}, every node/.style={font=\footnotesize}]
  % ======================= (a) Estados Unidos =======================
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (3.1,5.6) {(a) Estados Unidos};
    \draw[->] (0,0) -- (6.4,0) node[below=2pt, pos=0.85]{ahorro e inversi\'on};
    \draw[->] (0,0) -- (0,5.2) node[left=2pt]{$r$};
    \draw[thick] (0.77,0.3) -- (4.82,4.8) node[above]{$S$};
    \draw[thick] (5.73,0.3) -- (1.68,4.8) node[above]{$I$};
    \draw[dashed] (0,2.5) node[left]{$r^{*}_0$} -- (6.2,2.5);
    \draw[dashed] (0,2.222) node[left]{$r^{*}_1$} -- (6.2,2.222);
    \draw[line width=3pt, gray!30] (2.75,2.5) -- (3.75,2.5);
    \draw[line width=3pt, gray!65] (2.5,2.222) -- (4.0,2.222);
    \node[anchor=north, align=center] at (3.25,1.95) {\scriptsize d\'eficit: crece\\[-2pt]\scriptsize al bajar el tipo};
  \end{scope}
  % ======================= (b) Resto del mundo =======================
  \begin{scope}[xshift=7.4cm]
    \node[font=\footnotesize\bfseries] at (3.1,5.6) {(b) Resto del mundo};
    \draw[->] (0,0) -- (6.8,0) node[below=2pt, pos=0.85]{ahorro e inversi\'on};
    \draw[->] (0,0) -- (0,5.2) node[left=2pt]{$r$};
    \draw[thick] (4.73,0.3) -- (0.68,4.8) node[above]{$I$};
    \draw[thick] (1.77,0.3) -- (5.82,4.8) node[above]{$S_0$};
    \draw[thick, dashed] (2.77,0.3) -- (6.37,4.3) node[above]{$S_1$};
    \draw[dashed] (0,2.5) -- (6.6,2.5);
    \draw[dashed] (0,2.222) -- (6.6,2.222);
    \draw[line width=3pt, gray!30] (2.75,2.5) -- (3.75,2.5);
    \draw[line width=3pt, gray!65] (3.0,2.222) -- (4.5,2.222);
    \draw[->, thick] (4.85,3.6) -- (5.65,3.6);
    \node[anchor=west] at (5.0,3.95) {\scriptsize exceso de ahorro};
    \node[anchor=north, align=center] at (3.75,1.95) {\scriptsize super\'avit: financia\\[-2pt]\scriptsize el d\'eficit de (a)};
  \end{scope}
\end{tikzpicture}
