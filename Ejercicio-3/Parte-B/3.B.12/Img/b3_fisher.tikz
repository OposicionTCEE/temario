% Cuerpo, bloque 3 — Diagrama de FISHER (dotacion, dos periodos) con la ganancia del comercio
% intertemporal: en autarquia la economia consume su renta en Y y alcanza U0; con acceso al
% credito exterior se mueve por la recta de pendiente -(1+r) hasta C y alcanza U1.
\begin{tikzpicture}[>={Stealth[length=2.2mm]}, every node/.style={font=\footnotesize}, x=0.85cm, y=0.85cm]
  % ejes
  \draw[->] (0,0) -- (7.3,0) node[below=2pt]{$c_1$};
  \draw[->] (0,0) -- (0,7.4) node[left=2pt]{$c_2$};
  % recta presupuestaria
  \draw[thick] (1.3,6.16) -- (6.3,0.16);
  \node[anchor=west] at (5.55,1.25) {\scriptsize pendiente $-(1+r)$};
  % curvas de indiferencia
  \draw[gray, thick] plot[smooth] coordinates {(2.05,6.799) (2.3,5.627) (2.6,4.6) (3.0,3.636) (3.5,2.822) (4.2,2.091) (5.0,1.57) (5.9,1.196)};
  \node[gray, left=1pt] at (2.05,6.8) {$U_0$};
  \draw[thick] plot[smooth] coordinates {(2.45,6.537) (2.8,5.248) (3.2,4.214) (3.6,3.472) (4.0,2.92) (4.6,2.321) (5.3,1.839) (6.2,1.421)};
  \node[right=1pt] at (6.2,1.45) {$U_1$};
  % puntos y guias
  \draw[dashed] (2.6,0) -- (2.6,4.6) -- (0,4.6);
  \draw[dashed] (4.0,0) -- (4.0,2.92) -- (0,2.92);
  \fill (2.6,4.6) circle (1.7pt);
  \node[above right=0pt and 1pt] at (2.6,4.6) {$Y$};
  \fill (4.0,2.92) circle (1.7pt);
  \node[above right=0pt and 1pt] at (4.0,2.92) {$C$};
  \node[below] at (2.6,0) {$y_1$};
  \node[below] at (4.0,0) {$c_1$};
  \node[left] at (0,4.6) {$y_2$};
  \node[left] at (0,2.92) {$c_2$};
  % deficit y superavit
  \draw[decorate,decoration={brace,mirror,amplitude=4pt}] (2.62,-0.55) -- (3.98,-0.55)
    node[midway, below=5pt]{\scriptsize d\'eficit en 1: $c_1-y_1$};
  \node[anchor=west, align=left] at (0.25,3.76) {\scriptsize super\'avit en 2:\\[-2pt]\scriptsize $y_2-c_2=(1+r)(c_1-y_1)$};
\end{tikzpicture}
