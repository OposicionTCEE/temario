% Anexo I.3 — Enfoque de la absorcion (ALEXANDER, 1952): el deficit exterior como exceso
% de absorcion sobre produccion, y las dos familias de politicas que lo cierran.
\begin{tikzpicture}[>={Stealth[length=2.2mm]}, every node/.style={font=\footnotesize}]
  % barra de produccion
  \fill[gray!25] (0,2.1) rectangle (7,2.9);
  \draw (0,2.1) rectangle (7,2.9);
  \node at (3.5,2.5) {producci\'on $Y$};
  % ampliacion posible de Y (recursos ociosos)
  \draw[dashed] (7,2.1) rectangle (7.9,2.9);
  \node[above, align=center] at (6.3,3.05) {\scriptsize $\uparrow Y$ solo si hay recursos ociosos};
  % barra de absorcion
  \fill[gray!25] (0,0.7) rectangle (7,1.5);
  \fill[gray!55] (7,0.7) rectangle (8.6,1.5);
  \draw (0,0.7) rectangle (8.6,1.5);
  \node at (3.5,1.1) {absorci\'on $A=C+I+G$};
  \draw[dashed] (7,0.35) -- (7,3.25);
  % deficit
  \draw[decorate,decoration={brace,mirror,amplitude=4pt}] (7.02,0.55) -- (8.58,0.55)
    node[midway, below=5pt]{\scriptsize d\'eficit exterior: $B=Y-A<0$};
  % politicas
  \draw[->, thick] (9.9,2.5) -- (7.95,2.5);
  \node[right, align=left] at (9.95,2.5) {\scriptsize desviaci\'on del gasto:\\[-2pt]\scriptsize traslada demanda, propia y ajena,\\[-2pt]\scriptsize hacia la producci\'on interior};
  \draw[->, thick] (9.9,1.1) -- (8.65,1.1);
  \node[right, align=left] at (9.95,1.1) {\scriptsize reducci\'on del gasto:\\[-2pt]\scriptsize recorta $A$ hasta la producci\'on};
\end{tikzpicture}
