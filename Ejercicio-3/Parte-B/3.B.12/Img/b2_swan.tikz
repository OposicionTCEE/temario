% Cuerpo, bloque 2 — Diagrama de SWAN (misma base que el del Anexo I.4): desde D, en la zona III
% (paro y deficit), la politica de gasto sola lleva a D1 (sobre EE) o a D2 (sobre EI); hacen falta
% la desviacion del gasto (D -> D3) y la reduccion del gasto (D3 -> P).
\begin{tikzpicture}[>={Stealth[length=2.2mm]}, every node/.style={font=\footnotesize}]
  \draw[->] (0,0) -- (8.8,0) node[below=2pt, pos=0.92]{absorci\'on $A$};
  \draw[->] (0,0) -- (0,7.0) node[above=2pt]{competitividad $R$};
  % curvas
  \draw[thick] (1.2,6.2) -- (7.6,0.9) node[below right=-2pt]{EI};
  \draw[thick] (1.2,0.9) -- (7.6,6.2) node[above right=-2pt]{EE};
  % zonas
  \node[align=center, gray] at (4.4,6.1) {\scriptsize I: inflaci\'on y super\'avit};
  \node[align=center, gray] at (7.45,3.45) {\scriptsize II: inflaci\'on\\[-2pt]\scriptsize y d\'eficit};
  \node[align=center, gray] at (4.4,0.55) {\scriptsize III: paro y d\'eficit};
  \node[align=center, gray] at (1.25,3.55) {\scriptsize IV: paro\\[-2pt]\scriptsize y super\'avit};
  % politica de gasto sola: D -> D1 y D -> D2
  \draw[->, dashed] (5.05,1.9) -- (2.55,1.9);
  \draw[->, dashed] (5.35,1.9) -- (6.25,1.9);
  \fill (2.408,1.9) circle (1.5pt);
  \node[below] at (2.408,1.82) {$D_1$};
  \fill (6.393,1.9) circle (1.5pt);
  \node[below] at (6.393,1.82) {$D_2$};
  % dos instrumentos: D -> D3 -> P
  \draw[->, thick] (5.2,1.97) -- (5.2,3.45);
  \draw[->, thick] (5.13,3.55) -- (4.52,3.55);
  \fill (5.2,1.9) circle (1.6pt);
  \node[below] at (5.2,1.82) {$D$};
  \fill (5.2,3.55) circle (1.5pt);
  \node[right=2pt] at (5.2,3.62) {$D_3$};
  \fill (4.4,3.55) circle (1.7pt);
  \node[above left=1pt and 0pt] at (4.4,3.55) {$P$};
  % leyenda bajo el eje
  \draw[->, thick] (0.5,-0.95) -- (0.5,-0.55);
  \node[right] at (0.65,-0.75) {\scriptsize desviaci\'on del gasto (tipo de cambio real o salarios): mueve $R$};
  \draw[->, thick] (0.3,-1.25) -- (0.75,-1.25);
  \node[right] at (0.85,-1.25) {\scriptsize pol\'itica de gasto (reducci\'on o aumento de la absorci\'on): mueve $A$};
\end{tikzpicture}
