% Anexo I.4 — Diagrama de SWAN: equilibrio interno (EI) y externo (EE) en el plano
% (absorcion A, competitividad R = tipo de cambio real). Cuatro zonas de desequilibrio
% y las dos palancas: la politica de gasto mueve A, la cambiaria (o de rentas) mueve R.
\begin{tikzpicture}[>={Stealth[length=2.2mm]}, every node/.style={font=\footnotesize}]
  \draw[->] (0,0) -- (8.8,0) node[below=2pt, pos=0.92]{absorci\'on $A$};
  \draw[->] (0,0) -- (0,7.2) node[above=2pt]{competitividad $R$};
  % curvas
  \draw[thick] (1.2,6.2) -- (7.6,0.9) node[below right=-2pt]{EI};
  \draw[thick] (1.2,0.9) -- (7.6,6.2) node[above right=-2pt]{EE};
  \fill (4.4,3.55) circle (1.7pt);
  \node[below right=2pt and 2pt] at (4.4,3.55) {$P$};
  % zonas
  \node[align=center] at (4.4,5.95) {\scriptsize zona I\\[-2pt]\scriptsize inflaci\'on y super\'avit};
  \node[align=center] at (6.95,3.2) {\scriptsize zona II\\[-2pt]\scriptsize inflaci\'on y d\'eficit};
  \node[align=center] at (4.4,1.0) {\scriptsize zona III\\[-2pt]\scriptsize desempleo y d\'eficit};
  \node[align=center] at (1.8,3.55) {\scriptsize zona IV\\[-2pt]\scriptsize desempleo y super\'avit};
  % palancas
  \draw[<->, gray, thick] (3.3,3.55) -- (5.5,3.55);
  \node[gray, below right=1pt and -34pt] at (5.5,3.5) {\scriptsize pol\'itica de gasto};
  \draw[<->, gray, thick] (4.4,2.5) -- (4.4,4.6);
  \node[gray, right=2pt, align=left] at (4.42,4.38) {\scriptsize pol\'itica cambiaria\\[-2pt]\scriptsize (o de rentas)};
\end{tikzpicture}
