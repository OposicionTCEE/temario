% Cuerpo, bloque 4 — Del trilema al dilema. Triangulo de la imposible trinidad: cada lado combina
% dos vertices y renuncia al tercero. Con un ciclo financiero global (REY, 2013), el lado de la
% flotacion (libertad de capitales y politica monetaria propia) deja de estar garantizado: la
% autonomia exige gestionar la cuenta de capital, sea cual sea el regimen cambiario.
\begin{tikzpicture}[every node/.style={font=\footnotesize}]
  % vertices
  \coordinate (L) at (3.6,5.0);
  \coordinate (F) at (0,0);
  \coordinate (M) at (7.2,0);
  % lados
  \draw[thick] (L) -- (F);
  \draw[thick] (F) -- (M);
  \draw[thick, dashed, gray] (L) -- (M);
  % vertices rotulados
  \fill (L) circle (2pt); \fill (F) circle (2pt); \fill (M) circle (2pt);
  \node[above=3pt, align=center] at (L) {\textbf{libertad de capitales}};
  \node[below left=2pt and -6pt, align=center] at (F) {\textbf{tipo de cambio}\\[-2pt]\textbf{fijo}};
  \node[below right=2pt and -14pt, align=center] at (M) {\textbf{pol\'itica monetaria}\\[-2pt]\textbf{propia}};
  % opciones del trilema en cada lado
  \node[anchor=east, align=right] at (1.55,2.6) {\scriptsize sin pol\'itica monetaria propia:\\[-2pt]\scriptsize uni\'on monetaria, caja de conversi\'on};
  \node[anchor=north, align=center] at (3.6,-0.25) {\scriptsize sin libertad de capitales:\\[-2pt]\scriptsize controles, como en Bretton Woods};
  \node[anchor=west, align=left] at (5.6,2.75) {\scriptsize sin tipo de cambio fijo: flotaci\'on};
  % el dilema
  \node[font=\Large, gray] at (5.4,2.5) {$\times$};
  \node[anchor=north west, align=left, text width=4.3cm] at (6.6,2.45) {\scriptsize con un ciclo financiero global, la flotaci\'on ya no garantiza la pol\'itica monetaria propia: hay que gestionar los flujos de capital (dilema de REY)};
\end{tikzpicture}
