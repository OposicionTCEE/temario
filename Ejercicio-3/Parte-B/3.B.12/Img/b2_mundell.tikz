% Cuerpo, bloque 2 — Asignacion de MUNDELL (1962) en el plano (gasto publico G, tipo de interes r):
% EI mas inclinada que EE (la politica monetaria tiene ventaja comparativa sobre el equilibrio
% externo). Con la asignacion correcta (fiscal -> EI, monetaria -> EE) la economia converge
% de A0 a Q en escalones; con la contraria (gris) se aleja.
\begin{tikzpicture}[>={Stealth[length=2.0mm]}, every node/.style={font=\footnotesize}]
  \draw[->] (0,0) -- (8.8,0) node[below=2pt, pos=0.9]{gasto p\'ublico $G$};
  \draw[->] (0,0) -- (0,6.4) node[above=2pt]{tipo de inter\'es $r$};
  % curvas: EI: r = 3 + 1,2 (G - 4,5); EE: r = 3 + 0,4 (G - 4,5)
  \draw[thick] (2.1,0.12) -- (7.0,6.0) node[above=1pt]{EI};
  \draw[thick] (0.4,1.36) -- (8.2,4.48) node[right=1pt]{EE};
  % zonas
  \node[gray, align=center] at (2.0,4.6) {\scriptsize paro y super\'avit};
  \node[gray, align=center] at (7.3,1.3) {\scriptsize inflaci\'on y d\'eficit};
  \node[gray, align=center] at (1.15,0.62) {\scriptsize paro y\\[-2pt]\scriptsize d\'eficit};
  \node[gray, align=center] at (6.55,4.45) {\scriptsize inflaci\'on y\\[-2pt]\scriptsize super\'avit};
  % asignacion contraria (gris): A0 -> B1 y se aleja
  \draw[->, gray, dashed] (2.8,1.82) -- (2.8,1.04);
  \fill[gray] (2.8,0.96) circle (1.4pt);
  \node[gray, right=2pt] at (2.8,0.88) {$B_1$};
  \draw[->, gray, dashed] (2.72,0.96) -- (1.95,0.96);
  % asignacion correcta: A0 -> A1 -> A2 -> A3 -> A4 -> Q
  \draw[->, thick] (2.86,1.9) -- (3.53,1.9);
  \draw[->, thick] (3.583,1.96) -- (3.583,2.58);
  \draw[->, thick] (3.64,2.633) -- (4.14,2.633);
  \draw[->, thick] (4.194,2.68) -- (4.194,2.84);
  \draw[->, thick] (4.24,2.878) -- (4.46,2.97);
  \fill (2.8,1.9) circle (1.6pt);
  \node[left=2pt] at (2.8,1.95) {$A_0$};
  \fill (3.583,1.9) circle (1.5pt);
  \node[below right=0pt and 0pt] at (3.583,1.9) {$A_1$};
  \fill (3.583,2.633) circle (1.5pt);
  \node[above left=0pt and 0pt] at (3.583,2.633) {$A_2$};
  \fill (4.5,3.0) circle (1.7pt);
  \node[above left=1pt and 0pt] at (4.5,3.0) {$Q$};
  % leyenda de la asignacion
  \node[anchor=west, align=left] at (5.0,2.35) {\scriptsize fiscal $\to$ EI (horizontal)\\[-2pt]\scriptsize monetaria $\to$ EE (vertical)};
\end{tikzpicture}
