% Anexo III.2 — La cuenta corriente como amortiguador: ante una caida transitoria de la renta,
% el consumo se mantiene en su nivel permanente y la diferencia la cubre el deficit corriente.
\begin{tikzpicture}[>={Stealth[length=2.2mm]}, every node/.style={font=\footnotesize}]
  \draw[->] (0,0) -- (10.6,0) node[below=2pt]{tiempo};
  \draw[->] (0,0) -- (0,4.6);
  % renta
  \draw[thick] (0.4,3.5) -- (2.2,3.5) to[out=0,in=180] (3.0,2.3) -- (4.6,2.3) to[out=0,in=180] (5.4,3.5) -- (10.0,3.5);
  \node[right] at (10.05,3.5) {$y_t$};
  % consumo permanente
  \draw[thick, dashed] (0.4,3.28) -- (10.0,3.28);
  \node[right] at (10.05,3.1) {$c_t$};
  % areas
  \fill[gray!35] (2.56,2.95) -- (3.0,2.3) -- (4.6,2.3) -- (5.04,2.95) -- cycle;
  \fill[gray!35] (2.42,3.1) -- (2.56,2.95) -- (5.04,2.95) -- (5.18,3.1) -- cycle;
  \draw[->] (3.8,1.5) node[below, align=center]{\scriptsize d\'eficit corriente:\\[-2pt]\scriptsize se pide prestado} -- (3.8,2.2);
  \draw[->] (7.6,4.25) node[above, align=center]{\scriptsize superávit: con $c_t$ bajo la renta\\[-2pt]\scriptsize normal, se devuelve la deuda} -- (7.6,3.55);
  % marca de la perturbacion
  \draw[dashed] (2.6,0) -- (2.6,2.0);
  \draw[dashed] (5.0,0) -- (5.0,2.0);
  \node[below] at (3.8,0) {\scriptsize ca\'ida transitoria de $y$};
\end{tikzpicture}
