% Cuerpo, bloque 2 — Curva J desde un deficit inicial B0: la depreciacion en t0 lo agrava
% hasta B1 (efecto precio) y el efecto cantidad lo devuelve a B0 en t1 y lo mejora hasta B2.
% La zona sombreada es la brecha adicional que hay que financiar mientras tanto.
\begin{tikzpicture}[>={Stealth[length=2.2mm]}, every node/.style={font=\footnotesize}]
  % zona sombreada: brecha adicional entre t0 y t1
  \fill[gray!25] plot[smooth] coordinates {(1.0,-1.0) (1.8,-1.9) (2.8,-2.35) (3.8,-2.0) (5.0,-1.0)} -- cycle;
  % ejes
  \draw[->] (0,-3.0) -- (0,1.6) node[left=2pt]{$B$};
  \draw[->] (0,0) -- (10.9,0) node[below=2pt, pos=0.95]{tiempo};
  \node[left] at (0,0) {$0$};
  % deficit inicial
  \draw[dashed] (0,-1.0) node[left]{$B_0$} -- (10.5,-1.0);
  % curva J
  \draw[thick] plot[smooth] coordinates {(0,-1.0) (1.0,-1.0) (1.8,-1.9) (2.8,-2.35) (3.8,-2.0) (5.0,-1.0) (6.5,-0.35) (8.2,-0.08) (10.3,0.0)};
  % puntos
  \fill (1.0,-1.0) circle (1.5pt);
  \draw[dotted] (1.0,-1.0) -- (1.0,0);
  \node[above] at (1.0,0) {$t_0$};
  \fill (2.8,-2.35) circle (1.5pt);
  \draw[dotted] (0,-2.35) node[left]{$B_1$} -- (2.8,-2.35);
  \fill (5.0,-1.0) circle (1.5pt);
  \draw[dotted] (5.0,-1.0) -- (5.0,0);
  \node[above] at (5.0,0) {$t_1$};
  \fill (10.3,0.0) circle (1.5pt);
  \node[above] at (10.3,0.0) {$B_2$};
  % rotulos
  \node[align=center] at (3.0,-1.55) {\scriptsize financiaci\'on\\[-2pt]\scriptsize adicional};
  \node[anchor=north, align=center] at (2.5,-2.45) {\scriptsize efecto precio: lo ya contratado\\[-2pt]\scriptsize se paga m\'as caro};
  \node[anchor=north west, align=left] at (6.4,-0.45) {\scriptsize efecto cantidad: se exporta m\'as\\[-2pt]\scriptsize y se importa menos};
  \draw[->] (1.9,1.0) node[right]{\scriptsize depreciaci\'on} to[out=180,in=50] (1.22,0.5);
\end{tikzpicture}
