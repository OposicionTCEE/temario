% Anexo I.1 — Mercado de divisas (solo flujos corrientes): estabilidad del ajuste cambiario.
% Panel (a): oferta creciente, equilibrio único y estable. Panel (b): oferta vuelta hacia atrás
% (ingresos por exportación caen al depreciarse si la demanda es inelástica): equilibrio inestable.
\begin{tikzpicture}[>={Stealth[length=2.2mm]}, every node/.style={font=\footnotesize}]
% ---------- Panel (a): mercado estable ----------
\begin{scope}
  \node[font=\footnotesize\bfseries] at (3.1,5.75) {(a) Mercado estable};
  \draw[->] (0,0) -- (6.3,0) node[below=2pt, pos=0.85]{divisas};
  \draw[->] (0,0) -- (0,5.1) node[left=2pt]{$e$};
  \draw[thick] (0.6,4.6) -- (5.6,1.0) node[right]{$D$};
  \node[anchor=west] at (5.0,0.65) {\scriptsize importadores};
  \draw[thick] (0.6,0.8) -- (5.6,4.4) node[right]{$S$};
  \node[anchor=west] at (5.0,4.9) {\scriptsize exportadores};
  \draw[dashed] (0,2.70) node[left]{$e_0$} -- (3.24,2.70);
  \fill (3.24,2.70) circle (1.6pt) node[above right=0pt and 2pt]{$E$};
  \draw[dashed] (0,1.8) node[left]{$e_1$} -- (4.49,1.8);
  \fill (1.99,1.8) circle (1.1pt);
  \fill (4.49,1.8) circle (1.1pt);
  \draw[<->] (1.99,1.52) -- node[below]{exceso de demanda} (4.49,1.52);
  \draw[->, thick] (3.24,1.95) -- (3.24,2.48) node[midway, right=2pt]{$e$ sube};
\end{scope}
% ---------- Panel (b): oferta vuelta hacia atras ----------
\begin{scope}[xshift=8.1cm]
  \node[font=\footnotesize\bfseries] at (3.1,5.75) {(b) Mercado inestable};
  \draw[->] (0,0) -- (6.3,0) node[below=2pt, pos=0.85]{divisas};
  \draw[->] (0,0) -- (0,5.1) node[left=2pt]{$e$};
  \draw[thick] plot[smooth] coordinates {(0.9,0.7) (2.4,1.6) (3.4,2.4) (3.6,3.2) (2.9,4.3) (2.4,5.0)};
  \node[left=2pt] at (2.42,4.9) {$S$};
  \draw[thick] (2.6,5.05) -- (4.32,0.8) node[below=2pt]{$D$};
  \fill (3.51,2.83) circle (1.6pt);
  \draw[dashed] (0,2.83) -- (3.51,2.83);
  \node[right=2pt] at (3.56,2.72) {$E$ (estable)};
  \fill (3.02,4.12) circle (1.6pt);
  \draw[dashed] (0,4.12) -- (3.02,4.12);
  \node[right=2pt] at (3.12,4.22) {$E'$ (inestable)};
  % dinamica sobre el eje e
  \draw[->, thick] (0.3,2.1) -- (0.3,2.63);
  \draw[->, thick] (0.3,3.85) -- (0.3,3.05);
  \draw[->, thick] (0.3,4.35) -- (0.3,4.95) node[right=2pt, pos=0.85]{\scriptsize espiral de depreciaci\'on};
  \node[anchor=west, align=left] at (3.9,4.75) {\scriptsize por encima de $E'$:\\[-2pt]\scriptsize $\varepsilon_X+\lvert\varepsilon_M\rvert<1$};
\end{scope}
\end{tikzpicture}
