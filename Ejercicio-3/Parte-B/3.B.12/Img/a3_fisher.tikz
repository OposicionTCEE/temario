% Anexo III.1 — Diagrama de FISHER (dos periodos, economia de dotacion): la apertura financiera
% permite consumir hoy contra renta futura; deficit en 1 y devolucion en 2.
\begin{tikzpicture}[>={Stealth[length=2.2mm]}, every node/.style={font=\footnotesize}]
  \draw[->] (0,0) -- (7.2,0) node[below=2pt]{$c_1$};
  \draw[->] (0,0) -- (0,6.4) node[left=2pt]{$c_2$};
  % recta presupuestaria por la dotacion, pendiente -(1+r)
  \draw[thick] (1.8,5.8) -- (5.55,0.175);
  \node[below right=0pt and 3pt] at (4.5,1.75) {\scriptsize pendiente $-(1+r)$};
  % curva de indiferencia tangente en C
  \draw[thick] plot[smooth] coordinates {(2.7,4.9) (3.3,3.5) (3.8,2.8) (4.6,2.35) (5.9,2.0)};
  \node[right] at (5.95,2.0) {$U$};
  % dotacion y consumo
  \fill (2.4,4.9) circle (1.7pt);
  \node[above right=1pt and 1pt] at (2.4,4.9) {$Y$ (dotaci\'on)};
  \fill (3.8,2.8) circle (1.7pt);
  \node[above right=1pt and 2pt] at (3.85,2.85) {$C$};
  % guias
  \draw[dashed] (2.4,4.9) -- (2.4,0) node[below]{$y_1$};
  \draw[dashed] (3.8,2.8) -- (3.8,0) node[below]{$c_1$};
  \draw[dashed] (0,4.9) node[left]{$y_2$} -- (2.4,4.9);
  \draw[dashed] (0,2.8) node[left]{$c_2$} -- (3.8,2.8);
  % deficit y devolucion
  \draw[decorate,decoration={brace,mirror,amplitude=3pt}] (2.42,-0.55) -- (3.78,-0.55)
    node[midway, below=4pt]{\scriptsize d\'eficit del periodo 1: $c_1-y_1$};
  \draw[decorate,decoration={brace,amplitude=3pt}] (-0.82,4.9) -- (-0.82,2.8)
    node[midway, left=4pt, align=right]{\scriptsize devoluci\'on en 2:\\[-2pt]\scriptsize $y_2-c_2=(1+r)(c_1-y_1)$};
\end{tikzpicture}
