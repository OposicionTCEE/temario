% Cuerpo, bloque 2 — Multiplicador del comercio exterior en el plano (renta, saldo): equilibrio
% donde S-I corta a X-M. Una caida autonoma de las exportaciones desplaza (X-M)0 -> (X-M)1:
% deficit de impacto en F (renta Y0) y ajuste parcial por la renta hasta E1 (renta Y1).
\begin{tikzpicture}[>={Stealth[length=2.2mm]}, every node/.style={font=\footnotesize}]
  % ejes
  \draw[->] (0,-3.5) -- (0,2.7) node[left=2pt]{saldo};
  \draw[->] (0,0) -- (9.6,0) node[below=2pt, pos=0.95]{renta $Y$};
  \node[left] at (0,0) {$0$};
  % rectas
  \draw[thick] (0.9,-2.523) -- (8.6,2.215) node[right=1pt]{$S-I$};
  \draw[thick] (0.9,2.05) -- (8.6,-1.8) node[right=1pt]{$(X-M)_0$};
  \draw[thick, dashed] (0.9,0.55) -- (8.6,-3.3) node[right=1pt]{$(X-M)_1$};
  % puntos
  \fill (5.0,0) circle (1.6pt);
  \node[above right=1pt and 1pt] at (5.0,0) {$E_0$};
  \fill (5.0,-1.5) circle (1.6pt);
  \node[right=3pt] at (5.0,-1.5) {$F$};
  \fill (3.655,-0.828) circle (1.6pt);
  \node[above left=1pt and 0pt] at (3.655,-0.828) {$E_1$};
  % rentas
  \draw[dotted] (5.0,0) -- (5.0,-1.5);
  \draw[dotted] (3.655,-0.828) -- (3.655,0);
  \node[above] at (3.655,0) {$Y_1$};
  \node[above left=1pt and -1pt] at (5.0,0.02) {$Y_0$};
  % movimiento por (X-M)1 de F a E1
  \draw[->, thick, gray] (4.75,-1.68) -- (3.9,-1.24);
  % rotulos
  \node[anchor=west, align=left] at (5.25,-2.15) {\scriptsize d\'eficit de impacto: toda la\\[-2pt]\scriptsize ca\'ida de las exportaciones};
  \node[anchor=east, align=right] at (3.45,-1.6) {\scriptsize la renta cae y\\[-2pt]\scriptsize se importa menos};
  \node[anchor=east, align=right] at (3.45,-0.55) {\scriptsize d\'eficit final,\\[-2pt]\scriptsize menor pero no nulo};
\end{tikzpicture}
