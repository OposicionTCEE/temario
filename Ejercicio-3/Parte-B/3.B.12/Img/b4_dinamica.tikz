% Cuerpo, bloque 4 — Dinamica de la posicion exterior sobre el PIB en el plano (pii_{t-1}, Delta pii_t):
% Delta f = k f + b, con k = (r-g)/(1+g). (a) r>g (k>0): con superavit primario b>0 la posicion se
% estabiliza en fbar, pero es inestable; sin superavit (b=0) cualquier posicion deudora diverge.
% (b) r<g (k<0): con deficit comercial (b<0) la posicion converge a fbar desde cualquier punto.
% Valores ilustrativos: k = +-0,3 ; b = +-0,9 ; fbar = -3.
\begin{tikzpicture}[>={Stealth[length=2.0mm]}, every node/.style={font=\footnotesize}]
  % ======================= (a) r > g =======================
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (-1.8,2.35) {(a) $r>g$: posici\'on inestable};
    \draw[->] (-5.5,0) -- (1.9,0) node[below=2pt]{$pii_{t-1}$};
    \draw[->] (0,-1.9) -- (0,1.9) node[left=2pt]{$\Delta pii_t$};
    \node[below right=0pt and 0pt] at (0,0) {\scriptsize $0$};
    \draw[thick] (-5.2,-0.66) -- (1.6,1.38) node[above]{\scriptsize $b>0$};
    \draw[thick, dashed] (-5.2,-1.56) -- (1.6,0.48) node[right]{\scriptsize $b=0$};
    \fill (-3,0) circle (1.6pt);
    \node at (-2.72,-0.28) {$\overline{pii}$};
    \draw[->, very thick, gray] (-3.25,0.14) -- (-4.65,0.14);
    \draw[->, very thick, gray] (-2.75,0.14) -- (-1.3,0.14);
    \node[anchor=south, align=center] at (-3.95,0.28) {\scriptsize m\'as deuda\\[-2pt]\scriptsize que $\overline{pii}$: diverge};
    \node[anchor=south, align=center] at (-2.0,0.55) {\scriptsize menos deuda\\[-2pt]\scriptsize que $\overline{pii}$: decrece};
  \end{scope}
  % ======================= (b) r < g =======================
  \begin{scope}[xshift=8.4cm]
    \node[font=\footnotesize\bfseries] at (-1.8,2.35) {(b) $r<g$: posici\'on estable};
    \draw[->] (-5.5,0) -- (1.9,0) node[below=2pt]{$pii_{t-1}$};
    \draw[->] (0,-1.9) -- (0,1.9) node[left=2pt]{$\Delta pii_t$};
    \node[above right=0pt and 0pt] at (0,0) {\scriptsize $0$};
    \draw[thick] (-5.2,0.66) -- (1.6,-1.38) node[below]{\scriptsize $b<0$};
    \fill (-3,0) circle (1.6pt);
    \node[below left=1pt and 0pt] at (-3,0) {$\overline{pii}$};
    \draw[->, very thick, gray] (-4.75,-0.14) -- (-3.3,-0.14);
    \draw[->, very thick, gray] (-1.25,0.14) -- (-2.7,0.14);
    \node[anchor=north, align=center] at (-1.9,-0.82) {\scriptsize converge aunque\\[-2pt]\scriptsize haya d\'eficit comercial};
  \end{scope}
\end{tikzpicture}
