% Anexo III.4 — Flujos cuesta arriba: lo que predice el modelo intertemporal neoclasico
% (capital hacia la PMgK alta) frente a lo observado (flujos netos hacia las economias avanzadas).
\begin{tikzpicture}[>={Stealth[length=2.6mm]}, every node/.style={font=\footnotesize}]
  % cajas
  \draw[rounded corners=3pt, fill=gray!10] (0,1.7) rectangle (4.6,4.5);
  \node[align=center] at (2.3,3.75) {\textbf{Econom\'ias emergentes}};
  \node[align=center] at (2.3,2.75) {\scriptsize capital escaso, $PMgK$ alta,\\[-2pt]\scriptsize crecimiento r\'apido};
  \draw[rounded corners=3pt, fill=gray!10] (9.8,1.7) rectangle (15.2,4.5);
  \node[align=center] at (12.5,3.75) {\textbf{Econom\'ias avanzadas}};
  \node[align=center] at (12.5,2.75) {\scriptsize capital abundante, $PMgK$ baja;\\[-2pt]\scriptsize emisoras de los activos seguros};
  % flecha teorica (gris, discontinua): de avanzadas a emergentes
  \draw[->, gray, very thick, dashed] (9.7,4.05) -- (4.7,4.05);
  \node[gray, above, align=center] at (7.2,4.2) {\scriptsize lo que predice el modelo:\\[-2pt]\scriptsize capital hacia la $PMgK$ alta};
  % matiz: la IDE privada si baja
  \draw[->, thin] (9.7,3.3) -- (4.7,3.3);
  \node[above] at (7.2,3.37) {\scriptsize la inversi\'on directa privada s\'i baja};
  % flecha observada (negra): de emergentes a avanzadas
  \draw[->, very thick] (4.7,2.45) -- (9.7,2.45);
  \node[below, align=center] at (7.2,2.25) {\scriptsize lo observado: flujos \textbf{netos} cuesta arriba\\[-2pt]\scriptsize (reservas oficiales y exceso de ahorro)};
  % nota inferior
  \node[align=center] at (7.6,0.85) {\scriptsize Los flujos brutos van en ambos sentidos; el puzle es del flujo neto:\\[-2pt]\scriptsize las econom\'ias que m\'as crecen exportan capital en t\'erminos netos.};
\end{tikzpicture}
