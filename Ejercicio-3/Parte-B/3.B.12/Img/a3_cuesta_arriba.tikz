% Anexo III.4 — Flujos cuesta arriba: lo que predice el modelo intertemporal neoclasico
% (capital hacia la PMgK alta) frente a lo observado (flujos netos hacia las economias avanzadas).
\begin{tikzpicture}[>={Stealth[length=2.6mm]}, every node/.style={font=\footnotesize}]
  % cajas
  \draw[rounded corners=3pt, fill=gray!10] (0,1.7) rectangle (5.2,4.5);
  \node[align=center] at (2.6,3.75) {\textbf{Econom\'ias emergentes}};
  \node[align=center] at (2.6,2.85) {\scriptsize capital escaso, $PMgK$ alta,\\[-2pt]\scriptsize crecimiento r\'apido};
  \draw[rounded corners=3pt, fill=gray!10] (9.0,1.7) rectangle (14.4,4.5);
  \node[align=center] at (11.7,3.75) {\textbf{Econom\'ias avanzadas}};
  \node[align=center] at (11.7,2.85) {\scriptsize capital abundante, $PMgK$ baja;\\[-2pt]\scriptsize emisoras de los activos seguros};
  % flecha teorica (gris, discontinua): de avanzadas a emergentes
  \draw[->, gray, very thick, dashed] (8.9,4.0) -- (5.3,4.0);
  \node[gray, above, align=center] at (7.1,4.15) {\scriptsize lo que predice el modelo:\\[-2pt]\scriptsize capital hacia la $PMgK$ alta};
  % flecha observada (negra): de emergentes a avanzadas
  \draw[->, very thick] (5.3,2.6) -- (8.9,2.6);
  \node[below, align=center] at (7.1,2.4) {\scriptsize lo que se observa: flujos \textbf{netos} cuesta arriba\\[-2pt]\scriptsize (reservas oficiales y exceso de ahorro)};
  % matiz: la IDE privada si baja
  \draw[->, thin] (8.9,3.35) -- (5.3,3.35);
  \node[above] at (7.1,3.42) {\scriptsize la inversi\'on directa privada s\'i baja la cuesta};
  % nota inferior
  \node[align=center] at (7.2,0.9) {\scriptsize Los flujos brutos van en ambos sentidos; el puzle es del flujo neto:\\[-2pt]\scriptsize las econom\'ias que m\'as crecen exportan capital en t\'erminos netos.};
\end{tikzpicture}
