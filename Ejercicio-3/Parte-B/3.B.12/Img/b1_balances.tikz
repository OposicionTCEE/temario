% Cuerpo, bloque 1 — Heterogeneidad: balance exterior estilizado del emisor de la moneda de reserva
% (activos con riesgo en divisas, pasivos seguros en su moneda) y de un pais que se endeuda en
% dolares (reservas en dolares menores que su deuda en dolares). Mismo signo de la posicion neta,
% reaccion opuesta ante una depreciacion de la propia moneda.
\begin{tikzpicture}[>={Stealth[length=2.0mm]}, every node/.style={font=\footnotesize},
    partida/.style={draw, align=center, text width=2.7cm, inner sep=2pt}]
  % ================= (a) emisor de la moneda de reserva =================
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (3.3,4.55) {(a) Emisor de la moneda de reserva};
    \node at (1.65,4.08) {activos};
    \node at (4.95,4.08) {pasivos};
    \draw[thick] (0,3.85) -- (6.6,3.85);
    \draw[thick] (3.3,3.85) -- (3.3,0.55);
    % activos
    \node[partida, fill=gray!20, minimum height=1.65cm] at (1.65,2.90) {\scriptsize inversi\'on directa\\[-1pt]\scriptsize y acciones\\[-1pt]\scriptsize (en divisas, con riesgo)};
    \node[partida, fill=gray!5, minimum height=0.62cm] at (1.65,1.73) {\scriptsize deuda y reservas};
    \node[partida, dashed, minimum height=0.62cm] at (1.65,1.03) {\scriptsize posici\'on neta $F_a<0$};
    % pasivos
    \node[partida, fill=gray!5, minimum height=2.05cm] at (4.95,2.70) {\scriptsize deuda y dep\'ositos\\[-1pt]\scriptsize en d\'olares\\[-1pt]\scriptsize (el activo seguro del mundo)};
    \node[partida, fill=gray!20, minimum height=0.95cm] at (4.95,1.13) {\scriptsize inversi\'on directa\\[-1pt]\scriptsize y acciones};
    % reacciones
    \node[anchor=north west, align=left, text width=6.6cm] at (0,0.42) {\scriptsize si el d\'olar se deprecia, los activos valen m\'as y los pasivos no\\[-2pt]\scriptsize cambian: $F_a$ \textbf{mejora}. En una crisis global, el d\'olar se aprecia\\[-2pt]\scriptsize y caen sus activos: $F_a$ empeora y asegura al resto del mundo};
  \end{scope}
  % ================= (b) pais que se endeuda en dolares =================
  \begin{scope}[xshift=7.5cm]
    \node[font=\footnotesize\bfseries] at (3.3,4.55) {(b) Pa\'is que se endeuda en d\'olares};
    \node at (1.65,4.08) {activos};
    \node at (4.95,4.08) {pasivos};
    \draw[thick] (0,3.85) -- (6.6,3.85);
    \draw[thick] (3.3,3.85) -- (3.3,0.55);
    % activos
    \node[partida, fill=gray!5, minimum height=1.15cm] at (1.65,3.15) {\scriptsize reservas en d\'olares\\[-1pt]\scriptsize (seguras, poco rentables)};
    \node[partida, fill=gray!20, minimum height=0.55cm] at (1.65,2.25) {\scriptsize otros activos};
    \node[partida, dashed, minimum height=1.20cm] at (1.65,1.30) {\scriptsize posici\'on neta $F_b<0$};
    % pasivos
    \node[partida, fill=gray!5, minimum height=1.60cm] at (4.95,2.93) {\scriptsize deuda en d\'olares};
    \node[partida, fill=gray!20, minimum height=1.40cm] at (4.95,1.33) {\scriptsize inversi\'on directa\\[-1pt]\scriptsize y acciones};
    % reacciones
    \node[anchor=north west, align=left, text width=6.6cm] at (0,0.42) {\scriptsize si su moneda se deprecia, la deuda en d\'olares crece, medida en\\[-2pt]\scriptsize su moneda, m\'as que las reservas: $F_b$ \textbf{empeora} justo cuando\\[-2pt]\scriptsize m\'as falta le hace la financiaci\'on};
  \end{scope}
\end{tikzpicture}
