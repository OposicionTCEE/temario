% Cuerpo, bloque 2 — Absorción (2/3): con pleno empleo, desviación y reducción del gasto.
% En Yf la producción no puede crecer: cerrar el déficit solo con la depreciación exigiría llegar a E'
% (punto hueco, más allá de Yf: inflación); hace falta reducir la absorción, (S-I)0 -> (S-I)1, de E1 a E2.
% Misma geometría que b2_absorcion_desviacion y b2_absorcion_reduccion.
\begin{tikzpicture}[scale=0.8, >={Stealth[length=2.2mm]}, every node/.style={font=\footnotesize}]
  % ejes
  \draw[->] (0,-3.6) -- (0,2.8) node[left=2pt]{saldo};
  \draw[->] (0,0) -- (9.8,0) node[below=2pt, pos=0.95]{renta $Y$};
  \node[left] at (0,0) {$0$};
  % pleno empleo
  \draw[dashed, gray] (6.6,-3.4) -- (6.6,2.5);
  \node[below, gray] at (6.6,-3.4) {$Y_f$};
  % rectas
  \draw[thick] (3.0,-2.96) -- (9.0,0.64) node[right=1pt]{$(S-I)_0$};
  \draw[thick, dashed] (1.9,-2.82) -- (8.8,1.32) node[right=1pt]{$(S-I)_1$};
  \draw[thick, dashed] (1.4,2.6) -- (8.8,-1.1) node[right=1pt]{$(X-M)_1$};
  % puntos
  \fill (6.6,-0.8) circle (1.6pt);
  \node[below right=0pt and 1pt] at (6.6,-0.8) {$E_1$};
  \fill (6.6,0) circle (1.6pt);
  \node at (6.86,0.36) {$E_2$};
  \draw[fill=white] (7.327,-0.364) circle (1.8pt);
  \node at (7.3,-0.15) {$E'$};
  % caminos: el que exigiría la desviación sola (punteado) y el de la reducción
  \draw[->, thick, gray, dotted] (6.75,-0.71) -- (7.17,-0.46);
  \draw[->, very thick, gray] (6.6,-0.62) -- (6.6,-0.16);
\end{tikzpicture}
