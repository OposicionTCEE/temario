% Anexo III.4 — Los dos canales del ajuste exterior: la posicion neta cambia por el saldo
% corriente (canal comercial) y por la revalorizacion de activos y pasivos (canal financiero).
\begin{tikzpicture}[>={Stealth[length=2.4mm]}, every node/.style={font=\footnotesize}]
  % identidad
  \draw[rounded corners=3pt, thick] (4.0,4.1) rectangle (9.4,5.3);
  \node at (6.7,4.7) {$\Delta F_t \;=\; \underbrace{CC_t}_{\text{flujos}} \;+\; \underbrace{VAL_t}_{\text{revalorizaci\'on}}$};
  % canal comercial
  \draw[rounded corners=3pt, fill=gray!10] (0.2,0.9) rectangle (6.1,2.9);
  \node[align=center] at (3.15,2.35) {\textbf{canal comercial}};
  \node[align=center] at (3.15,1.6) {\scriptsize exportar m\'as de lo que se importa:\\[-2pt]\scriptsize lento, exige el ajuste real del Anexo I};
  \draw[->, thick] (3.15,2.95) -- (5.3,4.05);
  % canal financiero
  \draw[rounded corners=3pt, fill=gray!10] (7.3,0.9) rectangle (14.0,2.9);
  \node[align=center] at (10.65,2.35) {\textbf{canal financiero (valoraci\'on)}};
  \node[align=center] at (10.65,1.6) {\scriptsize rendimientos, precios de los activos y tipo de cambio\\[-2pt]\scriptsize revalorizan activos y pasivos: r\'apido y vol\'atil};
  \draw[->, thick] (10.65,2.95) -- (8.1,4.05);
\end{tikzpicture}
