% Anexo I.2 — Efectos de una devaluacion sobre el valor en divisas de exportaciones e importaciones.
% Panel (a): la oferta de exportaciones se desplaza (cada precio exterior equivale a mas moneda nacional);
% el ingreso pierde el rectangulo oscuro (precio) y gana el claro (cantidad).
% Panel (b): pais pequeno, precio mundial dado; la demanda de importaciones cae al encarecerse en moneda nacional.
\begin{tikzpicture}[>={Stealth[length=2.2mm]}, every node/.style={font=\footnotesize}]
% ---------- Panel (a): exportaciones ----------
\begin{scope}
  \node[font=\footnotesize\bfseries] at (3.2,5.55) {(a) Exportaciones, valoradas en divisas};
  % areas
  \fill[gray!45] (0,2.58) rectangle (2.86,3.06);
  \fill[gray!18] (2.86,0) rectangle (3.58,2.58);
  \draw[->] (0,0) -- (6.4,0) node[below=2pt, pos=0.9]{$X$};
  \draw[->] (0,0) -- (0,5.2) node[left=2pt]{$P^{*}$};
  \draw[thick] (0.6,4.6) -- (5.6,1.2) node[right]{$D^{*}_{X}$};
  \draw[thick] (0.8,1.0) -- (4.6,4.8) node[above right=-1pt]{$S_{X}(e_0)$};
  \draw[thick] (1.8,0.8) -- (5.8,4.8) node[right]{$S_{X}(e_1)$};
  \fill (2.86,3.06) circle (1.5pt) node[above left=0pt and 1pt]{$E_0$};
  \fill (3.58,2.58) circle (1.5pt) node[above right=0pt and 1pt]{$E_1$};
  \draw[dashed] (0,3.06) node[left]{$P^{*}_{0}$} -- (2.86,3.06) -- (2.86,0) node[below]{$X_0$};
  \draw[dashed] (0,2.58) node[left]{$P^{*}_{1}$} -- (3.58,2.58) -- (3.58,0) node[below]{$X_1$};
  \draw[->] (1.2,4.35) node[above right=-1pt]{\scriptsize p\'erdida por precio: $X_0\,\Delta P^{*}$} to[out=250,in=90] (1.4,3.1);
  \draw[->] (5.0,0.65) node[right=-1pt]{\scriptsize ganancia por cantidad: $P^{*}_{1}\,\Delta X$} to[out=180,in=-20] (3.5,1.0);
\end{scope}
% ---------- Panel (b): importaciones ----------
\begin{scope}[xshift=8.1cm]
  \node[font=\footnotesize\bfseries] at (3.2,5.55) {(b) Importaciones, valoradas en divisas};
  \fill[gray!18] (2.0,0) rectangle (3.1,2.8);
  \draw[->] (0,0) -- (6.3,0) node[below=2pt, pos=0.9]{$M$};
  \draw[->] (0,0) -- (0,5.2) node[left=2pt]{$P^{*}$};
  \draw[thick] (0.4,2.8) -- (5.7,2.8) node[above right=-1pt and -26pt]{$S^{*}_{M}$};
  \draw[thick] (0.8,5.0) -- (5.2,0.8) node[below=2pt]{$D_{M}(e_0)$};
  \draw[thick] (0.4,4.33) -- (4.1,0.8) node[below=2pt]{$D_{M}(e_1)$};
  \fill (3.1,2.8) circle (1.5pt);
  \fill (2.0,2.8) circle (1.5pt);
  \draw[dashed] (3.1,2.8) -- (3.1,0) node[below]{$M_0$};
  \draw[dashed] (2.0,2.8) -- (2.0,0) node[below]{$M_1$};
  \node[left] at (0,2.8) {$P^{*}_{M}$};
  \draw[->] (4.6,1.9) node[right=-1pt]{\scriptsize ahorro de divisas: $P^{*}_{M}\,\Delta M$} to[out=180,in=-10] (2.9,1.4);
\end{scope}
\end{tikzpicture}
