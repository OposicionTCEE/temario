% Anexo I.2 — Curva J: respuesta dinamica del saldo comercial a una devaluacion,
% con las tres etapas de MAGEE (1973): contratos en vigor, traslado a precios, ajuste de cantidades.
\begin{tikzpicture}[>={Stealth[length=2.2mm]}, every node/.style={font=\footnotesize}]
  \draw[->] (0,-2.7) -- (0,2.9) node[left=2pt]{$B$};
  \draw[->] (0,0) -- (11.4,0) node[below=2pt]{tiempo};
  \node[left] at (0,0) {$0$};
  \draw[thick] plot[smooth] coordinates {(0,0) (1,-1.05) (2.2,-1.55) (3.5,-1.1) (5.2,0) (6.8,1.1) (8.6,1.85) (10.6,2.15)};
  \fill (0,0) circle (1.5pt);
  \draw[->] (1.6,2.3) node[right]{devaluaci\'on en $t=0$} to[out=180,in=70] (0.08,0.2);
  \draw[dashed] (2.2,-2.1) -- (2.2,1.6);
  \draw[dashed] (5.2,-2.1) -- (5.2,2.2);
  \fill (5.2,0) circle (1.3pt);
  \draw[decorate,decoration={brace,mirror,amplitude=4pt}] (0.05,-2.25) -- (2.15,-2.25)
    node[midway, below=5pt, align=center]{\scriptsize contratos en vigor:\\[-2pt]\scriptsize solo act\'ua el efecto precio};
  \draw[decorate,decoration={brace,mirror,amplitude=4pt}] (2.25,-2.25) -- (5.15,-2.25)
    node[midway, below=5pt, align=center]{\scriptsize traslado a precios y\\[-2pt]\scriptsize primeras cantidades};
  \draw[decorate,decoration={brace,mirror,amplitude=4pt}] (5.25,-2.25) -- (10.6,-2.25)
    node[midway, below=5pt, align=center]{\scriptsize ajuste de cantidades: el efecto cantidad domina\\[-2pt]\scriptsize si se cumple la condici\'on de MARSHALL-LERNER};
\end{tikzpicture}
