% Anexo II.2 — Expansion monetaria (compra de bonos en mercado abierto) con tipo fijo en el
% modelo de cartera: MM y BB bajan, el nuevo equilibrio recorre la FF con un tipo menor y
% mas activos exteriores privados (salida de capital, caida de reservas): autonomia parcial.
\begin{tikzpicture}[>={Stealth[length=2.2mm]}, every node/.style={font=\footnotesize}]
  \draw[->] (0,0) -- (6.9,0) node[below=2pt, pos=0.96]{$F$};
  \draw[->] (0,0) -- (0,5.2) node[left=2pt]{$r$};
  % situacion inicial (gris)
  \draw[gray, thick] (0.5,2.6) -- (6.0,2.6) node[right]{\textcolor{gray}{$BB_0$}};
  \draw[gray, thick] (0.7,1.07) -- (5.8,4.13) node[above right=-1pt and -8pt]{\textcolor{gray}{$MM_0$}};
  % situacion nueva (negro)
  \draw[thick] (0.5,2.05) -- (6.0,2.05) node[below right=-1pt and -8pt]{$BB_1$};
  \draw[thick] (1.25,0.3) -- (5.8,3.03) node[right]{$MM_1$};
  \draw[thick] (0.7,4.13) -- (5.8,1.07) node[right]{FF};
  % equilibrios
  \fill[gray] (3.25,2.6) circle (1.6pt);
  \node[gray, above right=2pt and 2pt] at (3.25,2.6) {$E_0$};
  \fill (4.17,2.05) circle (1.7pt) node[above right=2pt and 2pt]{$E_1$};
  \draw[->, thick] (3.42,2.49) -- (4.0,2.14);
  \draw[dashed] (0,2.05) node[left]{$r_1$} -- (0.5,2.05);
  \draw[dashed] (4.17,2.05) -- (4.17,0) node[below]{$F_1$};
  \node[align=left, anchor=north west] at (0.1,-0.75) {\scriptsize 1 compra de bonos en mercado abierto: $MM$ y $BB$ bajan\\[-2pt]\scriptsize 2 de $E_0$ a $E_1$ por la FF: se compran activos exteriores y caen las reservas\\[-2pt]\scriptsize 3 con sustituibilidad imperfecta, $r$ baja: autonom\'ia monetaria parcial};
\end{tikzpicture}
