% Anexo I.5 — El modelo IS-LM-BP: equilibrio interno (IS-LM) y curva BP segun el grado
% de movilidad del capital (horizontal con movilidad perfecta; mas plana o mas empinada que LM).
\begin{tikzpicture}[>={Stealth[length=2.2mm]}, every node/.style={font=\footnotesize}]
  \draw[->] (0,0) -- (6.9,0) node[below=2pt, pos=0.93]{$Y$};
  \draw[->] (0,0) -- (0,5.4) node[left=2pt]{$i$};
  \draw[thick] (0.8,4.6) -- (5.6,0.9) node[right]{IS};
  \draw[thick] (0.9,0.8) -- (5.4,4.7) node[right]{LM};
  % BP segun movilidad
  \draw[dashed] (0.7,2.77) -- (6.1,2.77) node[right]{\scriptsize BP: $\beta\to\infty$ ($i=i^{*}$)};
  \draw[thick] (0.8,1.70) -- (5.9,4.00) node[right]{\scriptsize BP: movilidad alta};
  \draw[dash dot] (2.0,0.90) -- (4.45,4.82) node[above left=2pt and -14pt]{\scriptsize BP: movilidad baja};
  % equilibrio
  \fill (3.17,2.77) circle (1.7pt) node[above right=1pt and 2pt]{$E$};
  \draw[dashed] (0,2.77) node[left]{$i_0$} -- (3.17,2.77);
  \draw[dashed] (3.17,2.77) -- (3.17,0) node[below]{$Y_0$};
  % zonas de la BP intermedia
  \node[gray] at (1.35,3.1) {\scriptsize super\'avit};
  \node[gray] at (5.15,1.9) {\scriptsize d\'eficit};
\end{tikzpicture}
