% El sistema de paridades: cuatro magnitudes (diferencia de tipos de interés, margen a plazo, depreciación esperada y
% diferencia de inflación esperada) unidas por cinco condiciones. En cada triángulo, dos condiciones implican la tercera:
% paridad cubierta + tipo a plazo insesgado = paridad no cubierta; paridad no cubierta + paridad en expectativas = paridad
% de los tipos reales (FISHER internacional). Logaritmos; lambda = prima de riesgo cambiaria. Figura abstracta.
% Compilar con: bash Code/generar_figura.sh anx_paridades
\begin{tikzpicture}[font=\footnotesize,
    caja/.style={draw=black!70, rounded corners=2pt, align=center, text width=3.9cm, minimum height=1.25cm, inner sep=3pt},
    lado/.style={black!70, line width=0.8pt},
    rot/.style={font=\scriptsize, align=center, fill=white, inner sep=1.5pt}]
  \node[caja] (A) at (0,3.6) {Diferencia de tipos de interés\\[2pt] $i_t-i_t^*$};
  \node[caja] (B) at (8.4,3.6) {Margen a plazo\\[2pt] $f_t-s_t$};
  \node[caja] (C) at (8.4,0) {Depreciación esperada\\[2pt] $\mathbb{E}_t[\Delta s_{t+1}]$};
  \node[caja] (D) at (0,0) {Diferencia de inflación esperada\\[2pt] $\mathbb{E}_t[\pi_{t+1}]-\mathbb{E}_t[\pi_{t+1}^*]$};
  \draw[lado] (A) -- node[rot, above=2pt] {Paridad cubierta: arbitraje} (B);
  \draw[lado] (B) -- node[rot, right=3pt] {Tipo a plazo\\insesgado:\\$\lambda_t=0$} (C);
  \draw[lado] (A) -- node[rot, sloped] {Paridad no cubierta} (C);
  \draw[lado] (D) -- node[rot, below=2pt] {Paridad en expectativas: $\mathbb{E}_t[\Delta q_{t+1}]=0$} (C);
  \draw[lado] (A) -- node[rot, left=3pt] {FISHER\\internacional:\\$r_t=r_t^*$} (D);
\end{tikzpicture}
