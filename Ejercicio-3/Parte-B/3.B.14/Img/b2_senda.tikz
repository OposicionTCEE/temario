% Cuerpo, bloque 2 (T15, 08/11/2026): la senda, segundo término de la identidad. Arriba, la diferencia de tipos de interés reales
% que se espera tras una subida de los tipos europeos en t0, que se reduce poco a poco; abajo, el tipo real, que se aprecia de
% golpe por la suma de todas las diferencias esperadas y después se deprecia cada periodo en la diferencia de ese periodo hasta
% volver al ancla. Versión del cuerpo, sin fórmulas ni anotaciones, de anx_senda (anexo II), con el estilo de b1_senda.
% Hecha a mano; compilar con: bash Code/generar_figura.sh b2_senda
\begin{tikzpicture}
\footnotesize
\begin{axis}[name=pa,
  scale only axis, width=11cm, height=2.2cm, axis lines=left, tick style={draw=none},
  every axis label/.style={font=\footnotesize}, tick label style={font=\footnotesize}, title style={font=\footnotesize\bfseries},
  xmin=0, xmax=100, ymin=-0.3, ymax=3.3, clip=false,
  xtick={20}, xticklabels={$t_0$}, ytick={0}, yticklabels={$0$},
  title={Diferencia de tipos de interés reales, $r-r^*$},
]
\draw[black, line width=1pt] (axis cs:0,0) -- (axis cs:20,0);
\addplot[black, line width=1pt, domain=20:100, samples=100] {3*exp(-(x-20)/18)};
\draw[black!40, dotted] (axis cs:20,0) -- (axis cs:20,3);
\end{axis}
\begin{axis}[at={(pa.south west)}, anchor=north west, yshift=-1.2cm,
  scale only axis, width=11cm, height=3.4cm, axis lines=left, tick style={draw=none},
  every axis label/.style={font=\footnotesize}, tick label style={font=\footnotesize}, title style={font=\footnotesize\bfseries},
  xmin=0, xmax=100, ymin=-6.5, ymax=1.2, clip=false,
  xtick={20}, xticklabels={$t_0$}, ytick={0}, yticklabels={$\bar q$},
  title={Tipo de cambio real, $q$}, xlabel={Tiempo},
]
\draw[black!60, densely dashed] (axis cs:0,0) -- (axis cs:100,0);
\draw[black, line width=1pt] (axis cs:0,0) -- (axis cs:20,0) -- (axis cs:20,-5.4);
\addplot[black, line width=1pt, domain=20:100, samples=100] {-5.4*exp(-(x-20)/18)};
\draw[decorate, decoration={brace, amplitude=4pt, mirror}, black!70] (axis cs:17,0) -- (axis cs:17,-5.4) node[midway, anchor=east, xshift=-0.15cm, align=right] {suma de las\\diferencias\\esperadas};
\end{axis}
\end{tikzpicture}
