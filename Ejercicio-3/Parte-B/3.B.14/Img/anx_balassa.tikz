% El mecanismo de BALASSA (1964) y SAMUELSON (1964) en cadena: la productividad de los comerciables sube el salario, el
% salario sube el precio de los no comerciables, este sube el nivel de precios y, con el precio único en los comerciables,
% el tipo real se aprecia. Caso con el trabajo como único factor. Delta = variación de los logaritmos; w = ln W, el
% salario; zeta = cuota de los no comerciables en la cesta; exterior constante.
% Figura abstracta, sin cifras. Compilar con: bash Code/generar_figura.sh anx_balassa
\begin{tikzpicture}[font=\footnotesize,
    caja/.style={draw=black!70, rounded corners=2pt, align=center, minimum height=1.35cm, text width=3.8cm, inner sep=3pt},
    flecha/.style={-{Stealth[length=2mm]}, black!70, line width=0.7pt},
    paso/.style={font=\scriptsize, black!60, align=center}]
  \node[caja] (a) at (0,0) {Productividad de los\\ comerciables\\[2pt] $\Delta z^T>\Delta z^N$};
  \node[caja] (b) at (5.4,0) {Salario, el mismo\\ en los dos sectores\\[2pt] $\Delta w=\Delta p^T+\Delta z^T$};
  \node[caja] (c) at (10.8,0) {Precio de los\\ no comerciables\\[2pt] $\Delta p^N=\Delta w-\Delta z^N$};
  \node[caja] (d) at (10.8,-2.6) {Nivel de precios\\[2pt] $\Delta p=\Delta p^T+\zeta\left(\Delta p^N-\Delta p^T\right)$};
  \node[caja] (e) at (5.4,-2.6) {Tipo real\\[2pt] $\Delta q=-\zeta\left(\Delta z^T-\Delta z^N\right)<0$};
  \node[caja, draw=none] (f) at (0,-2.6) {Apreciación real\\ de equilibrio};
  \draw[flecha] (a) -- node[paso, above] {competencia} (b);
  \draw[flecha] (b) -- node[paso, above] {trabajo móvil} (c);
  \draw[flecha] (c) -- node[paso, right] {cesta de consumo} (d);
  \draw[flecha] (d) -- node[paso, above] {precio único\\ en $T$} (e);
  \draw[flecha] (e) -- (f);
\end{tikzpicture}
