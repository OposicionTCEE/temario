% El mecanismo de BALASSA (1964) y SAMUELSON (1964) en cadena: la productividad de los comerciables sube el salario, el
% salario sube el precio de los no comerciables, este sube el nivel de precios y, con el precio único en los comerciables,
% el tipo real se aprecia. Acento = tasa de variación; zeta = cuota de los no comerciables en la cesta; exterior constante.
% Figura abstracta, sin cifras. Compilar con: bash Code/generar_figura.sh anx_balassa
\begin{tikzpicture}[font=\footnotesize,
    caja/.style={draw=black!70, rounded corners=2pt, align=center, minimum height=1.35cm, text width=3.55cm, inner sep=3pt},
    flecha/.style={-{Stealth[length=2mm]}, black!70, line width=0.7pt},
    paso/.style={font=\scriptsize, black!60, align=center}]
  \node[caja] (a) at (0,0) {Productividad de los\\ comerciables\\[2pt] $\hat z^T>\hat z^N$};
  \node[caja] (b) at (5.2,0) {Salario, el mismo\\ en los dos sectores\\[2pt] $\hat w=\hat p^T+\hat z^T$};
  \node[caja] (c) at (10.4,0) {Precio de los\\ no comerciables\\[2pt] $\hat p^N=\hat w-\hat z^N$};
  \node[caja] (d) at (10.4,-2.6) {Nivel de precios\\[2pt] $\hat p=\hat p^T+\zeta\left(\hat p^N-\hat p^T\right)$};
  \node[caja] (e) at (5.2,-2.6) {Tipo real\\[2pt] $\hat q=-\zeta\left(\hat z^T-\hat z^N\right)<0$};
  \node[caja, draw=none, text width=3.55cm] (f) at (0,-2.6) {Apreciación real\\ de equilibrio};
  \draw[flecha] (a) -- node[paso, above] {competencia} (b);
  \draw[flecha] (b) -- node[paso, above] {trabajo móvil} (c);
  \draw[flecha] (c) -- node[paso, right] {cesta de consumo} (d);
  \draw[flecha] (d) -- node[paso, above] {precio único en $T$} (e);
  \draw[flecha] (e) -- (f);
\end{tikzpicture}
