% Prima con intermediarios de capacidad limitada (GABAIX y MAGGIORI, 2015): los intermediarios solo absorben una posición
% neta en euros N si la prima de los activos en euros la compensa, lambda = Gamma N. Con Gamma = 0 se cumple la paridad no
% cubierta; con Gamma bajo (capital abundante) una misma posición exige poca prima, y con Gamma alto (crisis), mucha.
% Rectas: lambda = 0,3 N y lambda = 0,7 N; posición N_0 = 4,5. Figura abstracta.
% Compilar con: bash Code/generar_figura.sh anx_gabaix_maggiori
\begin{tikzpicture}[font=\footnotesize, x=1cm, y=1cm]
  \draw[-{Stealth[length=1.8mm]}] (0,0) -- (7.4,0) node[below left, align=right] {$N$};
  \draw[-{Stealth[length=1.8mm]}] (0,0) -- (0,4.9) node[left] {$\lambda$};
  % Gamma = 0
  \draw[black!50, line width=1pt] (0,0.02) -- (6.6,0.02);
  \node[anchor=south east, font=\scriptsize, black!70, inner sep=2pt] at (6.6,0.02) {$\Gamma=0$: paridad no cubierta};
  % Gamma bajo y Gamma alto
  \draw[black, line width=1pt] (0,0) -- (6.6,1.98) node[right, align=left, font=\scriptsize] {$\Gamma$ bajo: intermediarios\\con capital abundante};
  \draw[black, line width=1pt] (0,0) -- (6.3,4.41) node[right, align=left, font=\scriptsize] {$\Gamma$ alto: intermediarios\\con poco capital (crisis)};
  % posición N_0
  \draw[black!40, densely dotted] (4.5,0) -- (4.5,3.15);
  \draw[black!40, densely dotted] (4.5,1.35) -- (0,1.35);
  \draw[black!40, densely dotted] (4.5,3.15) -- (0,3.15);
  \node[below] at (4.5,0) {$N_0$};
  \node[left] at (0,1.35) {$\lambda_{\mathrm{bajo}}$};
  \node[left] at (0,3.15) {$\lambda_{\mathrm{alto}}$};
  \fill (4.5,1.35) circle (1.5pt);
  \fill (4.5,3.15) circle (1.5pt);
\end{tikzpicture}
