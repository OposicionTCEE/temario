% Cuerpo, bloque 1 (notas del usuario, tanda 2, 09/11/2026): la moneda de facturación decide cómo llega una depreciación del euro
% (en t0) a los precios, sobre la base de las sendas tras una perturbación. Izquierda: precio en euros de las importaciones; derecha:
% precio de las exportaciones europeas para el comprador extranjero. Con precios en la moneda del exportador, las importaciones se
% encarecen y las exportaciones se abaratan de inmediato; en la moneda del comprador, nada cambia hasta que se revisan los precios;
% en dólares, las importaciones se encarecen como en el primer caso y las exportaciones no se abaratan, como en el segundo.
% Sendas ilustrativas, sin datos. Hecha a mano; compilar con: bash Code/generar_figura.sh b1_facturacion
\begin{tikzpicture}
\footnotesize
\begin{axis}[name=pa,
  scale only axis, width=6.2cm, height=2.9cm, axis lines=left, tick style={draw=none},
  every axis label/.style={font=\footnotesize}, tick label style={font=\footnotesize}, title style={font=\footnotesize\bfseries},
  xmin=0, xmax=100, ymin=-2, ymax=13.5, clip=false, xtick={20}, xticklabels={$t_0$}, ytick=\empty,
  title={Precio de las importaciones en euros}, xlabel={Tiempo},
]
\draw[black!40, dotted] (axis cs:20,-2) -- (axis cs:20,13.5);
\draw[black, line width=1pt] (axis cs:0,0) -- (axis cs:20,0) -- (axis cs:20,10) -- (axis cs:100,10);
\draw[black!50, line width=1pt, densely dashed] (axis cs:0,0) -- (axis cs:35,0);
\addplot[black!50, line width=1pt, densely dashed, domain=35:100, samples=80] {10*(1-exp(-(x-35)/18))};
\node[anchor=south, font=\footnotesize, align=center] at (axis cs:60,10.2) {En la moneda del exportador o en dólares};
\node[anchor=north west, font=\footnotesize, text=black!70] at (axis cs:36,3.0) {En la moneda del comprador};
\end{axis}
\begin{axis}[at={(pa.south east)}, anchor=south west, xshift=1.0cm,
  scale only axis, width=6.2cm, height=2.9cm, axis lines=left, tick style={draw=none},
  every axis label/.style={font=\footnotesize}, tick label style={font=\footnotesize}, title style={font=\footnotesize\bfseries},
  xmin=0, xmax=100, ymin=-13.5, ymax=2, clip=false, xtick={20}, xticklabels={$t_0$}, ytick=\empty,
  title={Precio de las exportaciones para el comprador extranjero}, xlabel={Tiempo},
]
\draw[black!40, dotted] (axis cs:20,-13.5) -- (axis cs:20,2);
\draw[black, line width=1pt] (axis cs:0,0) -- (axis cs:20,0) -- (axis cs:20,-10) -- (axis cs:100,-10);
\draw[black!50, line width=1pt, densely dashed] (axis cs:0,0) -- (axis cs:35,0);
\addplot[black!50, line width=1pt, densely dashed, domain=35:100, samples=80] {-10*(1-exp(-(x-35)/18))};
\node[anchor=north, font=\footnotesize] at (axis cs:60,-10.2) {En la moneda del exportador};
\node[anchor=south west, font=\footnotesize, text=black!70, align=left] at (axis cs:36,-3.0) {En la moneda del comprador\\o en dólares};
\end{axis}
\end{tikzpicture}
