% Cuerpo, bloque 1 (notas del usuario, tanda 3, 09/11/2026): construcción canónica de BALASSA y SAMUELSON con el trabajo como único
% factor. El precio de los comerciables es el mismo en los dos países (P^T = 1), así que el salario de cada uno lo fija la
% productividad de sus comerciables, W = Z^T; el precio de los servicios es el salario dividido por su productividad, P^N = W/Z^N,
% la misma recta en los dos países. El país rico, con más salario, tiene servicios más caros. Valores ilustrativos.
% Hecha a mano; compilar con: bash Code/generar_figura.sh b1_bs_salario
\begin{tikzpicture}[font=\footnotesize, x=1cm, y=1cm]
\draw[-{Stealth[length=1.8mm]}] (0,0) -- (8.6,0) node[anchor=north east, yshift=-0.55cm] {Salario, $W$};
\draw[-{Stealth[length=1.8mm]}] (0,0) -- (0,4.6) node[anchor=south west] {Precios};
\draw[black!60, densely dashed] (0,2) -- (8.2,2) node[anchor=west, black] {$P^T=1$ en los dos países};
\draw[black, line width=1pt] (0,0) -- (8.2,4.1) node[anchor=west] {$P^N=W/Z^N$};
\draw[black!45, dotted] (2.8,0) -- (2.8,1.4) -- (0,1.4) node[anchor=east, black] {$P^N_{\mathrm{pobre}}$};
\draw[black!45, dotted] (6.4,0) -- (6.4,3.2) -- (0,3.2) node[anchor=east, black] {$P^N_{\mathrm{rico}}$};
\node[anchor=north] at (2.8,0) {$W_{\mathrm{pobre}}=Z^T_{\mathrm{pobre}}$};
\node[anchor=north] at (6.4,0) {$W_{\mathrm{rico}}=Z^T_{\mathrm{rico}}$};
\node[anchor=east] at (0,2) {$1$};
\fill (2.8,1.4) circle (1.8pt);
\fill (6.4,3.2) circle (1.8pt);
\end{tikzpicture}
