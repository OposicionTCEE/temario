% Equilibrio a corto plazo del modelo de cartera con tipo de cambio flexible (BRANSON y HENDERSON, 1985), en el plano
% tipo de interés nacional (i) y tipo de cambio (S, euros por dólar). MM: dinero (pendiente positiva: una depreciación
% aumenta la riqueza y la demanda de dinero, y hace falta un tipo de interés mayor); DD: bonos en euros (pendiente negativa
% y grande); D*D*: bonos en dólares (pendiente negativa y menor). Las tres se cortan en E (ley de WALRAS).
% Figura abstracta. Compilar con: bash Code/generar_figura.sh anx_cartera
\begin{tikzpicture}[font=\footnotesize, x=1cm, y=1cm]
  \draw[-{Stealth[length=1.8mm]}] (0,0) -- (7.6,0) node[below left] {$i$};
  \draw[-{Stealth[length=1.8mm]}] (0,0) -- (0,5.4) node[left] {$S$};
  % equilibrio
  \draw[black!35, densely dotted] (3.6,0) -- (3.6,2.7) -- (0,2.7);
  \node[below] at (3.6,0) {$i_0$};
  \node[left] at (0,2.7) {$S_0$};
  % MM: dinero
  \draw[black, line width=1pt] (0.8,1.02) -- (6.8,4.62) node[right] {$MM$: dinero};
  % DD: bonos en euros
  \draw[black, line width=1pt] (2.55,5.01) -- (4.65,0.39) node[right, inner sep=3pt] {$DD$: bonos en euros};
  % D*D*: bonos en dólares
  \draw[black, line width=1pt] (0.5,3.94) -- (7.0,1.34) node[right] {$D^*D^*$: bonos en dólares};
  \fill (3.6,2.7) circle (1.6pt);
  \node[above right, inner sep=3pt] at (3.6,2.7) {$E$};
\end{tikzpicture}
