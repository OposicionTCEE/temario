% Dinámica del modelo de cartera con cuenta corriente (versión simplificada propia, en la línea de KOURI, 1976, y de
% DORNBUSCH y FISCHER, 1980): en t = 0 los residentes pasan a desear 10 puntos del PIB más de activos exteriores.
% Modelo anual: E_t[dq_{t+1}] = gamma (a_t - a_deseada); a_{t+1} - a_t = r a_t + xi (q_t - q_tilde), con gamma = 0,05,
% xi = 0,2 y r = 0,02. Senda de silla con raíz estable mu = [2 + r - sqrt(r^2 + 4 gamma xi)]/2 = 0,9095. El tipo real salta
% 5,52 por encima de su nuevo nivel de largo plazo, que es 1 punto más apreciado que el inicial (más renta de los activos
% exteriores): q_t = -1 + 5,52 mu^t (+4,52 en t = 0); la posición exterior sube 10 (1 - mu^t). Figura abstracta (fórmulas).
% Compilar con: bash Code/generar_figura.sh anx_cartera_dinamica
\begin{tikzpicture}
\footnotesize
\begin{axis}[name=pa,
  scale only axis, width=6.0cm, height=4.3cm, axis lines=left, tick align=outside, tick style={black!60},
  /pgf/number format/.cd, use comma, 1000 sep={}, /pgfplots/.cd,
  every axis label/.style={font=\footnotesize}, tick label style={font=\footnotesize}, title style={font=\footnotesize},
  xmin=-3, xmax=30, ymin=-2, ymax=5.5, xtick={0,5,...,30}, ytick={-1,0,...,5}, clip=false,
  xlabel={Años}, ylabel={Diferencia con el nivel inicial (\%)}, title={(a) Tipo de cambio real},
]
  \draw[black!45, densely dashed] (axis cs:-3,0) -- (axis cs:30,0);
  \draw[black!45, densely dotted] (axis cs:0,-1) -- (axis cs:30,-1);
  \node[font=\scriptsize, black!70, anchor=south east, inner sep=2pt] at (axis cs:30,-1) {nuevo nivel a largo plazo};
  \addplot[black, line width=1.2pt] coordinates {(-3,0) (0,0)};
  \draw[black, line width=1.2pt] (axis cs:0,0) -- (axis cs:0,4.525);
  \addplot[black, line width=1.2pt, domain=0:30, samples=120] {-1 + 5.525*0.9095^x};
  \node[font=\scriptsize, anchor=west, inner sep=3pt] at (axis cs:0,4.525) {$+4{,}5$};
\end{axis}
\begin{axis}[at={(pa.east)}, anchor=west, xshift=1.6cm,
  scale only axis, width=6.0cm, height=4.3cm, axis lines=left, tick align=outside, tick style={black!60},
  /pgf/number format/.cd, use comma, 1000 sep={}, /pgfplots/.cd,
  every axis label/.style={font=\footnotesize}, tick label style={font=\footnotesize}, title style={font=\footnotesize},
  xmin=-3, xmax=30, ymin=0, ymax=12, xtick={0,5,...,30}, ytick={0,2,...,12}, clip=false,
  xlabel={Años}, ylabel={Variación (puntos del PIB)}, title={(b) Posición exterior neta},
]
  \draw[black!45, densely dotted] (axis cs:0,10) -- (axis cs:30,10);
  \node[font=\scriptsize, black!70, anchor=south east, inner sep=2pt] at (axis cs:30,10) {posición deseada};
  \addplot[black, line width=1.2pt] coordinates {(-3,0) (0,0)};
  \addplot[black, line width=1.2pt, domain=0:30, samples=120] {10*(1 - 0.9095^x)};
\end{axis}
\end{tikzpicture}
