% Cuerpo, bloque 1, 2.3.3 (notas del usuario, tanda 4, 09/11/2026): el cálculo del tipo de cambio de equilibrio fundamental
% (FEER) en tres pasos, sobre la base de b1_equilibrio_externo, ahora con la cuenta corriente. Paso 1: la cuenta corriente
% subyacente, el punto de la curva en el tipo real actual, q, limpio del ciclo. Paso 2: la norma, la cuenta corriente sostenible
% (línea discontinua, la de las figuras anteriores). Paso 3: la brecha vertical entre las dos, dividida por la pendiente de la
% curva, da el desalineamiento, la distancia horizontal hasta el ancla, \bar q. La cuenta corriente subyacente queda por debajo de
% la norma: la moneda está sobrevalorada (q < \bar q). Hecha a mano; compilar con: bash Code/generar_figura.sh b1_feer
\begin{tikzpicture}
\footnotesize
\begin{axis}[
  scale only axis, width=9.5cm, height=5cm, axis lines=middle, tick style={draw=none},
  every axis label/.style={font=\footnotesize}, tick label style={font=\footnotesize},
  xmin=0, xmax=10.4, ymin=-3.4, ymax=3.6, clip=false, xtick=\empty, ytick=\empty,
]
\addplot[black, line width=1pt, domain=0.5:9.6, samples=120] {3*tanh((x-5)/2.5)};
\draw[black!60, densely dashed] (axis cs:0,1.1) -- (axis cs:10.4,1.1) node[anchor=west, black, align=left] {2. Norma: la cuenta\\corriente sostenible};
\draw[{Stealth[length=1.4mm]}-{Stealth[length=1.4mm]}, black] (axis cs:3.6,-1.45) -- (axis cs:3.6,1.03);
\draw[black!40, dotted] (axis cs:3.6,1.1) -- (axis cs:3.6,1.5);
\draw[black!40, dotted] (axis cs:5.961,1.1) -- (axis cs:5.961,1.5);
\draw[{Stealth[length=1.4mm]}-{Stealth[length=1.4mm]}, black] (axis cs:3.62,1.45) -- (axis cs:5.94,1.45);
\node[anchor=east, align=right] at (axis cs:3.5,0.55) {Brecha de la\\cuenta corriente};
\node[anchor=south, align=center] at (axis cs:4.4,1.5) {3. Desalineamiento:\\brecha entre pendiente};
\node[anchor=south east, align=right] at (axis cs:3.5,-1.4) {1. Cuenta corriente\\subyacente};
\draw[black!40, dotted] (axis cs:3.6,-1.524) -- (axis cs:3.6,-3.4) node[anchor=north, black] {$q$};
\draw[black!40, dotted] (axis cs:5.961,1.1) -- (axis cs:5.961,-3.4) node[anchor=north, black] {$\bar q$};
\fill[black] (axis cs:3.6,-1.524) circle (1.6pt);
\fill[black] (axis cs:5.961,1.1) circle (1.6pt);
\node[anchor=south west] at (axis cs:0,3.6) {Cuenta corriente};
\node[anchor=north east] at (axis cs:10.4,-0.15) {Tipo de cambio real, $q$};
\end{axis}
\end{tikzpicture}
