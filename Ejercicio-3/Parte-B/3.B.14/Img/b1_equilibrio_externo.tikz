% Cuerpo, bloque 1 (T14, 08/11/2026): el tipo real que sostiene la posición exterior. Las exportaciones netas crecen con el tipo
% real (sube = depreciación); el deudor necesita un superávit para pagar los rendimientos de su deuda y el acreedor puede financiar
% un déficit con los de sus activos, de modo que el deudor necesita un tipo real más depreciado. Versión del cuerpo, con rótulos en
% palabras, de anx_equilibrio_externo (anexo I). Hecha a mano; compilar con: bash Code/generar_figura.sh b1_equilibrio_externo
\begin{tikzpicture}
\footnotesize
\begin{axis}[
  scale only axis, width=9.5cm, height=5cm, axis lines=middle, tick style={draw=none},
  every axis label/.style={font=\footnotesize}, tick label style={font=\footnotesize},
  xmin=0, xmax=10.4, ymin=-3.4, ymax=3.6, clip=false,
  xtick={3.267,5,6.733}, xticklabels={$\bar q_A$,$\bar q_0$,$\bar q_D$}, ytick=\empty,
  x tick label style={yshift=-1.05cm},
  xlabel={Tipo de cambio real, $q$}, ylabel={Exportaciones netas},
  xlabel style={at={(axis description cs:1,0.5)}, anchor=north east, yshift=-0.1cm},
  ylabel style={at={(axis description cs:0,1)}, anchor=south west, rotate=-90, xshift=-0.1cm},
]
\addplot[black, line width=1pt, domain=0.5:9.6, samples=120] {3*tanh((x-5)/2.5)};
\draw[black!60, densely dashed] (axis cs:0,1.8) -- (axis cs:10.4,1.8) node[anchor=west, font=\footnotesize, black, align=left] {Superávit que\\necesita un deudor};
\draw[black!60, densely dashed] (axis cs:0,-1.8) -- (axis cs:10.4,-1.8) node[anchor=west, font=\footnotesize, black, align=left] {Déficit que puede\\financiar un acreedor};
\draw[black!40, dotted] (axis cs:6.733,1.8) -- (axis cs:6.733,-3.4);
\draw[black!40, dotted] (axis cs:3.267,-1.8) -- (axis cs:3.267,-3.4);
\draw[black!40, dotted] (axis cs:5,0) -- (axis cs:5,-3.4);
\fill[black] (axis cs:6.733,1.8) circle (1.6pt);
\fill[black] (axis cs:3.267,-1.8) circle (1.6pt);
\fill[white, draw=black] (axis cs:5,0) circle (1.6pt);
\end{axis}
\end{tikzpicture}
