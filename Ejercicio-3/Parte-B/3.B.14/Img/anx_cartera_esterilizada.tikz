% Intervención esterilizada en el modelo de cartera con tipo flexible: el banco central compra bonos en dólares y vende
% bonos en euros por el mismo importe, de modo que el dinero no cambia. El público tiene más bonos en euros (DD se desplaza
% a la derecha: hace falta un tipo de interés mayor para que los acepte) y menos bonos en dólares (D*D* se desplaza hacia
% arriba). MM no se mueve, porque ni el dinero ni la riqueza cambian al tipo de cambio inicial. El nuevo equilibrio E' está
% sobre MM, con más tipo de interés y un euro más depreciado. Figura abstracta.
% Compilar con: bash Code/generar_figura.sh anx_cartera_esterilizada
\begin{tikzpicture}[font=\footnotesize, x=1cm, y=1cm]
  \draw[-{Stealth[length=1.8mm]}] (0,0) -- (7.6,0) node[below left] {$i$};
  \draw[-{Stealth[length=1.8mm]}] (0,0) -- (0,5.4) node[left] {$S$};
  % proyecciones
  \draw[black!35, densely dotted] (3.6,0) -- (3.6,2.7) -- (0,2.7);
  \draw[black!35, densely dotted] (4.5,0) -- (4.5,3.24) -- (0,3.24);
  \node[below] at (3.6,0) {$i_0$};
  \node[below] at (4.5,0) {$i_1$};
  \node[left] at (0,2.7) {$S_0$};
  \node[left] at (0,3.24) {$S_1$};
  % curvas iniciales
  \draw[black!35, line width=1pt] (2.55,5.01) -- (4.65,0.39) node[below, inner sep=2pt] {$DD$};
  \draw[black!35, line width=1pt] (0.5,3.94) -- (7.0,1.34) node[right, black!50] {$D^*D^*$};
  % MM no se mueve
  \draw[black, line width=1pt] (0.8,1.02) -- (6.8,4.62) node[right] {$MM$};
  % curvas tras la intervención
  \draw[black, line width=1pt, densely dashed] (3.61,5.2) -- (5.79,0.4) node[right, inner sep=3pt] {$DD'$};
  \draw[black, line width=1pt, densely dashed] (0.5,4.84) -- (7.0,2.24) node[right] {$D^*D^{*\prime}$};
  % desplazamientos
  \draw[black!60, -{Stealth[length=1.6mm]}] (4.36,1.2) -- (5.33,1.2);
  \draw[black!60, -{Stealth[length=1.6mm]}] (1.2,3.74) -- (1.2,4.48);
  % equilibrios
  \fill (3.6,2.7) circle (1.6pt);
  \node[below right, inner sep=3pt] at (3.6,2.7) {$E$};
  \fill (4.5,3.24) circle (1.6pt);
  \node[above, inner sep=4pt, xshift=4pt] at (4.5,3.24) {$E'$};
\end{tikzpicture}
