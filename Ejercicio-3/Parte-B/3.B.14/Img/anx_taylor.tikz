% Respuesta del tipo de cambio a una sorpresa de inflación (de una unidad en el periodo 0, que se reduce al 80 % cada
% periodo) con dos bancos centrales: uno que mantiene el tipo de interés nominal (discontinua) y otro que sigue una regla de
% TAYLOR (1993) con phi_pi = 0,5 (continua). Prima nula, exterior constante. Con el tipo fijo, el tipo de cambio salta a su
% nivel de largo plazo, la subida total de los precios, 1/(1 - 0,8) = 5, y el tipo real se deprecia; con la regla, el tipo real
% de interés sube en (1 + phi_pi - rho) pi, el tipo real se aprecia en 3,5 rho^t y el nominal cae a -2,5 antes de subir a 5:
% s_t = 5 - 7,5 rho^t. Figura abstracta (simulación con fórmulas). Compilar con: bash Code/generar_figura.sh anx_taylor
\begin{tikzpicture}[font=\footnotesize, x=1cm, y=1cm]
  % (a) tipo de cambio nominal
  \begin{scope}
    \node[anchor=south] at (3.3,2.75) {(a) Tipo de cambio nominal};
    \draw[-{Stealth[length=1.8mm]}] (0,0) -- (6.6,0) node[below left] {$t$};
    \draw[-{Stealth[length=1.8mm]}] (0,-1.2) -- (0,2.6) node[left] {$s$};
    \node[left] at (0,0) {$0$};
    \draw[black!35, densely dotted] (0.8,-1.2) -- (0.8,2.4);
    \node[below] at (0.8,-1.2) {$t_0$};
    \draw[black!40, densely dotted] (0.8,2.0) -- (6.2,2.0);
    % banco central que no mueve el tipo de interés: salta a 5 (escala 0,4)
    \draw[black!55, densely dashed, line width=1pt] (0.05,0) -- (0.8,0) -- (0.8,2.0) -- (6.2,2.0);
    % regla de TAYLOR: s = 5 - 7,5 rho^t, con t en periodos de 0,45 cm
    \draw[black, line width=1pt] (0.05,0) -- (0.8,0) -- (0.8,-1.0);
    \draw[black, line width=1pt] plot[smooth, domain=0:12] ({0.8+0.45*\x}, {0.4*(5-7.5*0.8^\x)});
    \node[anchor=south west, inner sep=2pt, black!70] at (3.6,2.0) {tipo de interés fijo};
    \node[anchor=north west, inner sep=2pt] at (2.6,0.75) {regla de TAYLOR};
  \end{scope}
  % (b) tipo de cambio real
  \begin{scope}[xshift=7.6cm]
    \node[anchor=south] at (3.3,2.75) {(b) Tipo de cambio real};
    \draw[-{Stealth[length=1.8mm]}] (0,0) -- (6.6,0) node[below left] {$t$};
    \draw[-{Stealth[length=1.8mm]}] (0,-1.6) -- (0,2.6) node[left] {$q$};
    \node[left] at (0,0) {$\bar q$};
    \draw[black!35, densely dotted] (0.8,-1.6) -- (0.8,2.4);
    \node[below] at (0.8,-1.6) {$t_0$};
    % tipo fijo: q = rho^{t+1}/(1-rho) = 5 rho^{t+1}
    \draw[black!55, densely dashed, line width=1pt] (0.05,0) -- (0.8,0) -- (0.8,1.6);
    \draw[black!55, densely dashed, line width=1pt] plot[smooth, domain=0:12] ({0.8+0.45*\x}, {0.4*5*0.8^(\x+1)});
    % regla de TAYLOR: q = -3,5 rho^t
    \draw[black, line width=1pt] (0.05,0) -- (0.8,0) -- (0.8,-1.4);
    \draw[black, line width=1pt] plot[smooth, domain=0:12] ({0.8+0.45*\x}, {-0.4*3.5*0.8^\x});
  \end{scope}
\end{tikzpicture}
