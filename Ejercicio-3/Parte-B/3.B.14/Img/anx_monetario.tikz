% Modelo monetario con precios flexibles: respuesta del tipo de cambio, s (continua), a tres perturbaciones del dinero
% relativo, m (discontinua), en logaritmos. (a) Aumento permanente no anticipado en t_0: s sube en t_0 lo mismo que m.
% (b) Aumento anunciado en t_0 para t_1: s sube en t_0 y sigue subiendo hasta t_1, cuando m aumenta, sin saltar entonces.
% (c) Más crecimiento del dinero desde t_0: s salta en t_0 por encima de m (efecto de las expectativas de inflación) y
% crece después al nuevo ritmo. Figura abstracta, sin cifras. Compilar con: bash Code/generar_figura.sh anx_monetario
\begin{tikzpicture}[font=\footnotesize, x=1cm, y=1cm]
  \foreach \dx/\tit in {0/{(a) Aumento por sorpresa}, 5.2/{(b) Aumento anunciado}, 10.4/{(c) Más crecimiento del dinero}} {
    \begin{scope}[xshift=\dx cm]
      \draw[-{Stealth[length=1.8mm]}] (0,0) -- (4.5,0) node[below left] {$t$};
      \draw[-{Stealth[length=1.8mm]}] (0,0) -- (0,3.1);
      \draw[black!35, densely dotted] (1.4,0) -- (1.4,2.9);
      \node[below] at (1.4,0) {$t_0$};
      \node[anchor=south] at (2.2,3.2) {\tit};
    \end{scope}
  }
  % (a) aumento permanente no anticipado
  \draw[black!55, densely dashed, line width=0.9pt] (0.05,1.2) -- (1.4,1.2) -- (1.4,2.4) -- (4.2,2.4) node[right] {$m$};
  \draw[black, line width=1pt] (0.05,0.6) -- (1.4,0.6) -- (1.4,1.8) -- (4.2,1.8) node[right] {$s$};
  % (b) aumento anunciado en t_0 que se aplica en t_1
  \begin{scope}[xshift=5.2cm]
    \draw[black!35, densely dotted] (3.0,0) -- (3.0,2.9);
    \node[below] at (3.0,0) {$t_1$};
    \draw[black!55, densely dashed, line width=0.9pt] (0.05,1.2) -- (3.0,1.2) -- (3.0,2.4) -- (4.2,2.4) node[right] {$m$};
    \draw[black, line width=1pt] (0.05,0.6) -- (1.4,0.6) -- (1.4,{0.6+1.2*exp(-1.6/0.9)});
    \draw[black, line width=1pt] plot[smooth, domain=1.4:3.0] (\x, {0.6+1.2*exp(-(3.0-\x)/0.9)});
    \draw[black, line width=1pt] (3.0,1.8) -- (4.2,1.8) node[right] {$s$};
  \end{scope}
  % (c) aumento del ritmo de crecimiento del dinero desde t_0
  \begin{scope}[xshift=10.4cm]
    \draw[black!55, densely dashed, line width=0.9pt] (0.05,1.0) -- (1.4,1.27) -- (4.2,2.39) node[right] {$m$};
    \draw[black, line width=1pt] (0.05,0.5) -- (1.4,0.77) -- (1.4,1.22) -- (4.2,2.34) node[right] {$s$};
  \end{scope}
\end{tikzpicture}
