% Cuerpo, bloque 2, 3.3.1 (Lecciones de DORNBUSCH; notas del usuario del bloque 2, 10/11/2026): rehecha con el diseño común de las
% figuras de precios rígidos (b2_sobrerreaccion, b2_taylor_bajada y b2_taylor): el tipo de cambio nominal, s, y el real, q, como
% desviación de su valor inicial, en el mismo eje, de modo que la distancia entre los dos es lo que han subido los precios; dos
% paneles. Aumento permanente y por sorpresa del dinero europeo, Δm = 1, en t0. Izquierda, precios rígidos (DORNBUSCH, 1976): s y q
% saltan (1 + 1/(hν))Δm = 1,54 (con h = 2 y κ = 0,6, como en la nota del texto); s vuelve a Δm y q a su ancla, al ritmo ν
% (1,54 e^{-x/15} con x = t - t0). Derecha, precios flexibles (modelo monetario): s salta Δm y q no se mueve. Sustituye a la versión
% con el panel del tipo de interés. Curvas ilustrativas. Hecha a mano; compilar con: bash Code/generar_figura.sh b2_sobrerreaccion
\begin{tikzpicture}
\footnotesize
\begin{axis}[name=pa,
  scale only axis, width=6.2cm, height=2.6cm, axis lines=left, tick style={draw=none},
  every axis label/.style={font=\footnotesize}, tick label style={font=\footnotesize}, title style={font=\footnotesize\bfseries},
  xmin=0, xmax=100, ymin=-0.3, ymax=1.9, clip=false, xtick={20}, xticklabels={$t_0$}, ytick={0,1}, yticklabels={$0$,$\Delta m$},
  title={Precios rígidos: DORNBUSCH}, xlabel={Tiempo}, ylabel={Desviación del valor inicial},
  legend style={draw=none, fill=none, font=\footnotesize, at={(1.105,1.32)}, anchor=south, legend columns=-1,
    /tikz/every even column/.append style={column sep=0.6cm}},
]
\draw[black!45, dotted] (axis cs:20,1) -- (axis cs:100,1);
\addplot[black, line width=1pt] coordinates {(0,0) (20,0) (20,1.54)};
\addlegendentry{Tipo de cambio nominal, $s$}
\addplot[black!50, line width=1pt, densely dashed] coordinates {(0,0) (20,0) (20,1.54)};
\addlegendentry{Tipo de cambio real, $q$}
\addplot[black, line width=1pt, domain=20:100, samples=100, forget plot] {1+0.54*exp(-(x-20)/15)};
\addplot[black!50, line width=1pt, densely dashed, domain=20:100, samples=100, forget plot] {1.54*exp(-(x-20)/15)};
\end{axis}
\begin{axis}[at={(pa.south east)}, anchor=south west, xshift=1.3cm,
  scale only axis, width=6.2cm, height=2.6cm, axis lines=left, tick style={draw=none},
  every axis label/.style={font=\footnotesize}, tick label style={font=\footnotesize}, title style={font=\footnotesize\bfseries},
  xmin=0, xmax=100, ymin=-0.3, ymax=1.9, clip=false, xtick={20}, xticklabels={$t_0$}, ytick={0,1}, yticklabels={$0$,$\Delta m$},
  title={Precios flexibles: modelo monetario}, xlabel={Tiempo},
]
\draw[black!45, dotted] (axis cs:20,1) -- (axis cs:100,1);
\addplot[black, line width=1pt] coordinates {(0,0) (20,0) (20,1) (100,1)};
\addplot[black!50, line width=1pt, densely dashed] coordinates {(0,0) (100,0)};
\end{axis}
\end{tikzpicture}
