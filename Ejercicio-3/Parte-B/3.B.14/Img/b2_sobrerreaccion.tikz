% Cuerpo, bloque 2 (T15, 08/11/2026): sobrerreacción de DORNBUSCH (1976). Tras un aumento permanente y por sorpresa del dinero
% europeo en t0, el tipo de interés cae (efecto liquidez) y vuelve despacio; el tipo de cambio salta por encima de su nuevo nivel
% de largo plazo y se aprecia después mientras los precios suben poco a poco. Versión del cuerpo de anx_dornbusch_sorpresa (anexo II),
% sin el panel del dinero; curvas ilustrativas. Hecha a mano; compilar con: bash Code/generar_figura.sh b2_sobrerreaccion
\begin{tikzpicture}
\footnotesize
\begin{axis}[name=pa,
  scale only axis, width=7.2cm, height=2.5cm, axis lines=left, tick style={draw=none},
  every axis label/.style={font=\footnotesize}, tick label style={font=\footnotesize}, title style={font=\footnotesize\bfseries},
  xmin=0, xmax=100, ymin=0, ymax=10, clip=false, xtick={20}, xticklabels={$t_0$}, ytick={6.2}, yticklabels={$\bar s_1$},
  title={Tipo de cambio y precios}, xlabel={Tiempo},
  legend style={draw=none, fill=none, font=\footnotesize, at={(0.5,1.2)}, anchor=south, legend columns=-1,
    /tikz/every even column/.append style={column sep=0.5cm}},
]
\draw[black!45, dotted] (axis cs:20,6.2) -- (axis cs:100,6.2);
\addplot[black, line width=1pt] coordinates {(0,2.2) (20,2.2)};
\addlegendentry{Tipo de cambio, $s$}
\addplot[black!50, line width=1pt, densely dashed] coordinates {(0,1.0) (20,1.0)};
\addlegendentry{Precios, $p$}
\draw[black, line width=1pt] (axis cs:20,2.2) -- (axis cs:20,9.0);
\addplot[black, line width=1pt, domain=20:100, samples=80, forget plot] {6.2+2.8*exp(-(x-20)/14)};
\addplot[black!50, line width=1pt, densely dashed, domain=20:100, samples=80, forget plot] {5.0-4.0*exp(-(x-20)/14)};
\end{axis}
\begin{axis}[at={(pa.south east)}, anchor=south west, xshift=1.0cm,
  scale only axis, width=5.2cm, height=3.6cm, axis lines=left, tick style={draw=none},
  every axis label/.style={font=\footnotesize}, tick label style={font=\footnotesize}, title style={font=\footnotesize\bfseries},
  xmin=0, xmax=100, ymin=0, ymax=10, clip=false, xtick={20}, xticklabels={$t_0$}, ytick={7}, yticklabels={$i^*$},
  title={Tipo de interés, $i$}, xlabel={Tiempo},
]
\draw[black!45, dotted] (axis cs:0,7) -- (axis cs:100,7);
\draw[black, line width=1pt] (axis cs:0,7) -- (axis cs:20,7) -- (axis cs:20,2.5);
\addplot[black, line width=1pt, domain=20:100, samples=80] {7-4.5*exp(-(x-20)/14)};
\end{axis}
\end{tikzpicture}
