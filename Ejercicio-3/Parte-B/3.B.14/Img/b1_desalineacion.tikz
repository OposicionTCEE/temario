% Cuerpo, bloque 1, 2.3.4 (notas del usuario, tanda 4, 09/11/2026): el coste de una sobrevaloración sobre la base de
% b1_equilibrio_externo, con la cuenta corriente. Con la norma inicial (aquí, un déficit sostenible) el ancla es \bar q_0; con la
% moneda sobrevalorada, en q, la cuenta corriente queda por debajo de la norma y el país acumula deuda. La deuda acumulada eleva el
% superávit que exige la posición exterior, la norma sube y el ancla se desplaza a \bar q_1, más depreciada: cuanto más dura la
% sobrevaloración, mayor es la depreciación que hará falta. Hecha a mano; compilar con: bash Code/generar_figura.sh b1_desalineacion
\begin{tikzpicture}
\footnotesize
\begin{axis}[
  scale only axis, width=9.5cm, height=5cm, axis lines=middle, tick style={draw=none},
  every axis label/.style={font=\footnotesize}, tick label style={font=\footnotesize},
  xmin=0, xmax=10.4, ymin=-3.4, ymax=3.6, clip=false, xtick=\empty, ytick=\empty,
]
\addplot[black, line width=1pt, domain=0.5:9.6, samples=120] {3*tanh((x-5)/2.5)};
\draw[black!60, densely dashed] (axis cs:0,-0.8) -- (axis cs:10.4,-0.8) node[anchor=west, black] {Norma inicial};
\draw[black!60, densely dashed] (axis cs:0,0.9) -- (axis cs:10.4,0.9) node[anchor=west, black, align=left] {Norma con la\\deuda acumulada};
\draw[-{Stealth[length=1.6mm]}, black] (axis cs:6.8,-0.72) -- (axis cs:6.8,0.82);
\fill[black] (axis cs:3,-1.99) circle (1.6pt);
\node[anchor=south east, align=right] at (axis cs:2.9,-1.85) {Sobrevaloración:\\déficit y deuda};
\draw[black!40, dotted] (axis cs:3,-1.99) -- (axis cs:3,-3.4) node[anchor=north, black] {$q$};
\draw[black!40, dotted] (axis cs:4.317,-0.8) -- (axis cs:4.317,-3.4) node[anchor=north, black] {$\bar q_0$};
\draw[black!40, dotted] (axis cs:5.774,0.9) -- (axis cs:5.774,-3.4) node[anchor=north, black] {$\bar q_1$};
\draw[-{Stealth[length=1.6mm]}, black] (axis cs:4.4,-2.9) -- (axis cs:5.69,-2.9);
\fill[white, draw=black] (axis cs:4.317,-0.8) circle (1.6pt);
\fill[black] (axis cs:5.774,0.9) circle (1.6pt);
\node[anchor=south west] at (axis cs:0,3.6) {Cuenta corriente};
\node[anchor=north east] at (axis cs:10.4,-0.15) {Tipo de cambio real, $q$};
\end{axis}
\end{tikzpicture}
