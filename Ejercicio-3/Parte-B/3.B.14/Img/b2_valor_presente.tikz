% Cuerpo, bloque 2 (T15, 08/11/2026): el modelo monetario como valor presente. Un aumento permanente del dinero europeo por sorpresa
% (izquierda) deprecia el euro de golpe y en la misma proporción; si se anuncia en t0 para aplicarlo en t1 (derecha), el euro
% salta en el anuncio y sigue depreciándose hasta t1, sin saltar entonces. Versión del cuerpo con dos de los tres casos de
% anx_monetario (anexo II). Hecha a mano; compilar con: bash Code/generar_figura.sh b2_valor_presente
\begin{tikzpicture}
\footnotesize
\begin{axis}[name=pa,
  scale only axis, width=6.4cm, height=3.4cm, axis lines=left, tick style={draw=none},
  every axis label/.style={font=\footnotesize}, tick label style={font=\footnotesize}, title style={font=\footnotesize\bfseries},
  xmin=0, xmax=100, ymin=0, ymax=10, clip=false, xtick={35}, xticklabels={$t_0$}, ytick=\empty,
  title={Aumento por sorpresa}, xlabel={Tiempo}, ylabel={Logaritmo},
  legend style={draw=none, fill=none, font=\footnotesize, at={(1.08,1.2)}, anchor=south, legend columns=-1,
    /tikz/every even column/.append style={column sep=0.6cm}},
]
\addplot[black!50, line width=1pt, densely dashed] coordinates {(0,4.2) (35,4.2) (35,8.2) (100,8.2)};
\addlegendentry{Dinero europeo, $m$}
\addplot[black, line width=1pt] coordinates {(0,2.2) (35,2.2) (35,6.2) (100,6.2)};
\addlegendentry{Tipo de cambio, $s$}
\end{axis}
\begin{axis}[at={(pa.south east)}, anchor=south west, xshift=1.0cm,
  scale only axis, width=6.4cm, height=3.4cm, axis lines=left, tick style={draw=none},
  every axis label/.style={font=\footnotesize}, tick label style={font=\footnotesize}, title style={font=\footnotesize\bfseries},
  xmin=0, xmax=100, ymin=0, ymax=10, clip=false, xtick={30,70}, xticklabels={$t_0$,$t_1$}, ytick=\empty,
  title={Aumento anunciado}, xlabel={Tiempo},
]
\addplot[black!50, line width=1pt, densely dashed] coordinates {(0,4.2) (70,4.2) (70,8.2) (100,8.2)};
\draw[black, line width=1pt] (axis cs:0,2.2) -- (axis cs:30,2.2) -- (axis cs:30,3.0);
\addplot[black, line width=1pt, domain=30:70, samples=60] {2.2+4*exp(-(70-x)/24.85)};
\draw[black, line width=1pt] (axis cs:70,6.2) -- (axis cs:100,6.2);
\draw[black!40, dotted] (axis cs:30,0) -- (axis cs:30,3.0);
