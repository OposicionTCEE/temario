% Cuerpo, bloque 2, 3.3.2 (Regla de TAYLOR; notas del usuario del bloque 2, 10/11/2026): la misma expansión monetaria con el dinero
% como instrumento y con una regla, con el diseño común de las figuras de precios rígidos (s y q como desviación de su valor inicial,
% en el mismo eje). Izquierda, DORNBUSCH: aumento del dinero por sorpresa, el mismo panel que en b2_sobrerreaccion (salto de 1,54 y
% vuelta de s a Δm = 1 y de q a su ancla). Derecha, regla de TAYLOR: una bajada del tipo de interés por sorpresa que el banco central
% deshace poco a poco; el tipo real baja, q salta 1,2 y vuelve a su ancla (1,2 e^{-x/15}); los precios suben 0,6 en total y s acaba
% ahí (0,6 + 0,6 e^{-x/15}): el mecanismo es el mismo. Curvas ilustrativas. Hecha a mano; compilar con:
% bash Code/generar_figura.sh b2_taylor_bajada
\begin{tikzpicture}
\footnotesize
\begin{axis}[name=pa,
  scale only axis, width=6.2cm, height=2.6cm, axis lines=left, tick style={draw=none},
  every axis label/.style={font=\footnotesize}, tick label style={font=\footnotesize}, title style={font=\footnotesize\bfseries},
  xmin=0, xmax=100, ymin=-0.3, ymax=1.9, clip=false, xtick={20}, xticklabels={$t_0$}, ytick={0,1}, yticklabels={$0$,$\Delta m$},
  title={DORNBUSCH: más dinero}, xlabel={Tiempo}, ylabel={Desviación del valor inicial},
  legend style={draw=none, fill=none, font=\footnotesize, at={(1.105,1.32)}, anchor=south, legend columns=-1,
    /tikz/every even column/.append style={column sep=0.6cm}},
]
\draw[black!45, dotted] (axis cs:20,1) -- (axis cs:100,1);
\addplot[black, line width=1pt] coordinates {(0,0) (20,0) (20,1.54)};
\addlegendentry{Tipo de cambio nominal, $s$}
\addplot[black!50, line width=1pt, densely dashed] coordinates {(0,0) (20,0) (20,1.54)};
\addlegendentry{Tipo de cambio real, $q$}
\addplot[black, line width=1pt, domain=20:100, samples=100, forget plot] {1+0.54*exp(-(x-20)/15)};
\addplot[black!50, line width=1pt, densely dashed, domain=20:100, samples=100, forget plot] {1.54*exp(-(x-20)/15)};
\end{axis}
\begin{axis}[at={(pa.south east)}, anchor=south west, xshift=1.3cm,
  scale only axis, width=6.2cm, height=2.6cm, axis lines=left, tick style={draw=none},
  every axis label/.style={font=\footnotesize}, tick label style={font=\footnotesize}, title style={font=\footnotesize\bfseries},
  xmin=0, xmax=100, ymin=-0.3, ymax=1.9, clip=false, xtick={20}, xticklabels={$t_0$}, ytick={0}, yticklabels={$0$},
  title={Regla de TAYLOR: tipo de interés más bajo}, xlabel={Tiempo},
]
\draw[black!45, dotted] (axis cs:20,0.6) -- (axis cs:100,0.6);
\addplot[black, line width=1pt] coordinates {(0,0) (20,0) (20,1.2)};
\addplot[black!50, line width=1pt, densely dashed] coordinates {(0,0) (20,0) (20,1.2)};
\addplot[black, line width=1pt, domain=20:100, samples=100] {0.6+0.6*exp(-(x-20)/15)};
\addplot[black!50, line width=1pt, densely dashed, domain=20:100, samples=100] {1.2*exp(-(x-20)/15)};
\end{axis}
\end{tikzpicture}
