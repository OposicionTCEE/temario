% Tipo real de equilibrio y posición exterior: las exportaciones netas, XN(q), crecen con el tipo real; la posición de
% inversión internacional neta estable exige XN = -(r - g) pii. Un acreedor (pii_A > 0) puede tener un déficit comercial
% y un tipo real más apreciado; un deudor (pii_D < 0) necesita un superávit y un tipo real más depreciado.
% Figura abstracta, sin cifras. Compilar con: bash Code/generar_figura.sh anx_equilibrio_externo
\begin{tikzpicture}[font=\footnotesize, x=1cm, y=1cm]
  % ejes
  \draw[-{Stealth[length=2mm]}] (0,0) -- (10.6,0) node[below left] {$q$};
  \draw[-{Stealth[length=2mm]}] (0,-2.6) -- (0,3.0) node[above] {$XN$};
  \node[left] at (0,0) {$0$};
  % curva de exportaciones netas
  \draw[black, line width=1pt] plot[smooth, domain=0.6:9.8] (\x, {-2.3 + 4.6/(1+exp(-0.75*(\x-5.2)))});
  \node[anchor=west] at (9.8,2.25) {$XN(q)$};
  % exigencias del acreedor y del deudor
  \draw[black!55, densely dashed] (0,-1.15) -- (9.8,-1.15) node[anchor=west, black] {$-(r-g)\,pii_A<0$};
  \draw[black!55, densely dashed] (0,1.35) -- (9.8,1.35) node[anchor=west, black] {$-(r-g)\,pii_D>0$};
  % tipos de equilibrio
  \pgfmathsetmacro{\qa}{5.2 - ln(4.6/(-1.15+2.3) - 1)/0.75}
  \pgfmathsetmacro{\qd}{5.2 - ln(4.6/(1.35+2.3) - 1)/0.75}
  \draw[black!40, densely dotted] (\qa,-1.15) -- (\qa,-2.6);
  \draw[black!40, densely dotted] (\qd,1.35) -- (\qd,-2.6);
  \fill[black] (\qa,-1.15) circle (1.6pt);
  \fill[black] (\qd,1.35) circle (1.6pt);
  \node[below] at (\qa,-2.6) {$\bar q_A$};
  \node[below] at (\qd,-2.6) {$\bar q_D$};
\end{tikzpicture}
