% Cuerpo, bloque 1 (T14, 08/11/2026): figura base «senda». Tras una perturbación en t0, el tipo de cambio real se separa de su
% ancla y vuelve despacio (semivida de tres a cinco años); la línea gris es la vuelta que cabría esperar si solo la frenara la
% rigidez de los precios (uno o dos años). Curvas exponenciales ilustrativas, sin datos.
% Hecha a mano; compilar con: bash Code/generar_figura.sh b1_senda
\begin{tikzpicture}
\footnotesize
\begin{axis}[
  scale only axis, width=11cm, height=4.4cm, axis lines=left, tick style={draw=none},
  every axis label/.style={font=\footnotesize}, tick label style={font=\footnotesize},
  xmin=0, xmax=100, ymin=-2, ymax=12, clip=false,
  xtick={15}, xticklabels={$t_0$}, ytick={0}, yticklabels={$\bar q$},
  xlabel={Tiempo}, ylabel={Tipo de cambio real, $q$},
  legend style={draw=none, fill=none, font=\footnotesize, at={(0.5,1.04)}, anchor=south, legend columns=-1,
    /tikz/every even column/.append style={column sep=0.6cm}},
]
\draw[black!60, densely dashed] (axis cs:0,0) -- (axis cs:100,0);
\addplot[black, line width=1pt, domain=15:100, samples=120] {10*exp(-(x-15)*ln(2)/25)};
\addlegendentry{Vuelta observada}
\addplot[black!45, line width=1pt, densely dashed, domain=15:100, samples=120] {10*exp(-(x-15)*ln(2)/7)};
\addlegendentry{Vuelta si solo la frenara la rigidez de los precios}
\draw[black, line width=1pt] (axis cs:0,0) -- (axis cs:15,0) -- (axis cs:15,10);
\draw[{Stealth[length=1.6mm]}-{Stealth[length=1.6mm]}, black!70] (axis cs:15,5) -- (axis cs:40,5) node[midway, above, font=\footnotesize] {semivida};
\draw[black!40, dotted] (axis cs:40,5) -- (axis cs:40,0);
\end{axis}
\end{tikzpicture}
