% Cuerpo, bloque 3 (T16, 08/11/2026): el bucle de un modelo basado en agentes del tipo de cambio, versión del cuerpo de
% anx_agentes_estructura (anexo III), a partir de DELLI GATTI et al. (2025). Los operadores fijan el tipo de cambio; el tipo de cambio
% decide la competitividad de las empresas y el comercio; el comercio fija el valor fundamental, que guía a los fundamentalistas,
% mientras los chartistas siguen la tendencia del propio tipo de cambio; el banco central puede intervenir en el mercado de divisas.
% Hecha a mano; compilar con: bash Code/generar_figura.sh b3_agentes
\begin{tikzpicture}[font=\footnotesize,
  caja/.style={draw, rounded corners=2pt, align=center, text width=3.9cm, minimum height=1.05cm, inner sep=3pt},
  flecha/.style={-{Stealth[length=1.8mm]}, line width=0.7pt},
  rotulo/.style={font=\footnotesize, text=black!70, align=center}]
\node[caja] (ope) at (0,2.6) {Operadores\\chartistas y fundamentalistas};
\node[caja] (tc) at (7.2,2.6) {Mercado de divisas\\tipo de cambio};
\node[caja] (emp) at (7.2,0) {Empresas\\competitividad, comercio y producción};
\node[caja] (fun) at (0,0) {Valor fundamental\\el que equilibra el comercio};
\node[caja, text width=2.6cm] (bc) at (7.2,4.6) {Banco central};
\draw[flecha] (ope.east) -- node[rotulo, above] {compras y ventas de divisas} (tc.west);
\draw[flecha, densely dashed] (tc.north west) to[bend right=28] node[rotulo, above] {tendencia que siguen los chartistas} (ope.north east);
\draw[flecha] (tc.south) -- node[rotulo, right] {canal real} (emp.north);
\draw[flecha] (emp.west) -- node[rotulo, below] {saldo comercial} (fun.east);
\draw[flecha] (fun.north) -- node[rotulo, left, text width=2.4cm] {guía a los\\fundamentalistas} (ope.south);
\draw[flecha] (bc.south) -- node[rotulo, right] {intervención} (tc.north);
\end{tikzpicture}
