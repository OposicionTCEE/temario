% Moneda de facturación y traspaso: logaritmo del precio de una importación en la moneda del importador, p_M, tras una
% depreciación de la moneda del importador en t_0. (a) Precio en la moneda del exportador: traspaso completo e inmediato.
% (b) Precio en la moneda del importador: nada cambia hasta que se revisa el precio en t_1, y entonces solo en parte.
% (c) Precio en dólares: el precio sigue al tipo frente al dólar, no al tipo frente a la moneda del exportador.
% Figura abstracta, sin cifras. Compilar con: bash Code/generar_figura.sh anx_facturacion
\begin{tikzpicture}[font=\footnotesize, x=1cm, y=1cm]
  \foreach \dx/\tit in {0/{(a) Moneda del exportador}, 5.45/{(b) Moneda del importador}, 10.9/{(c) Dólar}} {
    \begin{scope}[xshift=\dx cm]
      \draw[-{Stealth[length=1.8mm]}] (0,0) -- (4.35,0) node[below left] {$t$};
      \draw[-{Stealth[length=1.8mm]}] (0,0) -- (0,3.05) node[above] {$p_M$};
      \draw[black!35, densely dotted] (1.5,0) -- (1.5,2.75);
      \node[below] at (1.5,0) {$t_0$};
      \node[anchor=south] at (2.1,3.35) {\tit};
    \end{scope}
  }
  % (a) traspaso completo e inmediato
  \draw[black, line width=1pt] (0.05,0.85) -- (1.5,0.85) -- (1.5,2.2) -- (4.1,2.2);
  \draw[decorate, decoration={brace, amplitude=3pt}, black!65] (4.2,2.2) -- (4.2,0.85) node[midway, right=3pt] {$\Delta s$};
  \draw[black!35, densely dotted] (1.5,0.85) -- (4.1,0.85);
  % (b) precio fijo en la moneda del importador hasta t_1, y ajuste parcial
  \begin{scope}[xshift=5.45cm]
    \draw[black!35, densely dotted] (3.0,0) -- (3.0,2.75);
    \node[below] at (3.0,0) {$t_1$};
    \draw[black, line width=1pt] (0.05,0.85) -- (3.0,0.85) -- (3.0,1.45) -- (4.1,1.45);
    \draw[black!45, densely dashed] (1.5,2.2) -- (4.1,2.2);
    \draw[decorate, decoration={brace, amplitude=3pt}, black!65] (4.2,2.2) -- (4.2,0.85) node[midway, right=3pt] {$\Delta s$};
  \end{scope}
  % (c) precio en dólares: depende del tipo frente al dólar
  \begin{scope}[xshift=10.9cm]
    \draw[black, line width=1pt] (0.05,0.85) -- (1.5,0.85) -- (1.5,2.2) -- (4.1,2.2);
    \draw[black, line width=1pt, densely dashed] (1.5,0.85) -- (4.1,0.85);
    \node[anchor=south east, inner sep=2pt] at (4.1,2.2) {$\Delta s^{\$}>0$};
    \node[anchor=south east, inner sep=2pt] at (4.1,0.85) {$\Delta s^{\$}=0$};
  \end{scope}
\end{tikzpicture}
