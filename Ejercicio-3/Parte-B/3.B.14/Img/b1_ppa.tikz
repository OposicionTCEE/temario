% Cuerpo, bloque 1 (notas del usuario, tanda 2, 09/11/2026): paridad absoluta y relativa sobre la base «senda» (tipo real a lo largo
% del tiempo frente a su ancla). Con la absoluta, el ancla es q = 0 (Q = 1) para cualquier par de países; con la relativa, cada país
% tiene su propia ancla constante, que puede estar lejos de cero. Oscilaciones ilustrativas, sin datos.
% Hecha a mano; compilar con: bash Code/generar_figura.sh b1_ppa
\begin{tikzpicture}
\footnotesize
\begin{axis}[name=pa,
  scale only axis, width=6.2cm, height=2.8cm, axis lines=left, tick style={draw=none},
  every axis label/.style={font=\footnotesize}, tick label style={font=\footnotesize}, title style={font=\footnotesize\bfseries},
  xmin=0, xmax=100, ymin=-4, ymax=8, clip=false, xtick=\empty, ytick={0}, yticklabels={$\bar q=0$},
  title={Paridad absoluta}, xlabel={Tiempo}, ylabel={Tipo de cambio real, $q$},
]
\draw[black!60, densely dashed] (axis cs:0,0) -- (axis cs:100,0);
\addplot[black, line width=1pt, domain=0:100, samples=150] {1.5*sin(deg(x/8))+0.8*sin(deg(x/3.7+1))};
\end{axis}
\begin{axis}[at={(pa.south east)}, anchor=south west, xshift=1.6cm,
  scale only axis, width=6.2cm, height=2.8cm, axis lines=left, tick style={draw=none},
  every axis label/.style={font=\footnotesize}, tick label style={font=\footnotesize}, title style={font=\footnotesize\bfseries},
  xmin=0, xmax=100, ymin=-4, ymax=8, clip=false, xtick=\empty, ytick={0,4}, yticklabels={$0$,$\bar q$},
  title={Paridad relativa}, xlabel={Tiempo},
]
\draw[black!35, dotted] (axis cs:0,0) -- (axis cs:100,0);
\draw[black!60, densely dashed] (axis cs:0,4) -- (axis cs:100,4);
\addplot[black, line width=1pt, domain=0:100, samples=150] {4+1.5*sin(deg(x/8))+0.8*sin(deg(x/3.7+1))};
\end{axis}
\end{tikzpicture}
