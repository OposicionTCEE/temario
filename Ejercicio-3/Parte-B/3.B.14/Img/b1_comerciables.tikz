% Cuerpo, bloque 1 (notas del usuario, tanda 2, 09/11/2026): bienes comerciables y cesta de consumo, sobre la base «senda». El tipo
% real de los comerciables oscila dentro de la banda alrededor de la paridad; el de la cesta de consumo, que incluye alquileres y
% servicios que no se comercian, comparte sus oscilaciones pero se queda lejos de la paridad, y puede alejarse más con el tiempo,
% mientras los precios de esos bienes difieran entre países. Oscilaciones ilustrativas, sin datos.
% Hecha a mano; compilar con: bash Code/generar_figura.sh b1_comerciables
\begin{tikzpicture}
\footnotesize
\begin{axis}[
  scale only axis, width=11cm, height=3.4cm, axis lines=left, tick style={draw=none},
  every axis label/.style={font=\footnotesize}, tick label style={font=\footnotesize},
  xmin=0, xmax=100, ymin=-9.6, ymax=3.5, clip=false, xtick=\empty, ytick={0}, yticklabels={$0$},
  xlabel={Tiempo}, ylabel={Tipo de cambio real, $q$},
]
\fill[black!9] (axis cs:0,-2.5) rectangle (axis cs:100,2.5);
\draw[black!60, densely dashed] (axis cs:0,0) -- (axis cs:100,0);
\addplot[black!50, line width=1pt, domain=0:100, samples=150] {1.3*sin(deg(x/7))+0.6*sin(deg(x/3.1+2))};
\addplot[black, line width=1pt, domain=0:100, samples=150] {-3.6-0.018*x+1.3*sin(deg(x/7))+0.6*sin(deg(x/3.1+2))};
\node[anchor=south east, font=\footnotesize, text=black!70] at (axis cs:100,2.5) {Bienes comerciables};
\node[anchor=north east, font=\footnotesize] at (axis cs:100,-7.3) {Cesta de consumo, con los no comerciables};
\end{axis}
\end{tikzpicture}
