% Síntesis propia de la historia de las teorías del tipo de cambio (anexo IV): filas, las etapas de la historia monetaria;
% columnas, los tres términos de la identidad del tema, q = ancla - suma E(r - r*) + suma E(lambda): ancla, senda y cuña.
% Hecha a mano (A13, 08/11/2026); compilar con: bash Code/generar_figura.sh anx_historia_teorias
\begin{tikzpicture}[font=\scriptsize]
\matrix (m) [matrix of nodes, ampersand replacement=\&, row sep=0.26cm, column sep=0.3cm,
  nodes={anchor=north, text width=3.95cm, align=left, inner sep=1pt},
  column 1/.style={nodes={text width=2.1cm, align=right}},
  row 1/.style={nodes={font=\scriptsize\bfseries}}]
{
  {} \& Ancla: el tipo real a largo plazo \& Senda: dinero y tipos de interés \& Cuña: primas y expectativas \\
  {\textbf{Monedas de metal}, 1556-1914} \&
  AZPILCUETA (1556) y MERCADO (1569): el dinero vale más donde escasea. HUME (1752): flujos de metal y precios. \&
  THORNTON (1802) y RICARDO (1810): el exceso de billetes deprecia la libra. GOSCHEN (1861): el tipo de descuento mueve el cambio. \&
  {} \\
  {\textbf{Entreguerras}, 1914-1944} \&
  CASSEL (1916, 1918): paridad del poder adquisitivo. KEYNES (1925): la libra sobrevalorada. \&
  KEYNES (1923): paridad cubierta de intereses. \&
  NURKSE (1944): la especulación desestabiliza. \\
  {\textbf{Bretton Woods}, 1944-1973} \&
  BALASSA (1964) y SAMUELSON (1964): la productividad mueve el tipo real. \&
  FLEMING (1962) y MUNDELL (1963): el capital responde a los tipos de interés. \&
  FRIEDMAN (1953): la especulación rentable estabiliza. \\
  {\textbf{Flotación}, 1973-2007} \&
  FRENKEL (1981a): la paridad se derrumba. WILLIAMSON (1983): tipo de equilibrio. ROGOFF (1996): enigma de la paridad. \&
  FRENKEL (1976) y MUSSA (1976): enfoque monetario. DORNBUSCH (1976): sobrerreacción. OBSTFELD y ROGOFF (1995): microfundamentos. \&
  KOURI (1976): cartera. MEESE y ROGOFF (1983) y FAMA (1984): los modelos fallan y la prima existe. FRANKEL y FROOT (1986): chartistas. \\
  {\textbf{Tras la crisis}, 2008-2025} \&
  BERKA, DEVEREUX y ENGEL (2018): productividad en el euro. \&
  MOLODTSOVA y PAPELL (2009): reglas de TAYLOR. \&
  GABAIX y MAGGIORI (2015): intermediarios. JIANG, KRISHNAMURTHY y LUSTIG (2021): activos seguros. ITSKHOKI y MUKHIN (2021): la cuña explica los enigmas. DELLI GATTI et al. (2025): agentes. \\
};
% líneas entre filas, sin recuadros
\foreach \f in {3,...,6} {
  \draw[black!35, line width=0.4pt] ($(m-\f-1.north west)+(0,0.13cm)$) -- ($(m-\f-4.north east)+(0,0.13cm)$);
}
\draw[black!70, line width=0.6pt] ($(m-2-1.north west)+(0,0.13cm)$) -- ($(m-2-4.north east)+(0,0.13cm)$);
% flecha del tiempo
\draw[-{Stealth[length=1.8mm]}, black!60] ($(m-2-1.north west)+(-0.25cm,0)$) -- ($(m-6-1.west |- m-6-4.south)+(-0.25cm,0)$)
  node[midway, rotate=90, above, font=\scriptsize, black!70] {tiempo};
\end{tikzpicture}
