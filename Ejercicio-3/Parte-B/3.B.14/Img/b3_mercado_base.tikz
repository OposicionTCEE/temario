% Cuerpo, bloque 3, 4.2 (notas del usuario del bloque 3, 09/11/2026): primer paso de la construcción del mercado de activos en euros,
% el entorno común de los enfoques de cartera y de intermediarios, sin los resultados de ninguno. Oferta vertical (los activos en
% euros que alguien tiene que mantener) y su aumento (más activos que absorber); una demanda con pendiente negativa, la misma recta
% que en el enfoque de cartera; el equilibrio inicial A. El segundo paso es b3_mercado_cartera (con B) y el tercero, b3_mercado_activos
% (con C y D). Los rótulos invisibles del final reproducen los de la figura completa para que los tres pasos salgan del mismo tamaño.
% Valores ilustrativos. Hecha a mano; compilar con: bash Code/generar_figura.sh b3_mercado_base
\begin{tikzpicture}[font=\footnotesize, x=0.95cm, y=0.8cm]
% ejes
\draw[-{Stealth[length=1.8mm]}] (0,0) -- (9.6,0) node[anchor=north east, yshift=-0.1cm] {Activos en euros que hay que mantener};
\draw[-{Stealth[length=1.8mm]}] (0,0) -- (0,6.4) node[anchor=south west] {Valor del euro hoy};
% oferta, antes y después
\draw[black!45, line width=1pt] (3.5,0) -- (3.5,5.7) node[anchor=south east, text=black] {Oferta};
\draw[black!45, line width=1pt, densely dashed] (5.5,0) -- (5.5,5.7) node[anchor=south west, text=black] {Más activos que absorber};
\draw[-{Stealth[length=1.4mm]}, black!60] (3.65,5.35) -- (5.35,5.35);
% demanda
\draw[black, line width=1pt] (0.6,4.435) -- (8.4,3.265) node[anchor=west] {Demanda};
% equilibrio inicial
\draw[black!45, dotted] (3.5,4) -- (5.5,4);
\fill (3.5,4) circle (1.7pt) node[anchor=north east, inner sep=2pt] {$A$};
% rótulos invisibles de la figura completa
\node[opacity=0, anchor=west, align=left] at (8.4,3.265) {Todo el mundo:\\enfoque de cartera};
\node[opacity=0, anchor=west, align=left] at (7.3,1.72) {Unos pocos\\intermediarios};
\node[opacity=0, anchor=west] at (6.3,0.5) {Intermediarios en una crisis};
\end{tikzpicture}
