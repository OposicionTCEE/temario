% Estructura del modelo basado en agentes de DELLI GATTI, FERRARESI, GUSELLA, POPOYAN, RICCHIUTI y ROVENTINI (2025):
% dos países con empresas que innovan e imitan y fijan precios con un margen; mercados internacionales de bienes en los que
% la competitividad depende del precio, de los costes de comercio y del tipo de cambio; la balanza comercial fija el tipo de
% cambio fundamental (canal real); en el mercado de divisas, fundamentalistas y chartistas, cuya proporción cambia con la
% desalineación, fijan el tipo de cambio (canal financiero), que vuelve a la competitividad (retroalimentación); el banco
% central interviene contra el viento. Figura propia, que sustituye a las dos copiadas del documento de trabajo.
% Compilar con: bash Code/generar_figura.sh anx_agentes_estructura
\begin{tikzpicture}[font=\footnotesize,
  caja/.style={draw=black!70, rounded corners=2pt, align=center, inner sep=4pt, fill=white},
  flecha/.style={-{Stealth[length=1.8mm]}, black!75, line width=0.7pt},
  rotulo/.style={font=\scriptsize\itshape, black!70, inner sep=2pt}]
  % mercado de divisas y banco central
  \node[caja, text width=6.4cm] (fx) at (0,4.3) {\textbf{Mercado de divisas}\\[1pt]fundamentalistas: esperan la vuelta a $\bar s_t$\\chartistas: extrapolan la última variación\\la proporción de chartistas, $\omega_t$, cae con la desalineación};
  \node[caja, text width=3.0cm] (bc) at (5.75,4.3) {\textbf{Banco central}\\[1pt]vende o compra divisas contra la última variación};
  \node[caja, text width=3.0cm] (fund) at (-5.75,4.3) {\textbf{Tipo de cambio fundamental}, $\bar s_t$\\[1pt]el que equilibraría la balanza comercial};
  % tipo de cambio
  \node[caja, fill=black!6] (s) at (0,2.35) {\textbf{Tipo de cambio}, $s_t$};
  % mercados de bienes y países
  \node[caja, text width=6.4cm] (bienes) at (0,0.55) {\textbf{Mercados internacionales de bienes}\\[1pt]competitividad: precio, costes de comercio y tipo de cambio\\las cuotas de mercado crecen con la competitividad};
  \node[caja, text width=3.0cm] (p1) at (-5.75,0.55) {\textbf{País 1}\\[1pt]empresas: innovación,\\imitación y precios\\con un margen\\trabajadores: salario\\y consumo};
  \node[caja, text width=3.0cm] (p2) at (5.75,0.55) {\textbf{País 2}\\[1pt]empresas: innovación,\\imitación y precios\\con un margen\\trabajadores: salario\\y consumo};
  \node[caja] (bc2) at (0,-1.35) {\textbf{Balanza comercial}};
  % flechas
  \draw[flecha, {Stealth[length=1.8mm]}-{Stealth[length=1.8mm]}] (p1.east) -- (bienes.west);
  \draw[flecha, {Stealth[length=1.8mm]}-{Stealth[length=1.8mm]}] (p2.west) -- (bienes.east);
  \draw[flecha] (bienes.south) -- (bc2.north);
  \draw[flecha] (bc2.west) -| (-7.6,2.35) |- (fund.west) node[pos=0.25, left, rotulo, align=right] {canal\\real};
  \draw[flecha] (fund.east) -- (fx.west);
  \draw[flecha] (bc.west) -- (fx.east);
  \draw[flecha] (fx.south) -- (s.north) node[midway, right, rotulo] {canal financiero};
  \draw[flecha] (s.south) -- (bienes.north) node[midway, right, rotulo] {retroalimentación};
\end{tikzpicture}
