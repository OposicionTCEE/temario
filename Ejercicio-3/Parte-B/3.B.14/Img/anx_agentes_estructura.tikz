% Estructura del modelo basado en agentes de DELLI GATTI, FERRARESI, GUSELLA, POPOYAN, RICCHIUTI y ROVENTINI (2025):
% dos países con empresas que innovan e imitan y fijan precios con un margen; mercados internacionales de bienes en los que
% la competitividad depende del precio, de los costes de comercio y del tipo de cambio; la balanza comercial fija el tipo de
% cambio fundamental (canal real); en el mercado de divisas, fundamentalistas y chartistas, cuya proporción cambia con la
% desalineación, fijan el tipo de cambio (canal financiero), que vuelve a la competitividad; el banco central interviene
% contra el viento. Figura propia, en dos filas, que sustituye a las dos copiadas del documento de trabajo.
% Compilar con: bash Code/generar_figura.sh anx_agentes_estructura
\begin{tikzpicture}[font=\footnotesize,
  caja/.style={draw=black!70, rounded corners=2pt, align=center, inner sep=3.5pt, fill=white},
  flecha/.style={-{Stealth[length=1.8mm]}, black!75, line width=0.7pt},
  rotulo/.style={font=\scriptsize\itshape, black!70, inner sep=2pt}]
  % fila superior: valor fundamental, mercado de divisas y banco central
  \node[caja, text width=3.0cm] (fund) at (-5.75,2.75) {\textbf{Tipo de cambio fundamental}, $\bar s_t$\\[1pt]el que equilibraría la balanza comercial};
  \node[caja, text width=6.4cm] (fx) at (0,2.75) {\textbf{Mercado de divisas}\\[1pt]fundamentalistas: esperan la vuelta a $\bar s_t$\\chartistas: extrapolan la última variación\\la proporción de chartistas, $\omega_t$, cae con la desalineación};
  \node[caja, text width=3.0cm] (bc) at (5.75,2.75) {\textbf{Banco central}\\[1pt]vende o compra divisas contra la última variación};
  % fila inferior: países y mercados de bienes
  \node[caja, text width=3.0cm] (p1) at (-5.75,0) {\textbf{País 1}\\[1pt]empresas que innovan, imitan y fijan precios; trabajadores que consumen};
  \node[caja, text width=6.4cm] (bienes) at (0,0) {\textbf{Mercados internacionales de bienes}\\[1pt]competitividad: precio, costes de comercio y tipo de cambio\\las cuotas de mercado crecen con la competitividad};
  \node[caja, text width=3.0cm] (p2) at (5.75,0) {\textbf{País 2}\\[1pt]empresas que innovan, imitan y fijan precios; trabajadores que consumen};
  % flechas
  \draw[flecha] (fund.east) -- (fx.west);
  \draw[flecha] (bc.west) -- (fx.east);
  \draw[flecha, {Stealth[length=1.8mm]}-{Stealth[length=1.8mm]}] (p1.east) -- (bienes.west);
  \draw[flecha, {Stealth[length=1.8mm]}-{Stealth[length=1.8mm]}] (p2.west) -- (bienes.east);
  \draw[flecha] ([xshift=1.2cm]fx.south) -- ([xshift=1.2cm]bienes.north) node[midway, right, rotulo, align=left] {tipo de cambio $s_t$\\(canal financiero)};
  \draw[flecha] ([xshift=-1.2cm]bienes.north) -- ([xshift=-1.2cm]fx.south) node[midway, left, rotulo, align=right] {balanza comercial,\\que mueve $\bar s_t$ (canal real)};
\end{tikzpicture}
