% Diagrama de fases del modelo de DORNBUSCH (1976): nivel de precios p en el eje horizontal y tipo de cambio s en el
% vertical. Precios estables (p punto = 0) cuando el tipo real está en su equilibrio, s = p + q_barra (recta de 45 grados);
% tipo de cambio estable (s punto = 0) cuando p = p_barra. La senda de silla SS, de pendiente -1/(h nu), es la única que
% lleva al equilibrio. Un aumento del dinero desplaza p_barra de p_0 a p_1: el tipo de cambio salta de A a B, sobre la
% nueva senda de silla, y después baja de B a C mientras suben los precios. Pendiente de SS = -0,541 (h = 2, kappa = 0,6).
% Figura abstracta. Compilar con: bash Code/generar_figura.sh anx_dornbusch_fases
\begin{tikzpicture}[font=\footnotesize, x=1cm, y=1cm, >={Stealth[length=4pt]}]
  \draw[->] (0,0) -- (6.4,0) node[below left] {$p$};
  \draw[->] (0,0) -- (0,6.0) node[left] {$s$};
  % precios estables: s = p + q_barra
  \draw[black, line width=0.8pt] (0.3,0.9) -- (5.3,5.9) node[right] {$\dot p=0$};
  % tipo de cambio estable: p = p_barra, antes y después
  \draw[black!45, line width=0.8pt] (2.0,0.3) -- (2.0,5.8) node[above] {$\dot s_0=0$};
  \draw[black, line width=0.8pt] (3.5,0.3) -- (3.5,5.8) node[above] {$\dot s_1=0$};
  % sendas de silla
  \draw[black!45, densely dashed, line width=0.8pt] (0.8,3.25) -- (3.6,1.73) node[right, black!60] {$SS_0$};
  \draw[black, densely dashed, line width=0.9pt] (1.2,5.34) -- (5.6,2.96) node[right] {$SS_1$};
  % equilibrios y ajuste
  \fill[black!55] (2.0,2.6) circle (1.8pt) node[anchor=north west, black] {$A$};
  \fill (2.0,4.91) circle (1.8pt) node[anchor=south east] {$B$};
  \fill (3.5,4.1) circle (1.8pt) node[anchor=north west] {$C$};
  \draw[->, line width=0.8pt] (2.0,2.75) -- (2.0,4.78);
  \draw[->, line width=0.8pt] (2.12,4.85) -- (3.38,4.17);
  % niveles
  \draw[black!35, densely dotted] (0,2.6) node[left] {$\bar s_0$} -- (2.0,2.6);
  \draw[black!35, densely dotted] (0,4.1) node[left] {$\bar s_1$} -- (3.5,4.1);
  \node[below] at (2.0,0) {$\bar p_0$};
  \node[below] at (3.5,0) {$\bar p_1$};
\end{tikzpicture}
