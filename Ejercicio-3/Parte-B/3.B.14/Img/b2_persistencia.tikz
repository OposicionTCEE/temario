% Cuerpo, bloque 2, 3.4.1 (notas del usuario, tanda 2 de los bloques 2-3, 09/11/2026): la senda sobre el aspa de la paridad
% (base de b2_activos). Partiendo de A, sin diferencia de tipos (i = i*), una subida del tipo del euro a i1 desplaza a la derecha
% la vertical de los depósitos en euros. Si se espera que la subida sea pasajera, el tipo que se espera para mañana no cambia y
% el equilibrio pasa a B; si se espera que dure, el euro también estará caro mañana, baja el tipo que se espera, la recta de los
% depósitos en dólares se desplaza hacia abajo y el euro se aprecia hasta C, mucho más. Valores ilustrativos: i* = 3; i1 = 4,4;
% nu = 1,5; tipo que se espera, 3,6 o 2,6. Hecha a mano; compilar con: bash Code/generar_figura.sh b2_persistencia
\begin{tikzpicture}[font=\footnotesize, x=0.95cm, y=0.8cm]
% ejes
\draw[-{Stealth[length=1.8mm]}] (0,0) -- (8.6,0);
\node[anchor=north east] at (8.6,-0.45) {Rentabilidad en euros};
\draw[-{Stealth[length=1.8mm]}] (0,0) -- (0,5.0) node[anchor=south west] {Tipo de cambio, $s$};
% depósitos en euros, antes y después de la subida
\draw[black!30, line width=1pt, densely dashed] (3,0) -- (3,4.4) node[anchor=south east, text=black] {Euros, antes};
\draw[black!45, line width=1pt] (4.4,0) -- (4.4,4.4) node[anchor=south west, text=black] {Euros, después};
% depósitos en dólares: subida pasajera y subida que se espera que dure
\draw[black, line width=1pt] (1.8,{3.6-(1.8-3)/1.5}) -- (6.9,{3.6-(6.9-3)/1.5});
\draw[black, line width=1pt, densely dashed] (1.8,{2.6-(1.8-3)/1.5}) -- (5.9,{2.6-(5.9-3)/1.5});
\draw[-{Stealth[length=1.4mm]}, black!60] (2.2,4.03) -- (2.2,3.23);
% leyenda de las rectas de los dólares
\draw[black, line width=1pt] (5.6,3.8) -- (6.2,3.8) node[anchor=west, black] {Dólares: subida pasajera};
\draw[black, line width=1pt, densely dashed] (5.6,3.35) -- (6.2,3.35) node[anchor=west, black] {Dólares: subida duradera};
% equilibrios
\draw[black!45, dotted] (3,3.6) -- (0,3.6) node[anchor=east, black] {$s_A$};
\draw[black!45, dotted] (4.4,{3.6-1.4/1.5}) -- (0,{3.6-1.4/1.5}) node[anchor=east, black] {$s_B$};
\draw[black!45, dotted] (4.4,{2.6-1.4/1.5}) -- (0,{2.6-1.4/1.5}) node[anchor=east, black] {$s_C$};
\fill[white, draw=black] (3,3.6) circle (1.6pt) node[anchor=south east, inner sep=2pt] {$A$};
\fill (4.4,{3.6-1.4/1.5}) circle (1.7pt) node[anchor=south west, inner sep=2pt] {$B$};
\fill (4.4,{2.6-1.4/1.5}) circle (1.7pt) node[anchor=south west, inner sep=2pt] {$C$};
% tipos de interés
\node[anchor=north, fill=white, inner sep=1pt] at (3,-0.1) {$i^*$};
\node[anchor=north, fill=white, inner sep=1pt] at (4.4,-0.1) {$i_1$};
\end{tikzpicture}
