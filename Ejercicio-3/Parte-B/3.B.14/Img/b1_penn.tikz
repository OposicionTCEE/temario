% Cuerpo, bloque 1 (T14, 08/11/2026): efecto PENN estilizado. Nivel de precios de cada economía (paridad absoluta = 1) frente a su
% renta por habitante: los puntos se ordenan a lo largo de una recta creciente, por debajo de la paridad los pobres y cerca o por
% encima los ricos. Puntos ilustrativos, sin datos (los del ICP 2021 están en el anexo I, figura anx_penn).
% Hecha a mano; compilar con: bash Code/generar_figura.sh b1_penn
\begin{tikzpicture}
\footnotesize
\begin{axis}[
  scale only axis, width=9cm, height=5cm, axis lines=left, tick style={draw=none},
  every axis label/.style={font=\footnotesize}, tick label style={font=\footnotesize},
  xmin=0, xmax=10.4, ymin=0.3, ymax=1.25, clip=false,
  xtick=\empty, ytick={1}, yticklabels={$1$},
  xlabel={Renta por habitante}, ylabel={Nivel de precios},
]
\draw[black!60, densely dashed] (axis cs:0,1) -- (axis cs:10.4,1) node[anchor=west, font=\footnotesize, black] {Paridad absoluta};
\addplot[only marks, mark=*, mark size=1.6pt, black!45] coordinates {(1.96,0.51) (2.55,0.56) (2.74,0.47) (2.93,0.60) (3.31,0.65) (3.31,0.78) (4.15,0.70) (4.83,1.03) (4.85,0.77) (5.17,0.70) (5.86,0.93) (5.87,0.87) (5.92,0.88) (6.04,0.81) (6.23,0.86) (6.31,0.93) (6.64,1.02) (7.07,1.02) (7.27,0.86) (8.13,0.88) (8.14,1.02) (8.51,1.08) (8.89,0.98) (8.96,1.00) (9.02,0.99) (9.29,0.99) (9.55,1.12) (9.80,1.17)};
\draw[black, line width=1pt] (axis cs:0.6,0.37) -- (axis cs:9.9,1.16) node[anchor=west, font=\footnotesize] {Efecto PENN};
\end{axis}
\end{tikzpicture}
