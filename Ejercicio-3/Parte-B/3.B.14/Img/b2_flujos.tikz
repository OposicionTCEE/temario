% Cuerpo, bloque 2 (T15, 08/11/2026): enfoque de flujos. Oferta y demanda de dólares a cambio de euros (adaptada de b1_flujos del
% 3.B.13): ofrecen dólares los exportadores europeos y los inversores del exterior que compran activos en euros; los demandan los
% importadores europeos y los inversores europeos que compran activos en dólares. Si crece la renta europea, crecen las
% importaciones, la demanda se desplaza y el euro se deprecia de S0 a S1. Hecha a mano; compilar con: bash Code/generar_figura.sh b2_flujos
\begin{tikzpicture}[font=\footnotesize, x=1cm, y=1cm]
\draw[-{Stealth[length=1.8mm]}] (0,0) -- (9.2,0) node[anchor=north east, yshift=-0.1cm] {Dólares};
\draw[-{Stealth[length=1.8mm]}] (0,0) -- (0,5.2) node[anchor=south west] {Euros por dólar, $S$};
\draw[black, line width=1pt] (1.0,0.9) -- (7.6,4.6) node[anchor=west, align=left] {Oferta: exportaciones\\e inversión que entra};
\draw[black, line width=1pt, densely dashed] (1.0,4.4) -- (7.0,1.0) node[anchor=west, align=left] {Demanda: importaciones\\e inversión que sale};
\draw[black!55, line width=1pt, densely dashed] (2.4,4.9) -- (8.4,1.5) node[anchor=west, align=left] {Demanda con más\\renta europea};
% equilibrios: intersecciones de la oferta con las dos demandas
\coordinate (E0) at (intersection of 1.0,0.9--7.6,4.6 and 1.0,4.4--7.0,1.0);
\coordinate (E1) at (intersection of 1.0,0.9--7.6,4.6 and 2.4,4.9--8.4,1.5);
\draw[black!45, dotted] (E0) -- (E0 -| 0,0) node[anchor=east, black] {$S_0$};
\draw[black!45, dotted] (E1) -- (E1 -| 0,0) node[anchor=east, black] {$S_1$};
\draw[black!45, dotted] (E0) -- (E0 |- 0,0);
\draw[black!45, dotted] (E1) -- (E1 |- 0,0);
\fill[black] (E0) circle (1.7pt);
\fill[black] (E1) circle (1.7pt);
\end{tikzpicture}
