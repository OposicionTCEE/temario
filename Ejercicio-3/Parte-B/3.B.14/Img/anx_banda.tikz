% Ley del precio único con costes de transacción (HECKSCHER, 1916; OBSTFELD y TAYLOR, 1997): la desviación del precio
% del bien i, d_i = p_i - s - p_i^*, vaga sin tendencia dentro de la banda |d_i| <= c_i, donde no compensa arbitrar,
% y vuelve deprisa al borde cuando una perturbación la saca de ella. Figura abstracta, sin cifras.
% Compilar con: bash Code/generar_figura.sh anx_banda
\begin{tikzpicture}[x=1.08cm, y=1.15cm, font=\footnotesize]
  % banda de inacción
  \fill[black!8] (0,-1) rectangle (12.4,1);
  \draw[black!45] (0,1) -- (12.4,1);
  \draw[black!45] (0,-1) -- (12.4,-1);
  \draw[black!30, densely dotted] (0,0) -- (12.4,0);
  % ejes
  \draw[-{Stealth[length=2mm]}] (0,-2.15) -- (0,2.25) node[above] {$d_i=p_i-s-p_i^*$};
  \draw[-{Stealth[length=2mm]}] (0,-2.05) -- (12.8,-2.05) node[below left] {$t$};
  % rótulos de la banda
  \node[anchor=west] at (12.45,1) {$c_i$};
  \node[anchor=west] at (12.45,-1) {$-c_i$};
  \node[anchor=west] at (12.45,0) {$0$};
  \node[black!60] at (1.6,1.55) {$d_i>c_i$};
  \node[black!60] at (1.6,-1.55) {$d_i<-c_i$};
  \node[black!60] at (5.2,-0.55) {$|d_i|\le c_i$};
  % trayectoria: dentro de la banda vaga sin volver a cero; fuera, vuelve deprisa al borde
  \draw[black, line width=0.9pt, smooth, tension=0.55] plot coordinates {
    (0.1,0.10) (0.6,0.28) (1.2,-0.08) (1.8,0.32) (2.4,0.12) (3.0,0.46) (3.25,1.70)};
  \draw[black, line width=0.9pt, smooth, tension=0.55] plot coordinates {
    (3.25,1.70) (3.55,1.32) (3.85,1.12) (4.15,1.03) (4.6,0.97) (5.2,0.70) (5.8,0.82) (6.4,0.38) (7.0,0.18) (7.6,-0.30) (7.9,-1.75)};
  \draw[black, line width=0.9pt, smooth, tension=0.55] plot coordinates {
    (7.9,-1.75) (8.2,-1.34) (8.5,-1.12) (8.8,-1.03) (9.3,-0.95) (9.9,-0.66) (10.5,-0.82) (11.1,-0.42) (11.7,-0.55) (12.3,-0.30)};
  % perturbaciones y vuelta por arbitraje
  \draw[-{Stealth[length=1.6mm]}, black!55] (3.25,1.95) -- (3.25,1.74);
  \draw[-{Stealth[length=1.6mm]}, black!55] (7.9,-2.0) -- (7.9,-1.79);
  \draw[-{Stealth[length=1.6mm]}, black!55, densely dashed] (3.55,1.55) to[bend left=20] (4.35,1.12);
  \draw[-{Stealth[length=1.6mm]}, black!55, densely dashed] (8.2,-1.6) to[bend right=20] (9.0,-1.14);
\end{tikzpicture}
