% Base gráfica «senda»: (a) en t_0 aparece una diferencia de tipos de interés reales a favor de la zona del euro que se
% reduce poco a poco; (b) el tipo real cae en t_0 (apreciación del euro) en la suma de las diferencias esperadas y vuelve
% después al ancla, depreciándose cada periodo lo que marca la diferencia de ese periodo. Prima nula. Figura abstracta.
% Compilar con: bash Code/generar_figura.sh anx_senda
\begin{tikzpicture}[font=\footnotesize, x=1cm, y=1cm, >={Stealth[length=4pt]}]
  % (a) diferencia de tipos reales
  \begin{scope}[yshift=1.95cm]
    \node[anchor=south] at (7.0,1.1) {(a) Diferencia de tipos de interés reales};
    \draw[->] (0,0) -- (14.0,0) node[below left] {$t$};
    \draw[->] (0,-0.15) -- (0,1.1) node[left] {$r_t-r_t^*$};
    \node[left] at (0,0) {$0$};
    \draw[black!35, densely dotted] (4.5,0) -- (4.5,0.95);
    \node[below] at (4.5,0) {$t_0$};
    \draw[black, line width=1pt] (0.05,0) -- (4.5,0);
    \draw[black, line width=1pt] plot[smooth, domain=4.5:13.6] (\x, {0.75*exp(-0.5*(\x-4.5))});
    \fill (4.5,0.75) circle (1.4pt);
  \end{scope}
  % (b) tipo real
  \node[anchor=south] at (7.0,0.6) {(b) Tipo de cambio real};
  \draw[->] (0,-1.75) -- (14.0,-1.75) node[below left] {$t$};
  \draw[->] (0,-1.75) -- (0,0.6) node[left] {$q_t$};
  \draw[black!55, densely dashed] (0,0) -- (13.6,0) node[right] {$\bar q$};
  \draw[black!35, densely dotted] (4.5,-1.75) -- (4.5,0.3);
  \node[below] at (4.5,-1.75) {$t_0$};
  \draw[black, line width=1pt] (0.05,0) -- (4.5,0);
  \draw[black, line width=1pt] plot[smooth, domain=4.5:13.6] (\x, {-1.45*exp(-0.5*(\x-4.5))});
  \fill (4.5,-1.45) circle (1.4pt);
  \draw[decorate, decoration={brace, amplitude=3pt, mirror}, black!65] (4.3,0) -- (4.3,-1.45)
    node[midway, left=4pt, align=right] {$\mathbb{E}_{t_0}\sum_{j\geq 0}\left(r_{t_0+j}-r_{t_0+j}^*\right)$};
  \node[anchor=west, align=left, black!70] at (7.4,-1.05) {cada periodo se deprecia\\ en $r_t-r_t^*$};
\end{tikzpicture}
