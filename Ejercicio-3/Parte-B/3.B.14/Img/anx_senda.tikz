% Base gráfica «senda»: (a) en t_0 aparece una diferencia de tipos de interés reales a favor de la zona del euro que se
% reduce poco a poco; (b) el tipo real cae en t_0 (apreciación del euro) en la suma de las diferencias esperadas y vuelve
% después al ancla, depreciándose cada periodo lo que marca la diferencia de ese periodo. Prima nula. Figura abstracta.
% Compilar con: bash Code/generar_figura.sh anx_senda
\begin{tikzpicture}[font=\footnotesize, x=1cm, y=1cm, >={Stealth[length=4pt]}]
  % (a) diferencia de tipos reales
  \begin{scope}[yshift=3.3cm]
    \node[anchor=south] at (6.2,1.75) {(a) Diferencia de tipos de interés reales};
    \draw[->] (0,0) -- (12.6,0) node[below left] {$t$};
    \draw[->] (0,-0.2) -- (0,1.6) node[left] {$r_t-r_t^*$};
    \node[left] at (0,0) {$0$};
    \draw[black!35, densely dotted] (2.5,0) -- (2.5,1.4);
    \node[below] at (2.5,0) {$t_0$};
    \draw[black, line width=1pt] (0.05,0) -- (2.5,0);
    \draw[black, line width=1pt] plot[smooth, domain=2.5:12.2] (\x, {1.1*exp(-0.5*(\x-2.5))});
    \fill (2.5,1.1) circle (1.4pt);
  \end{scope}
  % (b) tipo real
  \node[anchor=south] at (6.2,1.0) {(b) Tipo de cambio real};
  \draw[->] (0,-2.8) -- (12.6,-2.8) node[below left] {$t$};
  \draw[->] (0,-2.8) -- (0,0.9) node[left] {$q_t$};
  \draw[black!55, densely dashed] (0,0) -- (12.2,0) node[right] {$\bar q$};
  \draw[black!35, densely dotted] (2.5,-2.8) -- (2.5,0.4);
  \node[below] at (2.5,-2.8) {$t_0$};
  \draw[black, line width=1pt] (0.05,0) -- (2.5,0);
  \draw[black, line width=1pt] plot[smooth, domain=2.5:12.2] (\x, {-2.2*exp(-0.5*(\x-2.5))});
  \fill (2.5,-2.2) circle (1.4pt);
  \draw[decorate, decoration={brace, amplitude=3pt, mirror}, black!65] (2.3,0) -- (2.3,-2.2)
    node[midway, left=4pt, align=right] {$\mathbb{E}_{t_0}\sum_{j\geq 0}\left(r_{t_0+j}-r_{t_0+j}^*\right)$};
  \node[anchor=west, align=left, black!70] at (5.6,-1.6) {cada periodo se deprecia\\ en $r_t-r_t^*$};
\end{tikzpicture}
