% Cuerpo, bloque 3, 4.1 (notas del usuario, tanda 3 de los bloques 2-3, 09/11/2026): la paradoja del margen a plazo y el enigma
% del nivel contados en el tiempo, base «trayectoria» del bloque 3 (sustituye en el cuerpo a b3_horizontes, que se borra, y a
% b3_paradoja, que pasa al anexo III.2.1 como anx_paradoja). Arriba, la apreciación del euro tras una subida de sus tipos en t0: en
% gris discontinuo, lo que predice la paridad no cubierta, que es la senda (salto y vuelta, 2 e^{-x/25}, con x = t - t0); en negro,
% lo que muestran los datos, la senda más una distancia, la cuña, G(x) = (0,6 + 0,35 x) e^{-x/12}, que empieza en 0,6 (el euro se
% aprecia de más), crece hasta x = 10,3 (sigue apreciándose: sobrerreacción retardada) y se cierra después. Abajo, la prima de los
% activos en euros en cada momento, lambda = G'(x): positiva mientras la distancia crece y negativa, durante años, mientras se
% cierra; la parte negativa pesa más (áreas 1,18 y 1,78, cuya diferencia es la distancia inicial). Valores ilustrativos, sin datos.
% Hecha a mano; compilar con: bash Code/generar_figura.sh b3_nivel
\begin{tikzpicture}
\footnotesize
\begin{axis}[name=pa,
  scale only axis, width=11cm, height=3.0cm, axis lines=left, tick style={draw=none},
  every axis label/.style={font=\footnotesize}, tick label style={font=\footnotesize}, title style={font=\footnotesize\bfseries},
  xmin=0, xmax=100, ymin=-0.2, ymax=3.5, clip=false, xtick=\empty, ytick={0}, yticklabels={$0$},
  title={Apreciación del euro},
  legend style={draw=none, fill=none, font=\footnotesize, at={(0.5,1.2)}, anchor=south, legend columns=-1,
    /tikz/every even column/.append style={column sep=0.5cm}},
]
\addplot[black!50, line width=1pt, densely dashed] coordinates {(0,0) (15,0) (15,2)};
\addlegendentry{Lo que predice la paridad no cubierta: la senda}
\addplot[black, line width=1pt] coordinates {(0,0) (15,0) (15,2.6)};
\addlegendentry{Lo que muestran los datos}
\addplot[black!50, line width=1pt, densely dashed, domain=15:100, samples=100, forget plot] {2*exp(-(x-15)/25)};
\addplot[black, line width=1pt, domain=15:100, samples=160, forget plot] {2*exp(-(x-15)/25)+(0.6+0.35*(x-15))*exp(-(x-15)/12)};
% la cuña, en su máximo
\draw[decorate, decoration={brace, amplitude=4pt}, black!70] (axis cs:25.3,3.07) -- (axis cs:25.3,1.36) node[midway, anchor=west, xshift=0.15cm] {cuña};
\draw[black!40, dotted] (axis cs:15,-0.2) -- (axis cs:15,2.6);
\end{axis}
\begin{axis}[at={(pa.south west)}, anchor=north west, yshift=-0.85cm,
  scale only axis, width=11cm, height=2.0cm, axis lines=left, tick style={draw=none},
  every axis label/.style={font=\footnotesize}, tick label style={font=\footnotesize}, title style={font=\footnotesize\bfseries},
  xmin=0, xmax=100, ymin=-0.16, ymax=0.34, clip=false, xtick={15}, xticklabels={$t_0$}, ytick={0}, yticklabels={$0$},
  title={Prima de los activos en euros, $\lambda$}, xlabel={Tiempo},
]
\draw[black!45] (axis cs:0,0) -- (axis cs:100,0);
\addplot[draw=none, fill=black!18, domain=15:25.29, samples=60] {(0.35-(0.6+0.35*(x-15))/12)*exp(-(x-15)/12)} \closedcycle;
\addplot[draw=none, fill=black!40, domain=25.29:100, samples=120] {(0.35-(0.6+0.35*(x-15))/12)*exp(-(x-15)/12)} \closedcycle;
\draw[black, line width=1pt] (axis cs:0,0) -- (axis cs:15,0) -- (axis cs:15,0.3);
\addplot[black, line width=1pt, domain=15:100, samples=160] {(0.35-(0.6+0.35*(x-15))/12)*exp(-(x-15)/12)};
\node[anchor=west, align=left] at (axis cs:21,0.2) {Positiva: el euro sigue apreciándose\\y rinde más de lo que pide la paridad};
\node[anchor=north west, align=left] at (axis cs:44,-0.065) {Negativa durante años: se deprecia más deprisa\\que en la senda y rinde menos; pesa más};
\draw[black!40, dotted] (axis cs:15,0.3) -- (axis cs:15,0.34);
\end{axis}
\end{tikzpicture}
