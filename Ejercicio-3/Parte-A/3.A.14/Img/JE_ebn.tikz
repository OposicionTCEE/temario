% Equilibrio bayesiano de Nash en la versión simultánea del juego de entrada con información incompleta (apartado «Información privada»).
% Elaboración propia a partir de HARSANYI (1967-1968).
% (a) Las dos matrices que J1 no puede distinguir; subrayado, la estrategia dominante de cada tipo de J2 (θ_ac: Alto, porque a2 > b2 y c2 > d2;
% θ_ag: Bajo, porque b̂2 > â2 y d̂2 > ĉ2). (b) Transformación de HARSANYI: la naturaleza elige el tipo; J1 no lo ve; J2 lo ve, pero no ve si J1 ha entrado.
\begin{tikzpicture}[font=\footnotesize, line cap=round,
    nd/.style={circle, fill=black, inner sep=0pt, minimum size=4.5pt},
    nat/.style={circle, draw=black, fill=white, line width=0.6pt, inner sep=0pt, minimum size=6pt},
    jug/.style={font=\footnotesize\bfseries},
    acc/.style={font=\footnotesize\itshape},
    pago/.style={font=\footnotesize},
    rama/.style={line width=0.6pt},
    info/.style={dashed, line width=0.6pt},
    tit/.style={font=\footnotesize\bfseries}]
  % Matriz 2x2 con el origen en la esquina superior izquierda: #1 título; #2-#5 pagos (Entrar, Alto), (Entrar, Bajo), (No entrar, Alto), (No entrar, Bajo)
  \def\matriz#1#2#3#4#5{%
    \fill[black!8] (0,0) rectangle (5.0,-1.1);
    \fill[black!8] (0,-1.1) rectangle (2.0,-2.5);
    \draw[line width=0.5pt] (2.0,0) -- (5.0,0);
    \draw[line width=0.5pt] (2.0,-0.55) -- (5.0,-0.55);
    \draw[line width=0.5pt] (0,-1.1) -- (5.0,-1.1);
    \draw[line width=0.5pt] (0.5,-1.8) -- (5.0,-1.8);
    \draw[line width=0.5pt] (0,-2.5) -- (5.0,-2.5);
    \draw[line width=0.5pt] (0,-1.1) -- (0,-2.5);
    \draw[line width=0.5pt] (0.5,-1.1) -- (0.5,-2.5);
    \draw[line width=0.5pt] (2.0,0) -- (2.0,-2.5);
    \draw[line width=0.5pt] (3.5,-0.55) -- (3.5,-2.5);
    \draw[line width=0.5pt] (5.0,0) -- (5.0,-2.5);
    \node[font=\footnotesize] at (2.5,0.35) {#1};
    \node[jug] at (3.5,-0.275) {J2};
    \node[acc] at (2.75,-0.825) {Alto};
    \node[acc] at (4.25,-0.825) {Bajo};
    \node[jug] at (0.25,-1.8) {J1};
    \node[acc] at (1.25,-1.45) {Entrar};
    \node[acc] at (1.25,-2.15) {No entrar};
    \node at (2.75,-1.45) {#2};
    \node at (4.25,-1.45) {#3};
    \node at (2.75,-2.15) {#4};
    \node at (4.25,-2.15) {#5};
  }
  % (a) Las dos matrices
  \node[tit] at (8,1.15) {(a) Información incompleta: J1 no sabe qué matriz rige};
  \begin{scope}[shift={(1.6,0)}]
    \matriz{J2 de tipo $\theta_{ac}$ (probabilidad $p$)}{$a_1,\ \underline{a_2}$}{$b_1,\ b_2$}{$c_1,\ \underline{c_2}$}{$d_1,\ d_2$}
  \end{scope}
  \begin{scope}[shift={(9.4,0)}]
    \matriz{J2 de tipo $\theta_{ag}$ (probabilidad $1-p$)}{$a_1,\ \hat{a}_2$}{$b_1,\ \underline{\hat{b}_2}$}{$c_1,\ \hat{c}_2$}{$d_1,\ \underline{\hat{d}_2}$}
  \end{scope}
  % (b) Transformación de HARSANYI
  \node[tit] at (8,-3.2) {(b) Transformación de HARSANYI};
  \node[nat, label=above:{\textbf{Naturaleza}}] (n) at (8,-4.05) {};
  \node[nd] (j1) at (4,-5.25) {};
  \node[nd] (j2) at (12,-5.25) {};
  \draw[rama] (n) -- node[acc, above left] {$\theta_{ac}$ ($p$)} (j1);
  \draw[rama] (n) -- node[acc, above right] {$\theta_{ag}$ ($1-p$)} (j2);
  \draw[info] (j1) -- (j2);
  \node[jug, fill=white, inner sep=1.5pt] at (8,-5.25) {J1};
  \node[nd] (k1) at (2.1,-6.45) {};
  \node[nd] (k2) at (5.9,-6.45) {};
  \node[nd] (k3) at (10.1,-6.45) {};
  \node[nd] (k4) at (13.9,-6.45) {};
  \draw[info] (k1) -- (k2);
  \draw[info] (k3) -- (k4);
  \node[jug, fill=white, inner sep=1.5pt] at (4,-6.45) {J2};
  \node[jug, fill=white, inner sep=1.5pt] at (12,-6.45) {J2};
  \draw[rama] (j1) -- node[acc, above left] {Entrar} (k1);
  \draw[rama] (j1) -- node[acc, above right] {No entrar} (k2);
  \draw[rama] (j2) -- node[acc, above left] {Entrar} (k3);
  \draw[rama] (j2) -- node[acc, above right] {No entrar} (k4);
  \foreach \p/\x/\l/\pos/\pg in {k1/1.15/Alto/left/{(a_1,\,a_2)}, k1/3.05/Bajo/right/{(b_1,\,b_2)}, k2/4.95/Alto/left/{(c_1,\,c_2)}, k2/6.85/Bajo/right/{(d_1,\,d_2)},
                                 k3/9.15/Alto/left/{(a_1,\,\hat{a}_2)}, k3/11.05/Bajo/right/{(b_1,\,\hat{b}_2)}, k4/12.95/Alto/left/{(c_1,\,\hat{c}_2)}, k4/14.85/Bajo/right/{(d_1,\,\hat{d}_2)}} {
    \node[nd] (t) at (\x,-7.65) {};
    \draw[rama] (\p) -- node[acc, \pos] {\l} (t);
    \node[pago, below] at (t.south) {$\pg$};
  }
\end{tikzpicture}
