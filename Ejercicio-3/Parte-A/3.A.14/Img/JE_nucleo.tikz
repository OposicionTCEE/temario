% Núcleo del juego de tres jugadores que reparten 100 euros. Elaboración propia.
\begin{tikzpicture}[font=\footnotesize, line cap=round,
    nd/.style={circle, fill=black, inner sep=0pt, minimum size=4.5pt},
    jug/.style={font=\footnotesize\bfseries},
    acc/.style={font=\footnotesize\itshape},
    pago/.style={font=\footnotesize},
    rama/.style={line width=0.6pt},
    info/.style={dashed, line width=0.6pt},
    tit/.style={font=\footnotesize\bfseries},
    nota/.style={font=\footnotesize, align=left}]
  \node[tit] at (2.50,5.90) {(a) Las restricciones};
  \draw[-{Latex[length=2mm]}, line width=0.6pt] (0.00,0.00) -- (5.60,0.00) node[right] {$x_1$};
  \draw[-{Latex[length=2mm]}, line width=0.6pt] (0.00,0.00) -- (0.00,5.50) node[above] {$x_2$};
  \draw[line width=1.1pt] (0.00,5.00) -- (5.00,0.00);
  \draw[line width=0.5pt] (1.00,0.00) -- (1.00,4.00);
  \draw[line width=0.5pt] (4.00,0.00) -- (4.00,1.00);
  \draw[line width=0.5pt] (0.00,4.00) -- (1.00,4.00);
  \draw[line width=0.5pt] (0.00,1.00) -- (4.00,1.00);
  \draw[info] (0.00,4.00) -- (4.00,0.00);
  \draw[info] (0.00,1.00) -- (1.00,0.00);
  \node[font=\scriptsize, anchor=east] at (0.00,4.00) {$(0,80,20)$};
  \node[font=\scriptsize, anchor=east] at (0.00,1.00) {$(0,20,80)$};
  \node[font=\scriptsize, anchor=north] at (1.00,0.00) {$(20,0,80)$};
  \node[font=\scriptsize, anchor=north] at (4.00,0.00) {$(80,0,20)$};
  \node[font=\scriptsize, anchor=south west] at (1.00,4.00) {$(20,80,0)$};
  \node[font=\scriptsize, anchor=south west] at (4.00,1.00) {$(80,20,0)$};
  \fill[red!18] (7.60,1.00) -- (7.60,4.00) -- (8.60,4.00) -- (11.60,1.00) -- (11.60,0.00) -- (8.60,0.00) -- cycle;
  \node[tit] at (10.10,5.90) {(b) El núcleo (sombreado)};
  \draw[-{Latex[length=2mm]}, line width=0.6pt] (7.60,0.00) -- (13.20,0.00) node[right] {$x_1$};
  \draw[-{Latex[length=2mm]}, line width=0.6pt] (7.60,0.00) -- (7.60,5.50) node[above] {$x_2$};
  \draw[line width=1.1pt] (7.60,5.00) -- (12.60,0.00);
  \draw[line width=0.5pt] (8.60,0.00) -- (8.60,4.00);
  \draw[line width=0.5pt] (11.60,0.00) -- (11.60,1.00);
  \draw[line width=0.5pt] (7.60,4.00) -- (8.60,4.00);
  \draw[line width=0.5pt] (7.60,1.00) -- (11.60,1.00);
  \draw[info] (7.60,4.00) -- (11.60,0.00);
  \draw[info] (7.60,1.00) -- (8.60,0.00);
  \node[font=\scriptsize, anchor=east] at (7.60,4.00) {$(0,80,20)$};
  \node[font=\scriptsize, anchor=east] at (7.60,1.00) {$(0,20,80)$};
  \node[font=\scriptsize, anchor=north] at (8.60,0.00) {$(20,0,80)$};
  \node[font=\scriptsize, anchor=north] at (11.60,0.00) {$(80,0,20)$};
  \node[font=\scriptsize, anchor=south west] at (8.60,4.00) {$(20,80,0)$};
  \node[font=\scriptsize, anchor=south west] at (11.60,1.00) {$(80,20,0)$};
  \node[nota, anchor=north west, text width=12.6cm] at (0,-0.75) {Cada punto es un reparto $(x_1,x_2,x_3)$ con $x_3=100-x_1-x_2$. Las rectas marcan $x_1+x_2=20$ y $x_1+x_2=80$ (discontinuas), $x_1=20$, $x_1=80$, $x_2=20$ y $x_2=80$. En (b), los repartos que cumplen $x_i+x_j\geq 20$ y $x_i\geq 0$.};
\end{tikzpicture}
