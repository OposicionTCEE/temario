% Bloque 2, «Primer precio»: funciones de puja de equilibrio b(θ) = E[Y | Y < θ] con un solo bono.
% (a) Competencia: valoraciones uniformes en [0, θ̄]; b(θ) = (n-1)θ/n para n y n' > n (ilustrativos n = 3, n' = 8);
%     se marca b* en θ_i = 0,9 θ̄ para n, el mismo punto que en JE_sub_primer.
% (b) Distribución, con n dado (n = 3): F uniforme, b = (n-1)θ/n; F' = (θ/θ̄)^a con a = 2, que concentra las valoraciones
%     en los valores altos, b = a(n-1)θ/[a(n-1)+1] = 0,8 θ. Recuadro: densidades f (plana) y f' (creciente).
\begin{tikzpicture}[font=\footnotesize, line cap=round,
    eje/.style={-{Stealth[length=2mm]}, line width=0.5pt},
    ref/.style={black!45, line width=0.6pt, dotted},
    guia/.style={black!50, line width=0.5pt, densely dotted},
    tit/.style={font=\footnotesize\bfseries}]
  \def\u{5.2}   % ancho de [0, θ̄]
  \def\v{3.4}   % alto de una unidad
  % ---------- (a) Competencia ----------
  \node[tit] at (0.5*\u,1.32*\v) {(a) Competencia: $n'>n$};
  \draw[eje] (0,0) -- (\u+0.45,0) node[below] {$\theta$};
  \draw[eje] (0,0) -- (0,1.2*\v) node[left] {$b$};
  \draw (0,0) node[below left] {$0$};
  \draw (\u,0) -- (\u,-0.08) node[below] {$\bar{\theta}$};
  \draw[black!30] (\u,0) -- (\u,1.1*\v);
  \draw[ref] (0,0) -- (\u,\v) node[right, black!60] {$b=\theta$};
  \draw[line width=1.3pt, dashed] (0,0) -- (\u,0.875*\v) node[right] {$\frac{n'-1}{n'}\,\theta$};
  \draw[line width=1.3pt] (0,0) -- (\u,0.6667*\v) node[right] {$\frac{n-1}{n}\,\theta$};
  \draw[guia] (0.9*\u,0) -- (0.9*\u,0.6*\v) -- (0,0.6*\v);
  \fill (0.9*\u,0.6*\v) circle (1.8pt);
  \draw (0.9*\u,0) -- (0.9*\u,-0.08) node[below] {$\theta_i$};
  \draw (0,0.6*\v) -- (-0.08,0.6*\v) node[left] {$b^*$};
  % ---------- (b) Distribución ----------
  \begin{scope}[shift={(8.6,0)}]
    \node[tit] at (0.5*\u,1.32*\v) {(b) Distribución, con $n$ dado};
    \draw[eje] (0,0) -- (\u+0.45,0) node[below] {$\theta$};
    \draw[eje] (0,0) -- (0,1.2*\v) node[left] {$b$};
    \draw (0,0) node[below left] {$0$};
    \draw (\u,0) -- (\u,-0.08) node[below] {$\bar{\theta}$};
    \draw[black!30] (\u,0) -- (\u,1.1*\v);
    \draw[ref] (0,0) -- (\u,\v) node[right, black!60] {$b=\theta$};
    \draw[line width=1.3pt, dashed] (0,0) -- (\u,0.8*\v) node[right] {$F'$};
    \draw[line width=1.3pt] (0,0) -- (\u,0.6667*\v) node[right] {$F$};
    % recuadro con las densidades de las valoraciones
    \begin{scope}[shift={(0.35,0.62*\v)}]
      \def\w{1.5} \def\h{0.85}
      \draw[-{Stealth[length=1.5mm]}, line width=0.4pt] (0,0) -- (\w+0.2,0);
      \draw[-{Stealth[length=1.5mm]}, line width=0.4pt] (0,0) -- (0,\h+0.15);
      \draw[line width=0.9pt] (0,0.5*\h) -- (\w,0.5*\h) node[right] {$f$};
      \draw[line width=0.9pt, dashed] (0,0) -- (\w,\h) node[right] {$f'$};
    \end{scope}
  \end{scope}
\end{tikzpicture}
