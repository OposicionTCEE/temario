% Equilibrio de Nash en estrategias mixtas en la versión simultánea del juego de entrada con J2 agresivo (apartado «Equilibrio de Nash en estrategias mixtas»). Elaboración propia.
% J1 entra con probabilidad p; J2 baja el precio con probabilidad q. Pagos: a1 > c1 = d1 > b1; b2 > a2; c2 > d2.
% Mejor respuesta de J1: entrar (p = 1) si q < q*, no entrar (p = 0) si q > q*, con q* = (a1 - c1)/(a1 - b1).
% Mejor respuesta de J2: bajar el precio (q = 1) si p > p*, mantenerlo (q = 0) si p < p*, con p* = (c2 - d2)/[(b2 - a2) + (c2 - d2)].
% Las posiciones de q* y p* en el panel (b) son ilustrativas.
\begin{tikzpicture}[font=\footnotesize, line cap=round,
    jug/.style={font=\footnotesize\bfseries},
    acc/.style={font=\footnotesize\itshape},
    tit/.style={font=\footnotesize\bfseries},
    mr1/.style={line width=1.6pt},
    mr2/.style={line width=1.3pt, dashed}]
  % (a) Matriz con las probabilidades de cada estrategia
  \node[tit] at (3.45,0.9) {(a) J2 agresivo: $b_2>a_2$};
  \begin{scope}[shift={(0,0.3)}]
    \fill[black!8] (0,0) rectangle (6.9,-1.2);
    \fill[black!8] (0,-1.2) rectangle (3.1,-2.6);
    \draw[line width=0.5pt] (3.1,0) -- (6.9,0);
    \draw[line width=0.5pt] (3.1,-0.6) -- (6.9,-0.6);
    \draw[line width=0.5pt] (0,-1.2) -- (6.9,-1.2);
    \draw[line width=0.5pt] (0.5,-1.9) -- (6.9,-1.9);
    \draw[line width=0.5pt] (0,-2.6) -- (6.9,-2.6);
    \draw[line width=0.5pt] (0,-1.2) -- (0,-2.6);
    \draw[line width=0.5pt] (0.5,-1.2) -- (0.5,-2.6);
    \draw[line width=0.5pt] (3.1,0) -- (3.1,-2.6);
    \draw[line width=0.5pt] (5.0,-0.6) -- (5.0,-2.6);
    \draw[line width=0.5pt] (6.9,0) -- (6.9,-2.6);
    \node[jug] at (5.0,-0.3) {J2};
    \node[acc] at (4.05,-0.9) {Alto ($1-q$)};
    \node[acc] at (5.95,-0.9) {Bajo ($q$)};
    \node[jug] at (0.25,-1.9) {J1};
    \node[acc] at (1.8,-1.55) {Entrar ($p$)};
    \node[acc] at (1.8,-2.25) {No entrar ($1-p$)};
    \node at (4.05,-1.55) {$a_1,\ a_2$};
    \node at (5.95,-1.55) {$b_1,\ b_2$};
    \node at (4.05,-2.25) {$c_1,\ c_2$};
    \node at (5.95,-2.25) {$d_1,\ d_2$};
  \end{scope}
  % (b) Mejores respuestas en el cuadrado (q, p)
  \node[tit] at (11.2,0.9) {(b) Mejores respuestas};
  \begin{scope}[shift={(8.9,-4.6)}]
    \def\u{4.4}
    \def\qs{0.4}
    \def\ps{0.6}
    \draw[line width=0.4pt, black!35] (0,0) rectangle (\u,\u);
    \draw[-{Stealth[length=2mm]}, line width=0.5pt] (0,0) -- (\u+0.5,0) node[below left, xshift=-2pt] {$q$};
    \draw[-{Stealth[length=2mm]}, line width=0.5pt] (0,0) -- (0,\u+0.5) node[below left] {$p$};
    \draw (0,0) -- (0,-0.08) node[below] {$0$};
    \draw (\qs*\u,0) -- (\qs*\u,-0.08) node[below] {$q^*$};
    \draw (\u,0) -- (\u,-0.08) node[below] {$1$};
    \draw (0,\ps*\u) -- (-0.08,\ps*\u) node[left] {$p^*$};
    \draw (0,\u) -- (-0.08,\u) node[left] {$1$};
    \draw[line width=0.4pt, black!35, dotted] (\qs*\u,0) -- (\qs*\u,\ps*\u) -- (0,\ps*\u);
    % Mejor respuesta de J1: p en función de q
    \draw[mr1] (0,\u) -- (\qs*\u,\u) -- (\qs*\u,0) -- (\u,0);
    % Mejor respuesta de J2: q en función de p
    \draw[mr2] (0,0) -- (0,\ps*\u) -- (\u,\ps*\u) -- (\u,\u);
    \fill (\qs*\u,\ps*\u) circle (2.6pt);
    \node[font=\footnotesize, fill=white, inner sep=1pt, anchor=south west] at (\qs*\u+0.08,\ps*\u+0.08) {EN};
    \node[font=\footnotesize, anchor=south] at (0.2*\u,\u+0.05) {MR de J1};
    \node[font=\footnotesize, anchor=west] at (\u+0.1,0.8*\u) {MR de J2};
  \end{scope}
\end{tikzpicture}
