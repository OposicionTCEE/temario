% Bloque 2, «Equivalencia de ingresos»: la subasta del Tesoro con k bonos y demanda unitaria.
% Eje horizontal: bonos (entidades ordenadas de mayor a menor puja); vertical: precio. La oferta es la vertical en k.
% (a) Precio uniforme (pagando la primera puja rechazada): las entidades pujan su valoración; las k primeras ganan y todas pagan θ_(k+1);
%     ingreso = rectángulo sombreado.
% (b) Precios múltiples: las mismas valoraciones (punteadas) y las pujas de equilibrio b(θ) = E[Y_k | Y_k < θ], más bajas; cada ganadora
%     paga la suya; ingreso = área sombreada bajo la escalera de pujas.
% Valores ilustrativos: θ̄ = 1, siete entidades, cuatro bonos, valoraciones en sus valores esperados (7/8, 6/8, …, 1/8) y pujas de equilibrio
% calculadas con valoraciones uniformes (0,427; 0,414; 0,380; 0,327; 0,258; 0,178; 0,092). Ingresos: 1,50 en (a) y 1,55 en (b), iguales en esperanza.
\begin{tikzpicture}[font=\footnotesize, line cap=round,
    eje/.style={-{Stealth[length=2mm]}, line width=0.5pt},
    val/.style={black!50, line width=0.7pt, dotted},
    puja/.style={line width=1.3pt},
    tit/.style={font=\footnotesize\bfseries}]
  \def\w{0.8}   % ancho de un bono
  \def\v{4.0}   % alto de θ̄
  \def\k{4}
  % ---------- (a) ----------
  \node[tit] at (3.0,1.08*\v) {(a) Precio uniforme};
  \begin{scope}
    \fill[black!15] (0,0) rectangle (\k*\w,0.375*\v);
    \draw[eje] (0,0) -- (7*\w+0.6,0) node[below] {Bonos};
    \draw[eje] (0,0) -- (0,1.0*\v) node[left] {Precio};
    \draw (0,0) node[below left] {$0$};
    \draw[puja] (0,0.875*\v) \foreach \x/\y in {1/0.875,2/0.75,3/0.625,4/0.5,5/0.375,6/0.25,7/0.125} { -- (\x*\w-\w,\y*\v) -- (\x*\w,\y*\v) } -- (7*\w,0);
    \draw[line width=0.9pt] (\k*\w,0) -- (\k*\w,0.95*\v);
    \draw (\k*\w,0) node[below] {$k$};
    \draw[black!50, densely dashed] (0,0.375*\v) -- (5*\w,0.375*\v);
    \draw (0,0.375*\v) -- (-0.08,0.375*\v) node[left] {$\theta_{(k+1)}$};
    \node[right] at (7*\w,0.2*\v) {$b=\theta$};
  \end{scope}
  % ---------- (b) ----------
  \begin{scope}[shift={(8.2,0)}]
    \node[tit] at (3.0,1.08*\v) {(b) Precios múltiples};
    \fill[black!15] (0,0) -- (0,0.427*\v) -- (\w,0.427*\v) -- (\w,0.414*\v) -- (2*\w,0.414*\v) -- (2*\w,0.380*\v) -- (3*\w,0.380*\v) -- (3*\w,0.327*\v) -- (4*\w,0.327*\v) -- (4*\w,0) -- cycle;
    \draw[eje] (0,0) -- (7*\w+0.6,0) node[below] {Bonos};
    \draw[eje] (0,0) -- (0,1.0*\v) node[left] {Precio};
    \draw (0,0) node[below left] {$0$};
    \draw[val] (0,0.875*\v) \foreach \x/\y in {1/0.875,2/0.75,3/0.625,4/0.5,5/0.375,6/0.25,7/0.125} { -- (\x*\w-\w,\y*\v) -- (\x*\w,\y*\v) } -- (7*\w,0);
    \draw[puja] (0,0.427*\v) \foreach \x/\y in {1/0.427,2/0.414,3/0.380,4/0.327,5/0.258,6/0.178,7/0.092} { -- (\x*\w-\w,\y*\v) -- (\x*\w,\y*\v) } -- (7*\w,0);
    \draw[line width=0.9pt] (\k*\w,0) -- (\k*\w,0.95*\v);
    \draw (\k*\w,0) node[below] {$k$};
    \node[right, black!60] at (2*\w+0.05,0.72*\v) {$\theta$};
    \node[right] at (7*\w,0.12*\v) {$b(\theta)$};
  \end{scope}
\end{tikzpicture}
