% Forma extensiva y estrategias dominadas: D domina a C para J2. J2 no observa la jugada de J1 (línea discontinua), de modo que la matriz 2x2 es su forma normal exacta. Elaboración propia.
\begin{tikzpicture}[font=\footnotesize, line cap=round,
    nd/.style={circle, fill=black, inner sep=0pt, minimum size=4.5pt},
    jug/.style={font=\footnotesize\bfseries},
    acc/.style={font=\footnotesize\itshape},
    pago/.style={font=\footnotesize},
    rama/.style={line width=0.6pt},
    info/.style={dashed, line width=0.6pt},
    tit/.style={font=\footnotesize\bfseries},
    nota/.style={font=\footnotesize, align=left}]
  \node[nd, label=above:{\textbf{J1}}] (r) at (2.4,3.3) {};
  \node[nd, label=left:{\textbf{J2}}] (a1) at (1.1,1.9) {};
  \node[nd, label=right:{\textbf{J2}}] (a2) at (3.7,1.9) {};
  \draw[info] (a1) -- (a2);
  \draw[rama] (r) -- node[acc, above left] {A} (a1);
  \draw[rama] (r) -- node[acc, above right] {B} (a2);
  \foreach \p/\x/\l/\pos/\pg in {a1/0.5/C/left/{(0,\,2)}, a1/1.7/D/right/{(5,\,5)}, a2/3.1/C/left/{(5,\,1)}, a2/4.3/D/right/{(3,\,2)}} {
    \node[nd] (t) at (\x,0.6) {};
    \draw[rama] (\p) -- node[acc, \pos] {\l} (t);
    \node[pago, below] at (t.south) {$\pg$};
  }
  \node[pago, anchor=east, align=right] at (0.0,0.27) {Pagos:\\(J1, J2)};
  % Matriz de pagos: J2 (filas) frente a J1 (columnas)
  \fill[black!8] (6.200,3.000) rectangle (11.300,1.800);
  \fill[black!8] (6.200,1.800) rectangle (7.900,0.600);
  \fill[cyan!22, rounded corners=4pt] (7.960,1.140) rectangle (9.540,0.660);
  \fill[cyan!22, rounded corners=4pt] (9.660,1.140) rectangle (11.240,0.660);
  \draw[line width=0.5pt] (7.900,3.000) -- (11.300,3.000);
  \draw[line width=0.5pt] (7.900,2.400) -- (11.300,2.400);
  \draw[line width=0.5pt] (6.200,1.800) -- (11.300,1.800);
  \draw[line width=0.5pt] (6.950,1.200) -- (11.300,1.200);
  \draw[line width=0.5pt] (6.950,0.600) -- (11.300,0.600);
  \draw[line width=0.5pt] (6.200,0.600) -- (6.950,0.600);
  \draw[line width=0.5pt] (6.200,1.800) -- (6.200,0.600);
  \draw[line width=0.5pt] (6.950,1.800) -- (6.950,0.600);
  \draw[line width=0.5pt] (7.900,3.000) -- (7.900,0.600);
  \draw[line width=0.5pt] (9.600,2.400) -- (9.600,0.600);
  \draw[line width=0.5pt] (11.300,3.000) -- (11.300,0.600);
  \node[jug] at (9.600,2.700) {J1};
  \node[acc] at (8.750,2.100) {A};
  \node[acc] at (10.450,2.100) {B};
  \node[jug] at (6.575,1.200) {J2};
  \node[acc] at (7.425,1.500) {C};
  \node at (8.750,1.500) {$0,\ 2$};
  \node at (10.450,1.500) {$5,\ 1$};
  \node[acc] at (7.425,0.900) {D};
  \node at (8.750,0.900) {$5,\ 5$};
  \node at (10.450,0.900) {$3,\ 2$};
  \node[nota, anchor=north west, text width=5.6cm] at (6.2,0.4) {Pagos de cada celda: (J1, J2). J2 no observa la jugada de J1 (línea discontinua). Sombreada, la estrategia $D$ de J2, que domina a $C$ haga lo que haga J1.};
\end{tikzpicture}
