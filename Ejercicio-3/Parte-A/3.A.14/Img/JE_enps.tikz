% Equilibrio de Nash perfecto en subjuegos en la versión secuencial del juego de entrada (apartado «Credibilidad»). Elaboración propia.
% Trazo grueso: lo que elige cada jugador por inducción hacia atrás. Recuadros punteados: los dos subjuegos propios (los que empiezan en los nodos de J2).
% (a) J2 acomodaticio (a2 > b2): la amenaza de guerra no es creíble; ENPS (Entrar; Alto, Alto).
% (b) J2 agresivo (b2 > a2): la amenaza es creíble; ENPS (No entrar; Bajo, Alto). En los dos casos, a1 > c1 = d1 > b1 y c2 > d2.
\begin{tikzpicture}[font=\footnotesize, line cap=round,
    nd/.style={circle, fill=black, inner sep=0pt, minimum size=4.5pt},
    acc/.style={font=\footnotesize\itshape},
    pago/.style={font=\footnotesize},
    rama/.style={line width=0.6pt},
    elegida/.style={line width=1.8pt},
    sub/.style={draw=black!45, line width=0.5pt, dotted, rounded corners=6pt},
    tit/.style={font=\footnotesize\bfseries}]
  % \arbol{centro}{rama tras Entrar: 1 Alto, 2 Bajo}{rama de J1: 1 Entrar, 2 No entrar}
  \def\arbol#1#2#3{%
    \begin{scope}[shift={(#1,0)}]
      \node[nd, label=above:{\textbf{J1}}] (r) at (0,2.8) {};
      \node[nd, label=left:{\textbf{J2}}] (i1) at (-1.7,1.5) {};
      \node[nd, label=right:{\textbf{J2}}] (i2) at (1.7,1.5) {};
      \draw[sub] (-2.75,1.85) rectangle (-0.65,-0.55);
      \draw[sub] (0.65,1.85) rectangle (2.75,-0.55);
      \ifnum#3=1
        \draw[elegida] (r) -- node[acc, above left] {Entrar} (i1);
        \draw[rama] (r) -- node[acc, above right] {No entrar} (i2);
      \else
        \draw[rama] (r) -- node[acc, above left] {Entrar} (i1);
        \draw[elegida] (r) -- node[acc, above right] {No entrar} (i2);
      \fi
      \node[nd] (t1) at (-2.3,0.2) {}; \node[nd] (t2) at (-1.1,0.2) {};
      \node[nd] (t3) at (1.1,0.2) {}; \node[nd] (t4) at (2.3,0.2) {};
      \ifnum#2=1
        \draw[elegida] (i1) -- node[acc, left] {Alto} (t1); \draw[rama] (i1) -- node[acc, right] {Bajo} (t2);
      \else
        \draw[rama] (i1) -- node[acc, left] {Alto} (t1); \draw[elegida] (i1) -- node[acc, right] {Bajo} (t2);
      \fi
      \draw[elegida] (i2) -- node[acc, left] {Alto} (t3); \draw[rama] (i2) -- node[acc, right] {Bajo} (t4);
      \foreach \t/\pg in {t1/{(a_1,\,a_2)}, t2/{(b_1,\,b_2)}, t3/{(c_1,\,c_2)}, t4/{(d_1,\,d_2)}} {\node[pago, below] at (\t.south) {$\pg$};}
    \end{scope}}
  \node[tit] at (3.6,3.75) {(a) J2 acomodaticio: $a_2>b_2$};
  \arbol{3.6}{1}{1}
  \node[pago] at (3.6,-0.95) {ENPS: (Entrar; Alto, Alto)};
  \node[tit] at (11.8,3.75) {(b) J2 agresivo: $b_2>a_2$};
  \arbol{11.8}{2}{2}
  \node[pago] at (11.8,-0.95) {ENPS: (No entrar; Bajo, Alto)};
\end{tikzpicture}
