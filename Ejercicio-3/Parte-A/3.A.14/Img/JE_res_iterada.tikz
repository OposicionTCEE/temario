% Eliminación iterada de estrategias estrictamente dominadas en la versión simultánea del juego de entrada, J2 acomodaticio. Elaboración propia.
% (a) Juego inicial. (b) Primera ronda: J2, racional, descarta Bajo (a2 > b2, c2 > d2). (c) Segunda ronda: J1, que sabe que J2 es racional, descarta No entrar (a1 > c1).
\begin{tikzpicture}[font=\footnotesize, line cap=round,
    jug/.style={font=\footnotesize\bfseries},
    acc/.style={font=\footnotesize\itshape},
    pago/.style={font=\footnotesize},
    tit/.style={font=\footnotesize\bfseries},
    tapa/.style={fill=white, opacity=0.72}]
  % \matriz{x}{y}: matriz 2x2 del juego con el origen en la esquina superior izquierda
  \def\matriz#1#2{%
    \begin{scope}[shift={(#1,#2)}]
      \fill[black!8] (0,0) rectangle (4.5,-1.1);
      \fill[black!8] (0,-1.1) rectangle (1.9,-2.5);
      \draw[line width=0.5pt] (1.9,0) -- (4.5,0);
      \draw[line width=0.5pt] (1.9,-0.55) -- (4.5,-0.55);
      \draw[line width=0.5pt] (0,-1.1) -- (4.5,-1.1);
      \draw[line width=0.5pt] (0.5,-1.8) -- (4.5,-1.8);
      \draw[line width=0.5pt] (0,-2.5) -- (4.5,-2.5);
      \draw[line width=0.5pt] (0,-1.1) -- (0,-2.5);
      \draw[line width=0.5pt] (0.5,-1.1) -- (0.5,-2.5);
      \draw[line width=0.5pt] (1.9,0) -- (1.9,-2.5);
      \draw[line width=0.5pt] (3.2,-0.55) -- (3.2,-2.5);
      \draw[line width=0.5pt] (4.5,0) -- (4.5,-2.5);
      \node[jug] at (3.2,-0.275) {J2};
      \node[acc] at (2.55,-0.825) {Alto};
      \node[acc] at (3.85,-0.825) {Bajo};
      \node[jug] at (0.25,-1.8) {J1};
      \node[acc] at (1.2,-1.45) {Entrar};
      \node[acc] at (1.2,-2.15) {No entrar};
      \node at (2.55,-1.45) {$a_1,\ a_2$};
      \node at (3.85,-1.45) {$b_1,\ b_2$};
      \node at (2.55,-2.15) {$c_1,\ c_2$};
      \node at (3.85,-2.15) {$d_1,\ d_2$};
    \end{scope}}
  % (a) Juego inicial
  \node[tit] at (2.25,0.45) {(a) Juego inicial};
  \matriz{0}{0}
  % (b) Primera ronda: se descarta Bajo
  \node[tit] at (7.75,0.45) {(b) Primera ronda};
  \matriz{5.5}{0}
  \fill[tapa] (8.7,-0.55) rectangle (10.0,-2.5);
  \draw[line width=0.6pt] (8.8,-1.2) -- (9.9,-2.4);
  \node[pago] at (7.75,-2.95) {J2: $a_2>b_2$ y $c_2>d_2$};
  % (c) Segunda ronda: se descarta No entrar
  \node[tit] at (13.25,0.45) {(c) Segunda ronda};
  \matriz{11}{0}
  \fill[tapa] (14.2,-0.55) rectangle (15.5,-2.5);
  \fill[tapa] (11.5,-1.8) rectangle (14.2,-2.5);
  \draw[line width=0.6pt] (14.3,-1.2) -- (15.4,-2.4);
  \draw[line width=0.6pt] (11.6,-2.15) -- (14.1,-2.15);
  \node[pago] at (13.25,-2.95) {J1: $a_1>c_1$};
\end{tikzpicture}
