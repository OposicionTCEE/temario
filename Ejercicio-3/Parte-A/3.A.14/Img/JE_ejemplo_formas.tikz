% Forma extensiva y forma normal del juego de entrada, secuencial y simultáneo (apartado «Equivalencias»). Elaboración propia.
% En (a), cada estrategia de J2 es (precio si J1 entra, precio si J1 no entra).
\begin{tikzpicture}[font=\footnotesize, line cap=round,
    nd/.style={circle, fill=black, inner sep=0pt, minimum size=4.5pt},
    jug/.style={font=\footnotesize\bfseries},
    acc/.style={font=\footnotesize\itshape},
    pago/.style={font=\footnotesize},
    rama/.style={line width=0.6pt},
    info/.style={dashed, line width=0.6pt},
    tit/.style={font=\footnotesize\bfseries}]
  % (a) Juego secuencial: J2 observa si J1 ha entrado
  \node[tit] at (4.45,4.6) {(a) Juego secuencial};
  \node[nd, label=above:{\textbf{J1}}] (r) at (4.45,3.6) {};
  \node[nd, label=left:{\textbf{J2}}] (a1) at (3.05,2.4) {};
  \node[nd, label=right:{\textbf{J2}}] (a2) at (5.85,2.4) {};
  \draw[rama] (r) -- node[acc, above left] {Entrar} (a1);
  \draw[rama] (r) -- node[acc, above right] {No entrar} (a2);
  \foreach \p/\x/\l/\pos/\pg in {a1/2.45/Alto/left/{(a_1,\,a_2)}, a1/3.65/Bajo/right/{(b_1,\,b_2)}, a2/5.25/Alto/left/{(c_1,\,c_2)}, a2/6.45/Bajo/right/{(d_1,\,d_2)}} {
    \node[nd] (t) at (\x,1.3) {};
    \draw[rama] (\p) -- node[acc, \pos] {\l} (t);
    \node[pago, below] at (t.south) {$\pg$};
  }
  % Matriz 2x4: J1 (filas) frente a J2 (columnas)
  \fill[black!8] (0,0.15) rectangle (8.9,-0.95);
  \fill[black!8] (0,-0.95) rectangle (2.1,-2.05);
  \draw[line width=0.5pt] (2.1,0.15) -- (8.9,0.15);
  \draw[line width=0.5pt] (2.1,-0.40) -- (8.9,-0.40);
  \draw[line width=0.5pt] (0,-0.95) -- (8.9,-0.95);
  \draw[line width=0.5pt] (0.6,-1.50) -- (8.9,-1.50);
  \draw[line width=0.5pt] (0,-2.05) -- (8.9,-2.05);
  \draw[line width=0.5pt] (0,-0.95) -- (0,-2.05);
  \draw[line width=0.5pt] (0.6,-0.95) -- (0.6,-2.05);
  \draw[line width=0.5pt] (2.1,0.15) -- (2.1,-2.05);
  \foreach \x in {3.8,5.5,7.2} {\draw[line width=0.5pt] (\x,-0.40) -- (\x,-2.05);}
  \draw[line width=0.5pt] (8.9,0.15) -- (8.9,-2.05);
  \node[jug] at (5.5,-0.125) {J2};
  \node[acc] at (2.95,-0.675) {Alto, Alto};
  \node[acc] at (4.65,-0.675) {Alto, Bajo};
  \node[acc] at (6.35,-0.675) {Bajo, Alto};
  \node[acc] at (8.05,-0.675) {Bajo, Bajo};
  \node[jug] at (0.3,-1.50) {J1};
  \node[acc] at (1.35,-1.225) {Entrar};
  \node[acc] at (1.35,-1.775) {No entrar};
  \foreach \x/\pe/\pn in {2.95/{a_1,\ a_2}/{c_1,\ c_2}, 4.65/{a_1,\ a_2}/{d_1,\ d_2}, 6.35/{b_1,\ b_2}/{c_1,\ c_2}, 8.05/{b_1,\ b_2}/{d_1,\ d_2}} {
    \node at (\x,-1.225) {$\pe$};
    \node at (\x,-1.775) {$\pn$};
  }
  % (b) Juego simultáneo: J2 no observa si J1 ha entrado
  \node[tit] at (12.35,4.6) {(b) Juego simultáneo};
  \node[nd, label=above:{\textbf{J1}}] (s) at (12.35,3.6) {};
  \node[nd] (b1) at (10.95,2.4) {};
  \node[nd] (b2) at (13.75,2.4) {};
  \draw[info] (b1) -- (b2);
  \node[jug, fill=white, inner sep=1pt] at (12.35,2.4) {J2};
  \draw[rama] (s) -- node[acc, above left] {Entrar} (b1);
  \draw[rama] (s) -- node[acc, above right] {No entrar} (b2);
  \foreach \p/\x/\l/\pos/\pg in {b1/10.35/Alto/left/{(a_1,\,a_2)}, b1/11.55/Bajo/right/{(b_1,\,b_2)}, b2/13.15/Alto/left/{(c_1,\,c_2)}, b2/14.35/Bajo/right/{(d_1,\,d_2)}} {
    \node[nd] (t) at (\x,1.3) {};
    \draw[rama] (\p) -- node[acc, \pos] {\l} (t);
    \node[pago, below] at (t.south) {$\pg$};
  }
  % Matriz 2x2: J1 (filas) frente a J2 (columnas)
  \fill[black!8] (9.9,0.15) rectangle (14.8,-0.95);
  \fill[black!8] (9.9,-0.95) rectangle (12.0,-2.05);
  \draw[line width=0.5pt] (12.0,0.15) -- (14.8,0.15);
  \draw[line width=0.5pt] (12.0,-0.40) -- (14.8,-0.40);
  \draw[line width=0.5pt] (9.9,-0.95) -- (14.8,-0.95);
  \draw[line width=0.5pt] (10.5,-1.50) -- (14.8,-1.50);
  \draw[line width=0.5pt] (9.9,-2.05) -- (14.8,-2.05);
  \draw[line width=0.5pt] (9.9,-0.95) -- (9.9,-2.05);
  \draw[line width=0.5pt] (10.5,-0.95) -- (10.5,-2.05);
  \draw[line width=0.5pt] (12.0,0.15) -- (12.0,-2.05);
  \draw[line width=0.5pt] (13.4,-0.40) -- (13.4,-2.05);
  \draw[line width=0.5pt] (14.8,0.15) -- (14.8,-2.05);
  \node[jug] at (13.4,-0.125) {J2};
  \node[acc] at (12.7,-0.675) {Alto};
  \node[acc] at (14.1,-0.675) {Bajo};
  \node[jug] at (10.2,-1.50) {J1};
  \node[acc] at (11.25,-1.225) {Entrar};
  \node[acc] at (11.25,-1.775) {No entrar};
  \node at (12.7,-1.225) {$a_1,\ a_2$};
  \node at (14.1,-1.225) {$b_1,\ b_2$};
  \node at (12.7,-1.775) {$c_1,\ c_2$};
  \node at (14.1,-1.775) {$d_1,\ d_2$};
\end{tikzpicture}
