% Forma extensiva y forma normal del juego de entrada del texto, con y sin observación de la decisión de E
% (sustituye a JE_forma_normal_extensiva). Elaboración propia.
% Pagos (E, I): Entra-Alto (2,2); Entra-Bajo (-1,1); No entra-Alto (0,4); No entra-Bajo (0,2).
% En (a), cada estrategia de I es (precio si E entra, precio si E no entra).
\begin{tikzpicture}[font=\footnotesize, line cap=round,
    nd/.style={circle, fill=black, inner sep=0pt, minimum size=4.5pt},
    jug/.style={font=\footnotesize\bfseries},
    acc/.style={font=\footnotesize\itshape},
    pago/.style={font=\footnotesize},
    rama/.style={line width=0.6pt},
    info/.style={dashed, line width=0.6pt},
    tit/.style={font=\footnotesize\bfseries},
    nota/.style={font=\footnotesize, align=left}]
  % (a) Juego secuencial: I observa si E ha entrado
  \node[tit] at (4.45,4.6) {(a) I observa si E ha entrado};
  \node[nd, label=above:{\textbf{E}}] (r) at (4.45,3.6) {};
  \node[nd, label=left:{\textbf{I}}] (a1) at (3.05,2.4) {};
  \node[nd, label=right:{\textbf{I}}] (a2) at (5.85,2.4) {};
  \draw[rama] (r) -- node[acc, above left] {Entra} (a1);
  \draw[rama] (r) -- node[acc, above right] {No entra} (a2);
  \foreach \p/\x/\l/\pos/\pg in {a1/2.45/Alto/left/{(2,\,2)}, a1/3.65/Bajo/right/{(-1,\,1)}, a2/5.25/Alto/left/{(0,\,4)}, a2/6.45/Bajo/right/{(0,\,2)}} {
    \node[nd] (t) at (\x,1.3) {};
    \draw[rama] (\p) -- node[acc, \pos] {\l} (t);
    \node[pago, below] at (t.south) {$\pg$};
  }
  % Matriz 2x4: E (filas) frente a I (columnas)
  \fill[black!8] (0,0.15) rectangle (8.9,-0.95);
  \fill[black!8] (0,-0.95) rectangle (2.1,-2.05);
  \draw[line width=0.5pt] (2.1,0.15) -- (8.9,0.15);
  \draw[line width=0.5pt] (2.1,-0.40) -- (8.9,-0.40);
  \draw[line width=0.5pt] (0,-0.95) -- (8.9,-0.95);
  \draw[line width=0.5pt] (0.6,-1.50) -- (8.9,-1.50);
  \draw[line width=0.5pt] (0,-2.05) -- (8.9,-2.05);
  \draw[line width=0.5pt] (0,-0.95) -- (0,-2.05);
  \draw[line width=0.5pt] (0.6,-0.95) -- (0.6,-2.05);
  \draw[line width=0.5pt] (2.1,0.15) -- (2.1,-2.05);
  \foreach \x in {3.8,5.5,7.2} {\draw[line width=0.5pt] (\x,-0.40) -- (\x,-2.05);}
  \draw[line width=0.5pt] (8.9,0.15) -- (8.9,-2.05);
  \node[jug] at (5.5,-0.125) {I};
  \node[acc] at (2.95,-0.675) {Alto, Alto};
  \node[acc] at (4.65,-0.675) {Alto, Bajo};
  \node[acc] at (6.35,-0.675) {Bajo, Alto};
  \node[acc] at (8.05,-0.675) {Bajo, Bajo};
  \node[jug] at (0.3,-1.50) {E};
  \node[acc] at (1.35,-1.225) {Entra};
  \node[acc] at (1.35,-1.775) {No entra};
  \foreach \x/\pe/\pn in {2.95/{2,\ 2}/{0,\ 4}, 4.65/{2,\ 2}/{0,\ 2}, 6.35/{-1,\ 1}/{0,\ 4}, 8.05/{-1,\ 1}/{0,\ 2}} {
    \node at (\x,-1.225) {$\pe$};
    \node at (\x,-1.775) {$\pn$};
  }
  % (b) Juego simultáneo: I no observa si E ha entrado (conjunto de información con dos nodos)
  \node[tit] at (12.35,4.6) {(b) I no observa si E ha entrado};
  \node[nd, label=above:{\textbf{E}}] (s) at (12.35,3.6) {};
  \node[nd, label=left:{\textbf{I}}] (b1) at (10.95,2.4) {};
  \node[nd, label=right:{\textbf{I}}] (b2) at (13.75,2.4) {};
  \draw[info] (b1) -- (b2);
  \draw[rama] (s) -- node[acc, above left] {Entra} (b1);
  \draw[rama] (s) -- node[acc, above right] {No entra} (b2);
  \foreach \p/\x/\l/\pos/\pg in {b1/10.35/Alto/left/{(2,\,2)}, b1/11.55/Bajo/right/{(-1,\,1)}, b2/13.15/Alto/left/{(0,\,4)}, b2/14.35/Bajo/right/{(0,\,2)}} {
    \node[nd] (t) at (\x,1.3) {};
    \draw[rama] (\p) -- node[acc, \pos] {\l} (t);
    \node[pago, below] at (t.south) {$\pg$};
  }
  % Matriz 2x2: E (filas) frente a I (columnas)
  \fill[black!8] (9.9,0.15) rectangle (14.8,-0.95);
  \fill[black!8] (9.9,-0.95) rectangle (12.0,-2.05);
  \draw[line width=0.5pt] (12.0,0.15) -- (14.8,0.15);
  \draw[line width=0.5pt] (12.0,-0.40) -- (14.8,-0.40);
  \draw[line width=0.5pt] (9.9,-0.95) -- (14.8,-0.95);
  \draw[line width=0.5pt] (10.5,-1.50) -- (14.8,-1.50);
  \draw[line width=0.5pt] (9.9,-2.05) -- (14.8,-2.05);
  \draw[line width=0.5pt] (9.9,-0.95) -- (9.9,-2.05);
  \draw[line width=0.5pt] (10.5,-0.95) -- (10.5,-2.05);
  \draw[line width=0.5pt] (12.0,0.15) -- (12.0,-2.05);
  \draw[line width=0.5pt] (13.4,-0.40) -- (13.4,-2.05);
  \draw[line width=0.5pt] (14.8,0.15) -- (14.8,-2.05);
  \node[jug] at (13.4,-0.125) {I};
  \node[acc] at (12.7,-0.675) {Alto};
  \node[acc] at (14.1,-0.675) {Bajo};
  \node[jug] at (10.2,-1.50) {E};
  \node[acc] at (11.25,-1.225) {Entra};
  \node[acc] at (11.25,-1.775) {No entra};
  \node at (12.7,-1.225) {$2,\ 2$};
  \node at (14.1,-1.225) {$-1,\ 1$};
  \node at (12.7,-1.775) {$0,\ 4$};
  \node at (14.1,-1.775) {$0,\ 2$};
  \node[nota, text width=15.5cm, anchor=north west] at (0,-2.25) {Arriba, cada juego en forma extensiva; abajo, su forma normal. Pagos: (E, I). En (a), cada estrategia de I indica el precio que fija si E entra y el que fija si no entra, por ese orden; en (b), los dos nodos de I forman un único conjunto de información (línea discontinua) y su estrategia es un solo precio.};
\end{tikzpicture}
