% Bloque 2, «Deuda pública»: reducción estratégica de la demanda en la subasta de precio uniforme (AUSUBEL y CRAMTON, 2002).
% Una entidad grande con demanda de varias unidades: valoración marginal θ(q) decreciente; oferta residual (bonos ofrecidos menos lo que piden
% las demás a cada precio), creciente; el precio uniforme es el de la oferta residual en la cantidad que obtiene.
% (a) Si puja su valoración, obtiene q_C al precio p_C (cruce de θ(q) y la oferta residual); paga el rectángulo p_C·q_C.
% (b) Si reduce la demanda, actúa como un monopsonista: iguala su valoración marginal al gasto marginal, obtiene q_M < q_C al precio p_M < p_C;
%     ahorra el rectángulo (p_C - p_M)·q_M y se pierde el triángulo de eficiencia entre q_M y q_C.
% Rectas ilustrativas: θ(q) = 8 - 0,6q; oferta residual 1 + 0,5q; gasto marginal 1 + q.
\begin{tikzpicture}[font=\footnotesize, line cap=round,
    eje/.style={-{Stealth[length=2mm]}, line width=0.5pt},
    guia/.style={black!50, line width=0.5pt, densely dotted},
    tit/.style={font=\footnotesize\bfseries}]
  \def\sx{0.56}  % cm por unidad de cantidad
  \def\sy{0.5}   % cm por unidad de precio
  \pgfmathsetmacro{\qc}{7/1.1}    \pgfmathsetmacro{\pc}{1+0.5*\qc}
  \pgfmathsetmacro{\qm}{7/1.6}    \pgfmathsetmacro{\pm}{1+0.5*\qm}  \pgfmathsetmacro{\dm}{8-0.6*\qm}
  \foreach \p/\panel in {0/a, 7.7/b} {
    \begin{scope}[shift={(\p,0)}]
      \draw[eje] (0,0) -- (11*\sx,0) node[below] {$q$};
      \draw[eje] (0,0) -- (0,9.5*\sy) node[left] {$p$};
      \draw (0,0) node[below left] {$0$};
      \draw[line width=1.3pt] (0,8*\sy) -- (10*\sx,2*\sy) node[right] {$\theta(q)$};
      \draw[line width=1.0pt] (0,1*\sy) -- (10*\sx,6*\sy) node[above left] {Oferta residual};
    \end{scope}
  }
  % (a) pujar la valoración
  \node[tit] at (3.0,5.4) {(a) Pujar la valoración};
  \fill[black!15] (0,0) rectangle (\qc*\sx,\pc*\sy);
  \draw[guia] (\qc*\sx,0) -- (\qc*\sx,\pc*\sy) -- (0,\pc*\sy);
  \fill (\qc*\sx,\pc*\sy) circle (1.8pt) node[above right] {$C$};
  \draw (\qc*\sx,0) node[below] {$q_C$};
  \draw (0,\pc*\sy) node[left] {$p_C$};
  % (b) reducir la demanda
  \begin{scope}[shift={(7.7,0)}]
    \node[tit] at (3.0,5.4) {(b) Reducir la demanda};
    \fill[black!15] (0,\pm*\sy) rectangle (\qm*\sx,\pc*\sy);
    \fill[black!35] (\qm*\sx,\dm*\sy) -- (\qc*\sx,\pc*\sy) -- (\qm*\sx,\pm*\sy) -- cycle;
    \draw[line width=1.0pt, dashed] (0,1*\sy) -- (7.5*\sx,8.5*\sy) node[above] {Gasto marginal};
    \draw[guia] (\qc*\sx,0) -- (\qc*\sx,\pc*\sy) -- (0,\pc*\sy);
    \draw[guia] (\qm*\sx,0) -- (\qm*\sx,\dm*\sy);
    \draw[guia] (\qm*\sx,\pm*\sy) -- (0,\pm*\sy);
    \fill (\qc*\sx,\pc*\sy) circle (1.8pt) node[above right] {$C$};
    \fill (\qm*\sx,\pm*\sy) circle (1.8pt) node[below right] {$M$};
    \draw (\qm*\sx,0) node[below] {$q_M$};
    \draw (\qc*\sx,0) node[below] {$q_C$};
    \draw (0,\pc*\sy) node[left] {$p_C$};
    \draw (0,\pm*\sy) node[left] {$p_M$};
  \end{scope}
\end{tikzpicture}
