% Juego sin equilibrio de Nash en estrategias puras. Elaboración propia.
\begin{tikzpicture}[font=\footnotesize, line cap=round,
    nd/.style={circle, fill=black, inner sep=0pt, minimum size=4.5pt},
    jug/.style={font=\footnotesize\bfseries},
    acc/.style={font=\footnotesize\itshape},
    pago/.style={font=\footnotesize},
    rama/.style={line width=0.6pt},
    info/.style={dashed, line width=0.6pt},
    tit/.style={font=\footnotesize\bfseries},
    nota/.style={font=\footnotesize, align=left}]
  % Matriz de pagos: J1 (filas) frente a J2 (columnas)
  \fill[black!8] (0.000,0.000) rectangle (5.100,-1.200);
  \fill[black!8] (0.000,-1.200) rectangle (1.700,-2.400);
  \draw[line width=0.5pt] (1.700,0.000) -- (5.100,0.000);
  \draw[line width=0.5pt] (1.700,-0.600) -- (5.100,-0.600);
  \draw[line width=0.5pt] (0.000,-1.200) -- (5.100,-1.200);
  \draw[line width=0.5pt] (0.750,-1.800) -- (5.100,-1.800);
  \draw[line width=0.5pt] (0.750,-2.400) -- (5.100,-2.400);
  \draw[line width=0.5pt] (0.000,-2.400) -- (0.750,-2.400);
  \draw[line width=0.5pt] (0.000,-1.200) -- (0.000,-2.400);
  \draw[line width=0.5pt] (0.750,-1.200) -- (0.750,-2.400);
  \draw[line width=0.5pt] (1.700,0.000) -- (1.700,-2.400);
  \draw[line width=0.5pt] (3.400,-0.600) -- (3.400,-2.400);
  \draw[line width=0.5pt] (5.100,0.000) -- (5.100,-2.400);
  \node[jug] at (3.400,-0.300) {J2};
  \node[acc] at (2.550,-0.900) {$s_1$};
  \node[acc] at (4.250,-0.900) {$s_2$};
  \node[jug] at (0.375,-1.800) {J1};
  \node[acc] at (1.225,-1.500) {$S_1$};
  \node at (2.550,-1.500) {$1,\ 1$};
  \node at (4.250,-1.500) {$0,\ 4$};
  \node[acc] at (1.225,-2.100) {$S_2$};
  \node at (2.550,-2.100) {$-1,\ 3$};
  \node at (4.250,-2.100) {$3,\ -5$};
\end{tikzpicture}
