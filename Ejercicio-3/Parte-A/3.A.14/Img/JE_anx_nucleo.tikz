% Anexo de juegos cooperativos, «El núcleo»: repartos de V entre tres jugadores sobre el símplice x1 + x2 + x3 = V. Elaboración propia.
% (a) Juego simétrico: v(N) = V, v({i,j}) = W, v({i}) = 0, con W < V/2 (ilustrativo, W = 0,2 V). El núcleo es el hexágono sombreado
%     (x_k <= V - W para todo k); el valor de SHAPLEY y el nucléolo coinciden en el centro, (V/3, V/3, V/3).
% (b) Jugador imprescindible: v({1,2}) = v({1,3}) = v(N) = V y 0 en el resto. El núcleo es el vértice (V, 0, 0);
%     el valor de SHAPLEY, (2V/3, V/6, V/6), queda fuera del núcleo.
\begin{tikzpicture}[font=\footnotesize, line cap=round,
    tit/.style={font=\footnotesize\bfseries}]
  \def\L{4.9}
  % Coordenadas cartesianas de un reparto (x1, x2, x3) en proporción de V: x1 en el vértice izquierdo, x2 en el derecho, x3 arriba
  \def\pto#1#2#3{({#2*\L+#3*\L/2},{#3*\L*0.8660})}
  % (a) Juego simétrico
  \node[tit] at (\L/2,5.15) {(a) Juego simétrico};
  \begin{scope}
    \def\w{0.2}
    \draw[line width=0.7pt] \pto{1}{0}{0} -- \pto{0}{1}{0} -- \pto{0}{0}{1} -- cycle;
    \fill[black!15] \pto{0.8}{0.2}{0} -- \pto{0.2}{0.8}{0} -- \pto{0}{0.8}{0.2} -- \pto{0}{0.2}{0.8} -- \pto{0.2}{0}{0.8} -- \pto{0.8}{0}{0.2} -- cycle;
    \draw[line width=0.5pt, dashed] \pto{0.8}{0.2}{0} -- \pto{0.8}{0}{0.2};
    \draw[line width=0.5pt, dashed] \pto{0.2}{0.8}{0} -- \pto{0}{0.8}{0.2};
    \draw[line width=0.5pt, dashed] \pto{0}{0.2}{0.8} -- \pto{0.2}{0}{0.8};
    \fill \pto{0.3333}{0.3333}{0.3333} circle (2.2pt);
    \node[anchor=west] at \pto{0.3333}{0.3333}{0.3333} {$\phi=\left(\tfrac{V}{3},\tfrac{V}{3},\tfrac{V}{3}\right)$};
    \node[anchor=north] at \pto{1}{0}{0} {$(V,0,0)$};
    \node[anchor=north] at \pto{0}{1}{0} {$(0,V,0)$};
    \node[anchor=south] at \pto{0}{0}{1} {$(0,0,V)$};
    \node[anchor=east, font=\footnotesize] at \pto{0.8}{0}{0.2} {$x_1=V-W$};
  \end{scope}
  % (b) Jugador imprescindible
  \node[tit] at (8.8+\L/2,5.15) {(b) Jugador imprescindible};
  \begin{scope}[shift={(8.8,0)}]
    \draw[line width=0.7pt] \pto{1}{0}{0} -- \pto{0}{1}{0} -- \pto{0}{0}{1} -- cycle;
    \fill \pto{1}{0}{0} circle (2.6pt);
    \node[anchor=north, align=center] at \pto{1}{0}{0} {núcleo:\\$(V,0,0)$};
    \node[anchor=north] at \pto{0}{1}{0} {$(0,V,0)$};
    \node[anchor=south] at \pto{0}{0}{1} {$(0,0,V)$};
    \fill \pto{0.6667}{0.1667}{0.1667} circle (2.2pt);
    \node[anchor=south west] at \pto{0.6667}{0.1667}{0.1667} {$\phi=\left(\tfrac{2V}{3},\tfrac{V}{6},\tfrac{V}{6}\right)$};
  \end{scope}
\end{tikzpicture}
