% Bloque 2, «Límites», teorema de MYERSON y SATTERTHWAITE: reventa de un bono entre una entidad vendedora (valoración θ_v)
% y una compradora (θ_c), ambas uniformes e independientes en [θ_low, θ̄].
% (a) Intercambio eficiente: siempre que θ_c > θ_v (triángulo sobre la diagonal).
% (b) Mejor mecanismo compatible con los incentivos, voluntario y sin financiación externa (MYERSON y SATTERTHWAITE, 1983;
%     subasta doble de CHATTERJEE y SAMUELSON, 1983): solo hay intercambio si θ_c - θ_v ≥ (θ̄ - θ_low)/4;
%     la franja clara son intercambios eficientes que se pierden.
\begin{tikzpicture}[font=\footnotesize, line cap=round,
    eje/.style={-{Stealth[length=2mm]}, line width=0.5pt},
    tit/.style={font=\footnotesize\bfseries}]
  \def\L{4.6}  % lado del cuadrado [θ_low, θ̄]
  \foreach \p/\titulo/\b in {0/{(a) Intercambio eficiente}/0, 8.2/{(b) Sin financiación externa}/1} {
    \begin{scope}[shift={(\p,0)}]
      \node[tit] at (0.5*\L,\L+0.85) {\titulo};
      \ifnum\b=0
        \fill[black!25] (0,0) -- (\L,\L) -- (0,\L) -- cycle;
      \else
        \fill[black!8] (0,0) -- (\L,\L) -- (0,\L) -- cycle;
        \fill[black!25] (0,0.25*\L) -- (0.75*\L,\L) -- (0,\L) -- cycle;
        \draw[line width=0.7pt] (0,0.25*\L) -- (0.75*\L,\L);
        \draw (0,0.25*\L) -- (-0.08,0.25*\L) node[left] {$\underline{\theta}+\frac{\bar{\theta}-\underline{\theta}}{4}$};
      \fi
      \draw[line width=0.5pt] (0,0) rectangle (\L,\L);
      \draw[black!60, densely dashed, line width=0.6pt] (0,0) -- (\L,\L) node[above right, black] {$\theta_c=\theta_v$};
      \draw[eje] (0,0) -- (\L+0.45,0) node[below] {$\theta_v$};
      \draw[eje] (0,0) -- (0,\L+0.45) node[left] {$\theta_c$};
      \node[below] at (0,0) {$\underline{\theta}$};
      \node[below] at (\L,0) {$\bar{\theta}$};
      \node[left] at (0,\L) {$\bar{\theta}$};
    \end{scope}
  }
  \node at (4.1+2.3,-0.95) {Se intercambia si $\theta_c-\theta_v\geq\dfrac{\bar{\theta}-\underline{\theta}}{4}$ en el panel (b)};
\end{tikzpicture}
