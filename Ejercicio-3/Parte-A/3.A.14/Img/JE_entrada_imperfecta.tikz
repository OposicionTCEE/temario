% Juego de entrada con dos formas de entrar que I no distingue: dos equilibrios de Nash que son ENPS. Elaboración propia a partir de MAS-COLELL, WHINSTON y GREEN (1995).
\begin{tikzpicture}[font=\footnotesize, line cap=round,
    nd/.style={circle, fill=black, inner sep=0pt, minimum size=4.5pt},
    jug/.style={font=\footnotesize\bfseries},
    acc/.style={font=\footnotesize\itshape},
    pago/.style={font=\footnotesize},
    rama/.style={line width=0.6pt},
    info/.style={dashed, line width=0.6pt},
    tit/.style={font=\footnotesize\bfseries},
    nota/.style={font=\footnotesize, align=left}]
  \node[nd, label=above:{\textbf{E}}] (e) at (2.4,3.6) {};
  \node[nd] (o) at (0.6,2.0) {}; \node[pago, below] at (o.south) {$(0,\,2)$};
  \node[nd] (i1) at (3.3,2.0) {}; \node[nd] (i2) at (5.7,2.0) {};
  \draw[rama] (e) -- node[acc, above left] {Out} (o);
  \draw[rama] (e) -- node[acc, left, pos=0.55] {In$_1$} (i1);
  \draw[rama] (e) .. controls (4.3,3.55) .. node[acc, above right] {In$_2$} (i2);
  \draw[line width=0.7pt, rounded corners=8pt] (2.95,1.7) rectangle (6.05,2.3); \node[jug] at (4.5,2.0) {I};
  \foreach \p/\x/\l/\pos/\pg in {i1/2.6/L/left/{(-1,\,-1)}, i1/4.0/A/right/{(3,\,0)}, i2/5.0/L/left/{(-1,\,-1)}, i2/6.4/A/right/{(2,\,1)}} {
    \node[nd] (t) at (\x,0.5) {};
    \draw[rama] (\p) -- node[acc, \pos, pos=0.6] {\l} (t);
    \node[pago, below] at (t.south) {$\pg$};
  }
  \node[pago, anchor=east, align=right] at (0.0,1.6) {Pagos:\\$(u_E,u_I)$};
  \node[nota, anchor=north west] at (0.6,-0.35) {L: luchar; A: acomodar.};
  % Matriz de pagos: E (filas) frente a I (columnas)
  \fill[black!8] (7.400,3.300) rectangle (12.600,2.100);
  \fill[black!8] (7.400,2.100) rectangle (9.100,0.300);
  \fill[cyan!22, rounded corners=4pt] (9.160,2.040) rectangle (10.790,1.560);
  \fill[cyan!22, rounded corners=4pt] (10.910,1.440) rectangle (12.540,0.960);
  \draw[line width=0.5pt] (9.100,3.300) -- (12.600,3.300);
  \draw[line width=0.5pt] (9.100,2.700) -- (12.600,2.700);
  \draw[line width=0.5pt] (7.400,2.100) -- (12.600,2.100);
  \draw[line width=0.5pt] (8.150,1.500) -- (12.600,1.500);
  \draw[line width=0.5pt] (8.150,0.900) -- (12.600,0.900);
  \draw[line width=0.5pt] (8.150,0.300) -- (12.600,0.300);
  \draw[line width=0.5pt] (7.400,0.300) -- (8.150,0.300);
  \draw[line width=0.5pt] (7.400,2.100) -- (7.400,0.300);
  \draw[line width=0.5pt] (8.150,2.100) -- (8.150,0.300);
  \draw[line width=0.5pt] (9.100,3.300) -- (9.100,0.300);
  \draw[line width=0.5pt] (10.850,2.700) -- (10.850,0.300);
  \draw[line width=0.5pt] (12.600,3.300) -- (12.600,0.300);
  \node[jug] at (10.850,3.000) {I};
  \node[acc] at (9.975,2.400) {Luchar};
  \node[acc] at (11.725,2.400) {Acomodar};
  \node[jug] at (7.775,1.200) {E};
  \node[acc] at (8.625,1.800) {Out};
  \node at (9.975,1.800) {$0,\ 2$};
  \node at (11.725,1.800) {$0,\ 2$};
  \node[acc] at (8.625,1.200) {In$_1$};
  \node at (9.975,1.200) {$-1,\ -1$};
  \node at (11.725,1.200) {$3,\ 0$};
  \node[acc] at (8.625,0.600) {In$_2$};
  \node at (9.975,0.600) {$-1,\ -1$};
  \node at (11.725,0.600) {$2,\ 1$};
  \node[nota, anchor=north west, text width=6.4cm] at (7.4,0.4) {Sombreados, los dos equilibrios de Nash. El único subjuego es el juego completo, así que ambos son también ENPS.};
\end{tikzpicture}
