% Anexo de juegos no cooperativos, «Equilibrio de NASH perfecto en subjuegos»: inducción hacia atrás en tres etapas. Elaboración propia.
% Variante del juego de entrada: si J2 baja el precio tras la entrada, J1 decide si se queda (desenlace b) o sale del mercado (desenlace e).
% En los dos paneles, e1 > b1 (J1 sale si hay guerra), a1 > c1 = d1 > e1 y c2 > d2. Trazo grueso: elección de inducción hacia atrás.
% (a) a2 > e2: J2 se acomoda; ENPS (Entrar, Salir; Alto, Alto). (b) e2 > a2: la guerra expulsa al entrante; ENPS (No entrar, Salir; Bajo, Alto).
\begin{tikzpicture}[font=\footnotesize, line cap=round,
    nd/.style={circle, fill=black, inner sep=0pt, minimum size=4.5pt},
    acc/.style={font=\footnotesize\itshape},
    pago/.style={font=\footnotesize},
    rama/.style={line width=0.6pt},
    elegida/.style={line width=1.8pt},
    tit/.style={font=\footnotesize\bfseries}]
  % \arbol{centro}{rama de J2 tras la entrada: 1 Alto, 2 Bajo}{rama de J1 en x0: 1 Entrar, 2 No entrar}
  \def\arbol#1#2#3{%
    \begin{scope}[shift={(#1,0)}]
      \node[nd, label=above:{\textbf{J1}}] (r) at (0,3.9) {};
      \node[nd, label=left:{\textbf{J2}}] (i1) at (-1.7,2.6) {};
      \node[nd, label=right:{\textbf{J2}}] (i2) at (1.9,2.6) {};
      \node[nd] (ta) at (-2.7,1.3) {};
      \node[nd, label={[font=\footnotesize\bfseries]right:J1}] (y) at (-0.7,1.3) {};
      \node[nd] (tb) at (-1.4,0.0) {};
      \node[nd] (te) at (0.0,0.0) {};
      \node[nd] (tc) at (1.0,1.3) {};
      \node[nd] (td) at (2.8,1.3) {};
      \ifnum#3=1
        \draw[elegida] (r) -- node[acc, above left] {Entrar} (i1);
        \draw[rama] (r) -- node[acc, above right] {No entrar} (i2);
      \else
        \draw[rama] (r) -- node[acc, above left] {Entrar} (i1);
        \draw[elegida] (r) -- node[acc, above right] {No entrar} (i2);
      \fi
      \ifnum#2=1
        \draw[elegida] (i1) -- node[acc, left] {Alto} (ta);
        \draw[rama] (i1) -- node[acc, right] {Bajo} (y);
      \else
        \draw[rama] (i1) -- node[acc, left] {Alto} (ta);
        \draw[elegida] (i1) -- node[acc, right] {Bajo} (y);
      \fi
      \draw[rama] (y) -- node[acc, left] {Quedarse} (tb);
      \draw[elegida] (y) -- node[acc, right] {Salir} (te);
      \draw[elegida] (i2) -- node[acc, left] {Alto} (tc);
      \draw[rama] (i2) -- node[acc, right] {Bajo} (td);
      \foreach \t/\pg in {ta/{(a_1,\,a_2)}, tb/{(b_1,\,b_2)}, te/{(e_1,\,e_2)}, tc/{(c_1,\,c_2)}, td/{(d_1,\,d_2)}} {\node[pago, below] at (\t.south) {$\pg$};}
    \end{scope}}
  \node[tit] at (3.6,4.85) {(a) $a_2>e_2$};
  \arbol{3.6}{1}{1}
  \node[tit] at (12.0,4.85) {(b) $e_2>a_2$};
  \arbol{12.0}{2}{2}
\end{tikzpicture}
