% Creencias y racionalidad secuencial en una variante del juego de entrada (apartado «Creencias»). Elaboración propia a partir de MAS-COLELL, WHINSTON y GREEN (1995).
% J1 puede no entrar (J2 sigue como monopolista: (c1, c2)), entrar imitando el producto de J2 o entrar diferenciándose; J2 ve que J1 ha entrado, pero no cómo.
% J2 prefiere acomodarse en los dos nodos (a2 > b2 y e2 > f2); a J1 no le compensa entrar si hay guerra de precios (c1 > b1 y c1 > f1).
% (a) Equilibrio de Nash, y perfecto en subjuegos, sostenido por la amenaza: (No entrar, Bajo). (b) Con cualquier creencia mu, J2 se acomoda: la amenaza cae.
\begin{tikzpicture}[font=\footnotesize, line cap=round,
    nd/.style={circle, fill=black, inner sep=0pt, minimum size=4.5pt},
    jug/.style={font=\footnotesize\bfseries},
    acc/.style={font=\footnotesize\itshape},
    pago/.style={font=\footnotesize},
    rama/.style={line width=0.6pt},
    elegida/.style={line width=1.8pt},
    info/.style={dashed, line width=0.6pt},
    tit/.style={font=\footnotesize\bfseries}]
  % \arbol{centro}{1: amenaza (Bajo y No entrar en grueso); 2: Alto en grueso y creencias}
  \def\arbol#1#2{%
    \begin{scope}[shift={(#1,0)}]
      \node[nd, label=above:{\textbf{J1}}] (r) at (0,2.8) {};
      \node[nd] (x1) at (-1.9,1.5) {};
      \node[nd] (x2) at (0.7,1.5) {};
      \node[nd] (x0) at (2.5,1.5) {};
      \draw[info] (x1) -- (x2);
      \node[jug, fill=white, inner sep=1pt] at (-0.6,1.5) {J2};
      \draw[rama] (r) -- node[acc, above left] {Imitar} (x1);
      \draw[rama] (r) -- node[acc, left, pos=0.55] {Diferenciar} (x2);
      \ifnum#2=1
        \draw[elegida] (r) -- node[acc, above right] {No entrar} (x0);
      \else
        \draw[rama] (r) -- node[acc, above right] {No entrar} (x0);
        \node[pago, left] at (x1.west) {$[\mu]$};
        \node[pago, below right, xshift=-1pt] at (x2.east) {$[1-\mu]$};
      \fi
      \node[pago, below] at (x0.south) {$(c_1,\,c_2)$};
      \node[nd] (t1) at (-2.6,0.2) {}; \node[nd] (t2) at (-1.2,0.2) {};
      \node[nd] (t3) at (0.0,0.2) {}; \node[nd] (t4) at (1.4,0.2) {};
      \ifnum#2=1
        \draw[rama] (x1) -- node[acc, left] {Alto} (t1); \draw[elegida] (x1) -- node[acc, right] {Bajo} (t2);
        \draw[rama] (x2) -- node[acc, left] {Alto} (t3); \draw[elegida] (x2) -- node[acc, right] {Bajo} (t4);
      \else
        \draw[elegida] (x1) -- node[acc, left] {Alto} (t1); \draw[rama] (x1) -- node[acc, right] {Bajo} (t2);
        \draw[elegida] (x2) -- node[acc, left] {Alto} (t3); \draw[rama] (x2) -- node[acc, right] {Bajo} (t4);
      \fi
      \foreach \t/\pg in {t1/{(a_1,\,a_2)}, t2/{(b_1,\,b_2)}, t3/{(e_1,\,e_2)}, t4/{(f_1,\,f_2)}} {\node[pago, below] at (\t.south) {$\pg$};}
    \end{scope}}
  \node[tit] at (3.5,3.75) {(a) Equilibrio de NASH sostenido por la amenaza};
  \arbol{3.5}{1}
  \node[tit] at (11.9,3.75) {(b) Equilibrio bayesiano perfecto};
  \arbol{11.9}{2}
\end{tikzpicture}
