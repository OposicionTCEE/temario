% Bloque 2, «Primer precio»: el problema de la entidad de valoración θ_i y el equilibrio.
% (a) Ganancia esperada = margen (θ_i - b) × probabilidad de ganar P(b): rectángulos para una puja alta b_A (casi segura, sin margen),
% una baja b_B (mucho margen, poca probabilidad) y la óptima b* (sombreada, máxima área). P(b) ilustrativa: valoraciones uniformes en [0, θ̄],
% un bono, n = 3 y rivales que pujan (n-1)θ/n, de modo que P(b) = min{1, (1,5 b/θ̄)^2}; θ_i = 0,9 θ̄, b* = 0,6 θ̄, b_A = 0,85 θ̄, b_B = 0,3 θ̄.
% (b) Funciones de puja de equilibrio b(θ) = (n-1)θ/n para n y n' > n, bajo la recta θ; se marca b*(θ_i) para n. Valores ilustrativos n = 3, n' = 8.
\begin{tikzpicture}[font=\footnotesize, line cap=round,
    eje/.style={-{Stealth[length=2mm]}, line width=0.5pt},
    ref/.style={black!45, line width=0.6pt, dotted},
    guia/.style={black!50, line width=0.5pt, densely dotted},
    tit/.style={font=\footnotesize\bfseries}]
  \def\u{5.6}   % ancho de [0, θ̄]
  \def\v{3.4}   % alto de una unidad
  % ---------- (a) ----------
  \node[tit] at (0.5*\u,1.32*\v) {(a) Margen y probabilidad de ganar};
  \begin{scope}
    \draw[eje] (0,0) -- (\u+0.45,0) node[below] {$b$};
    \draw[eje] (0,0) -- (0,1.2*\v) node[left] {$P(b)$};
    \draw (0,0) node[below left] {$0$};
    \draw (0,\v) -- (-0.08,\v) node[left] {$1$};
    % rectángulo óptimo (sombreado)
    \fill[black!12] (0.6*\u,0) rectangle (0.9*\u,0.81*\v);
    \draw[line width=0.9pt] (0.6*\u,0) rectangle (0.9*\u,0.81*\v);
    % puja baja
    \draw[line width=0.8pt, densely dashed] (0.3*\u,0) rectangle (0.9*\u,0.2025*\v);
    % puja alta
    \draw[line width=0.8pt, dash pattern=on 3pt off 2pt] (0.85*\u,0) rectangle (0.9*\u,1.0*\v);
    % probabilidad de ganar
    \draw[line width=1.3pt] plot[domain=0:0.6667, samples=60] ({\x*\u},{(1.5*\x)^2*\v}) -- (\u,\v);
    \draw[black!30] (0.9*\u,0) -- (0.9*\u,1.1*\v);
    \foreach \x/\t in {0.3/b_B, 0.6/b^*, 0.85/b_A} { \draw (\x*\u,0) -- (\x*\u,-0.08) node[below] {$\t$}; }
    \draw (0.9*\u,0) -- (0.9*\u,-0.08) node[below right, xshift=-2pt] {$\theta_i$};
    \node[font=\footnotesize] at (0.75*\u,0.45*\v) {$(\theta_i-b^*)\,P(b^*)$};
  \end{scope}
  % ---------- (b) ----------
  \begin{scope}[shift={(8.4,0)}]
    \node[tit] at (0.5*\u,1.32*\v) {(b) Competencia};
    \draw[eje] (0,0) -- (\u+0.45,0) node[below] {$\theta$};
    \draw[eje] (0,0) -- (0,1.2*\v) node[left] {$b$};
    \draw (0,0) node[below left] {$0$};
    \draw (\u,0) -- (\u,-0.08) node[below] {$\bar{\theta}$};
    \draw[black!30] (\u,0) -- (\u,1.1*\v);
    \draw[ref] (0,0) -- (\u,\v) node[right, black!60] {$\theta$};
    \draw[line width=1.3pt, dashed] (0,0) -- (\u,0.875*\v) node[right] {$b(\theta)\ (n')$};
    \draw[line width=1.3pt] (0,0) -- (\u,0.6667*\v) node[right] {$b(\theta)\ (n)$};
    \draw[guia] (0.9*\u,0) -- (0.9*\u,0.6*\v) -- (0,0.6*\v);
    \fill (0.9*\u,0.6*\v) circle (1.8pt);
    \draw (0.9*\u,0) -- (0.9*\u,-0.08) node[below] {$\theta_i$};
    \draw (0,0.6*\v) -- (-0.08,0.6*\v) node[left] {$b^*$};
  \end{scope}
\end{tikzpicture}
