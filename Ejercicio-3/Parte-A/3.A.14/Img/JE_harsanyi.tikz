% Información incompleta y transformación de HARSANYI (1967-68). Elaboración propia.
% (a) Dos matrices posibles según el tipo de J1, que J2 no conoce; (b) el mismo juego con una jugada previa de la naturaleza.
% El ejemplo se resuelve en el apartado del equilibrio bayesiano de Nash (J1: U si es de tipo A y D si es de tipo B; J2: l si p > 1/3).
\begin{tikzpicture}[font=\footnotesize, line cap=round,
    nd/.style={circle, fill=black, inner sep=0pt, minimum size=4.5pt},
    nat/.style={circle, draw=black, fill=white, line width=0.6pt, inner sep=0pt, minimum size=6pt},
    jug/.style={font=\footnotesize\bfseries},
    acc/.style={font=\footnotesize\itshape},
    pago/.style={font=\footnotesize},
    rama/.style={line width=0.6pt},
    info/.style={dashed, line width=0.6pt},
    tit/.style={font=\footnotesize\bfseries},
    nota/.style={font=\footnotesize, align=left}]
  % Matriz 2x2 con el origen en la esquina superior izquierda: #1 título; #2-#5 pagos (U,l), (U,r), (D,l), (D,r)
  \def\matriz#1#2#3#4#5{%
    \fill[black!8] (0,0) rectangle (4.2,-1.1);
    \fill[black!8] (0,-1.1) rectangle (1.5,-2.2);
    \draw[line width=0.5pt] (1.5,0) -- (4.2,0);
    \draw[line width=0.5pt] (1.5,-0.55) -- (4.2,-0.55);
    \draw[line width=0.5pt] (0,-1.1) -- (4.2,-1.1);
    \draw[line width=0.5pt] (0.75,-1.65) -- (4.2,-1.65);
    \draw[line width=0.5pt] (0,-2.2) -- (4.2,-2.2);
    \draw[line width=0.5pt] (0,-1.1) -- (0,-2.2);
    \draw[line width=0.5pt] (0.75,-1.1) -- (0.75,-2.2);
    \draw[line width=0.5pt] (1.5,0) -- (1.5,-2.2);
    \draw[line width=0.5pt] (2.85,-0.55) -- (2.85,-2.2);
    \draw[line width=0.5pt] (4.2,0) -- (4.2,-2.2);
    \node[font=\footnotesize] at (2.1,0.4) {#1};
    \node[jug] at (2.85,-0.275) {J2};
    \node[acc] at (2.175,-0.825) {$l$};
    \node[acc] at (3.525,-0.825) {$r$};
    \node[jug] at (0.375,-1.65) {J1};
    \node[acc] at (1.125,-1.375) {$U$};
    \node[acc] at (1.125,-1.925) {$D$};
    \node at (2.175,-1.375) {#2};
    \node at (3.525,-1.375) {#3};
    \node at (2.175,-1.925) {#4};
    \node at (3.525,-1.925) {#5};
  }
  % (a) Información incompleta
  \node[tit] at (7.75,0.9) {(a) Información incompleta: J2 no sabe qué matriz rige};
  \begin{scope}[shift={(1.6,-0.6)}]
    \matriz{J1 de tipo $\theta_A$ (probabilidad $p$)}{$3,\ 2$}{$1,\ 0$}{$2,\ 0$}{$0,\ 1$}
  \end{scope}
  \begin{scope}[shift={(9.7,-0.6)}]
    \matriz{J1 de tipo $\theta_B$ (probabilidad $1-p$)}{$1,\ 2$}{$0,\ 0$}{$2,\ 0$}{$3,\ 1$}
  \end{scope}
  \node[nota, align=center, text width=3.0cm] at (7.75,-1.7) {J1 conoce su tipo; J2 solo sabe que es $\theta_A$ con probabilidad $p$};
  % (b) Transformación de HARSANYI
  \node[tit] at (7.75,-3.8) {(b) Transformación de HARSANYI: la naturaleza elige antes el tipo de J1};
  \node[nat, label=above:{\textbf{Naturaleza}}] (n) at (7.75,-4.7) {};
  \node[nd, label=left:{\textbf{J1} ($\theta_A$)}] (a) at (3.9,-5.9) {};
  \node[nd, label=right:{\textbf{J1} ($\theta_B$)}] (b) at (11.6,-5.9) {};
  \draw[rama] (n) -- node[acc, above left] {$\theta_A$ ($p$)} (a);
  \draw[rama] (n) -- node[acc, above right] {$\theta_B$ ($1-p$)} (b);
  \node[nd] (a1) at (1.95,-7.2) {};
  \node[nd] (a2) at (5.85,-7.2) {};
  \node[nd] (b1) at (9.65,-7.2) {};
  \node[nd] (b2) at (13.55,-7.2) {};
  \draw[info] (a1) -- (a2) -- (b1) -- (b2);
  \node[jug, fill=white, inner sep=1pt] at (7.75,-7.2) {J2};
  \draw[rama] (a) -- node[acc, above left] {$U$} (a1);
  \draw[rama] (a) -- node[acc, above right] {$D$} (a2);
  \draw[rama] (b) -- node[acc, above left] {$U$} (b1);
  \draw[rama] (b) -- node[acc, above right] {$D$} (b2);
  \foreach \p/\x/\l/\pos/\pg in {a1/1.0/l/left/{(3,\,2)}, a1/2.9/r/right/{(1,\,0)}, a2/4.9/l/left/{(2,\,0)}, a2/6.8/r/right/{(0,\,1)},
                                 b1/8.7/l/left/{(1,\,2)}, b1/10.6/r/right/{(0,\,0)}, b2/12.6/l/left/{(2,\,0)}, b2/14.5/r/right/{(3,\,1)}} {
    \node[nd] (t) at (\x,-8.4) {};
    \draw[rama] (\p) -- node[acc, \pos] {$\l$} (t);
    \node[pago, below] at (t.south) {$\pg$};
  }
  \node[nota, text width=15.5cm, anchor=north west] at (0,-9.2) {Pagos: (J1, J2). Los pagos de J2 son los mismos en las dos matrices; los de J1 dependen de su tipo: al de tipo $\theta_A$ le conviene $U$ y al de tipo $\theta_B$, $D$, haga lo que haga J2. En (b), J1 observa la jugada de la naturaleza (sus dos nodos están separados), pero J2 no observa ni el tipo ni la jugada de J1: sus cuatro nodos forman un único conjunto de información (línea discontinua). La información incompleta se ha convertido en información imperfecta sobre una jugada de la naturaleza.};
\end{tikzpicture}
