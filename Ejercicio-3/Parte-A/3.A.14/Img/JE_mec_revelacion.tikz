% Bloque 2, «Estructura general de un mecanismo»: el problema del Tesoro como mecanismo (adaptación al ejemplo del diagrama de MOUNT y REITER del anexo).
% (a) Subasta: las entidades pujan b(θ) según su valoración; las reglas g convierten las pujas en asignación de bonos y pagos; el Tesoro alcanza su objetivo f si g(b(θ)) = f(θ).
% (b) Mecanismo directo equivalente: las entidades declaran su valoración θ̂, decir la verdad (θ̂ = θ) es un equilibrio y el Tesoro aplica f a las declaraciones.
\begin{tikzpicture}[font=\footnotesize, line cap=round,
    con/.style={font=\footnotesize, draw=black, line width=0.6pt, rounded corners=3pt, minimum width=2.1cm, minimum height=0.85cm, align=center},
    fl/.style={-{Stealth[length=2.4mm]}, line width=0.8pt},
    tit/.style={font=\footnotesize\bfseries}]
  % (a) Subasta
  \node[tit] at (2.9,3.5) {(a) Subasta};
  \node[con] (T) at (0.6,2.3) {Valoraciones\\$\theta$};
  \node[con] (X) at (5.2,2.3) {Bonos y pagos\\$f(\theta)$};
  \node[con] (M) at (2.9,0.0) {Pujas\\$b(\theta)$};
  \draw[fl] (T) -- node[above] {Objetivo $f$} (X);
  \draw[fl] (T) -- node[left, xshift=-3pt] {$b$} (M);
  \draw[fl] (M) -- node[right, xshift=3pt] {Reglas $g$} (X);
  \node at (2.9,1.45) {$g\left(b(\theta)\right)=f(\theta)$};
  % (b) Mecanismo directo
  \node[tit] at (11.3,3.5) {(b) Mecanismo directo};
  \node[con] (T2) at (9.0,2.3) {Valoraciones\\$\theta$};
  \node[con] (X2) at (13.6,2.3) {Bonos y pagos\\$f(\theta)$};
  \node[con] (M2) at (11.3,0.0) {Declaraciones\\$\hat{\theta}$};
  \draw[fl] (T2) -- node[above] {Objetivo $f$} (X2);
  \draw[fl] (T2) -- node[left, xshift=-3pt] {$\hat{\theta}=\theta$} (M2);
  \draw[fl] (M2) -- node[right, xshift=3pt] {$f(\hat{\theta})$} (X2);
  \node at (11.3,1.45) {$f(\hat{\theta})=f(\theta)$};
\end{tikzpicture}
