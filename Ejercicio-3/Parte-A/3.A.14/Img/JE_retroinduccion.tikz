% Equilibrio por retroinducción en un juego de información perfecta. Elaboración propia.
\begin{tikzpicture}[font=\footnotesize, line cap=round,
    nd/.style={circle, fill=black, inner sep=0pt, minimum size=4.5pt},
    jug/.style={font=\footnotesize\bfseries},
    acc/.style={font=\footnotesize\itshape},
    pago/.style={font=\footnotesize},
    rama/.style={line width=0.6pt},
    info/.style={dashed, line width=0.6pt},
    tit/.style={font=\footnotesize\bfseries},
    nota/.style={font=\footnotesize, align=left}]
  \tikzset{ruta/.style={-{Latex[length=2mm]}, line width=0.7pt, black!70}}
  \node[nd, label=above:{\textbf{J1}}] (r) at (3.0,5.4) {};
  \node[nd, label=left:{\textbf{J2}}] (a) at (1.6,3.9) {};
  \node[nd, label=right:{\textbf{J2}}] (b) at (4.4,3.9) {};
  \draw[rama] (r) -- node[acc, above left] {U} (a);
  \draw[rama] (r) -- node[acc, above right] {D} (b);
  \node[nd] (a1) at (0.8,2.4) {}; \node[pago, below] at (a1.south) {$(2,\,4)$};
  \node[nd, label=right:{\textbf{J1}}] (a2) at (2.4,2.4) {};
  \draw[rama] (a) -- node[acc, left] {u} (a1);
  \draw[rama] (a) -- node[acc, right] {d} (a2);
  \node[nd] (b1) at (3.6,2.4) {}; \node[pago, below] at (b1.south) {$(-2,\,6)$};
  \node[nd] (b2) at (5.2,2.4) {}; \node[pago, below] at (b2.south) {$(4,\,4)$};
  \draw[rama] (b) -- node[acc, left] {l} (b1);
  \draw[rama] (b) -- node[acc, right] {r} (b2);
  \node[nd] (c1) at (1.6,0.9) {}; \node[pago, below] at (c1.south) {$(-1,\,5)$};
  \node[nd] (c2) at (3.2,0.9) {}; \node[pago, below] at (c2.south) {$(0,\,2)$};
  \draw[rama] (a2) -- node[acc, left] {L} (c1);
  \draw[rama] (a2) -- node[acc, right] {R} (c2);
  \draw[ruta] ($(r)!0.22!(a)+(0.17,0.12)$) -- ($(r)!0.8!(a)+(0.17,0.12)$);
  \draw[ruta] ($(a)!0.22!(a1)+(0.17,0.08)$) -- ($(a)!0.8!(a1)+(0.17,0.08)$);
  \draw[ruta] ($(b)!0.22!(b1)+(0.17,0.08)$) -- ($(b)!0.8!(b1)+(0.17,0.08)$);
  \draw[ruta] ($(a2)!0.22!(c2)+(-0.17,0.08)$) -- ($(a2)!0.8!(c2)+(-0.17,0.08)$);
  \node[nota, anchor=west, text width=5.0cm] at (6.3,3.4) {Las flechas marcan la elección óptima en cada nodo, empezando por el último. Pagos: (J1, J2). Equilibrio: $(U,R;\,u,l)$; ruta de equilibrio: $(U,u)$.};
\end{tikzpicture}
