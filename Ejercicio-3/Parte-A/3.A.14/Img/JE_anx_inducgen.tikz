% Anexo de juegos no cooperativos, «Inducción hacia atrás generalizada»: variante del juego de entrada en la que, tras la entrada,
% las dos empresas fijan el precio a la vez (subjuego simultáneo). Si J1 no entra, J2 sigue como monopolista: (c1, c2). Elaboración propia.
% Pagos del subjuego: (Alto, Alto) = (a1, a2); (Alto, Bajo) = (g1, g2); (Bajo, Alto) = (h1, h2); (Bajo, Bajo) = (b1, b2),
% con a1 > h1, b1 > g1, a2 > g2 y b2 > h2: a cada empresa le conviene igualar el precio de la otra, y el subjuego tiene dos equilibrios en puras.
% (a) Forma extensiva. (b) El subjuego en forma normal (subrayado, mejores respuestas). (c) Los dos juegos reducidos.
\begin{tikzpicture}[font=\footnotesize, line cap=round,
    nd/.style={circle, fill=black, inner sep=0pt, minimum size=4.5pt},
    jug/.style={font=\footnotesize\bfseries},
    acc/.style={font=\footnotesize\itshape},
    pago/.style={font=\footnotesize},
    rama/.style={line width=0.6pt},
    info/.style={dashed, line width=0.6pt},
    sub/.style={draw=black!50, line width=0.6pt, dotted, rounded corners=6pt},
    tit/.style={font=\footnotesize\bfseries}]
  % (a) Forma extensiva
  \node[tit] at (3.2,4.7) {(a) Forma extensiva};
  \node[nd, label=above:{\textbf{J1}}] (r) at (3.2,3.9) {};
  \node[nd, label=left:{\textbf{J1}}] (e) at (2.0,2.7) {};
  \node[nd] (x0) at (4.9,2.7) {};
  \node[pago, below] at (x0.south) {$(c_1,\,c_2)$};
  \draw[rama] (r) -- node[acc, above left] {Entrar} (e);
  \draw[rama] (r) -- node[acc, above right] {No entrar} (x0);
  \node[nd] (k1) at (0.8,1.5) {};
  \node[nd] (k2) at (3.2,1.5) {};
  \draw[rama] (e) -- node[acc, left] {Alto} (k1);
  \draw[rama] (e) -- node[acc, right] {Bajo} (k2);
  \draw[info] (k1) -- (k2);
  \node[jug, fill=white, inner sep=1pt] at (2.0,1.5) {J2};
  \foreach \p/\x/\l/\pos/\pg in {k1/0.2/Alto/left/{(a_1,\,a_2)}, k1/1.4/Bajo/right/{(g_1,\,g_2)}, k2/2.6/Alto/left/{(h_1,\,h_2)}, k2/3.8/Bajo/right/{(b_1,\,b_2)}} {
    \node[nd] (t) at (\x,0.3) {};
    \draw[rama] (\p) -- node[acc, \pos, inner sep=1pt] {\l} (t);
    \node[pago, below] at (t.south) {$\pg$};
  }
  \draw[sub] (-0.45,3.05) rectangle (4.45,-0.45);
  % (b) Subjuego en forma normal
  \node[tit] at (8.6,4.7) {(b) Subjuego tras la entrada};
  \begin{scope}[shift={(6.2,3.9)}]
    \fill[black!8] (0,0) rectangle (4.8,-1.1);
    \fill[black!8] (0,-1.1) rectangle (1.6,-2.5);
    \draw[line width=0.5pt] (1.6,0) -- (4.8,0);
    \draw[line width=0.5pt] (1.6,-0.55) -- (4.8,-0.55);
    \draw[line width=0.5pt] (0,-1.1) -- (4.8,-1.1);
    \draw[line width=0.5pt] (0.5,-1.8) -- (4.8,-1.8);
    \draw[line width=0.5pt] (0,-2.5) -- (4.8,-2.5);
    \draw[line width=0.5pt] (0,-1.1) -- (0,-2.5);
    \draw[line width=0.5pt] (0.5,-1.1) -- (0.5,-2.5);
    \draw[line width=0.5pt] (1.6,0) -- (1.6,-2.5);
    \draw[line width=0.5pt] (3.2,-0.55) -- (3.2,-2.5);
    \draw[line width=0.5pt] (4.8,0) -- (4.8,-2.5);
    \node[jug] at (3.2,-0.275) {J2};
    \node[acc] at (2.4,-0.825) {Alto};
    \node[acc] at (4.0,-0.825) {Bajo};
    \node[jug] at (0.25,-1.8) {J1};
    \node[acc] at (1.05,-1.45) {Alto};
    \node[acc] at (1.05,-2.15) {Bajo};
    \node at (2.4,-1.45) {$\underline{a_1},\ \underline{a_2}$};
    \node at (4.0,-1.45) {$g_1,\ g_2$};
    \node at (2.4,-2.15) {$h_1,\ h_2$};
    \node at (4.0,-2.15) {$\underline{b_1},\ \underline{b_2}$};
  \end{scope}
  % (c) Juegos reducidos
  \node[tit] at (13.95,4.7) {(c) Juegos reducidos};
  \begin{scope}[shift={(12.8,0)}]
    \node[nd, label=above:{\textbf{J1}}] (s1) at (0,3.9) {};
    \node[nd] (s1a) at (-0.7,2.7) {}; \node[nd] (s1b) at (0.7,2.7) {};
    \draw[rama] (s1) -- node[acc, above left] {E} (s1a);
    \draw[rama] (s1) -- node[acc, above right] {N} (s1b);
    \node[pago, below] at (s1a.south) {$(a_1,\,a_2)$};
    \node[pago, below] at (s1b.south) {$(c_1,\,c_2)$};
    \node[nd, label=above:{\textbf{J1}}] (s2) at (2.3,3.9) {};
    \node[nd] (s2a) at (1.6,2.7) {}; \node[nd] (s2b) at (3.0,2.7) {};
    \draw[rama] (s2) -- node[acc, above left] {E} (s2a);
    \draw[rama] (s2) -- node[acc, above right] {N} (s2b);
    \node[pago, below] at (s2a.south) {$(b_1,\,b_2)$};
    \node[pago, below] at (s2b.south) {$(c_1,\,c_2)$};
    \node[pago] at (0,1.6) {(Alto, Alto)};
    \node[pago] at (2.3,1.6) {(Bajo, Bajo)};
  \end{scope}
\end{tikzpicture}
