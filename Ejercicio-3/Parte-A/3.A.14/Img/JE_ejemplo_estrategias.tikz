% Estrategias de J2 en el juego de entrada (apartado «Perfil de estrategias»). Elaboración propia.
% (a) Juego secuencial: cada estrategia elige una acción en cada uno de los dos nodos de J2 (precio si J1 entra, precio si no entra).
% (b) Juego simultáneo: J2 no distingue sus dos nodos y elige la misma acción en ambos.
\begin{tikzpicture}[font=\footnotesize, line cap=round,
    nd/.style={circle, fill=black, inner sep=0pt, minimum size=4pt},
    acc/.style={font=\footnotesize\itshape},
    rama/.style={line width=0.6pt},
    elegida/.style={line width=1.6pt},
    tenue/.style={line width=0.6pt, black!30},
    info/.style={dashed, line width=0.6pt},
    tit/.style={font=\footnotesize\bfseries},
    plan/.style={font=\footnotesize}]
  % \mini{x}{y}{acción tras Entrar: 1 Alto, 2 Bajo}{acción tras No entrar}{etiqueta}{1 = conjunto de información único}
  \def\mini#1#2#3#4#5#6{%
    \begin{scope}[shift={(#1,#2)}]
      \node[nd, label={[font=\footnotesize\bfseries]above:J1}] (r) at (0,0) {};
      \node[nd] (p) at (-1.1,-0.9) {};
      \node[nd] (q) at (1.1,-0.9) {};
      \draw[rama] (r) -- node[acc, above left] {Entrar} (p);
      \draw[rama] (r) -- node[acc, above right] {No entrar} (q);
      \ifnum#6=1
        \draw[info] (p) -- (q);
        \node[font=\footnotesize\bfseries, fill=white, inner sep=1pt] at (0,-0.9) {J2};
      \else
        \node[font=\footnotesize\bfseries, left] at (p.west) {J2};
        \node[font=\footnotesize\bfseries, right] at (q.east) {J2};
      \fi
      \node[nd] (p1) at (-1.65,-1.8) {}; \node[nd] (p2) at (-0.55,-1.8) {};
      \node[nd] (q1) at (0.55,-1.8) {}; \node[nd] (q2) at (1.65,-1.8) {};
      \ifnum#3=1
        \draw[elegida] (p) -- node[acc, left] {Alto} (p1); \draw[tenue] (p) -- (p2);
      \else
        \draw[tenue] (p) -- (p1); \draw[elegida] (p) -- node[acc, right] {Bajo} (p2);
      \fi
      \ifnum#4=1
        \draw[elegida] (q) -- node[acc, left] {Alto} (q1); \draw[tenue] (q) -- (q2);
      \else
        \draw[tenue] (q) -- (q1); \draw[elegida] (q) -- node[acc, right] {Bajo} (q2);
      \fi
      \node[plan] at (0,-2.3) {#5};
    \end{scope}}
  % (a) Juego secuencial
  \node[tit] at (4.4,0.95) {(a) Juego secuencial: cuatro estrategias de J2};
  \mini{2.2}{0}{1}{1}{(Alto, Alto)}{0}
  \mini{6.6}{0}{1}{2}{(Alto, Bajo)}{0}
  \mini{2.2}{-3.2}{2}{1}{(Bajo, Alto)}{0}
  \mini{6.6}{-3.2}{2}{2}{(Bajo, Bajo)}{0}
  % (b) Juego simultáneo
  \node[tit] at (12.3,0.95) {(b) Juego simultáneo: dos estrategias de J2};
  \mini{12.3}{0}{1}{1}{Alto}{1}
  \mini{12.3}{-3.2}{2}{2}{Bajo}{1}
\end{tikzpicture}
