% El juego de entrada que recorre el bloque «Principales conceptos» (introducción de «Reglas del juego»). Elaboración propia.
% J1 (entrante): Entrar / No entrar; J2 (incumbente) observa y fija precio Alto / Bajo.
% Pagos por nodo final, con subíndice del jugador: a = Entrar-Alto, b = Entrar-Bajo, c = No entrar-Alto, d = No entrar-Bajo.
\begin{tikzpicture}[font=\footnotesize, line cap=round,
    nd/.style={circle, fill=black, inner sep=0pt, minimum size=4.5pt},
    acc/.style={font=\footnotesize\itshape},
    pago/.style={font=\footnotesize},
    rama/.style={line width=0.6pt}]
  \node[nd, label=above:{\textbf{J1}}] (r) at (4,2.8) {};
  \node[nd, label=left:{\textbf{J2}}] (i1) at (2,1.4) {};
  \node[nd, label=right:{\textbf{J2}}] (i2) at (6,1.4) {};
  \draw[rama] (r) -- node[acc, above left] {Entrar} (i1);
  \draw[rama] (r) -- node[acc, above right] {No entrar} (i2);
  \foreach \p/\x/\l/\pos/\pg in {i1/1.0/Alto/left/{(a_1,\,a_2)}, i1/3.0/Bajo/right/{(b_1,\,b_2)}, i2/5.0/Alto/left/{(c_1,\,c_2)}, i2/7.0/Bajo/right/{(d_1,\,d_2)}} {
    \node[nd] (t) at (\x,0) {};
    \draw[rama] (\p) -- node[acc, \pos] {\l} (t);
    \node[pago, below] at (t.south) {$\pg$};
  }
\end{tikzpicture}
