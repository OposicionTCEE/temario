% Juego de entrada con elección de nicho: subjuegos, equilibrios del subjuego propio y juegos reducidos. Elaboración propia a partir de MAS-COLELL, WHINSTON y GREEN (1995).
\begin{tikzpicture}[font=\footnotesize, line cap=round,
    nd/.style={circle, fill=black, inner sep=0pt, minimum size=4.5pt},
    jug/.style={font=\footnotesize\bfseries},
    acc/.style={font=\footnotesize\itshape},
    pago/.style={font=\footnotesize},
    rama/.style={line width=0.6pt},
    info/.style={dashed, line width=0.6pt},
    tit/.style={font=\footnotesize\bfseries},
    nota/.style={font=\footnotesize, align=left}]
  \tikzset{conj/.style={draw, line width=0.7pt, rounded corners=1pt}, sub/.style={font=\footnotesize\bfseries, text=red!60!black}}
  % Subjuego 1: el juego completo
  \node[sub] at (2.6,7.75) {Subjuego 1 (el juego completo)};
  \node[nd, label=above:{\textbf{E}}] (e) at (2.6,7.0) {};
  \node[nd] (o) at (0.5,5.9) {}; \node[pago, below] at (o.south) {$(0,\,2)$};
  \node[nd, label=right:{\textbf{E}}] (e2) at (3.8,5.9) {};
  \draw[rama] (e) -- node[acc, above left] {Out} (o);
  \draw[rama] (e) -- node[acc, above right] {In} (e2);
  \node[nd] (i1) at (2.6,4.6) {}; \node[nd] (i2) at (5.0,4.6) {};
  \draw[rama] (e2) -- node[acc, above left, align=right] {Nicho\\pequeño} (i1);
  \draw[rama] (e2) -- node[acc, above right, align=left] {Nicho\\grande} (i2);
  \draw[conj] (2.25,4.3) rectangle (5.35,4.9); \node[jug] at (3.8,4.6) {I};
  \foreach \p/\x/\l/\pg in {i1/1.95/P/{(-6,\,-6)}, i1/3.25/G/{(-1,\,1)}, i2/4.35/P/{(1,\,-1)}, i2/5.65/G/{(-3,\,-3)}} {
    \node[nd] (t) at (\x,3.35) {};
    \draw[rama] (\p) -- node[acc, fill=white, inner sep=1pt] {\l} (t);
    \node[pago, below] at (t.south) {$\pg$};
  }
  % Subjuego 2: el que empieza tras In
  \node[sub] at (10.5,7.75) {Subjuego 2 (tras In)};
  \node[nd, label=above:{\textbf{E}}] (f) at (10.5,7.0) {};
  \node[nd] (j1) at (9.3,5.6) {}; \node[nd] (j2) at (11.7,5.6) {};
  \draw[rama] (f) -- node[acc, above left, align=right] {Nicho\\pequeño} (j1);
  \draw[rama] (f) -- node[acc, above right, align=left] {Nicho\\grande} (j2);
  \draw[conj] (8.95,5.3) rectangle (12.05,5.9); \node[jug] at (10.5,5.6) {I};
  \foreach \p/\x/\l/\pg in {j1/8.65/P/{(-6,\,-6)}, j1/9.95/G/{(-1,\,1)}, j2/11.05/P/{(1,\,-1)}, j2/12.35/G/{(-3,\,-3)}} {
    \node[nd] (t) at (\x,4.35) {};
    \draw[rama] (\p) -- node[acc, fill=white, inner sep=1pt] {\l} (t);
    \node[pago, below] at (t.south) {$\pg$};
  }
  % Matriz de pagos: E (filas) frente a I (columnas)
  \fill[black!8] (8.200,3.350) rectangle (14.450,2.150);
  \fill[black!8] (8.200,2.150) rectangle (10.650,0.950);
  \fill[cyan!22, rounded corners=4pt] (12.610,2.090) rectangle (14.390,1.610);
  \fill[cyan!22, rounded corners=4pt] (10.710,1.490) rectangle (12.490,1.010);
  \draw[line width=0.5pt] (10.650,3.350) -- (14.450,3.350);
  \draw[line width=0.5pt] (10.650,2.750) -- (14.450,2.750);
  \draw[line width=0.5pt] (8.200,2.150) -- (14.450,2.150);
  \draw[line width=0.5pt] (8.800,1.550) -- (14.450,1.550);
  \draw[line width=0.5pt] (8.800,0.950) -- (14.450,0.950);
  \draw[line width=0.5pt] (8.200,0.950) -- (8.800,0.950);
  \draw[line width=0.5pt] (8.200,2.150) -- (8.200,0.950);
  \draw[line width=0.5pt] (8.800,2.150) -- (8.800,0.950);
  \draw[line width=0.5pt] (10.650,3.350) -- (10.650,0.950);
  \draw[line width=0.5pt] (12.550,2.750) -- (12.550,0.950);
  \draw[line width=0.5pt] (14.450,3.350) -- (14.450,0.950);
  \node[jug] at (12.550,3.050) {I};
  \node[acc] at (11.600,2.450) {Nicho pequeño};
  \node[acc] at (13.500,2.450) {Nicho grande};
  \node[jug] at (8.500,1.550) {E};
  \node[acc] at (9.725,1.850) {Nicho pequeño};
  \node at (11.600,1.850) {$-6,\ -6$};
  \node at (13.500,1.850) {$-1,\ 1$};
  \node[acc] at (9.725,1.250) {Nicho grande};
  \node at (11.600,1.250) {$1,\ -1$};
  \node at (13.500,1.250) {$-3,\ -3$};
  \node[nota, anchor=north west, text width=7.4cm] at (8.2,0.85) {Equilibrios de Nash del subjuego 2 (sombreados): E en el nicho grande e I en el pequeño ($\sigma_1$), o al revés ($\sigma_2$).};
  % Juegos reducidos
  \node[tit, anchor=west] at (-0.2,1.9) {ENPS-1 ($\sigma_1$): juego reducido};
  \node[nd, label=above:{\textbf{E}}] (g) at (1.6,1.3) {};
  \node[nd] (g1) at (0.8,0.3) {}; \node[nd] (g2) at (2.4,0.3) {};
  \draw[rama] (g) -- node[acc, above left] {Out} (g1);
  \draw[rama] (g) -- node[acc, above right] {In} (g2);
  \node[pago, below] at (g1.south) {$(0,\,2)$};
  \node[pago, below, fill=cyan!22, rounded corners=3pt] at (g2.south) {$(1,\,-1)$};
  \node[tit, anchor=west] at (4.1,1.9) {ENPS-2 ($\sigma_2$): juego reducido};
  \node[nd, label=above:{\textbf{E}}] (h) at (5.9,1.3) {};
  \node[nd] (h1) at (5.1,0.3) {}; \node[nd] (h2) at (6.7,0.3) {};
  \draw[rama] (h) -- node[acc, above left] {Out} (h1);
  \draw[rama] (h) -- node[acc, above right] {In} (h2);
  \node[pago, below, fill=cyan!22, rounded corners=3pt] at (h1.south) {$(0,\,2)$};
  \node[pago, below] at (h2.south) {$(-1,\,1)$};
  \node[nota, anchor=north west, text width=7.8cm] at (-0.2,-0.55) {P: nicho pequeño; G: nicho grande. Pagos: $(u_E,u_I)$. Cada juego reducido sustituye el subjuego 2 por los pagos de uno de sus equilibrios.};
\end{tikzpicture}
