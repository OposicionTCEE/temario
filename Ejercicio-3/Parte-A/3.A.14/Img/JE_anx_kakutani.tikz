% Anexo de juegos no cooperativos, «Existencia»: el teorema del punto fijo de KAKUTANI (1941) y el equilibrio de Nash. Elaboración propia.
% (a) Correspondencia de [0,1] en sí misma con grafo cerrado y valores convexos (un segmento vertical en el salto): corta la diagonal.
% (b) Si un valor no es convexo (dos puntos aislados en el salto), la correspondencia puede saltar por encima de la diagonal sin cortarla.
% (c) Mejores respuestas del juego de entrada simultáneo con J2 agresivo: el único punto fijo es (q*, p*). Posiciones ilustrativas.
\begin{tikzpicture}[font=\footnotesize, line cap=round,
    eje/.style={-{Stealth[length=2mm]}, line width=0.5pt},
    diag/.style={line width=0.5pt, black!40, dashed},
    corr/.style={line width=1.6pt},
    mr2/.style={line width=1.3pt, dashed},
    tit/.style={font=\footnotesize\bfseries}]
  \def\u{3.6}
  % (a) Valores convexos
  \node[tit] at (0.5*\u,\u+0.75) {(a) Valores convexos};
  \begin{scope}[shift={(0,0)}]
    \draw[line width=0.4pt, black!30] (0,0) rectangle (\u,\u);
    \draw[eje] (0,0) -- (\u+0.4,0) node[below left] {$x$};
    \draw[eje] (0,0) -- (0,\u+0.4) node[below left] {$\phi(x)$};
    \draw[diag] (0,0) -- (\u,\u);
    \draw[corr] (0,0.8*\u) -- (0.45*\u,0.8*\u) -- (0.45*\u,0.2*\u) -- (\u,0.2*\u);
    \fill (0.45*\u,0.45*\u) circle (2.4pt);
    \node[anchor=west] at (0.45*\u+0.08,0.45*\u) {$x^*\in\phi(x^*)$};
  \end{scope}
  % (b) Valores no convexos
  \node[tit] at (5.4+0.5*\u,\u+0.75) {(b) Valores no convexos};
  \begin{scope}[shift={(5.4,0)}]
    \draw[line width=0.4pt, black!30] (0,0) rectangle (\u,\u);
    \draw[eje] (0,0) -- (\u+0.4,0) node[below left] {$x$};
    \draw[eje] (0,0) -- (0,\u+0.4) node[below left] {$\phi(x)$};
    \draw[diag] (0,0) -- (\u,\u);
    \draw[corr] (0,0.8*\u) -- (0.45*\u,0.8*\u);
    \draw[corr] (0.45*\u,0.2*\u) -- (\u,0.2*\u);
    \fill (0.45*\u,0.8*\u) circle (2.4pt);
    \fill (0.45*\u,0.2*\u) circle (2.4pt);
    \draw[line width=0.5pt, black!40, dotted] (0.45*\u,0.2*\u) -- (0.45*\u,0.8*\u);
  \end{scope}
  % (c) Mejores respuestas del ejemplo
  \node[tit] at (10.8+0.5*\u,\u+0.75) {(c) Juego de entrada, J2 agresivo};
  \begin{scope}[shift={(10.8,0)}]
    \def\qs{0.4}
    \def\ps{0.6}
    \draw[line width=0.4pt, black!30] (0,0) rectangle (\u,\u);
    \draw[eje] (0,0) -- (\u+0.4,0) node[below left] {$q$};
    \draw[eje] (0,0) -- (0,\u+0.4) node[below left] {$p$};
    \draw (\qs*\u,0) -- (\qs*\u,-0.08) node[below] {$q^*$};
    \draw (0,\ps*\u) -- (-0.08,\ps*\u) node[left] {$p^*$};
    \draw[corr] (0,\u) -- (\qs*\u,\u) -- (\qs*\u,0) -- (\u,0);
    \draw[mr2] (0,0) -- (0,\ps*\u) -- (\u,\ps*\u) -- (\u,\u);
    \fill (\qs*\u,\ps*\u) circle (2.4pt);
    \node[fill=white, inner sep=1pt, anchor=south west] at (\qs*\u+0.08,\ps*\u+0.08) {EN};
    \node[anchor=south] at (0.2*\u,\u+0.05) {$MR_1$};
    \node[anchor=west] at (\u+0.08,0.8*\u) {$MR_2$};
  \end{scope}
\end{tikzpicture}
