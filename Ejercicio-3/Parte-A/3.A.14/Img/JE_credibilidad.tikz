% Juego de entrada (MAS-COLELL, WHINSTON y GREEN, 1995): (a) el equilibrio de Nash (Out, Luchar) descansa en una amenaza no creíble;
% (b) la inducción hacia atrás selecciona el único equilibrio perfecto en subjuegos, (In, Acomodar). Pagos (E, I): Out (0,2); In-Luchar (-3,-1); In-Acomodar (2,1).
\begin{tikzpicture}[font=\footnotesize, line cap=round,
    nd/.style={circle, fill=black, inner sep=0pt, minimum size=4.5pt},
    acc/.style={font=\footnotesize\itshape},
    pago/.style={font=\footnotesize},
    rama/.style={line width=0.6pt},
    elegida/.style={line width=2.2pt},
    tit/.style={font=\footnotesize\bfseries},
    nota/.style={font=\footnotesize, align=left},
    paso/.style={font=\footnotesize\bfseries, circle, draw, inner sep=1pt, minimum size=12pt}]
  % Árbol del juego de entrada; #1: estilo de Out, #2: de In, #3: de Luchar, #4: de Acomodar
  \def\arbol#1#2#3#4{%
    \node[nd, label=above:{\textbf{E}}] (e) at (2.6,3.4) {};
    \node[nd] (o) at (0.9,1.8) {};
    \node[nd, label=right:{\textbf{I}}] (i) at (3.9,1.8) {};
    \draw[#1] (e) -- node[acc, above left] {Out} (o);
    \draw[#2] (e) -- node[acc, above right] {In} (i);
    \node[pago, below] at (o.south) {$(0,\,2)$};
    \node[nd] (f) at (3.0,0.3) {};
    \node[nd] (a) at (4.8,0.3) {};
    \draw[#3] (i) -- node[acc, left] {Luchar} (f);
    \draw[#4] (i) -- node[acc, right] {Acomodar} (a);
    \node[pago, below] at (f.south) {$(-3,\,-1)$};
    \node[pago, below] at (a.south) {$(2,\,1)$};
  }
  % (a) Equilibrio de Nash con amenaza no creíble
  \node[tit] at (2.9,4.5) {(a) Equilibrio de Nash (Out, Luchar)};
  \begin{scope}
    \arbol{elegida}{rama}{elegida}{rama}
    \node[nota, text width=6.2cm, anchor=north west] at (-0.2,-0.6) {I amenaza con luchar si E entra. Si E se lo cree, no entra ($0>-3$), y la amenaza no le cuesta nada a I porque nunca tiene que cumplirla. Pero no es creíble: si E entrara, a I le convendría acomodar ($1>-1$).};
  \end{scope}
  % (b) Inducción hacia atrás
  \node[tit] at (11.4,4.5) {(b) Inducción hacia atrás: (In, Acomodar)};
  \begin{scope}[shift={(8.5,0)}]
    \arbol{rama}{elegida}{rama}{elegida}
    \node[paso] at (5.45,0.85) {1};
    \node[paso] at (3.3,3.75) {2};
    \node[nota, text width=6.4cm, anchor=north west] at (-0.2,-0.6) {(1) Se resuelve primero la última decisión: si E ha entrado, I acomoda ($1>-1$). (2) E anticipa esa respuesta y compara $2$ (entrar) con $0$ (no entrar): entra. Es el único equilibrio perfecto en subjuegos.};
  \end{scope}
  \node[nota, text width=15.2cm, anchor=north west] at (-0.2,-2.25) {Pagos: (E, I). En trazo grueso, las estrategias de cada equilibrio. Los dos perfiles son equilibrios de Nash, pero solo el de (b) prescribe conducta óptima también en el nodo de I.};
\end{tikzpicture}
