% Anexo de juegos no cooperativos, «Subjuegos»: subjuegos del juego de entrada. Elaboración propia.
% (a) Secuencial: tres subjuegos, el juego entero (recuadro exterior) y los que empiezan en x1 y en x2 (recuadros interiores).
% (b) Simultáneo: el único subjuego es el juego entero, porque x1 y x2 forman un mismo conjunto de información.
\begin{tikzpicture}[font=\footnotesize, line cap=round,
    nd/.style={circle, fill=black, inner sep=0pt, minimum size=4.5pt},
    acc/.style={font=\footnotesize\itshape},
    pago/.style={font=\footnotesize},
    nom/.style={font=\footnotesize, black!70},
    rama/.style={line width=0.6pt},
    info/.style={dashed, line width=0.6pt},
    sub/.style={draw=black!50, line width=0.6pt, dotted, rounded corners=6pt},
    tit/.style={font=\footnotesize\bfseries}]
  \def\arbol#1#2{%
    \begin{scope}[shift={(#1,0)}]
      \node[nd] (r) at (0,2.8) {};
      \node[font=\footnotesize\bfseries, above] at (r.north) {J1};
      \node[nom, right=2pt] at (r.east) {$x_0$};
      \node[nd] (i1) at (-1.7,1.5) {};
      \node[nd] (i2) at (1.7,1.5) {};
      \node[nom] at (-1.7,0.9) {$x_1$};
      \node[nom] at (1.7,0.9) {$x_2$};
      \ifnum#2=1
        \node[font=\footnotesize\bfseries, left] at (i1.west) {J2};
        \node[font=\footnotesize\bfseries, right] at (i2.east) {J2};
        \draw[sub] (-3.05,1.95) rectangle (-0.35,-0.6);
        \draw[sub] (0.35,1.95) rectangle (3.05,-0.6);
      \else
        \draw[info] (i1) -- (i2);
        \node[font=\footnotesize\bfseries, fill=white, inner sep=1pt] at (0,1.5) {J2};
      \fi
      \draw[sub] (-3.25,3.5) rectangle (3.25,-0.8);
      \draw[rama] (r) -- node[acc, above left] {Entrar} (i1);
      \draw[rama] (r) -- node[acc, above right] {No entrar} (i2);
      \foreach \p/\x/\l/\pos/\pg in {i1/-2.6/Alto/left/{(a_1,\,a_2)}, i1/-0.8/Bajo/right/{(b_1,\,b_2)}, i2/0.8/Alto/left/{(c_1,\,c_2)}, i2/2.6/Bajo/right/{(d_1,\,d_2)}} {
        \node[nd] (t) at (\x,0.2) {};
        \draw[rama] (\p) -- node[acc, \pos] {\l} (t);
        \node[pago, below] at (t.south) {$\pg$};
      }
    \end{scope}}
  \node[tit] at (3.8,4.0) {(a) Juego secuencial: tres subjuegos};
  \arbol{3.8}{1}
  \node[tit] at (12.0,4.0) {(b) Juego simultáneo: un subjuego};
  \arbol{12.0}{2}
\end{tikzpicture}
