% Forma normal del juego de entrada (apartado «Forma normal»): (a) versión simultánea, matriz 2x2; (b) versión secuencial, matriz 2x4. Elaboración propia.
% En (a), cada estrategia de J2 es (precio si J1 entra, precio si J1 no entra).
\begin{tikzpicture}[font=\footnotesize, line cap=round,
    nd/.style={circle, fill=black, inner sep=0pt, minimum size=4.5pt},
    jug/.style={font=\footnotesize\bfseries},
    acc/.style={font=\footnotesize\itshape},
    pago/.style={font=\footnotesize},
    rama/.style={line width=0.6pt},
    info/.style={dashed, line width=0.6pt},
    tit/.style={font=\footnotesize\bfseries}]
  \node[tit] at (2.45,0.6) {(a) Juego simultáneo};
  \node[tit] at (10.85,0.6) {(b) Juego secuencial};
  % Matriz 2x2: J1 (filas) frente a J2 (columnas)
  \fill[black!8] (0.0,0.15) rectangle (4.9,-0.95);
  \fill[black!8] (0.0,-0.95) rectangle (2.1,-2.05);
  \draw[line width=0.5pt] (2.1,0.15) -- (4.9,0.15);
  \draw[line width=0.5pt] (2.1,-0.40) -- (4.9,-0.40);
  \draw[line width=0.5pt] (0.0,-0.95) -- (4.9,-0.95);
  \draw[line width=0.5pt] (0.6,-1.50) -- (4.9,-1.50);
  \draw[line width=0.5pt] (0.0,-2.05) -- (4.9,-2.05);
  \draw[line width=0.5pt] (0.0,-0.95) -- (0.0,-2.05);
  \draw[line width=0.5pt] (0.6,-0.95) -- (0.6,-2.05);
  \draw[line width=0.5pt] (2.1,0.15) -- (2.1,-2.05);
  \draw[line width=0.5pt] (3.5,-0.40) -- (3.5,-2.05);
  \draw[line width=0.5pt] (4.9,0.15) -- (4.9,-2.05);
  \node[jug] at (3.5,-0.125) {J2};
  \node[acc] at (2.8,-0.675) {Alto};
  \node[acc] at (4.2,-0.675) {Bajo};
  \node[jug] at (0.3,-1.50) {J1};
  \node[acc] at (1.35,-1.225) {Entrar};
  \node[acc] at (1.35,-1.775) {No entrar};
  \node at (2.8,-1.225) {$a_1,\ a_2$};
  \node at (4.2,-1.225) {$b_1,\ b_2$};
  \node at (2.8,-1.775) {$c_1,\ c_2$};
  \node at (4.2,-1.775) {$d_1,\ d_2$};
  % Matriz 2x4: J1 (filas) frente a J2 (columnas)
  \fill[black!8] (6.4,0.15) rectangle (15.3,-0.95);
  \fill[black!8] (6.4,-0.95) rectangle (8.5,-2.05);
  \draw[line width=0.5pt] (8.5,0.15) -- (15.3,0.15);
  \draw[line width=0.5pt] (8.5,-0.40) -- (15.3,-0.40);
  \draw[line width=0.5pt] (6.4,-0.95) -- (15.3,-0.95);
  \draw[line width=0.5pt] (7.0,-1.50) -- (15.3,-1.50);
  \draw[line width=0.5pt] (6.4,-2.05) -- (15.3,-2.05);
  \draw[line width=0.5pt] (6.4,-0.95) -- (6.4,-2.05);
  \draw[line width=0.5pt] (7.0,-0.95) -- (7.0,-2.05);
  \draw[line width=0.5pt] (8.5,0.15) -- (8.5,-2.05);
  \foreach \x in {3.8,5.5,7.2} {\draw[line width=0.5pt] (\x,-0.40) -- (\x,-2.05);}
  \draw[line width=0.5pt] (15.3,0.15) -- (15.3,-2.05);
  \node[jug] at (11.9,-0.125) {J2};
  \node[acc] at (9.35,-0.675) {Alto, Alto};
  \node[acc] at (11.05,-0.675) {Alto, Bajo};
  \node[acc] at (12.75,-0.675) {Bajo, Alto};
  \node[acc] at (14.45,-0.675) {Bajo, Bajo};
  \node[jug] at (6.7,-1.50) {J1};
  \node[acc] at (7.75,-1.225) {Entrar};
  \node[acc] at (7.75,-1.775) {No entrar};
  \foreach \x/\pe/\pn in {2.95/{a_1,\ a_2}/{c_1,\ c_2}, 4.65/{a_1,\ a_2}/{d_1,\ d_2}, 6.35/{b_1,\ b_2}/{c_1,\ c_2}, 8.05/{b_1,\ b_2}/{d_1,\ d_2}} {
    \node at (\x,-1.225) {$\pe$};
    \node at (\x,-1.775) {$\pn$};
  }
\end{tikzpicture}
