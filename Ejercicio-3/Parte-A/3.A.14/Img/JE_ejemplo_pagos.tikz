% Pagos ciertos y pagos esperados en el juego de entrada (apartado «Función de pagos»). Elaboración propia.
% (a) J1 sabe que J2 fijará el precio alto si entra. (b) J1 cree que J2 bajará el precio con probabilidad q si entra.
\begin{tikzpicture}[font=\footnotesize, line cap=round,
    nd/.style={circle, fill=black, inner sep=0pt, minimum size=4.5pt},
    acc/.style={font=\footnotesize\itshape},
    pago/.style={font=\footnotesize},
    rama/.style={line width=0.6pt},
    elegida/.style={line width=1.6pt},
    tenue/.style={line width=0.6pt, black!35},
    tit/.style={font=\footnotesize\bfseries}]
  % (a) Resultado cierto
  \node[tit] at (3.6,3.6) {(a) Resultado cierto};
  \node[nd, label=above:{\textbf{J1}}] (r) at (3.6,2.8) {};
  \node[nd, label=left:{\textbf{J2}}] (i1) at (1.9,1.5) {};
  \node[nd, label=right:{\textbf{J2}}] (i2) at (5.3,1.5) {};
  \draw[rama] (r) -- node[acc, above left] {Entrar} (i1);
  \draw[rama] (r) -- node[acc, above right] {No entrar} (i2);
  \node[nd] (t1) at (1.0,0.2) {}; \node[nd] (t2) at (2.8,0.2) {};
  \node[nd] (t3) at (4.4,0.2) {}; \node[nd] (t4) at (6.2,0.2) {};
  \draw[elegida] (i1) -- node[acc, left] {Alto} (t1);
  \draw[tenue] (i1) -- node[acc, right] {Bajo} (t2);
  \draw[rama] (i2) -- node[acc, left] {Alto} (t3);
  \draw[rama] (i2) -- node[acc, right] {Bajo} (t4);
  \foreach \t/\pg in {t1/{(a_1,\,a_2)}, t2/{(b_1,\,b_2)}, t3/{(c_1,\,c_2)}, t4/{(d_1,\,d_2)}} {\node[pago, below] at (\t.south) {$\pg$};}
  \node[pago] at (3.6,-0.85) {Entrar: $a_1$\qquad No entrar: $c_1=d_1$};
  % (b) Resultado aleatorio
  \node[tit] at (11.6,3.6) {(b) Resultado aleatorio};
  \node[nd, label=above:{\textbf{J1}}] (s) at (11.6,2.8) {};
  \node[nd, label=left:{\textbf{J2}}] (k1) at (9.9,1.5) {};
  \node[nd, label=right:{\textbf{J2}}] (k2) at (13.3,1.5) {};
  \draw[rama] (s) -- node[acc, above left] {Entrar} (k1);
  \draw[rama] (s) -- node[acc, above right] {No entrar} (k2);
  \node[nd] (u1) at (9.0,0.2) {}; \node[nd] (u2) at (10.8,0.2) {};
  \node[nd] (u3) at (12.4,0.2) {}; \node[nd] (u4) at (14.2,0.2) {};
  \draw[rama] (k1) -- node[acc, left] {Alto ($1-q$)} (u1);
  \draw[rama] (k1) -- node[acc, right] {Bajo ($q$)} (u2);
  \draw[rama] (k2) -- node[acc, left] {Alto} (u3);
  \draw[rama] (k2) -- node[acc, right] {Bajo} (u4);
  \foreach \t/\pg in {u1/{(a_1,\,a_2)}, u2/{(b_1,\,b_2)}, u3/{(c_1,\,c_2)}, u4/{(d_1,\,d_2)}} {\node[pago, below] at (\t.south) {$\pg$};}
  \node[pago] at (11.6,-0.85) {Entrar: $(1-q)\,a_1+q\,b_1$\qquad No entrar: $c_1=d_1$};
\end{tikzpicture}
