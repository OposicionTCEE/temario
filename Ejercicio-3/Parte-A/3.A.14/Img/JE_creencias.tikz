% Juego con un conjunto de información no singleton y sistema de creencias. Elaboración propia a partir de MAS-COLELL, WHINSTON y GREEN (1995).
\begin{tikzpicture}[font=\footnotesize, line cap=round,
    nd/.style={circle, fill=black, inner sep=0pt, minimum size=4.5pt},
    jug/.style={font=\footnotesize\bfseries},
    acc/.style={font=\footnotesize\itshape},
    pago/.style={font=\footnotesize},
    rama/.style={line width=0.6pt},
    info/.style={dashed, line width=0.6pt},
    tit/.style={font=\footnotesize\bfseries},
    nota/.style={font=\footnotesize, align=left}]
  \node[nd, label=above:{\textbf{I}}] (r) at (3.6,5.0) {};
  \node[nd, label=left:{\textbf{I}}] (a) at (2.2,3.7) {};
  \node[nd] (b) at (5.2,3.7) {}; \node[pago, below] at (b.south) {$(1,\,3)$};
  \draw[rama] (r) -- node[acc, above left] {L} (a);
  \draw[rama] (r) -- node[acc, above right] {R} (b);
  \node[nd] (x) at (1.2,2.3) {}; \node[nd] (y) at (3.2,2.3) {};
  \draw[rama] (a) -- node[acc, above left] {L} (x);
  \draw[rama] (a) -- node[acc, above right] {M} (y);
  \draw[line width=0.7pt, rounded corners=8pt] (-0.1,1.95) rectangle (4.5,2.65);
  \node[jug] at (2.2,2.3) {II};
  \node[font=\footnotesize, anchor=east] at (1.05,2.3) {$[\mu]$};
  \node[font=\footnotesize, anchor=west] at (3.35,2.3) {$[1-\mu]$};
  \node[font=\footnotesize, anchor=west] at (4.55,2.3) {$H_2$};
  \foreach \p/\x/\l/\pos/\pg in {x/0.5/U/left/{(2,\,1)}, x/1.7/D/right/{(0,\,0)}, y/2.7/U/left/{(0,\,2)}, y/3.9/D/right/{(0,\,1)}} {
    \node[nd] (t) at (\x,0.9) {};
    \draw[rama] (\p) -- node[acc, \pos] {\l} (t);
    \node[pago, below] at (t.south) {$\pg$};
  }
  \node[pago, anchor=west, align=left] at (5.0,1.0) {Pagos:\\(I, II)};
\end{tikzpicture}
