% Mapa de los juegos no cooperativos: orden de las jugadas (estático/dinámico) e información (completa/incompleta),
% con el concepto de solución de cada casilla y el problema que lleva de una casilla a otra. Elaboración propia a partir de GIBBONS (1992).
\begin{tikzpicture}[font=\footnotesize, line cap=round,
    celda/.style={draw=black, line width=0.5pt, fill=black!5, rounded corners=2pt, text width=5.1cm, minimum height=3.8cm, align=left, inner sep=5pt, anchor=north west,
      execute at begin node={\hyphenpenalty=10000\exhyphenpenalty=10000}},
    cab/.style={font=\footnotesize\bfseries, align=center},
    flecha/.style={-{Stealth[length=2.6mm]}, line width=0.9pt},
    rot/.style={font=\footnotesize\itshape, align=center, execute at begin node={\hyphenpenalty=10000}}]
  % Cabeceras
  \node[cab] at (5.3,0) {Juegos estáticos (simultáneos)};
  \node[cab] at (12.6,0) {Juegos dinámicos (secuenciales)};
  \node[cab, text width=2.1cm] at (1.15,-2.5) {Información\\completa};
  \node[cab, text width=2.1cm] at (1.15,-7.8) {Información\\incompleta};
  % Casillas
  \node[celda] (tl) at (2.55,-0.6) {\textbf{Equilibrio de Nash}\\(NASH, 1950-1951)\\[2pt]
    \textit{Exige}: conjeturas correctas sobre lo que harán los demás.\\[2pt]
    Antes: dominancia y estrategias racionalizables. Existe siempre, al menos en estrategias mixtas, si el juego es finito.\\[2pt]
    \textit{Aplicaciones}: dilema del prisionero; COURNOT y BERTRAND (3.A.19).};
  \node[celda] (tr) at (9.85,-0.6) {\textbf{Equilibrio de Nash perfecto en subjuegos}\\(SELTEN, 1965)\\[2pt]
    \textit{Exige}: conducta óptima también fuera de la senda de equilibrio.\\[2pt]
    Se halla por inducción hacia atrás.\\[2pt]
    \textit{Aplicaciones}: STACKELBERG; disuasión de la entrada (3.A.19).};
  \node[celda] (bl) at (2.55,-5.9) {\textbf{Equilibrio bayesiano de Nash}\\(HARSANYI, 1967-1968)\\[2pt]
    \textit{Exige}: conjeturas correctas sobre la estrategia de cada tipo, ponderadas con probabilidades que todos conocen.\\[2pt]
    Una estrategia es un plan para cada tipo.\\[2pt]
    \textit{Aplicaciones}: subastas; diseño de mecanismos.};
  \node[celda] (br) at (9.85,-5.9) {\textbf{Equilibrio bayesiano perfecto}\\[2pt]
    \textit{Exige}: creencias en cada conjunto de información, actualizadas con la regla de Bayes, y conducta óptima dadas esas creencias.\\[2pt]
    Refinamientos: equilibrio secuencial (KREPS y WILSON, 1982), mano temblorosa \mbox{(SELTEN, 1975)}.\\[2pt]
    \textit{Aplicaciones}: señalización (SPENCE, 1973; 3.A.13).};
  % Flechas: el problema que obliga a pasar de una casilla a otra
  \draw[flecha] (tl.east |- 0,-2.5) -- node[rot, above, text width=2.2cm] {amenazas\\no creíbles} (tr.west |- 0,-2.5);
  \draw[flecha] (bl.east |- 0,-7.8) -- node[rot, above, text width=2.2cm] {jugadas que\\revelan el tipo} (br.west |- 0,-7.8);
  \draw[flecha] (tl.south) -- node[rot, right, text width=4.2cm, align=left] {información privada: tipos} (bl.north);
  \draw[flecha] (tr.south) -- node[rot, right, text width=4.2cm, align=left] {subjuegos insuficientes: creencias} (br.north);
  \node[font=\footnotesize, align=left, text width=15.2cm, anchor=north west] at (0.1,-9.95) {Cada casilla exige más a las expectativas de los jugadores que la anterior y la contiene como caso particular: todo equilibrio perfecto en subjuegos es un equilibrio de Nash, y el equilibrio bayesiano de Nash es el equilibrio de Nash del juego que resulta de la transformación de HARSANYI.};
\end{tikzpicture}
