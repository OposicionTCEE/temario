% Mapa de los juegos no cooperativos: orden de las jugadas (estático/dinámico) e información (completa/incompleta).
% Cada casilla: nombre del concepto y lo que exige. Cada flecha: el problema que obliga a pasar de una casilla a otra (cursiva)
% y la relación entre los dos conceptos. Elaboración propia a partir de GIBBONS (1992).
\begin{tikzpicture}[font=\footnotesize, line cap=round,
    celda/.style={draw=black, line width=0.5pt, fill=black!5, rounded corners=2pt, text width=5.1cm, minimum height=2.1cm, align=left, inner sep=5pt, anchor=north west,
      execute at begin node={\hyphenpenalty=10000\exhyphenpenalty=10000}},
    previa/.style={draw=black, line width=0.5pt, dashed, rounded corners=2pt, text width=5.1cm, minimum height=1.25cm, align=left, inner sep=5pt, anchor=north west,
      execute at begin node={\hyphenpenalty=10000\exhyphenpenalty=10000}},
    cab/.style={font=\footnotesize\bfseries, align=center},
    flecha/.style={-{Stealth[length=2.6mm]}, line width=0.9pt},
    prob/.style={font=\footnotesize\itshape, align=center, execute at begin node={\hyphenpenalty=10000}},
    rel/.style={font=\footnotesize, align=center, execute at begin node={\hyphenpenalty=10000}},
    lat/.style={font=\footnotesize, align=left, right, xshift=2pt, execute at begin node={\hyphenpenalty=10000\exhyphenpenalty=10000}}]
  % Cabeceras
  \node[cab] at (5.3,0) {Juegos estáticos (simultáneos)};
  \node[cab] at (12.6,0) {Juegos dinámicos (secuenciales)};
  \node[cab, text width=2.1cm] at (1.15,-3.65) {Información\\completa};
  \node[cab, text width=2.1cm] at (1.15,-7.55) {Información\\incompleta};
  % Conceptos previos al equilibrio
  \node[previa] (pr) at (2.55,-0.45) {\textbf{Dominancia y estrategias racionalizables}\\[2pt]
    \textit{Exigen}: racionalidad y su conocimiento común, pero no conjeturas correctas.};
  % Casillas
  \node[celda] (tl) at (2.55,-2.6) {\textbf{Equilibrio de NASH (EN)}\\[3pt]
    \textit{Exige}: conjeturas correctas sobre las estrategias de los demás.};
  \node[celda] (tr) at (9.85,-2.6) {\textbf{Equilibrio de NASH perfecto en subjuegos (ENPS)}\\[3pt]
    \textit{Exige}: además, conducta óptima en cada subjuego, también en los que el equilibrio no alcanza.};
  \node[celda] (bl) at (2.55,-6.5) {\textbf{Equilibrio bayesiano de NASH (EBN)}\\[3pt]
    \textit{Exige}: conjeturas correctas sobre la estrategia de cada tipo, ponderadas con probabilidades que todos conocen.};
  \node[celda] (br) at (9.85,-6.5) {\textbf{Equilibrio bayesiano perfecto (EBP)}\\[3pt]
    \textit{Exige}: creencias en cada conjunto de información, coherentes con la regla de Bayes, y conducta óptima dadas esas creencias.};
  % Flechas: problema (encima o a la izquierda) y relación (debajo o a la derecha)
  \draw[flecha] (pr.south -| 5.3,0) -- node[lat, text width=4.3cm] {\textit{conjeturas que no se cumplen}; las estrategias de un EN son racionalizables} (tl.north -| 5.3,0);
  \draw[flecha] (tl.east |- 0,-3.65) -- node[prob, above, text width=2.0cm] {amenazas\\no creíbles} node[rel, below, text width=2.0cm] {todo ENPS\\es EN} (tr.west |- 0,-3.65);
  \draw[flecha] (bl.east |- 0,-7.55) -- node[prob, above, text width=2.0cm] {jugadas que\\revelan el tipo} node[rel, below, text width=2.0cm] {todo EBP\\es EBN} (br.west |- 0,-7.55);
  \draw[flecha] (tl.south -| 5.3,0) -- node[lat, text width=4.3cm] {\textit{información privada: tipos}; el EBN es el EN del juego bayesiano} (bl.north -| 5.3,0);
  \draw[flecha] (tr.south -| 12.6,0) -- node[lat, text width=3.25cm] {\textit{subjuegos insuficientes: creencias}; con información perfecta, EBP y ENPS coinciden} (br.north -| 12.6,0);
\end{tikzpicture}
