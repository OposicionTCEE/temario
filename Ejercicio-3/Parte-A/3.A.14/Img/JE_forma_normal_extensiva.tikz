% Forma extensiva y forma normal del mismo juego, con y sin observación de la jugada de J1. Elaboración propia.
\begin{tikzpicture}[font=\footnotesize, line cap=round,
    nd/.style={circle, fill=black, inner sep=0pt, minimum size=4.5pt},
    jug/.style={font=\footnotesize\bfseries},
    acc/.style={font=\footnotesize\itshape},
    pago/.style={font=\footnotesize},
    rama/.style={line width=0.6pt},
    info/.style={dashed, line width=0.6pt},
    tit/.style={font=\footnotesize\bfseries},
    nota/.style={font=\footnotesize, align=left}]
  % (a) Juego secuencial: J2 observa la elección de J1
  \node[tit] at (2.2,4.6) {(a) J2 observa la jugada de J1};
  \node[nd, label=above:{\textbf{J1}}] (r) at (2.2,3.6) {};
  \node[nd, label=left:{\textbf{J2}}] (a1) at (1.0,2.4) {};
  \node[nd, label=right:{\textbf{J2}}] (a2) at (3.4,2.4) {};
  \draw[rama] (r) -- node[acc, above left] {U} (a1);
  \draw[rama] (r) -- node[acc, above right] {D} (a2);
  \foreach \p/\x/\l/\pos/\pg in {a1/0.45/l/left/{(2,\,1)}, a1/1.55/r/right/{(0,\,0)}, a2/2.85/l'/left/{(-1,\,1)}, a2/3.95/r'/right/{(3,\,2)}} {
    \node[nd] (t) at (\x,1.3) {};
    \draw[rama] (\p) -- node[acc, \pos] {$\l$} (t);
    \node[pago, below] at (t.south) {$\pg$};
  }
  % Matriz de pagos: J1 (filas) frente a J2 (columnas)
  \fill[black!8] (-0.550,0.150) rectangle (6.550,-0.950);
  \fill[black!8] (-0.550,-0.950) rectangle (1.150,-2.050);
  \draw[line width=0.5pt] (1.150,0.150) -- (6.550,0.150);
  \draw[line width=0.5pt] (1.150,-0.400) -- (6.550,-0.400);
  \draw[line width=0.5pt] (-0.550,-0.950) -- (6.550,-0.950);
  \draw[line width=0.5pt] (0.200,-1.500) -- (6.550,-1.500);
  \draw[line width=0.5pt] (0.200,-2.050) -- (6.550,-2.050);
  \draw[line width=0.5pt] (-0.550,-2.050) -- (0.200,-2.050);
  \draw[line width=0.5pt] (-0.550,-0.950) -- (-0.550,-2.050);
  \draw[line width=0.5pt] (0.200,-0.950) -- (0.200,-2.050);
  \draw[line width=0.5pt] (1.150,0.150) -- (1.150,-2.050);
  \draw[line width=0.5pt] (2.500,-0.400) -- (2.500,-2.050);
  \draw[line width=0.5pt] (3.850,-0.400) -- (3.850,-2.050);
  \draw[line width=0.5pt] (5.200,-0.400) -- (5.200,-2.050);
  \draw[line width=0.5pt] (6.550,0.150) -- (6.550,-2.050);
  \node[jug] at (3.850,-0.125) {J2};
  \node[acc] at (1.825,-0.675) {$l,l'$};
  \node[acc] at (3.175,-0.675) {$l,r'$};
  \node[acc] at (4.525,-0.675) {$r,l'$};
  \node[acc] at (5.875,-0.675) {$r,r'$};
  \node[jug] at (-0.175,-1.500) {J1};
  \node[acc] at (0.675,-1.225) {U};
  \node at (1.825,-1.225) {$2,\ 1$};
  \node at (3.175,-1.225) {$2,\ 1$};
  \node at (4.525,-1.225) {$0,\ 0$};
  \node at (5.875,-1.225) {$0,\ 0$};
  \node[acc] at (0.675,-1.775) {D};
  \node at (1.825,-1.775) {$-1,\ 1$};
  \node at (3.175,-1.775) {$3,\ 2$};
  \node at (4.525,-1.775) {$-1,\ 1$};
  \node at (5.875,-1.775) {$3,\ 2$};
  % (b) Juego simultáneo: J2 no observa la elección de J1 (conjunto de información con dos nodos)
  \node[tit] at (10.6,4.6) {(b) J2 no observa la jugada de J1};
  \node[nd, label=above:{\textbf{J1}}] (s) at (10.6,3.6) {};
  \node[nd, label=left:{\textbf{J2}}] (b1) at (9.4,2.4) {};
  \node[nd, label=right:{\textbf{J2}}] (b2) at (11.8,2.4) {};
  \draw[info] (b1) -- (b2);
  \draw[rama] (s) -- node[acc, above left] {U} (b1);
  \draw[rama] (s) -- node[acc, above right] {D} (b2);
  \foreach \p/\x/\l/\pos/\pg in {b1/8.85/l/left/{(2,\,1)}, b1/9.95/r/right/{(0,\,0)}, b2/11.25/l'/left/{(-1,\,1)}, b2/12.35/r'/right/{(3,\,2)}} {
    \node[nd] (t) at (\x,1.3) {};
    \draw[rama] (\p) -- node[acc, \pos] {$\l$} (t);
    \node[pago, below] at (t.south) {$\pg$};
  }
  % Matriz de pagos: J1 (filas) frente a J2 (columnas)
  \fill[black!8] (8.550,0.150) rectangle (12.950,-0.950);
  \fill[black!8] (8.550,-0.950) rectangle (10.250,-2.050);
  \draw[line width=0.5pt] (10.250,0.150) -- (12.950,0.150);
  \draw[line width=0.5pt] (10.250,-0.400) -- (12.950,-0.400);
  \draw[line width=0.5pt] (8.550,-0.950) -- (12.950,-0.950);
  \draw[line width=0.5pt] (9.300,-1.500) -- (12.950,-1.500);
  \draw[line width=0.5pt] (9.300,-2.050) -- (12.950,-2.050);
  \draw[line width=0.5pt] (8.550,-2.050) -- (9.300,-2.050);
  \draw[line width=0.5pt] (8.550,-0.950) -- (8.550,-2.050);
  \draw[line width=0.5pt] (9.300,-0.950) -- (9.300,-2.050);
  \draw[line width=0.5pt] (10.250,0.150) -- (10.250,-2.050);
  \draw[line width=0.5pt] (11.600,-0.400) -- (11.600,-2.050);
  \draw[line width=0.5pt] (12.950,0.150) -- (12.950,-2.050);
  \node[jug] at (11.600,-0.125) {J2};
  \node[acc] at (10.925,-0.675) {$l$};
  \node[acc] at (12.275,-0.675) {$r$};
  \node[jug] at (8.925,-1.500) {J1};
  \node[acc] at (9.775,-1.225) {U};
  \node at (10.925,-1.225) {$2,\ 1$};
  \node at (12.275,-1.225) {$0,\ 0$};
  \node[acc] at (9.775,-1.775) {D};
  \node at (10.925,-1.775) {$-1,\ 1$};
  \node at (12.275,-1.775) {$3,\ 2$};
  \node[nota, text width=15.5cm, anchor=north west] at (-0.55,-2.25) {Arriba, cada juego en forma extensiva; abajo, su forma normal. Pagos: (J1, J2). En (a), una estrategia de J2 indica qué hace tras U y qué hace tras D; en (b), las dos ramas de J2 están en un mismo conjunto de información (línea discontinua) y $l=l'$, $r=r'$.};
\end{tikzpicture}
