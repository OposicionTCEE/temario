% Subjuegos propios de un juego con tres jugadores. Elaboración propia.
\begin{tikzpicture}[font=\footnotesize, line cap=round,
    nd/.style={circle, fill=black, inner sep=0pt, minimum size=4.5pt},
    jug/.style={font=\footnotesize\bfseries},
    acc/.style={font=\footnotesize\itshape},
    pago/.style={font=\footnotesize},
    rama/.style={line width=0.6pt},
    info/.style={dashed, line width=0.6pt},
    tit/.style={font=\footnotesize\bfseries},
    nota/.style={font=\footnotesize, align=left}]
  \node[nd, label=above:{\textbf{J1}}] (r) at (2.7,4.4) {};
  \node[nd, label=above:{\textbf{J2}}] (a) at (1.5,3.2) {};
  \node[nd, label=above:{\textbf{J2}}] (b) at (4.1,3.2) {};
  \draw[rama] (r) -- (a); \draw[rama] (r) -- (b);
  \node[nd, label=left:{\textbf{J3}}] (c) at (0.9,1.9) {};
  \node[nd, label=right:{\textbf{J3}}] (d) at (2.1,1.9) {};
  \draw[rama] (a) -- (c); \draw[rama] (a) -- (d);
  \draw[info] (c) -- (d);
  \foreach \n in {c,d} { \draw[rama] (\n) -- ++(-0.35,-0.75); \draw[rama] (\n) -- ++(0.35,-0.75); }
  \draw[rama] (b) -- ++(-0.45,-0.9); \draw[rama] (b) -- ++(0.45,-0.9);
  \draw[red!55!black, line width=0.8pt] (1.5,2.35) ellipse (1.25 and 1.55);
  \draw[red!55!black, line width=0.8pt] (4.1,2.75) ellipse (0.8 and 0.95);
  \node[nota, anchor=west, text width=5.2cm] at (5.4,3.2) {En rojo, los subjuegos que empiezan en cada nodo de J2. El tercero es el propio juego. Ninguno empieza en J3: sus dos nodos forman un mismo conjunto de información (línea discontinua).};
\end{tikzpicture}
