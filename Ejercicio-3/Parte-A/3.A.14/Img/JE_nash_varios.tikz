% Varios equilibrios de Nash en la versión secuencial del juego de entrada, J2 acomodaticio (apartado «Existencia»). Elaboración propia.
% (a) Forma extensiva. (b) Forma normal 2x4: subrayado, mejor respuesta de cada jugador; recuadro grueso, los tres equilibrios de Nash:
% (Entrar; Alto, Alto), (Entrar; Alto, Bajo) y (No entrar; Bajo, Alto). Pagos: a1 > c1 = d1 > b1; a2 > b2; c2 > d2.
\begin{tikzpicture}[font=\footnotesize, line cap=round,
    nd/.style={circle, fill=black, inner sep=0pt, minimum size=4.5pt},
    jug/.style={font=\footnotesize\bfseries},
    acc/.style={font=\footnotesize\itshape},
    pago/.style={font=\footnotesize},
    rama/.style={line width=0.6pt},
    tit/.style={font=\footnotesize\bfseries},
    en/.style={line width=1.6pt}]
  % (a) Forma extensiva
  \node[tit] at (2.9,3.6) {(a) Forma extensiva};
  \node[nd, label=above:{\textbf{J1}}] (r) at (2.9,2.8) {};
  \node[nd, label=left:{\textbf{J2}}] (i1) at (1.4,1.5) {};
  \node[nd, label=right:{\textbf{J2}}] (i2) at (4.4,1.5) {};
  \draw[rama] (r) -- node[acc, above left] {Entrar} (i1);
  \draw[rama] (r) -- node[acc, above right] {No entrar} (i2);
  \foreach \p/\x/\l/\pos/\pg in {i1/0.6/Alto/left/{(a_1,\,a_2)}, i1/2.2/Bajo/right/{(b_1,\,b_2)}, i2/3.6/Alto/left/{(c_1,\,c_2)}, i2/5.2/Bajo/right/{(d_1,\,d_2)}} {
    \node[nd] (t) at (\x,0.2) {};
    \draw[rama] (\p) -- node[acc, \pos] {\l} (t);
    \node[pago, below] at (t.south) {$\pg$};
  }
  % (b) Forma normal 2x4
  \node[tit] at (11.15,3.6) {(b) Forma normal};
  \begin{scope}[shift={(6.7,2.9)}]
    \fill[black!8] (0,0) rectangle (8.9,-1.1);
    \fill[black!8] (0,-1.1) rectangle (2.1,-2.5);
    \draw[line width=0.5pt] (2.1,0) -- (8.9,0);
    \draw[line width=0.5pt] (2.1,-0.55) -- (8.9,-0.55);
    \draw[line width=0.5pt] (0,-1.1) -- (8.9,-1.1);
    \draw[line width=0.5pt] (0.6,-1.8) -- (8.9,-1.8);
    \draw[line width=0.5pt] (0,-2.5) -- (8.9,-2.5);
    \draw[line width=0.5pt] (0,-1.1) -- (0,-2.5);
    \draw[line width=0.5pt] (0.6,-1.1) -- (0.6,-2.5);
    \draw[line width=0.5pt] (2.1,0) -- (2.1,-2.5);
    \foreach \x in {3.8,5.5,7.2} {\draw[line width=0.5pt] (\x,-0.55) -- (\x,-2.5);}
    \draw[line width=0.5pt] (8.9,0) -- (8.9,-2.5);
    \node[jug] at (5.5,-0.275) {J2};
    \node[acc] at (2.95,-0.825) {Alto, Alto};
    \node[acc] at (4.65,-0.825) {Alto, Bajo};
    \node[acc] at (6.35,-0.825) {Bajo, Alto};
    \node[acc] at (8.05,-0.825) {Bajo, Bajo};
    \node[jug] at (0.3,-1.8) {J1};
    \node[acc] at (1.35,-1.45) {Entrar};
    \node[acc] at (1.35,-2.15) {No entrar};
    \node at (2.95,-1.45) {$\underline{a_1},\ \underline{a_2}$};
    \node at (4.65,-1.45) {$\underline{a_1},\ \underline{a_2}$};
    \node at (6.35,-1.45) {$b_1,\ b_2$};
    \node at (8.05,-1.45) {$b_1,\ b_2$};
    \node at (2.95,-2.15) {$c_1,\ \underline{c_2}$};
    \node at (4.65,-2.15) {$d_1,\ d_2$};
    \node at (6.35,-2.15) {$\underline{c_1},\ \underline{c_2}$};
    \node at (8.05,-2.15) {$\underline{d_1},\ d_2$};
    \draw[en] (2.16,-1.16) rectangle (3.74,-1.74);
    \draw[en] (3.86,-1.16) rectangle (5.44,-1.74);
    \draw[en] (5.56,-1.86) rectangle (7.14,-2.44);
  \end{scope}
\end{tikzpicture}
