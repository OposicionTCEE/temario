% Los elementos de un juego, señalados sobre el juego de entrada que acompaña al apartado «Reglas del juego». Elaboración propia.
% E (entrante) decide si entra; I (incumbente) observa su decisión y fija precio alto o bajo.
% Pagos (E, I): Entra-Alto (2,2); Entra-Bajo (-1,1); No entra-Alto (0,4); No entra-Bajo (0,2).
\begin{tikzpicture}[font=\footnotesize, line cap=round,
    nd/.style={circle, fill=black, inner sep=0pt, minimum size=4.5pt},
    acc/.style={font=\footnotesize\itshape},
    pago/.style={font=\footnotesize},
    rama/.style={line width=0.6pt},
    llam/.style={-{Stealth[length=4pt]}, line width=0.4pt, black!55},
    cuadro/.style={font=\footnotesize, align=left, text width=7.6cm, anchor=west, inner sep=1pt},
    nota/.style={font=\footnotesize, align=left}]
  % Árbol del juego
  \node[nd, label=above:{\textbf{E}}] (r) at (3.6,4.2) {};
  \node[nd, label=left:{\textbf{I}}] (i1) at (1.8,2.7) {};
  \node[nd, label=right:{\textbf{I}}] (i2) at (5.4,2.7) {};
  \draw[rama] (r) -- node[acc, above left] {Entra} (i1);
  \draw[rama] (r) -- node[acc, above right] {No entra} (i2);
  \foreach \p/\x/\l/\pos/\pg in {i1/0.9/Alto/left/{(2,\,2)}, i1/2.7/Bajo/right/{(-1,\,1)}, i2/4.5/Alto/left/{(0,\,4)}, i2/6.3/Bajo/right/{(0,\,2)}} {
    \node[nd] (t) at (\x,1.2) {};
    \draw[rama] (\p) -- node[acc, \pos] {\l} (t);
    \node[pago, below] at (t.south) {$\pg$};
  }
  % Llamadas: cada elemento de la descripción del juego
  \node[cuadro] at (8.0,4.2) {\textbf{Jugadores}: el entrante (E) y el incumbente (I). La naturaleza no interviene: nada se decide al azar.};
  \draw[llam] (7.9,4.2) -- (3.78,4.2);
  \node[cuadro] at (8.0,3.2) {\textbf{Acciones y orden}: primero E decide si entra; después, I fija un precio alto o bajo.};
  \draw[llam] (7.9,3.2) -- (4.92,3.2);
  \node[cuadro] at (8.0,1.95) {\textbf{Conjuntos de información}: I ve lo que ha hecho E, de modo que cada uno de sus dos nodos es un conjunto de información distinto.};
  \draw[llam] (7.9,1.95) -- (5.52,2.6);
  \node[cuadro] at (8.0,0.95) {\textbf{Pagos} (E, I): el beneficio de cada empresa al final de cada historia posible del juego.};
  \draw[llam] (7.9,0.95) -- (6.78,0.95);
  \node[nota, text width=15.5cm, anchor=north west] at (0,0.25) {La información es completa, porque cada empresa conoce los beneficios de la otra, y perfecta, porque I observa la decisión de E antes de fijar el precio.};
\end{tikzpicture}
