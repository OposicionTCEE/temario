% Dominancia estricta en la versión simultánea del juego de entrada, con J2 acomodaticio (apartado «Dominancia»). Elaboración propia.
% (a) Forma extensiva: J2 no observa si J1 ha entrado. (b) Forma normal: Alto domina estrictamente a Bajo si a2 > b2 y c2 > d2.
\begin{tikzpicture}[font=\footnotesize, line cap=round,
    nd/.style={circle, fill=black, inner sep=0pt, minimum size=4.5pt},
    jug/.style={font=\footnotesize\bfseries},
    acc/.style={font=\footnotesize\itshape},
    pago/.style={font=\footnotesize},
    rama/.style={line width=0.6pt},
    info/.style={dashed, line width=0.6pt},
    tit/.style={font=\footnotesize\bfseries}]
  % (a) Forma extensiva
  \node[tit] at (3.6,3.6) {(a) Forma extensiva};
  \node[nd, label=above:{\textbf{J1}}] (r) at (3.6,2.8) {};
  \node[nd] (i1) at (1.9,1.5) {};
  \node[nd] (i2) at (5.3,1.5) {};
  \draw[info] (i1) -- (i2);
  \node[jug, fill=white, inner sep=1pt] at (3.6,1.5) {J2};
  \draw[rama] (r) -- node[acc, above left] {Entrar} (i1);
  \draw[rama] (r) -- node[acc, above right] {No entrar} (i2);
  \foreach \p/\x/\l/\pos/\pg in {i1/1.0/Alto/left/{(a_1,\,a_2)}, i1/2.8/Bajo/right/{(b_1,\,b_2)}, i2/4.4/Alto/left/{(c_1,\,c_2)}, i2/6.2/Bajo/right/{(d_1,\,d_2)}} {
    \node[nd] (t) at (\x,0.2) {};
    \draw[rama] (\p) -- node[acc, \pos] {\l} (t);
    \node[pago, below] at (t.south) {$\pg$};
  }
  % (b) Forma normal
  \node[tit] at (11.6,3.6) {(b) Forma normal};
  \begin{scope}[shift={(9.15,2.9)}]
    \fill[black!8] (0,0) rectangle (4.9,-1.1);
    \fill[black!8] (0,-1.1) rectangle (2.1,-2.5);
    \draw[line width=0.5pt] (2.1,0) -- (4.9,0);
    \draw[line width=0.5pt] (2.1,-0.55) -- (4.9,-0.55);
    \draw[line width=0.5pt] (0,-1.1) -- (4.9,-1.1);
    \draw[line width=0.5pt] (0.6,-1.8) -- (4.9,-1.8);
    \draw[line width=0.5pt] (0,-2.5) -- (4.9,-2.5);
    \draw[line width=0.5pt] (0,-1.1) -- (0,-2.5);
    \draw[line width=0.5pt] (0.6,-1.1) -- (0.6,-2.5);
    \draw[line width=0.5pt] (2.1,0) -- (2.1,-2.5);
    \draw[line width=0.5pt] (3.5,-0.55) -- (3.5,-2.5);
    \draw[line width=0.5pt] (4.9,0) -- (4.9,-2.5);
    \node[jug] at (3.5,-0.275) {J2};
    \node[acc] at (2.8,-0.825) {Alto};
    \node[acc] at (4.2,-0.825) {Bajo};
    \node[jug] at (0.3,-1.8) {J1};
    \node[acc] at (1.35,-1.45) {Entrar};
    \node[acc] at (1.35,-2.15) {No entrar};
    \node at (2.8,-1.45) {$a_1,\ a_2$};
    \node at (4.2,-1.45) {$b_1,\ b_2$};
    \node at (2.8,-2.15) {$c_1,\ c_2$};
    \node at (4.2,-2.15) {$d_1,\ d_2$};
  \end{scope}
  \node[pago] at (11.6,-0.05) {$a_2>b_2$ y $c_2>d_2$\quad$\Rightarrow$\quad Alto domina estrictamente a Bajo};
\end{tikzpicture}
