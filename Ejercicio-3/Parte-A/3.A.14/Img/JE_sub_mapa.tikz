% Bloque 2, «Objetivos y taxonomía»: mapa de los formatos de subasta.
% Columnas: el ganador paga su propia puja / la puja de otro. Filas: subastas abiertas, a sobre cerrado (un objeto) y de varias unidades
% con demanda unitaria. Flechas verticales: relación entre formatos (equivalencia estratégica; equivalencia con valores privados; generalización).
% Debajo, el entorno de información, de valores privados a valor común. Elaboración propia a partir de KRISHNA (2002) y KLEMPERER (2004).
\begin{tikzpicture}[font=\footnotesize, line cap=round,
    celda/.style={draw=black, line width=0.5pt, fill=black!5, rounded corners=2pt, text width=5.3cm, minimum height=1.3cm, align=left, inner sep=5pt, anchor=north west,
      execute at begin node={\hyphenpenalty=10000\exhyphenpenalty=10000}},
    cab/.style={font=\footnotesize\bfseries, align=center},
    flecha/.style={{Stealth[length=2.4mm]}-{Stealth[length=2.4mm]}, line width=0.8pt},
    gen/.style={-{Stealth[length=2.4mm]}, line width=0.8pt},
    rel/.style={font=\footnotesize, align=left, right, xshift=3pt, execute at begin node={\hyphenpenalty=10000\exhyphenpenalty=10000}},
    eje/.style={{Stealth[length=2.2mm]}-{Stealth[length=2.2mm]}, line width=0.6pt}]
  % Cabeceras de columna
  \node[cab] at (5.55,0) {El ganador paga su propia puja};
  \node[cab] at (12.05,0) {El ganador paga la puja de otro};
  % Cabeceras de fila
  \node[cab, text width=2.3cm] at (1.2,-1.1) {Abiertas};
  \node[cab, text width=2.3cm] at (1.2,-3.5) {A sobre cerrado};
  \node[cab, text width=2.3cm] at (1.2,-5.9) {Varias unidades\\(demanda\\unitaria)};
  % Casillas
  \node[celda] (a1) at (2.75,-0.45) {\textbf{Descendente (holandesa)}\\[2pt] El precio baja hasta que alguien acepta y paga ese precio.};
  \node[celda] (a2) at (9.25,-0.45) {\textbf{Ascendente (inglesa)}\\[2pt] El precio sube hasta que solo queda uno, que paga el precio al que abandona el último rival.};
  \node[celda] (b1) at (2.75,-2.85) {\textbf{Primer precio}\\[2pt] Gana la puja más alta y paga su puja.};
  \node[celda] (b2) at (9.25,-2.85) {\textbf{Segundo precio (VICKREY)}\\[2pt] Gana la puja más alta y paga la segunda más alta.};
  \node[celda] (c1) at (2.75,-5.25) {\textbf{Discriminatoria (precios múltiples)}\\[2pt] Ganan las $k$ pujas más altas y cada una paga la suya.};
  \node[celda] (c2) at (9.25,-5.25) {\textbf{Precio uniforme}\\[2pt] Ganan las $k$ pujas más altas y todas pagan la primera rechazada.};
  % Relaciones
  \draw[flecha] (a1.south -| 4.0,0) -- node[rel, text width=3.6cm] {Estratégicamente equivalentes} (b1.north -| 4.0,0);
  \draw[flecha] (a2.south -| 10.5,0) -- node[rel, text width=3.6cm] {Equivalentes con valores privados} (b2.north -| 10.5,0);
  \draw[gen] (b1.south -| 4.0,0) -- node[rel, text width=3.6cm] {Generalización} (c1.north -| 4.0,0);
  \draw[gen] (b2.south -| 10.5,0) -- node[rel, text width=3.6cm] {Generalización} (c2.north -| 10.5,0);
  % Entorno de información
  \node[cab] at (8.8,-7.45) {Entorno de información};
  \draw[eje] (2.75,-8.05) -- (14.85,-8.05);
  \node[font=\footnotesize, below, align=center] at (2.95,-8.15) {Valores\\privados};
  \node[font=\footnotesize, below, align=center] at (14.65,-8.15) {Valor común\\puro};
  \node[font=\footnotesize, above, align=center] at (8.8,-8.0) {Modelo general (valores afiliados)};
  \foreach \x/\t in {5.4/Pintura, 7.9/Inmueble, 10.9/Bono del Tesoro, 13.3/Derechos petrolíferos} {
    \fill (\x,-8.05) circle (1.6pt);
    \node[font=\footnotesize, below, align=center, text width=2.0cm] at (\x,-8.15) {\t};
  }
\end{tikzpicture}
