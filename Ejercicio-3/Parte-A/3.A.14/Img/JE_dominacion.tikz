% Un ejemplo de juego con dominación: D domina a U para J1. Elaboración propia.
\begin{tikzpicture}[font=\footnotesize, line cap=round,
    nd/.style={circle, fill=black, inner sep=0pt, minimum size=4.5pt},
    jug/.style={font=\footnotesize\bfseries},
    acc/.style={font=\footnotesize\itshape},
    pago/.style={font=\footnotesize},
    rama/.style={line width=0.6pt},
    info/.style={dashed, line width=0.6pt},
    tit/.style={font=\footnotesize\bfseries},
    nota/.style={font=\footnotesize, align=left}]
  % Matriz de pagos: J1 (filas) frente a J2 (columnas)
  \fill[black!8] (0.000,0.000) rectangle (5.300,-1.200);
  \fill[black!8] (0.000,-1.200) rectangle (1.700,-2.400);
  \draw[line width=0.5pt] (1.700,0.000) -- (5.300,0.000);
  \draw[line width=0.5pt] (1.700,-0.600) -- (5.300,-0.600);
  \draw[line width=0.5pt] (0.000,-1.200) -- (5.300,-1.200);
  \draw[line width=0.5pt] (0.750,-1.800) -- (5.300,-1.800);
  \draw[line width=0.5pt] (0.750,-2.400) -- (5.300,-2.400);
  \draw[line width=0.5pt] (0.000,-2.400) -- (0.750,-2.400);
  \draw[line width=0.5pt] (0.000,-1.200) -- (0.000,-2.400);
  \draw[line width=0.5pt] (0.750,-1.200) -- (0.750,-2.400);
  \draw[line width=0.5pt] (1.700,0.000) -- (1.700,-2.400);
  \draw[line width=0.5pt] (3.500,-0.600) -- (3.500,-2.400);
  \draw[line width=0.5pt] (5.300,0.000) -- (5.300,-2.400);
  \node[jug] at (3.500,-0.300) {J2};
  \node[acc] at (2.600,-0.900) {$l$};
  \node[acc] at (4.400,-0.900) {$r$};
  \node[jug] at (0.375,-1.800) {J1};
  \node[acc] at (1.225,-1.500) {U};
  \node at (2.600,-1.500) {$-1,\ 3$};
  \node at (4.400,-1.500) {$2,\ 1$};
  \node[acc] at (1.225,-2.100) {D};
  \node at (2.600,-2.100) {$0,\ 2$};
  \node at (4.400,-2.100) {$3,\ 4$};
\end{tikzpicture}
