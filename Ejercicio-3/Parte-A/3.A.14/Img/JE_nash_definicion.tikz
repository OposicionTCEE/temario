% Equilibrio de Nash en estrategias puras en la versión simultánea del juego de entrada (introducción de «Equilibrio de NASH»). Elaboración propia.
% Subrayado: mejor respuesta de cada jugador a cada estrategia del otro. Recuadro grueso: casilla en la que las dos estrategias son mejores respuestas.
% (a) J2 acomodaticio (a2 > b2): (Entrar, Alto) es el único equilibrio. (b) J2 agresivo (b2 > a2): ninguna casilla lo es.
% En los dos casos, a1 > c1 = d1 > b1 y c2 > d2.
\begin{tikzpicture}[font=\footnotesize, line cap=round,
    jug/.style={font=\footnotesize\bfseries},
    acc/.style={font=\footnotesize\itshape},
    tit/.style={font=\footnotesize\bfseries},
    en/.style={line width=1.6pt}]
  \def\marco#1#2{%
    \begin{scope}[shift={(#1,#2)}]
      \fill[black!8] (0,0) rectangle (5.6,-1.1);
      \fill[black!8] (0,-1.1) rectangle (2.0,-3.1);
      \draw[line width=0.5pt] (2.0,0) -- (5.6,0);
      \draw[line width=0.5pt] (2.0,-0.55) -- (5.6,-0.55);
      \draw[line width=0.5pt] (0,-1.1) -- (5.6,-1.1);
      \draw[line width=0.5pt] (0.5,-2.1) -- (5.6,-2.1);
      \draw[line width=0.5pt] (0,-3.1) -- (5.6,-3.1);
      \draw[line width=0.5pt] (0,-1.1) -- (0,-3.1);
      \draw[line width=0.5pt] (0.5,-1.1) -- (0.5,-3.1);
      \draw[line width=0.5pt] (2.0,0) -- (2.0,-3.1);
      \draw[line width=0.5pt] (3.8,-0.55) -- (3.8,-3.1);
      \draw[line width=0.5pt] (5.6,0) -- (5.6,-3.1);
      \node[jug] at (3.8,-0.275) {J2};
      \node[acc] at (2.9,-0.825) {Alto};
      \node[acc] at (4.7,-0.825) {Bajo};
      \node[jug] at (0.25,-2.1) {J1};
      \node[acc] at (1.25,-1.6) {Entrar};
      \node[acc] at (1.25,-2.6) {No entrar};
    \end{scope}}
  % (a) J2 acomodaticio
  \node[tit] at (2.8,0.45) {(a) J2 acomodaticio: un equilibrio};
  \marco{0}{0}
  \node at (2.9,-1.6) {$\underline{a_1},\ \underline{a_2}$};
  \node at (4.7,-1.6) {$b_1,\ b_2$};
  \node at (2.9,-2.6) {$c_1,\ \underline{c_2}$};
  \node at (4.7,-2.6) {$\underline{d_1},\ d_2$};
  \draw[en] (2.06,-1.16) rectangle (3.74,-2.04);
  % (b) J2 agresivo
  \node[tit] at (11.6,0.45) {(b) J2 agresivo: ningún equilibrio en estrategias puras};
  \marco{8.8}{0}
  \node at (11.7,-1.6) {$\underline{a_1},\ a_2$};
  \node at (13.5,-1.6) {$b_1,\ \underline{b_2}$};
  \node at (11.7,-2.6) {$c_1,\ \underline{c_2}$};
  \node at (13.5,-2.6) {$\underline{d_1},\ d_2$};
\end{tikzpicture}
