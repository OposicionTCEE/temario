% Anexo de juegos no cooperativos, «Creencias»: pago esperado de J2 en su conjunto de información en la variante del juego de entrada
% en que J1 puede entrar imitando (probabilidad μ) o diferenciándose (1-μ). Mantener el precio: μ a2 + (1-μ) e2; bajarlo: μ b2 + (1-μ) f2.
% (a) a2 > b2 y e2 > f2: mantener el precio es mejor para cualquier creencia. (b) b2 > a2 y e2 > f2: bajarlo es mejor si μ > μ̄. Posiciones ilustrativas.
\begin{tikzpicture}[font=\footnotesize, line cap=round,
    eje/.style={-{Stealth[length=2mm]}, line width=0.5pt},
    alto/.style={line width=1.4pt},
    bajo/.style={line width=1.3pt, dashed},
    tit/.style={font=\footnotesize\bfseries}]
  \def\u{4.2}
  % (a)
  \node[tit] at (0.5*\u,3.95) {(a) $a_2>b_2$ y $e_2>f_2$};
  \begin{scope}
    \draw[eje] (0,0) -- (\u+0.5,0) node[below] {$\mu$};
    \draw[eje] (0,0) -- (0,3.4);
    \draw[black!40] (\u,0) -- (\u,3.2);
    \draw (0,0) -- (0,-0.08) node[below] {$0$};
    \draw (\u,0) -- (\u,-0.08) node[below] {$1$};
    \draw[alto] (0,2.2) -- (\u,2.9);
    \draw[bajo] (0,1.0) -- (\u,1.6);
    \node[left] at (0,2.2) {$e_2$}; \node[left] at (0,1.0) {$f_2$};
    \node[right] at (\u,2.9) {$a_2$}; \node[right] at (\u,1.6) {$b_2$};
    \node[anchor=south] at (0.5*\u,2.6) {Alto};
    \node[anchor=north] at (0.5*\u,1.25) {Bajo};
  \end{scope}
  % (b)
  \node[tit] at (8.2+0.5*\u,3.95) {(b) $b_2>a_2$ y $e_2>f_2$};
  \begin{scope}[shift={(8.2,0)}]
    \draw[eje] (0,0) -- (\u+0.5,0) node[below] {$\mu$};
    \draw[eje] (0,0) -- (0,3.4);
    \draw[black!40] (\u,0) -- (\u,3.2);
    \draw (0,0) -- (0,-0.08) node[below] {$0$};
    \draw (\u,0) -- (\u,-0.08) node[below] {$1$};
    \draw[alto] (0,2.2) -- (\u,1.4);
    \draw[bajo] (0,1.0) -- (\u,2.9);
    \node[left] at (0,2.2) {$e_2$}; \node[left] at (0,1.0) {$f_2$};
    \node[right] at (\u,1.4) {$a_2$}; \node[right] at (\u,2.9) {$b_2$};
    \pgfmathsetmacro{\mb}{(2.2-1.0)/((2.9-1.0)-(1.4-2.2))}
    \draw[black!50, dotted] (\mb*\u,0) -- (\mb*\u,{2.2+(1.4-2.2)*\mb});
    \draw (\mb*\u,0) -- (\mb*\u,-0.08) node[below] {$\bar{\mu}$};
    \fill (\mb*\u,{2.2+(1.4-2.2)*\mb}) circle (2pt);
    \node[anchor=south] at (0.2*\u,2.1) {Alto};
    \node[anchor=south] at (0.85*\u,2.75) {Bajo};
  \end{scope}
\end{tikzpicture}
