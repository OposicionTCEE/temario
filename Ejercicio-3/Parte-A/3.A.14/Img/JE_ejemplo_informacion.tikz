% Información completa e incompleta en el juego de entrada (apartado «Información»). Elaboración propia a partir de HARSANYI (1967-1968).
% (a) Juego de información completa. (b) Transformación de HARSANYI: la naturaleza elige el tipo de J2, acomodaticio (θ_ac, probabilidad p)
% o agresivo (θ_ag, probabilidad 1-p); J2 lo observa y J1 no (sus dos nodos forman un único conjunto de información).
% Los pagos de J2 de tipo agresivo llevan acento circunflejo.
\begin{tikzpicture}[font=\footnotesize, line cap=round,
    nd/.style={circle, fill=black, inner sep=0pt, minimum size=4.5pt},
    nat/.style={circle, draw=black, fill=white, line width=0.6pt, inner sep=0pt, minimum size=6pt},
    acc/.style={font=\footnotesize\itshape},
    pago/.style={font=\footnotesize},
    rama/.style={line width=0.6pt},
    info/.style={dashed, line width=0.6pt},
    tit/.style={font=\footnotesize\bfseries}]
  % (a) Información completa
  \node[tit] at (8,0.85) {(a) Información completa};
  \node[nd, label=above:{\textbf{J1}}] (r) at (8,0) {};
  \node[nd, label=left:{\textbf{J2}}] (i1) at (6.2,-1.2) {};
  \node[nd, label=right:{\textbf{J2}}] (i2) at (9.8,-1.2) {};
  \draw[rama] (r) -- node[acc, above left] {Entrar} (i1);
  \draw[rama] (r) -- node[acc, above right] {No entrar} (i2);
  \foreach \p/\x/\l/\pos/\pg in {i1/5.3/Alto/left/{(a_1,\,a_2)}, i1/7.1/Bajo/right/{(b_1,\,b_2)}, i2/8.9/Alto/left/{(c_1,\,c_2)}, i2/10.7/Bajo/right/{(d_1,\,d_2)}} {
    \node[nd] (t) at (\x,-2.4) {};
    \draw[rama] (\p) -- node[acc, \pos] {\l} (t);
    \node[pago, below] at (t.south) {$\pg$};
  }
  % (b) Información incompleta: transformación de HARSANYI
  \node[tit] at (8,-3.55) {(b) Información incompleta: transformación de HARSANYI};
  \node[nat, label=above:{\textbf{Naturaleza}}] (n) at (8,-4.4) {};
  \node[nd] (j1) at (4,-5.6) {};
  \node[nd] (j2) at (12,-5.6) {};
  \draw[rama] (n) -- node[acc, above left] {$\theta_{ac}$ ($p$)} (j1);
  \draw[rama] (n) -- node[acc, above right] {$\theta_{ag}$ ($1-p$)} (j2);
  \draw[info] (j1) -- (j2);
  \node[font=\footnotesize\bfseries, fill=white, inner sep=1.5pt] at (8,-5.6) {J1};
  \node[nd, label=left:{\textbf{J2}}] (k1) at (2.1,-6.8) {};
  \node[nd, label=right:{\textbf{J2}}] (k2) at (5.9,-6.8) {};
  \node[nd, label=left:{\textbf{J2}}] (k3) at (10.1,-6.8) {};
  \node[nd, label=right:{\textbf{J2}}] (k4) at (13.9,-6.8) {};
  \draw[rama] (j1) -- node[acc, above left] {Entrar} (k1);
  \draw[rama] (j1) -- node[acc, above right] {No entrar} (k2);
  \draw[rama] (j2) -- node[acc, above left] {Entrar} (k3);
  \draw[rama] (j2) -- node[acc, above right] {No entrar} (k4);
  \foreach \p/\x/\l/\pos/\pg in {k1/1.15/Alto/left/{(a_1,\,a_2)}, k1/3.05/Bajo/right/{(b_1,\,b_2)}, k2/4.95/Alto/left/{(c_1,\,c_2)}, k2/6.85/Bajo/right/{(d_1,\,d_2)},
                                 k3/9.15/Alto/left/{(a_1,\,\hat{a}_2)}, k3/11.05/Bajo/right/{(b_1,\,\hat{b}_2)}, k4/12.95/Alto/left/{(c_1,\,\hat{c}_2)}, k4/14.85/Bajo/right/{(d_1,\,\hat{d}_2)}} {
    \node[nd] (t) at (\x,-8.0) {};
    \draw[rama] (\p) -- node[acc, \pos] {\l} (t);
    \node[pago, below] at (t.south) {$\pg$};
  }
\end{tikzpicture}
