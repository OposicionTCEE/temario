% Anexo de diseño de mecanismos, «Subastas», equivalencia de ingresos: pujas de equilibrio de los cuatro formatos a sobre cerrado
% con valoraciones uniformes en [0, θ̄]. (a) Segundo precio b = θ y primer precio b = (n-1)θ/n para n y n' > n.
% (b) Tercer precio b = (n-1)θ/(n-2) y todo-pago b = (n-1)θ^n/(n θ̄^(n-1)), con la recta θ de referencia.
% Valores ilustrativos para el dibujo: n = 4, n' = 8 (no se rotulan).
\begin{tikzpicture}[font=\footnotesize, line cap=round,
    eje/.style={-{Stealth[length=2mm]}, line width=0.5pt},
    ref/.style={black!45, line width=0.6pt, dotted},
    f1/.style={line width=1.3pt},
    f2/.style={line width=1.3pt, dashed},
    f3/.style={line width=1.0pt, densely dashed, black!60},
    tit/.style={font=\footnotesize\bfseries}]
  \def\u{4.4}  % ancho de [0, θ̄]
  \def\v{2.9}  % alto de una unidad de puja (θ̄)
  % ---------- (a) ----------
  \node[tit] at (0.5*\u,1.62*\v) {(a) Primer y segundo precio};
  \begin{scope}
    \draw[eje] (0,0) -- (\u+0.45,0) node[below] {$\theta$};
    \draw[eje] (0,0) -- (0,1.5*\v) node[left] {Puja};
    \draw (0,0) node[below left] {$0$};
    \draw (\u,0) -- (\u,-0.08) node[below] {$\bar{\theta}$};
    \draw (0,\v) -- (-0.08,\v) node[left] {$\bar{\theta}$};
    \draw[black!30] (\u,0) -- (\u,1.1*\v);
    \draw[f1] (0,0) -- (\u,\v) node[right] {$b^{II}=\theta$};
    \draw[f2] (0,0) -- (\u,0.875*\v) node[right] {$b^{I}\ (n')$};
    \draw[f3] (0,0) -- (\u,0.75*\v) node[right] {$b^{I}\ (n)$};
  \end{scope}
  % ---------- (b) ----------
  \begin{scope}[shift={(7.6,0)}]
    \node[tit] at (0.5*\u,1.62*\v) {(b) Tercer precio y todo-pago};
    \draw[eje] (0,0) -- (\u+0.45,0) node[below] {$\theta$};
    \draw[eje] (0,0) -- (0,1.6*\v) node[left] {Puja};
    \draw (0,0) node[below left] {$0$};
    \draw (\u,0) -- (\u,-0.08) node[below] {$\bar{\theta}$};
    \draw (0,\v) -- (-0.08,\v) node[left] {$\bar{\theta}$};
    \draw[black!30] (\u,0) -- (\u,1.55*\v);
    \draw[ref] (0,0) -- (\u,\v) node[right, black!60] {$\theta$};
    \draw[f1] (0,0) -- (\u,1.5*\v) node[right] {$b^{III}\ (n)$};
    \draw[f2] plot[domain=0:1, samples=60] ({\x*\u},{0.75*\x^4*\v}) node[right] {$b^{AP}\ (n)$};
  \end{scope}
\end{tikzpicture}
