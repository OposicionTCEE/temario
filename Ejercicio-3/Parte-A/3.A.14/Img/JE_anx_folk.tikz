% Anexo de juegos no cooperativos, «Juegos repetidos»: pagos factibles e individualmente racionales del dilema del prisionero, con T > R > P > S
% (y 2R > T + S). El conjunto factible es la envolvente convexa de (R,R), (T,S), (S,T) y (P,P); la zona sombreada es la de pagos que superan
% el pago de minimax, P, de cada jugador, que el teorema de tradición oral permite sostener como ENPS si los jugadores son pacientes. Elaboración propia.
% Posiciones ilustrativas: S = 0, P = 1, R = 3, T = 4.
\begin{tikzpicture}[font=\footnotesize, line cap=round, scale=0.95,
    eje/.style={-{Stealth[length=2mm]}, line width=0.5pt},
    tit/.style={font=\footnotesize\bfseries}]
  \def\S{0} \def\P{1} \def\R{3} \def\T{4}
  % Zona individualmente racional dentro del conjunto factible: v1 >= P y v2 >= P
  \pgfmathsetmacro{\yP}{\T+(\R-\T)*(\P-\S)/(\R-\S)}
  \fill[black!15] (\P,\P) -- (\P,\yP) -- (\R,\R) -- (\yP,\P) -- cycle;
  % Conjunto factible
  \draw[line width=0.9pt] (\R,\R) -- (\T,\S) -- (\P,\P) -- (\S,\T) -- cycle;
  \draw[eje] (-0.3,0) -- (5.2,0) node[below] {$v_1$};
  \draw[eje] (0,-0.3) -- (0,4.8) node[below left] {$v_2$};
  \draw[dashed, black!50] (\P,0) -- (\P,4.4);
  \draw[dashed, black!50] (0,\P) -- (4.4,\P);
  \foreach \x/\l in {\S/$S$, \P/$P$, \R/$R$, \T/$T$} {\draw (\x,0) -- (\x,-0.08) node[below] {\l};}
  \foreach \y/\l in {\P/$P$, \R/$R$, \T/$T$} {\draw (0,\y) -- (-0.08,\y) node[left] {\l};}
  \fill (\R,\R) circle (2pt) node[above right] {$(R,R)$};
  \fill (\T,\S) circle (2pt) node[above right] {$(T,S)$};
  \fill (\S,\T) circle (2pt) node[above right] {$(S,T)$};
  \fill (\P,\P) circle (2pt) node[below left] {$(P,P)$};
\end{tikzpicture}
