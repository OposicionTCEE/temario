% Anexo de juegos no cooperativos, «Forma extensiva»: el juego de entrada con la notación formal de MAS-COLELL, WHINSTON y GREEN (1995).
% Nodo inicial x0 (J1); nodos de decisión de J2, x1 (tras Entrar) y x2 (tras No entrar); nodos terminales t1 a t4.
% (a) Secuencial: H = {{x0}, {x1}, {x2}}. (b) Simultáneo: H = {{x0}, {x1, x2}}. Elaboración propia.
\begin{tikzpicture}[font=\footnotesize, line cap=round,
    nd/.style={circle, fill=black, inner sep=0pt, minimum size=4.5pt},
    acc/.style={font=\footnotesize\itshape},
    pago/.style={font=\footnotesize},
    nom/.style={font=\footnotesize, black!70},
    rama/.style={line width=0.6pt},
    info/.style={dashed, line width=0.6pt},
    conj/.style={draw=black!45, line width=0.5pt, rounded corners=7pt},
    tit/.style={font=\footnotesize\bfseries}]
  % \arbol{centro}{1: secuencial; 2: simultáneo}
  \def\arbol#1#2{%
    \begin{scope}[shift={(#1,0)}]
      \node[nd] (r) at (0,2.8) {};
      \node[font=\footnotesize\bfseries, above] at (r.north) {J1};
      \node[nom, right=2pt] at (r.east) {$x_0$};
      \node[nd] (i1) at (-1.7,1.5) {};
      \node[nd] (i2) at (1.7,1.5) {};
      \ifnum#2=1
        \draw[conj] (-2.15,1.22) rectangle (-1.25,1.78);
        \draw[conj] (1.25,1.22) rectangle (2.15,1.78);
        \node[font=\footnotesize\bfseries, left] at (-2.15,1.5) {J2};
        \node[font=\footnotesize\bfseries, right] at (2.15,1.5) {J2};
      \else
        \draw[conj] (-2.15,1.22) rectangle (2.15,1.78);
        \draw[info] (i1) -- (i2);
        \node[font=\footnotesize\bfseries, left] at (-2.15,1.5) {J2};
        \node[nom, right] at (2.15,1.5) {$\{x_1,x_2\}$};
      \fi
      \node[nom] at (-1.7,0.9) {$x_1$};
      \node[nom] at (1.7,0.9) {$x_2$};
      \draw[rama] (r) -- node[acc, above left] {Entrar} (i1);
      \draw[rama] (r) -- node[acc, above right] {No entrar} (i2);
      \foreach \p/\x/\l/\pos/\t/\pg in {i1/-2.6/Alto/left/t_1/{(a_1,\,a_2)}, i1/-0.8/Bajo/right/t_2/{(b_1,\,b_2)}, i2/0.8/Alto/left/t_3/{(c_1,\,c_2)}, i2/2.6/Bajo/right/t_4/{(d_1,\,d_2)}} {
        \node[nd] (t) at (\x,0.2) {};
        \draw[rama] (\p) -- node[acc, \pos] {\l} (t);
        \node[nom, right=1pt] at (t.east) {$\t$};
        \node[pago, below] at (t.south) {$\pg$};
      }
    \end{scope}}
  \node[tit] at (3.7,3.75) {(a) Juego secuencial};
  \arbol{3.7}{1}
  \node[tit] at (12.1,3.75) {(b) Juego simultáneo};
  \arbol{12.1}{2}
\end{tikzpicture}
