% Bloque 2, «Límites», teorema de GIBBARD y SATTERTHWAITE: el Tesoro elige entre tres formatos (x, y, z) por mayoría relativa
% a partir de las ordenaciones que declaran las entidades, sin pagos. Tres grupos de entidades, con n_x > n_y > n_z y n_y + n_z > n_x.
% (a) Declaraciones sinceras: x ≻ y ≻ z (n_x), y ≻ z ≻ x (n_y), z ≻ y ≻ x (n_z); gana x.
% (b) Voto útil: el grupo z declara y ≻ z ≻ x (columna sombreada); gana y, que el grupo z prefiere a x.
\begin{tikzpicture}[font=\footnotesize, line cap=round,
    tit/.style={font=\footnotesize\bfseries},
    lin/.style={line width=0.5pt}]
  \foreach \p/\titulo/\zuno/\zdos/\cy/\cz/\gana/\sombra in {
      0/{(a) Declaraciones sinceras}/z/y/{n_y}/{n_z}/x/0,
      8.4/{(b) Voto útil del grupo $z$}/y/z/{n_y+n_z}/{0}/y/1} {
    \begin{scope}[shift={(\p,0)}]
      \node[tit] at (3.35,3.55) {\titulo};
      % columna modificada
      \ifnum\sombra=1 \fill[black!14] (4.6,0.6) rectangle (6.1,2.45); \fi
      % tabla de ordenaciones declaradas
      \draw[lin] (1.6,0.6) rectangle (6.1,3.05);
      \draw[lin] (1.6,2.45) -- (6.1,2.45);
      \draw[lin] (3.1,0.6) -- (3.1,3.05);
      \draw[lin] (4.6,0.6) -- (4.6,3.05);
      \node at (0.8,2.75) {Entidades};
      \node at (2.35,2.75) {$n_x$};
      \node at (3.85,2.75) {$n_y$};
      \node at (5.35,2.75) {$n_z$};
      \node at (0.8,2.1) {$1.^{\text{er}}$ lugar};
      \node at (0.8,1.5) {$2.^{\text{o}}$ lugar};
      \node at (0.8,0.9) {$3.^{\text{er}}$ lugar};
      \node at (2.35,2.1) {$x$}; \node at (2.35,1.5) {$y$}; \node at (2.35,0.9) {$z$};
      \node at (3.85,2.1) {$y$}; \node at (3.85,1.5) {$z$}; \node at (3.85,0.9) {$x$};
      \node at (5.35,2.1) {$\zuno$}; \node at (5.35,1.5) {$\zdos$}; \node at (5.35,0.9) {$x$};
      % recuento de primeros lugares y formato elegido
      \node[anchor=west] at (0.15,0.05) {Primeros lugares:\quad $x$: $n_x$\quad $y$: $\cy$\quad $z$: $\cz$};
      \node[anchor=west, font=\footnotesize\bfseries] at (0.15,-0.5) {Elegido: $\gana$};
    \end{scope}
  }
  \node at (7.45,-1.2) {$n_x>n_y>n_z,\qquad n_y+n_z>n_x$};
\end{tikzpicture}
