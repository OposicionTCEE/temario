% Juego de cara o cruz (matching pennies): (a) matriz de pagos; (b) mejores respuestas y equilibrio de Nash en estrategias mixtas.
% Elaboración propia a partir de MAS-COLELL, WHINSTON y GREEN (1995). J1 gana si las monedas no coinciden; J2, si coinciden.
% Mejor respuesta de J1: Cara (p=1) si q<1/2, Cruz (p=0) si q>1/2. De J2: Cara (q=1) si p>1/2, Cruz (q=0) si p<1/2. EN: p=q=1/2.
\begin{tikzpicture}[font=\footnotesize, line cap=round,
    jug/.style={font=\footnotesize\bfseries},
    acc/.style={font=\footnotesize\itshape},
    tit/.style={font=\footnotesize\bfseries},
    nota/.style={font=\footnotesize, align=left},
    mr1/.style={line width=1.6pt},
    mr2/.style={line width=1.3pt, dashed}]
  % (a) Matriz de pagos: Jugador 1 (filas) frente a Jugador 2 (columnas)
  \node[tit] at (3.05,0.9) {(a) Matriz de pagos};
  \begin{scope}[shift={(0,-0.4)}]
  \fill[black!8] (0.000,0.000) rectangle (6.100,-1.200);
  \fill[black!8] (0.000,-1.200) rectangle (2.500,-2.400);
  \draw[line width=0.5pt] (2.500,0.000) -- (6.100,0.000);
  \draw[line width=0.5pt] (2.500,-0.600) -- (6.100,-0.600);
  \draw[line width=0.5pt] (0.000,-1.200) -- (6.100,-1.200);
  \draw[line width=0.5pt] (1.500,-1.800) -- (6.100,-1.800);
  \draw[line width=0.5pt] (1.500,-2.400) -- (6.100,-2.400);
  \draw[line width=0.5pt] (0.000,-2.400) -- (1.500,-2.400);
  \draw[line width=0.5pt] (0.000,-1.200) -- (0.000,-2.400);
  \draw[line width=0.5pt] (1.500,-1.200) -- (1.500,-2.400);
  \draw[line width=0.5pt] (2.500,0.000) -- (2.500,-2.400);
  \draw[line width=0.5pt] (4.300,-0.600) -- (4.300,-2.400);
  \draw[line width=0.5pt] (6.100,0.000) -- (6.100,-2.400);
  \node[jug] at (4.300,-0.300) {Jugador 2};
  \node[acc] at (3.400,-0.900) {Cara ($q$)};
  \node[acc] at (5.200,-0.900) {Cruz ($1-q$)};
  \node[jug, align=center] at (0.750,-1.800) {Jugador\\1};
  \node[acc] at (2.000,-1.500) {Cara ($p$)};
  \node at (3.400,-1.500) {$-1,\ +1$};
  \node at (5.200,-1.500) {$+1,\ -1$};
  \node[acc] at (2.000,-2.100) {Cruz ($1-p$)};
  \node at (3.400,-2.100) {$+1,\ -1$};
  \node at (5.200,-2.100) {$-1,\ +1$};
  \end{scope}
  % (b) Mejores respuestas en el cuadrado (p, q)
  \node[tit] at (10.6,0.9) {(b) Mejores respuestas};
  \begin{scope}[shift={(8.3,-4.9)}]
    \def\u{4.6}
    \draw[line width=0.4pt, black!35] (0,0) rectangle (\u,\u);
    \draw[-{Stealth[length=2mm]}, line width=0.5pt] (0,0) -- (\u+0.5,0) node[below left, xshift=-2pt] {$p$};
    \draw[-{Stealth[length=2mm]}, line width=0.5pt] (0,0) -- (0,\u+0.5) node[below left] {$q$};
    \foreach \t/\l in {0/$0$, 0.5/$\tfrac{1}{2}$, 1/$1$} {
      \draw (\t*\u,0) -- (\t*\u,-0.08) node[below] {\l};
      \draw (0,\t*\u) -- (-0.08,\t*\u) node[left] {\l};
    }
    % Mejor respuesta de J1: p en función de q
    \draw[mr1] (\u,0) -- (\u,0.5*\u) -- (0,0.5*\u) -- (0,\u);
    % Mejor respuesta de J2: q en función de p
    \draw[mr2] (0,0) -- (0.5*\u,0) -- (0.5*\u,\u) -- (\u,\u);
    \fill (0.5*\u,0.5*\u) circle (2.6pt);
    \node[font=\footnotesize, fill=white, inner sep=1pt, anchor=south west] at (0.5*\u+0.08,0.5*\u+0.08) {EN};
    \node[font=\footnotesize, anchor=west] at (\u+0.1,0.25*\u) {MR de J1};
    \node[font=\footnotesize, anchor=west] at (\u+0.1,\u) {MR de J2};
  \end{scope}
  \node[nota, text width=15.2cm, anchor=north west] at (0,-6.0) {Pagos: (Jugador 1, Jugador 2). J1 gana si las monedas no coinciden y J2 si coinciden, de modo que ninguna casilla es un equilibrio en estrategias puras. En (b), $p$ y $q$ son las probabilidades con que J1 y J2 juegan Cara. La mejor respuesta (MR) de J1, en trazo continuo, es Cara si $q<\tfrac{1}{2}$ y Cruz si $q>\tfrac{1}{2}$; la de J2, discontinua, es Cara si $p>\tfrac{1}{2}$ y Cruz si $p<\tfrac{1}{2}$. Solo se cortan en $p=q=\tfrac{1}{2}$: cada jugador elige al azar con la probabilidad que deja al otro indiferente.};
\end{tikzpicture}
