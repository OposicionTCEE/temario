% Anexo de diseño de mecanismos, «La subasta óptima», con valoraciones uniformes en [0, θ̄].
% (a) Valoración virtual ψ(θ) = 2θ - θ̄ frente a θ; el precio de reserva óptimo r* cumple ψ(r*) = θ0, r* = (θ̄ + θ0)/2 > θ0.
% (b) Analogía del monopolio (BULOW y ROBERTS, 1989): demanda q = 1 - F(p), es decir, p = θ̄(1 - q); ingreso marginal θ̄(1 - 2q) = ψ(p);
% el precio de monopolio con coste marginal θ0 es r*. Valor ilustrativo para el dibujo: θ0 = 0,2 θ̄ (no se rotula).
\begin{tikzpicture}[font=\footnotesize, line cap=round,
    eje/.style={-{Stealth[length=2mm]}, line width=0.5pt},
    ref/.style={black!45, line width=0.6pt, dotted},
    guia/.style={black!50, line width=0.5pt, densely dotted},
    f1/.style={line width=1.3pt},
    f2/.style={line width=1.3pt, dashed},
    tit/.style={font=\footnotesize\bfseries}]
  \def\u{4.4}   % ancho de [0, θ̄] en (a) y de [0, 1] en (b)
  \def\v{2.6}   % alto de θ̄
  \def\t{0.2}   % θ0 / θ̄
  % ---------- (a) ----------
  \node[tit] at (0.5*\u,1.45*\v) {(a) Valoración virtual};
  \begin{scope}
    \draw[eje] (0,-1.05*\v) -- (0,1.3*\v);
    \draw[eje] (0,0) -- (\u+0.6,0) node[below] {$\theta$};
    \draw (0,0) node[left] {$0$};
    \draw (\u,0) -- (\u,-0.08) node[below] {$\bar{\theta}$};
    \draw (0,\v) -- (-0.08,\v) node[left] {$\bar{\theta}$};
    \draw (0,-\v) -- (-0.08,-\v) node[left] {$-\bar{\theta}$};
    \draw[ref] (0,0) -- (\u,\v) node[pos=0.55, above left, black!60] {$\theta$};
    \draw[f1] (0,-\v) -- (\u,\v) node[above right] {$\psi(\theta)$};
    \draw[f2] (0,\t*\v) -- (\u,\t*\v) node[right] {$\theta_0$};
    \pgfmathsetmacro{\r}{(1+\t)/2}
    \draw[guia] (\r*\u,\t*\v) -- (\r*\u,0);
    \fill (\r*\u,\t*\v) circle (1.8pt);
    \draw (\r*\u,0) -- (\r*\u,-0.08) node[below] {$r^*$};
  \end{scope}
  % ---------- (b) ----------
  \begin{scope}[shift={(7.6,-0.4*\v)}]
    \node[tit] at (0.5*\u,1.85*\v) {(b) Analogía del monopolio};
    \draw[eje] (0,0) -- (\u+0.45,0) node[below] {$q$};
    \draw[eje] (0,0) -- (0,1.3*\v) node[left] {$p$};
    \draw (0,0) node[below left] {$0$};
    \draw (\u,0) -- (\u,-0.08) node[below] {$1$};
    \draw (0,\v) -- (-0.08,\v) node[left] {$\bar{\theta}$};
    \draw[f1] (0,\v) -- (\u,0);
    \node[anchor=south west] at (0.6*\u,0.42*\v) {$q=1-F(p)$};
    \draw[f2] (0,\v) -- (0.5*\u,0);
    \node[anchor=east] at (1.35,0.95) {$\psi(p)$};
    \draw[black!60, line width=0.8pt] (0,\t*\v) -- (\u,\t*\v) node[right, black] {$\theta_0$};
    \pgfmathsetmacro{\q}{(1-\t)/2}
    \pgfmathsetmacro{\r}{1-\q}
    \draw[guia] (\q*\u,0) -- (\q*\u,\r*\v) -- (0,\r*\v);
    \fill (\q*\u,\t*\v) circle (1.8pt);
    \fill (\q*\u,\r*\v) circle (1.8pt);
    \draw (\q*\u,0) -- (\q*\u,-0.08) node[below] {$q^*$};
    \draw (0,\r*\v) -- (-0.08,\r*\v) node[left] {$r^*$};
  \end{scope}
\end{tikzpicture}
