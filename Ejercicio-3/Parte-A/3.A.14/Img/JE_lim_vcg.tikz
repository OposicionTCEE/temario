% Bloque 2, «Límites», mecanismo pivotal de CLARKE en la consulta del Tesoro sobre el formato (x, y, z), con pagos.
% V_{-i}(d): suma de los valores declarados por las demás entidades; v_i(d): valor declarado por la entidad i.
% (a) Sin la entidad i: el Tesoro elegiría y, el formato de mayor V_{-i}.
% (b) Con la entidad i: la suma total es máxima en x, que se elige; i es pivotal y paga t_i = V_{-i}(y) - V_{-i}(x),
%     lo que las demás pierden porque se elige x en lugar de y (llave).
% Valores ilustrativos (solo para el dibujo): V_{-i} = (2,0; 3,0; 1,6); v_i = (1,6; 0,2; 0,5).
\begin{tikzpicture}[font=\footnotesize, line cap=round,
    eje/.style={-{Stealth[length=2mm]}, line width=0.5pt},
    dem/.style={fill=black!22, draw=black, line width=0.5pt},
    pro/.style={fill=white, draw=black, line width=0.5pt},
    tit/.style={font=\footnotesize\bfseries}]
  \def\h{0.95}  % alto por unidad
  \def\w{0.8}   % ancho de barra
  % (a) Sin la entidad i
  \node[tit] at (2.3,4.75) {(a) Sin la entidad $i$};
  \draw[eje] (0,0) -- (4.6,0);
  \draw[eje] (0,0) -- (0,4.3) node[above] {Valor declarado};
  \foreach \x/\v/\n in {1/2.0/x, 2.3/3.0/y, 3.6/1.6/z} {
    \draw[dem] (\x-\w/2,0) rectangle (\x+\w/2,\v*\h);
    \node[below] at (\x,0) {$\n$};
    \node[above] at (\x,\v*\h) {$V_{-i}(\n)$};
  }
  \node[anchor=west, font=\footnotesize\bfseries] at (0,-0.75) {Elegido: $y$};
  % (b) Con la entidad i
  \begin{scope}[shift={(7.6,0)}]
    \node[tit] at (2.3,4.75) {(b) Con la entidad $i$};
    \draw[eje] (0,0) -- (4.6,0);
    \draw[eje] (0,0) -- (0,4.3) node[above] {Valor declarado};
    \foreach \x/\v/\p/\n in {1/2.0/1.6/x, 2.3/3.0/0.2/y, 3.6/1.6/0.5/z} {
      \draw[dem] (\x-\w/2,0) rectangle (\x+\w/2,\v*\h);
      \draw[pro] (\x-\w/2,\v*\h) rectangle (\x+\w/2,{(\v+\p)*\h});
      \node[below] at (\x,0) {$\n$};
    }
    % lo que las demás obtendrían sin i
    \draw[black!60, densely dashed, line width=0.6pt] (0,3.0*\h) -- (4.4,3.0*\h) node[right, black] {$V_{-i}(y)$};
    % pago de la entidad pivotal
    \draw[decorate, decoration={brace, amplitude=4pt}, line width=0.6pt] (1-\w/2-0.08,2.0*\h) -- (1-\w/2-0.08,3.0*\h) node[midway, left=5pt] {$t_i$};
    \node[anchor=west, font=\footnotesize\bfseries] at (0,-0.75) {Elegido: $x$};
  \end{scope}
  % leyenda y condición
  \draw[dem] (2.6,-1.55) rectangle (2.95,-1.3); \node[anchor=west] at (3.0,-1.42) {Demás entidades, $V_{-i}$};
  \draw[pro] (6.9,-1.55) rectangle (7.25,-1.3); \node[anchor=west] at (7.3,-1.42) {Entidad $i$, $v_i$};
  \node at (6.1,-2.2) {$t_i=V_{-i}(y)-V_{-i}(x)$};
\end{tikzpicture}
