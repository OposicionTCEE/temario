% Anexo de juegos cooperativos, «Negociación»: solución de NASH (1950c). Conjunto factible U (convexo y compacto), punto de desacuerdo d
% y curva de nivel del producto de NASH, (u1 - d1)(u2 - d2), tangente a la frontera de U en la solución. Elaboración propia.
% (a) Caso general. (b) Reparto de un excedente V con utilidad transferible: frontera u1 + u2 = V; la solución da a cada uno su pago de
%     desacuerdo más la mitad del excedente neto. Posiciones ilustrativas.
\begin{tikzpicture}[font=\footnotesize, line cap=round,
    eje/.style={-{Stealth[length=2mm]}, line width=0.5pt},
    tit/.style={font=\footnotesize\bfseries}]
  % (a) Caso general
  \node[tit] at (2.3,4.85) {(a) Caso general};
  \begin{scope}
    \draw[eje] (0,0) -- (4.8,0) node[below] {$u_1$};
    \draw[eje] (0,0) -- (0,4.5) node[left] {$u_2$};
    \fill[black!10] (0,0) -- (0,3.8) .. controls (2.2,3.75) and (3.9,2.4) .. (4.1,0) -- cycle;
    \draw[line width=0.9pt] (0,3.8) .. controls (2.2,3.75) and (3.9,2.4) .. (4.1,0);
    \node at (1.3,1.7) {$U$};
    \fill (0.7,0.6) circle (2pt) node[below left] {$d$};
    \draw[dashed, black!50] (0.7,0.6) -- (0.7,4.3);
    \draw[dashed, black!50] (0.7,0.6) -- (4.5,0.6);
    % Curva de nivel del producto de NASH tangente en la solución (aprox. en (2.75, 2.75))
    \draw[line width=0.6pt, domain=1.15:4.4, samples=40] plot (\x,{0.6+(2.05*2.15)/(\x-0.7)});
    \fill (2.75,2.75) circle (2.2pt);
    \node[anchor=south west] at (2.8,2.8) {$u^N$};
  \end{scope}
  % (b) Utilidad transferible
  \node[tit] at (8.6+2.3,4.85) {(b) Reparto de un excedente};
  \begin{scope}[shift={(8.6,0)}]
    \draw[eje] (0,0) -- (4.8,0) node[below] {$u_1$};
    \draw[eje] (0,0) -- (0,4.5) node[left] {$u_2$};
    \fill[black!10] (0,0) -- (0,4.0) -- (4.0,0) -- cycle;
    \draw[line width=0.9pt] (0,4.0) -- (4.0,0);
    \node[anchor=east] at (0,4.0) {$V$};
    \node[anchor=north] at (4.0,0) {$V$};
    \fill (1.2,0.6) circle (2pt) node[below left] {$d$};
    \draw[dashed, black!50] (1.2,0.6) -- (1.2,2.8);
    \draw[dashed, black!50] (1.2,0.6) -- (3.4,0.6);
    \fill (2.3,1.7) circle (2.2pt);
    \node[anchor=south west, align=left] at (2.35,1.75) {$u_i^N=d_i+\tfrac{1}{2}\left(V-d_1-d_2\right)$};
  \end{scope}
\end{tikzpicture}
