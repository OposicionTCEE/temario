% Conjuntos de información en el juego de entrada (apartado «Secuencialidad»). Elaboración propia.
% (a) Información perfecta: cada nodo de J2 es su propio conjunto de información.
% (b) Información imperfecta: J2 no observa si J1 ha entrado; sus dos nodos forman un único conjunto de información.
\begin{tikzpicture}[font=\footnotesize, line cap=round,
    nd/.style={circle, fill=black, inner sep=0pt, minimum size=4.5pt},
    acc/.style={font=\footnotesize\itshape},
    pago/.style={font=\footnotesize},
    rama/.style={line width=0.6pt},
    info/.style={dashed, line width=0.6pt},
    conj/.style={draw=black!45, line width=0.5pt, rounded corners=7pt},
    tit/.style={font=\footnotesize\bfseries}]
  % (a) Información perfecta
  \node[tit] at (3.6,3.6) {(a) Información perfecta};
  \node[nd, label=above:{\textbf{J1}}] (r) at (3.6,2.8) {};
  \node[nd] (i1) at (1.9,1.5) {};
  \node[nd] (i2) at (5.3,1.5) {};
  \draw[conj] (1.45,1.22) rectangle (2.35,1.78);
  \draw[conj] (4.85,1.22) rectangle (5.75,1.78);
  \node[font=\footnotesize\bfseries, left] at (1.45,1.5) {J2};
  \node[font=\footnotesize\bfseries, right] at (5.75,1.5) {J2};
  \draw[rama] (r) -- node[acc, above left] {Entrar} (i1);
  \draw[rama] (r) -- node[acc, above right] {No entrar} (i2);
  \foreach \p/\x/\l/\pos/\pg in {i1/1.0/Alto/left/{(a_1,\,a_2)}, i1/2.8/Bajo/right/{(b_1,\,b_2)}, i2/4.4/Alto/left/{(c_1,\,c_2)}, i2/6.2/Bajo/right/{(d_1,\,d_2)}} {
    \node[nd] (t) at (\x,0.2) {};
    \draw[rama] (\p) -- node[acc, \pos] {\l} (t);
    \node[pago, below] at (t.south) {$\pg$};
  }
  % (b) Información imperfecta
  \node[tit] at (11.6,3.6) {(b) Información imperfecta};
  \node[nd, label=above:{\textbf{J1}}] (s) at (11.6,2.8) {};
  \node[nd] (k1) at (9.9,1.5) {};
  \node[nd] (k2) at (13.3,1.5) {};
  \draw[conj] (9.45,1.22) rectangle (13.75,1.78);
  \draw[info] (k1) -- (k2);
  \node[font=\footnotesize\bfseries, left] at (9.45,1.5) {J2};
  \draw[rama] (s) -- node[acc, above left] {Entrar} (k1);
  \draw[rama] (s) -- node[acc, above right] {No entrar} (k2);
  \foreach \p/\x/\l/\pos/\pg in {k1/9.0/Alto/left/{(a_1,\,a_2)}, k1/10.8/Bajo/right/{(b_1,\,b_2)}, k2/12.4/Alto/left/{(c_1,\,c_2)}, k2/14.2/Bajo/right/{(d_1,\,d_2)}} {
    \node[nd] (t) at (\x,0.2) {};
    \draw[rama] (\p) -- node[acc, \pos] {\l} (t);
    \node[pago, below] at (t.south) {$\pg$};
  }
\end{tikzpicture}
