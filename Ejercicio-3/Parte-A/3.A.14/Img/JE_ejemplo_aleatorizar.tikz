% Estrategia mixta y estrategia de comportamiento de J2 en el juego de entrada (apartado «Taxonomía»). Elaboración propia.
% (a) Mixta: J2 sortea antes de empezar uno de sus cuatro planes, con probabilidades lambda_1 a lambda_4.
% (b) De comportamiento: J2 sortea en cada nodo; beta_E es la probabilidad de bajar el precio si J1 entra y beta_N, si no entra.
\begin{tikzpicture}[font=\footnotesize, line cap=round,
    nd/.style={circle, fill=black, inner sep=0pt, minimum size=4.5pt},
    sorteo/.style={circle, draw=black, fill=white, line width=0.6pt, inner sep=0pt, minimum size=6pt},
    acc/.style={font=\footnotesize\itshape},
    pago/.style={font=\footnotesize},
    rama/.style={line width=0.6pt},
    tit/.style={font=\footnotesize\bfseries}]
  % (a) Estrategia mixta
  \node[tit] at (3.2,3.6) {(a) Estrategia mixta};
  \node[sorteo, label=above:{\textbf{J2}}] (m) at (3.2,2.8) {};
  \foreach \x/\l/\pl in {0.5/{\lambda_1}/{(Alto, Alto)}, 2.3/{\lambda_2}/{(Alto, Bajo)}, 4.1/{\lambda_3}/{(Bajo, Alto)}, 5.9/{\lambda_4}/{(Bajo, Bajo)}} {
    \node[nd] (t) at (\x,0.9) {};
    \draw[rama] (m) -- node[pago, fill=white, inner sep=1pt, pos=0.55] {$\l$} (t);
    \node[acc, below] at (t.south) {\pl};
  }
  % (b) Estrategia de comportamiento
  \node[tit] at (11.6,3.6) {(b) Estrategia de comportamiento};
  \node[nd, label=above:{\textbf{J1}}] (s) at (11.6,2.8) {};
  \node[nd, label=left:{\textbf{J2}}] (k1) at (9.6,1.5) {};
  \node[nd, label=right:{\textbf{J2}}] (k2) at (13.6,1.5) {};
  \draw[rama] (s) -- node[acc, above left] {Entrar} (k1);
  \draw[rama] (s) -- node[acc, above right] {No entrar} (k2);
  \foreach \p/\x/\l/\pos/\pg in {k1/8.7/{Alto ($1-\beta_E$)}/left/{(a_1,\,a_2)}, k1/10.5/{Bajo ($\beta_E$)}/right/{(b_1,\,b_2)}, k2/12.7/{Alto ($1-\beta_N$)}/left/{(c_1,\,c_2)}, k2/14.5/{Bajo ($\beta_N$)}/right/{(d_1,\,d_2)}} {
    \node[nd] (t) at (\x,0.2) {};
    \draw[rama] (\p) -- node[acc, \pos] {\l} (t);
    \node[pago, below] at (t.south) {$\pg$};
  }
\end{tikzpicture}
