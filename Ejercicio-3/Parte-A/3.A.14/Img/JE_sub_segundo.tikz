% Bloque 2, «Segundo precio»: ganancia de la entidad de valoración θ_i según la puja rival más alta, h.
% Pujando la valoración, gana θ_i - h si h < θ_i y nada si h > θ_i (recta de referencia, punteada).
% (a) Pujar por debajo, b < θ_i: pierde las victorias rentables con b < h < θ_i (triángulo sombreado sobre el eje).
% (b) Pujar por encima, b > θ_i: añade victorias con pérdida, θ_i < h < b (triángulo sombreado bajo el eje).
% Valores ilustrativos: θ̄ = 1, θ_i = 0,6; b = 0,35 en (a) y b = 0,85 en (b).
\begin{tikzpicture}[font=\footnotesize, line cap=round,
    eje/.style={-{Stealth[length=2mm]}, line width=0.5pt},
    ref/.style={black!45, line width=0.6pt, dotted},
    gan/.style={line width=1.4pt},
    tit/.style={font=\footnotesize\bfseries}]
  \def\u{5.4}   % ancho de [0, θ̄]
  \def\v{4.0}   % alto de una unidad
  \def\t{0.6}   % θ_i
  \foreach \p/\b/\pos/\titulo in {0/0.35/below/{(a) Pujar por debajo: $b<\theta_i$}, 8.0/0.85/above/{(b) Pujar por encima: $b>\theta_i$}} {
    \begin{scope}[shift={(\p,0)}]
      \node[tit] at (0.5*\u,0.95*\v) {\titulo};
      \draw[eje] (0,0) -- (\u+0.45,0) node[below] {$h$};
      \draw[eje] (0,-0.5*\v) -- (0,0.8*\v) node[left] {Ganancia};
      \draw (0,\t*\v) -- (-0.08,\t*\v) node[left] {$\theta_i$};
      \draw (0,0) node[left] {$0$};
      % ganancia si se puja la valoración (referencia)
      \draw[ref] (0,\t*\v) -- (\u,{(\t-1)*\v}) node[right, black!60] {$\theta_i-h$};
      % región en la que la puja cambia el resultado
      \pgfmathsetmacro{\lo}{min(\b,\t)}
      \pgfmathsetmacro{\hi}{max(\b,\t)}
      \fill[black!15] (\lo*\u,0) -- (\lo*\u,{(\t-\lo)*\v}) -- (\hi*\u,{(\t-\hi)*\v}) -- (\hi*\u,0) -- cycle;
      % ganancia con la puja b
      \draw[gan] (0,\t*\v) -- (\b*\u,{(\t-\b)*\v});
      \draw[gan] (\b*\u,0) -- (\u,0);
      \draw[black!50, densely dotted] (\b*\u,{(\t-\b)*\v}) -- (\b*\u,0);
      \draw (\t*\u,0) -- (\t*\u,0.08) node[\pos] {$\theta_i$};
      \draw (\b*\u,0) -- (\b*\u,0.08) node[\pos] {$b$};
    \end{scope}
  }
\end{tikzpicture}
