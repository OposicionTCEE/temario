% Anexo de diseño de mecanismos, «Implementación» y «Principio de revelación»: diagrama de MOUNT y REITER. Elaboración propia.
% (a) Un mecanismo (M, g) implementa la función de elección social f si, en equilibrio, s*(θ) lleva a g(s*(θ)) = f(θ) para todo θ.
% (b) Mecanismo directo: los mensajes son los tipos (M = Θ), el equilibrio es decir la verdad y el resultado es la propia f.
\begin{tikzpicture}[font=\footnotesize, line cap=round,
    con/.style={font=\footnotesize, draw=black, line width=0.6pt, rounded corners=3pt, minimum width=1.6cm, minimum height=0.8cm, align=center},
    fl/.style={-{Stealth[length=2.4mm]}, line width=0.8pt},
    tit/.style={font=\footnotesize\bfseries}]
  % (a) Mecanismo general
  \node[tit] at (3.0,3.4) {(a) Un mecanismo cualquiera};
  \node[con] (T) at (0.8,2.3) {Tipos\\$\theta\in\Theta$};
  \node[con] (X) at (5.2,2.3) {Resultados\\$x\in X$};
  \node[con] (M) at (3.0,0.0) {Mensajes\\$m\in\mathcal{M}$};
  \draw[fl] (T) -- node[above] {$f(\theta)$} (X);
  \draw[fl] (T) -- node[left, xshift=-2pt] {$s^*(\theta)$} (M);
  \draw[fl] (M) -- node[right, xshift=2pt] {$g(m)$} (X);
  \node at (3.0,1.45) {$g\left(s^*(\theta)\right)=f(\theta)$};
  % (b) Mecanismo directo
  \node[tit] at (11.6,3.4) {(b) Mecanismo directo};
  \node[con] (T2) at (9.4,2.3) {Tipos\\$\theta\in\Theta$};
  \node[con] (X2) at (13.8,2.3) {Resultados\\$x\in X$};
  \node[con] (M2) at (11.6,0.0) {Anuncios\\$\hat{\theta}\in\Theta$};
  \draw[fl] (T2) -- node[above] {$f(\theta)$} (X2);
  \draw[fl] (T2) -- node[left, xshift=-2pt] {$\hat{\theta}=\theta$} (M2);
  \draw[fl] (M2) -- node[right, xshift=2pt] {$f(\hat{\theta})$} (X2);
  \node at (11.6,1.45) {$f\left(\theta\right)$ con veracidad};
\end{tikzpicture}
