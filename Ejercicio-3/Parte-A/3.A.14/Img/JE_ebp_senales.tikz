% Señalización en el juego de entrada: precio límite (apartado «Señalización»). Elaboración propia a partir de MILGROM y ROBERTS (1982a).
% La naturaleza elige el tipo de J2 (acomodaticio con probabilidad p, agresivo con 1-p); J2 lo ve y fija un precio alto o bajo antes de que J1 decida;
% J1 ve el precio, no el tipo: sus conjuntos de información unen los dos nodos que siguen al mismo precio, con creencias mu_A y mu_B (probabilidad de que J2 sea agresivo).
% En los nodos finales, solo los pagos de J1: entrar le da a1 frente al acomodaticio y b1 frente al agresivo; no entrar, c1.
% (a) Equilibrio separador: el acomodaticio fija el precio alto, el agresivo el bajo; J1 entra solo tras el precio alto.
% (b) Equilibrio agrupador: los dos tipos fijan el precio bajo; J1 no aprende nada (mu_B = 1-p) y no entra si 1-p > q*; tras el precio alto, que no se observa, entraría.
\begin{tikzpicture}[font=\footnotesize, line cap=round,
    nd/.style={circle, fill=black, inner sep=0pt, minimum size=4.5pt},
    nat/.style={circle, draw=black, fill=white, line width=0.6pt, inner sep=0pt, minimum size=6pt},
    jug/.style={font=\footnotesize\bfseries},
    acc/.style={font=\footnotesize\itshape},
    pago/.style={font=\footnotesize},
    rama/.style={line width=0.6pt},
    elegida/.style={line width=1.8pt},
    info/.style={dashed, line width=0.6pt},
    tit/.style={font=\footnotesize\bfseries}]
  % \senal{centro}{precio del acomodaticio: 1 Alto, 2 Bajo}{precio del agresivo}{J1 tras Alto: 1 Entrar, 2 No entrar}{J1 tras Bajo}{creencia tras Alto}{creencia tras Bajo}
  \def\senal#1#2#3#4#5#6#7{%
    \begin{scope}[shift={(#1,0)}]
      \node[nat, label=below:{\textbf{N}}] (n) at (0,0) {};
      \node[nd] (ac) at (-1.9,0) {};
      \node[nd] (ag) at (1.9,0) {};
      \draw[rama] (n) -- node[acc, above, pos=0.5] {$\theta_{ac}$ ($p$)} (ac);
      \draw[rama] (n) -- node[acc, above, pos=0.5] {$\theta_{ag}$ ($1-p$)} (ag);
      \node[jug, left] at (ac.west) {J2};
      \node[jug, right] at (ag.east) {J2};
      \node[nd] (ua) at (-1.9,1.5) {}; \node[nd] (ug) at (1.9,1.5) {};
      \node[nd] (da) at (-1.9,-1.5) {}; \node[nd] (dg) at (1.9,-1.5) {};
      \ifnum#2=1 \draw[elegida] (ac) -- node[acc, left] {Alto} (ua); \draw[rama] (ac) -- node[acc, left] {Bajo} (da);
      \else \draw[rama] (ac) -- node[acc, left] {Alto} (ua); \draw[elegida] (ac) -- node[acc, left] {Bajo} (da); \fi
      \ifnum#3=1 \draw[elegida] (ag) -- node[acc, right] {Alto} (ug); \draw[rama] (ag) -- node[acc, right] {Bajo} (dg);
      \else \draw[rama] (ag) -- node[acc, right] {Alto} (ug); \draw[elegida] (ag) -- node[acc, right] {Bajo} (dg); \fi
      \draw[info] (ua) -- (ug); \draw[info] (da) -- (dg);
      \node[jug, fill=white, inner sep=1pt] at (0,1.5) {J1};
      \node[jug, fill=white, inner sep=1pt] at (0,-1.5) {J1};
      \node[pago] at (0,1.95) {#6};
      \node[pago] at (0,-1.95) {#7};
      % Decisiones de J1: Entrar hacia fuera y arriba (o abajo), No entrar hacia fuera
      \node[nd] (uaE) at (-3.0,2.5) {}; \node[nd] (uaN) at (-3.3,1.5) {};
      \node[nd] (ugE) at (3.0,2.5) {};  \node[nd] (ugN) at (3.3,1.5) {};
      \node[nd] (daE) at (-3.0,-2.5) {}; \node[nd] (daN) at (-3.3,-1.5) {};
      \node[nd] (dgE) at (3.0,-2.5) {};  \node[nd] (dgN) at (3.3,-1.5) {};
      \ifnum#4=1
        \draw[elegida] (ua) -- (uaE); \draw[rama] (ua) -- (uaN); \draw[elegida] (ug) -- (ugE); \draw[rama] (ug) -- (ugN);
      \else
        \draw[rama] (ua) -- (uaE); \draw[elegida] (ua) -- (uaN); \draw[rama] (ug) -- (ugE); \draw[elegida] (ug) -- (ugN);
      \fi
      \ifnum#5=1
        \draw[elegida] (da) -- (daE); \draw[rama] (da) -- (daN); \draw[elegida] (dg) -- (dgE); \draw[rama] (dg) -- (dgN);
      \else
        \draw[rama] (da) -- (daE); \draw[elegida] (da) -- (daN); \draw[rama] (dg) -- (dgE); \draw[elegida] (dg) -- (dgN);
      \fi
      \node[acc, above left, inner sep=1pt] at ($(ua)!0.55!(uaE)$) {E};
      \node[acc, below, inner sep=2pt] at ($(ua)!0.5!(uaN)$) {N};
      \node[acc, above right, inner sep=1pt] at ($(ug)!0.55!(ugE)$) {E};
      \node[acc, below, inner sep=2pt] at ($(ug)!0.5!(ugN)$) {N};
      \node[acc, below left, inner sep=1pt] at ($(da)!0.55!(daE)$) {E};
      \node[acc, above, inner sep=2pt] at ($(da)!0.5!(daN)$) {N};
      \node[acc, below right, inner sep=1pt] at ($(dg)!0.55!(dgE)$) {E};
      \node[acc, above, inner sep=2pt] at ($(dg)!0.5!(dgN)$) {N};
      \node[pago, left] at (uaE.west) {$a_1$}; \node[pago, left] at (uaN.west) {$c_1$};
      \node[pago, right] at (ugE.east) {$b_1$}; \node[pago, right] at (ugN.east) {$c_1$};
      \node[pago, left] at (daE.west) {$a_1$}; \node[pago, left] at (daN.west) {$c_1$};
      \node[pago, right] at (dgE.east) {$b_1$}; \node[pago, right] at (dgN.east) {$c_1$};
    \end{scope}}
  \node[tit] at (3.9,3.3) {(a) Equilibrio separador};
  \senal{3.9}{1}{2}{1}{2}{$\mu_A=0$}{$\mu_B=1$}
  \node[tit] at (12.1,3.3) {(b) Equilibrio agrupador};
  \senal{12.1}{2}{2}{1}{2}{$\mu_A$}{$\mu_B=1-p$}
\end{tikzpicture}
