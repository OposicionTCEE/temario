% Juego de entrada: forma extensiva, forma normal y sus dos equilibrios de Nash. Elaboración propia a partir de MAS-COLELL, WHINSTON y GREEN (1995).
\begin{tikzpicture}[font=\footnotesize, line cap=round,
    nd/.style={circle, fill=black, inner sep=0pt, minimum size=4.5pt},
    jug/.style={font=\footnotesize\bfseries},
    acc/.style={font=\footnotesize\itshape},
    pago/.style={font=\footnotesize},
    rama/.style={line width=0.6pt},
    info/.style={dashed, line width=0.6pt},
    tit/.style={font=\footnotesize\bfseries},
    nota/.style={font=\footnotesize, align=left}]
  \node[nd, label=above:{\textbf{E}}] (e) at (2.6,3.4) {};
  \node[nd] (o) at (0.9,1.8) {};
  \node[nd, label=right:{\textbf{I}}] (i) at (3.9,1.8) {};
  \draw[rama] (e) -- node[acc, above left] {Out} (o);
  \draw[rama] (e) -- node[acc, above right] {In} (i);
  \node[pago, below] at (o.south) {$(0,\,2)$};
  \node[nd] (f) at (3.1,0.3) {};
  \node[nd] (a) at (4.7,0.3) {};
  \draw[rama] (i) -- node[acc, left] {Luchar} (f);
  \draw[rama] (i) -- node[acc, right] {Acomodar} (a);
  \node[pago, below] at (f.south) {$(-3,\,-1)$};
  \node[pago, below] at (a.south) {$(2,\,1)$};
  \node[pago, anchor=east, align=right] at (0.25,1.48) {Pagos:\\$(u_E,u_I)$};
  % Matriz de pagos: E (filas) frente a I (columnas)
  \fill[black!8] (7.000,3.000) rectangle (12.200,1.800);
  \fill[black!8] (7.000,1.800) rectangle (8.700,0.600);
  \fill[cyan!22, rounded corners=4pt] (10.510,1.740) rectangle (12.140,1.260);
  \fill[cyan!22, rounded corners=4pt] (8.760,1.140) rectangle (10.390,0.660);
  \draw[line width=0.5pt] (8.700,3.000) -- (12.200,3.000);
  \draw[line width=0.5pt] (8.700,2.400) -- (12.200,2.400);
  \draw[line width=0.5pt] (7.000,1.800) -- (12.200,1.800);
  \draw[line width=0.5pt] (7.750,1.200) -- (12.200,1.200);
  \draw[line width=0.5pt] (7.750,0.600) -- (12.200,0.600);
  \draw[line width=0.5pt] (7.000,0.600) -- (7.750,0.600);
  \draw[line width=0.5pt] (7.000,1.800) -- (7.000,0.600);
  \draw[line width=0.5pt] (7.750,1.800) -- (7.750,0.600);
  \draw[line width=0.5pt] (8.700,3.000) -- (8.700,0.600);
  \draw[line width=0.5pt] (10.450,2.400) -- (10.450,0.600);
  \draw[line width=0.5pt] (12.200,3.000) -- (12.200,0.600);
  \node[jug] at (10.450,2.700) {I};
  \node[acc] at (9.575,2.100) {Luchar};
  \node[acc] at (11.325,2.100) {Acomodar};
  \node[jug] at (7.375,1.200) {E};
  \node[acc] at (8.225,1.500) {In};
  \node at (9.575,1.500) {$-3,\ -1$};
  \node at (11.325,1.500) {$2,\ 1$};
  \node[acc] at (8.225,0.900) {Out};
  \node at (9.575,0.900) {$0,\ 2$};
  \node at (11.325,0.900) {$0,\ 2$};
  \node[nota, anchor=north west, text width=6.4cm] at (7.0,0.45) {Sombreados, los dos equilibrios de Nash: $(\text{Out},\ \text{Luchar si E entra})$ y $(\text{In},\ \text{Acomodar si E entra})$.};
\end{tikzpicture}
