% Figura (Anexo III, «Rendimientos globales y locales»): isocuantas de niveles q, 2q y 3q a lo largo de la diagonal.
% Tecnologías q = (K L)^{nu/2}: la isocuanta de nivel q corta la diagonal en c = q^{1/nu} y es K = c^2 / L.
% (a) Constantes, nu = 1: c = 1; 2; 3 (separación constante).
% (b) Crecientes, nu = 1,5: c = 1; 1,587; 2,080 (cada vez más juntas).
% (c) Decrecientes, nu = 0,75 (escaladas para que la primera esté en 0,8): c = 0,8; 2,016; 3,461 (cada vez más separadas).
% Escala: 1 unidad = 1,15 cm. Sustituye a Rendimientos_Ilustracion_R3.png y FPNBC_Tipos.png del tema antiguo.
% Generar con: bash Code/generar_figura.sh anx_rendimientos
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1.15cm, y=1.15cm]
  \foreach \i/\titulo/\cond/\ca/\cb/\cc in {0/{(a) Constantes}/{$f(\lambda z)=\lambda f(z)$}/1/2/3, 1/{(b) Crecientes}/{$f(\lambda z)>\lambda f(z)$}/1/1.587/2.080, 2/{(c) Decrecientes}/{$f(\lambda z)<\lambda f(z)$}/0.8/2.016/3.461} {
    \begin{scope}[xshift=\i*4.75cm]
      \node[font=\footnotesize\bfseries] at (1.95,4.55) {\titulo};
      \node at (1.95,4.15) {\cond};
      \draw[->] (0,0) -- (3.95,0) node[below] {$L$};
      \draw[->] (0,0) -- (0,3.85) node[left] {$K$};
      \draw[dashed] (0,0) -- (3.7,3.7);
      \foreach \c/\et in {\ca/{$q$}, \cb/{$2q$}, \cc/{$3q$}} {
        \draw[very thick] plot[domain={\c*\c/3.75}:3.75, samples=60] (\x,{\c*\c/\x});
        \fill (\c,\c) circle (1.3pt);
      }
      \node[right] at (3.75,{\ca*\ca/3.75}) {$q$};
      \node[right] at (3.75,{\cb*\cb/3.75}) {$2q$};
      \node[right] at (3.75,{\cc*\cc/3.75}) {$3q$};
    \end{scope}
  }
\end{tikzpicture}
