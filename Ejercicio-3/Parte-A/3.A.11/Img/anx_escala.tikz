% Figura (Anexo I, «Escala»): un factor y un producto; plan eficiente y con z = 1,6; lambda = 1/2 y lambda' = 1,6.
% (a) No crecientes: frontera 1,6 z^{0,55}; y = (-1,6; 2,072); lambda y = (-0,8; 1,036) dentro (f(0,8) = 1,415);
%     lambda' y = (-2,56; 3,315) fuera (f(2,56) = 2,683).
% (b) Constantes: frontera 1,2 z; y = (-1,6; 1,92); lambda y = (-0,8; 0,96) y lambda' y = (-2,56; 3,072) en la frontera.
% (c) No decrecientes: frontera 0,75 z^{1,6}; y = (-1,6; 1,592); lambda y = (-0,8; 0,796) fuera (f(0,8) = 0,525);
%     lambda' y = (-2,56; 2,547) dentro (f(2,56) = 3,377).
% Sustituye, junto con anx_convexidad, a la figura Axiomas_ProcesoProductivo.png del tema antiguo.
% Glosario (26/10/2026): lambda para el factor de escala, como en el bloque 3 (alfa es el exponente de la COBB-DOUGLAS).
% Generar con: bash Code/generar_figura.sh anx_escala
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  \def\S{5.3}
  \foreach \i/\titulo/\cond in {0/{(a) No crecientes}/{$\lambda y\in Y$ si $\lambda\in[0,1]$}, 1/{(b) Constantes}/{$\lambda y\in Y$ si $\lambda\ge0$}, 2/{(c) No decrecientes}/{$\lambda y\in Y$ si $\lambda\ge1$}} {
    \begin{scope}[xshift=\i*\S cm]
      \node[font=\footnotesize\bfseries] at (-1.45,4.25) {\titulo};
      \node at (-1.45,3.85) {\cond};
    \end{scope}
  }
  % ---------------- (a) No crecientes ----------------
  \fill[black!12] (0,0) -- plot[domain=0:2.9, samples=60] ({-\x},{1.6*(\x)^0.55}) -- (-2.9,-0.5) -- (0,-0.5) -- cycle;
  \draw[->] (-3.2,0) -- (0.5,0) node[below] {$y_1$};
  \draw[->] (0,-0.6) -- (0,3.6) node[left] {$y_2$};
  \draw[very thick] plot[domain=0:2.9, samples=60] ({-\x},{1.6*(\x)^0.55});
  \draw[dashed] (0,0) -- (-2.75,3.56);
  \fill (-1.6,2.072) circle (1.4pt) node[right] {$y$};
  \fill (-0.8,1.036) circle (1.4pt) node[left] {$\lambda y$};
  \draw[fill=white] (-2.56,3.315) circle (1.6pt) node[right] {$\lambda' y$};
  % ---------------- (b) Constantes ----------------
  \begin{scope}[xshift=\S cm]
    \fill[black!12] (0,0) -- (-2.9,3.48) -- (-2.9,-0.5) -- (0,-0.5) -- cycle;
    \draw[->] (-3.2,0) -- (0.5,0) node[below] {$y_1$};
    \draw[->] (0,-0.6) -- (0,3.6) node[left] {$y_2$};
    \draw[very thick] (0,0) -- (-2.9,3.48);
    \fill (-1.6,1.92) circle (1.4pt) node[right] {$y$};
    \fill (-0.8,0.96) circle (1.4pt) node[right] {$\lambda y$};
    \fill (-2.56,3.072) circle (1.4pt) node[right] {$\lambda' y$};
  \end{scope}
  % ---------------- (c) No decrecientes ----------------
  \begin{scope}[xshift=2*\S cm]
    \fill[black!12] (0,0) -- plot[domain=0:2.55, samples=60] ({-\x},{0.75*(\x)^1.6}) -- (-2.55,3.35) -- (-2.9,3.35) -- (-2.9,-0.5) -- (0,-0.5) -- cycle;
    \draw[->] (-3.2,0) -- (0.5,0) node[below] {$y_1$};
    \draw[->] (0,-0.6) -- (0,3.6) node[left] {$y_2$};
    \draw[very thick] plot[domain=0:2.55, samples=60] ({-\x},{0.75*(\x)^1.6});
    \draw[dashed] (0,0) -- (-2.75,2.736);
    \fill (-1.6,1.592) circle (1.4pt) node[right] {$y$};
    \draw[fill=white] (-0.8,0.796) circle (1.6pt) node[above] {$\lambda y$};
    \fill (-2.56,2.547) circle (1.4pt) node[below left] {$\lambda' y$};
  \end{scope}
  \node at ({\S},-1.05) {$\lambda<1<\lambda'$};
\end{tikzpicture}
