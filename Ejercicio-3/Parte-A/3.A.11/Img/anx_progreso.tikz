% Figura (Anexo III, «Neutralidad y sesgo»): desplazamiento de una isocuanta CES con sigma = 1/2 (delta = 1/2): 1/K + 1/L = 2 (t_0).
% (a) Neutral de HICKS, A = 1,5: 1/K + 1/L = 3 -> K = L/(3L - 1). En K = L: (0,667; 0,667), pendiente -1 (igual que t_0 en (1,1)).
% (b) Aumentador de trabajo, A = 1,8: 1/K + 1/(1,8 L) = 2 -> K = 1,8L/(3,6L - 1). En K = L: (0,778; 0,778), pendiente -1/1,8 = -0,556
%     (la RMST baja: ahorrador de trabajo con sigma < 1).
% (c) Aumentador de capital, A = 1,8: 1/(1,8 K) + 1/L = 2 -> K = L/(3,6L - 1,8). En K = L: (0,778; 0,778), pendiente -1,8
%     (la RMST sube: ahorrador de capital con sigma < 1).
% Escala: 1 unidad = 1,35 cm. Sustituye a ISOCUANTAS_LP.png, MLP_HICKS.png, MLP_SOLOW.png y MLP_HARROD.png del tema antiguo.
% Generar con: bash Code/generar_figura.sh anx_progreso
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1.35cm, y=1.35cm]
  \foreach \i/\titulo/\forma in {0/{(a) Neutral de HICKS}/{$A\,F(K,L)$}, 1/{(b) Aumentador de trabajo}/{$F(K,AL)$}, 2/{(c) Aumentador de capital}/{$F(AK,L)$}} {
    \begin{scope}[xshift=\i*5.1cm]
      \node[font=\footnotesize\bfseries] at (1.55,3.75) {\titulo};
      \node at (1.55,3.38) {\forma};
      \draw[->] (0,0) -- (3.25,0) node[below] {$L$};
      \draw[->] (0,0) -- (0,3.15) node[left] {$K$};
      \draw[dashed] (0,0) -- (2.4,2.4);
      \draw[very thick] plot[domain=0.6:3.0, samples=80] (\x,{\x/(2*\x-1)}) node[right] {$t_0$};
      \draw[densely dotted, thick] (0.7,1.3) -- (1.3,0.7);
      \fill (1,1) circle (1.3pt);
    \end{scope}
  }
  % (a)
  \draw[thick, dashed] plot[domain=0.375:3.0, samples=80] (\x,{\x/(3*\x-1)}) node[right] {$t_1$};
  \draw[densely dotted, thick] (0.42,0.917) -- (0.917,0.42);
  \fill (0.667,0.667) circle (1.3pt);
  % (b)
  \begin{scope}[xshift=5.1cm]
    \draw[thick, dashed] plot[domain=0.334:3.0, samples=80] (\x,{1.8*\x/(3.6*\x-1)});
    \node[left] at (0.334,2.85) {$t_1$};
    \draw[densely dotted, thick] (0.378,1.0) -- (1.178,0.556);
    \fill (0.778,0.778) circle (1.3pt);
  \end{scope}
  % (c)
  \begin{scope}[xshift=10.2cm]
    \draw[thick, dashed] plot[domain=0.551:3.0, samples=80] (\x,{\x/(3.6*\x-1.8)}) node[right] {$t_1$};
    \draw[densely dotted, thick] (0.556,1.178) -- (1.0,0.378);
    \fill (0.778,0.778) circle (1.3pt);
  \end{scope}
  \node at (5.4,-0.55) {$\sigma=1/2$};
\end{tikzpicture}
