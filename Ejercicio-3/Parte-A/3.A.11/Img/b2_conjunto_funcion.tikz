% Figura (bloque 2, «Función Neoclásica»): el conjunto de producción y su función de producción, en espejo (segunda pasada, 26/10/2026).
% Un factor y un producto; frontera q = 1,5 z^{0,6}. Escalas: z, 1 unidad = 1,3 cm; q, 1 unidad = 1 cm.
% (a) Y a la izquierda, con el factor en negativo como en el bloque 1; (b) f a la derecha: imagen en espejo, cada plan (-z, q)
%     de la frontera queda a la misma altura que el punto (z, f(z)).
% Propiedades con el mismo número a los dos lados (tabla inferior, número centrado en el eje q):
%   (1) origen: inacción y sin producción gratuita <-> f(0) = 0;
%   (2) eliminación gratuita (flecha desde la frontera en z = 2,3, q = 2,47) <-> no decreciente;
%   (3) cuerda entre el origen y z = 2 (q = 2,274): dentro de Y <-> por debajo de f, cóncava;
%   (4) frontera sin vértices <-> dos veces derivable (rótulo en el extremo de cada curva). Punto y* en z* = 3,4 (q* = 3,13).
% Generar con: bash Code/generar_figura.sh b2_conjunto_funcion
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  % títulos
  \node[font=\footnotesize\bfseries] at (-2.8,4.4) {(a) Conjunto de producción $Y$};
  \node[font=\footnotesize\bfseries] at (2.8,4.4) {(b) Función de producción $f$};
  % conjunto de producción
  \fill[black!12] (0,0) -- plot[domain=0:4.15, samples=60] ({-1.3*\x},{1.5*(\x)^0.6}) -- (-5.4,3.52) -- (-5.4,-0.5) -- (0,-0.5) -- cycle;
  % ejes
  \draw[->] (-5.7,0) -- (5.8,0) node[below] {$z$};
  \node[below] at (-5.55,0) {$-z$};
  \draw[->] (0,-0.6) -- (0,4.0) node[left] {$q$};
  % frontera y función
  \draw[very thick] plot[domain=0:4.15, samples=60] ({-1.3*\x},{1.5*(\x)^0.6});
  \draw[very thick] plot[domain=0:4.15, samples=60] ({1.3*\x},{1.5*(\x)^0.6});
  % plan y* y su imagen
  \draw[dotted] (-4.42,3.13) -- (4.42,3.13);
  \draw[dotted] (-4.42,0) node[below] {$-z^*$} -- (-4.42,3.13);
  \draw[dotted] (4.42,0) node[below] {$z^*$} -- (4.42,3.13);
  % (4) frontera y curva sin vértices
  \node[left] at (-5.4,3.52) {(4)};
  \node[right] at (5.4,3.52) {(4)};
  \fill (-4.42,3.13) circle (1.4pt) node[above right] {$y^*$};
  \fill (4.42,3.13) circle (1.4pt) node[above left] {$f(z^*)$};
  % (3) cuerdas
  \draw[dashed] (0,0) -- (-2.6,2.274);
  \draw[dashed] (0,0) -- (2.6,2.274);
  \fill (-2.6,2.274) circle (1.2pt);
  \fill (2.6,2.274) circle (1.2pt);
  \node at (-1.62,0.95) {(3)};
  \node at (1.62,0.95) {(3)};
  % (2) eliminación gratuita y función no decreciente
  \draw[->, thick] (-2.99,2.47) -- (-3.65,1.8) node[below left=-1pt] {(2)};
  \node at (1.15,1.95) {(2)};
  % (1) origen
  \fill (0,0) circle (1.4pt);
  \node[below right] at (0,0) {(1)};
  % tabla de correspondencias: el número queda centrado bajo el eje q
  \node[anchor=north] at (0,-0.9) {%
    \begin{tabular}{>{\raggedleft\arraybackslash}p{4.6cm} c >{\raggedright\arraybackslash}p{4.6cm}}
      inacción y sin producción gratuita & (1) & $f(0)=0$\\
      eliminación gratuita & (2) & no decreciente\\
      convexidad & (3) & cóncava\\
      frontera sin vértices & (4) & dos veces derivable
    \end{tabular}};
\end{tikzpicture}
