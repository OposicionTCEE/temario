% Figura (bloque 3, «Corto plazo»): de las isocuantas a la curva de producto con el capital fijo (segunda pasada, 26/10/2026).
% Misma tecnología que anx_fases y anx_region: q = (L^2/K) e^{-L/K} (rendimientos constantes), capital fijo Kbar = 1,2.
% Isocuanta de nivel q en paramétricas, con t = L/K: (L, K) = (q e^t / t, q e^t / t^2); vertical en t = 1 y horizontal en t = 2;
% fuera de ese tramo se curva hacia atrás.
% (a) Isocuantas q_1 = 0,15, q_2 = 0,30, q_3 = 0,45 y q_4 = 0,60 (aumentos iguales); la recta K = Kbar las corta en
%     L = 0,529; 0,858; 1,224; 1,786 (distancias 0,33; 0,37; 0,56: primero se acortan respecto de la primera y después se alargan);
%     máximo técnico B en L = 2,4 (q = 0,6496); pasado B, la recta vuelve a cortar la isocuanta q_4 en L = 3,136 (tramo que se curva hacia atrás).
%     Radios por el primer y el cuarto punto: la proporción K/L cae de 2,27 a 0,67.
% (b) Curva de producto q = (L^2/1,2) e^{-L/1,2}, con los mismos puntos.
% Escalas: L, 1 unidad = 1,25 cm; K, 1 unidad = 1 cm (piso superior desplazado 4,0 cm); q, 1 unidad = 4 cm.
% Generar con: bash Code/generar_figura.sh b3_proporciones
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  \def\yo{4.0}
  % ---------------- (a) Isocuantas con el capital fijo ----------------
  \node[font=\footnotesize\bfseries] at (2.8,{\yo+3.75}) {(a) Isocuantas con el capital fijo};
  \draw[->] (0,\yo) -- (5.75,\yo) node[below] {$L$};
  \draw[->] (0,\yo) -- (0,{\yo+3.3}) node[left] {$K$};
  \foreach \q/\ta/\tb/\et in {0.15/0.253/4.955/{$q_1$}, 0.30/0.383/4.065/{$q_2$}, 0.45/0.495/3.515/{$q_3$}, 0.60/0.605/3.1/{$q_4$}} {
    \draw[thick] plot[domain=\ta:\tb, samples=90, variable=\t] ({1.25*\q*exp(\t)/\t},{\yo+\q*exp(\t)/(\t*\t)});
    \node[above] at ({1.25*\q*exp(\ta)/\ta},{\yo+3.0}) {\et};
  }
  % radios: la proporción K/L cae al añadir trabajo
  \draw[dashed] (0,\yo) -- (1.654,{\yo+3.0});
  \draw[dashed] (0,\yo) -- (5.375,{\yo+2.888});
  % capital fijo
  \draw[very thick] (0,{\yo+1.2}) -- (5.375,{\yo+1.2});
  \node[left] at (0,{\yo+1.2}) {$\bar K$};
  \foreach \l in {0.529, 0.858, 1.224, 1.786, 3.136} {
    \fill ({1.25*\l},{\yo+1.2}) circle (1.3pt);
  }
  \fill (3.0,{\yo+1.2}) circle (1.6pt) node[above right=-1pt] {$B$};
  % ---------------- (b) Curva de producto ----------------
  \node[font=\footnotesize\bfseries] at (2.8,3.2) {(b) Curva de producto a corto plazo};
  \draw[->] (0,0) -- (5.75,0) node[below] {$L$};
  \draw[->] (0,0) -- (0,2.95) node[left] {$q$};
  \draw[very thick] plot[domain=0:4.3, samples=90] ({1.25*\x},{4*(\x*\x/1.2)*exp(-\x/1.2)}) node[right] {$f(\bar K,L)$};
  \foreach \l/\q/\et in {0.529/0.15/{$q_1$}, 0.858/0.30/{$q_2$}, 1.224/0.45/{$q_3$}, 1.786/0.60/{$q_4$}} {
    \draw[dotted] ({1.25*\l},{\yo+1.2}) -- ({1.25*\l},{4*\q});
    \draw[dotted] (0,{4*\q}) node[left] {\et} -- ({1.25*\l},{4*\q});
    \fill ({1.25*\l},{4*\q}) circle (1.3pt);
  }
  \draw[dotted] (3.0,{\yo+1.2}) -- (3.0,2.598);
  \fill (3.0,2.598) circle (1.6pt) node[above] {$B$};
  \draw[dotted] (3.92,{\yo+1.2}) -- (3.92,2.4);
  \draw[dotted] (2.2325,2.4) -- (3.92,2.4);
  \fill (3.92,2.4) circle (1.3pt);
\end{tikzpicture}
