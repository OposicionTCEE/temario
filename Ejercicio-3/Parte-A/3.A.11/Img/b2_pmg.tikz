% Figura (bloque 2, «Productividad marginal»): la productividad marginal como pendiente de la tangente a la curva de producto
% con el capital fijo (segunda pasada, 26/10/2026). Curva q = f(Kbar, L) = 1,6 L^{0,6}; PMg = 0,96 L^{-0,4}.
%   L_0 = 1,2: q = 1,785; PMg = 0,8925 (tangente q = 1,785 + 0,8925 (L - 1,2)).
%   Una unidad más de trabajo, de L_0 a L_0 + 1 = 2,2: q = 2,568, de modo que Delta q = 0,783.
%   L_1 = 3,4: q = 3,336; PMg = 0,5887 (tangente q = 3,336 + 0,5887 (L - 3,4)): más plana.
% Escala: 1 unidad = 1 cm. La figura de la productividad media (b2_pme) usa la misma curva y los mismos puntos.
% Generar con: bash Code/generar_figura.sh b2_pmg
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  \draw[->] (0,0) -- (4.9,0) node[below] {$L$};
  \draw[->] (0,0) -- (0,4.4) node[left] {$q$};
  \draw[very thick] plot[domain=0:4.4, samples=70] (\x,{1.6*(\x)^0.6}) node[below right] {$f(\bar K,L)$};
  % tangente en L_0 y escalón de una unidad
  \draw[dashed] (0.3,0.982) -- (2.7,3.124) node[above left] {$PMg_L(L_0)$};
  \draw[dotted] (1.2,1.785) -- (2.2,1.785);
  \draw[dotted] (2.2,1.785) -- (2.2,2.568);
  \node[below] at (1.7,1.785) {$1$};
  \node[right] at (2.2,2.13) {$\Delta q$};
  % tangente en L_1
  \draw[dashed] (2.3,2.688) -- (4.4,3.925) node[above] {$PMg_L(L_1)$};
  % puntos y referencias en el eje
  \draw[dotted] (1.2,1.785) -- (1.2,0) node[below] {$L_0$};
  \draw[dotted] (3.4,3.336) -- (3.4,0) node[below] {$L_1$};
  \fill (1.2,1.785) circle (1.4pt);
  \fill (2.2,2.568) circle (1.2pt);
  \fill (3.4,3.336) circle (1.4pt);
\end{tikzpicture}
