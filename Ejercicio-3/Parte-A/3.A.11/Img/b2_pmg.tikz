% Figura (bloque 2, «Productividad marginal»): la productividad marginal como pendiente de la tangente a la curva de producto
% con el capital fijo (segunda pasada, 26/10/2026). Curva q = f(Kbar, L) = 3,6 (1 - e^{-0,55 L}); PMg = 1,98 e^{-0,55 L}.
%   L_0 = 1,2: q = 1,739; PMg = 1,0235 (tangente q = 1,739 + 1,0235 (L - 1,2)).
%   Una unidad más de trabajo, de L_0 a L_0 + 1 = 2,2: q = 2,526, de modo que Delta q = 0,787.
%   L_1 = 3,6: q = 3,103; PMg = 0,2734 (tangente q = 3,103 + 0,2734 (L - 3,6)): mucho más plana.
% Escala: 1 unidad = 1 cm. La figura de la productividad media (b2_pme) usa la misma curva y los mismos puntos.
% Generar con: bash Code/generar_figura.sh b2_pmg
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  \draw[->] (0,0) -- (4.9,0) node[below] {$L$};
  \draw[->] (0,0) -- (0,4.2) node[left] {$q$};
  \draw[very thick] plot[domain=0:4.5, samples=70] (\x,{3.6*(1-exp(-0.55*\x))}) node[right] {$f(\bar K,L)$};
  % tangente en L_0 y escalón de una unidad
  \draw[dashed] (0.4,0.920) -- (2.5,3.070) node[above] {$PMg_L(L_0)$};
  \draw[dotted] (1.2,1.739) -- (2.2,1.739);
  \draw[dotted] (2.2,1.739) -- (2.2,2.526);
  \node[below] at (1.7,1.739) {$1$};
  \node[right] at (2.2,2.11) {$\Delta q$};
  % tangente en L_1
  \draw[dashed] (2.6,2.830) -- (4.3,3.294) node[above left] {$PMg_L(L_1)$};
  % puntos y referencias en el eje
  \draw[dotted] (1.2,1.739) -- (1.2,0) node[below] {$L_0$};
  \draw[dotted] (3.6,3.103) -- (3.6,0) node[below] {$L_1$};
  \fill (1.2,1.739) circle (1.4pt);
  \fill (2.2,2.526) circle (1.2pt);
  \fill (3.6,3.103) circle (1.4pt);
\end{tikzpicture}
