% Figura (bloque 2, «Frontera» de la producción conjunta): las tres relaciones marginales de la tecnología como tres cortes
% de una misma frontera F(q, z) = 0, fijando todas las variables menos dos (segunda pasada, 26/10/2026).
% (a) Producto y producto, con los factores dados: curvas de transformación P(z) (semiejes 2,3 y 2,0) y P(z') (3,0 y 2,65);
%     A = (1,626; 1,414) en t = 45°; pendiente -0,8696, cuyo valor absoluto es la RMT.
% (b) Factor y producto, con lo demás dado: q_j = 2,6 (1 - e^{-0,6 z_i}); en z_i = 1,4, q_j = 1,4776 y pendiente 0,6735 = PMg.
% (c) Factor y factor, con los productos dados: isocuanta z_2 = 1,6 / z_1; en z_1 = 1,26, z_2 = 1,27 y pendiente -1,008 = -RMST.
% Escala: 1 unidad = 1 cm; paneles separados 4,3 cm. Sustituye en el cuerpo a anx_transformacion (que sigue en el anexo II).
% Glosario (26/10/2026): z y z' para las dos cantidades de factores, porque z_1 es el factor 1 en el panel (c).
% Generar con: bash Code/generar_figura.sh b2_relaciones_marginales
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  % ---------------- (a) Producto y producto ----------------
  \node[font=\footnotesize\bfseries] at (1.75,3.65) {(a) Producto y producto};
  \fill[black!10] (0,0) -- plot[domain=90:0, samples=60] ({2.3*cos(\x)},{2.0*sin(\x)}) -- cycle;
  \draw[->] (0,0) -- (3.6,0) node[below] {$q_1$};
  \draw[->] (0,0) -- (0,3.2) node[left] {$q_2$};
  \draw[very thick] plot[domain=90:0, samples=60] ({2.3*cos(\x)},{2.0*sin(\x)});
  \draw[thick, dashed] plot[domain=90:0, samples=60] ({3.0*cos(\x)},{2.65*sin(\x)});
  \node[below] at (2.3,0) {$z$};
  \node[below] at (3.0,0) {$z'$};
  \draw[densely dotted, thick] (1.0,1.959) node[above left=-1pt] {$-RMT$} -- (2.25,0.871);
  \fill (1.626,1.414) circle (1.4pt) node[above right=-1pt] {$A$};
  \node at (1.75,-0.75) {factores dados};
  % ---------------- (b) Factor y producto ----------------
  \begin{scope}[xshift=4.3cm]
    \node[font=\footnotesize\bfseries] at (1.75,3.65) {(b) Factor y producto};
    \draw[->] (0,0) -- (3.6,0) node[below] {$z_i$};
    \draw[->] (0,0) -- (0,3.2) node[left] {$q_j$};
    \draw[very thick] plot[domain=0:3.4, samples=60] (\x,{2.6*(1-exp(-0.6*\x))});
    \draw[densely dotted, thick] (0.4,0.804) -- (2.6,2.286) node[above left] {$PMg$};
    \fill (1.4,1.4776) circle (1.4pt);
    \node at (1.75,-0.75) {lo demás dado};
  \end{scope}
  % ---------------- (c) Factor y factor ----------------
  \begin{scope}[xshift=8.6cm]
    \node[font=\footnotesize\bfseries] at (1.75,3.65) {(c) Factor y factor};
    \draw[->] (0,0) -- (3.6,0) node[below] {$z_1$};
    \draw[->] (0,0) -- (0,3.2) node[left] {$z_2$};
    \draw[very thick] plot[domain=0.53:3.4, samples=60] (\x,{1.6/\x});
    \draw[densely dotted, thick] (0.5,2.036) -- (2.1,0.423) node[below] {$-RMST$};
    \fill (1.26,1.27) circle (1.4pt);
    \node at (1.75,-0.75) {productos dados};
  \end{scope}
\end{tikzpicture}
