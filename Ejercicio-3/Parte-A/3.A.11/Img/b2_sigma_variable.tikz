% Figura (bloque 2, «Elasticidad variable»): la elasticidad de sustitución según la proporción entre factores (segunda pasada, 26/10/2026).
% CES: rectas horizontales (sigma = 1/2, 1 y 2; la COBB-DOUGLAS es la de sigma = 1).
% Elasticidad variable (forma de REVANKAR, 1971, ilustrativa): sigma lineal en K/L, sigma = 0,3 + 0,5 K/L, de 0,4 a 2,4 en K/L de 0,2 a 4,2.
% Escala: 1 unidad = 1,2 cm en los dos ejes.
% Generar con: bash Code/generar_figura.sh b2_sigma_variable
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1.2cm, y=1.2cm]
  \draw[->] (0,0) -- (4.7,0) node[below] {$K/L$};
  \draw[->] (0,0) -- (0,2.9) node[left] {$\sigma$};
  \draw[very thick] (0.2,2) -- (4.2,2) node[right] {$\sigma=2$};
  \draw[very thick] (0.2,1) -- (4.2,1) node[right] {$\sigma=1$};
  \draw[very thick] (0.2,0.5) -- (4.2,0.5) node[right] {$\sigma=1/2$};
  \draw[very thick, dashed] (0.2,0.4) -- (4.2,2.4) node[right] {variable};
  \node[left] at (0,2) {$2$};
  \node[left] at (0,1) {$1$};
  \node[left] at (0,0.5) {$1/2$};
\end{tikzpicture}
