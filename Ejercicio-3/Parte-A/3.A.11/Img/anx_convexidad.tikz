% Figura (Anexo I, «Convexidad»).
% (a) Y convexo: frontera 1,6 z^{0,55}; y = (-0,6; 1,208), y' = (-2,6; 2,707); punto medio m = (-1,6; 1,958) dentro (f(1,6) = 2,072).
% (b) Y no convexo: frontera 0,75 z^{1,6}; y = (-0,6; 0,331), y' = (-2,6; 3,458); punto medio m = (-1,6; 1,895) fuera (f(1,6) = 1,592).
% (c) Isocuantas de q = z_1 z_2 para q, 2q y 3q (z_2 = c / z_1 con c = 1,2; 2,4; 3,6): conjuntos V(q) convexos y cada vez más juntos
%     sobre la diagonal (z_1 = z_2 = 1,095; 1,549; 1,897): rendimientos crecientes con isocuantas convexas.
% Generar con: bash Code/generar_figura.sh anx_convexidad
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  \def\S{5.3}
  % ---------------- (a) Y convexo ----------------
  \node[font=\footnotesize\bfseries] at (-1.45,4.0) {(a) $Y$ convexo};
  \fill[black!12] (0,0) -- plot[domain=0:2.9, samples=60] ({-\x},{1.6*(\x)^0.55}) -- (-2.9,-0.5) -- (0,-0.5) -- cycle;
  \draw[->] (-3.2,0) -- (0.5,0) node[below] {$y_1$};
  \draw[->] (0,-0.6) -- (0,3.6) node[left] {$y_2$};
  \draw[very thick] plot[domain=0:2.9, samples=60] ({-\x},{1.6*(\x)^0.55});
  \draw[dashed] (-0.6,1.208) -- (-2.6,2.707);
  \fill (-0.6,1.208) circle (1.4pt) node[right] {$y$};
  \fill (-2.6,2.707) circle (1.4pt) node[above] {$y'$};
  \fill (-1.6,1.958) circle (1.4pt) node[below] {$m$};
  % ---------------- (b) Y no convexo ----------------
  \begin{scope}[xshift=\S cm]
    \node[font=\footnotesize\bfseries] at (-1.45,4.0) {(b) $Y$ no convexo};
    \fill[black!12] (0,0) -- plot[domain=0:2.7, samples=60] ({-\x},{0.75*(\x)^1.6}) -- (-2.9,3.68) -- (-2.9,-0.5) -- (0,-0.5) -- cycle;
    \draw[->] (-3.2,0) -- (0.5,0) node[below] {$y_1$};
    \draw[->] (0,-0.6) -- (0,3.6) node[left] {$y_2$};
    \draw[very thick] plot[domain=0:2.7, samples=60] ({-\x},{0.75*(\x)^1.6});
    \draw[dashed] (-0.6,0.331) -- (-2.6,3.458);
    \fill (-0.6,0.331) circle (1.4pt) node[above right] {$y$};
    \fill (-2.6,3.458) circle (1.4pt) node[right] {$y'$};
    \draw[fill=white] (-1.6,1.895) circle (1.6pt) node[right] {$m$};
  \end{scope}
  % ---------------- (c) V(q) convexos ----------------
  \begin{scope}[xshift=2*\S cm-3.2cm]
    \node[font=\footnotesize\bfseries] at (1.75,4.0) {(c) $V(q)$ convexos};
    \draw[->] (0,0) -- (3.7,0) node[below] {$z_1$};
    \draw[->] (0,0) -- (0,3.6) node[left] {$z_2$};
    \draw[dashed] (0,0) -- (2.6,2.6);
    \foreach \c/\et in {1.2/{$q$}, 2.4/{$2q$}, 3.6/{$3q$}} {
      \draw[very thick] plot[domain={\c/3.4}:3.4, samples=60] (\x,{\c/\x}) node[right] {\et};
    }
  \end{scope}
  \node at ({\S},-1.05) {$m=\tfrac12 y+\tfrac12 y'$ \qquad (c): isocuantas de $q=z_1z_2$};
\end{tikzpicture}
