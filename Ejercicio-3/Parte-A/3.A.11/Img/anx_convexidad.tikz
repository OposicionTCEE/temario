% Figura (bloque 1 y Anexo I, «Convexidad»).
% (a) Y convexo: frontera 1,6 z^{0,55}; y = (-0,6; 1,208), y' = (-2,6; 2,707); punto medio m = (-1,6; 1,958) dentro (f(1,6) = 2,072).
% (b) y (c): la MISMA tecnología con rendimientos crecientes, q = z_1 z_2, vista de dos maneras (segunda pasada, 26/10/2026).
% (b) Corte del conjunto de producción por el radio z_1 = z_2 = t: frontera q = t^2 (escalas: t, 1 unidad = 1,25 cm; q, 1 unidad = 0,75 cm).
%     y = plan con z = (1, 1) y q_0 = 1; y' = plan con z' = (2, 2) y 4 q_0; m = (y + y')/2 exigiría 5/2 q_0 con z_m = (3/2, 3/2),
%     que solo obtiene 9/4 q_0 (punto de la frontera justo debajo de m): m no es factible.
% (c) Isocuantas de q = z_1 z_2 (1 unidad = 1,15 cm): q_0 (z_1 z_2 = 1), la de z_m (9/4, punteada) y 4 q_0; z, z_m y z' en el radio.
%     Las isocuantas son convexas (V(q) convexos) aunque duplicar los factores cuadruplique el producto.
% Generar con: bash Code/generar_figura.sh anx_convexidad
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  \def\S{5.3}
  % ---------------- (a) Y convexo ----------------
  \node[font=\footnotesize\bfseries] at (-1.45,4.0) {(a) $Y$ convexo};
  \fill[black!12] (0,0) -- plot[domain=0:2.9, samples=60] ({-\x},{1.6*(\x)^0.55}) -- (-2.9,-0.5) -- (0,-0.5) -- cycle;
  \draw[->] (-3.2,0) -- (0.5,0) node[below] {$y_1$};
  \draw[->] (0,-0.6) -- (0,3.6) node[left] {$y_2$};
  \draw[very thick] plot[domain=0:2.9, samples=60] ({-\x},{1.6*(\x)^0.55});
  \draw[dashed] (-0.6,1.208) -- (-2.6,2.707);
  \fill (-0.6,1.208) circle (1.4pt) node[right] {$y$};
  \fill (-2.6,2.707) circle (1.4pt) node[above] {$y'$};
  \fill (-1.6,1.958) circle (1.4pt) node[below] {$m$};
  % ---------------- (b) Y no convexo: corte por el radio z_1 = z_2 ----------------
  \begin{scope}[xshift=\S cm]
    \node[font=\footnotesize\bfseries] at (-1.45,4.0) {(b) $Y$ no convexo};
    \fill[black!12] (0,0) -- plot[domain=0:2.19, samples=60] ({-1.25*\x},{0.75*\x*\x}) -- (-2.9,3.6) -- (-2.9,-0.5) -- (0,-0.5) -- cycle;
    \draw[->] (-3.2,0) -- (0.5,0) node[below] {$-t$};
    \draw[->] (0,-0.6) -- (0,3.8) node[left] {$q$};
    \draw[very thick] plot[domain=0:2.19, samples=60] ({-1.25*\x},{0.75*\x*\x});
    \draw[dotted] (-1.25,0) node[below] {$z$} -- (-1.25,0.75) -- (0,0.75) node[right] {$q_0$};
    \draw[dotted] (-2.5,0) node[below] {$z'$} -- (-2.5,3.0) -- (0,3.0) node[right] {$4q_0$};
    \draw[dotted] (-1.875,0) node[below] {$z_m$} -- (-1.875,1.6875);
    \draw[dashed] (-1.25,0.75) -- (-2.5,3.0);
    \fill (-1.25,0.75) circle (1.4pt) node[left] {$y$};
    \fill (-2.5,3.0) circle (1.4pt) node[above right] {$y'$};
    \fill (-1.875,1.6875) circle (1.2pt);
    \draw[fill=white] (-1.875,1.875) circle (1.6pt) node[right] {$m$};
  \end{scope}
  % ---------------- (c) V(q) convexos: isocuantas de la misma tecnología ----------------
  \begin{scope}[xshift=2*\S cm-3.2cm]
    \node[font=\footnotesize\bfseries] at (1.75,4.0) {(c) $V(q)$ convexos};
    \draw[->] (0,0) -- (3.9,0) node[below] {$z_1$};
    \draw[->] (0,0) -- (0,3.6) node[left] {$z_2$};
    \draw[dashed] (0,0) -- (3.0,3.0);
    \draw[very thick] plot[domain=0.389:3.4, samples=60] (\x,{1.3225/\x}) node[right] {$q_0$};
    \draw[thick, densely dotted] plot[domain=0.875:3.4, samples=60] (\x,{2.9756/\x});
    \draw[very thick] plot[domain=1.556:3.4, samples=60] (\x,{5.29/\x}) node[right] {$4q_0$};
    \fill (1.15,1.15) circle (1.4pt) node[right=1pt] {$z$};
    \fill (1.725,1.725) circle (1.4pt) node[right=1pt] {$z_m$};
    \fill (2.3,2.3) circle (1.4pt) node[right=1pt] {$z'$};
  \end{scope}
  \node at ({\S},-1.15) {$m=\tfrac12 y+\tfrac12 y'$ \qquad (b) y (c): $q=z_1z_2$; en (b), $z=(t,t)$};
\end{tikzpicture}
