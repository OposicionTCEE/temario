% Figura (Anexo III, «Rendimientos a escala y productividades»): tecnología con rendimientos constantes q = (K L)^{1/2}.
% Isocuantas de niveles q_0, q_1, q_2, q_3 en proporción 1 : 1,25 : 1,5 : 1,75 (aumentos iguales de producto): K L = c^2,
% con c = 1; 1,25; 1,5; 1,75.
% Por el radio K = L: cortes en c (separación constante). Por la horizontal K = 1: cortes en L = c^2 = 1; 1,5625; 2,25; 3,0625
% (separación creciente: productividad marginal decreciente del trabajo).
% Escala: 1 unidad = 1,7 cm. Sustituye a RendimientosEscala_Productividad.png del tema antiguo.
% Generar con: bash Code/generar_figura.sh anx_proporciones_escala
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1.7cm, y=1.7cm]
  \draw[->] (0,0) -- (3.75,0) node[below] {$L$};
  \draw[->] (0,0) -- (0,2.6) node[left] {$K$};
  \foreach \c/\et in {1/{$q_0$}, 1.25/{$q_1$}, 1.5/{$q_2$}, 1.75/{$q_3$}} {
    \draw[thick] plot[domain={\c*\c/2.45}:3.5, samples=60] (\x,{\c*\c/\x}) node[right] {\et};
  }
  \draw[dashed] (0,0) -- (2.2,2.2) node[above right] {radio};
  \draw[dashed] (0,1) -- (3.5,1);
  \node[left] at (0,1) {$\bar K$};
  \foreach \c in {1, 1.25, 1.5, 1.75} {
    \fill (\c,\c) circle (1.3pt);
  }
  \foreach \l in {1, 1.5625, 2.25, 3.0625} {
    \draw[fill=white] (\l,1) circle (1.4pt);
  }
\end{tikzpicture}
