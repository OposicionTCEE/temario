% Figura (Anexo I, «Planes eficientes y precios»): un factor y un producto; recta de isobeneficio p·y = constante.
% (a) Y convexo: frontera 1,6 z^{0,55}; y* = (-1,6; 2,072); pendiente de la frontera en y*: -0,712 (en el plano y_1, y_2).
%     Recta tangente y_2 = 2,072 - 0,712 (y_1 + 1,6); vector de precios p proporcional a (0,712; 1). Ningún plan factible queda por encima.
% (b) Y no convexo: frontera 0,75 z^{1,6}; y* = (-1,6; 1,592); pendiente -1,591. Recta tangente y_2 = 1,592 - 1,591 (y_1 + 1,6),
%     por debajo de la frontera a ambos lados: y' = (-2,6; 3,458) da más beneficio a esos precios (la recta pasa por 3,183 en y_1 = -2,6).
% Generar con: bash Code/generar_figura.sh anx_eficiencia_precios
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  \def\S{6.4}
  % ---------------- (a) Y convexo ----------------
  \node[font=\footnotesize\bfseries] at (-1.2,4.05) {(a) $Y$ convexo: $y^{*}$ sostenido por $p$};
  \fill[black!12] (0,0) -- plot[domain=0:2.9, samples=60] ({-\x},{1.6*(\x)^0.55}) -- (-2.9,-0.5) -- (0,-0.5) -- cycle;
  \draw[->] (-3.2,0) -- (1.0,0) node[below] {$y_1$};
  \draw[->] (0,-0.6) -- (0,3.6) node[left] {$y_2$};
  \draw[very thick] plot[domain=0:2.9, samples=60] ({-\x},{1.6*(\x)^0.55});
  \draw[dashed] (-3.0,3.069) -- (0.6,0.506) node[right] {$p\cdot y=\pi^{*}$};
  \draw[->, thick] (-1.6,2.072) -- (-1.135,2.725) node[above] {$p$};
  \fill (-1.6,2.072) circle (1.4pt) node[below left] {$y^{*}$};
  \node at (-2.2,0.7) {$Y$};
  % ---------------- (b) Y no convexo ----------------
  \begin{scope}[xshift=\S cm]
    \node[font=\footnotesize\bfseries] at (-1.2,4.05) {(b) $Y$ no convexo: ningún $p$ sostiene $y^{*}$};
    \fill[black!12] (0,0) -- plot[domain=0:2.7, samples=60] ({-\x},{0.75*(\x)^1.6}) -- (-2.9,3.68) -- (-2.9,-0.5) -- (0,-0.5) -- cycle;
    \draw[->] (-3.2,0) -- (1.0,0) node[below] {$y_1$};
    \draw[->] (0,-0.6) -- (0,3.6) node[left] {$y_2$};
    \draw[very thick] plot[domain=0:2.7, samples=60] ({-\x},{0.75*(\x)^1.6});
    \draw[dashed] (-2.9,3.660) -- (-0.3,-0.476);
    \fill (-1.6,1.592) circle (1.4pt) node[right] {$y^{*}$};
    \fill (-2.6,3.458) circle (1.4pt) node[right] {$y'$};
    \node at (-2.2,0.7) {$Y$};
  \end{scope}
\end{tikzpicture}
