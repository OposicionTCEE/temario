% Figura (Anexo I, «De los procesos a la isocuanta»): isocuanta de una unidad de producto en el espacio de los factores.
% (a) Cuatro procesos de proporciones fijas: a = (0,6; 3,0), b = (1,2; 1,5), c = (2,2; 1,6), d = (3,0; 0,6).
%     La isocuanta es la línea quebrada convexa a-b-d con brazos vertical y horizontal; c queda por encima del tramo b-d
%     (en z_1 = 2,2 el tramo pasa por z_2 = 1,0): proceso dominado.
% (b) Ocho procesos con puntos sobre z_2 = 1,8 / z_1 (z_1 = 0,6; 0,8; 1,05; 1,35; 1,7; 2,1; 2,55; 3,0): la línea quebrada se acerca
%     a la curva suave (fina).
% Sustituye a la figura FP_LEONTIEFF.png del tema antiguo (panel de isocuantas quebradas).
% Generar con: bash Code/generar_figura.sh anx_actividades
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  \def\S{6.8}
  % ---------------- (a) Cuatro procesos ----------------
  \node[font=\footnotesize\bfseries] at (2.0,4.15) {(a) Cuatro procesos};
  \fill[black!12] (0.6,3.75) -- (0.6,3.0) -- (1.2,1.5) -- (3.0,0.6) -- (3.9,0.6) -- (3.9,3.75) -- cycle;
  \draw[->] (0,0) -- (4.3,0) node[below] {$z_1$};
  \draw[->] (0,0) -- (0,3.9) node[left] {$z_2$};
  \draw[dashed, black!60] (0,0) -- (0.69,3.45) node[black, right] {$A$};
  \foreach \px/\py/\n in {1.2/1.5/B, 2.2/1.6/C, 3.0/0.6/D} {
    \draw[dashed, black!60] (0,0) -- ({1.22*\px},{1.22*\py}) node[black, above right=-1pt] {$\n$};
  }
  \draw[very thick] (0.6,3.75) -- (0.6,3.0) -- (1.2,1.5) -- (3.0,0.6) -- (3.9,0.6);
  \fill (0.6,3.0) circle (1.4pt) node[left] {$a$};
  \fill (1.2,1.5) circle (1.4pt) node[below left] {$b$};
  \draw[fill=white] (2.2,1.6) circle (1.6pt) node[above] {$c$};
  \fill (3.0,0.6) circle (1.4pt) node[below] {$d$};
  % ---------------- (b) Muchos procesos ----------------
  \begin{scope}[xshift=\S cm]
    \node[font=\footnotesize\bfseries] at (2.0,4.15) {(b) Muchos procesos};
    \fill[black!12] (0.6,3.75) -- (0.6,3.0) -- (0.8,2.25) -- (1.05,1.714) -- (1.35,1.333) -- (1.7,1.059) -- (2.1,0.857) -- (2.55,0.706) -- (3.0,0.6) -- (3.9,0.6) -- (3.9,3.75) -- cycle;
    \draw[->] (0,0) -- (4.3,0) node[below] {$z_1$};
    \draw[->] (0,0) -- (0,3.9) node[left] {$z_2$};
    \foreach \px/\py in {0.6/3.0, 0.8/2.25, 1.05/1.714, 1.35/1.333, 1.7/1.059, 2.1/0.857, 2.55/0.706, 3.0/0.6} {
      \draw[dashed, black!40] (0,0) -- (\px,\py);
      \fill (\px,\py) circle (1.1pt);
    }
    \draw[very thick] (0.6,3.75) -- (0.6,3.0) -- (0.8,2.25) -- (1.05,1.714) -- (1.35,1.333) -- (1.7,1.059) -- (2.1,0.857) -- (2.55,0.706) -- (3.0,0.6) -- (3.9,0.6);
    \draw[thin] plot[domain=0.6:3.0, samples=60] (\x,{1.8/\x});
  \end{scope}
\end{tikzpicture}
