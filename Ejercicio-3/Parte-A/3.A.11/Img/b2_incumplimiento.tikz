% Figura (bloque 2, «Incumplimiento»): qué forma toma la función cuando falla cada propiedad del conjunto (segunda pasada, 26/10/2026).
% (a) Sin eliminación gratuita: q = 2,4 (z/1,4) e^{1 - z/1,4} (en cm), máximo en z = 1,4 con q = 2,4; después desciende (congestión).
%     Punteada: con eliminación gratuita la curva se quedaría plana en el máximo.
% (b) Sin convexidad del conjunto: curva en S, q = 2,8 / (1 + e^{-2,4 (z - 1,6)}) - 0,059 (q(0) = 0; inflexión en z = 1,6);
%     la cuerda entre el origen y z = 1,6 (q = 1,341) queda POR ENCIMA del tramo convexo: la función no es cóncava.
% (c) Sin convexidad de V(q): isocuanta cóncava hacia el origen, z_1^2 + z_2^2 = 2,4^2; isocoste de pendiente -0,7 por la esquina
%     E = (2,4; 0): el resto de la isocuanta queda por encima, de modo que el mínimo coste está en la esquina.
% (d) Sin derivabilidad: isocuanta en ángulo recto con vértice V = (1,2; 1,2); dos isocostes de pendientes -0,5 y -2 por el vértice.
% Escala: 1 unidad = 1 cm; paneles separados 4,0 cm.
% Generar con: bash Code/generar_figura.sh b2_incumplimiento
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  % ---------------- (a) Sin eliminación gratuita ----------------
  \node[font=\footnotesize\bfseries, align=center] at (1.7,3.75) {(a) Sin eliminación\\ gratuita};
  \draw[->] (0,0) -- (3.5,0) node[below] {$z$};
  \draw[->] (0,0) -- (0,3.0) node[left] {$q$};
  \draw[dotted, thick] (1.4,2.4) -- (3.3,2.4);
  \draw[very thick] plot[domain=0:3.3, samples=60] (\x,{2.4*(\x/1.4)*exp(1-\x/1.4)});
  \fill (1.4,2.4) circle (1.4pt);
  \node at (1.7,-0.6) {$f'<0$ tras el máximo};
  % ---------------- (b) Sin convexidad del conjunto ----------------
  \begin{scope}[xshift=4.0cm]
    \node[font=\footnotesize\bfseries, align=center] at (1.7,3.75) {(b) Sin convexidad\\ del conjunto};
    \draw[->] (0,0) -- (3.5,0) node[below] {$z$};
    \draw[->] (0,0) -- (0,3.0) node[left] {$q$};
    \draw[very thick] plot[domain=0:3.3, samples=60] (\x,{2.8/(1+exp(-2.4*(\x-1.6)))-0.059});
    \draw[dashed] (0,0) -- (1.6,1.341);
    \fill (1.6,1.341) circle (1.4pt);
    \node at (1.7,-0.6) {$f''>0$ en un tramo};
  \end{scope}
  % ---------------- (c) Sin convexidad de V(q) ----------------
  \begin{scope}[xshift=8.0cm]
    \node[font=\footnotesize\bfseries, align=center] at (1.7,3.75) {(c) Sin convexidad\\ de $V(q)$};
    \draw[->] (0,0) -- (3.5,0) node[below] {$z_1$};
    \draw[->] (0,0) -- (0,3.0) node[left] {$z_2$};
    \draw[very thick] (2.4,0) arc[start angle=0, end angle=90, radius=2.4];
    \draw[dashed] (0,1.68) -- (2.4,0);
    \fill (2.4,0) circle (1.4pt) node[above right] {$E$};
    \node at (1.7,-0.6) {solución de esquina};
  \end{scope}
  % ---------------- (d) Sin derivabilidad ----------------
  \begin{scope}[xshift=12.0cm]
    \node[font=\footnotesize\bfseries, align=center] at (1.7,3.75) {(d) Sin\\ derivabilidad};
    \draw[->] (0,0) -- (3.5,0) node[below] {$z_1$};
    \draw[->] (0,0) -- (0,3.0) node[left] {$z_2$};
    \draw[very thick] (1.2,2.8) -- (1.2,1.2) -- (3.2,1.2);
    \draw[dashed] (0.2,1.7) -- (3.2,0.2);
    \draw[dashed] (0.6,2.4) -- (1.8,0);
    \fill (1.2,1.2) circle (1.4pt) node[above right] {$V$};
    \node at (1.7,-0.6) {$RMST$ no definida en $V$};
  \end{scope}
\end{tikzpicture}
