% Figura (Anexo I, «Factores necesarios, productos posibles e isocuanta»): la misma tecnología leída en el espacio de los factores y en el de los productos.
% (a) V(q): región por encima de la isocuanta z_2 = 2,2 / z_1, con z_1 en [0,55; 4,1].
% (b) P(z): región bajo la curva de transformación q_2 = 3,2 (1 - (q_1/3,4)^2)^{1/2}.
% Generar con: bash Code/generar_figura.sh anx_representaciones
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  % ---------------- (a) Conjunto de factores necesarios ----------------
  \node[font=\footnotesize\bfseries] at (2.1,4.75) {(a) Factores necesarios};
  \fill[black!12] (0.55,4.15) -- plot[domain=0.55:4.1, samples=60] (\x,{2.2/\x}) -- (4.1,4.15) -- cycle;
  \draw[->] (0,0) -- (4.5,0) node[below] {$z_1$};
  \draw[->] (0,0) -- (0,4.4) node[left] {$z_2$};
  \draw[very thick] plot[domain=0.55:4.1, samples=60] (\x,{2.2/\x}) node[right] {$Q(q)$};
  \node at (2.6,2.7) {$V(q)$};
  % ---------------- (b) Conjunto de productos posibles ----------------
  \begin{scope}[xshift=7.2cm]
    \node[font=\footnotesize\bfseries] at (2.1,4.75) {(b) Productos posibles};
    \fill[black!12] (0,0) -- (0,3.2) -- plot[domain=0:3.4, samples=80] (\x,{3.2*sqrt(max(0,1-(\x/3.4)^2))}) -- cycle;
    \draw[->] (0,0) -- (4.5,0) node[below] {$q_1$};
    \draw[->] (0,0) -- (0,4.4) node[left] {$q_2$};
    \draw[very thick] plot[domain=0:3.4, samples=80] (\x,{3.2*sqrt(max(0,1-(\x/3.4)^2))});
    \node at (1.25,1.25) {$P(z)$};
  \end{scope}
\end{tikzpicture}
