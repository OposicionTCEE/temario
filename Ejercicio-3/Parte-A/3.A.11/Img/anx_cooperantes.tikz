% Figura (Anexo II, «Factores cooperantes y factores competitivos»): q = 1,5 K^{0,4} L^{0,6} con K_0 = 1 y K_1 = 2,5.
% En L = 2: q_0 = 2,274 (pendiente 0,682); q_1 = 3,280 (pendiente 0,984): con más capital, el producto y la productividad
% marginal del trabajo son mayores.
% Glosario (26/10/2026): L_a, el mismo nombre que en b2_pmg y b2_pme.
% Generar con: bash Code/generar_figura.sh anx_cooperantes
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  % ---------------- (b) Factores cooperantes ----------------
  \draw[->] (0,0) -- (4.5,0) node[below] {$L$};
  \draw[->] (0,0) -- (0,4.7) node[left] {$q$};
  \draw[very thick] plot[domain=0:3.6, samples=60] (\x,{1.5*(\x)^0.6}) node[right] {$f(K_0,L)$};
  \draw[very thick] plot[domain=0:3.4, samples=60] (\x,{2.164*(\x)^0.6}) node[right] {$f(K_1,L)$};
  \draw[dashed] (0.6,1.319) -- (3.4,3.229);
  \draw[dashed] (0.6,1.902) -- (3.4,4.658);
  \draw[dotted] (2,3.280) -- (2,0) node[below] {$L_a$};
  \fill (2,2.274) circle (1.4pt);
  \fill (2,3.280) circle (1.4pt);
  \node at (2.2,-0.75) {$K_1>K_0$};
\end{tikzpicture}
