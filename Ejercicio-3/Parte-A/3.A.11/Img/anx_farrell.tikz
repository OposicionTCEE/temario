% Figura (Anexo I, «La distancia a la frontera»): medida radial de eficiencia técnica en el espacio de los factores.
% (a) Isocuanta suave z_2 = 2,2 / z_1; plan observado P = (2,8; 2,6); su proyección radial sobre la isocuanta es Q = (1,539; 1,429)
%     (radio z_2 = 0,9286 z_1). ET = OQ/OP = 0,55 = 1/D(z,q).
% (b) Isocuanta quebrada: brazo vertical en z_1 = 0,9 desde a = (0,9; 2,0), tramo a-b con b = (2,4; 0,9) y brazo horizontal.
%     P' = (1,1; 3,2); su proyección radial Q' = (0,9; 2,618) cae en el brazo vertical: ET = 1/D, pero sobra z_2 (holgura Q'-a).
% Generar con: bash Code/generar_figura.sh anx_farrell
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  \def\S{6.8}
  % ---------------- (a) Isocuanta suave ----------------
  \node[font=\footnotesize\bfseries] at (2.0,4.15) {(a) Contracción radial hasta la isocuanta};
  \fill[black!12] (0.6,3.75) -- plot[domain=0.6:3.9, samples=60] (\x,{2.2/\x}) -- (3.9,3.75) -- cycle;
  \draw[->] (0,0) -- (4.3,0) node[below] {$z_1$};
  \draw[->] (0,0) -- (0,3.9) node[left] {$z_2$};
  \draw[very thick] plot[domain=0.6:3.9, samples=60] (\x,{2.2/\x}) node[right] {$Q(q)$};
  \draw[dashed] (0,0) -- (2.8,2.6);
  \fill (2.8,2.6) circle (1.4pt) node[above right] {$P$};
  \fill (1.539,1.429) circle (1.4pt) node[below right] {$Q$};
  \node[below left] at (0,0) {$O$};
  \node at (2.0,-0.75) {$ET=\dfrac{OQ}{OP}=\dfrac{1}{D(z,q)}$};
  % ---------------- (b) Isocuanta quebrada ----------------
  \begin{scope}[xshift=\S cm]
    \node[font=\footnotesize\bfseries] at (2.0,4.15) {(b) Proyección sobre un brazo de la isocuanta};
    \fill[black!12] (0.9,3.75) -- (0.9,2.0) -- (2.4,0.9) -- (3.9,0.9) -- (3.9,3.75) -- cycle;
    \draw[->] (0,0) -- (4.3,0) node[below] {$z_1$};
    \draw[->] (0,0) -- (0,3.9) node[left] {$z_2$};
    \draw[very thick] (0.9,3.75) -- (0.9,2.0) -- (2.4,0.9) -- (3.9,0.9) node[above] {$Q(q)$};
    \draw[dashed] (0,0) -- (1.1,3.2);
    \fill (1.1,3.2) circle (1.4pt) node[right] {$P'$};
    \fill (0.9,2.618) circle (1.4pt) node[left] {$Q'$};
    \fill (0.9,2.0) circle (1.4pt) node[left] {$a$};
    \fill (2.4,0.9) circle (1.4pt) node[below] {$b$};
    \draw[decorate, decoration={brace, amplitude=3pt}] (0.98,2.6) -- (0.98,2.02) node[midway, right=3pt] {holgura};
    \node[below left] at (0,0) {$O$};
  \end{scope}
\end{tikzpicture}
