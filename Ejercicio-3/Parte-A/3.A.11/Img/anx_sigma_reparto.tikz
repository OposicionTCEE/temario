% Figura (Anexo II, «La elasticidad de sustitución y el reparto de la renta»): participación relativa del capital, s_K / s_L,
% en función de la proporción K/L, normalizada a 1 en K/L = 1: (K/L)^{1 - 1/sigma}.
% sigma = 2: (K/L)^{1/2}, creciente; sigma = 1: constante; sigma = 1/2: (K/L)^{-1}, decreciente. K/L en [0,4; 4].
% Escala: eje horizontal 1 unidad = 1,25 cm; eje vertical 1 unidad = 1,25 cm.
% Generar con: bash Code/generar_figura.sh anx_sigma_reparto
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1.25cm, y=1.25cm]
  \draw[->] (0,0) -- (4.6,0) node[below] {$K/L$};
  \draw[->] (0,0) -- (0,2.75) node[left] {$s_K/s_L$};
  \draw[very thick] plot[domain=0.4:4.2, samples=60] (\x,{sqrt(\x)}) node[right] {$\sigma>1$};
  \draw[very thick] (0.4,1) -- (4.2,1) node[right] {$\sigma=1$};
  \draw[very thick] plot[domain=0.4:4.2, samples=60] (\x,{1/\x}) node[right] {$\sigma<1$};
  \draw[dotted] (1,0) node[below] {$1$} -- (1,1);
  \draw[dotted] (0,1) node[left] {$1$} -- (1,1);
\end{tikzpicture}
