% Figura (Anexo II, «Productividades»).
% (a) Producto total con K fijo: q = 1,6 L^{0,6}. En L = 2: q = 2,425; PMg = 0,728 (pendiente de la tangente); PMe = 1,213 (pendiente del radio).
%     Tangente: q = 2,425 + 0,728 (L - 2). Radio: q = 1,213 L.
% (b) Factores cooperantes: q = 1,5 K^{0,4} L^{0,6} con K_0 = 1 y K_1 = 2,5. En L = 2: q_0 = 2,274 (pendiente 0,682); q_1 = 3,280
%     (pendiente 0,984): con más capital, el producto y la productividad marginal del trabajo son mayores.
% Sustituye, junto con anx_rmst, a la figura COBB-DOUGLAS_FP.png del tema antiguo (panel del rendimiento marginal del trabajo).
% Generar con: bash Code/generar_figura.sh anx_productividades
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  \def\S{7.2}
  % ---------------- (a) PMg y PMe ----------------
  \node[font=\footnotesize\bfseries] at (2.1,5.0) {(a) Productividad marginal y media};
  \draw[->] (0,0) -- (4.5,0) node[below] {$L$};
  \draw[->] (0,0) -- (0,4.7) node[left] {$q$};
  \draw[very thick] plot[domain=0:4, samples=60] (\x,{1.6*(\x)^0.6}) node[right] {$f(\bar K,L)$};
  \draw[dashed] (0.3,1.188) -- (4.0,3.881) node[above right=-2pt] {$PMg_L$};
  \draw[densely dotted, thick] (0,0) -- (3.3,4.001) node[above] {$PMe_L$};
  \draw[dotted] (2,2.425) -- (2,0) node[below] {$L_0$};
  \fill (2,2.425) circle (1.4pt);
  % ---------------- (b) Factores cooperantes ----------------
  \begin{scope}[xshift=\S cm]
    \node[font=\footnotesize\bfseries] at (2.1,5.0) {(b) Factores cooperantes: $f_{KL}>0$};
    \draw[->] (0,0) -- (4.5,0) node[below] {$L$};
    \draw[->] (0,0) -- (0,4.7) node[left] {$q$};
    \draw[very thick] plot[domain=0:3.6, samples=60] (\x,{1.5*(\x)^0.6}) node[right] {$f(K_0,L)$};
    \draw[very thick] plot[domain=0:3.4, samples=60] (\x,{2.164*(\x)^0.6}) node[right] {$f(K_1,L)$};
    \draw[dashed] (1.2,1.728) -- (2.8,2.819);
    \draw[dashed] (1.2,2.493) -- (2.8,4.067);
    \draw[dotted] (2,3.280) -- (2,0) node[below] {$L_0$};
    \fill (2,2.274) circle (1.4pt);
    \fill (2,3.280) circle (1.4pt);
    \node at (2.2,-0.75) {$K_1>K_0$};
  \end{scope}
\end{tikzpicture}
