% Figura (Anexo III, «Región económica y líneas de contorno»): isocuantas de q = (L^2/K) e^{-L/K} (rendimientos constantes).
% Con x = L/K, la isocuanta de nivel q es (L, K) = (q e^x / x, q e^x / x^2), x > 0.
%   Línea de contorno superior: PMg_K = 0 en x = 1 (K = L); RMST = infinito; tangente vertical.
%   Línea de contorno inferior: PMg_L = 0 en x = 2 (K = L/2); RMST = 0; tangente horizontal.
%   Región económica: 1 <= L/K <= 2 (sombreada).
%   Corto plazo con K fijo = 1,2: M = (1,2; 1,2) en la línea superior (q = 1,2 e^{-1} = 0,441, máx. PMe = óptimo técnico);
%   T = (2,4; 1,2) en la inferior (q = 4,8 e^{-2} = 0,650, máximo técnico).
%   Isocuantas dibujadas: q = 0,441 (pasa por M), 0,650 (pasa por T) y 0,95.
% Sustituye a RegionEconomica_CP_CASSEL.png y RMST_CP_CP.png del tema antiguo.
% Segunda pasada (26/10/2026): se resalta el tramo MT (región económica a corto plazo) y se rotula la isocuanta de T;
% el sombreado sigue siendo el cono completo, porque la región se define con todos los factores variables.
% Glosario (26/10/2026): M = óptimo técnico y T = máximo técnico, como en la figura de la región de explotación del 3.A.12.
% Generar con: bash Code/generar_figura.sh anx_region
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1.45cm, y=1.45cm]
  \begin{scope}
    \clip (0,0) rectangle (4.6,3.9);
    \fill[black!10] (0,0) -- (3.9,3.9) -- (4.6,3.9) -- (4.6,2.3) -- cycle;
    \foreach \q in {0.441, 0.650, 0.95} {
      \draw[very thick] plot[domain=0.25:4.2, samples=120, variable=\t] ({\q*exp(\t)/\t},{\q*exp(\t)/(\t*\t)});
    }
    \draw[thick, dash dot] (0,0) -- (3.9,3.9);
    \draw[thick, dash dot] (0,0) -- (4.6,2.3);
    \draw[dashed] (0,1.2) -- (4.6,1.2);
  \end{scope}
  \draw[->] (0,0) -- (4.85,0) node[below] {$L$};
  \draw[->] (0,0) -- (0,4.05) node[left] {$K$};
  \node[above, rotate=45] at (3.25,3.25) {$PMg_K=0$};
  \node[below, rotate=26.57] at (4.0,2.0) {$PMg_L=0$};
  \node[left] at (0,1.2) {$\bar K$};
  % tramo AB: la región económica a corto plazo; la isocuanta que pasa por B es el máximo que permite Kbar
  \draw[line width=2.2pt] (1.2,1.2) -- (2.4,1.2);
  \node[above] at (2.074,3.9) {$q_{\max}(\bar K)$};
  \fill (1.2,1.2) circle (1.4pt) node[above left] {$M$};
  \fill (2.4,1.2) circle (1.4pt) node[below right] {$T$};
\end{tikzpicture}
