% Figura (bloque 2, «Productividad media»): la productividad media como pendiente del radio, sobre la misma curva
% y en los mismos puntos que la figura de la productividad marginal (b2_pmg) (segunda pasada, 26/10/2026).
% Curva q = 1,6 L^{0,6}.
%   L_0 = 1,2: q = 1,785; PMe = 1,4875 (radio q = 1,4875 L); PMg = 0,8925 (tangente, más plana que el radio).
%   L_1 = 3,4: q = 3,336; PMe = 0,981 (radio q = 0,981 L): el radio se aplana, la media cae.
%   Elasticidad del producto = PMg / PMe = 0,6 en todos los puntos (menor que uno).
% Escala: 1 unidad = 1 cm.
% Generar con: bash Code/generar_figura.sh b2_pme
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  \draw[->] (0,0) -- (4.9,0) node[below] {$L$};
  \draw[->] (0,0) -- (0,4.4) node[left] {$q$};
  \draw[very thick] plot[domain=0:4.4, samples=70] (\x,{1.6*(\x)^0.6}) node[below right] {$f(\bar K,L)$};
  % radios desde el origen
  \draw[densely dotted, thick] (0,0) -- (2.75,4.09) node[above] {$PMe_L(L_0)$};
  \draw[densely dotted, thick] (0,0) -- (4.4,4.316) node[above right=-2pt] {$PMe_L(L_1)$};
  % tangente en L_0, para comparar
  \draw[dashed] (0.3,0.982) -- (2.4,2.856) node[right] {$PMg_L(L_0)$};
  % puntos y referencias en el eje
  \draw[dotted] (1.2,1.785) -- (1.2,0) node[below] {$L_0$};
  \draw[dotted] (3.4,3.336) -- (3.4,0) node[below] {$L_1$};
  \fill (1.2,1.785) circle (1.4pt);
  \fill (3.4,3.336) circle (1.4pt);
\end{tikzpicture}
