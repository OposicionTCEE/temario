% Figura (bloque 2, «Productividad media»): la productividad media como pendiente del radio, sobre la misma curva
% y en los mismos puntos que la figura de la productividad marginal (b2_pmg) (segunda pasada, 26/10/2026).
% Curva q = 3,6 (1 - e^{-0,55 L}).
%   L_a = 1,2: q = 1,739; PMe = 1,449 (radio q = 1,449 L); PMg = 1,0235 (tangente, más plana que el radio).
%   L_b = 3,6: q = 3,103; PMe = 0,862 (radio q = 0,862 L): el radio se aplana, la media cae.
%   Elasticidad del producto = PMg / PMe: 0,71 en L_a y 0,32 en L_b (siempre menor que uno).
% Escala: 1 unidad = 1 cm.
% Glosario (26/10/2026): L_a y L_b (no L_0 y L_1), porque L_1 es la inflexión en el bloque 3 y en el anexo III.
% Generar con: bash Code/generar_figura.sh b2_pme
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  \draw[->] (0,0) -- (4.9,0) node[below] {$L$};
  \draw[->] (0,0) -- (0,4.2) node[left] {$q$};
  \draw[very thick] plot[domain=0:4.5, samples=70] (\x,{3.6*(1-exp(-0.55*\x))}) node[below right] {$f(\bar K,L)$};
  % radios desde el origen
  \draw[densely dotted, thick] (0,0) -- (2.6,3.767) node[above] {$PMe_L(L_a)$};
  \draw[densely dotted, thick] (0,0) -- (4.4,3.793) node[above right=-2pt] {$PMe_L(L_b)$};
  % tangente en L_0, para comparar
  \draw[dashed] (0.4,0.920) -- (2.9,3.479) node[right] {$PMg_L$};
  % puntos y referencias en el eje
  \draw[dotted] (1.2,1.739) -- (1.2,0) node[below] {$L_a$};
  \draw[dotted] (3.6,3.103) -- (3.6,0) node[below] {$L_b$};
  \fill (1.2,1.739) circle (1.4pt);
  \fill (3.6,3.103) circle (1.4pt);
\end{tikzpicture}
