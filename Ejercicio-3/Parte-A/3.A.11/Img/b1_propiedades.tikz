% Figura (bloque 1, «Relaciones entre las propiedades»): cómo se relacionan la divisibilidad, la aditividad, la convexidad y la inacción.
% Divisibilidad (rendimientos no crecientes) + aditividad <=> cono convexo (MAS-COLELL, WHINSTON y GREEN, 1995, apartado 5.B).
% Cono convexo => convexidad. Convexidad + inacción => divisibilidad (MWG, 5.B).
% Convexidad + inacción => sección de un cono convexo con un bien más, el factor oculto (McKENZIE, 1959): flecha discontinua.
% Generar con: bash Code/generar_figura.sh b1_propiedades
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=5pt]},
    caja/.style={draw, thick, rounded corners=2pt, align=center, minimum width=3.7cm, minimum height=1.05cm, inner sep=4pt}]
  \node[caja] (D) at (0,0) {\textbf{Divisibilidad}\\ (rendimientos no crecientes)};
  \node[caja] (C) at (8.2,0) {\textbf{Convexidad}};
  \node[caja] (K) at (4.1,-3.0) {\textbf{Cono convexo}\\ (rendimientos constantes)};
  % convexidad + inacción => divisibilidad
  \draw[->, thick] (C.west) -- node[above] {$+$ inacción} (D.east);
  % divisibilidad + aditividad <=> cono convexo
  \draw[<->, thick] (D.south) -- node[left=6pt] {$+$ aditividad} (K.west);
  % cono convexo => convexidad
  \draw[->, thick] (K.east) -- (C.south);
  % McKENZIE: convexidad + inacción => cono convexo con un factor más
  \draw[->, thick, dashed] (C.south east) to[out=-60, in=0, looseness=1.1] (K.south east);
  \node[anchor=west, align=left] at (10.7,-1.55) {$+$ inacción\\ y factor oculto};
\end{tikzpicture}
