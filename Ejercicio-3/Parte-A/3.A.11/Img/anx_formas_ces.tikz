% Figura (Anexo II, «La CES y sus casos límite»): isocuantas q = 1 de la familia CES con delta = 1/2 normalizada en (1, 1),
% donde todas tienen pendiente -1: [0,5 K^{-rho} + 0,5 L^{-rho}]^{-1/rho} = 1.
% sigma = 0 (LEONTIEF): ángulo recto en (1, 1). sigma = 1/2 (rho = 1): K = L / (2L - 1). sigma = 1 (COBB-DOUGLAS): K = 1/L.
% sigma = 2 (rho = -1/2): K = (2 - L^{1/2})^2, corta los ejes en 4. sigma = infinito (lineal): K = 2 - L.
% Escala: 1 unidad = 1,25 cm. Sustituye a FP_CES.png, COBB-DOUGLAS_FP.png y al panel de isocuantas de FP_LEONTIEFF.png del tema antiguo.
% Generar con: bash Code/generar_figura.sh anx_formas_ces
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1.25cm, y=1.25cm]
  \draw[->] (0,0) -- (4.5,0) node[below] {$L$};
  \draw[->] (0,0) -- (0,4.4) node[left] {$K$};
  \draw[very thick] (1,4.1) -- (1,1) -- (4.1,1) node[right] {$\sigma=0$};
  \draw[thick] plot[domain=0.567:4.1, samples=80] (\x,{\x/(2*\x-1)}) node[right] {$\sigma=1/2$};
  \draw[thick, dashed] plot[domain=0.245:4.1, samples=80] (\x,{1/\x}) node[right] {$\sigma=1$};
  \draw[thick] plot[domain=0:4, samples=80] (\x,{(2-sqrt(\x))^2}) node[below] {$\sigma=2$};
  \draw[thick, densely dotted] (0,2) -- (2,0) node[below] {$\sigma=\infty$};
  \fill (1,1) circle (1.4pt);
\end{tikzpicture}
