% Figura (Anexo I, «Eliminación gratuita»): un factor y un producto.
% (a) Con eliminación gratuita: frontera y_2 = 1,5 z^{0,6}; el plan y = (-1,6; 1,989) y todo lo que queda a su suroeste son factibles.
% (b) Con congestión: frontera y_2 = g(z) = 1,9 z (3,2 - z) / 2,56, máxima en z* = 1,6 (g = 1,9) y decreciente después; con
%     eliminación gratuita la frontera seguiría horizontal desde z* (discontinua).
% Generar con: bash Code/generar_figura.sh anx_eliminacion
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  \def\S{7.2}
  % ---------------- (a) Con eliminación gratuita ----------------
  \node[font=\footnotesize\bfseries] at (-1.4,3.35) {(a) Con eliminación gratuita};
  \fill[black!12] (0,0) -- plot[domain=0:3, samples=60] ({-\x},{1.5*(\x)^0.6}) -- (-3,-1.0) -- (0,-1.0) -- cycle;
  \fill[black!28] (-1.6,1.989) -- (-3,1.989) -- (-3,-1.0) -- (-1.6,-1.0) -- cycle;
  \draw[->] (-3.3,0) -- (1.0,0) node[below] {$y_1$};
  \draw[->] (0,-1.1) -- (0,3.0) node[left] {$y_2$};
  \draw[very thick] plot[domain=0:3, samples=60] ({-\x},{1.5*(\x)^0.6});
  \draw[dashed] (-1.6,1.989) -- (-3,1.989);
  \draw[dashed] (-1.6,1.989) -- (-1.6,-1.0);
  \fill (-1.6,1.989) circle (1.4pt) node[above right] {$y$};
  \node at (-2.35,0.55) {$y'\le y$};
  % ---------------- (b) Con congestión ----------------
  \begin{scope}[xshift=\S cm]
    \node[font=\footnotesize\bfseries] at (-1.4,3.35) {(b) Con congestión};
    \fill[black!12] (0,0) -- plot[domain=0:3, samples=60] ({-\x},{1.9*\x*(3.2-\x)/2.56}) -- (-3,-1.0) -- (0,-1.0) -- cycle;
    \draw[->] (-3.3,0) -- (1.0,0) node[below] {$y_1$};
    \draw[->] (0,-1.1) -- (0,3.0) node[left] {$y_2$};
    \draw[very thick] plot[domain=0:3, samples=60] ({-\x},{1.9*\x*(3.2-\x)/2.56});
    \draw[dashed] (-1.6,1.9) -- (-3,1.9);
    \draw[dotted] (-1.6,1.9) -- (-1.6,0);
    \node[below] at (-1.6,0) {$-z^{*}$};
    \node at (-0.6,-0.6) {$Y$};
  \end{scope}
\end{tikzpicture}
