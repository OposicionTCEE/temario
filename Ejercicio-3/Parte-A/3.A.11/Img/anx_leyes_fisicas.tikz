% Figura (Anexo I, «Leyes físicas»): irreversibilidad. Tecnología de un proceso proporcional: frontera y_2 = -1,1 y_1.
% (a) Irreversible: Y = {y_1 <= 0, y_2 <= -1,1 y_1}; el plan y = (-1,6; 1,76) es factible y su inverso -y = (1,6; -1,76) no.
% (b) Reversible: Y = {y_2 <= -1,1 y_1} (semiplano); y y -y son factibles. En ambos, el cuadrante positivo solo toca Y en el origen.
% Recoge la comparación SEGURA / MAS-COLELL de la figura CPP_Axiomas.png del tema antiguo.
% Generar con: bash Code/generar_figura.sh anx_leyes_fisicas
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  \def\S{7.4}
  \foreach \i/\titulo in {0/{(a) Irreversible: $-y\notin Y$}, 1/{(b) Reversible: $-y\in Y$}} {
    \begin{scope}[xshift=\i*\S cm]
      \node[font=\footnotesize\bfseries] at (0,3.45) {\titulo};
    \end{scope}
  }
  % ---------------- (a) ----------------
  \fill[black!12] (0,0) -- (-2.8,3.08) -- (-2.8,-2.4) -- (0,-2.4) -- cycle;
  \draw[->] (-3.1,0) -- (2.6,0) node[below] {$y_1$};
  \draw[->] (0,-2.5) -- (0,3.1) node[left] {$y_2$};
  \draw[very thick] (0,0) -- (-2.8,3.08);
  \draw[dashed] (-1.6,1.76) -- (1.6,-1.76);
  \fill (-1.6,1.76) circle (1.4pt) node[left] {$y$};
  \draw[fill=white] (1.6,-1.76) circle (1.6pt) node[right] {$-y$};
  \node at (-1.9,-1.2) {$Y$};
  % ---------------- (b) ----------------
  \begin{scope}[xshift=\S cm]
    \fill[black!12] (-2.8,3.08) -- (2.2,-2.42) -- (2.2,-2.5) -- (-2.8,-2.5) -- cycle;
    \draw[->] (-3.1,0) -- (2.6,0) node[below] {$y_1$};
    \draw[->] (0,-2.5) -- (0,3.1) node[left] {$y_2$};
    \draw[very thick] (-2.8,3.08) -- (2.2,-2.42);
    \fill (-1.6,1.76) circle (1.4pt) node[left] {$y$};
    \fill (1.6,-1.76) circle (1.4pt) node[left] {$-y$};
    \node at (-1.9,-1.2) {$Y$};
  \end{scope}
\end{tikzpicture}
