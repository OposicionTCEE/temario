% Figura (Anexo III, «La ley de las proporciones variables»): producto total, PMg y PMe con un factor fijo.
% Tecnología con rendimientos constantes q = (L^2/K) e^{-L/K}, con K fijo = 1: q = L^2 e^{-L}.
%   Inflexión (máx. PMg) en L = 2 - sqrt(2) = 0,586 (q = 0,191; PMg = 0,461).
%   Máx. PMe en L = 1 (PMe = PMg = e^{-1} = 0,368; q = 0,368): óptimo técnico; el radio q = 0,368 L es tangente.
%   Máx. producto en L = 2 (q = 4 e^{-2} = 0,541; PMg = 0): máximo técnico. Después PMg < 0.
%   PMe = L e^{-L}; PMg = (2L - L^2) e^{-L}.
% Escala: L, 1 unidad = 1,6 cm; q, PMe y PMg, 1 unidad = 6 cm; el panel superior se desplaza 4,5 cm (0,75 unidades).
% Sustituye a Grafico_CP_FP_CASSEL.png, InflexionA_FP_CASSEL.png y FASES_CASSEL.png del tema antiguo.
% Generar con: bash Code/generar_figura.sh anx_fases
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1.6cm, y=6cm]
  % ---------------- Panel superior: producto total ----------------
  \begin{scope}[yshift=4.5cm]
    \draw[->] (0,0) -- (4.75,0) node[below] {$L$};
    \draw[->] (0,0) -- (0,0.66) node[left] {$q$};
    \draw[very thick] plot[domain=0:4.5, samples=80] (\x,{\x*\x*exp(-\x)}) node[above] {$f(\bar K,L)$};
    \draw[densely dotted, thick] (0,0) -- (1.55,0.570);
    \fill (0.586,0.191) circle (1.2pt);
    \fill (1,0.368) circle (1.2pt);
    \fill (2,0.541) circle (1.2pt);
  \end{scope}
  % ---------------- Panel inferior: PMg y PMe ----------------
  \draw[->] (0,0) -- (4.75,0) node[below] {$L$};
  \draw[->] (0,-0.17) -- (0,0.55) node[left] {$PMg_L,\ PMe_L$};
  \draw[very thick] plot[domain=0:4.5, samples=80] (\x,{\x*exp(-\x)}) node[above] {$PMe_L$};
  \draw[very thick, dashed] plot[domain=0:4.5, samples=80] (\x,{(2*\x-\x*\x)*exp(-\x)}) node[below] {$PMg_L$};
  \fill (0.586,0.461) circle (1.2pt);
  \fill (1,0.368) circle (1.2pt);
  \fill (2,0) circle (1.2pt);
  % líneas verticales comunes
  \draw[dotted] (0.586,0) -- (0.586,0.75+0.191);
  \draw[dashed] (1,-0.17) -- (1,0.75+0.62) node[above] {óptimo técnico};
  \draw[dashed] (2,-0.17) -- (2,0.75+0.62) node[above] {máximo técnico};
  \node[below] at (0.586,-0.01) {$L_1$};
  \node[below left] at (1,-0.01) {$L_2$};
  \node[below left] at (2,-0.01) {$L_3$};
  % fases
  \node at (0.5,0.52) {Fase I};
  \node at (1.5,0.52) {Fase II};
  \node at (3.3,0.52) {Fase III};
\end{tikzpicture}
