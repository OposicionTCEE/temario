% Figura (Anexo I, «Planes de producción y conjunto de producción»): conjunto de producción Y con un factor (y_1 < 0) y un producto (y_2 > 0).
% Frontera: y_2 = 1,5 z^{0,6} con z = -y_1 en [0, 4]. Con eliminación gratuita, Y contiene todo lo que queda por debajo y a la izquierda.
% Plan eficiente y* = (-2; 2,274); plan ineficiente y = (-2; 1,1).
% Sustituye, junto con anx_leyes_fisicas, a la figura CPP_Axiomas.png del tema antiguo.
% Generar con: bash Code/generar_figura.sh anx_conjunto
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  \fill[black!12] (0,0) -- plot[domain=0:4, samples=60] ({-\x},{1.5*(\x)^0.6}) -- (-4,-1.2) -- (0,-1.2) -- cycle;
  \draw[->] (-4.5,0) -- (1.2,0) node[below] {$y_1$};
  \draw[->] (0,-1.3) -- (0,3.8) node[left] {$y_2$};
  \draw[very thick] plot[domain=0:4, samples=60] ({-\x},{1.5*(\x)^0.6});
  \node at (-3.1,1.0) {$Y$};
  \draw[dashed] (-2,2.274) -- (-2,0);
  \draw[dashed] (-2,2.274) -- (0,2.274) node[right] {$q^{*}$};
  \node[below right] at (-2,0) {$-z$};
  \fill (-2,2.274) circle (1.4pt) node[above right] {$y^{*}$};
  \fill (-2,1.1) circle (1.4pt) node[left] {$y$};
  \node[below right] at (0,0) {$0$};
\end{tikzpicture}
