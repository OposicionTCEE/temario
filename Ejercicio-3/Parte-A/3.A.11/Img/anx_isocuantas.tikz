% Figura (Anexo II, «Isocuantas»): superficie de producción q = 1,2 (K L)^{1/2} y sus curvas de nivel.
% (a) Superficie para K, L en [0, 4], con las curvas de nivel q = 1,2; 2,4; 3,6 (K L = 1, 4, 9) sobre ella y proyectadas en el plano.
% (b) Mapa de isocuantas en el plano (L, K): K = c / L con c = 1, 4, 9; q_1 < q_2 < q_3.
% Sustituye a la figura FPNCB_Tipos_Isocuantas.png del tema antiguo.
% Generar con: bash Code/generar_figura.sh anx_isocuantas
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  \node[font=\footnotesize\bfseries] at (3.3,5.15) {(a) La superficie de producción};
  \begin{axis}[at={(0,0)}, width=7.6cm, height=6.4cm, view={125}{28},
      axis lines=left, ticks=none, xmin=0, xmax=4.3, ymin=0, ymax=4.3, zmin=0, zmax=5.2,
      xlabel={$L$}, ylabel={$K$}, zlabel={$q$},
      colormap={gris}{gray(0cm)=(0.93); gray(1cm)=(0.72)}]
    \addplot3[surf, faceted color=black!35, samples=17, domain=0:4, y domain=0:4] {1.2*sqrt(x*y)};
    \foreach \c in {1,4,9} {
      \addplot3[very thick, domain={\c/4}:4, samples=50, samples y=0] (x, {\c/x}, {1.2*sqrt(\c)});
      \addplot3[dashed, domain={\c/4}:4, samples=50, samples y=0] (x, {\c/x}, 0);
    }
  \end{axis}
  % ---------------- (b) Mapa de isocuantas ----------------
  \begin{scope}[xshift=8.9cm, yshift=0.35cm]
    \node[font=\footnotesize\bfseries] at (2.0,4.8) {(b) El mapa de isocuantas};
    \draw[->] (0,0) -- (4.4,0) node[below] {$L$};
    \draw[->] (0,0) -- (0,4.4) node[left] {$K$};
    \foreach \c/\et in {1/{$q_1$}, 4/{$q_2$}, 9/{$q_3$}} {
      \draw[very thick] plot[domain={max(0.25,\c/4.2)}:4.1, samples=60] (\x,{\c/\x}) node[right] {\et};
    }
    \node at (2.0,-0.75) {$q_1<q_2<q_3$};
  \end{scope}
\end{tikzpicture}
