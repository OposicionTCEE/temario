% Figura (Anexo II, «La frontera con varios productos»): curvas de transformación P(z) para dos cantidades de factores, z_1 > z_0.
% P(z_0): cuarto de elipse de semiejes 2,6 (q_1) y 2,3 (q_2); P(z_1): semiejes 3,6 y 3,2.
% Punto A sobre P(z_0) con ángulo t = 40°: A = (2,6 cos 40°; 2,3 sin 40°) = (1,992; 1,478).
% Pendiente en A: dq_2/dq_1 = -(2,3/2,6) cot(40°) = -1,054; la RMT es su valor absoluto.
% Sustituye al «INCLUIR GRÁFICOS RELACIONES» del tema antiguo.
% Generar con: bash Code/generar_figura.sh anx_transformacion
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  \fill[black!10] (0,0) -- plot[domain=90:0, samples=60] ({2.6*cos(\x)},{2.3*sin(\x)}) -- cycle;
  \draw[->] (0,0) -- (4.3,0) node[below] {$q_1$};
  \draw[->] (0,0) -- (0,3.8) node[left] {$q_2$};
  \draw[very thick] plot[domain=90:0, samples=60] ({2.6*cos(\x)},{2.3*sin(\x)}) node[below] {$P(z_0)$};
  \draw[thick, dashed] plot[domain=90:0, samples=60] ({3.6*cos(\x)},{3.2*sin(\x)}) node[below] {$P(z_1)$};
  \draw[densely dotted] (1.2,2.313) -- (2.9,0.521);
  \fill (1.992,1.478) circle (1.4pt) node[above right] {$A$};
  \node at (2.1,-0.75) {$z_1>z_0$};
\end{tikzpicture}
