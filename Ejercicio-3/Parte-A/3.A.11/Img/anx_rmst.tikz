% Figura (Anexo II, «Relación marginal de sustitución técnica»): RMST_{LK} = -dK/dL a lo largo de una isocuanta.
% (a) Isocuanta convexa K = 4 / L. En A (L = 1; K = 4) la pendiente es -4; en B (L = 3,2; K = 1,25), -0,39: la RMST decrece.
% (b) Isocuanta no convexa: K = 0,3 + 3,5 (1 - u^2)^{1/2} con u = (L - 0,3) / 3,5. En A (L = 1,2; K = 3,682) la pendiente es -0,266;
%     en B (L = 3,0; K = 2,527), -1,212: la RMST crece.
% Generar con: bash Code/generar_figura.sh anx_rmst
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  \def\S{7.2}
  % ---------------- (a) Isocuanta convexa ----------------
  \node[font=\footnotesize\bfseries] at (2.1,4.85) {(a) Isocuanta convexa};
  \draw[->] (0,0) -- (4.5,0) node[below] {$L$};
  \draw[->] (0,0) -- (0,4.6) node[left] {$K$};
  \draw[very thick] plot[domain=0.9:4.2, samples=60] (\x,{4/\x});
  \draw[dashed] (0.85,4.6) -- (1.55,1.8);
  \draw[dashed] (1.9,1.758) -- (4.4,0.781);
  \fill (1,4) circle (1.4pt) node[right] {$A$};
  \fill (3.2,1.25) circle (1.4pt) node[above right] {$B$};
  \node at (2.1,-0.8) {$RMST_{LK}(A)>RMST_{LK}(B)$};
  % ---------------- (b) Isocuanta no convexa ----------------
  \begin{scope}[xshift=\S cm]
    \node[font=\footnotesize\bfseries] at (2.1,4.85) {(b) Isocuanta no convexa};
    \draw[->] (0,0) -- (4.5,0) node[below] {$L$};
    \draw[->] (0,0) -- (0,4.6) node[left] {$K$};
    \draw[very thick] plot[domain=0:89, samples=60] ({0.3+3.5*sin(\x)},{0.3+3.5*cos(\x)});
    \draw[dashed] (0.3,3.921) -- (2.3,3.389);
    \draw[dashed] (2.4,3.254) -- (3.6,1.800);
    \fill (1.2,3.682) circle (1.4pt) node[below left] {$A$};
    \fill (3.0,2.527) circle (1.4pt) node[below left] {$B$};
    \node at (2.1,-0.8) {$RMST_{LK}(A)<RMST_{LK}(B)$};
  \end{scope}
\end{tikzpicture}
