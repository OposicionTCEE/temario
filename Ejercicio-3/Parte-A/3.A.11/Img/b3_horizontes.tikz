% Figura (bloque 3, «Los horizontes temporales»): qué se mueve en el mapa de isocuantas en cada horizonte.
% Isocuantas K = c / L con c = 1; 2,2; 3,8 (paneles a y b).
% (a) Corto plazo: recta K = Kbar = 1,2; cortes con las isocuantas en L = c / 1,2 = 0,833; 1,833; 3,167.
% (b) Largo plazo: radio K = L; cortes en L = c^{1/2} = 1; 1,483; 1,949.
% (c) Muy largo plazo: la isocuanta de un mismo nivel pasa de K = 2,2 / L (t_0) a K = 1,2 / L (t_1); en el radio K = L,
%     de (1,483; 1,483) a (1,095; 1,095).
% Escala: 1 unidad = 1,05 cm; paneles separados 5,3 cm. Sustituye a la inexistente Esquema_TiempoProduccion.png del tema antiguo.
% Generar con: bash Code/generar_figura.sh b3_horizontes
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1.05cm, y=1.05cm]
  \foreach \i/\titulo/\cond in {0/{(a) Corto plazo}/{$K=\bar K$}, 1/{(b) Largo plazo}/{$z\to\lambda z$, \ $\lambda>1$}, 2/{(c) Muy largo plazo}/{$t_1>t_0$}} {
    \begin{scope}[xshift=\i*5.3cm]
      \node[font=\footnotesize\bfseries] at (1.9,4.05) {\titulo};
      \draw[->] (0,0) -- (3.9,0) node[below] {$L$};
      \draw[->] (0,0) -- (0,3.6) node[left] {$K$};
      \node at (1.9,-0.62) {\cond};
    \end{scope}
  }
  % ---------------- (a) Corto plazo ----------------
  \foreach \c in {1.0, 2.2, 3.8} {
    \draw[thick] plot[domain={\c/3.4}:3.6, samples=60] (\x,{\c/\x});
  }
  \draw[dashed, ->] (0,1.2) -- (3.75,1.2);
  \node[left] at (0,1.2) {$\bar K$};
  \foreach \l in {0.833, 1.833, 3.167} { \fill (\l,1.2) circle (1.4pt); }
  % ---------------- (b) Largo plazo ----------------
  \begin{scope}[xshift=5.3cm]
    \foreach \c in {1.0, 2.2, 3.8} {
      \draw[thick] plot[domain={\c/3.4}:3.6, samples=60] (\x,{\c/\x});
    }
    \draw[dashed, ->] (0,0) -- (2.9,2.9);
    \foreach \l in {1.0, 1.483, 1.949} { \fill (\l,\l) circle (1.4pt); }
  \end{scope}
  % ---------------- (c) Muy largo plazo ----------------
  \begin{scope}[xshift=10.6cm]
    \draw[very thick] plot[domain={2.2/3.4}:3.6, samples=60] (\x,{2.2/\x}) node[right] {$t_0$};
    \draw[thick, dashed] plot[domain={1.2/3.4}:3.6, samples=60] (\x,{1.2/\x}) node[right] {$t_1$};
    \draw[dotted] (0,0) -- (2.6,2.6);
    \draw[->, thick] (1.43,1.43) -- (1.14,1.14);
  \end{scope}
\end{tikzpicture}
