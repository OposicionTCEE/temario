% Figura (Anexo II, «Conjunción técnica y no conjunción»): frontera de dos productos con unos factores dados.
% (a) Conjunta en proporciones fijas: q_1 = alpha x, q_2 = beta x, con x <= g(z): rectángulo con vértice en (2,4; 1,8).
% (b) Separable con rendimientos decrecientes: q_1 = z_1^{1/2}, q_2 = (z - z_1)^{1/2}, z = 6,25: q_1^2 + q_2^2 = 6,25 (cuarto de círculo de radio 2,5).
% (c) Separable con rendimientos constantes y un solo factor: q_1 / a + q_2 / b = z: recta de (0; 2,4) a (2,8; 0).
% Corrige la afirmación del tema antiguo de que las tecnologías separables dan siempre una frontera recta.
% Generar con: bash Code/generar_figura.sh anx_conjuncion
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  \def\S{5.3}
  % ---------------- (a) Proporciones fijas ----------------
  \node[font=\footnotesize\bfseries, align=center] at (1.6,3.55) {(a) Conjunta en\\proporciones fijas};
  \fill[black!10] (0,0) -- (0,1.8) -- (2.4,1.8) -- (2.4,0) -- cycle;
  \draw[->] (0,0) -- (3.4,0) node[below] {$q_1$};
  \draw[->] (0,0) -- (0,3.0) node[left] {$q_2$};
  \draw[very thick] (0,1.8) -- (2.4,1.8) -- (2.4,0);
  \draw[dashed] (0,0) -- (2.4,1.8);
  \fill (2.4,1.8) circle (1.4pt);
  % ---------------- (b) Separable, rendimientos decrecientes ----------------
  \begin{scope}[xshift=\S cm]
    \node[font=\footnotesize\bfseries, align=center] at (1.6,3.55) {(b) Separable, rendimientos\\decrecientes};
    \fill[black!10] (0,0) -- plot[domain=90:0, samples=60] ({2.5*cos(\x)},{2.5*sin(\x)}) -- cycle;
    \draw[->] (0,0) -- (3.4,0) node[below] {$q_1$};
    \draw[->] (0,0) -- (0,3.0) node[left] {$q_2$};
    \draw[very thick] plot[domain=90:0, samples=60] ({2.5*cos(\x)},{2.5*sin(\x)});
  \end{scope}
  % ---------------- (c) Separable, rendimientos constantes ----------------
  \begin{scope}[xshift=2*\S cm]
    \node[font=\footnotesize\bfseries, align=center] at (1.6,3.55) {(c) Separable, rendimientos\\constantes y un factor};
    \fill[black!10] (0,0) -- (0,2.4) -- (2.8,0) -- cycle;
    \draw[->] (0,0) -- (3.4,0) node[below] {$q_1$};
    \draw[->] (0,0) -- (0,3.0) node[left] {$q_2$};
    \draw[very thick] (0,2.4) -- (2.8,0);
  \end{scope}
\end{tikzpicture}
