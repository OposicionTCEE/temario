% Figura (Anexo I, «Aditividad, divisibilidad y cono convexo»): dos procesos de proporciones fijas, A (z_2 = 2 z_1) y B (z_2 = 0,4 z_1),
% en el espacio de los factores, para una cantidad dada de producto: a = (0,9; 1,8) y b = (2,5; 1,0); punto medio m = (1,7; 1,4).
% (a) Sin aditividad: V(q) es la unión de los dos ortantes {z >= a} y {z >= b} (no convexa); m no es factible.
% (b) Con aditividad y divisibilidad: V(q) es la envolvente convexa; la isocuanta es la línea quebrada que pasa por a y b.
% Generar con: bash Code/generar_figura.sh anx_cono
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  \def\S{6.6}
  % ---------------- (a) Sin aditividad ----------------
  \node[font=\footnotesize\bfseries] at (1.9,3.95) {(a) Sin aditividad};
  \fill[black!12] (0.9,3.4) -- (0.9,1.8) -- (2.5,1.8) -- (2.5,1.0) -- (3.8,1.0) -- (3.8,3.4) -- cycle;
  \draw[->] (0,0) -- (4.2,0) node[below] {$z_1$};
  \draw[->] (0,0) -- (0,3.6) node[left] {$z_2$};
  \draw[dashed] (0,0) -- (1.65,3.3) node[above] {$A$};
  \draw[dashed] (0,0) -- (4.0,1.6) node[right] {$B$};
  \draw[very thick] (0.9,3.4) -- (0.9,1.8) -- (2.5,1.8) -- (2.5,1.0) -- (3.8,1.0);
  \draw[densely dotted] (0.9,1.8) -- (2.5,1.0);
  \fill (0.9,1.8) circle (1.4pt) node[left] {$a$};
  \fill (2.5,1.0) circle (1.4pt) node[below] {$b$};
  \draw[fill=white] (1.7,1.4) circle (1.6pt) node[below left] {$m$};
  % ---------------- (b) Con aditividad y divisibilidad ----------------
  \begin{scope}[xshift=\S cm]
    \node[font=\footnotesize\bfseries] at (1.9,3.95) {(b) Con aditividad y divisibilidad};
    \fill[black!12] (0.9,3.4) -- (0.9,1.8) -- (2.5,1.0) -- (3.8,1.0) -- (3.8,3.4) -- cycle;
    \draw[->] (0,0) -- (4.2,0) node[below] {$z_1$};
    \draw[->] (0,0) -- (0,3.6) node[left] {$z_2$};
    \draw[dashed] (0,0) -- (1.65,3.3) node[above] {$A$};
    \draw[dashed] (0,0) -- (4.0,1.6) node[right] {$B$};
    \draw[very thick] (0.9,3.4) -- (0.9,1.8) -- (2.5,1.0) -- (3.8,1.0);
    \fill (0.9,1.8) circle (1.4pt) node[left] {$a$};
    \fill (2.5,1.0) circle (1.4pt) node[below] {$b$};
    \fill (1.7,1.4) circle (1.4pt) node[below left] {$m$};
  \end{scope}
\end{tikzpicture}
