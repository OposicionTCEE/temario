% Figura (Anexo II, «Definición y significado» de la elasticidad de sustitución). Isocuantas CES con delta = 1/2 que pasan por (1, 1).
% En las dos, la RMST pasa de 2 (en A) a 1/2 (en B); como RMST = (K/L)^{1/sigma}, la proporción K/L pasa de 2^sigma a 2^{-sigma}.
% (a) sigma = 1/2: 1/K + 1/L = 2; A = (0,854; 1,207), B = (1,207; 0,854); K/L de 1,414 a 0,707 (el radio gira poco).
% (b) sigma = 2: K^{1/2} + L^{1/2} = 2; A = (0,444; 1,778), B = (1,778; 0,444); K/L de 4 a 0,25 (el radio gira mucho).
% Escala: 1 unidad = 1,8 cm. Tangentes de pendiente -2 en A y -1/2 en B.
% Generar con: bash Code/generar_figura.sh anx_sigma
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1.8cm, y=1.8cm]
  \def\S{4.0}
  % ---------------- (a) sigma = 1/2 ----------------
  \node[font=\footnotesize\bfseries] at (1.2,2.75) {(a) $\sigma=1/2$: isocuanta muy curvada};
  \draw[->] (0,0) -- (2.5,0) node[below] {$L$};
  \draw[->] (0,0) -- (0,2.55) node[left] {$K$};
  \draw[very thick] plot[domain=0.615:2.4, samples=80] (\x,{\x/(2*\x-1)});
  \draw[dashed] (0,0) -- (1.42,2.0);
  \draw[dashed] (0,0) -- (2.2,1.556);
  \draw[densely dotted] (0.62,1.675) -- (1.09,0.735);
  \draw[densely dotted] (0.75,1.083) -- (1.85,0.533);
  \fill (0.854,1.207) circle (1.3pt) node[above right=-1pt] {$A$};
  \fill (1.207,0.854) circle (1.3pt) node[above right=-1pt] {$B$};
  % ---------------- (b) sigma = 2 ----------------
  \begin{scope}[xshift=\S]
    \node[font=\footnotesize\bfseries] at (1.2,2.75) {(b) $\sigma=2$: isocuanta poco curvada};
    \draw[->] (0,0) -- (2.5,0) node[below] {$L$};
    \draw[->] (0,0) -- (0,2.55) node[left] {$K$};
    \draw[very thick] plot[domain=0.0:2.4, samples=80] (\x,{(2-sqrt(\x))^2});
    \draw[dashed] (0,0) -- (0.6,2.4);
    \draw[dashed] (0,0) -- (2.4,0.6);
    \draw[densely dotted] (0.15,2.366) -- (0.75,1.166);
    \draw[densely dotted] (1.15,0.758) -- (2.4,0.133);
    \fill (0.444,1.778) circle (1.3pt) node[right] {$A$};
    \fill (1.778,0.444) circle (1.3pt) node[above right=-1pt] {$B$};
  \end{scope}
  \node at ({(\S+2.5)/2},-0.42) {$RMST_{LK}(A)=2$ \qquad $RMST_{LK}(B)=1/2$};
\end{tikzpicture}
