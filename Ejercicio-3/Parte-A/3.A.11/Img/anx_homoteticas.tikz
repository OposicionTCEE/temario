% Figura (Anexo III, «Funciones homotéticas»).
% (a) Isocuantas de una función homotética f = F(g), con g = (K L)^{1/2}: K L = c^2 con c = 0,7; 1,1; 1,5; 2,0; 2,7.
%     A lo largo de cada radio la pendiente de todas las isocuantas es la misma (dK/dL = -K/L): -2 en el radio K = 2L y -1/2
%     en el radio K = L/2. Tangentes cortas de pendiente -2 y -1/2 en los cortes.
% (b) Elasticidad de escala a lo largo de un radio: homogéneas de grado k > 1 (1,5), k = 1 y k < 1 (0,6), constantes;
%     homotética con rendimientos variables (ZELLNER-REVANKAR): epsilon = 3 / (1 + q), igual a 1 en q* = 2.
% Generar con: bash Code/generar_figura.sh anx_homoteticas
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  % ---------------- (a) Mapa homotético ----------------
  \begin{scope}[x=1.3cm, y=1.3cm]
    \node[font=\footnotesize\bfseries] at (1.6,3.45) {(a) Isoclinas rectas};
    \draw[->] (0,0) -- (3.5,0) node[below] {$L$};
    \draw[->] (0,0) -- (0,3.2) node[left] {$K$};
    \foreach \c in {0.7, 1.1, 1.5, 2.0, 2.7} {
      \draw[thick] plot[domain={\c*\c/3.05}:3.3, samples=60] (\x,{\c*\c/\x});
    }
    % cortes con K = 2L: L = c / sqrt(2); con K = L/2: L = c sqrt(2)
    \foreach \c in {0.7, 1.1, 1.5, 2.0} {
      \draw[very thick] ({\c/sqrt(2)-0.16},{sqrt(2)*\c+0.32}) -- ({\c/sqrt(2)+0.16},{sqrt(2)*\c-0.32});
      \draw[very thick] ({sqrt(2)*\c-0.3},{\c/sqrt(2)+0.15}) -- ({sqrt(2)*\c+0.3},{\c/sqrt(2)-0.15});
    }
    \draw[dash dot] (0,0) -- (1.55,3.1);
    \draw[dash dot] (0,0) -- (3.3,1.65);
  \end{scope}
  % ---------------- (b) Elasticidad de escala ----------------
  \begin{scope}[xshift=6.6cm, x=1.55cm, y=1.55cm]
    \node[font=\footnotesize\bfseries] at (2.0,3.15) {(b) Elasticidad de escala por un radio};
    \draw[->] (0,0) -- (4.3,0) node[below] {$q$};
    \draw[->] (0,0) -- (0,2.85) node[left] {$\varepsilon$};
    \draw[dotted] (0,1) node[left] {$1$} -- (4.0,1);
    \draw[thick] (0.2,1.5) -- (4.0,1.5) node[right] {$k>1$};
    \draw[thick] (0.2,1.0) -- (4.0,1.0) node[right] {$k=1$};
    \draw[thick] (0.2,0.6) -- (4.0,0.6) node[right] {$k<1$};
    \draw[very thick, dashed] plot[domain=0.2:4.0, samples=60] (\x,{3/(1+\x)}) node[below right=-1pt] {homotética};
    \draw[dotted] (2,1) -- (2,0) node[below] {$q^{*}$};
    \fill (2,1) circle (1.4pt);
  \end{scope}
\end{tikzpicture}
