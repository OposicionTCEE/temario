% Figura: el margen de COASE (1937) y la frontera de la empresa (bloque 1, plano organizativo).
% (a) equilibrio: coste de organizar una transacción más dentro (creciente) frente al de realizarla en el mercado;
% (b) se abarata organizar (teléfono, técnicas de dirección): la empresa crece;
% (c) se abarata usar el mercado: la empresa se reduce. Curvas ilustrativas, sin datos.
% Generar con: bash Code/generar_figura.sh coase_margen
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  \def\W{4.3}  % ancho de cada eje
  \def\H{2.7}  % alto de cada eje
  \def\S{5.3}  % separación horizontal entre paneles
  \foreach \i/\titulo in {0/{(a) La frontera de la empresa}, 1/{(b) Se abarata organizar}, 2/{(c) Se abarata usar el mercado}} {
    \begin{scope}[xshift=\i*\S cm]
      \draw[->] (0,0) -- (\W,0) node[below left, xshift=2pt] {$n$};
      \draw[->] (0,0) -- (0,\H) node[above] {coste de la transacción marginal};
      \node[font=\footnotesize\bfseries, anchor=south] at (\W/2,\H+0.45) {\titulo};
    \end{scope}
  }
  % (a) Equilibrio.
  \draw[very thick, domain=0.2:3.9, smooth, samples=50] plot (\x, {0.35+0.11*\x*\x}) node[above left, xshift=4pt] {$CMg_T^{\text{emp}}$};
  \draw[very thick] (0.2,1.3) -- (4.0,1.3) node[above left, yshift=-1pt] {$CMg_T^{\text{mdo}}$};
  \draw[dashed] (2.94,1.3) -- (2.94,0) node[below] {$n^{*}$};
  \node[align=center] at (1.35,0.5) {se hace dentro\\ (\textit{make})};
  \node[align=center, anchor=north] at (\W/2,-0.4) {Frontera: organizar una transacción más\\ cuesta lo mismo que comprarla fuera};
  % (b) Se abarata organizar: la curva de la empresa baja y n* aumenta.
  \begin{scope}[xshift=\S cm]
    \draw[very thick, domain=0.2:3.9, smooth, samples=50] plot (\x, {0.35+0.11*\x*\x}) node[above left, xshift=4pt] {$CMg_T^{\text{emp}}$};
    \draw[thick, dashed, domain=0.2:4.05, smooth, samples=50] plot (\x, {0.2+0.07*\x*\x});
    \draw[very thick] (0.2,1.3) -- (4.0,1.3);
    \draw[dashed] (2.94,1.3) -- (2.94,0) node[below] {$n^{*}$};
    \draw[dashed] (3.96,1.3) -- (3.96,0) node[below] {$n^{*\prime}$};
    \draw[->, thick] (2.98,0.42) -- (3.9,0.42);
    \node[align=center, anchor=north] at (\W/2,-0.4) {Teléfono, mejores técnicas de dirección:\\ la empresa crece};
  \end{scope}
  % (c) Se abarata usar el mercado: la recta del mercado baja y n* disminuye.
  \begin{scope}[xshift=2*\S cm]
    \draw[very thick, domain=0.2:3.9, smooth, samples=50] plot (\x, {0.35+0.11*\x*\x});
    \draw[very thick] (0.2,1.3) -- (4.0,1.3) node[above left, yshift=-1pt] {$CMg_T^{\text{mdo}}$};
    \draw[thick, dashed] (0.2,0.75) -- (4.0,0.75);
    \draw[dashed] (2.94,1.3) -- (2.94,0) node[below] {$n^{*}$};
    \draw[dashed] (1.79,0.75) -- (1.79,0) node[below] {$n^{*\prime}$};
    \draw[->, thick] (2.9,0.25) -- (1.85,0.25);
    \node[align=center, anchor=north] at (\W/2,-0.4) {Información y contratación más baratas:\\ la empresa se reduce};
  \end{scope}
\end{tikzpicture}
