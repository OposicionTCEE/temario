% Figura: mercados impugnables (BAUMOL, PANZAR y WILLIG, 1982) y su fragilidad ante los costes hundidos (STIGLITZ, 1987), bloque 2.
% (a) Monopolio natural ilustrativo: CMe = 1 + 4/Q (coste fijo 4, CMg constante 1), demanda P = 5 - 0,6 Q.
%     Monopolio: IMg = CMg -> Q^m = 3,33, P^m = 3 (CMe = 2,2: beneficio). Precio sostenible: mayor corte de D y CMe,
%     Q^s = 5,44, P^s = 1,74 (beneficio nulo). Por encima de P^s, la entrada relámpago (hit and run) es rentable.
% (b) Juego de entrada con un coste hundido S > 0 y competencia en precios tras la entrada. Pagos: (incumbente, entrante).
% Generar con: bash Code/generar_figura.sh impugnables_paneles
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  % (a) Sin costes hundidos.
  \node[font=\footnotesize\bfseries] at (3.5,5.75) {(a) Sin costes hundidos: el precio sostenible};
  \fill[black!15] (0,2.2) rectangle (3.33,3.0);
  \node at (1.6,2.6) {$\Pi^m$};
  \draw[->] (0,0) -- (7.3,0) node[below left] {$Q$};
  \draw[->] (0,0) -- (0,5.4) node[left] {$P$};
  \draw[thick] (0,5) -- (7,0.8) node[above right, xshift=-2pt] {$D$};
  \draw[thick, domain=0.96:6.9, samples=80] plot (\x,{1+4/\x}) node[right] {$CMe$};
  \draw[dashed] (0,1) node[above right] {$CMg$} -- (6.9,1);
  \draw[densely dotted] (0,3.0) node[left] {$P^m$} -- (3.33,3.0) -- (3.33,0) node[below] {$Q^m$};
  \draw[densely dotted] (0,1.74) node[left] {$P^s$} -- (5.44,1.74) -- (5.44,0) node[below] {$Q^s$};
  \fill (5.44,1.74) circle (1.6pt);
  \node[align=left, anchor=west, text width=3.3cm] (hr) at (3.55,4.15) {Si $P>CMe$, un entrante que cobre algo menos gana y sale antes de que el incumbente reaccione (\textit{hit and run})};
  \node[align=center, text width=2.4cm] (ps) at (6.2,3.0) {Sostenible: $P^s=CMe$, beneficio nulo};
  \draw[->] (ps.south) -- (5.5,1.85);
  % (b) Con un coste hundido.
  \begin{scope}[xshift=8.35cm]
    \node[font=\footnotesize\bfseries] at (3.4,5.75) {(b) Con un coste hundido $S>0$};
    \node[draw, rounded corners=2pt, inner sep=3pt] (E) at (3.4,4.75) {Entrante};
    \node[align=center] (NE) at (1.1,3.05) {$(\Pi^m,\ 0)$};
    \node[draw, rounded corners=2pt, align=center, inner sep=3pt] (B) at (5.3,3.05) {Competencia en\\ precios (BERTRAND)};
    \node[align=center] (EB) at (5.3,1.55) {$(\leq 0,\ -S)$};
    \draw[->] (E) -- node[above left, align=center] {No entra} (NE);
    \draw[->] (E) -- node[above right, align=center] {Entra:\\ paga $S$} (B);
    \draw[->] (B) -- node[right, align=left] {$P\to CMe$} (EB);
    \node[anchor=west] at (0,1.55) {Pagos: (incumbente, entrante)};
    \node[align=left, text width=6.6cm, anchor=north west] at (0,0.95) {Tras la entrada, la competencia en precios lleva el precio al coste y el entrante no recupera $S$. Por pequeño que sea $S$, no entra, y el incumbente cobra $P^m$ sin temer la entrada.};
  \end{scope}
\end{tikzpicture}
