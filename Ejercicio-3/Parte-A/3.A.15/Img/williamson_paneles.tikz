% Figura: la teoría de los costes de transacción de WILLIAMSON (bloque 1).
% (a) Esquema: supuestos de conducta y atributos de la transacción -> transformación fundamental -> costes de gobierno -> elección.
% (b) Costes de gobierno de mercado M(k), híbrido X(k) y jerarquía H(k) según la especificidad de los activos k
%     (WILLIAMSON, 1991): M(k)=0,3+0,55k; X(k)=0,7+0,3k; H(k)=1,2+0,1k (ilustrativas). Umbrales k1=1,6 y k2=2,5.
% Generar con: bash Code/generar_figura.sh williamson_paneles
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]},
  caja/.style={draw, rounded corners=2pt, align=center, inner sep=3pt, text width=#1},
  caja/.default=3.1cm]
  % (a) Esquema.
  \node[font=\footnotesize\bfseries] at (3.4,5.75) {(a) De qué dependen los costes};
  \node[caja, anchor=north] (sup) at (1.65,5.35) {\textbf{Supuestos de conducta}\\ racionalidad limitada $\Rightarrow$ contratos incompletos\\ oportunismo $\Rightarrow$ riesgo de expropiación};
  \node[caja, anchor=north] (atr) at (5.15,5.35) {\textbf{Atributos de la transacción}\\ especificidad de los activos ($k$)\\ incertidumbre\\ frecuencia};
  \node[caja=6.6cm, anchor=north] (tf) at (3.4,3.45) {\textbf{Transformación fundamental:} con $k>0$, muchos oferentes \textit{ex ante} se convierten en un monopolio bilateral \textit{ex post}};
  \node[caja=6.6cm, anchor=north] (cg) at (3.4,2.25) {\textbf{Costes de gobierno:} \textit{ex ante} (buscar, negociar, salvaguardas) y \textit{ex post} (regateo, mala adaptación, cumplimiento)};
  \node[caja=6.6cm, anchor=north] (al) at (3.4,1.05) {\textbf{Alineamiento discriminante:} cada transacción, a la estructura que minimiza la suma de costes de producción y de transacción};
  \draw[->] (sup.south) -- (sup.south |- tf.north);
  \draw[->] (atr.south) -- (atr.south |- tf.north);
  \draw[->] (tf) -- (cg);
  \draw[->] (cg) -- (al);
  % (b) Costes de gobierno según la especificidad.
  \begin{scope}[xshift=8.3cm, yshift=0.9cm]
    \node[font=\footnotesize\bfseries] at (3.4,4.85) {(b) Costes de gobierno según $k$};
    \draw[->] (0,0) -- (4.7,0) node[below left, xshift=2pt] {$k$};
    \draw[->] (0,0) -- (0,3.0) node[above] {coste de gobierno};
    \draw[thick] (0,0.3) -- (4.2,2.61) node[right] {$M(k)$};
    \draw[thick, dashed] (0,0.7) -- (4.2,1.96) node[right] {$X(k)$};
    \draw[thick, dotted] (0,1.2) -- (4.2,1.62) node[right] {$H(k)$};
    \draw[line width=2.2pt, opacity=0.35] (0,0.3) -- (1.6,1.18) -- (2.5,1.45) -- (4.2,1.62);
    \draw[dashed, thin] (1.6,1.18) -- (1.6,0) node[below] {$k_1$};
    \draw[dashed, thin] (2.5,1.45) -- (2.5,0) node[below] {$k_2$};
    \node[anchor=north, align=center] at (0.8,-0.38) {mercado};
    \node[anchor=north, align=center] at (2.05,-0.38) {híbrido};
    \node[anchor=north, align=center] at (3.4,-0.38) {jerarquía};
    \node[align=left, anchor=north west, text width=4.9cm] at (-0.1,-0.95) {La línea gruesa es la estructura más barata para cada $k$: el margen de COASE, ahora con una variable que lo explica.};
  \end{scope}
\end{tikzpicture}
