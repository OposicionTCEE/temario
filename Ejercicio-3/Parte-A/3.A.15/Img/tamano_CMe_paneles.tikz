% Figura: forma de los costes medios a largo plazo y determinación del tamaño eficiente (anexo del enfoque tecnológico).
% Tres paneles conceptuales: (a) rendimientos constantes, tamaño indeterminado; (b) costes en U, tamaño único;
% (c) costes en L, escala mínima eficiente. Curvas ilustrativas, sin datos.
% Generar con: bash Code/generar_figura.sh tamano_CMe_paneles
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  \def\W{4.3}  % ancho de cada eje
  \def\H{2.7}  % alto de cada eje
  \def\S{5.45} % separación horizontal entre paneles
  \foreach \i/\titulo in {0/{(a) Rendimientos constantes}, 1/{(b) Costes en forma de U}, 2/{(c) Costes en forma de L}} {
    \begin{scope}[xshift=\i*\S cm]
      \draw[->] (0,0) -- (\W,0) node[below left, xshift=2pt] {$q$};
      \draw[->] (0,0) -- (0,\H) node[left] {$CMe_{L/P}$};
      \node[font=\footnotesize\bfseries, anchor=south] at (\W/2,\H+0.15) {\titulo};
    \end{scope}
  }
  % (a) Rendimientos constantes: coste medio horizontal.
  \draw[very thick] (0.3,1.2) -- (4.0,1.2);
  \node[align=center, anchor=north] at (\W/2,-0.35) {Cualquier escala es eficiente:\\ el tamaño queda indeterminado};
  % (b) Forma de U: tramo decreciente (indivisibilidades, especialización) y creciente (factor no replicable).
  \begin{scope}[xshift=\S cm]
    \draw[very thick, domain=0.35:4.05, smooth, samples=60] plot (\x, {0.75+0.33*(\x-2.15)*(\x-2.15)});
    \draw[dashed] (2.15,0.75) -- (2.15,0) node[below] {$q^{*}$};
    \node[align=center, anchor=south] at (0.95,1.95) {indivisibilidades,\\ especialización};
    \node[align=center, anchor=south] at (3.45,1.95) {capacidad de\\ dirección};
    \node[align=center, anchor=north] at (\W/2,-0.35) {Un único tamaño eficiente;\\ el límite lo pone la dirección};
  \end{scope}
  % (c) Forma de L: decrece hasta la escala mínima eficiente y después es plana.
  \begin{scope}[xshift=2*\S cm]
    \draw[very thick, domain=0.35:1.7, smooth, samples=40] plot (\x, {0.75+1.25*(1.7-\x)*(1.7-\x)/(1.35*1.35)});
    \draw[very thick] (1.7,0.75) -- (4.05,0.75);
    \draw[dashed] (1.7,0.75) -- (1.7,0) node[below] {$q_{\min}$};
    \draw[decorate, decoration={brace, amplitude=4pt}] (1.75,0.9) -- (4.0,0.9) node[midway, above=4pt, align=center] {tamaños igual\\ de eficientes};
    \node[align=center, anchor=north] at (\W/2,-0.35) {Escala mínima eficiente:\\ un mínimo, no un máximo};
  \end{scope}
\end{tikzpicture}
