% Figura: mercados impugnables sin costes hundidos (BAUMOL, PANZAR y WILLIG, 1982), bloque 2, «La tesis».
% (a) Monopolio natural ilustrativo: CMe = 1 + 4/Q (coste fijo 4, CMg constante 1), demanda P = 5 - 0,6 Q.
%     Monopolio: IMg = CMg -> Q^m = 3,33, P^m = 3 (CMe = 2,2: beneficio). Precio sostenible: mayor corte de D y CMe,
%     Q^s = 5,44, P^s = 1,74 (beneficio nulo). Por encima de P^s, la entrada relámpago (hit and run) es rentable.
% (b) Decisión del entrante sin coste hundido, con el incumbente cobrando P > CMe. Pagos: (incumbente, entrante).
% Pareja de impugnables_con_hundidos.tikz (misma escala y mismas curvas). Generar con: bash Code/generar_figura.sh impugnables_sin_hundidos
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  % (a) Precio y coste.
  \node[font=\footnotesize\bfseries] at (3.5,5.75) {(a) Precio y coste: el precio sostenible};
  \fill[black!15] (0,2.2) rectangle (3.33,3.0);
  \node at (1.6,2.6) {$\Pi^m$};
  \draw[->] (0,0) -- (7.3,0) node[below left] {$Q$};
  \draw[->] (0,0) -- (0,5.4) node[left] {$P$};
  \draw[thick] (0,5) -- (7,0.8) node[above right, xshift=-2pt] {$D$};
  \draw[thick, domain=0.96:6.9, samples=80] plot (\x,{1+4/\x}) node[right] {$CMe$};
  \draw[dashed] (0,1) node[above right] {$CMg$} -- (6.9,1);
  \draw[densely dotted] (0,3.0) node[left] {$P^m$} -- (3.33,3.0) -- (3.33,0) node[below] {$Q^m$};
  \draw[densely dotted] (0,1.74) node[left] {$P^s$} -- (5.44,1.74) -- (5.44,0) node[below] {$Q^s$};
  \fill (5.44,1.74) circle (1.6pt);
  \node[align=left, anchor=west, text width=3.3cm] (hr) at (3.55,4.15) {Si $P>CMe$, un entrante que cobre algo menos gana y sale antes de que el incumbente reaccione (\textit{hit and run})};
  \node[align=center, text width=2.4cm] (ps) at (6.2,3.0) {Sostenible: $P^s=CMe$, beneficio nulo};
  \draw[->] (ps.south) -- (5.5,1.85);
  % (b) Decisión del entrante.
  \begin{scope}[xshift=8.35cm]
    \node[font=\footnotesize\bfseries] at (3.4,5.75) {(b) Decisión del entrante: entrada relámpago};
    \node[draw, rounded corners=2pt, align=center, inner sep=3pt] (E) at (3.4,4.75) {Entrante\\ (el incumbente cobra $P>CMe$)};
    \node[align=center] (NE) at (1.1,3.05) {$(\Pi(P),\ 0)$};
    \node[draw, rounded corners=2pt, align=center, inner sep=3pt] (B) at (5.3,3.05) {Vende a $P-\varepsilon$\\ y se queda el mercado};
    \node[align=center] (EB) at (5.3,1.55) {$(0,\ \Pi^e>0)$};
    \draw[->] (E) -- node[above left, align=center] {No entra} (NE);
    \draw[->] (E) -- node[above right, align=center] {Entra:\\ sin coste hundido} (B);
    \draw[->] (B) -- node[right, align=left] {Sale sin pérdidas\\ si reacciona} (EB);
    \node[anchor=west] at (0,1.55) {Pagos: (incumbente, entrante)};
    \node[align=left, text width=6.6cm, anchor=north west] at (0,0.95) {Mientras $P>CMe$, entrar es rentable y salir no cuesta nada, de modo que el entrante entra. La amenaza basta: el incumbente fija $P^s=CMe$ y su beneficio es nulo.};
  \end{scope}
\end{tikzpicture}
