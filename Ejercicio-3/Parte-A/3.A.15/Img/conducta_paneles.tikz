% Figura: identificación del parámetro de conducta (BRESNAHAN, 1982; LAU, 1982), bloque 2.
% (a) Desplazamiento paralelo de la demanda: D1: P = 8 - Q, D2: P = 9 - Q. Los equilibrios E1 = (3,5; 4,5) y E2 = (4; 5) los
%     genera tanto la competencia con CMg_c: P = 1 + Q como el monopolio con CMg_m = 1 (IMg1 = 8 - 2Q, IMg2 = 9 - 2Q).
% (b) Rotación de la demanda alrededor de E1: D3: P = 11,5 - 2Q. Con competencia el equilibrio sigue en E1; con monopolio,
%     IMg3 = 11,5 - 4Q = 1 -> Q = 2,625 y P = 6,25: el precio sube.
% Generar con: bash Code/generar_figura.sh conducta_paneles
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=0.92cm, y=0.52cm]
  % (a) Desplazamiento paralelo.
  \node[font=\footnotesize\bfseries] at (3.6,9.9) {(a) Desplazamiento paralelo: no identifica};
  \draw[->] (0,0) -- (7.4,0) node[below left] {$Q$};
  \draw[->] (0,0) -- (0,9.2) node[left] {$P$};
  \draw[thick] (0,8) -- (7,1) node[above right, xshift=-3pt] {$D_1$};
  \draw[thick] (0.2,8.8) -- (7,2) node[above right, xshift=-3pt] {$D_2$};
  \draw[densely dotted] (0,8) -- (4,0) node[below] {$IMg_1$};
  \draw[densely dotted] (0.2,8.6) -- (4.5,0) node[below right, xshift=-2pt] {$IMg_2$};
  \draw (0,1) -- (6.4,7.4) node[right] {$CMg_c$};
  \draw[dashed] (0,1) -- (7,1) node[pos=0.72, below, yshift=1pt] {$CMg_m$};
  \fill (3.5,4.5) circle (1.8pt) node[below right] {$E_1$};
  \fill (4,5) circle (1.8pt) node[below right] {$E_2$};
  % (b) Rotación.
  \begin{scope}[xshift=8.3cm]
    \node[font=\footnotesize\bfseries] at (3.6,9.9) {(b) Rotación: identifica};
    \draw[->] (0,0) -- (7.4,0) node[below left] {$Q$};
    \draw[->] (0,0) -- (0,9.2) node[left] {$P$};
    \draw[thick] (0,8) -- (7,1) node[above right, xshift=-3pt] {$D_1$};
    \draw[thick] (1.75,8) -- (5.5,0.5) node[right] {$D_3$};
    \draw[densely dotted] (0.875,8) -- (2.875,0) node[below] {$IMg_3$};
    \draw (0,1) -- (6.4,7.4) node[right] {$CMg_c$};
    \draw[dashed] (0,1) -- (7,1) node[pos=0.22, below, yshift=1pt] {$CMg_m$};
    \fill (3.5,4.5) circle (1.8pt);
    \fill (2.625,6.25) circle (1.8pt);
    \draw[densely dotted] (0,6.25) node[left] {$P_3^m$} -- (2.625,6.25);
    \draw[densely dotted] (0,4.5) node[left] {$P_1$} -- (3.5,4.5);
    \node[align=left, anchor=west, text width=2.4cm] (c) at (4.9,4.6) {Competencia: el precio no cambia ($E_1$)};
    \draw[->] (c.west) -- (3.7,4.52);
    \node[align=left, anchor=west, text width=2.9cm] (m) at (3.9,8.4) {Monopolio: el precio sube a $P_3^m$};
    \draw[->] (m.west) -- (2.8,6.4);
  \end{scope}
\end{tikzpicture}
