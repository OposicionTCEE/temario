% Figura: la teoría de los derechos de propiedad (GROSSMAN y HART, 1986; HART y MOORE, 1990), bloque 1.
% (a) Calendario: t=0 propiedad; t=1 inversiones específicas no contratables; t=2 renegociación eficiente.
% (b) Incentivo a invertir de A (comprador) y B (proveedor) según la estructura de propiedad. Valores ilustrativos:
%     parte del rendimiento marginal de su inversión que capta cada uno = 1/2 + 1/2 x (valor marginal de su opción externa):
%     integración por A (0,9; 0,5); no integración (0,7; 0,7); integración por B (0,5; 0,9). Óptimo = 1.
% Generar con: bash Code/generar_figura.sh ghm_paneles
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]},
  hito/.style={align=center, text width=2.3cm, anchor=north}]
  % (a) Calendario.
  \node[font=\footnotesize\bfseries] at (3.65,4.35) {(a) Invertir antes, negociar después};
  \draw[->, thick] (0,2.6) -- (7.3,2.6) node[below left, yshift=-1pt] {$t$};
  \foreach \x/\t in {1.15/0, 3.65/1, 6.15/2} {\draw[thick] (\x,2.5) -- (\x,2.7) node[above] {$t=\t$};}
  \node[hito] at (1.15,2.35) {Se asigna la propiedad de los activos, lo único contratable};
  \node[hito] at (3.65,2.35) {Cada parte hace inversiones específicas, no contratables};
  \node[hito] at (6.15,2.35) {Renegociación eficiente: opción externa más la mitad del excedente};
  \node[align=center, text width=7.0cm] at (3.65,0.05) {Quien posee los activos tiene mejor opción externa, capta más rendimiento de su inversión e invierte más.};
  % (b) Incentivos según la estructura de propiedad.
  \begin{scope}[xshift=8.3cm]
    \node[font=\footnotesize\bfseries] at (3.4,4.35) {(b) Quién invierte según quién posee};
    \draw[->] (0,0) -- (6.9,0);
    \draw[->] (0,0) -- (0,3.6) node[above] {parte del rendimiento captado};
    \draw[dashed] (0,3.0) node[above right] {óptimo: todo el rendimiento} -- (6.8,3.0);
    \foreach \x/\a/\b/\nombre in {0.45/2.7/1.5/{Integración\\ por A}, 2.75/2.1/2.1/{No\\ integración}, 5.05/1.5/2.7/{Integración\\ por B}} {
      \fill[black!35] (\x,0) rectangle (\x+0.6,\a);
      \draw (\x,0) rectangle (\x+0.6,\a);
      \draw (\x+0.7,0) rectangle (\x+1.3,\b);
      \node[align=center, anchor=north] at (\x+0.65,-0.05) {\nombre};
    }
    \fill[black!35] (0.6,-1.4) rectangle (0.9,-1.2); \draw (0.6,-1.4) rectangle (0.9,-1.2);
    \node[anchor=west] at (0.95,-1.3) {A (comprador)};
    \draw (3.4,-1.4) rectangle (3.7,-1.2);
    \node[anchor=west] at (3.75,-1.3) {B (proveedor)};
  \end{scope}
\end{tikzpicture}
