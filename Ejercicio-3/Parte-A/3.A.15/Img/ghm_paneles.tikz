% Figura: la teoría de los derechos de propiedad (GROSSMAN y HART, 1986; HART y MOORE, 1990), bloque 1.
% (a) Calendario: t=0 propiedad; t=1 inversiones específicas no contratables; t=2 renegociación eficiente.
% (b) Incentivo a invertir de A (comprador) y B (proveedor) según la estructura de propiedad. Valores ilustrativos:
%     parte del rendimiento marginal de su inversión que capta cada uno = 1/2 + 1/2 x (valor marginal de su opción externa):
%     integración por A (0,9; 0,5); no integración (0,7; 0,7); integración por B (0,5; 0,9). Óptimo = 1.
% Generar con: bash Code/generar_figura.sh ghm_paneles
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]},
  hito/.style={align=center, text width=2.15cm, anchor=north}]
  % (a) Calendario.
  \node[font=\footnotesize\bfseries] at (3.6,4.35) {(a) Invertir antes, negociar después};
  \draw[->, thick] (0,2.6) -- (7.3,2.6) node[below left, yshift=-1pt] {$t$};
  \foreach \x/\t in {0.6/0, 3.6/1, 6.6/2} {\draw[thick] (\x,2.5) -- (\x,2.7) node[above] {$t=\t$};}
  \node[hito] at (0.6,2.35) {Se asigna la propiedad de los activos (lo único contratable)};
  \node[hito] at (3.6,2.35) {Cada parte hace inversiones específicas, no contratables};
  \node[hito] at (6.6,2.35) {Renegociación eficiente: opción externa más la mitad del excedente};
  \node[align=center, text width=7.0cm] at (3.6,0.1) {Quien posee los activos tiene mejor opción externa y capta más rendimiento de su inversión: invierte más.};
  \draw[decorate, decoration={brace, amplitude=5pt, mirror}] (3.6,0.65) -- (6.6,0.65) node[midway, below=5pt] {};
  % (b) Incentivos según la estructura de propiedad.
  \begin{scope}[xshift=8.4cm]
    \node[font=\footnotesize\bfseries] at (3.5,4.35) {(b) Quién invierte según quién posee};
    \draw[->] (0,0) -- (7.0,0);
    \draw[->] (0,0) -- (0,3.6) node[above] {parte del rendimiento captado};
    \draw[dashed] (0,3.0) -- (6.9,3.0) node[below left] {óptimo (todo el rendimiento)};
    \foreach \x/\a/\b/\nombre in {0.5/2.7/1.5/{Integración\\ por A}, 2.8/2.1/2.1/{No\\ integración}, 5.1/1.5/2.7/{Integración\\ por B}} {
      \fill[black!35] (\x,0) rectangle (\x+0.6,\a);
      \draw (\x,0) rectangle (\x+0.6,\a);
      \draw (\x+0.7,0) rectangle (\x+1.3,\b);
      \node[align=center, anchor=north] at (\x+0.65,-0.05) {\nombre};
    }
    \fill[black!35] (0.3,-1.05) rectangle (0.6,-0.85); \draw (0.3,-1.05) rectangle (0.6,-0.85);
    \node[anchor=west] at (0.65,-0.95) {A (comprador)};
    \draw (2.9,-1.05) rectangle (3.2,-0.85);
    \node[anchor=west] at (3.25,-0.95) {B (proveedor)};
  \end{scope}
\end{tikzpicture}
