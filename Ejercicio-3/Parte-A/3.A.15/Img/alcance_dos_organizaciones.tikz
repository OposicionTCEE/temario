% Figura: economías de alcance con un input compartido K organizadas de dos formas con la misma tecnología
% (anexo del enfoque tecnológico). (a) una empresa multiproducto; (b) dos empresas unidas por un contrato.
% Las diferencias se escriben como «≠ rasgo ⇒ implicación» (sin resaltado de color).
% Generar con: bash Code/generar_figura.sh alcance_dos_organizaciones
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]},
  caja/.style={draw, rounded corners=2pt, align=center, inner sep=3pt, minimum height=0.7cm},
  empresa/.style={draw, thick, rounded corners=4pt}]
  % (a) Una empresa multiproducto.
  \node[font=\footnotesize\bfseries] at (2.3,3.45) {(a) Una empresa multiproducto};
  \draw[empresa] (0,0) rectangle (4.6,3.0);
  \node[anchor=north west, font=\footnotesize\itshape] at (0.05,2.97) {Empresa};
  \node[caja, minimum width=3.4cm] (Ka) at (2.3,1.85) {Input compartido $K$\\ (saber hacer, red, capacidad)};
  \node[caja, minimum width=1.6cm] (P1a) at (1.2,0.55) {Producto 1};
  \node[caja, minimum width=1.6cm] (P2a) at (3.4,0.55) {Producto 2};
  \draw[->] (Ka) -- (P1a);
  \draw[->] (Ka) -- (P2a);
  \node at (2.3,-0.3) {Coordinación por autoridad};
  % (b) Dos empresas y un contrato.
  \begin{scope}[xshift=6.6cm]
    \node[font=\footnotesize\bfseries] at (3.6,3.45) {(b) Dos empresas y un contrato};
    \draw[empresa] (0,0) rectangle (2.6,3.0);
    \node[anchor=north west, font=\footnotesize\itshape] at (0.05,2.97) {Empresa A};
    \draw[empresa] (4.8,0) rectangle (7.2,3.0);
    \node[anchor=north west, font=\footnotesize\itshape] at (4.85,2.97) {Empresa B};
    \node[caja, minimum width=2.1cm] (Kb) at (1.3,1.85) {Input\\ compartido $K$};
    \node[caja, minimum width=1.6cm] (P1b) at (1.3,0.55) {Producto 1};
    \node[caja, minimum width=1.6cm] (P2b) at (6.0,0.55) {Producto 2};
    \draw[->] (Kb) -- (P1b);
    \draw[->, dashed] (Kb.east) -- (6.0,1.85) -- (P2b.north);
    \node[above] at (3.7,1.85) {contrato};
    \node[below] at (3.7,1.85) {(licencia, alquiler)};
    \node at (3.6,-0.3) {Coordinación por contrato};
  \end{scope}
  % Lo común y las diferencias.
  \node[align=left, anchor=north west, text width=15.3cm] at (-0.1,-0.7) {%
    \textbf{Misma tecnología en (a) y en (b):} $C(q_1,q_2)<C(q_1,0)+C(0,q_2)$ $\Rightarrow$ conviene producir juntos.\\[2pt]
    $\neq$ \textbf{propiedad de $K$} (una empresa o dos) $\Rightarrow$ \textit{si contratar no cuesta, la tecnología no distingue entre (a) y (b)}.\\[2pt]
    $\neq$ \textbf{coordinación} (autoridad o contrato) $\Rightarrow$ \textit{con costes de transacción, el coste de contratar los servicios de $K$ decide la frontera}.\\[2pt]
    {\itshape $\neq$: diferencia entre (a) y (b);\quad $\Rightarrow$: implicación.}};
\end{tikzpicture}
