% Figura: economías de alcance con un input compartido K organizadas de dos formas con la misma tecnología
% (anexo del enfoque tecnológico). (a) una empresa multiproducto; (b) dos empresas unidas por un contrato.
% Las diferencias se escriben como «≠ rasgo ⇒ implicación» (sin resaltado de color).
% Generar con: bash Code/generar_figura.sh alcance_dos_organizaciones
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]},
  caja/.style={draw, rounded corners=2pt, align=center, inner sep=3pt, minimum height=0.75cm},
  empresa/.style={draw, thick, rounded corners=4pt, inner sep=5pt}]
  % (a) Una empresa multiproducto.
  \node[font=\footnotesize\bfseries] at (2.3,3.55) {(a) Una empresa multiproducto};
  \node[caja, minimum width=3.2cm] (Ka) at (2.3,2.45) {Input compartido $K$\\ (saber hacer, red, capacidad)};
  \node[caja, minimum width=1.6cm] (P1a) at (1.2,0.75) {Producto 1};
  \node[caja, minimum width=1.6cm] (P2a) at (3.4,0.75) {Producto 2};
  \draw[->] (Ka) -- (P1a);
  \draw[->] (Ka) -- (P2a);
  \node[empresa, fit=(Ka)(P1a)(P2a), label={[anchor=north west, font=\footnotesize\itshape]north west:Empresa}] {};
  \node[align=center, anchor=north] at (2.3,-0.05) {Coordinación por autoridad};
  % (b) Dos empresas y un contrato.
  \begin{scope}[xshift=8.4cm]
    \node[font=\footnotesize\bfseries] at (2.6,3.55) {(b) Dos empresas y un contrato};
    \node[caja, minimum width=2.2cm] (Kb) at (0.9,2.45) {Input\\ compartido $K$};
    \node[caja, minimum width=1.6cm] (P1b) at (0.9,0.75) {Producto 1};
    \node[caja, minimum width=1.6cm] (P2b) at (4.6,0.75) {Producto 2};
    \draw[->] (Kb) -- (P1b);
    \node[empresa, fit=(Kb)(P1b), label={[anchor=north west, font=\footnotesize\itshape]north west:Empresa A}] (A) {};
    \node[empresa, fit=(P2b), minimum height=2.95cm, label={[anchor=north west, font=\footnotesize\itshape]north west:Empresa B}] (B) {};
    \draw[->, dashed] (Kb.east) -- node[above, align=center] {contrato\\ (licencia, alquiler)} ($(B.west |- Kb.east)$) |- (P2b.north);
    \node[align=center, anchor=north] at (2.6,-0.05) {Coordinación por contrato};
  \end{scope}
  % Lo común y las diferencias.
  \node[align=left, anchor=north west, text width=15.6cm] at (-0.2,-0.75) {%
    \textbf{Misma tecnología en (a) y en (b):} $C(q_1,q_2)<C(q_1,0)+C(0,q_2)$ $\Rightarrow$ conviene producir juntos.\\[2pt]
    $\neq$ \textbf{propiedad de $K$} (una empresa o dos) $\Rightarrow$ \textit{si contratar no cuesta, la tecnología no distingue entre (a) y (b)}.\\[2pt]
    $\neq$ \textbf{coordinación} (autoridad o contrato) $\Rightarrow$ \textit{con costes de transacción, el coste de contratar los servicios de $K$ decide la frontera}.\\[2pt]
    {\itshape $\neq$: diferencia entre (a) y (b);\quad $\Rightarrow$: implicación.}};
\end{tikzpicture}
