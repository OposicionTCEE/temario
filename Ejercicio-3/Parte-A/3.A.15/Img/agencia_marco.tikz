% Figura: el contrato lineal de HOLMSTRÖM y MILGROM (1987) aplicado al tema (bloque 1, «Marco analítico»).
% (a) Intensidad óptima de incentivos beta* = 1/(1 + r c sigma^2) según el ruido sigma^2 (comprar o hacer).
% (b) Coste de agencia CA = r sigma^2 / (2 (1 + r c sigma^2)) creciente con el ruido, que aumenta con el tamaño.
% Escala ilustrativa: r = c = 1, sigma^2 = 1,4 x (x = abscisa del gráfico), ordenadas multiplicadas por 2,4.
% Generar con: bash Code/generar_figura.sh agencia_marco
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  \def\W{6.0}
  \def\H{2.9}
  % (a) Intensidad óptima de incentivos.
  \node[font=\footnotesize\bfseries] at (\W/2,\H+0.75) {(a) Comprar o hacer};
  \draw[->] (0,0) -- (\W,0) node[below left, xshift=2pt, align=right] {$\sigma^2$};
  \draw[->] (0,0) -- (0,\H) node[above] {$\beta^{*}$};
  \draw[dashed] (0,2.4) node[left] {$1$} -- (\W-0.2,2.4);
  \draw[very thick, domain=0:5.6, smooth, samples=60] plot (\x, {2.4/(1+1.4*\x)});
  \node[align=left, anchor=west] at (0.35,1.75) {\textbf{proveedor independiente}:\\ posee el activo, cobra por resultado};
  \node[align=right, anchor=east] at (\W-0.1,0.95) {\textbf{empleado}: activo de la empresa,\\ sueldo fijo y supervisión};
  \node[align=center, anchor=north] at (\W/2,-0.4) {Resultado fácil de medir: mercado; difícil de medir: jerarquía};
  % (b) Coste de agencia según el tamaño.
  \begin{scope}[xshift=7.4cm]
    \node[font=\footnotesize\bfseries] at (\W/2,\H+0.75) {(b) Límite interno};
    \draw[->] (0,0) -- (\W,0) node[below left, xshift=2pt] {$\sigma^2$};
    \draw[->] (0,0) -- (0,\H) node[above] {coste de agencia};
    \draw[very thick, domain=0:5.6, smooth, samples=60] plot (\x, {2.4*1.4*\x/(1+1.4*\x)});
    \fill (0.7,{2.4*0.98/1.98}) circle (1.6pt) node[above left] {pequeña};
    \fill (4.2,{2.4*5.88/6.88}) circle (1.6pt) node[above left] {grande};
    \draw[->, thick] (4.1,1.55) -- (2.4,1.55) node[midway, below, align=center] {forma M, evaluación\\ relativa: menos ruido};
    \node[align=center, anchor=north] at (\W/2,-0.4) {Al crecer la empresa se mide peor al directivo: $\sigma^2\uparrow$};
  \end{scope}
\end{tikzpicture}
