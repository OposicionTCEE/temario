% Figura: la empresa como nexo de contratos (bloque 1, «Límites»).
% (a) Producción en equipo (ALCHIAN y DEMSETZ, 1972): producción conjunta no separable, supervisor que cobra el residuo.
% (b) Nexo de contratos (JENSEN y MECKLING, 1976): la empresa como ficción legal en el centro de los contratos,
%     y descomposición del coste de agencia (supervisión, fianza, pérdida residual). Tamaños ilustrativos.
% Generar con: bash Code/generar_figura.sh nexo_contratos
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]},
  caja/.style={draw, rounded corners=2pt, align=center, inner sep=3pt},
  parte/.style={draw, rounded corners=2pt, align=center, inner sep=2pt, minimum width=1.75cm, minimum height=0.55cm}]
  % (a) Producción en equipo.
  \node[font=\footnotesize\bfseries] at (3.2,5.75) {(a) Producción en equipo};
  \node[caja, text width=5.3cm] (sup) at (3.2,4.65) {\textbf{Supervisor}: cobra el residuo $Q-\sum w_i$;\\ observa, contrata y despide; vende sus derechos};
  \node[parte] (t1) at (0.9,2.6) {Trabajador 1};
  \node[parte] (t2) at (3.2,2.6) {Trabajador 2};
  \node[parte] (t3) at (5.5,2.6) {Trabajador 3};
  \node[caja, text width=4.6cm] (q) at (3.2,0.6) {\textbf{Producción conjunta} $Q$\\ no se sabe cuánto aporta cada uno};
  \foreach \t in {t1,t2,t3} {\draw[->] (\t) -- (q);}
  \draw[->, dashed] (sup) -- (t1);
  \draw[->, dashed] (sup) -- (t2) node[midway, right] {observa y paga $w_i$};
  \draw[->, dashed] (sup) -- (t3);
  \draw[->, thick] (q.east) -- (7.0,0.6) -- (7.0,4.65) node[midway, right] {residuo} -- (sup.east);
  % (b) Nexo de contratos.
  \begin{scope}[xshift=8.9cm]
    \node[font=\footnotesize\bfseries] at (3.2,5.75) {(b) Nexo de contratos};
    \node[draw, circle, align=center, inner sep=1pt, minimum size=1.7cm] (e) at (3.2,3.0) {Empresa\\ \textit{(ficción}\\ \textit{legal)}};
    \foreach \ang/\nom in {90/Accionistas, 30/Acreedores, -30/Proveedores, -90/Clientes, 210/Trabajadores, 150/Directivos} {
      \node[parte] (n\ang) at ($(e)+(\ang:2.0)$) {\nom};
      \draw (e) -- (n\ang);
    }
    % Coste de agencia descompuesto.
    \node[anchor=east] at (2.2,-0.1) {\textbf{Coste de agencia} $=$};
    \draw[fill=black!45] (2.3,-0.3) rectangle (3.6,0.1);
    \draw[fill=black!20] (3.6,-0.3) rectangle (4.8,0.1);
    \draw[fill=white] (4.8,-0.3) rectangle (6.1,0.1);
    \node[anchor=north, align=center] at (2.95,-0.35) {supervisión\\ (principal)};
    \node[anchor=north, align=center] at (4.2,-0.35) {fianza\\ (agente)};
    \node[anchor=north, align=center] at (5.45,-0.35) {pérdida\\ residual};
  \end{scope}
\end{tikzpicture}
