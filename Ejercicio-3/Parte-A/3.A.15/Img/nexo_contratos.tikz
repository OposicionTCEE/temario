% Figura: la empresa como nexo de contratos (bloque 1, «Límites»).
% (a) Producción en equipo (ALCHIAN y DEMSETZ, 1972): producción conjunta no separable, supervisor que cobra el residuo.
% (b) Nexo de contratos (JENSEN y MECKLING, 1976): la empresa como ficción legal en el centro de los contratos,
%     y descomposición del coste de agencia (supervisión, fianza, pérdida residual). Tamaños ilustrativos.
% Generar con: bash Code/generar_figura.sh nexo_contratos
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]},
  caja/.style={draw, rounded corners=2pt, align=center, inner sep=3pt},
  parte/.style={draw, rounded corners=2pt, align=center, inner sep=2pt, minimum width=1.75cm, minimum height=0.55cm}]
  % (a) Producción en equipo.
  \node[font=\footnotesize\bfseries] at (3.5,5.6) {(a) Producción en equipo};
  \node[caja, text width=4.6cm] (sup) at (3.5,4.5) {\textbf{Supervisor}: cobra el residuo $Q-\sum w_i$\\ observa, contrata y despide, vende sus derechos};
  \node[parte] (t1) at (1.0,2.5) {Trabajador 1};
  \node[parte] (t2) at (3.5,2.5) {Trabajador 2};
  \node[parte] (t3) at (6.0,2.5) {Trabajador 3};
  \node[caja, text width=4.6cm] (q) at (3.5,0.6) {\textbf{Producción conjunta} $Q$\\ no se sabe cuánto aporta cada uno};
  \foreach \t in {t1,t2,t3} {\draw[->] (\t) -- (q);}
  \foreach \t in {t1,t2,t3} {\draw[->, dashed] (sup) -- (\t);}
  \node[align=center, fill=white, inner sep=1pt] at (5.55,3.55) {observa y\\ paga $w_i$};
  \draw[->, thick] (q.east) -- ++(0.55,0) |- (sup.east) node[pos=0.25, right, align=left] {residuo};
  % (b) Nexo de contratos.
  \begin{scope}[xshift=8.6cm]
    \node[font=\footnotesize\bfseries] at (3.4,5.6) {(b) Nexo de contratos};
    \node[draw, circle, align=center, inner sep=1pt, minimum size=1.7cm] (e) at (3.4,3.2) {Empresa\\ \textit{(ficción}\\ \textit{legal)}};
    \foreach \ang/\nom in {90/Accionistas, 30/Acreedores, -30/Proveedores, -90/Clientes, 210/Trabajadores, 150/Directivos} {
      \node[parte] (n\ang) at ($(e)+(\ang:2.15)$) {\nom};
      \draw (e) -- (n\ang);
    }
    % Coste de agencia descompuesto.
    \node[anchor=west] at (0,0.35) {\textbf{Coste de agencia} $=$};
    \draw[fill=black!45] (2.45,0.15) rectangle (3.55,0.55);
    \draw[fill=black!20] (3.55,0.15) rectangle (4.45,0.55);
    \draw[fill=white] (4.45,0.15) rectangle (5.75,0.55);
    \node[anchor=north, align=center] at (3.0,0.1) {supervisión\\ (principal)};
    \node[anchor=north, align=center] at (4.0,0.1) {fianza\\ (agente)};
    \node[anchor=north, align=center] at (5.1,0.1) {pérdida\\ residual};
  \end{scope}
\end{tikzpicture}
