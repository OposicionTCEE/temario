% Figura (Anexo II, «Efecto sustitución y efecto escala»): empresa competitiva que maximiza el beneficio.
% Tecnología q = (K L)^{0,3} (rendimientos decrecientes), r = 1, p tal que p·0,3 = 1.
%   Con w_0 = 1: E_0 = (1, 1), q_0 = 1 (isocoste L + K = 2).
%   Con w_1 = 1,5: efecto sustitución hasta E' = (0,8165; 1,2247), en la misma isocuanta q_0 (K = 1/L) con K/L = 1,5
%   (isocoste 1,5 L + K = 2,4495); efecto escala hasta E_1 = (0,4917; 0,7377), q_1 = 0,7377, isocuanta K L = 0,3627
%   (isocoste 1,5 L + K = 1,4753). El trabajo cae en los dos pasos; el capital sube con la sustitución y cae con la escala.
% Escala: 1 unidad = 2,0 cm.
% Glosario único (segunda pasada, 26/10/2026): isocuantas q (inicial) y q' (final), para no chocar con q_1 del corto plazo; sin rótulos de trabajo en el eje (L_1 era el máximo de la PMg).
% Generar con: bash Code/generar_figura.sh anx_sustitucion_escala
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=2.0cm, y=2.0cm]
  \draw[->] (0,0) -- (2.85,0) node[below] {$L$};
  \draw[->] (0,0) -- (0,2.75) node[left] {$K$};
  \begin{scope}
    \clip (0,0) rectangle (2.7,2.6);
    \draw[very thick] plot[domain=0.38:2.7, samples=80] (\x,{1/\x});
    \draw[very thick] plot[domain=0.14:2.7, samples=80] (\x,{0.3627/\x});
    \draw[thin] (0,2) -- (2,0);
    \draw[thin, dashed] (0,2.4495) -- (1.633,0);
    \draw[thin, dashed] (0,1.4753) -- (0.9835,0);
  \end{scope}
  \node at (2.78,0.37) {$q$};
  \node at (2.78,0.13) {$q'$};
  \fill (1,1) circle (1.4pt) node[above right] {$E_0$};
  \fill (0.8165,1.2247) circle (1.4pt) node[above right] {$E'$};
  \fill (0.4917,0.7377) circle (1.4pt) node[above right] {$E_1$};
  \draw[dotted] (1,1) -- (1,0);
  \draw[dotted] (0.8165,1.2247) -- (0.8165,0);
  \draw[dotted] (0.4917,0.7377) -- (0.4917,0);
  \node at (1.35,-0.42) {$w_1>w_0$};
\end{tikzpicture}
