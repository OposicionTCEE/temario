% Figura (bloque 2, «Fuentes»): economías técnicas de producción y deseconomías de transporte (segunda pasada, 26/10/2026).
% Coste de producción por unidad decreciente: CMe_P = 0,8 + 1,2 q^{-1/3} (indivisibilidades y relaciones geométricas);
% coste de transporte por unidad creciente: CMe_T = 0,35 q^{1/2} (área de mercado circular: la distancia media crece con el radio,
% y la producción, con su cuadrado); CMe = CMe_P + CMe_T en forma de U.
% Mínimo: d CMe/dq = -0,4 q^{-4/3} + 0,175 q^{-1/2} = 0 => q^{5/6} = 2,2857 => q = 2,700; CMe = 0,8 + 0,8613 + 0,5751 = 2,236.
% Escalas: q 1 unidad = 1,25 cm; coste 1 unidad = 1,25 cm (recorte en 3,2).
% Generar con: bash Code/generar_figura.sh b2_fuentes_escala
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1.25cm, y=1.25cm]
  \draw[->] (0,0) -- (7.0,0) node[below] {$q$};
  \draw[->] (0,0) -- (0,3.45) node[left] {$\text{\texteuro}/q$};
  \begin{scope}
    \clip (0,0) rectangle (6.4,3.25);
    \draw[very thick] plot[domain=0.35:6.4, samples=90] (\x,{0.8+1.2*\x^(-1/3)+0.35*sqrt(\x)});
    \draw[thick, dashed] plot[domain=0.35:6.4, samples=90] (\x,{0.8+1.2*\x^(-1/3)});
    \draw[thick, densely dotted] plot[domain=0:6.4, samples=60] (\x,{0.35*sqrt(\x)});
  \end{scope}
  \node[right] at (6.4,3.135) {$CMe$};
  \node[right] at (6.4,1.45) {producción};
  \node[right] at (6.4,0.885) {transporte};
  \draw[dotted] (2.7,2.236) -- (2.7,0) node[below] {$q_{EME}$};
  \fill (2.7,2.236) circle (1.5pt);
\end{tikzpicture}
