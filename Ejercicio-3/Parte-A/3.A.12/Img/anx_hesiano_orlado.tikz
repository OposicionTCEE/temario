% Figura (Anexo I, «La condición de segundo orden: el hesiano orlado»).
% Precios w = r = 1; isocoste tangente L + K = 4 en E = (2, 2) en los dos casos.
% (a) Isocuanta convexa K = 4/L: la isocoste tangente queda por debajo de la isocuanta; E es el mínimo del coste.
% (b) Isocuanta cóncava K = (8 - L^2)^{1/2} (cuarto de círculo de radio 2,828): la isocoste tangente queda por encima;
%     E es el máximo del coste sobre la isocuanta; los mínimos están en las esquinas A = (0; 2,828) y B = (2,828; 0), coste 2,828.
% (c) Coste a lo largo de cada isocuanta, C(L) = wL + rK(L): convexa, L + 4/L (mínimo 4 en L = 2);
%     cóncava, L + (8 - L^2)^{1/2} (máximo 4 en L = 2; 2,828 en los extremos). Eje vertical: 1 unidad = 0,6 cm.
% Responde a la nota roja del texto antiguo que pedía la representación gráfica del hesiano orlado.
% Generar con: bash Code/generar_figura.sh anx_hesiano_orlado
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  % ---------------- (a) Isocuanta convexa ----------------
  \begin{scope}[x=1.0cm, y=1.0cm]
    \node[font=\footnotesize\bfseries] at (2.3,5.0) {(a) Isocuanta convexa};
    \draw[->] (0,0) -- (4.9,0) node[below] {$L$};
    \draw[->] (0,0) -- (0,4.7) node[left] {$K$};
    \draw[very thick] plot[domain=0.86:4.6, samples=80] (\x,{4/\x}) node[right] {$q$};
    \draw[thick] (0,4) -- (4,0);
    \fill (2,2) circle (1.4pt) node[above right] {$E$};
    \node at (2.3,-0.75) {$d^2K/dL^2>0$};
  \end{scope}
  % ---------------- (b) Isocuanta cóncava ----------------
  \begin{scope}[xshift=5.5cm, x=1.0cm, y=1.0cm]
    \node[font=\footnotesize\bfseries] at (2.3,5.0) {(b) Isocuanta cóncava};
    \draw[->] (0,0) -- (4.6,0) node[below] {$L$};
    \draw[->] (0,0) -- (0,4.7) node[left] {$K$};
    \draw[very thick] plot[domain=0:2.8284, samples=80] (\x,{sqrt(max(8-\x*\x,0))});
    \node at (2.75,1.15) {$q$};
    \draw[thick] (0,4) -- (4,0);
    \fill (2,2) circle (1.4pt) node[above right] {$E$};
    \fill (0,2.8284) circle (1.4pt) node[left] {$A$};
    \fill (2.8284,0) circle (1.4pt) node[below] {$B$};
    \node at (2.3,-0.75) {$d^2K/dL^2<0$};
  \end{scope}
  % ---------------- (c) Coste a lo largo de la isocuanta ----------------
  \begin{scope}[xshift=10.7cm, x=1.2cm, y=0.6cm]
    \node[font=\footnotesize\bfseries] at (1.75,8.33) {(c) Coste sobre la isocuanta};
    \draw[->] (0,0) -- (3.4,0) node[below] {$L$};
    \draw[->] (0,0) -- (0,7.6) node[left] {$C$};
    \draw[very thick] plot[domain=0.8:3.1, samples=80] (\x,{\x+4/\x}) node[right] {(a)};
    \draw[very thick, dashed] plot[domain=0:2.8284, samples=80] (\x,{\x+sqrt(max(8-\x*\x,0))});
    \node at (2.95,2.35) {(b)};
    \draw[dotted] (2,4) -- (2,0) node[below] {$L_E$};
    \fill (2,4) circle (1.4pt);
    \node at (1.75,-1.25) {$C(L)=wL+rK(L)$};
  \end{scope}
\end{tikzpicture}
