% Figura (bloque 2, «Reparto»): los costes y el reparto de la renta entre los factores (segunda pasada, 26/10/2026).
% (a) Participación relativa del trabajo en el coste, s_L/s_K = (w/r)^{1 - sigma}, normalizada a 1 en (w/r)_0 = 1:
%     corto plazo, sigma_s = 0,25: (w/r)^{0,75}, creciente; largo plazo, sigma_L = 1,8: (w/r)^{-0,8}, decreciente.
%     Con (w/r)_1 = 2: E_s = (2; 1,682) y E_L = (2; 0,574). Escala: w/r 1 unidad = 2 cm; s_L/s_K 1 unidad = 1,6 cm (recorte en 2,2).
% (b) Reparto del ingreso con rendimientos constantes: con p = CMg, s_L + s_K = 1 (0,6 y 0,4 en el dibujo); con un margen
%     mu = p/CMg = 1,25, el trabajo recibe s_L/mu = 0,48, el capital s_K/mu = 0,32 y el margen 1 - 1/mu = 0,20.
%     Barras de 1,1 cm de ancho y 3,6 cm de alto (ingreso = 1).
% Generar con: bash Code/generar_figura.sh b2_reparto
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  % ---------------- (a) Sustitución y horizonte ----------------
  \begin{scope}[x=2cm, y=1.6cm]
    \node[font=\footnotesize\bfseries] at (1.35,2.62) {(a) Sustitución y horizonte};
    \draw[->] (0,0) -- (2.85,0) node[below] {$w/r$};
    \draw[->] (0,0) -- (0,2.4) node[left] {$s_L/s_K$};
    \begin{scope}
      \clip (0,0) rectangle (2.65,2.2);
      \draw[very thick] plot[domain=0.3:2.6, samples=60] (\x,{\x^0.75});
      \draw[very thick, dashed] plot[domain=0.37:2.6, samples=60] (\x,{\x^(-0.8)});
    \end{scope}
    \node[right] at (2.6,2.05) {$\sigma_s<1$};
    \node[right] at (2.6,0.47) {$\sigma_L>1$};
    \draw[dotted] (1,1) -- (1,0) node[below] {$(w/r)_0$};
    \draw[dotted] (2,1.682) -- (2,0) node[below] {$(w/r)_1$};
    \draw[dotted] (0,1) -- (1,1);
    \fill (1,1) circle (1.4pt) node[above left] {$E_0$};
    \fill (2,1.682) circle (1.4pt) node[above left] {$E_s$};
    \fill (2,0.574) circle (1.4pt) node[below left] {$E_L$};
  \end{scope}
  % ---------------- (b) Poder de mercado ----------------
  \begin{scope}[xshift=8.0cm]
    \node[font=\footnotesize\bfseries] at (1.7,4.19) {(b) Poder de mercado};
    \draw[->] (0,0) -- (3.6,0);
    \draw[->] (0,0) -- (0,3.85) node[left] {ingreso};
    % barra 1: p = CMg
    \draw[fill=black!35] (0.5,0) rectangle (1.6,2.16);
    \draw[fill=black!12] (0.5,2.16) rectangle (1.6,3.6);
    \node at (1.05,1.08) {$s_L$};
    \node at (1.05,2.88) {$s_K$};
    \node[below] at (1.05,0) {$p=CMg$};
    % barra 2: p = mu CMg
    \draw[fill=black!35] (2.1,0) rectangle (3.2,1.728);
    \draw[fill=black!12] (2.1,1.728) rectangle (3.2,2.88);
    \draw[fill=white] (2.1,2.88) rectangle (3.2,3.6);
    \node at (2.65,0.864) {$s_L/\mu$};
    \node at (2.65,2.304) {$s_K/\mu$};
    \node at (2.65,3.24) {$1-1/\mu$};
    \node[below] at (2.65,0) {$p=\mu\,CMg$};
  \end{scope}
\end{tikzpicture}
