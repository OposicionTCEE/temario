% Figura (Anexo III, «La flexibilidad de las plantas»): planta rígida frente a planta flexible (STIGLER, 1939).
% Coste medio a corto plazo: planta rígida CMe^R = 2 + 3 (q - 1)^2 (mínimo 2 en q = 1, muy curvada);
% planta flexible CMe^F = 2,25 + 0,8 (q - 1)^2 (mínimo 2,25, más plana). Se cortan en q = 1 -/+ 0,337 (0,663 y 1,337).
% Si la producción fluctúa uniformemente entre q_min = 0,4 y q_max = 1,6, el coste medio esperado es 2,36 con la rígida
% y 2,346 con la flexible.
% Escala: q 1 unidad = 4,0 cm; costes 1 unidad = 1,2 cm. Sustituye a STIGLER_ReservaCapacidad.png del tema antiguo.
% Generar con: bash Code/generar_figura.sh anx_flexibilidad
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=4.0cm, y=1.2cm]
  \draw[->] (0,0) -- (2.0,0) node[below] {$q$};
  \draw[->] (0,0) -- (0,4.4) node[left] {$\text{\texteuro}/q$};
  \begin{scope}
    \clip (0,0) rectangle (1.9,4.2);
    \draw[very thick] plot[domain=0.2:1.8, samples=80] (\x,{2+3*(\x-1)^2});
    \draw[very thick, dashed] plot[domain=0.12:1.8, samples=80] (\x,{2.25+0.8*(\x-1)^2});
  \end{scope}
  \node at (1.83,4.05) {$CMe^{R}$};
  \node[right] at (1.8,2.76) {$CMe^{F}$};
  \draw[dotted] (0.4,3.08) -- (0.4,0) node[below] {$q_{\min}$};
  \draw[dotted] (1.6,3.08) -- (1.6,0) node[below] {$q_{\max}$};
  \draw[dotted] (1,2) -- (1,0) node[below] {$q^{*}$};
\end{tikzpicture}
