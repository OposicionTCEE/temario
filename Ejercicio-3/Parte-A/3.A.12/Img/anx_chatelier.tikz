% Figura (Anexo II, «La oferta a corto y a largo plazo»): principio de LE CHÂTELIER-SAMUELSON.
% Misma tecnología que anx_envolvente: CMg_L = 3 q^{1/2}; planta K_2 = 1, óptima para q* = 1: CMg_s = 3 q^2.
% En q* = 1 los dos costes marginales valen 3 (precio inicial p_0 = 3); pendientes: CMg_s' = 6, CMg_L' = 1,5.
% Con p_1 = 4: corto plazo q_s = (4/3)^{1/2} = 1,155; largo plazo q_L = (4/3)^2 = 1,778.
% Escala: q 1 unidad = 3,4 cm; precio 1 unidad = 0,85 cm (recorte en 6). Sustituye a Ppio_CHATELIER_SAMUELSON.png.
% Generar con: bash Code/generar_figura.sh anx_chatelier
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=3.4cm, y=0.85cm]
  \draw[->] (0,0) -- (2.25,0) node[below] {$q$};
  \draw[->] (0,0) -- (0,6.3) node[left] {$p$};
  \begin{scope}
    \clip (0,0) rectangle (2.1,6.0);
    \draw[very thick] plot[domain=0.2:2.05, samples=80] (\x,{3*sqrt(\x)});
    \draw[very thick, dashed] plot[domain=0.2:1.45, samples=80] (\x,{3*\x*\x});
  \end{scope}
  \node at (2.17,4.3) {$CMg_L$};
  \node at (1.5,5.8) {$CMg_s$};
  \draw[thin] (0,3) -- (2.0,3);
  \draw[thin] (0,4) -- (2.0,4);
  \node[left] at (0,3) {$p_0$};
  \node[left] at (0,4) {$p_1$};
  \fill (1,3) circle (1.4pt) node[below right] {$E_0$};
  \fill (1.1547,4) circle (1.4pt);
  \fill (1.7778,4) circle (1.4pt);
  \draw[dotted] (1,3) -- (1,0) node[below] {$q^*$};
  \draw[dotted] (1.1547,4) -- (1.1547,0) node[below right=-1pt] {$q_s$};
  \draw[dotted] (1.7778,4) -- (1.7778,0) node[below] {$q_L$};
\end{tikzpicture}
