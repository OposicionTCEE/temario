% Figura (bloque 3, «El tamaño de la empresa»): coste técnico, coste de organización y tamaño eficiente (formulación ilustrativa).
% CMe_T = F/q + c con F = 1 y c = 1 (decreciente hacia c: curva en L); CMe_O = theta q^gamma con theta = 0,12 y gamma = 1;
% CMe = CMe_T + CMe_O, en forma de U, con mínimo en q* = (F/(gamma theta))^{1/(1+gamma)} = 2,887 (CMe = 1,693).
% Escala: q 1 unidad = 1,35 cm; coste 1 unidad = 1,3 cm; recorte vertical en 3,4.
% Generar con: bash Code/generar_figura.sh b3_tamano
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1.35cm, y=1.3cm]
  \draw[->] (0,0) -- (7.6,0) node[below] {$q$};
  \draw[->] (0,0) -- (0,3.7) node[left] {$\text{\texteuro}/q$};
  \begin{scope}
    \clip (0,0) rectangle (7.2,3.4);
    \draw[very thick] plot[domain=0.3:7.0, samples=100] (\x,{1/\x+1+0.12*\x});
    \draw[thick, dashed] plot[domain=0.3:7.0, samples=100] (\x,{1/\x+1});
    \draw[thick, densely dotted] plot[domain=0:7.0, samples=20] (\x,{0.12*\x});
  \end{scope}
  \draw[dotted] (0,1) node[left] {$c$} -- (7.0,1);
  \node[right] at (7.0,1.98) {$CMe$};
  \node[right] at (7.0,1.2) {$CMe_T$};
  \node[below right] at (5.6,0.67) {$CMe_O$};
  \draw[dotted] (2.887,1.693) -- (2.887,0) node[below] {$q^{*}$};
  \fill (2.887,1.693) circle (1.5pt);
\end{tikzpicture}
