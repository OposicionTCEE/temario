% Figura (bloque 2, «Economías de escala»): rendimientos a escala de la tecnología y coste medio a largo plazo (segunda pasada, 26/10/2026).
% Fila superior: isocuantas de q, 2q y 3q de tecnologías homotéticas, hipérbolas K L = L_n^2 que cortan el radio K = L en L_n = L_1 n^{1/k}:
%   (a) constantes, k = 1: L_n = 0,9; 1,8; 2,7 (igual de separadas);
%   (b) crecientes, k = 1,6: L_n = 1,3; 1,97; 2,52 (cada vez más juntas);
%   (c) decrecientes, k = 0,7: L_n = 0,6; 1,62; 2,88 (cada vez más separadas).
% Fila inferior: coste medio a largo plazo con precios dados, CMe = c q^{1/k - 1} (en el dibujo, escalado):
%   (d) constante; (e) decreciente, q^{-0,375}; (f) creciente, q^{0,4286}.
% Escala: 1 unidad = 1 cm; columnas separadas 5,2 cm; filas separadas 4,6 cm.
% Generar con: bash Code/generar_figura.sh b2_rendimientos_costes
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  % ================= fila superior: tecnología =================
  \foreach \col/\tit/\la/\lb/\lc in {0/{(a) Rendimientos constantes}/0.9/1.8/2.7, 1/{(b) Rendimientos crecientes}/1.3/1.97/2.52, 2/{(c) Rendimientos decrecientes}/0.6/1.62/2.88} {
    \begin{scope}[xshift=\col*5.2cm]
      \node[font=\footnotesize\bfseries] at (1.85,3.75) {\tit};
      \draw[->] (0,0) -- (3.8,0) node[below] {$L$};
      \draw[->] (0,0) -- (0,3.45) node[left] {$K$};
      \begin{scope}
        \clip (0,0) rectangle (3.55,3.3);
        \foreach \l in {\la,\lb,\lc} { \draw[thick] plot[domain={\l*\l/3.3}:3.55, samples=60] (\x,{\l*\l/\x}); }
      \end{scope}
      \draw[dash dot] (0,0) -- (3.1,3.1);
      \foreach \l in {\la,\lb,\lc} { \fill (\l,\l) circle (1.3pt); }
    \end{scope}
  }
  % rótulos de las isocuantas
  \node[right] at (3.55,0.23) {$q$};
  \node[right] at (3.55,0.91) {$2q$};
  \node[right] at (3.55,2.05) {$3q$};
  \begin{scope}[xshift=5.2cm]
    \node[right] at (3.55,0.48) {$q$};
    \node[right] at (3.55,1.09) {$2q$};
    \node[right] at (3.55,1.79) {$3q$};
  \end{scope}
  \begin{scope}[xshift=10.4cm]
    \node[right] at (3.55,0.30) {$q$};
    \node[right] at (3.55,0.74) {$2q$};
    \node[right] at (3.55,2.34) {$3q$};
  \end{scope}
  % ================= fila inferior: costes =================
  \begin{scope}[yshift=-4.6cm]
    \node[font=\footnotesize\bfseries] at (1.85,3.35) {(d) Coste medio constante};
    \draw[->] (0,0) -- (3.8,0) node[below] {$q$};
    \draw[->] (0,0) -- (0,3.0) node[left] {$\text{\texteuro}/q$};
    \draw[very thick] (0.3,1.5) -- (3.3,1.5) node[above left] {$CMe_L$};
  \end{scope}
  \begin{scope}[xshift=5.2cm, yshift=-4.6cm]
    \node[font=\footnotesize\bfseries] at (1.85,3.35) {(e) Economías de escala};
    \draw[->] (0,0) -- (3.8,0) node[below] {$q$};
    \draw[->] (0,0) -- (0,3.0) node[left] {$\text{\texteuro}/q$};
    \draw[very thick] plot[domain=0.3:3.3, samples=60] (\x,{1.5*(\x/1.2)^(-0.375)}) node[above left] {$CMe_L$};
  \end{scope}
  \begin{scope}[xshift=10.4cm, yshift=-4.6cm]
    \node[font=\footnotesize\bfseries] at (1.85,3.35) {(f) Deseconomías de escala};
    \draw[->] (0,0) -- (3.8,0) node[below] {$q$};
    \draw[->] (0,0) -- (0,3.0) node[left] {$\text{\texteuro}/q$};
    \draw[very thick] plot[domain=0.3:3.3, samples=60] (\x,{1.2*(\x/1.2)^(0.4286)}) node[above left] {$CMe_L$};
  \end{scope}
\end{tikzpicture}
