% Figura (Anexo III, «Las fronteras estocásticas»): frontera determinista, frontera estocástica de cada empresa y producción observada.
% Frontera determinista f(x) = 2 x^{1/2}.
% Empresa A: x_A = 1,5; f(x_A) = 2,449; ruido v_A = 0,25 > 0: frontera estocástica f e^{v_A} = 3,145 (A*);
%   ineficiencia u_A = 0,35: producción observada y_A = f e^{v_A - u_A} = 2,216 (A), por debajo de la frontera determinista.
% Empresa B: x_B = 4; f(x_B) = 4,0; ruido v_B = -0,2 < 0: frontera estocástica 3,275 (B*); u_B = 0,15: y_B = 2,819 (B).
% Escala: x 1 unidad = 1,2 cm; producción 1 unidad = 1,1 cm. Sustituye al modelo de frontera estocástica del tema antiguo (sin figura).
% Generar con: bash Code/generar_figura.sh anx_sfa
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1.2cm, y=1.1cm]
  \draw[->] (0,0) -- (5.6,0) node[below] {$x$};
  \draw[->] (0,0) -- (0,5.0) node[left] {$y$};
  \draw[very thick] plot[domain=0:5.2, samples=100] (\x,{2*sqrt(\x)}) node[right] {$f(x)$};
  \draw[dotted] (1.5,0) node[below] {$x_A$} -- (1.5,3.145);
  \draw[dotted] (4,0) node[below] {$x_B$} -- (4,4.0);
  \draw[fill=white] (1.5,3.145) circle (1.6pt) node[left] {$A^{*}$};
  \fill (1.5,2.216) circle (1.5pt) node[right] {$A$};
  \draw[fill=white] (4,3.275) circle (1.6pt) node[right] {$B^{*}$};
  \fill (4,2.819) circle (1.5pt) node[right] {$B$};
  \node at (2.8,-0.75) {$v_A>0$, \ $v_B<0$};
\end{tikzpicture}
