% Figura (bloque 1, «Beneficio en dos etapas»): la minimización del coste como pieza común de las teorías de la empresa y de los mercados
% (segunda pasada, 26/10/2026). Arriba, la segunda etapa (cuánto producir), que cambia con el mercado; en el centro, la función de costes;
% abajo, la primera etapa (cómo producir), que solo exige precios de los factores dados e isocuantas convexas, y la tecnología.
% Generar con: bash Code/generar_figura.sh b1_pieza_comun
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=5pt]},
    caja/.style={draw, thick, rounded corners=2pt, align=center, minimum height=1.0cm, inner sep=3pt},
    ancha/.style={caja, minimum width=9.6cm}, total/.style={caja, minimum width=13.9cm}]
  % segunda etapa
  \node[caja, text width=2.9cm] (C) at (-5.25,3.3) {\textbf{Competencia}\\ $p=CMg$};
  \node[caja, text width=2.9cm] (M) at (-1.75,3.3) {\textbf{Monopolio}\\ $IMg=CMg$};
  \node[caja, text width=2.9cm] (O) at (1.75,3.3) {\textbf{Oligopolio}\\ estrategias según $C$};
  \node[caja, text width=2.9cm] (R) at (5.25,3.3) {\textbf{Pública o regulada}\\ por precio: $q$ dada};
  % función de costes
  \node[total] (F) at (0,1.35) {\textbf{Función de costes} $C(w,q)$: el coste mínimo de cada cantidad};
  % primera etapa y tecnología
  \node[ancha] (P) at (0,-0.35) {\textbf{Minimización del coste}: precios de los factores dados e isocuantas convexas};
  \node[ancha] (T) at (0,-2.05) {\textbf{Tecnología}: conjunto de producción e isocuantas};
  \foreach \n in {C,M,O,R} { \draw[->, thick] (F.north -| \n.south) -- (\n.south); }
  \draw[->, thick] (P.north) -- (F.south);
  \draw[->, thick] (T.north) -- (P.south);
  % rótulos de las etapas
  \node[anchor=west, align=left, text width=2.4cm] at (5.05,-1.2) {primera etapa:\\ cómo producir};
  \node[anchor=south] at (0,4.0) {segunda etapa: cuánto producir};
\end{tikzpicture}
