% Figura (Anexo I, «El esquema de la dualidad»): relaciones entre la tecnología y sus funciones duales.
% Centro: tecnología (f, V(q), Y). Izquierda: función de costes C(w,q) y, debajo, demandas condicionadas (SHEPHARD).
% Derecha: función de beneficios pi(p,w) y, debajo, oferta y demandas no condicionadas (HOTELLING).
% Abajo, centro: función de producción indirecta phi(w, C) (problema de SEGURA), ligada a C por inversión.
% Sustituye a Esquema_DUALIDAD_Produccion.png, TeoriaCostes_EsquemaDualidad.png y Dif_ProbMAX_PRODUCCION.png del tema antiguo.
% Generar con: bash Code/generar_figura.sh anx_esquema_dualidad
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=5pt]},
    caja/.style={draw, thick, rounded corners=2pt, align=center, minimum width=3.3cm, minimum height=1.0cm, inner sep=4pt},
    sub/.style={draw, rounded corners=2pt, align=center, minimum width=3.3cm, minimum height=0.8cm, inner sep=3pt}]
  \node[caja] (T) at (0,0) {\textbf{Tecnología}\\ $f(z)$, \ $V(q)$, \ $Y$};
  \node[caja] (C) at (-5.9,0) {\textbf{Función de costes}\\ $C(w,q)$};
  \node[caja] (P) at (5.9,0) {\textbf{Función de beneficios}\\ $\pi(p,w)$};
  \node[sub] (H) at (-5.9,-2.4) {Demandas condicionadas\\ $h(w,q)$};
  \node[sub] (Q) at (5.9,-2.4) {Oferta y demandas\\ $q(p,w)$, \ $z(p,w)$};
  \node[sub] (F) at (0,-2.4) {Producción indirecta\\ $\phi(w,\bar C)$};
  % tecnología <-> costes
  \draw[->, thick] ([yshift=3pt]T.west) -- node[above] {$\min\ w\cdot z$} ([yshift=3pt]C.east);
  \draw[->, thick] ([yshift=-3pt]C.east) -- node[below] {envolvente} ([yshift=-3pt]T.west);
  % tecnología <-> beneficios
  \draw[->, thick] ([yshift=3pt]T.east) -- node[above] {$\max\ p\,f(z)-w\cdot z$} ([yshift=3pt]P.west);
  \draw[->, thick] ([yshift=-3pt]P.west) -- node[below] {función soporte} ([yshift=-3pt]T.east);
  % costes -> beneficios
  \draw[->, thick] (C.north) to[out=40, in=140] node[above] {$\max_q\ p\,q-C(w,q)$} (P.north);
  % lemas
  \draw[->, thick] (C.south) -- node[left] {SHEPHARD} (H.north);
  \draw[->, thick] (P.south) -- node[right] {HOTELLING} (Q.north);
  % costes <-> producción indirecta
  \draw[<->, thick] (C.south east) -- node[above, sloped] {inversas} (F.north west);
\end{tikzpicture}
