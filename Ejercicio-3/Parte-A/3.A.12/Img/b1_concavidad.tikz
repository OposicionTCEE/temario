% Figura (cuerpo, B1, «Función de costes», párrafo «Propiedades»): la función de costes es cóncava en el precio de un factor.
% COBB-DOUGLAS con dos factores simétricos, q = 1 y w_2 = 1: C(w_1) = 2 (w_1)^{1/2}; h_1 = (w_1)^{-1/2}.
% Precio inicial w_1^0 = 1: C^0 = 2, h_1^0 = 1. Recta de la empresa pasiva: C^0 + h_1^0 (w_1 - w_1^0) = 1 + w_1.
% Precio menor w_1^- = 0,35 (C = 1,183; recta 1,35) y mayor w_1^+ = 2,6 (C = 3,225; recta 3,6): el tramo grueso es el ahorro por sustitución.
% Glosario: superíndices -, 0 y + = por debajo, inicial y por encima, como q_-, q_+ del bloque 2; los mismos que b1_shephard.
% Escala: 1 unidad de w_1 = 1,9 cm; 1 unidad de C = 1,2 cm.
% Generar con: bash Code/generar_figura.sh b1_concavidad
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1.9cm, y=1.2cm]
  \draw[->] (0,0) -- (3.4,0) node[below] {$w_1$};
  \draw[->] (0,0) -- (0,4.4) node[left] {$C$};
  % recta de la empresa pasiva y función de costes
  \draw[thick, dashed] (0.15,1.15) -- (3.0,4.0) node[right] {$C^0+h_1^0\,(w_1-w_1^0)$};
  \draw[very thick] plot[domain=0.15:3.0, samples=80] (\x,{2*sqrt(\x)}) node[right] {$C(w,q)$};
  % precio inicial
  \draw[dotted] (1,0) node[below] {$w_1^0$} -- (1,2) -- (0,2) node[left] {$C^0$};
  \fill (1,2) circle (1.5pt);
  % precio menor y mayor: el ahorro por sustitución
  \draw[dotted] (0.35,0) node[below] {$w_1^-$} -- (0.35,1.183);
  \draw[dotted] (2.6,0) node[below] {$w_1^+$} -- (2.6,3.225);
  \draw[line width=2.2pt, gray] (0.35,1.183) -- (0.35,1.35);
  \draw[line width=2.2pt, gray] (2.6,3.225) -- (2.6,3.6);
  \node[below] at (1.7,-0.45) {$w_2$ y $q$ dados};
\end{tikzpicture}
