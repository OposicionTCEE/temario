% Figura (bloque 2, «Envolvente»): el corto y el largo plazo en el mapa de isocuantas (rehecha en la segunda pasada, 26/10/2026).
% Misma tecnología con fases que el 3.A.11: q = (L^2/K) e^{-L/K} (rendimientos constantes), con w = r = 1.
%   Isocuanta de nivel q en paramétricas, con t = L/K: (L, K) = (q e^t / t, q e^t / t^2); vertical en t = 1 y horizontal en t = 2.
%   Líneas de contorno: K = L (PMg_K = 0) y K = L/2 (PMg_L = 0). Senda de expansión: radio L/K = 2^{1/2} (RMST = w/r = 1).
% Planta fija Kbar = 2. En la recta K = Kbar:
%   M = (2, 2): óptimo técnico = mínimo de explotación (t = 1); isocuanta q_2 = 2 e^{-1} = 0,73576.
%   O = (2,828; 2): óptimo de explotación (t = 2^{1/2}), en la senda: q_O = q* = 4 e^{-2^{1/2}} = 0,97249.
%   T = (4, 2): máximo técnico (t = 2); isocuanta q_3 = 8 e^{-2} = 1,08268.
% Largo plazo (panel b): A = (2,140; 1,513) para q_2 (coste 3,653; con la planta, M cuesta 4); E = (3,149; 2,227) para q_3
%   (coste 5,376; con la planta, T cuesta 6); en O coinciden (coste 4,828).
% Escala: 1 unidad = 1,25 cm; recorte a [0; 5,4] x [0; 4,3]; paneles separados 7,6 cm.
% Sustituye a la versión con una COBB-DOUGLAS (sin fases) de la primera pasada.
% Generar con: bash Code/generar_figura.sh b2_corto_largo
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1.25cm, y=1.25cm]
  \def\qA{0.73576}
  \def\qB{0.97249}
  \def\qC{1.08268}
  % ================= (a) Región de explotación =================
  \node[font=\footnotesize\bfseries] at (2.7,4.75) {(a) Región de explotación};
  \begin{scope}
    \clip (0,0) rectangle (5.4,4.3);
    \fill[black!8] (0,0) -- (4.3,4.3) -- (5.4,4.3) -- (5.4,2.7) -- cycle;
    \draw[thin, densely dashed] (0,0) -- (4.3,4.3);
    \draw[thin, densely dashed] (0,0) -- (5.4,2.7);
    \foreach \q in {\qA,\qB,\qC} {
      \draw[very thick] plot[domain=0.55:3.2, samples=110, variable=\t] ({\q*exp(\t)/\t},{\q*exp(\t)/(\t*\t)});
    }
    \draw[dash dot] (0,0) -- (5.4,3.818);
  \end{scope}
  \draw[->] (0,0) -- (5.75,0) node[below] {$L$};
  \draw[->] (0,0) -- (0,4.55) node[left] {$K$};
  \node[above, rotate=45, font=\scriptsize] at (0.85,0.85) {$PMg_K=0$};
  \node[below, rotate=26.57, font=\scriptsize] at (1.55,0.78) {$PMg_L=0$};
  \draw[thick] (0,2) -- (5.0,2);
  \node[left] at (0,2) {$\bar K$};
  \draw[line width=2.4pt] (2,2) -- (4,2);
  \fill (2,2) circle (1.6pt) node[above left] {$M$};
  \fill (2.828,2) circle (1.6pt) node[above=1pt] {$O$};
  \fill (4,2) circle (1.6pt) node[below right] {$T$};
  \node[right] at (5.4,1.72) {$q_2$};
  \node[below] at (2.92,1.88) {$q_O$};
  \node[above right] at (5.36,2.1) {$q_3$};
  % ================= (b) Corto y largo plazo =================
  \begin{scope}[xshift=7.6cm]
    \node[font=\footnotesize\bfseries] at (2.7,4.75) {(b) Corto y largo plazo};
    \begin{scope}
      \clip (0,0) rectangle (5.4,4.3);
      \foreach \q in {\qA,\qB,\qC} {
        \draw[very thick] plot[domain=0.55:3.2, samples=110, variable=\t] ({\q*exp(\t)/\t},{\q*exp(\t)/(\t*\t)});
      }
      \draw[dash dot] (0,0) -- (5.4,3.818);
      % isocostes de largo plazo (continuas) y de corto plazo (discontinuas)
      \draw[thin] (0,3.653) -- (3.653,0);
      \draw[thin] (0,4.828) -- (4.828,0);
      \draw[thin] (0,5.376) -- (5.376,0);
      \draw[thin, dashed] (0,4) -- (4,0);
      \draw[thin, dashed] (0,6) -- (6,0);
    \end{scope}
    \draw[->] (0,0) -- (5.75,0) node[below] {$L$};
    \draw[->] (0,0) -- (0,4.55) node[left] {$K$};
    \draw[thick] (0,2) -- (5.0,2);
    \node[left] at (0,2) {$\bar K$};
    \fill (2,2) circle (1.6pt) node[above right] {$M$};
    \fill (2.828,2) circle (1.6pt) node[above=1pt] {$O$};
    \fill (4,2) circle (1.6pt) node[above right] {$T$};
    \draw[fill=white] (2.140,1.513) circle (1.6pt) node[below=1pt] {$A$};
    \draw[fill=white] (3.149,2.227) circle (1.6pt) node[above=1pt] {$E$};
    \node[right] at (5.4,1.72) {$q_2$};
    \node[below] at (2.92,1.88) {$q_O$};
    \node[above right] at (5.36,2.1) {$q_3$};
  \end{scope}
\end{tikzpicture}
