% Figura (bloque 2, «Costes fijos y variables»): el corto y el largo plazo en el mapa de isocuantas.
% Tecnología q = (K L)^{1/2}, w = r = 1: la senda de expansión es el radio K = L y el coste a largo plazo, 2q.
% Capital fijo K_barra = 2, el óptimo para q_2 = 2. Isocuantas K = q^2 / L para q_1 = 1,2, q_2 = 2 y q_3 = 3.
%   q_1: largo plazo A = (1,2; 1,2), coste 2,4; corto plazo B = (0,72; 2), coste 2,72 (isocoste discontinua).
%   q_2: largo y corto plazo coinciden en C = (2, 2), coste 4.
%   q_3: largo plazo E = (3, 3), coste 6; corto plazo D = (4,5; 2), coste 6,5 (isocoste discontinua).
% Escala: 1 unidad = 1,05 cm; recorte a [0; 6,6] x [0; 4,2]. Sustituye a CT_Produccion_Senda.png del tema antiguo.
% Generar con: bash Code/generar_figura.sh b2_corto_largo
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1.05cm, y=1.05cm]
  \draw[->] (0,0) -- (7.0,0) node[below] {$L$};
  \draw[->] (0,0) -- (0,4.6) node[left] {$K$};
  \begin{scope}
    \clip (0,0) rectangle (6.8,4.3);
    \draw[thin] (0,2.4) -- (2.4,0);
    \draw[thin] (0,4) -- (4,0);
    \draw[thin] (0,6) -- (6,0);
    \draw[thin, dashed] (0,2.72) -- (2.72,0);
    \draw[thin, dashed] (0,6.5) -- (6.5,0);
    \draw[very thick] plot[domain=0.36:6.6, samples=80] (\x,{1.44/\x});
    \draw[very thick] plot[domain=0.96:6.6, samples=80] (\x,{4/\x});
    \draw[very thick] plot[domain=2.15:6.6, samples=80] (\x,{9/\x});
  \end{scope}
  \node[right] at (6.6,0.22) {$q_1$};
  \node[right] at (6.6,0.61) {$q_2$};
  \node[right] at (6.6,1.36) {$q_3$};
  \draw[dash dot] (0,0) -- (4.1,4.1);
  \draw[thick] (0,2) -- (6.8,2);
  \node[left] at (0,2) {$\bar K$};
  \fill (1.2,1.2) circle (1.5pt) node[below right] {$A$};
  \fill (0.72,2) circle (1.5pt) node[above left] {$B$};
  \fill (2,2) circle (1.5pt) node[above left] {$C$};
  \fill (3,3) circle (1.5pt) node[left] {$E$};
  \fill (4.5,2) circle (1.5pt) node[above right] {$D$};
\end{tikzpicture}
