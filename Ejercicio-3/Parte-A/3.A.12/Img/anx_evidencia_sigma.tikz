% Figura (Anexo III del 3.A.12, «La sustitución entre capital y trabajo»; trasladada del 3.A.11 el 30/10/2026): estimaciones de la elasticidad de sustitución entre capital y trabajo.
% Solo valores comprobados en las fuentes:
%   CHIRINKO (2008): «el peso de la evidencia» entre 0,40 y 0,60.
%   GECHERT, HAVRANEK, IRSOVA y KOLCUNOVA (2022): media corregida 0,3 (intervalo corregido 0-0,6); media sin corregir 0,9.
%   OBERFIELD y RAVAL (2021): elasticidad agregada de la industria manufacturera de EE. UU., 0,5-0,7.
%   KARABARBOUNIS y NEIMAN (2014): superior a 1 (sin cifra en la figura).
%   PIKETTY (2014): entre 1,3 y 1,6 (según citas secundarias del libro; etiquetado [Probable] en el texto).
% Escala horizontal: sigma de 0 a 1,8; 1 unidad de sigma = 4,5 cm.
% Generar con: bash Code/generar_figura.sh anx_evidencia_sigma
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=4.5cm, y=0.62cm]
  % eje
  \draw[->] (0,0) -- (1.85,0) node[right] {$\sigma$};
  \foreach \v/\t in {0/{$0$}, 0.5/{$0{,}5$}, 1/{$1$}, 1.5/{$1{,}5$}} {
    \draw (\v,0) -- (\v,-0.18) node[below] {\t};
  }
  \draw[dashed] (1,0) -- (1,6.0) node[above] {COBB-DOUGLAS};
  % filas (de arriba abajo)
  \node[left] at (-0.03,5) {CHIRINKO (2008)};
  \draw[line width=3pt, black!55] (0.40,5) -- (0.60,5);
  \node[left] at (-0.03,4) {GECHERT \textit{et al.} (2022)};
  \draw[line width=1pt] (0,4) -- (0.6,4);
  \fill (0.3,4) circle (2.2pt);
  \draw[fill=white] (0.9,4) circle (2.2pt);
  \node[left] at (-0.03,3) {OBERFIELD y RAVAL (2021)};
  \draw[line width=3pt, black!55] (0.5,3) -- (0.7,3);
  \node[left] at (-0.03,2) {KARABARBOUNIS y NEIMAN (2014)};
  \draw[->, line width=1pt] (1.0,2) -- (1.3,2);
  \node[left] at (-0.03,1) {PIKETTY (2014)};
  \draw[line width=3pt, black!55] (1.3,1) -- (1.6,1);
  % leyenda
  \node[anchor=west] at (1.08,4.0) {\scriptsize $\bullet$ corregida \quad $\circ$ sin corregir};
\end{tikzpicture}
