% Figura (Anexo II, «La sustitución con la cantidad constante»).
% Tecnología q = (K L)^{1/2}, q = 1, r = 1: demanda condicionada h_L = (r/w)^{1/2}, h_K = (w/r)^{1/2}.
% (a) Isocuanta K = 1/L; con w_0 = 1, tangencia en E_0 = (1, 1) (isocoste L + K = 2); con w_1 = 2,25, en E_1 = (0,667; 1,5)
%     (isocoste 2,25 L + K = 3). Al subir el salario, la combinación se desliza por la misma isocuanta.
% (b) Demanda condicionada de trabajo: w = 1/h_L^2, con E_0 = (1, 1) y E_1 = (0,667; 2,25).
% Escala: (a) 1 unidad = 1,7 cm; (b) h_L 1 unidad = 2,6 cm, w 1 unidad = 1,2 cm.
% Sustituye a Curva_Precio_Demanda_Factores.png y CurvaInversa_DemandaFP.png del tema antiguo.
% Generar con: bash Code/generar_figura.sh anx_demanda_condicionada
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  % ---------------- (a) La isocuanta ----------------
  \begin{scope}[x=1.7cm, y=1.7cm]
    \node[font=\footnotesize\bfseries] at (1.45,3.35) {(a) Sustitución en la isocuanta};
    \draw[->] (0,0) -- (3.2,0) node[below] {$L$};
    \draw[->] (0,0) -- (0,3.1) node[left] {$K$};
    \draw[very thick] plot[domain=0.34:3.0, samples=80] (\x,{1/\x}) node[above right] {$q$};
    \draw[thick] (0,2) -- (2,0);
    \draw[thick, dashed] (0,3) -- (1.3333,0);
    \fill (1,1) circle (1.4pt) node[above right] {$E_0$};
    \fill (0.6667,1.5) circle (1.4pt) node[above right] {$E_1$};
    \node at (1.45,-0.45) {$w_1>w_0$};
  \end{scope}
  % ---------------- (b) La demanda condicionada ----------------
  \begin{scope}[xshift=7.2cm, x=2.6cm, y=1.2cm]
    \node[font=\footnotesize\bfseries] at (1.0,4.75) {(b) Demanda condicionada de trabajo};
    \draw[->] (0,0) -- (2.1,0) node[below] {$L$};
    \draw[->] (0,0) -- (0,4.4) node[left] {$w$};
    \draw[very thick] plot[domain=0.5:1.9, samples=80] (\x,{1/(\x*\x)}) node[right] {$h_L(w,r,q)$};
    \fill (1,1) circle (1.4pt) node[above right] {$E_0$};
    \fill (0.6667,2.25) circle (1.4pt) node[above right] {$E_1$};
    \draw[dotted] (1,1) -- (0,1) node[left] {$w_0$};
    \draw[dotted] (0.6667,2.25) -- (0,2.25) node[left] {$w_1$};
    \node at (1.0,-0.65) {$r$ y $q$ dados};
  \end{scope}
\end{tikzpicture}
