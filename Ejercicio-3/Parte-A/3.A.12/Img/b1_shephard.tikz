% Figura (cuerpo, B1, «Función de costes», párrafo «Lema de SHEPHARD»): la pendiente de la función de costes es la demanda condicionada.
% Misma función que b1_concavidad: C(w_1) = 2 (w_1)^{1/2} (COBB-DOUGLAS simétrica, q = 1, w_2 = 1); h_1(w_1) = (w_1)^{-1/2}.
% (a) Tangentes en w_1^0 = 1 (pendiente h_1^0 = 1) y en w_1^+ = 2,6 (pendiente h_1^+ = 0,620).
% (b) La demanda condicionada h_1(w_1), decreciente porque C es cóncava: (w_1^0, h_1^0) = (1, 1) y (w_1^+, h_1^+) = (2,6; 0,620).
% Glosario: superíndices 0 y + como en b1_concavidad.
% Escalas: (a) 1,9 cm por unidad de w_1 y 1,2 cm por unidad de C; (b) 1,9 cm y 1,6 cm.
% Generar con: bash Code/generar_figura.sh b1_shephard
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  % ---------------- (a) La pendiente ----------------
  \begin{scope}[x=1.9cm, y=1.2cm]
    \node[font=\footnotesize\bfseries] at (1.6,4.75) {(a) La pendiente de la función de costes};
    \draw[->] (0,0) -- (3.3,0) node[below] {$w_1$};
    \draw[->] (0,0) -- (0,4.3) node[left] {$C$};
    \draw[very thick] plot[domain=0.15:3.0, samples=80] (\x,{2*sqrt(\x)}) node[below right] {$C(w,q)$};
    % tangente en w_1^0: C = 1 + w_1, con su triángulo de pendiente (base 1, altura h_1^0 = 1)
    \draw[thick, dashed] (0,1) -- (1.45,2.45);
    \draw (0,1) -- (1,1) -- (1,2);
    \node[below] at (0.5,1) {$1$};
    \node[right] at (1,1.5) {$h_1^0$};
    % tangente en w_1^+: C = 3,225 + 0,620 (w_1 - 2,6), con su triángulo (base 1, altura h_1^+ = 0,620)
    \draw[thick, dashed] (1.6,2.605) -- (3.2,3.597);
    \draw (1.6,2.605) -- (2.6,2.605) -- (2.6,3.225);
    \node[below] at (2.1,2.605) {$1$};
    \node[right] at (2.6,2.915) {$h_1^+$};
    \draw[dotted] (1,0) node[below] {$w_1^0$} -- (1,1);
    \draw[dotted] (2.6,0) node[below] {$w_1^+$} -- (2.6,2.605);
    \fill (1,2) circle (1.5pt);
    \fill (2.6,3.225) circle (1.5pt);
  \end{scope}
  % ---------------- (b) La demanda condicionada ----------------
  \begin{scope}[xshift=8.0cm, x=1.9cm, y=1.6cm]
    \node[font=\footnotesize\bfseries] at (1.6,3.56) {(b) La demanda condicionada};
    \draw[->] (0,0) -- (3.3,0) node[below] {$w_1$};
    \draw[->] (0,0) -- (0,3.2) node[left] {$h_1$};
    \draw[very thick] plot[domain=0.12:3.0, samples=80] (\x,{1/sqrt(\x)}) node[above] {$h_1(w,q)$};
    \draw[dotted] (1,0) node[below] {$w_1^0$} -- (1,1) -- (0,1) node[left] {$h_1^0$};
    \draw[dotted] (2.6,0) node[below] {$w_1^+$} -- (2.6,0.620) -- (0,0.620) node[left] {$h_1^+$};
    \fill (1,1) circle (1.5pt);
    \fill (2.6,0.620) circle (1.5pt);
  \end{scope}
\end{tikzpicture}
