% Figura (bloque 2, «Regla de cierre»): el coste medio decreciente a corto plazo no es una economía de escala (segunda pasada, 26/10/2026).
% Tecnología con rendimientos constantes q = (K L)^{1/2}, w = r = 1: coste a largo plazo 2q, coste medio a largo plazo constante = 2.
% Planta fija Kbar = 2, la óptima para q* = 2. Isocuantas K = q^2 / L para q_- = 1, q* = 2 y q_+ = 3.
% (a) Recta K = Kbar: cortes en L = 0,5; 2; 4,5 (cada vez más separados: cambian las proporciones).
%     Radio K = L: cortes en L = 1; 2; 3 (igual de separados: rendimientos constantes a escala).
% (b) Planta Kbar: CFMe = 2/q, CVMe = q/2, CTMe = 2/q + q/2 (mínimo 2 en q* = 2); CMe a largo plazo = 2 (horizontal).
% Escalas: (a) 1 unidad = 0,95 cm; (b) q 1 unidad = 1,05 cm, coste 1 unidad = 1,05 cm (recorte en 3,6).
% Generar con: bash Code/generar_figura.sh b2_corto_escala
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  % ---------------- (a) Proporciones y escala ----------------
  \begin{scope}[x=0.95cm, y=0.95cm]
    \node[font=\footnotesize\bfseries] at (2.6,4.55) {(a) Proporciones y escala};
    \draw[->] (0,0) -- (5.6,0) node[below] {$L$};
    \draw[->] (0,0) -- (0,4.2) node[left] {$K$};
    \begin{scope}
      \clip (0,0) rectangle (5.3,4.0);
      \foreach \q in {1, 2, 3} { \draw[thick] plot[domain={\q*\q/4.0}:5.3, samples=70] (\x,{\q*\q/\x}); }
    \end{scope}
    \node[right] at (5.3,0.19) {$q_-$};
    \node[right] at (5.3,0.75) {$q^*$};
    \node[right] at (5.3,1.70) {$q_+$};
    \draw[very thick] (0,2) -- (5.3,2);
    \node[left] at (0,2) {$\bar K$};
    \draw[dash dot] (0,0) -- (3.7,3.7);
    \foreach \l in {0.5, 2, 4.5} { \fill (\l,2) circle (1.4pt); }
    \foreach \l in {1, 3} { \draw[fill=white] (\l,\l) circle (1.5pt); }
    \fill (2,2) circle (1.4pt);
  \end{scope}
  % ---------------- (b) Costes medios ----------------
  \begin{scope}[xshift=7.4cm, x=1.05cm, y=1.05cm]
    \node[font=\footnotesize\bfseries] at (2.5,4.12) {(b) Costes medios};
    \draw[->] (0,0) -- (5.4,0) node[below] {$q$};
    \draw[->] (0,0) -- (0,3.8) node[left] {$\text{\texteuro}/q$};
    \begin{scope}
      \clip (0,0) rectangle (5.0,3.6);
      \draw[very thick] plot[domain=0.6:5.0, samples=70] (\x,{2/\x+\x/2});
      \draw[thin] plot[domain=0.56:5.0, samples=70] (\x,{2/\x});
      \draw[thick, dashed] (0,0) -- (5.0,2.5);
    \end{scope}
    \draw[thick, dash dot] (0,2) -- (5.0,2);
    \node[right] at (5.0,2.0) {$CMe_L$};
    \node[right] at (5.0,2.9) {$CTMe$};
    \node[right] at (5.0,2.5) {$CVMe$};
    \node[right] at (5.0,0.4) {$CFMe$};
    \draw[dotted] (2,2) -- (2,0) node[below] {$q^*$};
    \node[below] at (1,0) {$q_-$};
    \node[below] at (3,0) {$q_+$};
    \fill (2,2) circle (1.4pt);
  \end{scope}
\end{tikzpicture}
