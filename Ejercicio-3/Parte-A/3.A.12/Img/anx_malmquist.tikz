% Figura (Anexo III, «El índice de MALMQUIST»): fronteras de dos periodos con rendimientos constantes, un factor y un producto.
% Frontera en t: y = x; en t+1: y = 1,5 x. Unidad: z^t = (2; 1,4) y z^{t+1} = (3; 3,6).
% Funciones distancia (orientadas al producto): D^t(z^t) = 0,7; D^{t+1}(z^{t+1}) = 0,8; D^t(z^{t+1}) = 1,2; D^{t+1}(z^t) = 0,467.
% Malmquist = 1,714 = cambio de eficiencia (0,8/0,7 = 1,143) por cambio técnico (1,5).
% Escala: x 1 unidad = 1,3 cm; y 1 unidad = 0,95 cm.
% Glosario único (segunda pasada, 26/10/2026): factor z, producto q y unidad observada P^t, P^{t+1} (antes x, y, z^t).
% Generar con: bash Code/generar_figura.sh anx_malmquist
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1.3cm, y=0.95cm]
  \draw[->] (0,0) -- (4.2,0) node[below] {$z$};
  \draw[->] (0,0) -- (0,5.8) node[left] {$q$};
  \draw[very thick] (0,0) -- (3.9,3.9) node[right] {$F^{t}$};
  \draw[very thick, dashed] (0,0) -- (3.6,5.4) node[right] {$F^{t+1}$};
  \draw[dotted] (2,0) -- (2,3.0);
  \draw[dotted] (3,0) -- (3,4.5);
  \fill (2,1.4) circle (1.5pt) node[right] {$P^{t}$};
  \fill (3,3.6) circle (1.5pt) node[right] {$P^{t+1}$};
\end{tikzpicture}
