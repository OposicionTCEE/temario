% Figura (bloque 2 y Anexo II, «La senda de expansión y los factores inferiores»).
% (a) Isocuantas de niveles q_a < q_b < q_c < q_d, hipérbolas K = K_0 + d^2/(L - L_0), tangentes con pendiente -1 (w = r)
%     en P_a = (1,2; 0,9), P_b = (2,0; 1,7), P_c = (2,4; 2,7) y P_d = (2,2; 3,8):
%     (L_0, K_0, d) = (0,4; 0,1; 0,8), (0,9; 0,6; 1,1), (1,1; 1,4; 1,3), (1,3; 2,9; 0,9). Se comprobó que no se cortan.
%     Isocostes L + K = 2,1; 3,7; 5,1; 6,0. Senda de expansión: curva suave por el origen y P_a a P_d (de P_c a P_d, L disminuye).
% (b) Curvas de ENGEL de los factores: h_L(q) = 1,2; 2,0; 2,4; 2,2 y h_K(q) = 0,9; 1,7; 2,7; 3,8 en q_a, ..., q_d.
% Segunda pasada (26/10/2026): q_1..q_4 y P_1..P_4 pasan a llamarse q_a..q_d y P_a..P_d (glosario único: q_1, q_2, q_3 son los
%   puntos del corto plazo).
% Escala: 1 unidad = 1,05 cm. Sustituye a Senda_Expansion.png y Curva_ENGEL_FFPPs.png del tema antiguo.
% Generar con: bash Code/generar_figura.sh anx_senda_expansion
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1.05cm, y=1.05cm]
  % ---------------- (a) Senda de expansión ----------------
  \node[font=\footnotesize\bfseries] at (2.6,5.55) {(a) Senda de expansión};
  \draw[->] (0,0) -- (5.4,0) node[below] {$L$};
  \draw[->] (0,0) -- (0,5.2) node[left] {$K$};
  \begin{scope}
    \clip (0,0) rectangle (5.0,5.0);
    \foreach \c in {2.1,3.7,5.1,6.0} { \draw[thin, dashed] (0,\c) -- (\c,0); }
  \end{scope}
  \draw[thick] plot[domain=0.531:5.0, samples=80] (\x,{0.1+0.64/(\x-0.4)}) node[right] {$q_a$};
  \draw[thick] plot[domain=1.175:5.0, samples=80] (\x,{0.6+1.21/(\x-0.9)}) node[right] {$q_b$};
  \draw[thick] plot[domain=1.569:5.0, samples=80] (\x,{1.4+1.69/(\x-1.1)}) node[right] {$q_c$};
  \draw[thick] plot[domain=1.686:5.0, samples=80] (\x,{2.9+0.81/(\x-1.3)}) node[right] {$q_d$};
  \draw[very thick] plot[smooth, tension=0.6] coordinates {(0,0) (1.2,0.9) (2.0,1.7) (2.4,2.7) (2.2,3.8) (1.95,4.6)};
  \foreach \p in {{(1.2,0.9)}, {(2.0,1.7)}, {(2.4,2.7)}, {(2.2,3.8)}} { \fill \p circle (1.4pt); }
  \node[left] at (1.2,0.95) {$P_a$};
  \node[left] at (2.0,1.75) {$P_b$};
  \node[right] at (2.42,2.6) {$P_c$};
  \node[left] at (2.15,3.85) {$P_d$};
  \node at (2.6,-0.75) {$w/r$ constante};
  % ---------------- (b) Curvas de ENGEL ----------------
  \begin{scope}[xshift=7.0cm]
    \node[font=\footnotesize\bfseries] at (2.4,5.55) {(b) Curvas de ENGEL de los factores};
    \draw[->] (0,0) -- (5.0,0) node[below] {$q$};
    \draw[->] (0,0) -- (0,5.2) node[left] {$h_i$};
    \draw[very thick] plot[smooth, tension=0.6] coordinates {(0,0) (1,1.2) (2,2.0) (3,2.4) (4,2.2) (4.5,1.9)} node[right] {$h_L$};
    \draw[very thick, dashed] plot[smooth, tension=0.6] coordinates {(0,0) (1,0.9) (2,1.7) (3,2.7) (4,3.8) (4.5,4.5)} node[right] {$h_K$};
    \foreach \q/\n in {1/a,2/b,3/c,4/d} { \draw[dotted] (\q,0) node[below] {$q_\n$} -- (\q,0.12); }
    \draw[dotted] (3,2.4) -- (3,0);
    \fill (3,2.4) circle (1.4pt);
  \end{scope}
\end{tikzpicture}
