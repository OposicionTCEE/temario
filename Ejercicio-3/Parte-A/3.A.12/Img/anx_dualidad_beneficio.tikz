% Figura (Anexo I, «La función de beneficios y la tecnología»): la tecnología como envolvente de las rectas de isobeneficio.
% Función de producción con un tramo de rendimientos crecientes: q = 3 z^2 / (1 + z^2).
% Recta de isobeneficio que pasa por el origen y es tangente en z = 1 (q = 1,5): pendiente w/p = 1,5, beneficio nulo.
% Rectas tangentes en z = 1,5 (q = 2,077; pendiente 0,852; corte 0,799), z = 2 (q = 2,4; pendiente 0,48; corte 1,44)
% y z = 3 (q = 2,7; pendiente 0,18; corte 2,16). Envolvente: segmento del origen a (1; 1,5) y la curva para z >= 1.
% Escala: horizontal 1 unidad = 1,25 cm; vertical 1 unidad = 1,4 cm. Sustituye a Rel_DUALES_ConTECNOLOGICO.png.
% Generar con: bash Code/generar_figura.sh anx_dualidad_beneficio
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1.25cm, y=1.4cm]
  \draw[->] (0,0) -- (4.6,0) node[below] {$z$};
  \draw[->] (0,0) -- (0,3.3) node[left] {$q$};
  \begin{scope}
    \clip (0,0) rectangle (4.4,3.15);
    \draw[thin] (0,0) -- (2.1,3.15);
    \draw[thin] (0,0.799) -- (4.4,4.548);
    \draw[thin] (0,1.44) -- (4.4,3.552);
    \draw[thin] (0,2.16) -- (4.4,2.952);
  \end{scope}
  \draw[very thick] plot[domain=0:4.3, samples=100] (\x,{3*\x*\x/(1+\x*\x)}) node[below right] {$f(z)$};
  \draw[thick, dashed] (0,0) -- (1,1.5);
  \fill (1,1.5) circle (1.4pt) node[left] {$A$};
  \draw[dotted] (1,1.5) -- (1,0) node[below] {$z_A$};
\end{tikzpicture}
