% Figura (Anexo II, «La empresa con varias plantas»): reparto de la producción entre dos plantas.
% Planta 1: CMg_1 = q_1. Planta 2: CMg_2 = 1 + q_2 (solo produce si el coste marginal supera 1).
% Empresa: suma horizontal; con c <= 1 produce solo la planta 1 (q = c); con c > 1, q = 2c - 1 (c = (q+1)/2).
% Con c* = 2: q_1* = 2, q_2* = 1, q* = 3.
% Escala: cantidades 1 unidad = 0,9 cm; costes 1 unidad = 1,1 cm.
% Generar con: bash Code/generar_figura.sh anx_varias_plantas
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=0.9cm, y=1.1cm]
  \foreach \i/\titulo/\eje in {0/{(a) Planta 1}/{q_1}, 1/{(b) Planta 2}/{q_2}, 2/{(c) Empresa}/{q}} {
    \begin{scope}[xshift=\i*5.2cm]
      \node[font=\footnotesize\bfseries] at (1.9,3.35) {\titulo};
      \draw[->] (0,0) -- (4.2,0) node[below] {$\eje$};
      \draw[->] (0,0) -- (0,3.1) node[left] {$CMg$};
      \draw[dotted] (0,2) -- (4.0,2);
    \end{scope}
  }
  % (a)
  \draw[very thick] (0,0) -- (2.8,2.8) node[right] {$CMg_1$};
  \fill (2,2) circle (1.4pt);
  \draw[dotted] (2,2) -- (2,0) node[below] {$q_1^*$};
  \node[left] at (0,2) {$c^*$};
  % (b)
  \begin{scope}[xshift=5.2cm]
    \draw[very thick] (0,1) -- (1.9,2.9) node[right] {$CMg_2$};
    \fill (1,2) circle (1.4pt);
    \draw[dotted] (1,2) -- (1,0) node[below] {$q_2^*$};
    \node[left] at (0,2) {$c^*$};
  \end{scope}
  % (c)
  \begin{scope}[xshift=10.4cm]
    \draw[very thick] (0,0) -- (1,1) -- (4.0,2.5) node[above] {$CMg$};
    \fill (3,2) circle (1.4pt);
    \draw[dotted] (3,2) -- (3,0) node[below] {$q^*$};
    \node[left] at (0,2) {$c^*$};
  \end{scope}
\end{tikzpicture}
