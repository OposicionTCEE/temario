% Figura (bloque 2 y Anexo II, «Costes fijos y variables, mínimo y óptimo de explotación»).
% Misma tecnología que anx_espejo_costes: q = L + L^2 - L^3/3, w = 1; coste fijo CF = 0,3.
% (a) CV(q) = L(q) (paramétrica en L, de 0 a 2,414), CT = CV + 0,3, CF = 0,3.
% (b) CMg = 1/PMg, CVMe = 1/PMe, CFMe = 0,3/q, CTMe = CFMe + CVMe.
%   M: mínimo de explotación, mínimo del CVMe = CMg = 0,571 en q_2 = 2,625 (el óptimo técnico de anx_espejo_costes).
%   O: óptimo de explotación, mínimo del CTMe = CMg = 0,677 en q_O = 2,987 (L = 1,723).
%   q_3 = 3,552: máximo técnico (CMg infinito). Región de explotación: de q_2 a q_3 (llave bajo el eje).
% Segunda pasada (26/10/2026): q_M pasa a llamarse q_2, como en anx_espejo_costes (glosario único), y se añaden q_3 y la región.
% Escalas: (a) q 1 unidad = 1,25 cm, costes 1 unidad = 1,5 cm; (b) q 1 unidad = 1,25 cm, costes 1 unidad = 3,0 cm.
% Sustituye a CurvasCostes.png, CurvaCostes_VarProduccion.png y Analisis_FASES.png del tema antiguo.
% Generar con: bash Code/generar_figura.sh anx_costes_corto
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  % ---------------- (a) Costes totales ----------------
  \begin{scope}[x=1.25cm, y=1.5cm]
    \node[font=\footnotesize\bfseries] at (2.0,3.25) {(a) Costes totales};
    \draw[->] (0,0) -- (4.2,0) node[below] {$q$};
    \draw[->] (0,0) -- (0,3.0) node[left] {$C$};
    \draw[very thick] plot[domain=0:2.405, samples=120] ({\x+\x*\x-\x*\x*\x/3},{\x+0.3}) node[above] {$CT$};
    \draw[thick, dashed] plot[domain=0:2.405, samples=120] ({\x+\x*\x-\x*\x*\x/3},{\x}) node[right] {$CV$};
    \draw[thick] (0,0.3) -- (3.9,0.3) node[right] {$CF$};
  \end{scope}
  % ---------------- (b) Costes medios y marginal ----------------
  \begin{scope}[xshift=7.6cm, x=1.25cm, y=3.0cm]
    \node[font=\footnotesize\bfseries] at (2.0,1.625) {(b) Costes medios y marginal};
    \draw[->] (0,0) -- (4.2,0) node[below] {$q$};
    \draw[->] (0,0) -- (0,1.5) node[left] {$\text{\texteuro}/q$};
    \begin{scope}
      \clip (0,0) rectangle (3.75,1.42);
      \draw[very thick, dashed] plot[domain=0:2.405, samples=160] ({\x+\x*\x-\x*\x*\x/3},{1/(1+2*\x-\x*\x)});
      \draw[very thick] plot[domain=0:2.405, samples=120] ({\x+\x*\x-\x*\x*\x/3},{1/(1+\x-\x*\x/3)});
      \draw[very thick] plot[domain=0.12:2.405, samples=120] ({\x+\x*\x-\x*\x*\x/3},{0.3/(\x+\x*\x-\x*\x*\x/3)+1/(1+\x-\x*\x/3)});
      \draw[thin] plot[domain=0.12:2.405, samples=80] ({\x+\x*\x-\x*\x*\x/3},{0.3/(\x+\x*\x-\x*\x*\x/3)});
    \end{scope}
    \node at (3.95,1.32) {$CMg$};
    \node at (4.05,0.62) {$CVMe$};
    \node at (4.05,0.80) {$CTMe$};
    \node at (4.05,0.12) {$CFMe$};
    \fill (2.625,0.5714) circle (1.4pt) node[below right] {$M$};
    \fill (2.987,0.6773) circle (1.4pt) node[above left] {$O$};
    \draw[dotted] (2.625,0.5714) -- (2.625,0) node[below] {$q_2$};
    \draw[dotted] (2.987,0.6773) -- (2.987,0) node[below right=-1pt] {$q_O$};
    \draw[dotted] (3.5523,1.42) -- (3.5523,0) node[below] {$q_3$};
    \draw[decorate, decoration={brace, amplitude=4pt, mirror}] (2.625,-0.2) -- (3.5523,-0.2) node[midway, below=5pt] {región de explotación};
  \end{scope}
\end{tikzpicture}
