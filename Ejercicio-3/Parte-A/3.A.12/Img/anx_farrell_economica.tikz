% Figura (Anexo I, «Eficiencia técnica y eficiencia asignativa»): descomposición de FARRELL (1957).
% Isocuanta K = 4/L (nivel q); precios w = r = 1; isocoste de mínimo coste L + K = 4, tangente en E = (2, 2).
% Empresa observada en P = (1,6; 4,0), con coste 5,6. Radio OP: Q = 0,7906 P = (1,265; 3,162) sobre la isocuanta;
% R = 0,7143 P = (1,143; 2,857) sobre la isocoste de mínimo coste.
% ET = OQ/OP = 0,79; EA = OR/OQ = 0,90; EE = OR/OP = 0,71 = 4/5,6 (coste mínimo / coste efectivo).
% Escala: 1 unidad = 1,05 cm.
% Glosario único (segunda pasada, 26/10/2026): la proyección radial de P sobre la isocuanta se llama P', como en el DEA (antes Q).
% Generar con: bash Code/generar_figura.sh anx_farrell_economica
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1.05cm, y=1.05cm]
  \draw[->] (0,0) -- (5.6,0) node[below] {$L$};
  \draw[->] (0,0) -- (0,5.2) node[left] {$K$};
  \draw[very thick] plot[domain=0.8:5.1, samples=80] (\x,{4/\x}) node[right] {$q$};
  \draw[thick] (0,4) -- (4,0);
  \draw[dashed] (0,0) -- (1.6,4.0);
  \node[below left] at (0,0) {$O$};
  \fill (1.6,4.0) circle (1.4pt) node[right] {$P$};
  \fill (1.265,3.162) circle (1.4pt) node[right] {$P'$};
  \fill (1.143,2.857) circle (1.4pt) node[left] {$R$};
  \fill (2,2) circle (1.4pt) node[above right] {$E$};
\end{tikzpicture}
