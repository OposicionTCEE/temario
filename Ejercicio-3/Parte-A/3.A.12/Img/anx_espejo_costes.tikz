% Figura (Anexo II, «Las curvas de coste como reflejo de las productividades»).
% Producción a corto plazo (capital fijo): q = L + L^2 - L^3/3; PMg = 1 + 2L - L^2; PMe = 1 + L - L^2/3; w = 1.
%   L_1 = 1 (máximo de la PMg = 2; q_1 = 1,667); L_2 = 1,5 (máximo de la PMe = PMg = 1,75; q_2 = 2,625);
%   L_3 = 1 + 2^{1/2} = 2,414 (PMg = 0; q_3 = 3,552).
% (a) PMg y PMe frente a L. (b) CMg = w/PMg y CVMe = w/PMe frente a q (curvas paramétricas en L):
%   mínimo del CMg = 0,5 en q_1; mínimo del CVMe = CMg = 0,571 en q_2; CMg infinito en q_3. Recorte vertical en 1,5.
% Escalas: (a) L 1 unidad = 3,4 cm, productividades 1 unidad = 1,7 cm; (b) q 1 unidad = 2,3 cm, costes 1 unidad = 3,2 cm.
% Generar con: bash Code/generar_figura.sh anx_espejo_costes
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  % ---------------- (a) Productividades ----------------
  \begin{scope}[x=3.4cm, y=1.7cm]
    \node[font=\footnotesize\bfseries] at (1.35,2.55) {(a) Productividades del factor variable};
    \draw[->] (0,0) -- (2.75,0) node[below] {$L$};
    \draw[->] (0,-0.35) -- (0,2.3) node[left] {$PMg_L$, $PMe_L$};
    \draw[very thick, dashed] plot[domain=0:2.5, samples=80] (\x,{1+2*\x-\x*\x});
    \node at (2.32,0.95) {$PMg_L$};
    \draw[very thick] plot[domain=0:2.6, samples=80] (\x,{1+\x-\x*\x/3}) node[right] {$PMe_L$};
    \draw[dotted] (1,2) -- (1,0) node[below] {$L_1$};
    \draw[dotted] (1.5,1.75) -- (1.5,0) node[below] {$L_2$};
    \node[below] at (2.414,0) {$L_3$};
    \fill (1,2) circle (1.3pt);
    \fill (1.5,1.75) circle (1.3pt);
    \fill (2.414,0) circle (1.3pt);
  \end{scope}
  % ---------------- (b) Costes ----------------
  \begin{scope}[yshift=-6.9cm, x=2.3cm, y=3.2cm]
    \node[font=\footnotesize\bfseries] at (1.85,1.72) {(b) Costes marginal y variable medio};
    \draw[->] (0,0) -- (4.0,0) node[below] {$q$};
    \draw[->] (0,0) -- (0,1.55) node[left] {$CMg$, $CVMe$};
    \begin{scope}
      \clip (0,0) rectangle (3.75,1.5);
      \draw[very thick, dashed] plot[domain=0:2.405, samples=160] ({\x+\x*\x-\x*\x*\x/3},{1/(1+2*\x-\x*\x)});
      \draw[very thick] plot[domain=0:2.405, samples=120] ({\x+\x*\x-\x*\x*\x/3},{1/(1+\x-\x*\x/3)});
    \end{scope}
    \node at (3.45,1.38) {$CMg$};
    \node at (3.8,0.72) {$CVMe$};
    \draw[dotted] (1.6667,0.5) -- (1.6667,0) node[below] {$q_1$};
    \draw[dotted] (2.625,0.5714) -- (2.625,0) node[below] {$q_2$};
    \draw[dotted] (3.5523,1.5) -- (3.5523,0) node[below] {$q_3$};
    \fill (1.6667,0.5) circle (1.3pt);
    \fill (2.625,0.5714) circle (1.3pt);
  \end{scope}
\end{tikzpicture}
