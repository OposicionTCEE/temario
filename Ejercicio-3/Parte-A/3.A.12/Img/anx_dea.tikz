% Figura (Anexo III, «El análisis envolvente de datos»).
% (a) Dos factores por unidad de producto: unidades eficientes A = (1,0; 4,0), B = (1,5; 2,2), C = (2,5; 1,4), D = (4,2; 1,0)
%     (pendientes -3,6; -0,8; -0,235: frontera convexa); ineficientes E = (3,2; 2,4), F = (2,2; 3,4) y P = (3,0; 3,0).
%     Proyección radial de P sobre el tramo BC: P' = (1,889; 1,889); eficiencia theta = OP'/OP = 0,63.
%     Tramo vertical por encima de A y horizontal a la derecha de D (eliminación gratuita).
% (b) Un factor y un producto: frontera con rendimientos constantes, el radio y = 1,5 x que pasa por H (máximo y/x);
%     frontera con rendimientos variables, G = (1,5; 1), H = (2, 3), J = (4; 4,5), K = (5, 5) (pendientes 4; 0,75; 0,5).
%     Unidad P = (4,5; 2): proyecciones horizontales P_C = (1,333; 2) y P_V = (1,75; 2);
%     ET con constantes = 0,296; con variables = 0,389; eficiencia de escala = 0,762.
% Escalas: (a) 1 unidad = 1,25 cm; (b) 1 unidad = 0,95 cm. Sustituye a Frontera_DEA.png del tema antiguo.
% Generar con: bash Code/generar_figura.sh anx_dea
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  % ---------------- (a) Dos factores ----------------
  \begin{scope}[x=1.25cm, y=1.25cm]
    \node[font=\footnotesize\bfseries] at (2.5,5.15) {(a) Frontera con dos factores};
    \draw[->] (0,0) -- (5.1,0) node[below] {$z_1/q$};
    \draw[->] (0,0) -- (0,4.9) node[left] {$z_2/q$};
    \draw[very thick] (1.0,4.7) -- (1.0,4.0) -- (1.5,2.2) -- (2.5,1.4) -- (4.2,1.0) -- (4.9,1.0);
    \draw[dashed] (0,0) -- (3.0,3.0);
    \foreach \p/\n/\pos in {{(1.0,4.0)}/A/left, {(1.5,2.2)}/B/left, {(2.5,1.4)}/C/below left, {(4.2,1.0)}/D/below} {
      \fill \p circle (1.5pt) node[\pos] {$\n$};
    }
    \foreach \p/\n in {{(3.2,2.4)}/E, {(2.2,3.4)}/F, {(3.0,3.0)}/P} {
      \fill \p circle (1.5pt) node[above right] {$\n$};
    }
    \draw[fill=white] (1.889,1.889) circle (1.6pt) node[below left] {$P'$};
    \node[below left] at (0,0) {$O$};
  \end{scope}
  % ---------------- (b) Un factor y un producto ----------------
  \begin{scope}[xshift=7.6cm, x=0.95cm, y=0.95cm]
    \node[font=\footnotesize\bfseries] at (2.9,6.75) {(b) Rendimientos constantes y variables};
    \draw[->] (0,0) -- (6.1,0) node[below] {$z$};
    \draw[->] (0,0) -- (0,6.4) node[left] {$q$};
    \draw[thick, dashed] (0,0) -- (3.9,5.85);
    \draw[very thick] (1.5,0) -- (1.5,1) -- (2,3) -- (4,4.5) -- (5,5) -- (5.9,5);
    \foreach \p/\n/\pos in {{(1.5,1)}/G/right, {(2,3)}/H/below right, {(4,4.5)}/J/above, {(5,5)}/K/above} {
      \fill \p circle (1.5pt) node[\pos] {$\n$};
    }
    \fill (4.5,2) circle (1.5pt) node[right] {$P$};
    \draw[dotted] (1.333,2) -- (4.5,2);
    \draw[fill=white] (1.333,2) circle (1.6pt) node[left] {$P_C$};
    \draw[fill=white] (1.75,2) circle (1.6pt) node[below right] {$P_V$};
  \end{scope}
\end{tikzpicture}
