% Figura (Anexo I, «Cuándo no hay solución»): ingreso pq y coste C(q) de una empresa precio-aceptante.
% (a) Rendimientos decrecientes: C = q^2/2 (C'' > 0), p = 2: máximo en q* = 2 (C' = p), beneficio 2; tangente a C paralela al ingreso.
% (b) Rendimientos constantes: C = c q con c = 1,4 < p = 2: el beneficio crece sin límite con q.
% (c) Rendimientos crecientes: C = 2,4 q^{1/2} (C'' < 0), p = 1,2: en q^ = 1 se cumple p = C'(q^), pero es un mínimo del beneficio
%     (ingreso 1,2, coste 2,4); el ingreso supera al coste a partir de q = 4.
% Escala: horizontal 1 unidad = 0,95 cm; vertical 1 unidad = 0,62 cm.
% Generar con: bash Code/generar_figura.sh anx_beneficio_rendimientos
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  \foreach \i/\titulo/\cond in {0/{(a) Rendimientos decrecientes}/{$C''(q)>0$}, 1/{(b) Rendimientos constantes}/{$C''(q)=0$, \ $p>c$}, 2/{(c) Rendimientos crecientes}/{$C''(q)<0$}} {
    \begin{scope}[xshift=\i*5.25cm, x=0.95cm, y=0.62cm]
      \node[font=\footnotesize\bfseries] at (2.3,8.2) {\titulo};
      \draw[->] (0,0) -- (4.7,0) node[below] {$q$};
      \draw[->] (0,0) -- (0,7.6) node[left] {$\text{\texteuro}$};
      \node at (2.3,-1.3) {\cond};
    \end{scope}
  }
  % (a)
  \begin{scope}[x=0.95cm, y=0.62cm]
    \draw[very thick] plot[domain=0:3.7, samples=60] (\x,{0.5*\x*\x}) node[right] {$C(q)$};
    \draw[thick, dashed] (0,0) -- (3.6,7.2) node[right] {$pq$};
    \draw[dotted] (1.2,0.4) -- (3.0,4.0);
    \draw[dotted] (2,4) -- (2,0) node[below] {$q^*$};
    \fill (2,2) circle (1.3pt);
    \fill (2,4) circle (1.3pt);
  \end{scope}
  % (b)
  \begin{scope}[xshift=5.25cm, x=0.95cm, y=0.62cm]
    \draw[very thick] (0,0) -- (4.4,6.16) node[right] {$C(q)$};
    \draw[thick, dashed] (0,0) -- (3.6,7.2) node[right] {$pq$};
  \end{scope}
  % (c)
  \begin{scope}[xshift=10.5cm, x=0.95cm, y=0.62cm]
    \draw[very thick] plot[domain=0:4.5, samples=80] (\x,{2.4*sqrt(\x)}) node[above right] {$C(q)$};
    \draw[thick, dashed] (0,0) -- (4.5,5.4) node[right] {$pq$};
    \draw[dotted] (1,2.4) -- (1,0) node[below] {$\hat q$};
    \fill (1,2.4) circle (1.3pt);
    \fill (1,1.2) circle (1.3pt);
  \end{scope}
\end{tikzpicture}
