% Figura (Anexo I, «Condiciones de primer y segundo orden» de la maximización del beneficio).
% Un factor: q = f(z) = 2 z^{1/2}; rectas de isobeneficio q = pi/p + (w/p) z con w/p = 1/2.
% Tangencia: f'(z) = z^{-1/2} = 1/2 -> z* = 4, q* = 4, pi*/p = 4 - 2 = 2 (recta q = 2 + z/2).
% Recta inferior q = 1 + z/2 (corta la función); recta superior q = 3 + z/2 (no la alcanza).
% Escala: 1 unidad = 0,95 cm. Sustituye a SCEDINC_IB_FP_CSO.png del tema antiguo.
% Generar con: bash Code/generar_figura.sh anx_isobeneficio
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=0.95cm, y=0.95cm]
  \draw[->] (0,0) -- (7.4,0) node[below] {$z$};
  \draw[->] (0,0) -- (0,6.9) node[left] {$q$};
  \draw[very thick] plot[domain=0:7, samples=100] (\x,{2*sqrt(\x)}) node[right] {$f(z)$};
  \draw[dashed] (0,1) -- (7,4.5);
  \draw[thick] (0,2) -- (7,5.5);
  \draw[dashed] (0,3) -- (7,6.5);
  \node[left] at (0,1) {$\pi_0/p$};
  \node[left] at (0,2) {$\pi^*/p$};
  \node[left] at (0,3) {$\pi_2/p$};
  \draw[dotted] (4,4) -- (4,0) node[below] {$z^*$};
  \fill (4,4) circle (1.4pt) node[above left] {$E$};
\end{tikzpicture}
