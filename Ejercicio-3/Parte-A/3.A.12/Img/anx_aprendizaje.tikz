% Figura (Anexo III, «La curva de aprendizaje»): coste unitario y producción acumulada, curva del 80 %.
% c(Q) = c_1 (Q/Q_1)^{-b} con b = -log_2(0,8) = 0,322: c = 1; 0,8; 0,64; 0,512 en Q = Q_1, 2Q_1, 4Q_1, 8Q_1.
% (a) Niveles: Q de 0,5 a 8,5 (en unidades de Q_1). (b) Logaritmos: recta de pendiente -b; puntos equiespaciados
%     (ln 2 = 0,693 entre cada duplicación), con el eje vertical desplazado (ln c + 0,75).
% Escalas: (a) Q 1 unidad = 0,72 cm, c 1 unidad = 3,6 cm; (b) ln Q 1 unidad = 2,4 cm, ln c 1 unidad = 4,0 cm.
% Generar con: bash Code/generar_figura.sh anx_aprendizaje
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  % ---------------- (a) Niveles ----------------
  \begin{scope}[x=0.72cm, y=3.6cm]
    \node[font=\footnotesize\bfseries] at (4.5,1.47) {(a) Coste unitario y producción acumulada};
    \draw[->] (0,0) -- (9.2,0) node[below] {$Q$};
    \draw[->] (0,0) -- (0,1.35) node[left] {$c$};
    \draw[very thick] plot[domain=0.5:8.6, samples=80] (\x,{\x^(-0.322)}) node[above right] {$c(Q)$};
    \foreach \Q/\c/\et in {1/1/{Q_1}, 2/0.8/{2Q_1}, 4/0.64/{4Q_1}, 8/0.512/{8Q_1}} {
      \fill (\Q,\c) circle (1.4pt);
      \draw[dotted] (\Q,\c) -- (\Q,0) node[below] {$\et$};
    }
    \draw[dotted] (1,1) -- (0,1) node[left] {$c_1$};
    \draw[dotted] (2,0.8) -- (0,0.8) node[left] {$0{,}8\,c_1$};
    \draw[dotted] (4,0.64) -- (0,0.64) node[left] {$0{,}64\,c_1$};
  \end{scope}
  % ---------------- (b) Logaritmos ----------------
  \begin{scope}[xshift=9.0cm, x=2.4cm, y=4.0cm]
    \node[font=\footnotesize\bfseries] at (1.1,1.33) {(b) En logaritmos};
    \draw[->] (0,0) -- (2.5,0) node[below] {$\ln Q$};
    \draw[->] (0,0) -- (0,1.2) node[left] {$\ln c$};
    \draw[very thick] (0,0.75) -- (2.3,0.0094);
    \foreach \x/\et in {0/{Q_1}, 0.693/{2Q_1}, 1.386/{4Q_1}, 2.079/{8Q_1}} {
      \fill (\x,{0.75-0.322*\x}) circle (1.4pt);
      \draw[dotted] (\x,{0.75-0.322*\x}) -- (\x,0) node[below] {$\et$};
    }
    \node at (1.55,0.62) {pendiente $-b$};
  \end{scope}
\end{tikzpicture}
