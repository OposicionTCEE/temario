% Figura (Anexo I, «Propiedades respecto de los precios y lema de SHEPHARD»): la función de costes es cóncava en los precios.
% Tecnología q = (z_1 z_2)^{1/2}, con q = 1 y w_2 = 1: C(w_1) = 2 (w_1)^{1/2}; h_1 = (w_2/w_1)^{1/2}.
% En w_1^0 = 1: C^0 = 2 y h_1^0 = 1. Coste «pasivo» (sin sustituir factores): C^0 + h_1^0 (w_1 - w_1^0) = w_1 + 1, tangente en w_1^0.
% Escala: eje horizontal 1 unidad = 1,45 cm; vertical 1 unidad = 1,05 cm.
% Generar con: bash Code/generar_figura.sh anx_concavidad_costes
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1.45cm, y=1.05cm]
  \draw[->] (0,0) -- (3.7,0) node[below] {$w_1$};
  \draw[->] (0,0) -- (0,4.6) node[left] {$C$};
  \draw[very thick] plot[domain=0.12:3.3, samples=80] (\x,{2*sqrt(\x)}) node[right] {$C(w,q)$};
  \draw[thick, dashed] (0.15,1.15) -- (3.3,4.3) node[right] {$C^0+h_1^0\,(w_1-w_1^0)$};
  \draw[dotted] (1,2) -- (1,0) node[below] {$w_1^0$};
  \draw[dotted] (1,2) -- (0,2) node[left] {$C^0$};
  \fill (1,2) circle (1.4pt);
  \node at (1.85,-0.75) {$w_2$ y $q$ dados};
\end{tikzpicture}
