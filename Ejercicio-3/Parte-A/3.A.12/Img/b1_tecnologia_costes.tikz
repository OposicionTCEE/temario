% Figura (bloque 1, «Dualidad»): dos rasgos de la tecnología y su reflejo en los costes (segunda pasada, 26/10/2026).
% (a) Tecnología homotética: isocuantas K L = c (c = 1; 2,25; 4, copias ampliadas de una misma curva), isocostes paralelas de
%     pendiente -1 tangentes en (1,1), (1,5;1,5) y (2,2): la senda de expansión es el radio K = L.
% (b) Costes separables, C(w,q) = c(w) phi(q): dos precios de los factores, con c(w') = 1,6 c(w); phi(q) = q + 0,25 q^2
%     (misma forma, una curva es la otra multiplicada por 1,6).
% (c) Rendimientos constantes: isocuantas K L = q^2 con q, 2q y 3q (q = 0,8): cortes con el radio en 0,8; 1,6; 2,4, igual de separados.
% (d) Coste proporcional: C = c(w) q, recta desde el origen con pendiente c(w) = 0,8 (CMe = CMg constantes).
% Escala: 1 unidad = 1 cm; paneles separados 3,9 cm.
% Generar con: bash Code/generar_figura.sh b1_tecnologia_costes
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  % ---------------- (a) Homotética ----------------
  \node[font=\footnotesize\bfseries] at (1.6,3.55) {(a) Homotética};
  \draw[->] (0,0) -- (3.3,0) node[below] {$L$};
  \draw[->] (0,0) -- (0,3.2) node[left] {$K$};
  \begin{scope}
    \clip (0,0) rectangle (3.2,3.0);
    \foreach \c in {1, 2.25, 4} { \draw[thick] plot[domain={\c/3.0}:3.2, samples=60] (\x,{\c/\x}); }
    \foreach \t in {1, 1.5, 2} { \draw[densely dotted] ({\t-0.9},{\t+0.9}) -- ({\t+0.9},{\t-0.9}); }
  \end{scope}
  \draw[dash dot] (0,0) -- (2.75,2.75);
  \foreach \t in {1, 1.5, 2} { \fill (\t,\t) circle (1.3pt); }
  % ---------------- (b) Costes separables ----------------
  \begin{scope}[xshift=3.9cm]
    \node[font=\footnotesize\bfseries] at (1.6,3.55) {(b) Costes separables};
    \draw[->] (0,0) -- (3.3,0) node[below] {$q$};
    \draw[->] (0,0) -- (0,3.2) node[left] {$C$};
    \draw[very thick] plot[domain=0:2.6, samples=50] (\x,{0.55*(\x+0.25*\x*\x)}) node[right] {$C(w,q)$};
    \draw[very thick, dashed] plot[domain=0:2.25, samples=50] (\x,{0.88*(\x+0.25*\x*\x)}) node[above] {$C(w',q)$};
  \end{scope}
  % ---------------- (c) Rendimientos constantes ----------------
  \begin{scope}[xshift=7.8cm]
    \node[font=\footnotesize\bfseries] at (1.6,3.55) {(c) Rendimientos constantes};
    \draw[->] (0,0) -- (3.3,0) node[below] {$L$};
    \draw[->] (0,0) -- (0,3.2) node[left] {$K$};
    \begin{scope}
      \clip (0,0) rectangle (3.2,3.0);
      \foreach \q in {0.8, 1.6, 2.4} { \draw[thick] plot[domain={\q*\q/3.0}:3.2, samples=60] (\x,{\q*\q/\x}); }
    \end{scope}
    \draw[dash dot] (0,0) -- (2.75,2.75);
    \foreach \q/\et in {0.8/{$q$}, 1.6/{$2q$}, 2.4/{$3q$}} { \fill (\q,\q) circle (1.3pt); }
    \node[right] at (3.2,0.2) {$q$};
    \node[right] at (3.2,0.8) {$2q$};
    \node[right] at (3.2,1.8) {$3q$};
  \end{scope}
  % ---------------- (d) Coste proporcional ----------------
  \begin{scope}[xshift=11.7cm]
    \node[font=\footnotesize\bfseries] at (1.6,3.55) {(d) Coste proporcional};
    \draw[->] (0,0) -- (3.3,0) node[below] {$q$};
    \draw[->] (0,0) -- (0,3.2) node[left] {$C$};
    \draw[very thick] (0,0) -- (3.0,2.4) node[above left] {$C=c(w)\,q$};
    \draw[densely dotted] (1.5,1.2) -- (2.5,1.2) -- (2.5,2.0);
    \node[below] at (2.0,1.2) {$1$};
    \node[right] at (2.5,1.6) {$c(w)$};
  \end{scope}
\end{tikzpicture}
