% Figura (Anexo III, «Las economías de escala en la electricidad»): curva de coste medio a largo plazo estimada (ilustrativa).
% CMe(q) = 2 + 3 exp(-1,6 q) + 0,02 q, para q de 0,15 a 6: disminuye deprisa y es casi plana a partir de q_E = 2,5
% (en q_E el coste medio supera su mínimo en menos de un 2 %). Puntos: empresas ilustrativas, la mayoría en el tramo plano.
% Escala: q 1 unidad = 2,1 cm; coste 1 unidad = 1,25 cm. Curva ilustrativa, sin datos.
% Generar con: bash Code/generar_figura.sh anx_costes_estimados
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=2.1cm, y=1.25cm]
  \draw[->] (0,0) -- (6.4,0) node[below] {$q$};
  \draw[->] (0,0) -- (0,4.6) node[left] {$\text{\texteuro}/q$};
  \draw[very thick] plot[domain=0.15:6.0, samples=100] (\x,{2+3*exp(-1.6*\x)+0.02*\x}) node[right] {$CMe_L$};
  \foreach \q in {0.35,0.6,0.9,1.3,1.8,2.6,2.9,3.3,3.6,3.9,4.3,4.6,5.0,5.4} {
    \fill (\q,{2+3*exp(-1.6*\q)+0.02*\q}) circle (1.5pt);
  }
  \draw[dotted] (2.5,{2+3*exp(-4)+0.05}) -- (2.5,0) node[below] {$q_E$};
\end{tikzpicture}
