% Figura (bloque 3, «Sustitución»): del corto al largo plazo, salto frente a ajuste gradual del capital (segunda pasada, 26/10/2026).
% En t_0 un cambio de los precios eleva el capital deseado de K_0 = 1 a K_1 = 2,5.
% Distinción clásica (discontinua): el capital sigue en K_0 hasta t_1 = 4 y salta entonces a K_1.
% Costes de ajuste (continua, LUCAS, 1967): K(t) = K_1 - (K_1 - K_0) e^{-0,7 (t - t_0)} para t >= t_0 = 1, que cierra en cada periodo
% una parte constante de la distancia entre el capital deseado y el existente.
% Escala: t, 1 unidad = 1,25 cm; K, 1 unidad = 1,2 cm.
% Generar con: bash Code/generar_figura.sh b3_ajuste
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1.25cm, y=1.2cm]
  \draw[->] (0,0) -- (6.6,0) node[below] {$t$};
  \draw[->] (0,0) -- (0,3.1) node[left] {$K$};
  \draw[dotted] (0,2.5) node[left] {$K_1$} -- (6.2,2.5);
  \node[left] at (0,1) {$K_0$};
  % distinción clásica: salto en t_1
  \draw[thick, dashed] (0,1) -- (4,1) -- (4,2.5) -- (6.2,2.5);
  % ajuste gradual
  \draw[very thick] (0,1) -- (1,1);
  \draw[very thick] plot[domain=1:6.2, samples=80] (\x,{2.5-1.5*exp(-0.7*(\x-1))});
  \draw[dotted] (1,1) -- (1,0) node[below] {$t_0$};
  \draw[dotted] (4,1) -- (4,0) node[below] {$t_1$};
\end{tikzpicture}
