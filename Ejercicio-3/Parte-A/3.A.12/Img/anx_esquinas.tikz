% Figura (Anexo I, «Soluciones de esquina»).
% (a) Sustitutos perfectos q = aL + bK con a = 1, b = 2 y q = 4: isocuanta de (0, 2) a (4, 0), pendiente -a/b = -1/2.
%     Con w = r (w/r = 1 > a/b), el capital es más barato por unidad de producto: esquina E = (0, 2), con coste 2;
%     la otra esquina, B = (4, 0), cuesta 4 (isocoste discontinua).
% (b) Proporciones fijas q = min{L/a, K/b}: vértice E = (2; 1,5). Isocostes que pasan por E con w/r = 0,6 y w/r = 1,6:
%     las dos tocan la isocuanta solo en el vértice.
% Escala: 1 unidad = 1,05 cm. Sustituye, junto con anx_tangencia, a ISOCUANTAS_PMIN.png.
% Generar con: bash Code/generar_figura.sh anx_esquinas
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1.05cm, y=1.05cm]
  % ---------------- (a) Sustitutos perfectos ----------------
  \node[font=\footnotesize\bfseries] at (2.4,5.1) {(a) Sustitutos perfectos};
  \draw[->] (0,0) -- (5.0,0) node[below] {$L$};
  \draw[->] (0,0) -- (0,4.7) node[left] {$K$};
  \draw[very thick] (0,2) -- (4,0);
  \node[above] at (1.2,1.42) {$q$};
  \draw[thick] (0,2) -- (2,0);
  \draw[dashed] (0,4) -- (4,0);
  \fill (0,2) circle (1.4pt) node[left] {$E$};
  \fill (4,0) circle (1.4pt) node[below] {$B$};
  \node at (2.4,-0.75) {$w/r>a/b$};
  % ---------------- (b) Proporciones fijas ----------------
  \begin{scope}[xshift=6.4cm]
    \node[font=\footnotesize\bfseries] at (2.4,5.1) {(b) Proporciones fijas};
    \draw[->] (0,0) -- (5.0,0) node[below] {$L$};
    \draw[->] (0,0) -- (0,4.7) node[left] {$K$};
    \draw[very thick] (2,4.4) -- (2,1.5) -- (4.7,1.5) node[above] {$q$};
    \draw[dashed] (0,2.7) -- (4.5,0);
    \draw[dashed] (0.12,4.5) -- (2.9375,0);
    \fill (2,1.5) circle (1.4pt) node[below left] {$E$};
    \node at (2.4,-0.75) {$w/r$ cualquiera};
  \end{scope}
\end{tikzpicture}
