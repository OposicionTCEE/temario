% Figura (cuerpo, B1, «Eficiencia económica»): descomposición de FARRELL (1957) sobre una frontera construida con empresas observadas,
% como hizo el propio FARRELL y, después, el DEA de CHARNES, COOPER y RHODES (1978).
% Factores por unidad de producto (L/q, K/q), lo que supone rendimientos constantes.
% Empresas de la frontera: A = (1,0; 4,4), B = (1,5; 2,6), E = (2,4; 1,6), D = (4,2; 1,05) (pendientes -3,6; -1,11; -0,31: convexa),
% con tramo vertical sobre A y horizontal a la derecha de D (eliminación gratuita). Solo se rotulan B y E, los referentes de P.
% Empresas interiores: P = (2,75; 3,3) y cinco más sin rótulo.
% Precios w/r = 0,45: isocoste de mínimo coste 0,45 L + K = 2,68, que toca la frontera en E (B cuesta 3,28; D, 2,94; A, 4,85).
% Radio OP (K/L = 1,2): P' = (1,846; 2,215) en el tramo BE; R = (1,624; 1,949) en la isocoste.
% ET = OP'/OP = 0,67; EA = OR/OP' = 0,88; EE = OR/OP = 0,59.
% Glosario del tema: P, P', R y E como en anx_farrell_economica (anexo I) y anx_tangencia.
% Generar con: bash Code/generar_figura.sh b1_farrell_frontera
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1.25cm, y=1.25cm]
  \draw[->] (0,0) -- (5.4,0) node[below] {$L/q$};
  \draw[->] (0,0) -- (0,5.0) node[left] {$K/q$};
  % Frontera construida con las mejores empresas
  \draw[thick, dashed] (1.0,4.85) -- (1.0,4.4) -- (1.5,2.6) -- (2.4,1.6) -- (4.2,1.05) -- (5.1,1.05) node[above] {$q=1$};
  % Isocoste de mínimo coste
  \draw[thick] (0,2.68) -- (5.3,0.295);
  % Radio de P
  \draw[dotted, thick] (0,0) -- (2.75,3.3);
  % Empresas
  \foreach \p in {(1.0,4.4), (4.2,1.05), (3.4,2.3), (2.1,3.95), (4.3,1.9), (1.8,4.55), (3.5,3.6)} {
    \fill \p circle (1.5pt);
  }
  \fill (1.5,2.6) circle (1.5pt) node[left] {$B$};
  \fill (2.4,1.6) circle (1.5pt) node[above right] {$E$};
  \fill (2.75,3.3) circle (1.5pt) node[right] {$P$};
  \draw[fill=white] (1.846,2.215) circle (1.6pt) node[right=1pt] {$P'$};
  \draw[fill=white] (1.624,1.949) circle (1.6pt) node[below left] {$R$};
  \node[below left] at (0,0) {$O$};
\end{tikzpicture}
