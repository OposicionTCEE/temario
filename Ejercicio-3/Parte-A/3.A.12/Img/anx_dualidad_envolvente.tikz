% Figura (Anexo I, «De la función de costes a la tecnología»): la tecnología como envolvente de las isocostes.
% (a) Isocuanta convexa K = 4/L. Isocostes de mínimo coste tangentes en L = t, t = 1; 1,4; 2; 2,8; 4:
%     K = 8/t - (4/t^2) L (cortes: K = 8/t, L = 2t). Su envolvente reproduce la isocuanta.
% (b) Isocuanta no convexa K = 4/L + 0,9 exp(-((L-2)/0,42)^2), con un tramo cóncavo entre L = 1,75 y 2,25.
%     Envolvente convexa: segmento bitangente entre (1,42; 2,951) y (2,668; 1,571), pendiente -1,105 (cortes: K = 4,520; L = 4,089).
%     Isocostes de apoyo en L = 1 (K = 8,0 - 3,965 L) y L = 3,6 (K = 2,222 - 0,309 L); la bitangente es también una isocoste.
% Escala: 1 unidad = 1,0 cm; recorte del dibujo a [0; 5,3] x [0; 5,3]. Sustituye a Esquema_DUALIDAD_Produccion.png (en parte).
% Generar con: bash Code/generar_figura.sh anx_dualidad_envolvente
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1.0cm, y=1.0cm]
  % ---------------- (a) Isocuanta convexa ----------------
  \node[font=\footnotesize\bfseries] at (2.7,5.85) {(a) Isocuanta convexa};
  \draw[->] (0,0) -- (5.6,0) node[below] {$L$};
  \draw[->] (0,0) -- (0,5.5) node[left] {$K$};
  \begin{scope}
    \clip (0,0) rectangle (5.3,5.3);
    \foreach \t in {1.0,1.4,2.0,2.8,4.0} {
      \draw[thin] (0,{8/\t}) -- ({2*\t},0);
    }
  \end{scope}
  \draw[very thick] plot[domain=0.76:5.2, samples=80] (\x,{4/\x}) node[above right] {$V(q)$};
  \node at (2.7,-0.75) {$V(q)$ convexo};
  % ---------------- (b) Isocuanta no convexa ----------------
  \begin{scope}[xshift=7.0cm]
    \node[font=\footnotesize\bfseries] at (2.7,5.85) {(b) Isocuanta no convexa};
    \draw[->] (0,0) -- (5.6,0) node[below] {$L$};
    \draw[->] (0,0) -- (0,5.5) node[left] {$K$};
    \begin{scope}
      \clip (0,0) rectangle (5.3,5.3);
      \draw[thin] (0,7.968) -- (2.010,0);
      \draw[thin] (0,4.5203) -- (4.0891,0);
      \draw[thin] (0,2.222) -- (7.2,0);
    \end{scope}
    \draw[very thick] plot[domain=0.76:5.2, samples=160] (\x,{4/\x+0.9*exp(-((\x-2)/0.42)^2)});
    \draw[thick, dashed] (1.42,2.951) -- (2.668,1.571);
    \fill (1.42,2.951) circle (1.4pt) node[above right] {$A$};
    \fill (2.668,1.571) circle (1.4pt) node[above right] {$B$};
    \node at (2.7,-0.75) {$V(q)$ no convexo};
  \end{scope}
\end{tikzpicture}
