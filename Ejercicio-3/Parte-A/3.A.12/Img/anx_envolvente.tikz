% Figura (Anexo II, «La envolvente: el corto y el largo plazo»).
% Tecnología q = (K L)^{1/3} con un coste de puesta en marcha A = 1 y w = r = 1:
%   corto plazo con capital K: C_s(q;K) = 1 + K + q^3/K; CMe_s = (1+K)/q + q^2/K; CMg_s = 3q^2/K.
%   largo plazo (K* = q^{3/2}): C_L(q) = 1 + 2 q^{3/2}; CMe_L = 1/q + 2 q^{1/2} (mínimo 3 en q = 1); CMg_L = 3 q^{1/2}.
% Plantas: K_1 = 0,6^{3/2} = 0,4648 (tangencia en q = 0,6; mínimo de su CMe_s en q = 0,698), K_2 = 1 (tangencia y mínimo en q = 1),
%   K_3 = 1,6^{3/2} = 2,0239 (tangencia en q = 1,6; mínimo de su CMe_s en q = 1,452).
% (a) CMe_L como envolvente de los CMe_s. (b) Planta K_1: CMg_s = CMg_L en la tangencia (q = 0,6; 2,324) y CMg_s corta al CMe_s
%   en su mínimo (q = 0,698; 3,147); CMg_L corta al CMe_L en su mínimo (q = 1; 3).
% Escalas: q 1 unidad = 2,7 cm; costes 1 unidad = 0,8 cm (recorte en 6).
% Sustituye a Ppio_CHATELIER_SAMUELSON.png (en parte) y CT_Produccion_Senda.png del tema antiguo.
% Generar con: bash Code/generar_figura.sh anx_envolvente
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=2.7cm, y=0.8cm]
  % ---------------- (a) Envolvente ----------------
  \node[font=\footnotesize\bfseries] at (1.2,7.0) {(a) Costes medios a corto y a largo plazo};
  \draw[->] (0,0) -- (2.5,0) node[below] {$q$};
  \draw[->] (0,0) -- (0,6.4) node[left] {$\text{\texteuro}/q$};
  \begin{scope}
    \clip (0,0) rectangle (2.35,6.0);
    \draw[very thick] plot[domain=0.25:2.3, samples=80] (\x,{1/\x+2*sqrt(\x)});
    \draw[thick] plot[domain=0.25:1.35, samples=80] (\x,{1.4648/\x+\x*\x/0.4648});
    \draw[thick] plot[domain=0.3:1.9, samples=80] (\x,{2/\x+\x*\x});
    \draw[thick] plot[domain=0.6:2.3, samples=80] (\x,{3.0239/\x+\x*\x/2.0239});
  \end{scope}
  \node at (2.47,3.38) {$CMe_L$};
  \node at (1.35,5.38) {$CMe_1$};
  \node at (1.97,5.0) {$CMe_2$};
  \node at (2.47,4.1) {$CMe_3$};
  \fill (0.6,3.2159) circle (1.3pt);
  \fill (1,3) circle (1.3pt);
  \fill (1.6,3.1548) circle (1.3pt);
  \draw[dotted] (0.6,3.2159) -- (0.6,0) node[below] {$q_1$};
  \draw[dotted] (1,3) -- (1,0) node[below] {$q_2$};
  \draw[dotted] (1.6,3.1548) -- (1.6,0) node[below] {$q_3$};
  % ---------------- (b) Costes marginales ----------------
  \begin{scope}[xshift=8.0cm]
    \node[font=\footnotesize\bfseries] at (1.2,7.0) {(b) Costes marginales};
    \draw[->] (0,0) -- (2.5,0) node[below] {$q$};
    \draw[->] (0,0) -- (0,6.4) node[left] {$\text{\texteuro}/q$};
    \begin{scope}
      \clip (0,0) rectangle (2.35,6.0);
      \draw[very thick] plot[domain=0.25:2.3, samples=80] (\x,{1/\x+2*sqrt(\x)});
      \draw[very thick, dashed] plot[domain=0.15:2.3, samples=80] (\x,{3*sqrt(\x)});
      \draw[thick] plot[domain=0.25:1.35, samples=80] (\x,{1.4648/\x+\x*\x/0.4648});
      \draw[thick, dashed] plot[domain=0.15:1.2, samples=80] (\x,{3*\x*\x/0.4648});
    \end{scope}
    \node at (2.47,3.38) {$CMe_L$};
    \node at (2.47,4.72) {$CMg_L$};
    \node at (1.35,5.38) {$CMe_1$};
    \node at (1.0,6.3) {$CMg_1$};
    \fill (0.6,2.3238) circle (1.3pt);
    \fill (0.698,3.1468) circle (1.3pt);
    \fill (1,3) circle (1.3pt);
    \draw[dotted] (0.6,3.2159) -- (0.6,0) node[below] {$q_1$};
    \draw[dotted] (1,3) -- (1,0) node[below] {$q_2$};
  \end{scope}
\end{tikzpicture}
