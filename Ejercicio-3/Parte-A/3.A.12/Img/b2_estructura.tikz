% Figura (bloque 2, «Estructura del mercado»): escala mínima eficiente, demanda y número de empresas (segunda pasada, 26/10/2026).
% Demanda del mercado D: p = 3 - 0,45 Q (la misma en los tres paneles); al precio igual al mínimo del coste medio, 1,2, demanda Q = 4.
% (a) Muchas empresas: CMe_L = 1,2 + 4 (q - 0,7)^2, mínimo 1,2 en q_EME = 0,7: caben unas Q/q_EME = 5,7 empresas.
% (b) Pocas empresas: CMe_L = 1,2 + 0,6 (q - 1,8)^2, mínimo 1,2 en q_EME = 1,8: caben unas 2,2 empresas.
% (c) Monopolio natural: CMe_L = 0,9 + 1,2 / q, decreciente en todo el tramo de la demanda; corta a la demanda en q = 0,667 y q = 4
%     (p = 1,2): una sola empresa puede abastecer el mercado cubriendo costes, y dos que se lo repartieran (2 cada una) tendrían
%     un coste medio de 1,5.
% Escalas: Q y q, 1 unidad = 0,62 cm; precio, 1 unidad = 1,05 cm (recorte en 3,25). Paneles separados 5,25 cm.
% Generar con: bash Code/generar_figura.sh b2_estructura
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=0.62cm, y=1.05cm]
  \foreach \col/\tit in {0/{(a) Muchas empresas}, 1/{(b) Pocas empresas}, 2/{(c) Monopolio natural}} {
    \begin{scope}[xshift=\col*5.25cm]
      \node[font=\footnotesize\bfseries] at (3.6,3.75) {\tit};
      \draw[->] (0,0) -- (7.4,0) node[below] {$q,\,Q$};
      \draw[->] (0,0) -- (0,3.45) node[left] {$p$};
      \draw[thick] (0,3) -- (6.667,0);
      \node[above right] at (5.6,0.48) {$D$};
    \end{scope}
  }
  % ---------------- (a) ----------------
  \begin{scope}
    \clip (0,0) rectangle (7.2,3.25);
    \draw[very thick] plot[domain=0:1.6, samples=60] (\x,{1.2+4*(\x-0.7)^2});
  \end{scope}
  \node[above] at (1.4,3.0) {$CMe_L$};
  \draw[dotted] (0,1.2) -- (4,1.2);
  \draw[dotted] (0.7,1.2) -- (0.7,0) node[below] {$q_{EME}$};
  \draw[dotted] (4,1.2) -- (4,0) node[below] {$Q$};
  \fill (0.7,1.2) circle (1.3pt);
  \fill (4,1.2) circle (1.3pt);
  % ---------------- (b) ----------------
  \begin{scope}[xshift=5.25cm]
    \begin{scope}
      \clip (0,0) rectangle (7.2,3.25);
      \draw[very thick] plot[domain=0:4.0, samples=60] (\x,{1.2+0.6*(\x-1.8)^2});
    \end{scope}
    \node[above] at (3.9,3.05) {$CMe_L$};
    \draw[dotted] (0,1.2) -- (4,1.2);
    \draw[dotted] (1.8,1.2) -- (1.8,0) node[below] {$q_{EME}$};
    \draw[dotted] (4,1.2) -- (4,0) node[below] {$Q$};
    \fill (1.8,1.2) circle (1.3pt);
    \fill (4,1.2) circle (1.3pt);
  \end{scope}
  % ---------------- (c) ----------------
  \begin{scope}[xshift=10.5cm]
    \begin{scope}
      \clip (0,0) rectangle (7.2,3.25);
      \draw[very thick] plot[domain=0.4:7.0, samples=70] (\x,{0.9+1.2/\x});
    \end{scope}
    \node[right] at (7.0,1.07) {$CMe_L$};
    \draw[dotted] (4,1.2) -- (4,0) node[below] {$Q$};
    \fill (4,1.2) circle (1.3pt);
  \end{scope}
\end{tikzpicture}
