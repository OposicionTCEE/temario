% Figura (Anexo III, «La escala con varios productos»).
% (a) Espacio de los productos: vector de referencia Q = (2, 1); radio desde el origen con los puntos 0,5 Q, Q y 1,5 Q;
%     producciones por separado A = (2, 0) y B = (0, 1), que se comparan con Q en las economías de alcance.
% (b) Coste medio por rayo, CMR(t) = C(tQ)/t = 1,2/t + 1 + 0,5 t, con mínimo en t* = (1,2/0,5)^{1/2} = 1,549 (CMR = 2,549).
% Escalas: (a) 1 unidad = 1,6 cm; (b) t 1 unidad = 1,9 cm, coste 1 unidad = 0,95 cm.
% Generar con: bash Code/generar_figura.sh anx_multiproducto
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  % ---------------- (a) Productos ----------------
  \begin{scope}[x=1.6cm, y=1.6cm]
    \node[font=\footnotesize\bfseries] at (1.7,3.15) {(a) El espacio de los productos};
    \draw[->] (0,0) -- (3.5,0) node[below] {$q_1$};
    \draw[->] (0,0) -- (0,2.3) node[left] {$q_2$};
    \draw[dashed] (0,0) -- (3.4,1.7);
    \fill (1,0.5) circle (1.4pt) node[above left] {$\tfrac12 Q$};
    \fill (2,1) circle (1.4pt) node[above left] {$Q$};
    \fill (3,1.5) circle (1.4pt) node[above left] {$\tfrac32 Q$};
    \fill (2,0) circle (1.4pt) node[below] {$A$};
    \fill (0,1) circle (1.4pt) node[left] {$B$};
    \draw[dotted] (2,0) -- (2,1) -- (0,1);
  \end{scope}
  % ---------------- (b) Coste medio por rayo ----------------
  \begin{scope}[xshift=7.6cm, x=1.9cm, y=0.95cm]
    \node[font=\footnotesize\bfseries] at (1.6,5.3) {(b) Coste medio por rayo};
    \draw[->] (0,0) -- (3.4,0) node[below] {$t$};
    \draw[->] (0,0) -- (0,4.9) node[left] {$CMR(t)$};
    \begin{scope}
      \clip (0,0) rectangle (3.2,4.7);
      \draw[very thick] plot[domain=0.28:3.1, samples=80] (\x,{1.2/\x+1+0.5*\x});
    \end{scope}
    \draw[dotted] (1.549,2.549) -- (1.549,0) node[below] {$t^{*}$};
    \draw[dotted] (1,2.7) -- (1,0) node[below] {$1$};
    \fill (1.549,2.549) circle (1.4pt);
  \end{scope}
\end{tikzpicture}
