% Figura (Anexo I, «El problema y la condición de tangencia»): combinación de factores de mínimo coste.
% Isocuanta K = 4/L (nivel q). Precios w = r = 1: isocostes L + K = C con C_0 = 3,2 (no alcanza la isocuanta),
% C_1 = 4 (tangente en E = (2, 2)) y C_2 = 5 (corta la isocuanta en A = (1, 4) y B = (4, 1)).
% Escala: 1 unidad = 1,05 cm. Sustituye a ISOCUANTAS_PMIN.png del tema antiguo.
% Generar con: bash Code/generar_figura.sh anx_tangencia
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1.05cm, y=1.05cm]
  \draw[->] (0,0) -- (5.7,0) node[below] {$L$};
  \draw[->] (0,0) -- (0,5.6) node[left] {$K$};
  \draw[very thick] plot[domain=0.78:5.2, samples=80] (\x,{4/\x}) node[right] {$q$};
  \draw[dashed] (0,3.2) -- (3.2,0) node[below] {$C_0$};
  \draw[thick] (0,4) -- (4,0) node[below] {$C_1$};
  \draw[dashed] (0,5) -- (5,0) node[below] {$C_2$};
  \fill (2,2) circle (1.4pt) node[above right] {$E$};
  \fill (1,4) circle (1.4pt) node[above right] {$A$};
  \fill (4,1) circle (1.4pt) node[above right] {$B$};
\end{tikzpicture}
