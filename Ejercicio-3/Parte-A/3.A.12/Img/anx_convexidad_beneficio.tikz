% Figura (Anexo I, «Oferta, demandas no condicionadas y función de beneficios»): la función de beneficios es convexa en los precios.
% Tecnología q = 2 z^{1/2}, w = 1: z(p) = p^2, q(p) = 2p, pi(p) = p^2.
% En p^0 = 1: pi^0 = 1, q^0 = 2, z^0 = 1. Beneficio «pasivo» (sin cambiar el plan): q^0 p - w z^0 = 2p - 1, tangente en p^0.
% Escala: horizontal 1 unidad = 1,8 cm; vertical 1 unidad = 0,85 cm.
% Generar con: bash Code/generar_figura.sh anx_convexidad_beneficio
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1.8cm, y=0.85cm]
  \draw[->] (0,0) -- (2.6,0) node[below] {$p$};
  \draw[->] (0,0) -- (0,5.4) node[left] {$\pi$};
  \draw[very thick] plot[domain=0:2.2, samples=80] (\x,{\x*\x}) node[right] {$\pi(p,w)$};
  \draw[thick, dashed] (0.5,0) -- (2.35,3.7) node[right] {$q^0p-w\cdot z^0$};
  \draw[dotted] (1,1) -- (1,0) node[below] {$p^0$};
  \draw[dotted] (1,1) -- (0,1) node[left] {$\pi^0$};
  \fill (1,1) circle (1.4pt);
  \node at (1.25,-0.95) {$w$ dados};
\end{tikzpicture}
