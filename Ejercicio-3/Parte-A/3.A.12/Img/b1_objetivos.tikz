% Figura (bloque 1, «Objetivo»): la minimización del coste no depende del objetivo de la empresa (primera pasada de las notas del 29/10/2026).
% Arriba, tres objetivos distintos (beneficio; ventas con un beneficio mínimo, BAUMOL, 1959; producción con un presupuesto dado);
% en el centro, el paso común, sin nombrar la función de costes; abajo, lo dado: la tecnología y los precios de los factores.
% Se distingue de b1_pieza_comun (§2.3.1), que muestra las formas de competir en la segunda etapa.
% Generar con: bash Code/generar_figura.sh b1_objetivos
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=5pt]},
    caja/.style={draw, thick, rounded corners=2pt, align=center, minimum height=1.0cm, inner sep=3pt},
    rotulo/.style={anchor=east, font=\footnotesize\itshape, align=right}]
  % objetivos
  \node[caja, text width=3.5cm] (B) at (-4.1,3.2) {\textbf{Beneficio máximo}\\ empresa de sus propietarios};
  \node[caja, text width=3.5cm] (V) at (0,3.2) {\textbf{Ventas máximas}\\ con un beneficio mínimo};
  \node[caja, text width=3.5cm] (P) at (4.1,3.2) {\textbf{Producción máxima}\\ con un presupuesto dado};
  % paso común
  \node[caja, minimum width=11.8cm] (M) at (0,1.3) {\textbf{Obtener cada cantidad con el menor gasto}};
  % lo dado
  \node[caja, text width=4.6cm] (T) at (-2.9,-0.6) {\textbf{Tecnología}\\ qué puede producirse y con qué factores};
  \node[caja, text width=4.6cm] (W) at (2.9,-0.6) {\textbf{Precios de los factores}\\ lo que cuesta cada uno};
  \foreach \n in {B,V,P} { \draw[->, thick] (M.north -| \n.south) -- (\n.south); }
  \draw[->, thick] (T.north) -- (T.north |- M.south);
  \draw[->, thick] (W.north) -- (W.north |- M.south);
  % rótulos de las filas
  \node[rotulo] at (-6.15,3.2) {objetivo\\ distinto};
  \node[rotulo] at (-6.15,1.3) {paso\\ común};
  \node[rotulo] at (-6.15,-0.6) {datos};
\end{tikzpicture}
