% Figura: la conciliación entre stocks y flujos: del balance inicial al balance final de una unidad o un sector.
% Fuente de SCN_conciliacion.pdf. Elaboración propia a partir del SEC 2010 (apartados 8.60 a 8.64).
\providecommand{\op}[2]{\shortstack[l]{\textbf{#1}\\ \textcolor{black!65}{\scriptsize #2}}}
\begin{tikzpicture}[>=stealth,
  c/.style={draw=black!70, line width=0.5pt, minimum width=2.25cm, minimum height=1.0cm, font=\small, align=center, anchor=center},
  h/.style={c, fill=black!6, font=\footnotesize\bfseries, minimum height=1.35cm},
  f/.style={c, text width=3.6cm, minimum width=3.9cm, font=\footnotesize, align=left, fill=black!3},
  st/.style={c, fill=yellow!14}, op/.style={c, fill=red!8}, ov/.style={c, fill=orange!12}, rv/.style={c, fill=violet!8},
  pn/.style={c, fill=yellow!28, font=\small\bfseries}]
  \matrix (m) [matrix of nodes, column sep=-0.5pt, row sep=-0.5pt, nodes in empty cells]
  {
    |[f, fill=white, draw=none]| &
    |[h]| \shortstack{Balance\\ inicial\\ {\scriptsize\mdseries (IV.1)}} &
    |[h]| \shortstack{Operaciones\\ {\scriptsize\mdseries (III.1 y III.2)}} &
    |[h]| \shortstack{Otras var.\\ del volumen\\ {\scriptsize\mdseries (III.3.1)}} &
    |[h]| \shortstack{Revalori-\\ zaciones\\ {\scriptsize\mdseries (III.3.2)}} &
    |[h]| \shortstack{Balance\\ final\\ {\scriptsize\mdseries (IV.3)}} \\
    |[f]| \op{Activos no financieros}{AN} & |[st]| $K_{t-1}$ & |[op]| \shortstack{$FBC-CCF$\\ $+NP$} & |[ov]| $OV^{K}$ & |[rv]| $R^{K}$ & |[st]| $K_{t}$ \\
    |[f]| \op{Activos financieros}{AF} & |[st]| $A_{t-1}$ & |[op]| $\Delta A$ & |[ov]| $OV^{A}$ & |[rv]| $R^{A}$ & |[st]| $A_{t}$ \\
    |[f]| \op{Pasivos}{AF, del lado del deudor} & |[st]| $P_{t-1}$ & |[op]| $\Delta P$ & |[ov]| $OV^{P}$ & |[rv]| $R^{P}$ & |[st]| $P_{t}$ \\
    |[f, fill=yellow!28]| \op{Patrimonio neto}{activos menos pasivos} & |[pn]| $PN_{t-1}$ & |[pn]| \shortstack{$AN+TK$} & |[pn]| \shortstack{$OV^{K}+OV^{A}$\\ $-OV^{P}$} & |[pn]| \shortstack{$R^{K}+R^{A}$\\ $-R^{P}$} & |[pn]| $PN_{t}$ \\
  };
  \draw[line width=1.2pt, black!75] (m-5-1.north west) -- (m-5-6.north east);
  % Signos entre columnas
  \foreach \i/\j in {2/3, 3/4, 4/5} {
    \node[circle, fill=white, draw=black!50, inner sep=0.5pt, font=\scriptsize\bfseries] at ($(m-1-\i.north east)!0.5!(m-1-\j.north west)+(0,0.25)$) {$+$};
  }
  \node[circle, fill=white, draw=black!50, inner sep=0.5pt, font=\scriptsize\bfseries] at ($(m-1-5.north east)!0.5!(m-1-6.north west)+(0,0.25)$) {$=$};
  \node[font=\scriptsize, text=black!75, anchor=north west, align=left, text width=15.0cm, execute at begin node={\hyphenpenalty=10000}] at ([yshift=-0.3cm]m-5-1.south west)
    {Cada fila se lee de izquierda a derecha: el stock final es el inicial más las operaciones del periodo, las otras variaciones del volumen y las revalorizaciones. Solo las operaciones pasan por la matriz de transacciones.\\
     $AN$: ahorro neto; $TK$: transferencias de capital netas recibidas; $CCF$: consumo de capital fijo. Como $FBC+NP-CCF+\Delta A-\Delta P=AN+TK$, la variación del patrimonio neto debida a las operaciones es el ahorro neto más las transferencias de capital.};
\end{tikzpicture}
