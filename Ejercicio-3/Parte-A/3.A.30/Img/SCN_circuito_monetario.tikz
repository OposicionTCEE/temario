% Figura: el orden de registro de la sucesión de cuentas (SCN/SEC) frente al orden temporal del circuito monetario (GRAZIANI, 2003), en dos paneles.
% Fuente de SCN_circuito_monetario.pdf. Las columnas coinciden para que se vea dónde queda la financiación en cada caso.
\begin{tikzpicture}[>=stealth, font=\footnotesize,
  bx/.style={draw=black!70, line width=0.5pt, rounded corners=2pt, text width=1.95cm, minimum height=1.5cm, align=center, inner sep=2pt, fill=#1, execute at begin node={\hyphenpenalty=10000}},
  bx/.default=blue!8,
  bb/.style={bx=#1, minimum height=2.15cm},
  bb/.default=blue!8,
  fl/.style={->, line width=0.8pt, black!65},
  tit/.style={font=\footnotesize\bfseries, anchor=west, inner sep=0pt},
  nt/.style={font=\footnotesize, text=black!75, align=center}]

  % ---------- Panel (a): el orden de registro ----------
  \node[tit] at (-1.05,1.25) {(a) La sucesión de cuentas: el orden en que se registra};
  \node[bx] (a1) at (0,0) {Producción\\ (I)};
  \node[bx] (a2) at (2.55,0) {Renta: generación y distribución (II.1--II.3)};
  \node[bx] (a3) at (5.1,0) {Utilización: consumo y ahorro (II.4)};
  \node[bx] (a4) at (7.65,0) {Cuenta de capital: inversión (III.1)};
  \node[bx=red!9] (a5) at (10.2,0) {Cuenta financiera: préstamos y depósitos (III.2)};
  \node[bx=teal!12] (a6) at (12.75,0) {Balances: stocks al final del periodo (IV)};
  \foreach \i/\j in {a1/a2, a2/a3, a3/a4, a4/a5, a5/a6} \draw[fl] (\i) -- (\j);
  \draw[decorate, decoration={brace, amplitude=5pt, mirror}, line width=0.6pt, black!60]
    ([yshift=-4pt]a1.south west) -- ([yshift=-4pt]a6.south east)
    node[midway, below=7pt, nt] {un solo periodo contable, registrado \textit{ex post} como si todo fuera simultáneo:\\ la financiación aparece al final, como contrapartida del ahorro y de la inversión};

  % ---------- Panel (b): el orden en que ocurre ----------
  \node[tit] at (-1.05,-2.4) {(b) El circuito monetario: el orden en que ocurre (GRAZIANI, 2003)};
  \node[bb=red!9] (b1) at (0,-3.85) {\textbf{1.} Crédito: los bancos prestan a las empresas y crean depósitos};
  \node[bb] (b2) at (2.55,-3.85) {\textbf{2.} Producción: las empresas pagan salarios e insumos};
  \node[bb] (b3) at (5.1,-3.85) {\textbf{3.} Renta: los hogares la cobran en sus depósitos};
  \node[bb] (b4) at (7.65,-3.85) {\textbf{4.} Gasto: consumen y ahorran en depósitos o en títulos};
  \node[bb] (b5) at (10.2,-3.85) {\textbf{5.} Ventas: el dinero gastado vuelve a las empresas};
  \node[bb=red!9] (b6) at (12.75,-3.85) {\textbf{6.} Reembolso: se cancela el préstamo y se destruye el dinero};
  \foreach \i/\j in {b1/b2, b2/b3, b3/b4, b4/b5, b5/b6} \draw[fl] (\i) -- (\j);
  \draw[->, line width=0.8pt, dashed, red!50!black] (b6.south) -- ++(0,-0.45) -| (b1.south)
    node[pos=0.25, below, nt, text=red!50!black] {lo que los hogares ahorran en depósitos no vuelve a las empresas: queda como deuda con los bancos,\\ el stock con el que empieza el periodo siguiente};

  % ---------- Leyenda ----------
  \node[anchor=north west, font=\footnotesize, text=black!75, text width=14.6cm, align=left, inner sep=0pt,
        execute at begin node={\hyphenpenalty=10000}] at (-1.05,-6.75)
    {Azul: producción, renta y gasto; rojo: financiación; verde azulado: stocks. Las columnas coinciden: la financiación, que en las cuentas cierra el periodo (a), es en el circuito lo que lo abre (b); el dinero se crea con el crédito y se destruye con el reembolso.};
\end{tikzpicture}
