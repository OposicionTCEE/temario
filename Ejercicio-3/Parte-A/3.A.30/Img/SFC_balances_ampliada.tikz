% Figura: matriz de balances ampliada de una economía cerrada con empresas, bancos, Gobierno y banco central (convención de GODLEY y LAVOIE, 2007).
% Fuente de SFC_balances_ampliada.pdf. Activos con signo +, pasivos con signo -, patrimonio neto con signo - para que cada columna sume cero.
\providecommand{\op}[2]{\shortstack[l]{\textbf{#1}\\ \textcolor{black!65}{\scriptsize #2}}}
\begin{tikzpicture}[>=stealth,
  c/.style={draw=black!70, line width=0.5pt, minimum width=1.85cm, minimum height=0.9cm, font=\small, align=center, anchor=center},
  h/.style={c, fill=black!6, font=\footnotesize\bfseries, minimum height=1.25cm},
  f/.style={c, text width=4.2cm, minimum width=4.5cm, font=\footnotesize, align=left, fill=black!3},
  nf/.style={c, fill=orange!12}, fin/.style={c, fill=red!8},
  vac/.style={c, fill=white},
  cero/.style={c, fill=white, text=black!55, minimum width=1.2cm},
  sig/.style={h, minimum width=1.2cm},
  pn/.style={c, fill=yellow!20, font=\small\bfseries}]
  \matrix (m) [matrix of nodes, column sep=-0.5pt, row sep=-0.5pt, nodes in empty cells]
  {
    |[f, fill=white, draw=none]| &
    |[h]| Hogares &
    |[h]| Empresas &
    |[h]| Bancos &
    |[h]| Gobierno &
    |[h]| \shortstack{Banco\\ central} &
    |[sig]| $\Sigma$ \\
    |[f]| \op{Capital fijo}{activos no financieros} & |[vac]| & |[nf]| $+K$ & |[vac]| & |[vac]| & |[vac]| & |[cero]| $+K$ \\
    |[f]| \op{Dinero de alta potencia}{efectivo y reservas} & |[fin]| $+H_h$ & |[vac]| & |[fin]| $+H_b$ & |[vac]| & |[fin]| $-H$ & |[cero]| $0$ \\
    |[f]| \op{Depósitos bancarios}{dinero bancario} & |[fin]| $+M$ & |[vac]| & |[fin]| $-M$ & |[vac]| & |[vac]| & |[cero]| $0$ \\
    |[f]| \op{Préstamos}{} & |[vac]| & |[fin]| $-L$ & |[fin]| $+L$ & |[vac]| & |[vac]| & |[cero]| $0$ \\
    |[f]| \op{Bonos públicos}{} & |[fin]| $+B_h$ & |[vac]| & |[fin]| $+B_b$ & |[fin]| $-B$ & |[fin]| $+B_{cb}$ & |[cero]| $0$ \\
    |[f, fill=yellow!20]| \op{Patrimonio neto}{} & |[pn]| $-V_h$ & |[pn]| $-V_f$ & |[pn]| $-V_b$ & |[pn]| $+B$ & |[pn]| $0$ & |[cero]| $-K$ \\
    |[f, fill=black!6]| \textbf{$\Sigma$} & |[cero, minimum width=1.85cm]| $0$ & |[cero, minimum width=1.85cm]| $0$ & |[cero, minimum width=1.85cm]| $0$ & |[cero, minimum width=1.85cm]| $0$ & |[cero, minimum width=1.85cm]| $0$ & |[cero]| $0$ \\
  };
  \draw[line width=1.2pt, black!75] (m-7-1.north west) -- (m-7-7.north east);
  % Correspondencia con el bloque 2
  \draw[decorate, decoration={brace, amplitude=5pt}, line width=0.8pt, blue!55!black]
    ([yshift=0.12cm]m-1-3.north west) -- ([yshift=0.12cm]m-1-4.north east)
    node[midway, above=6pt, font=\scriptsize, text=blue!55!black, align=center] {sociedades del bloque 2\\ (S.11 y S.12, salvo S.121)};
  \draw[decorate, decoration={brace, amplitude=5pt}, line width=0.8pt, red!55!black]
    ([yshift=0.12cm]m-1-5.north west) -- ([yshift=0.12cm]m-1-6.north east)
    node[midway, above=6pt, font=\scriptsize, text=red!55!black, align=center] {sector público\\ (S.13 y S.121)};
  \node[font=\scriptsize, text=black!75, anchor=north west, align=left, text width=14.0cm, execute at begin node={\hyphenpenalty=10000}] at ([yshift=-0.3cm]m-8-1.south west)
    {Economía cerrada. El Gobierno no tiene activos, de modo que su patrimonio neto es su deuda con el signo cambiado; el banco central transfiere sus beneficios al Gobierno y su patrimonio neto es nulo. Cada fila financiera suma cero, y la riqueza de la economía es su capital fijo.};
\end{tikzpicture}
