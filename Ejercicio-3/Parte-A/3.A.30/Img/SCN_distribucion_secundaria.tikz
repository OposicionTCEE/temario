% Figura: bloque de filas de la cuenta de distribución secundaria de la renta (II.2).
% Fuente de SCN_distribucion_secundaria.pdf. Convención de GODLEY y LAVOIE (2007) sobre las columnas del cuadro de cuentas económicas integradas del SEC 2010.
\providecommand{\op}[2]{\shortstack[l]{\textbf{#1}\\ \textcolor{black!65}{\scriptsize #2}}}
\begin{tikzpicture}[>=stealth,
  c/.style={draw=black!70, line width=0.5pt, minimum width=1.75cm, minimum height=0.95cm, font=\small, align=center, anchor=center},
  h/.style={c, fill=black!6, font=\footnotesize\bfseries, minimum height=1.25cm},
  ht/.style={h, fill=black!16},
  f/.style={c, text width=5.0cm, minimum width=5.3cm, font=\footnotesize, align=left, fill=black!3},
  cor/.style={c, fill=blue!7}, ext/.style={c, fill=green!8},
  tot/.style={c, fill=black!12}, totz/.style={c, fill=black!12, text=black!50},
  vac/.style={c, fill=white},
  cero/.style={c, fill=white, text=black!55, minimum width=1.3cm},
  sig/.style={h, minimum width=1.3cm},
  ab/.style={c, fill=blue!3, text=black!70},
  sal/.style={c, fill=blue!18, font=\small\bfseries},
  salt/.style={sal, fill=black!22}]
  \matrix (m) [matrix of nodes, column sep=-0.5pt, row sep=-0.5pt, nodes in empty cells]
  {
    |[f, fill=white, draw=none]| &
    |[h]| \shortstack{Hogares\\ e ISFLSH} &
    |[h]| Sociedades &
    |[h]| AAPP &
    |[ht]| \shortstack{Total\\ economía} &
    |[h]| \shortstack{Resto\\ del mundo} &
    |[h]| \shortstack{Bienes y\\ servicios} &
    |[sig]| $\Sigma$ \\
    |[f, fill=blue!3]| \op{Abre con: saldo de rentas primarias}{saldo de la cuenta de asignación primaria} & |[ab]| $+SRP_H$ & |[ab]| $+SRP_S$ & |[ab]| $+SRP_G$ & |[ab, fill=black!8]| $+RNB$ & |[vac]| & |[vac]| & |[cero]| \\
    |[f]| \op{Impuestos corrientes}{sobre la renta, el patrimonio, etc. (D.5)} & |[cor]| $-T_{d,H}$ & |[cor]| $-T_{d,S}$ & |[cor]| $+T_d$ & |[totz]| $0$ & |[vac]| & |[vac]| & |[cero]| $0$ \\
    |[f]| \op{Cotizaciones sociales netas}{D.61} & |[cor]| $-CS$ & |[cor]| $+CS_S$ & |[cor]| $+CS_G$ & |[totz]| $0$ & |[vac]| & |[vac]| & |[cero]| $0$ \\
    |[f]| \op{Prestaciones sociales}{distintas de las transferencias en especie (D.62)} & |[cor]| $+PS$ & |[cor]| $-PS_S$ & |[cor]| $-PS_G$ & |[totz]| $0$ & |[vac]| & |[vac]| & |[cero]| $0$ \\
    |[f]| \op{Otras transferencias corrientes}{D.7: remesas, aportaciones a la Unión, etc.} & |[cor]| $\pm OT_H$ & |[cor]| $\pm OT_S$ & |[cor]| $\pm OT_G$ & |[tot]| $+TCN$ & |[ext]| $-TCN$ & |[vac]| & |[cero]| $0$ \\
    |[f, fill=blue!18]| \op{Saldo}{renta disponible bruta (B.6b)} & |[sal]| $RDB_H$ & |[sal]| $RDB_S$ & |[sal]| $RDB_G$ & |[salt]| $RNDB$ & |[sal, fill=green!16]| $-TCN$ & |[vac]| & |[cero]| \\
  };
  \draw[line width=1.2pt, black!75] (m-7-1.north west) -- (m-7-8.north east);
  \draw[->, line width=1.0pt, black!60] ([yshift=-0.2cm]m-7-5.south) -- ++(0,-0.6)
    node[below, font=\scriptsize, text=black!75, align=center] {$RNDB=RNB+TCN$\\ (renta nacional disponible bruta)};
  \node[font=\scriptsize, text=black!75, anchor=north west, align=left, text width=15.6cm, execute at begin node={\hyphenpenalty=10000}] at ([yshift=-1.7cm]m-7-1.south west)
    {Las transferencias entre residentes cambian la renta de cada sector, pero no la del conjunto: en la columna del total se compensan (celdas con $0$). Solo sobreviven las transferencias corrientes netas recibidas del resto del mundo ($TCN$).\\
     Por simplicidad, se omiten los impuestos, las cotizaciones y las prestaciones con no residentes, que el SEC registra también en la columna del resto del mundo.};
\end{tikzpicture}
