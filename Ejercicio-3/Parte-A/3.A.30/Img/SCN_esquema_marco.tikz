% Figura: esquema de una página del bloque 1 (anexo «Material de estudio: Esquema»), como secuencia
% problema -> herramienta (el SCN y el SEC 2010, con sus hitos) -> solución (reglas de registro en pasos encadenados:
% quién, qué, dónde, cuándo y por cuánto) -> resultado -> glosario.
% Generar con: bash Code/generar_figura.sh SCN_esquema_marco
\begin{tikzpicture}[>=stealth,
  caja/.style={draw=black!70, rounded corners=3pt, line width=0.6pt, align=left, font=\footnotesize, inner sep=4pt},
  sec/.style={font=\small\bfseries, anchor=north west},
  tit/.style={font=\footnotesize, anchor=north west, align=left},
  mc/.style={draw=black!70, minimum width=0.95cm, minimum height=0.42cm, font=\footnotesize, inner sep=1pt, anchor=center},
  paso/.style={draw=black!70, rounded corners=3pt, line width=0.6pt, fill=blue!3, minimum width=15.43cm, minimum height=1.65cm, anchor=north west, inner sep=0pt},
  num/.style={circle, fill=black!80, text=white, font=\footnotesize\bfseries, inner sep=1.2pt, minimum size=0.45cm},
  enlace/.style={->, line width=1pt, blue!50!black},
  maniobra/.style={font=\footnotesize\itshape, text=blue!50!black, anchor=west},
  chip/.style={draw=black!60, rounded corners=2pt, font=\footnotesize, inner sep=2pt, minimum height=0.42cm}]

  % ================= EL PROBLEMA =================
  \node[sec, text=red!50!black] at (0,0) {El problema};
  \node[caja, fill=red!6, text width=15.15cm, anchor=north west] (P) at (0,-0.45)
    {\textbf{¿Cómo describir toda una economía con cifras coherentes y comparables?} Lo que produce, cómo genera, reparte y usa la renta, cómo acumula riqueza y cómo se financia cada agente, igual en todos los países y a lo largo del tiempo.};

  % ================= LA HERRAMIENTA =================
  \node[sec, text=blue!50!black] (hH) at ([yshift=-0.3cm]P.south west) {La herramienta: el sistema de cuentas nacionales};
  \node[caja, fill=blue!4, text width=15.15cm, anchor=north west] (H) at ([yshift=-0.12cm]hH.south west)
    {Un conjunto \textbf{coherente, sistemático, integrado y contable} de cuentas y balances. En la Unión, el \textbf{SEC 2010} (Reglamento (UE) n.º 549/2013), versión europea del SCN 2008, es obligatorio: sus cifras sustentan el déficit y la deuda, el recurso RNB y los fondos de cohesión. Dos ángulos: \textbf{funcional} (ramas: tablas input-output) e \textbf{institucional} (sectores: este tema).};
  % Línea de hitos, en una franja propia bajo la herramienta
  \node[draw=black!40, rounded corners=3pt, fill=blue!2, minimum width=15.43cm, minimum height=1.25cm, anchor=north west] (Tl) at ([yshift=-0.12cm]H.south west) {};
  \begin{scope}[shift={(Tl.south west)}]
    \draw[->, line width=0.8pt, black!60] (0.3,0.62) -- (15.15,0.62);
    \foreach \x/\a/\b/\pos in {
      1.0/1934/KUZNETS/arriba, 2.6/1941/MEADE y STONE/abajo, 4.2/1953/primer SCN/arriba, 5.8/1968/SCN 1968/abajo,
      7.4/1993/SCN 1993/arriba, 9.0/1995/SEC 95/abajo, 10.6/2008/SCN 2008/arriba, 12.2/2014/SEC 2010/abajo, 13.8/2025/SCN 2025/arriba} {
      \fill[blue!50!black] (\x,0.62) circle (2pt);
      \ifnum\pdfstrcmp{\pos}{arriba}=0
        \node[font=\footnotesize, anchor=south, align=center] at (\x,0.68) {\textbf{\a}\ \b};
      \else
        \node[font=\footnotesize, anchor=north, align=center] at (\x,0.56) {\textbf{\a}\ \b};
      \fi
    }
  \end{scope}

  % ================= LA SOLUCIÓN =================
  \node[sec, text=blue!50!black] (hS) at ([yshift=-0.3cm]Tl.south west) {La solución: las reglas de registro};

  % Paso 1: quién
  \node[paso] (k1) at ([yshift=-0.15cm]hS.south west) {};
  \node[num] at (k1.north west) {1};
  \begin{scope}[shift={(k1.north west)}]
    \node[tit, text width=4.1cm] at (0.25,-0.1) {\textbf{Quién: sectores y residencia}\\[1pt] unidades institucionales\\[1pt] $\to$ cinco sectores y el resto del mundo};
    \node[tit, text width=6.4cm] at (4.6,-0.1) {Unidades con autonomía de decisión y contabilidad completa, agrupadas por su función y sus recursos. Residente: centro de interés en el territorio un año o más; separa lo \textbf{interior} de lo \textbf{nacional}.};
    \foreach \x/\c/\l in {11.55/blue!15/S.11, 12.35/blue!15/S.12, 13.15/green!15/S.13, 13.95/red!12/S.14, 14.75/red!12/S.15}
      \node[chip, fill=\c] at (\x,-0.32) {\l};
    \draw[decorate, decoration={brace, mirror, amplitude=3pt}, black!60] (11.2,-0.58) -- (15.1,-0.58)
      node[midway, below=2pt, font=\footnotesize] {S.1: residentes};
    \node[chip, fill=yellow!35] at (13.15,-1.38) {S.2: resto del mundo};
  \end{scope}

  % Paso 2: qué
  \node[paso] (k2) at ([yshift=-0.42cm]k1.south west) {};
  \node[num] at (k2.north west) {2};
  \draw[enlace] ([xshift=2.2cm]k1.south west) -- ([xshift=2.2cm]k2.north west) node[midway, maniobra, xshift=2pt] {se define qué se anota};
  \begin{scope}[shift={(k2.north west)}]
    \node[tit, text width=4.1cm] at (0.25,-0.1) {\textbf{Qué: flujos y stocks}\\[1pt] operaciones P, D, F y NP\\[1pt] $X_t=X_{t-1}+OP_t+OV_t$};
    \node[tit, text width=6.4cm] at (4.6,-0.1) {Los flujos (operaciones y otras variaciones de volumen y de precio) explican la diferencia entre el balance inicial y el final. Las revalorizaciones van aparte: no son renta ni ahorro.};
    \fill[black!15] (11.5,-1.25) rectangle ++(0.6,0.75);
    \node[font=\footnotesize, anchor=north] at (11.8,-1.25) {$X_{t-1}$};
    \node[font=\footnotesize] at (12.4,-0.9) {$+$};
    \fill[blue!30] (12.7,-1.25) rectangle ++(0.6,0.35);
    \node[font=\footnotesize, anchor=north] at (13.0,-1.25) {$OP$};
    \node[font=\footnotesize] at (13.6,-0.9) {$+$};
    \fill[orange!40] (13.9,-1.25) rectangle ++(0.6,0.15);
    \node[font=\footnotesize, anchor=north] at (14.2,-1.25) {$OV$};
    \node[font=\footnotesize] at (14.75,-0.9) {$=$};
    \fill[black!15] (14.95,-1.25) rectangle ++(0.3,0.75); \fill[blue!30] (14.95,-0.5) rectangle ++(0.3,0.35); \fill[orange!40] (14.95,-0.15) rectangle ++(0.3,0.1);
    \node[font=\footnotesize, anchor=north] at (15.1,-1.25) {$X_t$};
  \end{scope}

  % Paso 3: dónde
  \node[paso] (k3) at ([yshift=-0.42cm]k2.south west) {};
  \node[num] at (k3.north west) {3};
  \draw[enlace] ([xshift=2.2cm]k2.south west) -- ([xshift=2.2cm]k3.north west) node[midway, maniobra, xshift=2pt] {se fija dónde se anota};
  \begin{scope}[shift={(k3.north west)}]
    \node[tit, text width=4.1cm] at (0.25,-0.1) {\textbf{Dónde: la cuenta y la partida cuádruple}\\[1pt] $CF_i=\Delta AF_i-\Delta P_i$\\[1pt] $\sum_i CF_i+CF_{RM}=0$};
    \node[tit, text width=6.4cm] at (4.6,-0.1) {Cada cuenta recoge recursos y empleos y cierra con un \textbf{saldo} que abre la siguiente. Cada operación, cuatro anotaciones: el empleo de uno es recurso de otro, y cada una tiene su contrapartida financiera (ejemplo: una prestación social).};
    \matrix (pc) [matrix of math nodes, nodes={mc}, column sep=-0.4pt, row sep=-0.4pt, anchor=north west] at (12.3,-0.15)
      { \text{\textbf{Hogar}} & \text{\textbf{AAPP}} \\ |[fill=green!15]| +x & |[fill=green!15]| -x \\ |[fill=blue!15]| -x & |[fill=blue!15]| +x \\ };
    \node[font=\footnotesize, anchor=east] at (pc-2-1.west) {D.62};
    \node[font=\footnotesize, anchor=east] at (pc-3-1.west) {F.2};
    \node[font=\footnotesize, text=blue!50!black, anchor=west] at (pc-2-2.east) {$\Sigma=0$};
    \node[font=\footnotesize, text=blue!50!black, anchor=west] at (pc-3-2.east) {$\Sigma=0$};
  \end{scope}

  % Paso 4: cuándo
  \node[paso] (k4) at ([yshift=-0.42cm]k3.south west) {};
  \node[num] at (k4.north west) {4};
  \draw[enlace] ([xshift=2.2cm]k3.south west) -- ([xshift=2.2cm]k4.north west) node[midway, maniobra, xshift=2pt] {se fija cuándo};
  \begin{scope}[shift={(k4.north west)}]
    \node[tit, text width=4.1cm] at (0.25,-0.1) {\textbf{Cuándo: el devengo}\\[1pt] al crearse el valor o nacer la obligación, no al cobrar};
    \node[tit, text width=6.4cm] at (4.6,-0.1) {Vendedor y comprador anotan la operación en el mismo periodo; lo que falta por cobrar queda como cuenta pendiente de cobro y de pago. Por eso el déficit en contabilidad nacional difiere del de caja.};
    \draw[->, line width=0.8pt, black!60] (11.4,-0.85) -- (15.25,-0.85);
    \fill (12.2,-0.85) circle (2pt); \fill (14.3,-0.85) circle (2pt);
    \node[font=\footnotesize, anchor=south, align=center] at (12.2,-0.8) {$t$: venta};
    \node[font=\footnotesize, anchor=north, align=center] at (12.2,-0.92) {\textbf{se registra}};
    \node[font=\footnotesize, anchor=south, align=center] at (14.3,-0.8) {$t+1$: cobro};
    \node[font=\footnotesize, anchor=north, align=center] at (14.3,-0.92) {cambia el activo};
  \end{scope}

  % Paso 5: por cuánto
  \node[paso] (k5) at ([yshift=-0.42cm]k4.south west) {};
  \node[num] at (k5.north west) {5};
  \draw[enlace] ([xshift=2.2cm]k4.south west) -- ([xshift=2.2cm]k5.north west) node[midway, maniobra, xshift=2pt] {se fija por cuánto};
  \begin{scope}[shift={(k5.north west)}]
    \node[tit, text width=4.1cm] at (0.25,-0.1) {\textbf{Por cuánto: la valoración}\\[1pt] $PIB_{pm}=\sum_j VAB_j^{pb}+T_p$};
    \node[tit, text width=6.4cm] at (4.6,-0.1) {Precio de mercado; si no lo hay, por comparación (alquiler imputado), por costes (servicios públicos) o por valor actual. Producción a precios básicos, empleos a precios de adquisición; se separan precios y volúmenes.};
    \foreach \i/\l/\c in {0/mercado/blue!30, 1/comparación/blue!22, 2/costes/blue!14, 3/valor actual/blue!7} {
      \node[draw=black!50, fill=\c, font=\footnotesize, minimum width=1.9cm, minimum height=0.32cm, inner sep=1pt, anchor=north west] at (11.35+\i*0.62,-0.2-\i*0.33) {\l};
    }
  \end{scope}

  % ================= EL RESULTADO =================
  \node[sec, text=black!75] (hR) at ([yshift=-0.3cm]k5.south west) {El resultado: un sistema contable cerrado};
  \node[caja, fill=black!4, text width=15.15cm, anchor=north west] (R) at ([yshift=-0.12cm]hR.south west)
    {Todo lo que una unidad emplea es un recurso de otra, y todo flujo de renta o de gasto tiene una contrapartida financiera; los flujos explican los stocks; y las macromagnitudes son \textbf{saldos que cuadran por construcción}. Su fuerza es la coherencia; su límite, que las identidades se cumplen siempre y no explican nada por sí solas.};

  % ================= GLOSARIO =================
  \node[caja, fill=black!3, anchor=north west, inner sep=5pt, text width=15.15cm] at ([yshift=-0.35cm]R.south west)
    {\textbf{Glosario de notación.}\\[2pt]
     \renewcommand{\arraystretch}{1.05}%
     \begin{tabular}{@{}>{$}l<{$}@{\;\;}>{\raggedright\arraybackslash}p{3.5cm}@{\quad}>{$}l<{$}@{\;\;}>{\raggedright\arraybackslash}p{3.3cm}@{\quad}>{$}l<{$}@{\;\;}>{\raggedright\arraybackslash}p{4.05cm}@{}}
       \text{S.11, S.12} & sociedades no financieras y financieras & \text{P, D} & bienes y servicios; distribución & CF_i & capacidad ($+$) o necesidad ($-$) \\
       \text{S.13} & Administraciones públicas & \text{F, NP} & financieras; no producidos & \Delta AF_i,\,\Delta P_i & activos adquiridos; pasivos contraídos \\
       \text{S.14, S.15} & hogares; ISFLSH & \text{D.62, F.2} & prestaciones; depósitos & VAB_j^{pb} & valor añadido a precios básicos \\
       \text{S.1, S.2} & total; resto del mundo & X_t;\ OP,\,OV & stock; flujos & T_p & impuestos netos sobre productos \\
     \end{tabular}};
\end{tikzpicture}
