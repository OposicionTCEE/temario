% Figura: estructura del SCN 2008 frente al SEC 2010, en dos paneles con el mismo flujo:
% sistema -> dos clasificaciones de las unidades (institucional y funcional) -> una sola clasificación de las operaciones
% -> cuentas, que vuelven a separarse (sucesión completa por sectores; solo producción y explotación por ramas);
% aparte, «+ Cuadros y extensiones». Las diferencias del SEC se escriben «≠ rasgo ⇒ implicación», sin color.
% Fuentes: SEC 2010 (Reglamento (UE) n.º 549/2013, anexo A), apartados 1.05-1.15, 1.50, 1.65-1.66, 1.109, 1.115, 2.148 y 19.01-19.05;
% SCN 2008, apartados 2.148 y 5.18 y capítulos 18 a 29; SEC 1979, apartado 109 (una sola clasificación de las operaciones).
% Generar con: bash Code/generar_figura.sh SCN_SEC_2008_2010
\providecommand{\tema}[1]{{\upshape\setlength{\fboxsep}{0.8pt}\fcolorbox{black!40}{white}{\color{black!75}#1}}}%
\providecommand{\sub}[1]{{\leftskip=1em #1\par}}%
\providecommand{\dif}[2]{{\hangindent=0.9em\hangafter=1 $\neq$\,#1 $\Rightarrow$ \textit{#2}\par}}%
\providecommand{\subdif}[2]{{\leftskip=1em\hangindent=0.9em\hangafter=1 $\neq$\,#1 $\Rightarrow$ \textit{#2}\par}}%
\providecommand{\imp}[1]{{\hangindent=0.9em\hangafter=1 $\Rightarrow$ \textit{#1}\par}}%
\providecommand{\difl}[2]{$\neq$\,#1 $\Rightarrow$ \textit{#2}}%
\begin{tikzpicture}[
  font=\footnotesize,
  cab/.style={draw=#1!55!black, fill=#1!10, rounded corners=2pt, text width=7.588cm, minimum height=2.4cm, align=center, inner sep=3pt, anchor=north west,
    execute at begin node={\hyphenpenalty=10000}},
  txt/.style={text width=#1, align=left, inner sep=3pt, anchor=north west,
    execute at begin node={\hyphenpenalty=10000\parindent=0pt\setlength{\baselineskip}{1.12\baselineskip}}},
  marco/.style={draw=black!40, rounded corners=2pt},
  linea/.style={black!45},
  flecha/.style={black!45, -{Latex[length=1.4mm]}}]
  % Ejes de cada panel: centro, rama institucional (izquierda) y rama funcional (derecha)
  \coordinate (cA) at (3.9,0);  \coordinate (lA) at (2.15,0);  \coordinate (rA) at (6.15,0);
  \coordinate (cB) at (12.1,0); \coordinate (lB) at (10.35,0); \coordinate (rB) at (14.35,0);
  % Sistema
  \node[cab=blue] (hA) at (0,0) {\textbf{\small SCN 2008}\\ Naciones Unidas, Comisión Europea, FMI,\\ OCDE y Banco Mundial\\ recomendación internacional};
  \node[cab=violet] (hB) at (8.2,0) {\textbf{\small SEC 2010}\\ Reglamento (UE) n.º 549/2013 $\cdot$ anexo A: metodología\\
    \difl{obligatorio}{mismas cifras en toda la Unión para el cuarto recurso, los Fondos Estructurales y el déficit excesivo}\\
    \difl{anexo B: programa de transmisión}{qué cuadros envía cada Estado a Eurostat y cuándo}};
  \path let \p1=(hA.south), \p2=(hB.south) in coordinate (y0) at (0,{min(\y1,\y2)});
  \coordinate (r1) at ($(y0)+(0,-0.6)$); \coordinate (m0) at ($(y0)!0.5!(r1)$);
  % Dos clasificaciones de las unidades
  \node[txt=4.088cm] (a1) at ($(r1)+(0,0)$) {\textbf{Clasificación institucional}\par
    unidades institucionales $\to$ sectores\hfill\tema{3.A.30}\par
    S.11 sociedades no financieras\par
    S.12 sociedades financieras*\par
    S.13 gobierno general* \tema{4.B.23}\par
    \sub{central $\cdot$ estatal $\cdot$ local}
    \sub{fondos de seguridad social}
    S.14 hogares $\cdot$ S.15 ISFLSH\par
    S.2 resto del mundo \tema{3.B.11}};
  \node[txt=3.088cm] (a2) at ($(r1)+(4.5,0)$) {\textbf{Clasificación funcional*}\par
    establecimientos* $\to$ industrias* (CIIU Rev. 4) \tema{3.A.31}\par
    productos (CCP Ver. 2)};
  \node[txt=4.088cm] (b1) at ($(r1)+(8.2,0)$) {\textbf{Clasificación institucional}\par
    unidades institucionales $\to$ sectores\hfill\tema{3.A.30}\par
    S.11 sociedades no financieras\par
    S.12 instituciones financieras\par
    \subdif{subsectores reordenados}{los que necesita la unión monetaria}
    S.13 administraciones públicas \tema{4.B.23}\par
    \sub{central $\cdot$ regional* $\cdot$ local*}
    \sub{fondos de la seguridad social*}
    \subdif{criterio del $50\%$ para separar productores de mercado y no de mercado}{qué unidades públicas cuentan en el déficit y la deuda}
    S.14 hogares $\cdot$ S.15 ISFLSH\par
    S.2 resto del mundo \tema{3.B.11}\par
    \subdif{S.21 Unión Europea / S.22 terceros países}{cuentas de la Unión y de la zona del euro frente a terceros \tema{3.B.37}}};
  \node[txt=3.088cm] (b2) at ($(r1)+(12.7,0)$) {\textbf{Clasificación funcional*}\par
    UAE locales $\to$ ramas de actividad \tema{3.A.31}\par
    productos\par
    \dif{NACE Rev. 2 (en España, CNAE-2009) y CPA}{las mismas que las demás estadísticas de la Unión}};
  \path let \p1=(a1.south), \p2=(a2.south), \p3=(b1.south), \p4=(b2.south) in coordinate (s1) at (0,{min(\y1,\y2,\y3,\y4)});
  \coordinate (r2) at ($(s1)+(0,-0.6)$); \coordinate (m1) at ($(s1)!0.5!(r2)$);
  % Una sola clasificación de las operaciones
  \node[txt=7.588cm] (a3) at ($(r2)+(0,0)$) {\textbf{Operaciones}: una sola clasificación, común a sectores y ramas\par
    P bienes y servicios $\cdot$ D distribución $\cdot$ F financieras $\cdot$ NP activos no producidos\par
    K otras variaciones de los activos: otros flujos, que no son operaciones\par
    cada tipo, explicado en el capítulo de la cuenta en que se registra\par
    \imp{lo que se registra a la vez por sectores y por ramas (p. ej., las subvenciones) suma lo mismo en las dos: las dos representaciones cuadran}};
  \node[txt=7.588cm] (b3) at ($(r2)+(8.2,0)$) {\textbf{Operaciones}: la misma clasificación (P $\cdot$ D $\cdot$ F $\cdot$ NP; otros flujos: K)\par
    \dif{un capítulo por tipo de operación, definida por lo que incluye y lo que excluye}{datos más coherentes entre Estados miembros}
    \dif{remite a Intrastat y a las contribuciones a la Unión}{reglas comunes para el comercio sin aduanas y el presupuesto europeo \tema{3.B.37}}
    \dif{no registra la producción doméstica de bienes poco significativa (confección, muebles)}{frontera de la producción algo más estrecha}};
  \path let \p1=(a3.south), \p2=(b3.south) in coordinate (s2) at (0,{min(\y1,\y2)});
  \coordinate (r3) at ($(s2)+(0,-0.6)$); \coordinate (m2) at ($(s2)!0.5!(r3)$);
  % Cuentas: la sucesión completa, solo por sectores
  \node[txt=4.088cm] (a4) at ($(r3)+(0,0)$) {\textbf{Cuentas de los sectores}\hfill\tema{3.A.30}\par
    la sucesión completa:\par
    I producción\par
    II distribución y utilización de la renta\par
    III acumulación: capital, financiera y otras variaciones\par
    IV balances\par
    V resto del mundo \tema{3.B.11}\par
    sector público \tema{4.B.26}};
  \node[txt=3.088cm] (a5) at ($(r3)+(4.5,0)$) {\textbf{Cuentas por industrias*}\par
    solo producción y generación de la renta*, dentro de los cuadros de oferta y utilización y de los input-output \tema{3.A.31}\par
    \imp{un establecimiento solo tiene datos de producción: la renta y el patrimonio son de la unidad institucional}};
  \node[txt=4.088cm] (b4) at ($(r3)+(8.2,0)$) {\textbf{Cuentas de los sectores}\hfill\tema{3.A.30}\par
    la misma sucesión completa (I a V)\par
    cuentas de las AAPP \tema{4.B.26}};
  \node[txt=3.088cm] (b5) at ($(r3)+(12.7,0)$) {\textbf{Cuentas por ramas}\par
    solo producción y explotación, dentro de las tablas de origen y destino y de las input-output simétricas \tema{3.A.31}};
  \path let \p1=(a4.south), \p2=(a5.south), \p3=(b4.south), \p4=(b5.south) in coordinate (s3) at (0,{min(\y1,\y2,\y3,\y4)});
  \coordinate (r4) at ($(s3)+(0,-0.55)$);
  % Aparte del esquema básico: cuadros y extensiones
  \node[txt=7.588cm] (a6) at ($(r4)+(0,0)$) {\textbf{+ Cuadros y extensiones}\par
    cuadros: población e insumo de trabajo $\cdot$ servicios del capital $\cdot$ flujo de fondos de quién a quién\par
    extensiones: cuentas trimestrales y regionales $\cdot$ cuentas satélite $\cdot$ economía informal};
  \node[txt=7.588cm] (b6) at ($(r4)+(8.2,0)$) {\textbf{+ Cuadros y extensiones}\par
    cuadros: población y empleo $\cdot$ cuenta financiera por deudor y acreedor\par
    extensiones: cuentas trimestrales\par
    \dif{cuentas regionales obligatorias (NUTS)}{reparto de los Fondos Estructurales \tema{3.B.40}}
    \dif{marco central y cuentas no principales (tablas suplementarias y cuentas satélite)}{lo que no se mide igual en todos los Estados, como los derechos de pensión \tema{4.B.24}, queda fuera del marco central}};
  \path let \p1=(a6.south), \p2=(b6.south) in coordinate (s4) at (0,{min(\y1,\y2)});
  % Marcos de igual altura en cada fila
  \foreach \n/\s in {a1/s1,a2/s1,b1/s1,b2/s1,a3/s2,b3/s2,a4/s3,a5/s3,b4/s3,b5/s3,a6/s4,b6/s4}
    \draw[marco] (\n.north west) rectangle (\n.east |- \s);
  % Flujo: el sistema se abre en dos clasificaciones, que comparten las operaciones y vuelven a separarse en las cuentas
  \foreach \P in {A,B} {
    \draw[linea] (c\P |- y0) -- (c\P |- m0);
    \draw[linea] (l\P |- m0) -- (r\P |- m0);
    \draw[flecha] (l\P |- m0) -- (l\P |- r1);
    \draw[flecha] (r\P |- m0) -- (r\P |- r1);
    \draw[linea] (l\P |- s1) -- (l\P |- m1);
    \draw[linea] (r\P |- s1) -- (r\P |- m1);
    \draw[linea] (l\P |- m1) -- (r\P |- m1);
    \draw[flecha] (c\P |- m1) -- (c\P |- r2);
    \draw[linea] (c\P |- s2) -- (c\P |- m2);
    \draw[linea] (l\P |- m2) -- (r\P |- m2);
    \draw[flecha] (l\P |- m2) -- (l\P |- r3);
    \draw[flecha] (r\P |- m2) -- (r\P |- r3);
  }
  % Separación del esquema básico
  \draw[black!40, dashed] ($(s3)+(0,-0.275)$) -- ++(16,0);
  % Leyenda
  \node[anchor=north west, text width=16cm, align=left, inner sep=0pt, font=\footnotesize] at ($(s4)+(0,-0.3)$) {
    $\neq$ diferencia del SEC respecto al SCN \quad $\Rightarrow$ \textit{implicación} \quad \tema{3.A.31} tema en que se trata\\[2pt]
    \textit{Cuadros}: traducción de \textit{tables}, que el SEC llama \textit{tablas}: presentan los datos en forma de matriz, cruzando dos clasificaciones (productos y ramas; sectores acreedores y deudores\dots).\\[2pt]
    * Términos del SCN: \textit{sociedades financieras} = instituciones financieras; \textit{gobierno general} = administraciones públicas; \textit{establecimientos} = UAE locales; \textit{industrias} = ramas de actividad; \textit{generación de la renta} = explotación.
    Términos del SEC: \textit{administración regional} = comunidades autónomas; \textit{administración local} = corporaciones locales; \textit{fondos de la seguridad social} = administraciones de seguridad social (4.B.23).
    \textit{Clasificación funcional}: por ramas de actividad, no la del gasto público (COFOG, 4.B.22 y 4.B.23).};
\end{tikzpicture}
