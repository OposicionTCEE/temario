% Figura: estructura del SCN 2008 frente al SEC 2010, en dos paneles. Solo conceptos.
% Diferencias según el propio SEC 2010 (anexo A, apartados 1.05-1.15 y 1.50); nomenclatura de cada norma (SEC 2010 en su texto español).
% Generar con: bash Code/generar_figura.sh SCN_SEC_2008_2010
\colorlet{cdif}{orange!30}
\providecommand{\dif}[1]{{\setlength{\fboxsep}{0.8pt}\colorbox{cdif}{#1}}}
\providecommand{\aus}[1]{{\color{black!55}\itshape #1}}
\providecommand{\tema}[1]{{\setlength{\fboxsep}{0.8pt}\fcolorbox{black!40}{white}{\color{black!75}#1}}}
\begin{tikzpicture}[
  font=\footnotesize,
  cab/.style={draw=#1!55!black, fill=#1!10, rounded corners=2pt, text width=7.25cm, align=center, inner sep=3pt, anchor=north west, execute at begin node={\hyphenpenalty=10000}},
  rama/.style={text width=6.6cm, align=left, inner sep=3pt, anchor=north west,
    execute at begin node={\hyphenpenalty=10000\setlength{\baselineskip}{1.12\baselineskip}}},
  marco/.style={draw=black!40, rounded corners=2pt},
  flecha/.style={black!45, -{Latex[length=1.4mm]}}]
  % Cabeceras (raíz de cada panel)
  \node[cab=blue] (hA) at (0,0) {\textbf{\small SCN 2008}\\ Naciones Unidas, Comisión Europea, FMI, OCDE y Banco Mundial\\ recomendación internacional};
  \node[cab=violet] (hB) at (8.2,0) {\textbf{\small SEC 2010}\\ \dif{Reglamento (UE) n.º 549/2013: obligatorio}\\ anexo A: metodología $\cdot$ \dif{anexo B: programa de transmisión}};
  \coordinate (eA) at (0.3,0); \coordinate (eB) at (8.5,0);
  \path let \p1=(hA.south), \p2=(hB.south) in coordinate (r1) at (0,{min(\y1,\y2)-0.25cm});
  % Fila 1: clasificación institucional
  \node[rama] (a1) at ($(r1)+(0.6,0)$) {\textbf{Clasificación institucional}\hfill\tema{3.A.30}\\
    unidades institucionales $\to$ sectores:\\
    S.11 sociedades no financieras\\ S.12 sociedades financieras*\\
    S.13 gobierno general* \tema{4.B.23}\\ \hspace*{1em}(central, estatal, local y seguridad social)\\
    S.14 hogares $\cdot$ S.15 ISFLSH\\ S.2 resto del mundo \tema{3.B.11}};
  \node[rama] (b1) at ($(r1)+(8.8,0)$) {\textbf{Clasificación institucional}\hfill\tema{3.A.30}\\
    unidades institucionales $\to$ sectores:\\
    S.11 sociedades no financieras\\
    S.12 instituciones financieras:\\ \hspace*{1em}\dif{subsectores reordenados para la UEM (IFM)}\\
    S.13 administraciones públicas \tema{4.B.23}\\ \hspace*{1em}central $\cdot$ regional* $\cdot$ local*\\ \hspace*{1em}fondos de la seguridad social*\\
    S.14 hogares $\cdot$ S.15 ISFLSH\\
    S.2 resto del mundo \tema{3.B.11}\\ \hspace*{1em}\dif{S.21 Unión Europea / S.22 terceros países}\\
    \dif{criterio del $50\%$: productor de mercado o no de mercado}};
  \path let \p1=(a1.south), \p2=(b1.south) in coordinate (s1) at (0,{min(\y1,\y2)});
  \coordinate (r2) at ($(s1)+(0,-0.22)$);
  % Fila 2: clasificación funcional
  \node[rama] (a2) at ($(r2)+(0.6,0)$) {\textbf{Clasificación funcional*}\hfill\tema{3.A.31}\\
    establecimientos $\to$ industrias* (CIIU Rev. 4)\\ productos (CCP Ver. 2)};
  \node[rama] (b2) at ($(r2)+(8.8,0)$) {\textbf{Clasificación funcional*}\hfill\tema{3.A.31}\\
    UAE locales $\to$ ramas de actividad\\ \dif{NACE Rev. 2 (en España, CNAE-2009)} $\cdot$ \dif{productos: CPA}};
  \path let \p1=(a2.south), \p2=(b2.south) in coordinate (s2) at (0,{min(\y1,\y2)});
  \coordinate (r3) at ($(s2)+(0,-0.22)$);
  % Fila 3: operaciones
  \node[rama] (a3) at ($(r3)+(0.6,0)$) {\textbf{Operaciones}\\
    P bienes y servicios $\cdot$ D distribución $\cdot$ F financieras\\ y otras variaciones de los activos (K)\\
    explicadas en el capítulo de cada cuenta};
  \node[rama] (b3) at ($(r3)+(8.8,0)$) {\textbf{Operaciones}\\
    P $\cdot$ D $\cdot$ F $\cdot$ K, \dif{con un capítulo para cada tipo}\\
    \dif{definidas por lo que incluyen y lo que excluyen}\\
    \dif{flujos propios de la Unión: Intrastat, contribuciones} \tema{3.B.37}\\
    \dif{sin la producción doméstica de bienes poco significativa}};
  \path let \p1=(a3.south), \p2=(b3.south) in coordinate (s3) at (0,{min(\y1,\y2)});
  \coordinate (r4) at ($(s3)+(0,-0.22)$);
  % Fila 4: cuentas
  \node[rama] (a4) at ($(r4)+(0.6,0)$) {\textbf{Cuentas}\hfill\tema{3.A.30}\\
    I producción\\ II distribución y utilización de la renta\\ III acumulación (capital, financiera, otras variaciones)\\
    IV balances $\cdot$ V resto del mundo};
  \node[rama] (b4) at ($(r4)+(8.8,0)$) {\textbf{Cuentas}\hfill\tema{3.A.30}\\
    la misma sucesión de cuentas (I a V), y además:\\
    cuentas trimestrales $\cdot$ \dif{cuentas regionales} \tema{3.B.40}\\
    cuentas de las AAPP \tema{4.B.26} $\cdot$ \dif{cuentas europeas} \tema{3.B.37}};
  \path let \p1=(a4.south), \p2=(b4.south) in coordinate (s4) at (0,{min(\y1,\y2)});
  \coordinate (r5) at ($(s4)+(0,-0.22)$);
  % Fila 5: cuadros y extensiones
  \node[rama] (a5) at ($(r5)+(0.6,0)$) {\textbf{Cuadros y extensiones}\\
    cuadros de oferta y utilización $\cdot$ input-output \tema{3.A.31}\\
    de quién a quién $\cdot$ trabajo $\cdot$ servicios del capital\\
    cuentas satélite $\cdot$ economía informal};
  \node[rama] (b5) at ($(r5)+(8.8,0)$) {\textbf{Cuadros y extensiones}\\
    tablas de origen y destino $\cdot$ input-output \tema{3.A.31}\\
    cuentas satélite\\
    \dif{marco central y cuadros complementarios}\\ \hspace*{1em}(p. ej., derechos de pensión \tema{4.B.24})};
  \path let \p1=(a5.south), \p2=(b5.south) in coordinate (s5) at (0,{min(\y1,\y2)});
  % Marcos de igual altura en cada fila, flechas y ejes
  \foreach \i in {1,...,5} {
    \draw[marco] (a\i.north west) rectangle (a\i.east |- s\i);
    \draw[marco] (b\i.north west) rectangle (b\i.east |- s\i);
    \coordinate (ta\i) at ($(a\i.north west)+(0,-0.26)$);
    \coordinate (tb\i) at ($(b\i.north west)+(0,-0.26)$);
    \draw[flecha] (eA |- ta\i) -- (ta\i);
    \draw[flecha] (eB |- tb\i) -- (tb\i);
  }
  \draw[black!45] (eA |- hA.south) -- (eA |- ta5);
  \draw[black!45] (eB |- hB.south) -- (eB |- tb5);
  % Leyenda
  \node[anchor=north west, text width=15.4cm, align=left, inner sep=0pt, font=\footnotesize] at ($(s5)+(0,-0.3)$) {
    \dif{\phantom{xx}} diferencia entre los dos sistemas \quad \tema{3.A.31} tema en que se trata\\[2pt]
    * Términos del SCN: \textit{sociedades financieras} = instituciones financieras; \textit{gobierno general} = administraciones públicas; \textit{industrias} = ramas de actividad.
    Términos del SEC: \textit{administración regional} = comunidades autónomas; \textit{administración local} = corporaciones locales; \textit{fondos de la seguridad social} = administraciones de seguridad social (4.B.23).
    \textit{Clasificación funcional}: por ramas de actividad, no la del gasto público (COFOG, 4.B.22 y 4.B.23).};
\end{tikzpicture}
