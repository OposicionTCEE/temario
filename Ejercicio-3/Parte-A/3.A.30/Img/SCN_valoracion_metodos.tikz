% Figura: orden de preferencia de los métodos de valoración del SEC 2010.
% Fuente de SCN_valoracion_metodos.pdf. Cada pregunta remite al método siguiente cuando no puede aplicarse el anterior.
\begin{tikzpicture}[>=stealth,
  preg/.style={execute at begin node={\hyphenpenalty=10000}, draw=black!60, rounded corners=6pt, fill=black!4, align=center, font=\footnotesize, text width=4.3cm, minimum height=1.0cm},
  met/.style={execute at begin node={\hyphenpenalty=10000}, draw=black!75, line width=0.7pt, fill=#1, align=left, font=\footnotesize, text width=6.3cm, minimum height=1.0cm, inner sep=4pt},
  met/.default=blue!10,
  si/.style={font=\scriptsize\itshape, text=black!70},
  fl/.style={->, line width=0.7pt, black!70}]
  \node[preg] (q1) at (0,0) {¿Se intercambia en el mercado entre partes independientes?};
  \node[preg, below=0.75cm of q1] (q2) {¿Hay precios de mercado de bienes, servicios o activos análogos?};
  \node[preg, below=0.75cm of q2] (q3) {¿Pueden medirse sus costes de producción?};
  \node[preg, below=0.75cm of q3] (q4) {Último recurso};
  \node[met, right=1.5cm of q1] (m1) {\textbf{1. Precios de mercado}\\ lo que pagan compradores y vendedores independientes y voluntarios};
  \node[met, right=1.5cm of q2] (m2) {\textbf{2. Equivalentes de mercado}\\ trueques, alquiler imputado de la vivienda propia, autoconsumo};
  \node[met, right=1.5cm of q3] (m3) {\textbf{3. Costes de producción}\\ servicios no de mercado de las AAPP y las ISFLSH, inversión por cuenta propia};
  \node[met=orange!14, right=1.5cm of q4] (m4) {\textbf{4. Valor actual de los rendimientos esperados}\\ recursos naturales, algunos activos sin mercado};
  \foreach \i in {1,2,3} { \draw[fl] (q\i) -- node[si, above] {sí} (m\i); }
  \draw[fl] (q4) -- (m4);
  \draw[fl] (q1) -- node[si, right] {no} (q2);
  \draw[fl] (q2) -- node[si, right] {no} (q3);
  \draw[fl] (q3) -- node[si, right] {no} (q4);
  % Gradiente de fiabilidad
  \draw[->, line width=1.4pt, black!45] ([xshift=0.45cm]m1.north east) -- ([xshift=0.45cm]m4.south east)
    node[midway, right, font=\scriptsize, align=left, text=black!65] {más\\ supuestos,\\ menos\\ observación};
\end{tikzpicture}
