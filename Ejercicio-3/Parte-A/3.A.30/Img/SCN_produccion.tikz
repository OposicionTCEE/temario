% Figura: bloque de filas de la cuenta de producción (I), de la cuenta exterior de bienes y servicios (V.I) y de los usos finales de la cuenta de bienes y servicios (0).
% Fuente de SCN_produccion.pdf. Convención de GODLEY y LAVOIE (2007) sobre las columnas del cuadro de cuentas económicas integradas del SEC 2010.
\providecommand{\op}[2]{\shortstack[l]{\textbf{#1}\\ \textcolor{black!65}{\scriptsize #2}}}
\begin{tikzpicture}[>=stealth,
  c/.style={draw=black!70, line width=0.5pt, minimum width=1.75cm, minimum height=0.95cm, font=\small, align=center, anchor=center},
  h/.style={c, fill=black!6, font=\footnotesize\bfseries, minimum height=1.25cm},
  ht/.style={h, fill=black!16},
  f/.style={c, text width=5.0cm, minimum width=5.3cm, font=\footnotesize, align=left, fill=black!3},
  cor/.style={c, fill=blue!7}, ext/.style={c, fill=green!8},
  tot/.style={c, fill=black!12}, vac/.style={c, fill=white},
  pen/.style={c, fill=white, text=black!45, font=\scriptsize\itshape},
  cero/.style={c, fill=white, text=black!55, minimum width=0.9cm},
  sig/.style={h, minimum width=0.9cm},
  sal/.style={c, fill=blue!18, font=\small\bfseries},
  salt/.style={sal, fill=black!22}]
  \matrix (m) [matrix of nodes, column sep=-0.5pt, row sep=-0.5pt, nodes in empty cells]
  {
    |[f, fill=white, draw=none]| &
    |[h]| \shortstack{Hogares\\ e ISFLSH} &
    |[h]| Sociedades &
    |[h]| AAPP &
    |[ht]| \shortstack{Total\\ economía} &
    |[h]| \shortstack{Resto\\ del mundo} &
    |[h]| \shortstack{Bienes y\\ servicios} &
    |[sig]| $\Sigma$ \\
    |[f]| \op{Producción}{P.1, a precios básicos} & |[cor]| $+VP_H$ & |[cor]| $+VP_S$ & |[cor]| $+VP_G$ & |[tot]| $+VP$ & |[vac]| & |[cor]| $-VP$ & |[cero]| $0$ \\
    |[f]| \op{Consumos intermedios}{P.2, a precios de adquisición} & |[cor]| $-CI_H$ & |[cor]| $-CI_S$ & |[cor]| $-CI_G$ & |[tot]| $-CI$ & |[vac]| & |[cor]| $+CI$ & |[cero]| $0$ \\
    |[f]| \op{Impuestos netos sobre los productos}{D.21 $-$ D.31: aún sin asignar a ningún sector} & |[vac]| & |[vac]| & |[vac]| & |[tot]| $+T_p$ & |[vac]| & |[cor]| $-T_p$ & |[cero]| $0^{*}$ \\
    |[f]| \op{Exportaciones}{P.6 (cuenta V.I)} & |[vac]| & |[vac]| & |[vac]| & |[tot]| & |[ext]| $-X$ & |[ext]| $+X$ & |[cero]| $0$ \\
    |[f]| \op{Importaciones}{P.7 (cuenta V.I)} & |[vac]| & |[vac]| & |[vac]| & |[tot]| & |[ext]| $+M$ & |[ext]| $-M$ & |[cero]| $0$ \\
    |[f]| \op{Gasto en consumo final}{P.3: el empleo se anota en II.4} & |[pen]| en II.4 & |[vac]| & |[pen]| en II.4 & |[pen, fill=black!12]| en II.4 & |[vac]| & |[cor]| $+C$ & |[cero]| \\
    |[f]| \op{Formación bruta de capital}{P.5: el empleo se anota en III.1} & |[pen]| en III.1 & |[pen]| en III.1 & |[pen]| en III.1 & |[pen, fill=black!12]| en III.1 & |[vac]| & |[cor]| $+FBC$ & |[cero]| \\
    |[f, fill=blue!18]| \op{Saldo}{suma de la columna} & |[sal]| $VAB_H$ & |[sal]| $VAB_S$ & |[sal]| $VAB_G$ & |[salt]| $PIB$ & |[sal, fill=green!16]| $M-X$ & |[sal]| $0$ & |[cero]| \\
  };
  % Doble raya sobre la fila de saldos
  \draw[line width=1.2pt, black!75] (m-9-1.north west) -- (m-9-8.north east);
  % Lecturas
  \draw[->, line width=1.0pt, black!60] ([yshift=-0.2cm]m-9-5.south) -- ++(0,-0.6)
    node[below, font=\scriptsize, text=black!75, align=center] {$PIB=\sum VAB+T_p$\\ (enfoque de la producción)};
  \draw[->, line width=1.0pt, black!60] ([yshift=-0.2cm]m-9-7.south) -- ++(0,-0.6)
    node[below, font=\scriptsize, text=black!75, align=center] {$VP+M+T_p=CI+C+FBC+X$\\ (cuenta de bienes y servicios)};
  \node[font=\scriptsize, text=black!75, anchor=north west, align=left, text width=15.3cm, execute at begin node={\hyphenpenalty=10000}] at ([yshift=-1.75cm]m-9-1.south west)
    {$^{*}$ El SEC suma los impuestos netos sobre los productos al total de la economía para obtener el PIB, pero no los asigna a ningún sector hasta la cuenta de asignación de la renta primaria, en la que son un recurso de las AAPP. En esta fila, el total no es aún la suma de los sectores, y la fila cuadra con él: Total $+$ Bienes y servicios $=0$.\\
     Las celdas en cursiva se llenarán en las cuentas de utilización de la renta (II.4) y de capital (III.1). La columna del resto del mundo se lee desde su punto de vista: $M-X$ es el saldo de los intercambios exteriores de bienes y servicios.};
\end{tikzpicture}
