% Figura: esquema de una página de las cuentas de acumulación, los balances y el resto del mundo (bloque 2, segunda parte;
% anexo «Material de estudio: Esquema»), con sus usos y límites. Secuencia: problema -> herramienta (de los flujos a los stocks)
% -> solución (cadena de cuentas) -> para qué sirve y dónde falla -> glosario.
% Generar con: bash Code/generar_figura.sh SCN_esquema_acumulacion
\begin{tikzpicture}[>=stealth,
  caja/.style={draw=black!70, rounded corners=3pt, line width=0.6pt, align=left, font=\footnotesize, inner sep=4pt},
  sec/.style={font=\small\bfseries, anchor=north west},
  tit/.style={font=\footnotesize, anchor=north west, align=left},
  paso/.style={draw=black!70, rounded corners=3pt, line width=0.6pt, fill=blue!3, minimum width=15.43cm, minimum height=1.65cm, anchor=north west, inner sep=0pt},
  num/.style={circle, fill=black!80, text=white, font=\footnotesize\bfseries, inner sep=1.2pt, minimum size=0.45cm},
  enlace/.style={->, line width=1pt, blue!50!black},
  maniobra/.style={font=\footnotesize\itshape, text=blue!50!black, anchor=west},
  chip/.style={draw=black!60, rounded corners=2pt, font=\footnotesize, inner sep=3pt, minimum height=0.5cm, fill=blue!12, align=center}]

  % ================= EL PROBLEMA =================
  \node[sec, text=red!50!black] at (0,0) {El problema};
  \node[caja, fill=red!6, text width=15.15cm, anchor=north west] (P) at (0,-0.45)
    {\textbf{¿En qué se convierte el ahorro, cómo se financia cada sector y cómo cambia la riqueza?} Las cuentas corrientes terminan en el ahorro, pero no dicen en qué se materializa ni cómo se financia la inversión.};

  % ================= LA HERRAMIENTA =================
  \node[sec, text=blue!50!black] (hH) at ([yshift=-0.3cm]P.south west) {La herramienta: las cuentas de acumulación y los balances};
  \node[caja, fill=blue!4, text width=15.15cm, minimum height=1.75cm, anchor=north west] (H) at ([yshift=-0.12cm]hH.south west)
    {\parbox[t]{6.3cm}{Ya no registran recursos y empleos, sino variaciones de los activos y de los pasivos y del patrimonio neto. Explican, partida a partida, por qué el balance final difiere del inicial.}};
  \begin{scope}[shift={(H.north west)}]
    \node[chip, fill=black!10] (b0) at (7.6,-0.85) {Balance\\ inicial (IV.1)};
    \node[chip] (ac) at (10.75,-0.85) {Capital, financiera y\\ otras variaciones (III)};
    \node[chip, fill=black!10] (b1) at (13.95,-0.85) {Balance\\ final (IV.3)};
    \draw[->, line width=0.9pt] (b0) -- (ac); \draw[->, line width=0.9pt] (ac) -- (b1);
  \end{scope}

  % ================= LA SOLUCIÓN =================
  \node[sec, text=blue!50!black] (hS) at ([yshift=-0.3cm]H.south west) {La solución: la sucesión de cuentas};

  % Paso 1: capital
  \node[paso] (k1) at ([yshift=-0.15cm]hS.south west) {};
  \node[num] at (k1.north west) {1};
  \begin{scope}[shift={(k1.north west)}]
    \node[tit, text width=4.1cm] at (0.25,-0.1) {\textbf{Capital (III.1)}\\[1pt] $CF_j=AB_j+TK_j-FBC_j-NP_j$\\[1pt] $CF=ANB+TKN-FBC$};
    \node[tit, text width=6.4cm] at (4.6,-0.1) {El ahorro y las transferencias de capital financian la inversión. El saldo es la \textbf{capacidad} ($+$) o \textbf{necesidad} ($-$) \textbf{de financiación}: lo que el sector presta al resto o le pide prestado.};
    \fill[blue!30] (11.4,-0.62) rectangle (14.4,-0.3); \node[font=\footnotesize] at (12.9,-0.46) {$AB+TK$};
    \fill[black!15] (11.4,-1.12) rectangle (13.4,-0.8); \node[font=\footnotesize] at (12.4,-0.96) {$FBC+NP$};
    \fill[green!30] (13.4,-1.12) rectangle (14.4,-0.8); \node[font=\footnotesize] at (13.9,-0.96) {$CF$};
    \node[font=\footnotesize, anchor=west] at (14.45,-0.96) {$>0$};
  \end{scope}

  % Paso 2: financiera
  \node[paso] (k2) at ([yshift=-0.42cm]k1.south west) {};
  \node[num] at (k2.north west) {2};
  \draw[enlace] ([xshift=2.2cm]k1.south west) -- ([xshift=2.2cm]k2.north west) node[midway, maniobra, xshift=2pt] {el mismo saldo, por el lado financiero};
  \begin{scope}[shift={(k2.north west)}]
    \node[tit, text width=4.1cm] at (0.25,-0.1) {\textbf{Financiera (III.2)}\\[1pt] $CF_j=\sum_k\left(\Delta A_j^{k}-\Delta P_j^{k}\right)$\\[1pt] $\sum_j CF_j+CF_{RM}=0$};
    \node[tit, text width=6.4cm] at (4.6,-0.1) {Ocho instrumentos (F.1 a F.8) dicen cómo presta o se endeuda cada sector. Con ella, \textbf{cada columna suma cero}: nadie gasta sin obtener los fondos de algún sitio. Entre las dos vías hay una discrepancia estadística.};
    \node[chip, fill=green!20] (pr) at (12.1,-0.75) {Hogares\\ $CF>0$};
    \node[chip, fill=red!15] (en) at (14.55,-0.75) {Sociedades\\ $CF<0$};
    \draw[->, line width=0.9pt] (pr) -- node[above, font=\footnotesize] {préstamo} (en);
    \node[font=\footnotesize, anchor=north] at (13.3,-1.2) {$\Delta A$ de uno $=\Delta P$ de otro};
  \end{scope}

  % Paso 3: otras variaciones y balances
  \node[paso] (k3) at ([yshift=-0.42cm]k2.south west) {};
  \node[num] at (k3.north west) {3};
  \draw[enlace] ([xshift=2.2cm]k2.south west) -- ([xshift=2.2cm]k3.north west) node[midway, maniobra, xshift=2pt] {se acumula en los balances};
  \begin{scope}[shift={(k3.north west)}]
    \node[tit, text width=4.1cm] at (0.25,-0.1) {\textbf{Otras variaciones (III.3) y balances (IV)}\\[1pt] $X_t=X_{t-1}+OP_t+OV_t+R_t$\\[1pt] $RN=K-PN_{RM}$};
    \node[tit, text width=6.4cm] at (4.6,-0.1) {Descubrimientos, catástrofes y revalorizaciones cambian la riqueza sin ser renta ni ahorro. Los activos financieros de unos son pasivos de otros: la \textbf{riqueza nacional} es $K$ menos lo que se debe al exterior.};
    \fill[blue!30] (11.4,-1.15) rectangle (12.6,-0.35); \node[font=\footnotesize] at (12.0,-0.75) {$K$};
    \node[font=\footnotesize] at (12.85,-0.75) {$-$};
    \fill[yellow!50] (13.1,-1.15) rectangle (13.6,-0.85); \node[font=\footnotesize, anchor=north] at (13.35,-1.15) {$PN_{RM}$};
    \node[font=\footnotesize] at (13.9,-0.75) {$=$};
    \fill[green!30] (14.2,-1.15) rectangle (14.9,-0.45); \node[font=\footnotesize] at (14.55,-0.8) {$RN$};
  \end{scope}

  % Paso 4: resto del mundo
  \node[paso] (k4) at ([yshift=-0.42cm]k3.south west) {};
  \node[num] at (k4.north west) {4};
  \draw[enlace] ([xshift=2.2cm]k3.south west) -- ([xshift=2.2cm]k4.north west) node[midway, maniobra, xshift=2pt] {se mira desde el exterior};
  \begin{scope}[shift={(k4.north west)}]
    \node[tit, text width=4.1cm] at (0.25,-0.1) {\textbf{Resto del mundo (V)}\\[1pt] $ANB-FBC=CC$\\[1pt] $CF_{priv}+CF_{G}=CC+KA$};
    \node[tit, text width=6.4cm] at (4.6,-0.1) {Las mismas operaciones con el signo cambiado forman la \textbf{balanza de pagos} (MBP6). El ahorro menos la inversión de la nación es su saldo por cuenta corriente; su acumulación, la posición de inversión internacional.};
    \node[chip, fill=red!12, minimum width=1.2cm] (cp) at (11.95,-0.75) {$CF_{priv}$};
    \node[font=\footnotesize] at (12.75,-0.75) {$+$};
    \node[chip, fill=green!15, minimum width=1.1cm] (cg) at (13.5,-0.75) {$CF_{G}$};
    \node[font=\footnotesize] at (14.2,-0.75) {$=$};
    \node[chip, fill=yellow!40, minimum width=0.8cm] (cc) at (14.8,-0.75) {$CC$};
    \node[font=\footnotesize, anchor=north] at (13.3,-1.12) {nadie mejora su saldo solo};
  \end{scope}

  % ================= USOS Y LÍMITES =================
  \node[sec, text=black!75] (hU) at ([yshift=-0.3cm]k4.south west) {Para qué sirve y dónde falla};
  \node[caja, fill=green!5, text width=7.1cm, minimum height=4.3cm, anchor=north west] (U) at ([yshift=-0.12cm]hU.south west)
    {\textbf{Usos}\\[2pt]
     \textbf{Diagnóstico}: ciclos y el agregado adecuado a cada pregunta (Irlanda, 2021: deuda del $55{,}4\%$ del PIB y del $100{,}9\%$ de la RNB modificada).\\
     \textbf{Política}: déficit y deuda en contabilidad nacional; reglas de la Unión (PDE, desequilibrios: cuenta corriente entre $-4$ y $+6\%$, PII $-35\%$); los saldos sectoriales obligan a proyecciones coherentes.\\
     \textbf{Largo plazo}: crecimiento, distribución, comparación.\\
     \textbf{Los stocks importan}: 2008 se gestó en los balances.};
  \node[caja, fill=orange!6, text width=7.1cm, minimum height=4.3cm, anchor=north west] (Li) at ([xshift=0.65cm]U.north east)
    {\textbf{Límites} ($\to$ respuesta)\\[2pt]
     Frontera de la producción: el trabajo doméstico, qué es productivo ($\to$ cuentas satélite).\\
     Lo que no tiene precio: servicios públicos, SIFMI, lo digital ($\to$ indicadores de volumen).\\
     PIB no es bienestar ($\to$ más allá del PIB).\\
     Sostenibilidad y distribución ($\to$ SCAE, cuentas distributivas).\\
     Separa lo real de lo monetario: identidades sin cierre, financiación previa ($\to$ modelos stock-flujo).\\
     Retos: rapidez, globalización, digitalización (SCN 2025).};

  % ================= GLOSARIO =================
  \node[caja, fill=black!3, anchor=north west, inner sep=5pt, text width=15.15cm] at ([yshift=-0.35cm]U.south west)
    {\textbf{Glosario de notación.} {\itshape $j$: sector; $k$: instrumento financiero.}\\[2pt]
     \renewcommand{\arraystretch}{1.05}%
     \begin{tabular}{@{}>{$}l<{$}@{\;\;}>{\raggedright\arraybackslash}p{3.55cm}@{\quad}>{$}l<{$}@{\;\;}>{\raggedright\arraybackslash}p{3.55cm}@{\quad}>{$}l<{$}@{\;\;}>{\raggedright\arraybackslash}p{3.55cm}@{}}
       AB,\,ANB & ahorro; ahorro nacional & \Delta A,\,\Delta P & activos adquiridos; pasivos & K,\,RN & activos no financieros; riqueza nacional \\
       TK,\,TKN & transferencias de capital (netas) & X_t & stock al final de $t$ & PN_{RM} & patrimonio neto del resto del mundo \\
       FBC,\,NP & formación bruta de capital; no producidos & OP,\,OV,\,R & operaciones; volumen; revalorización & CC,\,KA & cuenta corriente; de capital \\
       CF & capacidad ($+$) o necesidad ($-$) & CF_{priv},\,CF_G & privado; AAPP & PII & posición de inversión internacional \\
     \end{tabular}};
\end{tikzpicture}
