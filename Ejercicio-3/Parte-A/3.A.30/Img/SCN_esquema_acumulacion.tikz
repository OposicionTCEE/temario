% Figura: esquema de una página de las cuentas de acumulación, los balances y el resto del mundo (bloque 2, segunda parte;
% anexo «Material de estudio: Esquema»). En el centro, completas, la matriz de flujos de acumulación (cuentas de capital y
% financiera, como SCN_capital y SCN_financiera) y la matriz de balances (como SCN_balances), unidas por la conciliación;
% a la derecha, lo que añade cada cuenta y su saldo; debajo, el resto del mundo y el glosario.
% Generar con: bash Code/generar_figura.sh SCN_esquema_acumulacion
\begin{tikzpicture}[>=stealth,
  caja/.style={draw=black!70, rounded corners=3pt, line width=0.6pt, align=left, font=\footnotesize, inner sep=4pt},
  sec/.style={font=\small\bfseries, anchor=north west},
  tit/.style={font=\footnotesize, anchor=north west, align=left},
  num/.style={circle, fill=black!80, text=white, font=\footnotesize\bfseries, inner sep=1.2pt, minimum size=0.45cm},
  c/.style={draw=black!70, line width=0.4pt, minimum width=1.42cm, minimum height=0.42cm, font=\footnotesize, inner sep=0.5pt, align=center, anchor=center},
  h/.style={c, fill=black!6, font=\footnotesize\bfseries, minimum height=0.78cm},
  ht/.style={h, fill=black!16},
  f/.style={c, text width=3.75cm, minimum width=3.9cm, align=left, fill=black!3},
  fs/.style={f, fill=red!14, font=\footnotesize\bfseries},
  ab/.style={c, fill=red!3}, acu/.style={c, fill=red!8}, fin/.style={c, fill=red!8}, ext/.style={c, fill=green!8},
  sal/.style={c, fill=red!16, font=\footnotesize\bfseries}, salt/.style={sal, fill=black!18},
  nf/.style={c, fill=orange!14}, pn/.style={c, fill=yellow!22, font=\footnotesize\bfseries},
  tot/.style={c, fill=black!12}, totz/.style={c, fill=black!12, text=black!50},
  vac/.style={c, fill=white},
  cero/.style={c, fill=white, text=black!55, minimum width=0.55cm},
  sig/.style={h, minimum width=0.55cm},
  llave/.style={decorate, decoration={brace, amplitude=3pt}, line width=0.8pt, blue!55!black},
  call/.style={caja, fill=blue!3, text width=3.3cm, anchor=west}]
  \providecommand{\opc}[2]{{\color{black!60}#2}\ #1}

  % ================= EL PROBLEMA =================
  \node[sec, text=red!50!black] at (0,0) {El problema};
  \node[caja, fill=red!6, text width=15.15cm, anchor=north west] (P) at (0,-0.45)
    {\textbf{¿En qué se convierte el ahorro, cómo se financia cada sector y cómo cambia la riqueza?} Las cuentas corrientes terminan en el ahorro; las de acumulación dicen qué se hace con él, y los balances, cuánto se tiene.};

  % ================= LA HERRAMIENTA: LAS DOS MATRICES =================
  \node[sec, text=blue!50!black] (hH) at ([yshift=-0.3cm]P.south west) {La herramienta: los flujos de acumulación y la matriz de balances, completas};
  \node[font=\footnotesize\bfseries, text=red!50!black, anchor=north west] (tA) at ([yshift=-0.08cm]hH.south west) {Flujos del periodo};
  \matrix (a) [matrix of nodes, column sep=-0.4pt, row sep=-0.4pt, nodes in empty cells, anchor=north west] at ([yshift=-0.05cm]tA.south west)
  {
    |[f, fill=white, draw=none]| &
    |[h]| \shortstack{Hogares\\ e ISFLSH} & |[h]| Sociedades & |[h]| AAPP & |[ht]| \shortstack{Total\\ economía} & |[h]| \shortstack{Resto\\ del mundo} & |[sig]| $\Sigma$ \\
    |[f, fill=red!3]| \opc{Abre: ahorro}{B.8} & |[ab]| $+AB_H$ & |[ab]| $+AB_S$ & |[ab]| $+AB_G$ & |[ab, fill=black!8]| $+ANB$ & |[vac]| & |[cero]| \\
    |[f]| \opc{Transferencias de capital}{D.9} & |[acu]| $\pm TK_H$ & |[acu]| $\pm TK_S$ & |[acu]| $\pm TK_G$ & |[tot]| $+TKN$ & |[ext]| $-TKN$ & |[cero]| $0$ \\
    |[f]| \opc{Formación de capital}{P.5} & |[acu]| $-FBC_H$ & |[acu]| $-FBC_S$ & |[acu]| $-FBC_G$ & |[tot]| $-FBC$ & |[vac]| & |[cero]| $0^{\dagger}$ \\
    |[f]| \opc{Activos no producidos}{NP} & |[acu]| $\pm NP_H$ & |[acu]| $\pm NP_S$ & |[acu]| $\pm NP_G$ & |[totz]| $0$ & |[vac]| & |[cero]| $0$ \\
    |[fs]| \opc{Saldo: $CF$}{B.9} & |[sal]| $CF_H$ & |[sal]| $CF_S$ & |[sal]| $CF_G$ & |[salt]| $CF$ & |[sal, fill=green!16]| $-TKN$ & |[cero]| \\
    |[f, fill=red!3]| \opc{Abre: capacidad o necesidad}{B.9} & |[ab]| $+CF_H$ & |[ab]| $+CF_S$ & |[ab]| $+CF_G$ & |[ab, fill=black!8]| $+CF$ & |[ab]| $+CF_{RM}$ & |[cero]| $0$ \\
    |[f]| \opc{Oro monetario y DEG}{F.1} & |[vac]| & |[fin]| $f^{1}_{S}$ & |[vac]| & |[tot]| $f^{1}$ & |[ext]| $f^{1}_{RM}$ & |[cero]| $0^{*}$ \\
    |[f]| \opc{Efectivo y depósitos}{F.2} & |[fin]| $f^{2}_{H}$ & |[fin]| $f^{2}_{S}$ & |[fin]| $f^{2}_{G}$ & |[tot]| $f^{2}$ & |[ext]| $f^{2}_{RM}$ & |[cero]| $0$ \\
    |[f]| \opc{Valores de deuda}{F.3} & |[fin]| $f^{3}_{H}$ & |[fin]| $f^{3}_{S}$ & |[fin]| $f^{3}_{G}$ & |[tot]| $f^{3}$ & |[ext]| $f^{3}_{RM}$ & |[cero]| $0$ \\
    |[f]| \opc{Préstamos}{F.4} & |[fin]| $f^{4}_{H}$ & |[fin]| $f^{4}_{S}$ & |[fin]| $f^{4}_{G}$ & |[tot]| $f^{4}$ & |[ext]| $f^{4}_{RM}$ & |[cero]| $0$ \\
    |[f]| \opc{Participaciones}{F.5} & |[fin]| $f^{5}_{H}$ & |[fin]| $f^{5}_{S}$ & |[fin]| $f^{5}_{G}$ & |[tot]| $f^{5}$ & |[ext]| $f^{5}_{RM}$ & |[cero]| $0$ \\
    |[f]| \opc{Seguros y pensiones}{F.6} & |[fin]| $f^{6}_{H}$ & |[fin]| $f^{6}_{S}$ & |[fin]| $f^{6}_{G}$ & |[tot]| $f^{6}$ & |[ext]| $f^{6}_{RM}$ & |[cero]| $0$ \\
    |[f]| \opc{Derivados financieros}{F.7} & |[fin]| $f^{7}_{H}$ & |[fin]| $f^{7}_{S}$ & |[fin]| $f^{7}_{G}$ & |[tot]| $f^{7}$ & |[ext]| $f^{7}_{RM}$ & |[cero]| $0$ \\
    |[f]| \opc{Otras cuentas pendientes}{F.8} & |[fin]| $f^{8}_{H}$ & |[fin]| $f^{8}_{S}$ & |[fin]| $f^{8}_{G}$ & |[tot]| $f^{8}$ & |[ext]| $f^{8}_{RM}$ & |[cero]| $0$ \\
    |[fs]| Saldo: cada columna suma cero & |[sal]| $0$ & |[sal]| $0$ & |[sal]| $0$ & |[salt]| $0$ & |[sal, fill=green!16]| $0$ & |[cero]| \\
  };
  % Conciliación: de los flujos a los stocks
  \draw[->, line width=1.6pt, blue!50!black] ([yshift=-0.08cm]$(a-16-3.south)!0.5!(a-16-4.south)$) -- ++(0,-0.75)
    node[midway, right=3pt, font=\footnotesize, text=blue!50!black, fill=white, inner sep=1pt] {$X_t=X_{t-1}+OP_t+OV_t+R_t$};
  \node[font=\footnotesize\bfseries, text=orange!45!black, anchor=north west] (tB) at ([yshift=-0.85cm]tA.west |- a-16-1.south) {Stocks al final del periodo};
  \matrix (b) [matrix of nodes, column sep=-0.4pt, row sep=-0.4pt, nodes in empty cells, anchor=north west] at ([yshift=-0.05cm]tB.south west)
  {
    |[f, fill=white, draw=none]| &
    |[h]| \shortstack{Hogares\\ e ISFLSH} & |[h]| Sociedades & |[h]| AAPP & |[ht]| \shortstack{Total\\ economía} & |[h]| \shortstack{Resto\\ del mundo} & |[sig]| $\Sigma$ \\
    |[f]| \opc{Activos no financieros}{AN} & |[nf]| $+K_H$ & |[nf]| $+K_S$ & |[nf]| $+K_G$ & |[tot]| $+K$ & |[vac]| & |[cero]| $+K$ \\
    |[f]| \opc{Efectivo y depósitos}{AF.2} & |[fin]| $a^{2}_{H}$ & |[fin]| $a^{2}_{S}$ & |[fin]| $a^{2}_{G}$ & |[tot]| $a^{2}$ & |[ext]| $a^{2}_{RM}$ & |[cero]| $0$ \\
    |[f]| \opc{Valores de deuda}{AF.3} & |[fin]| $a^{3}_{H}$ & |[fin]| $a^{3}_{S}$ & |[fin]| $a^{3}_{G}$ & |[tot]| $a^{3}$ & |[ext]| $a^{3}_{RM}$ & |[cero]| $0$ \\
    |[f]| \opc{Préstamos}{AF.4} & |[fin]| $a^{4}_{H}$ & |[fin]| $a^{4}_{S}$ & |[fin]| $a^{4}_{G}$ & |[tot]| $a^{4}$ & |[ext]| $a^{4}_{RM}$ & |[cero]| $0$ \\
    |[f]| \opc{Participaciones}{AF.5} & |[fin]| $a^{5}_{H}$ & |[fin]| $a^{5}_{S}$ & |[fin]| $a^{5}_{G}$ & |[tot]| $a^{5}$ & |[ext]| $a^{5}_{RM}$ & |[cero]| $0$ \\
    |[f]| \opc{Otros instrumentos}{AF.1, 6--8} & |[fin]| $a^{o}_{H}$ & |[fin]| $a^{o}_{S}$ & |[fin]| $a^{o}_{G}$ & |[tot]| $a^{o}$ & |[ext]| $a^{o}_{RM}$ & |[cero]| $0^{*}$ \\
    |[f, fill=yellow!22, font=\footnotesize\bfseries]| \opc{Patrimonio neto}{B.90} & |[pn]| $-PN_H$ & |[pn]| $-PN_S$ & |[pn]| $-PN_G$ & |[pn, fill=black!22]| $-RN$ & |[pn, fill=green!16]| $-PN_{RM}$ & |[cero]| $-K$ \\
    |[f, fill=black!6]| \textbf{$\Sigma$} & |[cero, minimum width=1.42cm]| $0$ & |[cero, minimum width=1.42cm]| $0$ & |[cero, minimum width=1.42cm]| $0$ & |[cero, minimum width=1.42cm, fill=black!12]| $0$ & |[cero, minimum width=1.42cm]| $0$ & |[cero]| $0$ \\
  };
  \draw[line width=1.1pt, black!75] (b-8-1.north west) -- (b-8-7.north east);

  % ================= LA SOLUCIÓN: LLAMADAS A LA DERECHA =================
  \draw[llave] ([xshift=0.08cm]a-2-7.north east) -- ([xshift=0.08cm]a-6-7.south east) coordinate[midway] (l1);
  \draw[llave] ([xshift=0.08cm]a-7-7.north east) -- ([xshift=0.08cm]a-16-7.south east) coordinate[midway] (l2);
  \draw[llave] ([xshift=0.08cm]b-2-7.north east) -- ([xshift=0.08cm]b-9-7.south east) coordinate[midway] (l4);
  \node[call] (c1) at ([xshift=0.25cm]l1) {\textbf{Capital (III.1)}\\ $CF=ANB+TKN-FBC$: lo que el sector presta ($+$) o pide prestado ($-$).};
  \node[call] (c2) at ([xshift=0.25cm]l2) {\textbf{Financiera (III.2)}\\ El mismo saldo, por instrumentos: $CF_j=\sum_k f^{k}_{j}$. \textbf{Cada columna suma cero}: nadie gasta sin obtener fondos. $\sum_j CF_j+CF_{RM}=0$; entre las dos vías, una discrepancia estadística.};
  \node[call] (c3) at ([xshift=0.25cm, yshift=-0.85cm]a-16-7.south east) {\textbf{Otras variaciones (III.3)}\\ Volumen y revalorización: cambian la riqueza; no son renta ni ahorro.};
  \node[call] (c4) at ([xshift=0.25cm, yshift=-0.35cm]l4) {\textbf{Balances (IV)}\\ Cada fila financiera suma cero: lo que uno tiene, otro lo debe. La \textbf{riqueza nacional}: $RN=K-PN_{RM}$.};
  \foreach \i in {1,2,3,4} \node[num] at (c\i.north west) {\i};

  % ================= EL RESTO DEL MUNDO =================
  \node[caja, fill=green!5, text width=15.15cm, anchor=north west] (c5) at ([yshift=-0.3cm]b-9-1.south west)
    {\textbf{Resto del mundo (V).} Las mismas operaciones con el signo cambiado forman la \textbf{balanza de pagos} (MBP6). El ahorro menos la inversión de la nación es su saldo por cuenta corriente, $ANB-FBC=CC$, y los saldos sectoriales suman el exterior: $CF_{priv}+CF_G=CC+KA$. Su acumulación, $-PN_{RM}$, es la posición frente al exterior.};
  \node[num] at (c5.north west) {5};

  % ================= GLOSARIO =================
  \node[caja, fill=black!3, anchor=north west, inner sep=5pt, text width=15.15cm] at ([yshift=-0.3cm]c5.south west)
    {\textbf{Glosario de notación.} {\itshape $j$: sector ($H$, $S$, $G$, $RM$); $k$: instrumento; $^{\dagger}$ su contrapartida, $+FBC$, está en la columna de bienes y servicios; $^{*}$ salvo el oro monetario.}\\[2pt]
     \renewcommand{\arraystretch}{1.05}%
     \begin{tabular}{@{}>{$}l<{$}@{\;\;}>{\raggedright\arraybackslash}p{3.45cm}@{\quad}>{$}l<{$}@{\;\;}>{\raggedright\arraybackslash}p{3.45cm}@{\quad}>{$}l<{$}@{\;\;}>{\raggedright\arraybackslash}p{3.3cm}@{}}
       AB,\,ANB & ahorro; ahorro nacional & f^{k}_{j} & flujo: pasivos menos activos & K,\,RN & activos reales; riqueza nacional \\
       TK,\,TKN & transferencias de capital & a^{k}_{j} & stock: activos menos pasivos & PN & patrimonio neto \\
       FBC,\,NP & inversión; no producidos & OP,\,OV,\,R & operaciones; volumen; precios & CC,\,KA & cuenta corriente; de capital \\
       CF & capacidad ($+$) o necesidad ($-$) & X_t & stock al final de $t$ & CF_{priv},\,CF_G & sector privado; AAPP \\
     \end{tabular}};
\end{tikzpicture}
