% Figura: el ajuste por las transferencias sociales en especie (D.63) en la renta (II.3) y en el consumo (II.4.2), en dos paneles.
% Fuente de SCN_especie.pdf. SEC 2010, apartados 8.33 a 8.42. Proporciones ilustrativas: RDB_H=2,8; RDB_G=1,8; C_H=2,4; C_G=1,6; TSE=1,0 (el ahorro de cada sector no cambia).
\begin{tikzpicture}[>=stealth, font=\footnotesize,
  hh/.style={draw=black!70, line width=0.5pt, fill=blue!10},
  gg/.style={draw=black!70, line width=0.5pt, fill=black!10},
  tt/.style={draw=black!70, line width=0.5pt, fill=orange!30},
  hueco/.style={draw=black!45, line width=0.5pt, dashed},
  sx/.style={font=\footnotesize, text=black!80, align=center, anchor=south},
  base/.style={font=\footnotesize, text=black!80, anchor=north},
  grupo/.style={font=\footnotesize, text=black!80, align=center, anchor=north, text width=2.9cm},
  tit/.style={font=\footnotesize\bfseries, anchor=west, inner sep=0pt},
  fl/.style={->, line width=0.9pt, black!60}]

  % ---------- Panel (a): la renta ----------
  \node[tit] at (0,4.75) {(a) Renta: de la disponible a la disponible ajustada (II.3)};
  % Antes: renta disponible
  \draw[hh] (0,0) rectangle (1.2,2.8) node[midway] {$RDB_H$};
  \draw[gg] (1.35,0) rectangle (2.55,0.8);
  \draw[tt] (1.35,0.8) rectangle (2.55,1.8) node[midway] {$TSE$};
  \node[sx] at (1.95,1.85) {$RDB_G$};
  % Después: renta disponible ajustada
  \draw[hh] (3.4,0) rectangle (4.6,2.8) node[midway] {$RDB_H$};
  \draw[tt] (3.4,2.8) rectangle (4.6,3.8) node[midway] {$TSE$};
  \node[sx] at (4.0,3.85) {$RDBA_H$};
  \draw[gg] (4.75,0) rectangle (5.95,0.8);
  \draw[hueco] (4.75,0.8) rectangle (5.95,1.8);
  \node[sx] at (5.35,0.85) {$RDBA_G$};
  \draw[fl] (2.6,1.3) to[out=0, in=180] node[pos=0.55, above, sloped, font=\footnotesize, text=black!75] {D.63} (3.35,3.3);
  % Rótulos
  \foreach \x/\s in {0.6/Hogares, 1.95/AAPP, 4.0/Hogares, 5.35/AAPP} \node[base] at (\x,-0.05) {\s};
  \node[grupo] at (1.275,-0.45) {Renta disponible (B.6b)};
  \node[grupo] at (4.675,-0.45) {Renta disponible ajustada (B.7b)};

  % ---------- Panel (b): el consumo ----------
  \begin{scope}[xshift=7.1cm]
  \node[tit] at (0,4.75) {(b) Consumo: del gasto al consumo efectivo (II.4)};
  % Antes: gasto en consumo final (quién paga)
  \draw[hh] (0,0) rectangle (1.2,2.4) node[midway] {$C_H$};
  \draw[gg] (1.35,0) rectangle (2.55,0.6);
  \draw[tt] (1.35,0.6) rectangle (2.55,1.6) node[midway] {$TSE$};
  \node[sx] at (1.95,1.65) {$C_G$};
  % Después: consumo final efectivo (quién consume)
  \draw[hh] (3.4,0) rectangle (4.6,2.4) node[midway] {$C_H$};
  \draw[tt] (3.4,2.4) rectangle (4.6,3.4) node[midway] {$TSE$};
  \node[sx] at (4.0,3.45) {$CFE_H$};
  \draw[gg] (4.75,0) rectangle (5.95,0.6);
  \draw[hueco] (4.75,0.6) rectangle (5.95,1.6);
  \node[sx] at (5.35,0.65) {$CFE_G$};
  \draw[fl] (2.6,1.1) to[out=0, in=180] (3.35,2.9);
  \foreach \x/\s in {0.6/Hogares, 1.95/AAPP, 4.0/Hogares, 5.35/AAPP} \node[base] at (\x,-0.05) {\s};
  \node[grupo] at (1.275,-0.45) {Gasto en consumo final (P.3): quién paga};
  \node[grupo] at (4.675,-0.45) {Consumo final efectivo (P.4): quién consume};
  \end{scope}

  % ---------- Leyenda ----------
  \node[anchor=north west, font=\footnotesize, text=black!75, text width=13.0cm, align=left, inner sep=0pt,
        execute at begin node={\hyphenpenalty=10000}] at (0,-1.35)
    {Naranja: transferencias sociales en especie ($TSE$), el consumo individual de las AAPP (sanidad, educación, servicios sociales). Gris: el resto de la renta y del consumo de las AAPP, que tras el ajuste es su consumo colectivo. El mismo importe pasa de las AAPP a los hogares en la renta y en el consumo, de modo que el ahorro de cada sector no cambia ($RDB-C=RDBA-CFE$) y los totales de la economía tampoco. Proporciones ilustrativas.};
\end{tikzpicture}
