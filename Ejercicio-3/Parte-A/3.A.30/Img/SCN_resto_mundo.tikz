% Figura: correspondencia entre las cuentas del resto del mundo del SEC 2010 (punto de vista del resto del mundo) y la balanza de pagos del sexto manual del FMI (punto de vista de la economía nacional).
% Fuente de SCN_resto_mundo.pdf. Notación de las figuras anteriores del bloque.
\providecommand{\op}[2]{\shortstack[l]{\textbf{#1}\\ \textcolor{black!65}{\scriptsize #2}}}
\begin{tikzpicture}[>=stealth,
  c/.style={draw=black!70, line width=0.5pt, minimum height=1.0cm, font=\small, align=center, anchor=center},
  h/.style={c, fill=black!6, font=\footnotesize\bfseries, minimum height=1.3cm},
  f/.style={c, text width=4.2cm, minimum width=4.5cm, font=\footnotesize, align=left, fill=black!3},
  sec/.style={c, minimum width=4.6cm, fill=green!8},
  bp/.style={c, minimum width=4.6cm, fill=blue!7},
  ss/.style={c, minimum width=4.6cm, fill=green!18, font=\small\bfseries},
  bs/.style={c, minimum width=4.6cm, fill=blue!18, font=\small\bfseries}]
  \matrix (m) [matrix of nodes, column sep=-0.5pt, row sep=-0.5pt, nodes in empty cells]
  {
    |[f, fill=white, draw=none]| &
    |[h, minimum width=4.6cm]| \shortstack{Cuentas del resto del mundo (SEC)\\ {\scriptsize\mdseries punto de vista de los no residentes}} &
    |[h, minimum width=4.6cm]| \shortstack{Balanza de pagos (6.º manual del FMI)\\ {\scriptsize\mdseries punto de vista de la economía nacional}} \\
    |[f]| \op{Bienes y servicios}{cuenta V.I} & |[sec]| $M-X$ & |[bp]| $X-M$ \\
    |[f]| \op{Rentas primarias}{cuenta V.II} & |[sec]| $-RPN$ & |[bp]| $+RPN$ {\scriptsize (renta primaria)} \\
    |[f]| \op{Transferencias corrientes}{cuenta V.II} & |[sec]| $-TCN$ & |[bp]| $+TCN$ {\scriptsize (renta secundaria)} \\
    |[f, fill=black!8]| \op{Saldo corriente}{B.12 / cuenta corriente} & |[ss]| $M-X-RPN-TCN$ & |[bs]| $CC=X-M+RPN+TCN$ \\
    |[f]| \op{Capital}{cuenta V.III.1 / cuenta de capital} & |[sec]| $-TKN-NP_{RM}$ & |[bp]| $TKN+NP_{RM}$ \\
    |[f, fill=black!8]| \op{Capacidad o necesidad}{de financiación} & |[ss]| $CF_{RM}$ & |[bs]| $CF=-CF_{RM}=CC+KA$ \\
    |[f]| \op{Financiera}{cuenta V.III.2 / cuenta financiera} & |[sec]| \shortstack{adquisición neta de activos\\ menos pasivos frente a la nación} & |[bp]| \shortstack{$CF$ $+$ errores y omisiones} \\
    |[f, fill=black!8]| \op{Balance}{cuenta V.IV / PII} & |[ss]| $PN_{RM}$ & |[bs]| $PII=-PN_{RM}$ \\
  };
  \node[font=\scriptsize, text=black!75, anchor=north west, align=left, text width=13.6cm, execute at begin node={\hyphenpenalty=10000}] at ([yshift=-0.3cm]m-9-1.south west)
    {Las dos columnas registran las mismas operaciones con el signo cambiado: lo que es un recurso para el resto del mundo es un empleo para la economía nacional (SEC 2010, apartado 8.67). $KA$: saldo de la cuenta de capital de la balanza de pagos; $NP_{RM}$: adquisiciones netas de activos no producidos por no residentes. En la balanza de pagos, la discrepancia entre la cuenta financiera y la suma de las cuentas corriente y de capital se publica como errores y omisiones.};
\end{tikzpicture}
