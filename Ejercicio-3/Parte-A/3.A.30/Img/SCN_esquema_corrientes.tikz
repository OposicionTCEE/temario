% Figura: esquema de una página de las cuentas corrientes (bloque 2, primera parte; anexo «Material de estudio: Esquema»).
% El problema con el circuito de las cuentas; en el centro, la matriz de transacciones completa (la misma de SCN_matriz_completa),
% con las filas agrupadas por cuentas y numeradas; alrededor, lo que cada cuenta añade y su saldo; glosario.
% Generar con: bash Code/generar_figura.sh SCN_esquema_corrientes
\begin{tikzpicture}[>=stealth,
  caja/.style={draw=black!70, rounded corners=3pt, line width=0.6pt, align=left, font=\footnotesize, inner sep=4pt},
  sec/.style={font=\small\bfseries, anchor=north west},
  tit/.style={font=\footnotesize, anchor=north west, align=left},
  num/.style={circle, fill=black!80, text=white, font=\footnotesize\bfseries, inner sep=1.2pt, minimum size=0.45cm},
  cto/.style={draw=black!60, rounded corners=2pt, font=\footnotesize, align=center, inner sep=2pt, minimum height=0.62cm, text width=2.1cm},
  c/.style={draw=black!70, line width=0.4pt, minimum width=1.33cm, minimum height=0.44cm, font=\footnotesize, inner sep=0.5pt, align=center, anchor=center},
  h/.style={c, fill=black!6, font=\footnotesize\bfseries, minimum height=0.78cm},
  ht/.style={h, fill=black!16},
  f/.style={c, text width=3.75cm, minimum width=3.9cm, align=left, fill=black!3},
  pro/.style={c, fill=blue!7}, ren/.style={c, fill=blue!4}, acu/.style={c, fill=red!8}, ext/.style={c, fill=green!8},
  tot/.style={c, fill=black!12}, totz/.style={c, fill=black!12, text=black!50},
  vac/.style={c, fill=white},
  cero/.style={c, fill=white, text=black!55, minimum width=0.55cm},
  sig/.style={h, minimum width=0.55cm},
  llave/.style={decorate, decoration={brace, amplitude=3pt}, line width=0.8pt, blue!55!black}]
  \providecommand{\opc}[2]{{\color{black!60}#2}\ #1}

  % ================= EL PROBLEMA =================
  \node[sec, text=red!50!black] at (0,0) {El problema};
  \node[caja, fill=red!6, text width=15.15cm, anchor=north west] (P) at (0,-0.45)
    {\textbf{¿Cómo se crea, se reparte y se gasta la renta?} Cada fase es una cuenta, y cada cuenta se cierra con un saldo que abre la siguiente.};
  % Circuito de las cuentas
  \begin{scope}[shift={([yshift=-0.25cm]P.south west)}]
    \foreach \n/\x/\l in {a/0.0/Producción, b/3.32/{Generación de la renta}, c/6.64/{Asignación primaria}, d/9.96/{Distribución secundaria}, e/13.28/{Utilización de la renta}}
      \node[cto, fill=blue!8, anchor=north west] (\n) at (\x,0) {\l};
    \foreach \n/\x/\l in {g/6.64/{Cuenta de capital}, h/3.32/{Cuenta financiera}, i/0.0/{Balances (stocks)}}
      \node[cto, fill=red!8, anchor=north west] (\n) at (\x,-1.55) {\l};
    \draw[->, line width=0.8pt] (a) -- node[above, font=\footnotesize\itshape] {$VAB$} (b);
    \draw[->, line width=0.8pt] (b) -- node[above, font=\footnotesize\itshape] {$EBE$} (c);
    \draw[->, line width=0.8pt] (c) -- node[above, font=\footnotesize\itshape] {$SRP$} (d);
    \draw[->, line width=0.8pt] (d) -- node[above, font=\footnotesize\itshape] {$RD$} (e);
    \draw[->, line width=0.8pt] (e.south) |- node[pos=0.75, above, font=\footnotesize\itshape] {ahorro} (g.east);
    \draw[->, line width=0.8pt] (g) -- node[above, font=\footnotesize\itshape] {$CF$} (h);
    \draw[->, line width=0.8pt] (h) -- node[above, font=\footnotesize\itshape] {$\Delta A,\Delta P$} (i);
    \draw[->, dashed, blue!60!black] (e.south west) ++(0.3,0) -- ++(0,-0.35) -| node[pos=0.25, below, font=\footnotesize\itshape] {consumo y formación de capital: vuelven a la producción} ([xshift=0.4cm]a.south west);
    \node[font=\footnotesize\itshape, text=green!35!black, anchor=north west, align=left] at (9.4,-2.0) {resto del mundo: en todas las cuentas,\\ con su propia columna};
  \end{scope}

  % ================= LA HERRAMIENTA: LA MATRIZ =================
  \node[sec, text=blue!50!black] (hH) at ([yshift=-2.65cm]P.south west) {La herramienta: la matriz de transacciones, completa};
  \matrix (m) [matrix of nodes, column sep=-0.4pt, row sep=-0.4pt, nodes in empty cells, anchor=north west, column 2/.style={nodes={minimum width=1.55cm}}, column 6/.style={nodes={minimum width=1.6cm}}] at ([yshift=-0.12cm]hH.south west)
  {
    |[f, fill=white, draw=none]| &
    |[h]| \shortstack{Hogares\\ e ISFLSH} & |[h]| Sociedades & |[h]| AAPP & |[ht]| \shortstack{Total\\ economía} & |[h]| \shortstack{Resto\\ del mundo} & |[h]| \shortstack{Bienes y\\ servicios} & |[sig]| $\Sigma$ \\
    |[f]| \opc{Producción}{P.1} & |[pro]| $+VP_H$ & |[pro]| $+VP_S$ & |[pro]| $+VP_G$ & |[tot]| $+VP$ & |[vac]| & |[pro]| $-VP$ & |[cero]| $0$ \\
    |[f]| \opc{Consumos intermedios}{P.2} & |[pro]| $-CI_H$ & |[pro]| $-CI_S$ & |[pro]| $-CI_G$ & |[tot]| $-CI$ & |[vac]| & |[pro]| $+CI$ & |[cero]| $0$ \\
    |[f]| \opc{Exportaciones}{P.6} & |[vac]| & |[vac]| & |[vac]| & |[tot]| & |[ext]| $-X$ & |[pro]| $+X$ & |[cero]| $0$ \\
    |[f]| \opc{Importaciones}{P.7} & |[vac]| & |[vac]| & |[vac]| & |[tot]| & |[ext]| $+M$ & |[pro]| $-M$ & |[cero]| $0$ \\
    |[f]| \opc{Consumo final}{P.3} & |[pro]| $-C_H$ & |[vac]| & |[pro]| $-C_G$ & |[tot]| $-C$ & |[vac]| & |[pro]| $+C$ & |[cero]| $0$ \\
    |[f]| \opc{Formación de capital}{P.5} & |[acu]| $-FBC_H$ & |[acu]| $-FBC_S$ & |[acu]| $-FBC_G$ & |[tot]| $-FBC$ & |[vac]| & |[pro]| $+FBC$ & |[cero]| $0$ \\
    |[f]| \opc{Remuneración asalariados}{D.1} & |[ren]| $+W^{N}-W_H$ & |[ren]| $-W_S$ & |[ren]| $-W_G$ & |[tot]| $W^{N}-W$ & |[ext]| $W-W^{N}$ & |[vac]| & |[cero]| $0$ \\
    |[f]| \opc{Impuestos s/ producción}{D.2--3} & |[ren]| $-T_{q,H}$ & |[ren]| $-T_{q,S}$ & |[ren]| $T^{N}-T_{q,G}$ & |[tot]| $T^{N}-T_q$ & |[ext]| $T_p+T_q-T^{N}$ & |[pro]| $-T_p$ & |[cero]| $0$ \\
    |[f]| \opc{Rentas de la propiedad}{D.4} & |[ren]| $+RP_H$ & |[ren]| $\pm RP_S$ & |[ren]| $-RP_G$ & |[tot]| $\pm RP$ & |[ext]| $\pm RP_{RM}$ & |[vac]| & |[cero]| $0$ \\
    |[f]| \opc{Impuestos corrientes}{D.5} & |[ren]| $-T_{d,H}$ & |[ren]| $-T_{d,S}$ & |[ren]| $+T_d$ & |[totz]| $0$ & |[vac]| & |[vac]| & |[cero]| $0$ \\
    |[f]| \opc{Cotizaciones sociales}{D.61} & |[ren]| $-CS$ & |[ren]| $+CS_S$ & |[ren]| $+CS_G$ & |[totz]| $0$ & |[vac]| & |[vac]| & |[cero]| $0$ \\
    |[f]| \opc{Prestaciones sociales}{D.62} & |[ren]| $+PS$ & |[ren]| $-PS_S$ & |[ren]| $-PS_G$ & |[totz]| $0$ & |[vac]| & |[vac]| & |[cero]| $0$ \\
    |[f]| \opc{Otras transferencias}{D.7} & |[ren]| $\pm OT_H$ & |[ren]| $\pm OT_S$ & |[ren]| $\pm OT_G$ & |[tot]| $+TCN$ & |[ext]| $-TCN$ & |[vac]| & |[cero]| $0$ \\
    |[f]| \opc{Ajuste por pensiones}{D.8} & |[ren]| $+D8$ & |[ren]| $-D8$ & |[vac]| & |[totz]| $0$ & |[vac]| & |[vac]| & |[cero]| $0$ \\
    |[f]| \opc{Transferencias de capital}{D.9} & |[acu]| $\pm TK_H$ & |[acu]| $\pm TK_S$ & |[acu]| $\pm TK_G$ & |[tot]| $+TKN$ & |[ext]| $-TKN$ & |[vac]| & |[cero]| $0$ \\
    |[f]| \opc{Activos no producidos}{NP} & |[acu]| $\pm NP_H$ & |[acu]| $\pm NP_S$ & |[acu]| $\pm NP_G$ & |[totz]| $0$ & |[vac]| & |[vac]| & |[cero]| $0$ \\
    |[f]| \opc{Financieros, netos}{F} & |[acu]| $-CF_H$ & |[acu]| $-CF_S$ & |[acu]| $-CF_G$ & |[tot]| $-CF$ & |[ext]| $-CF_{RM}$ & |[vac]| & |[cero]| $0$ \\
    |[f, fill=black!6]| \textbf{$\Sigma$} & |[cero, minimum width=1.55cm]| $0$ & |[cero, minimum width=1.33cm]| $0$ & |[cero, minimum width=1.33cm]| $0$ & |[cero, minimum width=1.33cm, fill=black!12]| $0$ & |[cero, minimum width=1.6cm]| $0$ & |[cero, minimum width=1.33cm]| $0$ & |[cero]| $0$ \\
  };
  % Llaves por cuentas, a la derecha, con su número y su saldo
  \foreach \i/\a/\b/\s in {1/2/7/{PIB: producción\\ y gasto}, 2/8/9/{PIB: rentas}, 3/10/10/{RNB}, 4/11/14/{RNDB}, 5/15/15/{ahorro}, 6/16/18/{$CF$}} {
    \draw[llave] ([xshift=0.08cm, yshift=-0.5pt]m-\a-8.north east) -- ([xshift=0.08cm, yshift=0.5pt]m-\b-8.south east)
      node[midway, xshift=0.32cm, num, minimum size=0.42cm] (n\i) {\i};
    \node[font=\footnotesize, anchor=west, align=left] at ([xshift=0.08cm]n\i.east) {\s};
  }
  \node[tit, text width=15.2cm, text=black!75] (reg) at ([yshift=-0.08cm]m-19-1.south west)
    {Recurso $+$, empleo $-$: \textbf{cada fila suma cero} (lo que paga uno lo cobra otro) y, con la fila financiera, \textbf{cada columna también}. El total es un subtotal: lo que se cruzan los residentes se anula y solo queda lo que se hace con el resto del mundo.};

  % ================= LA SOLUCIÓN: CADA CUENTA =================
  \node[sec, text=blue!50!black] (hS) at ([yshift=-0.2cm]reg.south west) {La solución: cada cuenta añade sus filas y se cierra con su saldo};
  \foreach \i/\col/\fila/\t/\txt in {
      1/0/0/{Producción (I) y bienes y servicios (0)}/{$PIB=VP-CI+T_p=C+FBC+X-M$. Restar $CI$ evita el doble cómputo; la columna de bienes y servicios suma cero.},
      2/1/0/{Explotación (II.1.1)}/{$PIB=W+(T_p+T_q)+EBE+RMB$. El valor añadido remunera al trabajo, a las AAPP y al capital: el PIB por las rentas.},
      3/2/0/{Asignación primaria (II.1.2)}/{$RNB=PIB+RPN$. Las rentas cruzadas con el exterior (columna del resto del mundo): de lo interior a lo nacional.},
      4/0/1/{Distribución secundaria (II.2)}/{$RNDB=RNB+TCN$. Impuestos, cotizaciones y prestaciones se anulan en el total: solo cuenta $TCN$ con el exterior.},
      5/1/1/{Especie y utilización (II.3, II.4)}/{$ANB=RNDB-C$, con el consumo de la fila P.3 y el ajuste D.8: la parte de la renta que no se consume.},
      6/2/1/{Capital y financiera (III)}/{$CF=ANB+TKN-FBC$, con la FBC de la fila P.5. La fila F cierra cada columna (esquema siguiente).}} {
    \node[caja, fill=blue!3, text width=4.75cm, minimum height=1.95cm, anchor=north west] (b\i) at ([xshift=\col*5.22cm, yshift=-0.15cm-\fila*2.15cm]hS.south west)
      {\textbf{\t}\\[1pt] \txt};
    \node[num] at (b\i.north west) {\i};
  }

  % ================= GLOSARIO =================
  \node[caja, fill=black!3, anchor=north west, inner sep=5pt, text width=15.15cm] at ([yshift=-0.3cm]b4.south west)
    {\textbf{Glosario de notación.} {\itshape Subíndices $H$, $S$, $G$: hogares, sociedades, AAPP; superíndice $N$: de ámbito nacional; $RM$: resto del mundo.}\\[2pt]
     \renewcommand{\arraystretch}{1.05}%
     \begin{tabular}{@{}>{$}l<{$}@{\;\;}>{\raggedright\arraybackslash}p{3.3cm}@{\quad}>{$}l<{$}@{\;\;}>{\raggedright\arraybackslash}p{3.35cm}@{\quad}>{$}l<{$}@{\;\;}>{\raggedright\arraybackslash}p{3.1cm}@{}}
       VP,\,CI & producción; consumos intermedios & T_p,\,T_q & impuestos sobre productos; sobre la producción & RNB,\,RNDB & renta nacional; disponible \\
       VAB,\,EBE & valor añadido; excedente & T_d,\,CS,\,PS & impuesto renta; cotizaciones; prestaciones & SRP,\,RD & saldo de rentas primarias; renta disponible \\
       C,\,FBC & consumo; formación de capital & RP,\,OT & rentas de la propiedad; otras transferencias & ANB,\,CF & ahorro nacional; capacidad o necesidad \\
       X,\,M,\,W & exportaciones; importaciones; salarios & RPN,\,TCN & rentas y transferencias netas del exterior & TK,\,NP & transferencias de capital; no producidos \\
     \end{tabular}};
\end{tikzpicture}
