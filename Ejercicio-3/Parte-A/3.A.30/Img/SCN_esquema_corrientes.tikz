% Figura: esquema de una página de las cuentas corrientes (bloque 2, primera parte; anexo «Material de estudio: Esquema»).
% El problema con el circuito de las cuentas; en el centro, la matriz de transacciones completa, con las filas en el orden de la
% sucesión de cuentas (como el cuadro de cuentas económicas integradas del SEC) y una fila de saldo al cerrar cada cuenta:
% cada macromagnitud es la suma de la columna del total hasta su fila de saldo. Color de cada saldo = color de su llave y fórmula.
% Generar con: bash Code/generar_figura.sh SCN_esquema_corrientes
\begin{tikzpicture}[>=stealth,
  caja/.style={draw=black!70, rounded corners=3pt, line width=0.6pt, align=left, font=\footnotesize, inner sep=4pt},
  sec/.style={font=\small\bfseries, anchor=north west},
  tit/.style={font=\footnotesize, anchor=north west, align=left},
  num/.style={circle, fill=black!80, text=white, font=\footnotesize\bfseries, inner sep=1.2pt, minimum size=0.42cm},
  cto/.style={draw=black!60, rounded corners=2pt, font=\footnotesize, align=center, inner sep=2pt, minimum height=0.62cm, text width=2.1cm},
  c/.style={draw=black!70, line width=0.4pt, minimum width=1.33cm, minimum height=0.42cm, font=\footnotesize, inner sep=0.5pt, align=center, anchor=center},
  h/.style={c, fill=black!6, font=\footnotesize\bfseries, minimum height=0.78cm},
  ht/.style={h, fill=black!16},
  f/.style={c, text width=3.55cm, minimum width=3.7cm, align=left, fill=black!3},
  pro/.style={c, fill=blue!5}, ren/.style={c, fill=black!2}, acu/.style={c, fill=red!5}, ext/.style={c, fill=green!7},
  tot/.style={c, fill=black!10}, totz/.style={c, fill=black!10, text=black!50},
  vac/.style={c, fill=white},
  cero/.style={c, fill=white, text=black!55, minimum width=0.55cm},
  sig/.style={h, minimum width=0.55cm},
  % filas de saldo: un color por macromagnitud
  sA/.style={c, fill=blue!22, font=\footnotesize\bfseries}, sB/.style={c, fill=green!28, font=\footnotesize\bfseries},
  sC/.style={c, fill=orange!30, font=\footnotesize\bfseries}, sD/.style={c, fill=violet!22, font=\footnotesize\bfseries},
  sE/.style={c, fill=red!22, font=\footnotesize\bfseries},
  fA/.style={f, fill=blue!22, font=\footnotesize\bfseries}, fB/.style={f, fill=green!28, font=\footnotesize\bfseries},
  fC/.style={f, fill=orange!30, font=\footnotesize\bfseries}, fD/.style={f, fill=violet!22, font=\footnotesize\bfseries},
  fE/.style={f, fill=red!22, font=\footnotesize\bfseries},
  blanco/.style={c, fill=black!3, draw=black!25},
  llave/.style={decorate, decoration={brace, amplitude=3pt}, line width=1pt}]
  \providecommand{\opc}[2]{{\color{black!60}#2}\ #1}

  % ================= EL PROBLEMA =================
  \node[sec, text=red!50!black] at (0,0) {El problema};
  \node[caja, fill=red!6, text width=15.15cm, anchor=north west] (P) at (0,-0.45)
    {\textbf{¿Cómo se crea, se reparte y se gasta la renta?} Cada fase es una cuenta, y cada cuenta se cierra con un saldo que abre la siguiente.};
  % Circuito de las cuentas
  \begin{scope}[shift={([yshift=-0.25cm]P.south west)}]
    \foreach \n/\x/\l in {a/0.0/Producción, b/3.32/{Generación de la renta}, c/6.64/{Asignación primaria}, d/9.96/{Distribución secundaria}, e/13.28/{Utilización de la renta}}
      \node[cto, fill=blue!8, anchor=north west] (\n) at (\x,0) {\l};
    \foreach \n/\x/\l in {g/6.64/{Cuenta de capital}, h/3.32/{Cuenta financiera}, i/0.0/{Balances (stocks)}}
      \node[cto, fill=red!8, anchor=north west] (\n) at (\x,-1.55) {\l};
    \draw[->, line width=0.8pt] (a) -- node[above, font=\footnotesize\itshape] {$VAB$} (b);
    \draw[->, line width=0.8pt] (b) -- node[above, font=\footnotesize\itshape] {$EBE$} (c);
    \draw[->, line width=0.8pt] (c) -- node[above, font=\footnotesize\itshape] {$SRP$} (d);
    \draw[->, line width=0.8pt] (d) -- node[above, font=\footnotesize\itshape] {$RD$} (e);
    \draw[->, line width=0.8pt] (e.south) |- node[pos=0.75, above, font=\footnotesize\itshape] {ahorro} (g.east);
    \draw[->, line width=0.8pt] (g) -- node[above, font=\footnotesize\itshape] {$CF$} (h);
    \draw[->, line width=0.8pt] (h) -- node[above, font=\footnotesize\itshape] {$\Delta A,\Delta P$} (i);
    \draw[->, dashed, blue!60!black] (e.south west) ++(0.3,0) -- ++(0,-0.35) -| node[pos=0.25, below, font=\footnotesize\itshape] {consumo y formación de capital: vuelven a la producción} ([xshift=0.4cm]a.south west);
    \node[font=\footnotesize\itshape, text=green!35!black, anchor=north west, align=left] at (9.4,-2.0) {resto del mundo: en todas las cuentas,\\ con su propia columna};
  \end{scope}

  % ================= LA HERRAMIENTA: LA MATRIZ =================
  \node[sec, text=blue!50!black] (hH) at ([yshift=-2.65cm]P.south west) {La herramienta: la matriz de transacciones, cuenta a cuenta};
  \node[tit, text width=15.3cm] (lee) at ([yshift=-0.05cm]hH.south west)
    {\textbf{Cómo se lee}: recurso $+$, empleo $-$; cada fila de operaciones suma cero. Las \textbf{filas de color} no son operaciones: son la \textbf{suma de la columna desde arriba}. En la columna del total, esa suma es la \textbf{macromagnitud}; en la de cada sector, su saldo.};
  \matrix (m) [matrix of nodes, column sep=-0.4pt, row sep=-0.4pt, nodes in empty cells, anchor=north west] at ([yshift=-0.08cm]lee.south west)
  {
    |[f, fill=white, draw=none]| &
    |[h]| \shortstack{Hogares\\ e ISFLSH} & |[h]| Sociedades & |[h]| AAPP & |[ht]| \shortstack{Total\\ economía} & |[h]| \shortstack{Resto\\ del mundo} & |[h]| \shortstack{Bienes y\\ servicios} & |[sig]| $\Sigma$ \\
    |[f]| \opc{Producción}{P.1} & |[pro]| $+VP_H$ & |[pro]| $+VP_S$ & |[pro]| $+VP_G$ & |[tot]| $+VP$ & |[vac]| & |[pro]| $-VP$ & |[cero]| $0$ \\
    |[f]| \opc{Consumos intermedios}{P.2} & |[pro]| $-CI_H$ & |[pro]| $-CI_S$ & |[pro]| $-CI_G$ & |[tot]| $-CI$ & |[vac]| & |[pro]| $+CI$ & |[cero]| $0$ \\
    |[f]| \opc{Exportaciones}{P.6} & |[vac]| & |[vac]| & |[vac]| & |[tot]| & |[ext]| $-X$ & |[pro]| $+X$ & |[cero]| $0$ \\
    |[f]| \opc{Importaciones}{P.7} & |[vac]| & |[vac]| & |[vac]| & |[tot]| & |[ext]| $+M$ & |[pro]| $-M$ & |[cero]| $0$ \\
    |[fA]| \opc{Saldo: valor añadido}{B.1} & |[sA]| $VAB_H$ & |[sA]| $VAB_S$ & |[sA]| $VAB_G$ & |[sA, fill=blue!40]| $VAB$ & |[blanco]| & |[blanco]| & |[blanco, minimum width=0.55cm]| \\
    |[f]| \opc{Remuneración asalariados}{D.1} & |[ren]| $+W^{N}{-}W_H$ & |[ren]| $-W_S$ & |[ren]| $-W_G$ & |[tot]| $W^{N}{-}W$ & |[ext]| $W{-}W^{N}$ & |[vac]| & |[cero]| $0$ \\
    |[f]| \opc{Impuestos s/ producción}{D.2--3} & |[ren]| $-T_{q,H}$ & |[ren]| $-T_{q,S}$ & |[ren]| $T^{N}{-}T_{q,G}$ & |[tot]| $T^{N}{-}T_q$ & |[ext]| $T_p{+}T_q{-}T^{N}$ & |[pro]| $-T_p$ & |[cero]| $0$ \\
    |[f]| \opc{Rentas de la propiedad}{D.4} & |[ren]| $+RP_H$ & |[ren]| $\pm RP_S$ & |[ren]| $-RP_G$ & |[tot]| $\pm RP$ & |[ext]| $\pm RP_{RM}$ & |[vac]| & |[cero]| $0$ \\
    |[fB]| \opc{Saldo: rentas primarias}{B.5} & |[sB]| $SRP_H$ & |[sB]| $SRP_S$ & |[sB]| $SRP_G$ & |[sB, fill=green!45]| $RNB$ & |[blanco]| & |[blanco]| & |[blanco, minimum width=0.55cm]| \\
    |[f]| \opc{Impuestos corrientes}{D.5} & |[ren]| $-T_{d,H}$ & |[ren]| $-T_{d,S}$ & |[ren]| $+T_d$ & |[totz]| $0$ & |[vac]| & |[vac]| & |[cero]| $0$ \\
    |[f]| \opc{Cotizaciones sociales}{D.61} & |[ren]| $-CS$ & |[ren]| $+CS_S$ & |[ren]| $+CS_G$ & |[totz]| $0$ & |[vac]| & |[vac]| & |[cero]| $0$ \\
    |[f]| \opc{Prestaciones sociales}{D.62} & |[ren]| $+PS$ & |[ren]| $-PS_S$ & |[ren]| $-PS_G$ & |[totz]| $0$ & |[vac]| & |[vac]| & |[cero]| $0$ \\
    |[f]| \opc{Otras transferencias}{D.7} & |[ren]| $\pm OT_H$ & |[ren]| $\pm OT_S$ & |[ren]| $\pm OT_G$ & |[tot]| $+TCN$ & |[ext]| $-TCN$ & |[vac]| & |[cero]| $0$ \\
    |[fC]| \opc{Saldo: renta disponible}{B.6} & |[sC]| $RDB_H$ & |[sC]| $RDB_S$ & |[sC]| $RDB_G$ & |[sC, fill=orange!50]| $RNDB$ & |[blanco]| & |[blanco]| & |[blanco, minimum width=0.55cm]| \\
    |[f]| \opc{Consumo final}{P.3} & |[pro]| $-C_H$ & |[vac]| & |[pro]| $-C_G$ & |[tot]| $-C$ & |[vac]| & |[pro]| $+C$ & |[cero]| $0$ \\
    |[f]| \opc{Ajuste por pensiones}{D.8} & |[ren]| $+D8$ & |[ren]| $-D8$ & |[vac]| & |[totz]| $0$ & |[vac]| & |[vac]| & |[cero]| $0$ \\
    |[fD]| \opc{Saldo: ahorro}{B.8} & |[sD]| $AB_H$ & |[sD]| $AB_S$ & |[sD]| $AB_G$ & |[sD, fill=violet!38]| $ANB$ & |[blanco]| & |[blanco]| & |[blanco, minimum width=0.55cm]| \\
    |[f]| \opc{Formación de capital}{P.5} & |[acu]| $-FBC_H$ & |[acu]| $-FBC_S$ & |[acu]| $-FBC_G$ & |[tot]| $-FBC$ & |[vac]| & |[pro]| $+FBC$ & |[cero]| $0$ \\
    |[f]| \opc{Transferencias de capital}{D.9} & |[acu]| $\pm TK_H$ & |[acu]| $\pm TK_S$ & |[acu]| $\pm TK_G$ & |[tot]| $+TKN$ & |[ext]| $-TKN$ & |[vac]| & |[cero]| $0$ \\
    |[f]| \opc{Activos no producidos}{NP} & |[acu]| $\pm NP_H$ & |[acu]| $\pm NP_S$ & |[acu]| $\pm NP_G$ & |[totz]| $0$ & |[vac]| & |[vac]| & |[cero]| $0$ \\
    |[fE]| \opc{Saldo: financiación}{B.9} & |[sE]| $CF_H$ & |[sE]| $CF_S$ & |[sE]| $CF_G$ & |[sE, fill=red!38]| $CF$ & |[blanco]| & |[blanco]| & |[blanco, minimum width=0.55cm]| \\
    |[f]| \opc{Financieros, netos}{F} & |[acu]| $-CF_H$ & |[acu]| $-CF_S$ & |[acu]| $-CF_G$ & |[tot]| $-CF$ & |[ext]| $-CF_{RM}$ & |[vac]| & |[cero]| $0$ \\
    |[f, fill=black!6]| \textbf{$\Sigma$} & |[cero, minimum width=1.33cm]| $0$ & |[cero, minimum width=1.33cm]| $0$ & |[cero, minimum width=1.33cm]| $0$ & |[cero, minimum width=1.33cm, fill=black!10]| $0$ & |[cero, minimum width=1.33cm]| $0$ & |[cero, minimum width=1.33cm]| $0$ & |[cero]| $0$ \\
  };
  % PIB por el gasto: las celdas de la columna de bienes y servicios que lo forman
  \foreach \r in {4,5,16,19} \draw[blue!70!black, line width=1.1pt] (m-\r-7.north west) rectangle (m-\r-7.south east);
  \draw[blue!70!black, line width=1.1pt, dashed] (m-8-7.north west) rectangle (m-8-7.south east);
  % Llaves por cuentas, a la derecha: mismo color que su fila de saldo
  \foreach \i/\a/\b/\col in {1/2/6/blue!65!black, 2/7/10/green!45!black, 3/11/15/orange!70!black, 4/16/18/violet!70!black, 5/19/22/red!65!black, 6/23/24/black!60}
    \draw[llave, \col] ([xshift=0.08cm, yshift=-0.5pt]m-\a-8.north east) -- ([xshift=0.08cm, yshift=0.5pt]m-\b-8.south east) coordinate[midway] (L\i);
  \node[tit, anchor=west, text width=2.75cm] at ([xshift=0.2cm]L1)
    {\textcolor{blue!65!black}{\textbf{1 Producción}}\\ $VAB=VP-CI$\\ $PIB=VAB+T_p$\\ \textcolor{blue!65!black}{por el gasto, en la columna de ByS: $C+FBC+X-M$}};
  \node[tit, anchor=west, text width=2.75cm] at ([xshift=0.2cm]L2)
    {\textcolor{green!45!black}{\textbf{2 Distribución primaria}}\\ $RNB=PIB+RPN$\\ de lo interior a lo nacional};
  \node[tit, anchor=west, text width=2.75cm] at ([xshift=0.2cm]L3)
    {\textcolor{orange!70!black}{\textbf{3 Distribución secundaria}}\\ $RNDB=RNB+TCN$\\ D.5 a D.62 se anulan en el total};
  \node[tit, anchor=west, text width=2.75cm] at ([xshift=0.2cm]L4)
    {\textcolor{violet!70!black}{\textbf{4 Utilización}}\\ $ANB=RNDB-C$};
  \node[tit, anchor=west, text width=2.75cm] at ([xshift=0.2cm]L5)
    {\textcolor{red!65!black}{\textbf{5 Capital}}\\ $CF=ANB+TKN-FBC$};
  \node[tit, anchor=west, text width=2.75cm] at ([xshift=0.2cm]L6)
    {\textbf{6 Financiera}: la fila F devuelve cada columna a cero};

  % Lectura del PIB y de la columna del resto del mundo
  \node[caja, fill=blue!3, text width=15.15cm, anchor=north west] (pib) at ([yshift=-0.2cm]m-24-1.south west)
    {\textbf{\textcolor{blue!65!black}{El PIB, tres veces}}: por la \textbf{producción}, $VAB$ (fila B.1) más los impuestos sobre productos ($-T_p$, recuadro discontinuo); por el \textbf{gasto}, en la columna de bienes y servicios, $C+FBC+X-M$ (recuadros); por las \textbf{rentas}, lo que las filas D.1 y D.2--3 reparten del valor añadido: $W+(T_p+T_q)+EBE+RMB$. El \textbf{resto del mundo} recoge lo que la economía cruza con el exterior: por eso $RNB-PIB=RPN$ y $RNDB-RNB=TCN$.};

  % ================= GLOSARIO =================
  \node[caja, fill=black!3, anchor=north west, inner sep=5pt, text width=15.15cm] at ([yshift=-0.25cm]pib.south west)
    {\textbf{Glosario de notación.} {\itshape Subíndices $H$, $S$, $G$: hogares, sociedades, AAPP; superíndice $N$: de ámbito nacional; $RM$: resto del mundo.}\\[2pt]
     \renewcommand{\arraystretch}{1.05}%
     \begin{tabular}{@{}>{$}l<{$}@{\;\;}>{\raggedright\arraybackslash}p{3.25cm}@{\quad}>{$}l<{$}@{\;\;}>{\raggedright\arraybackslash}p{3.35cm}@{\quad}>{$}l<{$}@{\;\;}>{\raggedright\arraybackslash}p{3.15cm}@{}}
       VP,\,CI & producción; consumos intermedios & T_p,\,T_q & impuestos: productos; producción & SRP,\,RNB & rentas primarias; renta nacional \\
       VAB,\,W & valor añadido; salarios & T_d,\,CS & impuesto renta; cotizaciones & RDB,\,RNDB & renta disponible: sector; nación \\
       EBE,\,RMB & excedente; renta mixta & PS,\,RP & prestaciones; rentas de la propiedad & AB,\,ANB & ahorro; ahorro nacional \\
       C,\,FBC & consumo; inversión & OT,\,TK & otras transferencias; de capital & CF & capacidad o necesidad \\
       X,\,M & exportaciones; importaciones & RPN,\,TCN & netos del exterior: rentas; transferencias & TKN & transferencias de capital netas \\
     \end{tabular}};
\end{tikzpicture}
