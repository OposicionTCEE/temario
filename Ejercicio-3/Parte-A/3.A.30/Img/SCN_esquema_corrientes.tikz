% Figura: esquema de una página de las cuentas corrientes (bloque 2, primera parte; anexo «Material de estudio: Esquema»).
% Secuencia: problema -> herramienta (la matriz de transacciones y sus reglas) -> solución (cadena de cuentas: cada saldo abre
% la cuenta siguiente) -> resultado (una macromagnitud por pregunta) -> glosario.
% Generar con: bash Code/generar_figura.sh SCN_esquema_corrientes
\begin{tikzpicture}[>=stealth,
  caja/.style={draw=black!70, rounded corners=3pt, line width=0.6pt, align=left, font=\footnotesize, inner sep=4pt},
  sec/.style={font=\small\bfseries, anchor=north west},
  tit/.style={font=\footnotesize, anchor=north west, align=left},
  mc/.style={draw=black!60, minimum width=0.95cm, minimum height=0.42cm, font=\footnotesize, inner sep=1pt, anchor=center},
  paso/.style={draw=black!70, rounded corners=3pt, line width=0.6pt, fill=blue!3, minimum width=15.43cm, minimum height=1.65cm, anchor=north west, inner sep=0pt},
  num/.style={circle, fill=black!80, text=white, font=\footnotesize\bfseries, inner sep=1.2pt, minimum size=0.45cm},
  enlace/.style={->, line width=1pt, blue!50!black},
  maniobra/.style={font=\footnotesize\itshape, text=blue!50!black, anchor=west},
  chip/.style={draw=black!60, rounded corners=2pt, font=\footnotesize, inner sep=3pt, minimum height=0.5cm, fill=blue!12}]

  % ================= EL PROBLEMA =================
  \node[sec, text=red!50!black] at (0,0) {El problema};
  \node[caja, fill=red!6, text width=15.15cm, anchor=north west] (P) at (0,-0.45)
    {\textbf{¿Cómo se crea, se reparte y se gasta la renta?} Y, si todas proceden del mismo flujo, ¿por qué una economía tiene tantas medidas de su actividad: el producto, la renta nacional, la renta disponible, el ahorro?};

  % ================= LA HERRAMIENTA =================
  \node[sec, text=blue!50!black] (hH) at ([yshift=-0.3cm]P.south west) {La herramienta: la matriz de transacciones};
  \node[caja, fill=blue!4, text width=15.15cm, minimum height=2.55cm, anchor=north west] (H) at ([yshift=-0.12cm]hH.south west)
    {\parbox[t]{6.6cm}{El cuadro de cuentas económicas integradas del SEC, ordenado como GODLEY y LAVOIE (2007). Tres reglas:\\[2pt]
     (i) recurso $+$, empleo $-$: \textbf{cada fila suma cero};\\
     (ii) cada cuenta es un bloque de filas que se abre con el saldo anterior y se cierra con el suyo;\\
     (iii) el total es un subtotal: las operaciones entre residentes se anulan y solo queda el resto del mundo.}};
  \matrix (mx) [matrix of nodes, nodes={mc}, column sep=-0.4pt, row sep=-0.4pt, anchor=north east] at ([xshift=-0.25cm, yshift=-0.15cm]H.north east)
  {
    |[draw=none]| {} & \textbf{S.14--15} & \textbf{S.11--12} & \textbf{S.13} & |[fill=black!10]| \textbf{S.1} & \textbf{S.2} & \textbf{ByS} & |[draw=none]| {} \\
    I & $\pm$ & $\pm$ & $\pm$ & |[fill=black!10]| $(\Sigma)$ & & $\pm$ & |[draw=none, text=blue!50!black]| $\Sigma=0$ \\
    II.1 & $\pm$ & $\pm$ & $\pm$ & |[fill=black!10]| $(\Sigma)$ & $\pm$ & & |[draw=none, text=blue!50!black]| $\Sigma=0$ \\
    II.2 & $\pm$ & $\pm$ & $\pm$ & |[fill=black!10]| $(\Sigma)$ & $\pm$ & & |[draw=none, text=blue!50!black]| $\Sigma=0$ \\
    II.3--4 & $\pm$ & $\pm$ & $\pm$ & |[fill=black!10]| $(\Sigma)$ & & $\pm$ & |[draw=none, text=blue!50!black]| $\Sigma=0$ \\
  };

  % ================= LA SOLUCIÓN =================
  \node[sec, text=blue!50!black] (hS) at ([yshift=-0.3cm]H.south west) {La solución: la sucesión de cuentas};

  % Paso 1: producción y bienes y servicios
  \node[paso] (k1) at ([yshift=-0.15cm]hS.south west) {};
  \node[num] at (k1.north west) {1};
  \begin{scope}[shift={(k1.north west)}]
    \node[tit, text width=4.1cm] at (0.25,-0.1) {\textbf{Producción (I) y bienes y servicios (0)}\\[1pt] $VAB_j=VP_j-CI_j$\\[1pt] $PIB_{pm}=\sum_j VAB_j^{pb}+T_p$\\ $\phantom{PIB_{pm}}=C+FBC+X-M$};
    \node[tit, text width=6.4cm] at (4.6,-0.1) {Se resta el consumo intermedio para no contar dos veces lo que unas ramas venden a otras (\textbf{doble cómputo}). La columna de bienes y servicios suma cero: el PIB por la \textbf{producción} es igual al PIB por el \textbf{gasto}.};
    \fill[black!15] (11.4,-1.05) rectangle (12.9,-0.6); \fill[blue!30] (12.9,-1.05) rectangle (15.2,-0.6);
    \draw[black!60] (11.4,-1.05) rectangle (15.2,-0.6);
    \node[font=\footnotesize] at (12.15,-0.83) {$CI$}; \node[font=\footnotesize] at (14.05,-0.83) {$VAB$};
    \draw[decorate, decoration={brace, amplitude=3pt}, black!60] (11.4,-0.52) -- (15.2,-0.52) node[midway, above=2pt, font=\footnotesize] {$VP$};
  \end{scope}

  % Paso 2: explotación
  \node[paso] (k2) at ([yshift=-0.42cm]k1.south west) {};
  \node[num] at (k2.north west) {2};
  \draw[enlace] ([xshift=2.2cm]k1.south west) -- ([xshift=2.2cm]k2.north west) node[midway, maniobra, xshift=2pt] {el valor añadido remunera a los factores};
  \begin{scope}[shift={(k2.north west)}]
    \node[tit, text width=4.1cm] at (0.25,-0.1) {\textbf{Explotación (II.1.1)}\\[1pt] $PIB_{pm}=W+(T_p+T_q)$\\ $\phantom{PIB_{pm}=}+EBE+RMB$};
    \node[tit, text width=6.4cm] at (4.6,-0.1) {Reparte el valor añadido entre el trabajo (remuneración de los asalariados), las Administraciones (impuestos sobre la producción) y el capital (excedente y renta mixta): el PIB por las \textbf{rentas}.};
    \fill[blue!30] (11.4,-1.0) rectangle (13.2,-0.55); \fill[green!25] (13.2,-1.0) rectangle (13.8,-0.55); \fill[orange!35] (13.8,-1.0) rectangle (15.2,-0.55);
    \draw[black!60] (11.4,-1.0) rectangle (15.2,-0.55);
    \node[font=\footnotesize] at (12.3,-0.78) {$W$}; \node[font=\footnotesize] at (13.5,-0.78) {$T$}; \node[font=\footnotesize] at (14.5,-0.78) {$EBE$};
    \node[font=\footnotesize, anchor=north] at (13.3,-1.05) {el mismo $PIB$, por las rentas};
  \end{scope}

  % Paso 3: asignación primaria
  \node[paso] (k3) at ([yshift=-0.42cm]k2.south west) {};
  \node[num] at (k3.north west) {3};
  \draw[enlace] ([xshift=2.2cm]k2.south west) -- ([xshift=2.2cm]k3.north west) node[midway, maniobra, xshift=2pt] {se añaden las rentas cruzadas con el exterior};
  \begin{scope}[shift={(k3.north west)}]
    \node[tit, text width=4.1cm] at (0.25,-0.1) {\textbf{Asignación primaria (II.1.2)}\\[1pt] $RNB=PIB+RPN$};
    \node[tit, text width=6.4cm] at (4.6,-0.1) {Añade las rentas de la propiedad y las rentas del trabajo y los impuestos que se cobran o se pagan al resto del mundo: de lo \textbf{interior}, lo producido en el territorio, a lo \textbf{nacional}, lo que cobran los residentes.};
    \fill[blue!30] (11.4,-0.62) rectangle (14.3,-0.3); \node[font=\footnotesize] at (12.85,-0.46) {$PIB$};
    \fill[blue!30] (11.4,-1.12) rectangle (14.3,-0.8); \fill[yellow!50] (14.3,-1.12) rectangle (14.9,-0.8);
    \node[font=\footnotesize] at (12.85,-0.96) {$RNB$}; \node[font=\footnotesize] at (14.6,-0.96) {$RPN$};
  \end{scope}

  % Paso 4: distribución secundaria
  \node[paso] (k4) at ([yshift=-0.42cm]k3.south west) {};
  \node[num] at (k4.north west) {4};
  \draw[enlace] ([xshift=2.2cm]k3.south west) -- ([xshift=2.2cm]k4.north west) node[midway, maniobra, xshift=2pt] {se añaden las transferencias corrientes};
  \begin{scope}[shift={(k4.north west)}]
    \node[tit, text width=4.1cm] at (0.25,-0.1) {\textbf{Distribución secundaria (II.2)}\\[1pt] $RNDB=RNB+TCN$};
    \node[tit, text width=6.4cm] at (4.6,-0.1) {Impuestos sobre la renta, cotizaciones, prestaciones y otras transferencias corrientes: lo que cada sector puede gastar tras la intervención pública, como la \textbf{renta disponible} de los hogares.};
    \node[chip, fill=red!12] (hh) at (11.9,-0.8) {Hogares};
    \node[chip, fill=green!15] (gg) at (14.6,-0.8) {AAPP};
    \draw[->, line width=0.8pt] ([yshift=3pt]hh.east) -- node[above, font=\footnotesize] {impuestos, cotizaciones} ([yshift=3pt]gg.west);
    \draw[->, line width=0.8pt] ([yshift=-3pt]gg.west) -- node[below, font=\footnotesize] {prestaciones} ([yshift=-3pt]hh.east);
  \end{scope}

  % Paso 5: redistribución en especie y utilización
  \node[paso] (k5) at ([yshift=-0.42cm]k4.south west) {};
  \node[num] at (k5.north west) {5};
  \draw[enlace] ([xshift=2.2cm]k4.south west) -- ([xshift=2.2cm]k5.north west) node[midway, maniobra, xshift=2pt] {se gasta la renta};
  \begin{scope}[shift={(k5.north west)}]
    \node[tit, text width=4.1cm] at (0.25,-0.1) {\textbf{Especie y utilización (II.3 y II.4)}\\[1pt] $ANB=RNDB-C$\\[1pt] $AB_j=RDB_j+D8_j-C_j$};
    \node[tit, text width=6.4cm] at (4.6,-0.1) {Las transferencias sociales en especie (sanidad, educación) pasan del gasto de las Administraciones al consumo efectivo de los hogares. Lo que no se consume es el \textbf{ahorro}, que abre las cuentas de acumulación.};
    \fill[black!15] (11.4,-1.0) rectangle (14.0,-0.55); \fill[blue!30] (14.0,-1.0) rectangle (15.2,-0.55);
    \draw[black!60] (11.4,-1.0) rectangle (15.2,-0.55);
    \node[font=\footnotesize] at (12.7,-0.78) {$C$}; \node[font=\footnotesize] at (14.6,-0.78) {$ANB$};
    \draw[decorate, decoration={brace, amplitude=3pt}, black!60] (11.4,-0.47) -- (15.2,-0.47) node[midway, above=2pt, font=\footnotesize] {$RNDB$};
  \end{scope}

  % ================= EL RESULTADO =================
  \node[sec, text=black!75] (hR) at ([yshift=-0.3cm]k5.south west) {El resultado: una macromagnitud para cada pregunta};
  \node[caja, fill=black!4, minimum width=15.43cm, minimum height=2.25cm, anchor=north west] (R) at ([yshift=-0.12cm]hR.south west) {};
  \begin{scope}[shift={(R.north west)}]
    \foreach \x/\l/\q in {1.4/PIB/{¿cuánto valor\\ se crea?}, 5.0/RNB/{¿cuánta renta obtienen\\ los residentes?}, 8.6/RNDB/{¿de cuánta\\ disponen?}, 12.2/ANB/{¿cuánta no\\ consumen?}} {
      \node[chip, minimum width=1.4cm] (c\l) at (\x,-1.25) {$\l$};
      \node[font=\footnotesize, align=center, anchor=south] at (\x,-0.95) {\q};
    }
    \draw[->, line width=0.9pt] (cPIB.east) -- node[below, font=\footnotesize] {$+RPN$} (cRNB.west);
    \draw[->, line width=0.9pt] (cRNB.east) -- node[below, font=\footnotesize] {$+TCN$} (cRNDB.west);
    \draw[->, line width=0.9pt] (cRNDB.east) -- node[below, font=\footnotesize] {$-C$} (cANB.west);
    \draw[->, line width=0.9pt] (cANB.east) -- (14.9,-1.25) node[anchor=west, font=\footnotesize, align=left] {cuenta\\ de capital};
    \node[tit, text width=15.0cm] at (0.12,-1.6) {Entre dos macromagnitudes solo median las operaciones que se registran entre una y otra. Netas: menos el consumo de capital fijo. Reales: deflactadas, con índices encadenados.};
  \end{scope}

  % ================= GLOSARIO =================
  \node[caja, fill=black!3, anchor=north west, inner sep=5pt, text width=15.15cm] at ([yshift=-0.35cm]R.south west)
    {\textbf{Glosario de notación.} {\itshape Columnas: hogares e ISFLSH (S.14--15), sociedades (S.11--12), AAPP (S.13), total (S.1), resto del mundo (S.2), bienes y servicios (ByS).}\\[2pt]
     \renewcommand{\arraystretch}{1.05}%
     \begin{tabular}{@{}>{$}l<{$}@{\;\;}>{\raggedright\arraybackslash}p{3.55cm}@{\quad}>{$}l<{$}@{\;\;}>{\raggedright\arraybackslash}p{3.55cm}@{\quad}>{$}l<{$}@{\;\;}>{\raggedright\arraybackslash}p{3.55cm}@{}}
       VP,\,CI & producción; consumo intermedio & W & remuneración de los asalariados & RNB & renta nacional bruta \\
       VAB_j^{pb} & valor añadido a precios básicos & EBE,\,RMB & excedente; renta mixta & TCN & transferencias corrientes netas \\
       T_p,\,T_q & impuestos netos sobre productos; sobre la producción & RPN & rentas primarias netas del exterior & RNDB,\,RDB & renta disponible: nacional; de un sector \\
       C,\,FBC & consumo final; formación bruta de capital & X,\,M & exportaciones; importaciones & D8,\,AB,\,ANB & ajuste por pensiones; ahorro; ahorro nacional \\
     \end{tabular}};
\end{tikzpicture}
