% Figura: la matriz de transacciones completa del bloque 2 (todas las operaciones de las cuentas corrientes, de capital y financiera, sin las filas de saldos).
% Fuente de SCN_matriz_completa.pdf. Convención de GODLEY y LAVOIE (2007) sobre las columnas del cuadro de cuentas económicas integradas del SEC 2010.
\providecommand{\opc}[2]{\textbf{#1} {\scriptsize\textcolor{black!65}{#2}}}
\begin{tikzpicture}[>=stealth,
  c/.style={draw=black!70, line width=0.5pt, minimum width=1.95cm, minimum height=0.62cm, font=\footnotesize, align=center, anchor=center},
  h/.style={c, fill=black!6, font=\footnotesize\bfseries, minimum height=1.05cm},
  ht/.style={h, fill=black!16},
  f/.style={c, text width=5.4cm, minimum width=5.7cm, font=\footnotesize, align=left, fill=black!3},
  pro/.style={c, fill=blue!7}, ren/.style={c, fill=blue!4}, acu/.style={c, fill=red!8}, ext/.style={c, fill=green!8},
  tot/.style={c, fill=black!12}, totz/.style={c, fill=black!12, text=black!50},
  vac/.style={c, fill=white},
  cero/.style={c, fill=white, text=black!55, minimum width=1.0cm},
  sig/.style={h, minimum width=1.0cm},
  bl/.style={c, fill=white, draw=none, font=\scriptsize\bfseries\itshape, text=black!60, align=left, minimum height=0.45cm, anchor=west}]
  \matrix (m) [matrix of nodes, column sep=-0.5pt, row sep=-0.5pt, nodes in empty cells]
  {
    |[f, fill=white, draw=none]| &
    |[h]| \shortstack{Hogares\\ e ISFLSH} &
    |[h]| Sociedades &
    |[h]| AAPP &
    |[ht]| \shortstack{Total\\ economía} &
    |[h]| \shortstack{Resto\\ del mundo} &
    |[h]| \shortstack{Bienes y\\ servicios} &
    |[sig]| $\Sigma$ \\
    |[f]| \opc{Producción}{P.1} & |[pro]| $+VP_H$ & |[pro]| $+VP_S$ & |[pro]| $+VP_G$ & |[tot]| $+VP$ & |[vac]| & |[pro]| $-VP$ & |[cero]| $0$ \\
    |[f]| \opc{Consumos intermedios}{P.2} & |[pro]| $-CI_H$ & |[pro]| $-CI_S$ & |[pro]| $-CI_G$ & |[tot]| $-CI$ & |[vac]| & |[pro]| $+CI$ & |[cero]| $0$ \\
    |[f]| \opc{Exportaciones}{P.6} & |[vac]| & |[vac]| & |[vac]| & |[tot]| & |[ext]| $-X$ & |[pro]| $+X$ & |[cero]| $0$ \\
    |[f]| \opc{Importaciones}{P.7} & |[vac]| & |[vac]| & |[vac]| & |[tot]| & |[ext]| $+M$ & |[pro]| $-M$ & |[cero]| $0$ \\
    |[f]| \opc{Gasto en consumo final}{P.3} & |[pro]| $-C_H$ & |[vac]| & |[pro]| $-C_G$ & |[tot]| $-C$ & |[vac]| & |[pro]| $+C$ & |[cero]| $0$ \\
    |[f]| \opc{Formación bruta de capital}{P.5} & |[acu]| $-FBC_H$ & |[acu]| $-FBC_S$ & |[acu]| $-FBC_G$ & |[tot]| $-FBC$ & |[vac]| & |[pro]| $+FBC$ & |[cero]| $0$ \\
    |[f]| \opc{Remuneración de asalariados}{D.1} & |[ren]| $+W^{N}-W_H$ & |[ren]| $-W_S$ & |[ren]| $-W_G$ & |[tot]| $W^{N}-W$ & |[ext]| $W-W^{N}$ & |[vac]| & |[cero]| $0$ \\
    |[f]| \opc{Impuestos s/ producción e importac.}{D.2 $-$ D.3} & |[ren]| $-T_{q,H}$ & |[ren]| $-T_{q,S}$ & |[ren]| $T^{N}-T_{q,G}$ & |[tot]| $T^{N}-T_q$ & |[ext]| \scriptsize $T_p+T_q-T^{N}$ & |[pro]| $-T_p$ & |[cero]| $0$ \\
    |[f]| \opc{Rentas de la propiedad}{D.4} & |[ren]| $+RP_H$ & |[ren]| $\pm RP_S$ & |[ren]| $-RP_G$ & |[tot]| $\pm RP$ & |[ext]| $\pm RP_{RM}$ & |[vac]| & |[cero]| $0$ \\
    |[f]| \opc{Impuestos corrientes}{D.5} & |[ren]| $-T_{d,H}$ & |[ren]| $-T_{d,S}$ & |[ren]| $+T_d$ & |[totz]| $0$ & |[vac]| & |[vac]| & |[cero]| $0$ \\
    |[f]| \opc{Cotizaciones sociales netas}{D.61} & |[ren]| $-CS$ & |[ren]| $+CS_S$ & |[ren]| $+CS_G$ & |[totz]| $0$ & |[vac]| & |[vac]| & |[cero]| $0$ \\
    |[f]| \opc{Prestaciones sociales}{D.62} & |[ren]| $+PS$ & |[ren]| $-PS_S$ & |[ren]| $-PS_G$ & |[totz]| $0$ & |[vac]| & |[vac]| & |[cero]| $0$ \\
    |[f]| \opc{Otras transferencias corrientes}{D.7} & |[ren]| $\pm OT_H$ & |[ren]| $\pm OT_S$ & |[ren]| $\pm OT_G$ & |[tot]| $+TCN$ & |[ext]| $-TCN$ & |[vac]| & |[cero]| $0$ \\
    |[f]| \opc{Ajuste por derechos por pensiones}{D.8} & |[ren]| $+D8$ & |[ren]| $-D8$ & |[vac]| & |[totz]| $0$ & |[vac]| & |[vac]| & |[cero]| $0$ \\
    |[f]| \opc{Transferencias de capital}{D.9} & |[acu]| $\pm TK_H$ & |[acu]| $\pm TK_S$ & |[acu]| $\pm TK_G$ & |[tot]| $+TKN$ & |[ext]| $-TKN$ & |[vac]| & |[cero]| $0$ \\
    |[f]| \opc{Activos no producidos}{NP} & |[acu]| $\pm NP_H$ & |[acu]| $\pm NP_S$ & |[acu]| $\pm NP_G$ & |[totz]| $0$ & |[vac]| & |[vac]| & |[cero]| $0$ \\
    |[f]| \opc{Activos y pasivos financieros}{F.1 a F.8, netos} & |[acu]| $-CF_H$ & |[acu]| $-CF_S$ & |[acu]| $-CF_G$ & |[tot]| $-CF$ & |[ext]| $-CF_{RM}$ & |[vac]| & |[cero]| $0$ \\
    |[f, fill=black!6]| \textbf{$\Sigma$} & |[cero, minimum width=1.95cm]| $0$ & |[cero, minimum width=1.95cm]| $0$ & |[cero, minimum width=1.95cm]| $0$ & |[cero, minimum width=1.95cm, fill=black!12]| $0$ & |[cero, minimum width=1.95cm]| $0$ & |[cero, minimum width=1.95cm]| $0$ & |[cero]| $0$ \\
  };
  % Agrupación de las filas
  \draw[decorate, decoration={brace, amplitude=4pt, mirror}, line width=0.8pt, blue!55!black]
    ([xshift=-0.12cm]m-2-1.north west) -- ([xshift=-0.12cm]m-7-1.south west)
    node[midway, xshift=-0.4cm, font=\scriptsize\bfseries, text=blue!55!black, rotate=90] {Bienes y servicios};
  \draw[decorate, decoration={brace, amplitude=4pt, mirror}, line width=0.8pt, blue!40!black]
    ([xshift=-0.12cm]m-8-1.north west) -- ([xshift=-0.12cm]m-15-1.south west)
    node[midway, xshift=-0.4cm, font=\scriptsize\bfseries, text=blue!40!black, rotate=90] {Rentas y transferencias};
  \draw[decorate, decoration={brace, amplitude=4pt, mirror}, line width=0.8pt, red!55!black]
    ([xshift=-0.12cm]m-16-1.north west) -- ([xshift=-0.12cm]m-18-1.south west)
    node[midway, xshift=-0.4cm, font=\scriptsize\bfseries, text=red!55!black, rotate=90] {Acumulación};
  \node[font=\scriptsize, text=black!75, anchor=north west, align=left, text width=17.5cm, execute at begin node={\hyphenpenalty=10000}] at ([yshift=-0.25cm]m-19-1.south west)
    {Cada fila suma cero (lo que paga uno lo cobra otro) y cada columna suma cero (ningún sector gasta sin obtener los fondos de algún sitio). La formación bruta de capital se agrupa con las operaciones de bienes y servicios por su contrapartida en productos, aunque es un empleo de la cuenta de capital.\\
     Se omiten las transferencias sociales en especie y su consumo, porque se compensan en cada columna. Los impuestos sobre los productos llegan por fin a la columna de las AAPP: $T^{N}$ incluye los impuestos netos sobre los productos y los otros impuestos netos sobre la producción de ámbito nacional.};
\end{tikzpicture}
