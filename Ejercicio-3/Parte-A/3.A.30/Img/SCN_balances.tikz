% Figura: la matriz de balances (convención de GODLEY y LAVOIE, 2007): activos con signo +, pasivos con signo -, y el patrimonio neto con signo - para que cada columna sume cero.
% Fuente de SCN_balances.pdf. Columnas del cuadro de cuentas económicas integradas del SEC 2010, sin la de bienes y servicios.
\providecommand{\op}[2]{\shortstack[l]{\textbf{#1}\\ \textcolor{black!65}{\scriptsize #2}}}
\begin{tikzpicture}[>=stealth,
  c/.style={draw=black!70, line width=0.5pt, minimum width=1.85cm, minimum height=0.9cm, font=\small, align=center, anchor=center},
  h/.style={c, fill=black!6, font=\footnotesize\bfseries, minimum height=1.25cm},
  ht/.style={h, fill=black!16},
  f/.style={c, text width=5.0cm, minimum width=5.3cm, font=\footnotesize, align=left, fill=black!3},
  nf/.style={c, fill=orange!12}, fin/.style={c, fill=red!8}, ext/.style={c, fill=green!8},
  tot/.style={c, fill=black!12},
  vac/.style={c, fill=white},
  cero/.style={c, fill=white, text=black!55, minimum width=1.3cm},
  sig/.style={h, minimum width=1.3cm},
  pn/.style={c, fill=yellow!20, font=\small\bfseries}]
  \matrix (m) [matrix of nodes, column sep=-0.5pt, row sep=-0.5pt, nodes in empty cells]
  {
    |[f, fill=white, draw=none]| &
    |[h]| \shortstack{Hogares\\ e ISFLSH} &
    |[h]| Sociedades &
    |[h]| AAPP &
    |[ht]| \shortstack{Total\\ economía} &
    |[h]| \shortstack{Resto\\ del mundo} &
    |[sig]| $\Sigma$ \\
    |[f]| \op{Activos no financieros}{AN: producidos y no producidos} & |[nf]| $+K_H$ & |[nf]| $+K_S$ & |[nf]| $+K_G$ & |[tot]| $+K$ & |[vac]| & |[cero]| $+K$ \\
    |[f]| \op{Efectivo y depósitos}{AF.2} & |[fin]| $a^{2}_{H}$ & |[fin]| $a^{2}_{S}$ & |[fin]| $a^{2}_{G}$ & |[tot]| $a^{2}$ & |[ext]| $a^{2}_{RM}$ & |[cero]| $0$ \\
    |[f]| \op{Valores representativos de deuda}{AF.3} & |[fin]| $a^{3}_{H}$ & |[fin]| $a^{3}_{S}$ & |[fin]| $a^{3}_{G}$ & |[tot]| $a^{3}$ & |[ext]| $a^{3}_{RM}$ & |[cero]| $0$ \\
    |[f]| \op{Préstamos}{AF.4} & |[fin]| $a^{4}_{H}$ & |[fin]| $a^{4}_{S}$ & |[fin]| $a^{4}_{G}$ & |[tot]| $a^{4}$ & |[ext]| $a^{4}_{RM}$ & |[cero]| $0$ \\
    |[f]| \op{Participaciones en el capital}{y en fondos de inversión (AF.5)} & |[fin]| $a^{5}_{H}$ & |[fin]| $a^{5}_{S}$ & |[fin]| $a^{5}_{G}$ & |[tot]| $a^{5}$ & |[ext]| $a^{5}_{RM}$ & |[cero]| $0$ \\
    |[f]| \op{Otros instrumentos}{AF.1, AF.6, AF.7 y AF.8} & |[fin]| $a^{o}_{H}$ & |[fin]| $a^{o}_{S}$ & |[fin]| $a^{o}_{G}$ & |[tot]| $a^{o}$ & |[ext]| $a^{o}_{RM}$ & |[cero]| $0^{*}$ \\
    |[f, fill=yellow!20]| \op{Patrimonio neto}{B.90: activos menos pasivos} & |[pn]| $-PN_H$ & |[pn]| $-PN_S$ & |[pn]| $-PN_G$ & |[pn, fill=black!22]| $-RN$ & |[pn, fill=green!16]| $-PN_{RM}$ & |[cero]| $-K$ \\
    |[f, fill=black!6]| \textbf{$\Sigma$} & |[cero, minimum width=1.85cm]| $0$ & |[cero, minimum width=1.85cm]| $0$ & |[cero, minimum width=1.85cm]| $0$ & |[cero, minimum width=1.85cm, fill=black!12]| $0$ & |[cero, minimum width=1.85cm]| $0$ & |[cero]| $0$ \\
  };
  \draw[line width=1.2pt, black!75] (m-8-1.north west) -- (m-8-7.north east);
  \node[font=\scriptsize, text=black!75, anchor=north west, align=left, text width=14.6cm, execute at begin node={\hyphenpenalty=10000}] at ([yshift=-0.3cm]m-9-1.south west)
    {$a^{k}_{j}$: activos menos pasivos del sector $j$ en el instrumento $k$ (posición neta). Cada fila financiera suma cero, porque todo activo financiero es el pasivo de otra unidad ($^{*}$ salvo el oro monetario en lingotes). Por eso la riqueza nacional ($RN$, suma de los patrimonios netos de los sectores residentes) es igual a los activos no financieros más la posición financiera neta frente al resto del mundo: $RN=K-PN_{RM}$.\\
     El resto del mundo solo tiene activos y pasivos financieros: los activos no financieros que poseen los no residentes en el territorio se atribuyen a una unidad residente ficticia, de la que aquellos poseen una participación (SEC 2010, apartado 8.76).};
\end{tikzpicture}
