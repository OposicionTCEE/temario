% Figura: esquema de una página de los modelos stock-flujo (bloque 3 y su anexo; anexo «Material de estudio: Esquema»).
% Secuencia: problema -> herramienta (los ingredientes: qué suponen y su crítica) -> solución (de la contabilidad al modelo:
% matrices, SIM, BMW, PC, tres saldos) -> para qué sirve y dónde falla -> glosario.
% Generar con: bash Code/generar_figura.sh SFC_esquema
\begin{tikzpicture}[>=stealth,
  caja/.style={draw=black!70, rounded corners=3pt, line width=0.6pt, align=left, font=\footnotesize, inner sep=4pt},
  sec/.style={font=\small\bfseries, anchor=north west},
  tit/.style={font=\footnotesize, anchor=north west, align=left},
  mc/.style={draw=black!60, minimum width=0.6cm, minimum height=0.32cm, font=\footnotesize, inner sep=0.3pt, anchor=center},
  paso/.style={draw=black!70, rounded corners=3pt, line width=0.6pt, fill=blue!3, minimum width=15.43cm, minimum height=1.65cm, anchor=north west, inner sep=0pt},
  num/.style={circle, fill=black!80, text=white, font=\footnotesize\bfseries, inner sep=1.2pt, minimum size=0.45cm},
  enlace/.style={->, line width=1pt, blue!50!black},
  maniobra/.style={font=\footnotesize\itshape, text=blue!50!black, anchor=west},
  chip/.style={draw=black!60, rounded corners=2pt, font=\footnotesize, inner sep=2.5pt, minimum height=0.45cm, fill=blue!12, align=center}]

  % ================= EL PROBLEMA =================
  \node[sec, text=red!50!black] at (0,0) {El problema};
  \node[caja, fill=red!6, text width=15.15cm, anchor=north west] (P) at (0,-0.45)
    {\textbf{Las identidades se cumplen siempre, pero no dicen qué saldo se ajusta a cuál, ni a qué velocidad, ni qué pasa con los stocks.} ¿Cómo convertir las cuentas en un modelo que respete, periodo a periodo, la coherencia entre flujos y stocks?};

  % ================= LA HERRAMIENTA =================
  \node[sec, text=blue!50!black] (hH) at ([yshift=-0.3cm]P.south west) {La herramienta: las cuentas más tres ingredientes};
  \node[caja, fill=blue!4, text width=15.15cm, anchor=north west] (H) at ([yshift=-0.12cm]hH.south west)
    {GODLEY y LAVOIE (2007) sintetizan los flujos de fondos (COPELAND), New Haven (TOBIN) y Cambridge (GODLEY).\\[3pt]
     \renewcommand{\arraystretch}{1.12}%
     \begin{tabular}{@{}>{\raggedright\arraybackslash}p{2.6cm}@{\quad}>{\raggedright\arraybackslash}p{7.3cm}@{\quad}>{\raggedright\arraybackslash}p{4.4cm}@{}}
       \textbf{Ingrediente} & \textbf{Qué supone} & \textbf{Crítica} \\ \hline
       Matrices ampliadas & empresas, bancos, Gobierno y banco central: sin agujeros negros & ninguna: es contabilidad \\
       Comportamiento & consumo (renta, riqueza), inversión (capital deseado), cartera & se postula; calibrado; LUCAS \\
       Cierre & el banco central fija el tipo de interés; el dinero es endógeno & otro cierre, otros resultados \\
       Tiempo & intereses sobre los stocks de $t-1$; normas stock-flujo & agregado, sin heterogeneidad \\
     \end{tabular}};

  % ================= LA SOLUCIÓN =================
  \node[sec, text=blue!50!black] (hS) at ([yshift=-0.3cm]H.south west) {La solución: de la contabilidad al modelo};

  % Paso 1: matrices ampliadas
  \node[paso] (k1) at ([yshift=-0.15cm]hS.south west) {};
  \node[num] at (k1.north west) {1};
  \begin{scope}[shift={(k1.north west)}]
    \node[tit, text width=4.1cm] at (0.25,-0.1) {\textbf{Matrices ampliadas}\\[1pt] $X_t=X_{t-1}+\Delta X^{op}_t+R^X_t$\\[1pt] una ecuación es redundante};
    \node[tit, text width=6.4cm] at (4.6,-0.1) {Filas y columnas suman cero: todo déficit se financia con un pasivo o vendiendo un activo, y todo flujo cambia un stock. Si todo cuadra, una ecuación sobra (como la ley de WALRAS) y sirve de comprobación.};
    \matrix (ma) [matrix of nodes, nodes={mc}, column sep=-0.4pt, row sep=-0.4pt, anchor=north west] at (11.6,-0.12)
    {
      \textbf{H} & \textbf{E} & \textbf{B} & \textbf{G} & |[draw=none]| {} \\
      $+$ & $-$ & & & |[draw=none, text=blue!50!black]| $\Sigma=0$ \\
      $-$ & $+$ & & & |[draw=none, text=blue!50!black]| $\Sigma=0$ \\
      |[draw=none, text=blue!50!black]| $0$ & |[draw=none, text=blue!50!black]| $0$ & |[draw=none, text=blue!50!black]| $0$ & |[draw=none, text=blue!50!black]| $0$ & |[draw=none]| {} \\
    };
  \end{scope}

  % Paso 2: SIM
  \node[paso] (k2) at ([yshift=-0.42cm]k1.south west) {};
  \node[num] at (k2.north west) {2};
  \draw[enlace] ([xshift=2.2cm]k1.south west) -- ([xshift=2.2cm]k2.north west) node[midway, maniobra, xshift=2pt] {se añade el comportamiento más simple};
  \begin{scope}[shift={(k2.north west)}]
    \node[tit, text width=4.1cm] at (0.25,-0.1) {\textbf{SIM: dinero público}\\[1pt] $C=\alpha_1 YD+\alpha_2 H_{-1}$, $\Delta H=G-T$\\[1pt] $\Delta H=0\Rightarrow Y^{*}=G/\theta$};
    \node[tit, text width=6.4cm] at (4.6,-0.1) {A corto plazo, el multiplicador keynesiano; a largo, el déficit se cierra cuando los hogares alcanzan su riqueza deseada, y el multiplicador es $1/\theta$. \textbf{El Gobierno no elige su déficit}: elige $G$ y $\theta$.};
    \draw[->, black!60] (11.95,-1.45) -- (15.25,-1.45) node[anchor=north east, font=\footnotesize] {$t$};
    \draw[->, black!60] (11.95,-1.45) -- (11.95,-0.15) node[anchor=north east, font=\footnotesize] {$Y$};
    \draw[dashed, black!40] (11.95,-0.4) -- (15.1,-0.4);
    \node[font=\footnotesize, anchor=east] at (11.95,-0.4) {$125$};
    \node[font=\footnotesize, anchor=east] at (11.95,-1.2) {$100$};
    \draw[line width=1.1pt, blue!60!black] (12.0,-1.2) -- (12.7,-1.2) -- (12.7,-0.95) .. controls (13.4,-0.55) and (14.1,-0.43) .. (15.1,-0.41);
    \node[font=\footnotesize, anchor=north] at (12.7,-1.45) {$G\uparrow$};
  \end{scope}

  % Paso 3: BMW
  \node[paso] (k3) at ([yshift=-0.42cm]k2.south west) {};
  \node[num] at (k3.north west) {3};
  \draw[enlace] ([xshift=2.2cm]k2.south west) -- ([xshift=2.2cm]k3.north west) node[midway, maniobra, xshift=2pt] {se añaden los bancos y los préstamos};
  \begin{scope}[shift={(k3.north west)}]
    \node[tit, text width=4.1cm] at (0.25,-0.1) {\textbf{BMW: dinero endógeno}\\[1pt] $\Delta L=I-AF$\\[1pt] $\Delta M_h=YD-C$};
    \node[tit, text width=6.4cm] at (4.6,-0.1) {Las empresas piden prestado para invertir y pagar salarios: los \textbf{préstamos crean los depósitos} y la financiación precede a la producción. Ahorrar más reduce la renta también a largo plazo (paradoja del ahorro).};
    \node[chip, fill=black!10] (ba) at (11.95,-0.45) {Bancos};
    \node[chip, fill=blue!15] (em) at (14.5,-0.45) {Empresas};
    \node[chip, fill=red!12] (ho) at (13.2,-1.3) {Hogares};
    \draw[->, line width=0.8pt] (ba) -- node[above, font=\footnotesize] {préstamo $L$} (em);
    \draw[->, line width=0.8pt] (em) -- node[right, font=\footnotesize] {salarios} (ho);
    \draw[->, line width=0.8pt] (ho) -- node[midway, sloped, below, font=\footnotesize] {depósito $M$} (ba);
  \end{scope}

  % Paso 4: PC
  \node[paso] (k4) at ([yshift=-0.42cm]k3.south west) {};
  \node[num] at (k4.north west) {4};
  \draw[enlace] ([xshift=2.2cm]k3.south west) -- ([xshift=2.2cm]k4.north west) node[midway, maniobra, xshift=2pt] {se añade la elección entre activos};
  \begin{scope}[shift={(k4.north west)}]
    \node[tit, text width=4.1cm] at (0.25,-0.1) {\textbf{PC: riqueza y cartera}\\[1pt] $\dfrac{B_h}{V}=\lambda_0+\lambda_1 r-\lambda_2\dfrac{YD}{V}$, \ $r=\bar r$};
    \node[tit, text width=6.4cm] at (4.6,-0.1) {Los hogares reparten su riqueza entre dinero y bonos según su rendimiento (TOBIN); el banco central fija el tipo y compra el resto. Subirlo eleva la renta de los tenedores: el \textbf{tipo de interés es también fiscal}.};
    \fill[blue!30] (11.4,-0.62) rectangle (13.6,-0.3); \fill[green!30] (13.6,-0.62) rectangle (15.2,-0.3);
    \node[font=\footnotesize] at (12.5,-0.46) {$B_h$}; \node[font=\footnotesize] at (14.4,-0.46) {$H_h$};
    \fill[blue!30] (11.4,-1.17) rectangle (14.0,-0.85); \fill[green!30] (14.0,-1.17) rectangle (15.2,-0.85);
    \node[font=\footnotesize] at (12.7,-1.01) {$B_h$}; \node[font=\footnotesize] at (14.6,-1.01) {$H_h$};
    \node[font=\footnotesize, anchor=north] at (13.3,-1.2) {$V$ con $r$ bajo y con $r$ alto};
  \end{scope}

  % Paso 5: tres saldos
  \node[paso] (k5) at ([yshift=-0.42cm]k4.south west) {};
  \node[num] at (k5.north west) {5};
  \draw[enlace] ([xshift=2.2cm]k4.south west) -- ([xshift=2.2cm]k5.north west) node[midway, maniobra, xshift=2pt] {se abre la economía};
  \begin{scope}[shift={(k5.north west)}]
    \node[tit, text width=4.1cm] at (0.25,-0.1) {\textbf{Los tres saldos}\\[1pt] $(S-I)+(T-G)=CC$};
    \node[tit, text width=6.4cm] at (4.6,-0.1) {Con normas stock-flujo, la identidad detecta procesos insostenibles: EE. UU. (1999), zona del euro (1992), España (2007: superávit público del $2{,}2\%$ del PIB, necesidad de la nación del $9{,}7\%$).};
    \draw[black!50] (11.4,-0.75) -- (15.2,-0.75);
    \fill[red!35] (11.7,-0.75) rectangle ++(0.8,-0.7); \node[font=\footnotesize, anchor=south] at (12.1,-0.73) {privado};
    \fill[green!35] (13.0,-0.75) rectangle ++(0.8,0.17); \node[font=\footnotesize, anchor=north] at (13.4,-0.78) {AAPP};
    \node[font=\footnotesize, anchor=south] at (13.4,-0.56) {$+2{,}2$};
    \fill[yellow!55] (14.3,-0.75) rectangle ++(0.8,-0.57); \node[font=\footnotesize, anchor=south] at (14.7,-0.73) {nación};
    \node[font=\footnotesize, anchor=north] at (14.7,-1.33) {$-9{,}7$};
  \end{scope}

  % ================= USOS Y LÍMITES =================
  \node[sec, text=black!75] (hU) at ([yshift=-0.3cm]k5.south west) {Para qué sirve y dónde falla};
  \node[caja, fill=green!5, text width=7.1cm, minimum height=3.3cm, anchor=north west] (U) at ([yshift=-0.12cm]hU.south west)
    {\textbf{Usos}\\[2pt]
     \textbf{Sostenibilidad}: saldos sectoriales más normas de deuda (el procedimiento de desequilibrios de la Unión, de 2011).\\
     \textbf{Política fiscal}: un recorte del gasto reduce la renta hasta que el ahorro deseado iguala la deuda emitida.\\
     \textbf{Ahorro}: más ahorro, menos producción, también a largo plazo.\\
     \textbf{Política monetaria}: el tipo de interés también reparte renta.};
  \node[caja, fill=orange!6, text width=7.1cm, minimum height=3.3cm, anchor=north west] (Li) at ([xshift=0.65cm]U.north east)
    {\textbf{Límites} ($\to$ respuesta)\\[2pt]
     Comportamiento postulado ($\to$ también lo son los supuestos de optimización; se puede estimar).\\
     Muchos parámetros, calibrados ($\to$ modelos aplicados estimados).\\
     Crítica de LUCAS ($\to$ afecta a todo modelo sin parámetros estructurales).\\
     Agregación sin heterogeneidad ($\to$ tras 2008, los HANK y los DSGE con bancos y balances convergen).};

  % ================= GLOSARIO =================
  \node[caja, fill=black!3, anchor=north west, inner sep=5pt, text width=15.15cm] at ([yshift=-0.35cm]U.south west)
    {\textbf{Glosario de notación.} {\itshape Columnas: H hogares, E empresas, B bancos, G Gobierno y banco central; subíndice $-1$: periodo anterior.}\\[2pt]
     \renewcommand{\arraystretch}{1.05}%
     \begin{tabular}{@{}>{$}l<{$}@{\;\;}>{\raggedright\arraybackslash}p{3.55cm}@{\quad}>{$}l<{$}@{\;\;}>{\raggedright\arraybackslash}p{3.55cm}@{\quad}>{$}l<{$}@{\;\;}>{\raggedright\arraybackslash}p{3.55cm}@{}}
       Y,\,C,\,G & renta, consumo, gasto público & H,\,M & dinero público; depósitos & B_h,\,V & bonos de los hogares; riqueza \\
       T,\,\theta & impuestos; tipo impositivo & L,\,AF & préstamos; amortización & r,\,\lambda_i & tipo de interés; parámetros \\
       YD & renta disponible & I & inversión & S,\,CC & ahorro; cuenta corriente \\
       \alpha_1,\,\alpha_2 & propensiones a consumir & \Delta X^{op},\,R^X & operaciones; revalorización & Y^{*} & estado estacionario \\
     \end{tabular}};
\end{tikzpicture}
