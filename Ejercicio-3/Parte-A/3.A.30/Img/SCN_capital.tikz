% Figura: bloque de filas de la cuenta de capital (III.1).
% Fuente de SCN_capital.pdf. Convención de GODLEY y LAVOIE (2007) sobre las columnas del cuadro de cuentas económicas integradas del SEC 2010.
\providecommand{\op}[2]{\shortstack[l]{\textbf{#1}\\ \textcolor{black!65}{\scriptsize #2}}}
\begin{tikzpicture}[>=stealth,
  c/.style={draw=black!70, line width=0.5pt, minimum width=1.75cm, minimum height=0.95cm, font=\small, align=center, anchor=center},
  h/.style={c, fill=black!6, font=\footnotesize\bfseries, minimum height=1.25cm},
  ht/.style={h, fill=black!16},
  f/.style={c, text width=5.0cm, minimum width=5.3cm, font=\footnotesize, align=left, fill=black!3},
  acu/.style={c, fill=red!8}, ext/.style={c, fill=green!8},
  tot/.style={c, fill=black!12}, totz/.style={c, fill=black!12, text=black!50},
  vac/.style={c, fill=white}, prev/.style={c, fill=white, text=black!50},
  cero/.style={c, fill=white, text=black!55, minimum width=1.3cm},
  sig/.style={h, minimum width=1.3cm},
  ab/.style={c, fill=red!3, text=black!70},
  sal/.style={c, fill=red!18, font=\small\bfseries},
  salt/.style={sal, fill=black!22}]
  \matrix (m) [matrix of nodes, column sep=-0.5pt, row sep=-0.5pt, nodes in empty cells]
  {
    |[f, fill=white, draw=none]| &
    |[h]| \shortstack{Hogares\\ e ISFLSH} &
    |[h]| Sociedades &
    |[h]| AAPP &
    |[ht]| \shortstack{Total\\ economía} &
    |[h]| \shortstack{Resto\\ del mundo} &
    |[h]| \shortstack{Bienes y\\ servicios} &
    |[sig]| $\Sigma$ \\
    |[f, fill=red!3]| \op{Abre con: ahorro bruto}{saldo de la cuenta de utilización} & |[ab]| $+AB_H$ & |[ab]| $+AB_S$ & |[ab]| $+AB_G$ & |[ab, fill=black!8]| $+ANB$ & |[vac]| & |[vac]| & |[cero]| \\
    |[f]| \op{Transferencias de capital}{D.9: ayudas a la inversión, impuestos...} & |[acu]| $\pm TK_H$ & |[acu]| $\pm TK_S$ & |[acu]| $\pm TK_G$ & |[tot]| $+TKN$ & |[ext]| $-TKN$ & |[vac]| & |[cero]| $0$ \\
    |[f]| \op{Formación bruta de capital}{P.5: FBCF, existencias y objetos valiosos} & |[acu]| $-FBC_H$ & |[acu]| $-FBC_S$ & |[acu]| $-FBC_G$ & |[tot]| $-FBC$ & |[vac]| & |[prev]| \shortstack{$+FBC$\\ {\scriptsize (cuenta $0$)}} & |[cero]| $0$ \\
    |[f]| \op{Activos no financieros no producidos}{NP: adquisiciones menos cesiones} & |[acu]| $\pm NP_H$ & |[acu]| $\pm NP_S$ & |[acu]| $\pm NP_G$ & |[totz]| $0$ & |[vac]| & |[vac]| & |[cero]| $0$ \\
    |[f, fill=red!18]| \op{Saldo}{capacidad ($+$) o necesidad ($-$), B.9} & |[sal]| $CF_H$ & |[sal]| $CF_S$ & |[sal]| $CF_G$ & |[salt]| $CF$ & |[sal, fill=green!16]| $-TKN$ & |[vac]| & |[cero]| \\
  };
  \draw[line width=1.2pt, black!75] (m-6-1.north west) -- (m-6-8.north east);
  \draw[->, line width=1.0pt, black!60] ([yshift=-0.2cm]m-6-5.south) -- ++(0,-0.6)
    node[below, font=\scriptsize, text=black!75, align=center] {$CF=ANB+TKN-FBC$\\ (capacidad o necesidad de financiación de la nación)};
  \node[font=\scriptsize, text=black!75, anchor=north west, align=left, text width=15.6cm, execute at begin node={\hyphenpenalty=10000}] at ([yshift=-1.7cm]m-6-1.south west)
    {Con la fila de la formación bruta de capital se completan las celdas que la cuenta de bienes y servicios dejó pendientes. La matriz utiliza saldos brutos: el SEC parte del ahorro neto y resta el consumo de capital fijo entre las adquisiciones de activos, con el mismo resultado.\\
     $TKN$: transferencias de capital netas recibidas del resto del mundo. Por simplicidad, se omiten las adquisiciones de activos no producidos a no residentes, por lo que entre residentes se compensan.};
\end{tikzpicture}
