% Figura: árbol de decisión para clasificar una unidad institucional en su sector del SEC 2010 (cap. 2) y criterio de residencia.
% Fuente de SEC_sectores.pdf. Sustituye a la antigua imagen EsquemaUAE_Residencia.png.
\begin{tikzpicture}[>=stealth,
  preg/.style={draw=black!60, rounded corners=6pt, fill=black!4, align=center, font=\footnotesize, inner sep=3pt, minimum height=0.8cm},
  sec/.style={draw=black!75, line width=0.7pt, fill=blue!10, align=center, font=\footnotesize\bfseries, inner sep=3pt, minimum height=0.85cm, minimum width=2.3cm},
  sub/.style={draw=black!55, fill=white, align=center, font=\scriptsize, inner sep=2pt, minimum height=0.75cm, text width=2.0cm},
  rm/.style={sec, fill=red!10},
  si/.style={font=\scriptsize\itshape, text=black!70},
  fl/.style={->, line width=0.6pt, black!70}]
  % Nivel 1: residencia
  \node[preg] (q1) at (0,0) {¿Tiene su centro de interés económico\\ en el territorio económico?};
  \node[rm, right=1.6cm of q1] (rmu) {Resto del mundo\\ \normalfont(S.2)};
  \draw[fl] (q1) -- node[si, above] {no} (rmu);
  % Nivel 2: hogares
  \node[preg, below=0.9cm of q1] (q2) {¿Es un hogar\\ (consumidor o empresario individual)?};
  \node[sec, right=1.6cm of q2] (hog) {Hogares\\ \normalfont(S.14)};
  \draw[fl] (q1) -- node[si, right] {sí: unidad residente} (q2);
  \draw[fl] (q2) -- node[si, above] {sí} (hog);
  % Nivel 3: mercado o no de mercado
  \node[preg, below=0.9cm of q2] (q3) {¿Es un productor no de mercado?\\ \scriptsize(sus ventas cubren menos del $50\%$ de sus costes)};
  \draw[fl] (q2) -- node[si, right] {no} (q3);
  % Rama no de mercado
  \node[preg, below left=1.0cm and -0.6cm of q3] (q4) {¿Está controlado por\\ las Administraciones públicas?};
  \node[sec, below left=0.9cm and -1.2cm of q4] (isfl) {ISFLSH\\ \normalfont(S.15)};
  \node[sec, below right=0.9cm and -1.2cm of q4] (aapp) {Administraciones\\ públicas \normalfont(S.13)};
  \draw[fl] (q3.south) -- ++(0,-0.3) -| node[si, pos=0.5, above] {sí} (q4.north);
  \draw[fl] (q4) -- node[si, left] {no} (isfl);
  \draw[fl] (q4) -- node[si, right] {sí} (aapp);
  % Rama de mercado
  \node[preg, below right=1.0cm and -0.6cm of q3] (q5) {¿Su actividad principal es\\ financiera (intermediación, seguros\\ o auxiliares)?};
  \node[sec, below left=0.9cm and -1.2cm of q5] (snf) {Sociedades no\\ financieras \normalfont(S.11)};
  \node[sec, below right=0.9cm and -1.2cm of q5] (if) {Instituciones\\ financieras \normalfont(S.12)};
  \draw[fl] (q3.south) -- ++(0,-0.3) -| node[si, pos=0.5, above] {no} (q5.north);
  \draw[fl] (q5) -- node[si, left] {no} (snf);
  \draw[fl] (q5) -- node[si, right] {sí} (if);
  % Subsectores por control
  \foreach \s in {snf, if} {
    \node[sub, text width=3.4cm, below=0.6cm of \s] (\s c) {públicas, controladas\\ por las AAPP\\[1pt] privadas nacionales\\[1pt] privadas bajo control extranjero};
    \draw[fl] (\s.south) -- (\s c.north);
  }
  \node[si, align=center] at ($(snfc.south)!0.5!(ifc.south)+(0,-0.35)$) {Subsectores según quién controla la sociedad};
\end{tikzpicture}
