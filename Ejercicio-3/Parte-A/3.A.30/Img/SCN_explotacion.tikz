% Figura: bloque de filas de la cuenta de explotación (II.1.1). Las rentas se anotan del lado de quien las paga; quien las cobra, en II.1.2.
% Fuente de SCN_explotacion.pdf. Convención de GODLEY y LAVOIE (2007) sobre las columnas del cuadro de cuentas económicas integradas del SEC 2010.
\providecommand{\op}[2]{\shortstack[l]{\textbf{#1}\\ \textcolor{black!65}{\scriptsize #2}}}
\begin{tikzpicture}[>=stealth,
  c/.style={draw=black!70, line width=0.5pt, minimum width=1.75cm, minimum height=0.95cm, font=\small, align=center, anchor=center},
  h/.style={c, fill=black!6, font=\footnotesize\bfseries, minimum height=1.25cm},
  ht/.style={h, fill=black!16},
  f/.style={c, text width=5.0cm, minimum width=5.3cm, font=\footnotesize, align=left, fill=black!3},
  cor/.style={c, fill=blue!7},
  tot/.style={c, fill=black!12}, vac/.style={c, fill=white},
  pen/.style={c, fill=white, text=black!45, font=\scriptsize\itshape, minimum width=1.3cm},
  cero/.style={c, fill=white, text=black!55, minimum width=1.3cm},
  sig/.style={h, minimum width=1.3cm},
  ab/.style={c, fill=blue!3, text=black!70},
  sal/.style={c, fill=blue!18, font=\small\bfseries},
  salt/.style={sal, fill=black!22}]
  \matrix (m) [matrix of nodes, column sep=-0.5pt, row sep=-0.5pt, nodes in empty cells]
  {
    |[f, fill=white, draw=none]| &
    |[h]| \shortstack{Hogares\\ e ISFLSH} &
    |[h]| Sociedades &
    |[h]| AAPP &
    |[ht]| \shortstack{Total\\ economía} &
    |[h]| \shortstack{Resto\\ del mundo} &
    |[h]| \shortstack{Bienes y\\ servicios} &
    |[sig]| $\Sigma$ \\
    |[f, fill=blue!3]| \op{Abre con: valor añadido bruto}{saldo de la cuenta de producción} & |[ab]| $+VAB_H$ & |[ab]| $+VAB_S$ & |[ab]| $+VAB_G$ & |[ab, fill=black!8]| $+PIB$ & |[vac]| & |[vac]| & |[cero]| \\
    |[f]| \op{Remuneración de asalariados}{D.1, interior: del lado de quien la paga} & |[cor]| $-W_H$ & |[cor]| $-W_S$ & |[cor]| $-W_G$ & |[tot]| $-W$ & |[vac]| & |[vac]| & |[pen]| en II.1.2 \\
    |[f]| \op{Otros impuestos netos sobre la producción}{D.29 $-$ D.39} & |[cor]| $-T_{q,H}$ & |[cor]| $-T_{q,S}$ & |[cor]| $-T_{q,G}$ & |[tot]| $-T_q$ & |[vac]| & |[vac]| & |[pen]| en II.1.2 \\
    |[f]| \op{Impuestos netos sobre los productos}{D.21 $-$ D.31: salen solo del total} & |[vac]| & |[vac]| & |[vac]| & |[tot]| $-T_p$ & |[vac]| & |[vac]| & |[pen]| en II.1.2 \\
    |[f, fill=blue!18]| \op{Saldo}{excedente de explotación y renta mixta} & |[sal]| \shortstack{$EBE_H$\\ $+RMB_H$} & |[sal]| $EBE_S$ & |[sal]| $EBE_G$ & |[salt]| \shortstack{$EBE$\\ $+RMB$} & |[vac]| & |[vac]| & |[cero]| \\
  };
  \draw[line width=1.2pt, black!75] (m-6-1.north west) -- (m-6-8.north east);
  \draw[->, line width=1.0pt, black!60] ([yshift=-0.2cm]m-6-5.south) -- ++(0,-0.6)
    node[below, font=\scriptsize, text=black!75, align=center] {$PIB=W+T_q+T_p+EBE+RMB$\\ (enfoque de las rentas)};
  \node[font=\scriptsize, text=black!75, anchor=north west, align=left, text width=15.6cm, execute at begin node={\hyphenpenalty=10000}] at ([yshift=-1.7cm]m-6-1.south west)
    {La cuenta de explotación registra las rentas generadas por la producción desde el punto de vista de quien las paga. Quien las cobra (los hogares asalariados, las AAPP o el resto del mundo) las anota en la cuenta de asignación de la renta primaria, y por eso estas filas solo suman cero junto con las de ese bloque.\\
     Los impuestos netos sobre los productos, que en la cuenta de producción solo figuraban en el total, salen ahora también solo del total: en la columna del total, el PIB se reparte entre los factores productivos y las AAPP.};
\end{tikzpicture}
