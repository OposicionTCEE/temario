% Figura: esquema de una página de las implicaciones y limitaciones del bloque 2 (anexo «Material de estudio: Esquema»):
% usos en tres planos, límites con su respuesta y el límite más profundo, la separación entre lo real y lo monetario,
% con los dos circuitos (orden de registro y circuito monetario, como SCN_circuito_monetario) como salto al bloque 3.
% Generar con: bash Code/generar_figura.sh SCN_esquema_implicaciones
\begin{tikzpicture}[>=stealth,
  caja/.style={draw=black!70, rounded corners=3pt, line width=0.6pt, align=left, font=\footnotesize, inner sep=4pt},
  sec/.style={font=\small\bfseries, anchor=north west},
  tit/.style={font=\footnotesize, anchor=north west, align=left},
  num/.style={circle, fill=black!80, text=white, font=\footnotesize\bfseries, inner sep=1.2pt, minimum size=0.45cm},
  fase/.style={draw=black!60, rounded corners=2pt, font=\footnotesize, align=center, inner sep=2pt, minimum height=1.0cm, text width=2.05cm, anchor=north west}]

  % ================= EL PROBLEMA =================
  \node[sec, text=red!50!black] at (0,0) {El problema};
  \node[caja, fill=red!6, text width=15.15cm, anchor=north west] (P) at (0,-0.45)
    {\textbf{¿Para qué sirven las cuentas nacionales y qué no pueden decir?} Las macromagnitudes son saldos de una misma matriz: cada pregunta exige su agregado, y las identidades obligan a que todo cuadre.};

  % ================= LOS USOS =================
  \node[sec, text=green!35!black] (hU) at ([yshift=-0.3cm]P.south west) {Para qué sirven: tres planos};
  \node[caja, fill=green!5, text width=4.7cm, minimum height=3.35cm, anchor=north west] (u1) at ([yshift=-0.12cm]hU.south west)
    {\textbf{Diagnóstico}\\[1pt] PIB trimestral, ciclos y brecha de producción. Cada pregunta, su agregado: PIB (lo producido en el territorio), RNB (la renta de los residentes), renta disponible de los hogares. Irlanda, 2021: deuda del $55{,}4\%$ del PIB y del $100{,}9\%$ de la RNB modificada.};
  \node[caja, fill=green!5, text width=4.7cm, minimum height=3.35cm, anchor=north west] (u2) at ([xshift=0.22cm]u1.north east)
    {\textbf{Política económica}\\[1pt] Déficit y deuda en contabilidad nacional; desequilibrios (cuenta corriente entre $-4$ y $+6\%$, PII $-35\%$); recurso RNB y fondos de cohesión. Saldos sectoriales: $CF_{priv}+CF_{G}=-CF_{RM}$: nadie reduce su déficit sin que otro lo absorba.};
  \node[caja, fill=green!5, text width=4.7cm, minimum height=3.35cm, anchor=north west] (u3) at ([xshift=0.22cm]u2.north east)
    {\textbf{Largo plazo}\\[1pt] Contabilidad del crecimiento, distribución y comparación internacional. \textbf{Los stocks importan}: los déficits de hoy son la deuda de mañana, y también cambian por revalorización; la crisis de 2008 se gestó en los balances.};

  % ================= LOS LÍMITES =================
  \node[sec, text=orange!45!black] (hL) at ([yshift=-0.3cm]u1.south west) {Dónde falla: lo que el sistema deja fuera};
  \node[caja, fill=orange!5, text width=15.15cm, anchor=north west] (L) at ([yshift=-0.12cm]hL.south west)
    {\renewcommand{\arraystretch}{1.12}%
     \begin{tabular}{@{}>{\raggedright\arraybackslash}p{3.1cm}@{\quad}>{\raggedright\arraybackslash}p{6.7cm}@{\quad}>{\raggedright\arraybackslash}p{4.6cm}@{}}
       \textbf{Límite} & \textbf{Por qué} & \textbf{Respuesta} \\ \hline
       Frontera de la producción & fuera el trabajo doméstico no remunerado (economía feminista); qué es productivo (MAZZUCATO) & cuentas satélite \\
       Lo que no tiene precio & servicios públicos valorados a coste; SIFMI; servicios digitales gratuitos & indicadores de volumen \\
       El PIB no es bienestar & ya lo advirtió KUZNETS (1934); NORDHAUS y TOBIN (1972) & más allá del PIB: cuadros de indicadores \\
       Sostenibilidad y distribución & no descuenta el capital natural; no existe un hogar medio & SCAE; cuentas distributivas \\
       Retos & rapidez, globalización, digitalización & \textit{nowcasting}; SCN 2025 \\
     \end{tabular}};

  % ================= EL LÍMITE MÁS PROFUNDO: LOS DOS CIRCUITOS =================
  \node[sec, text=red!50!black] (hM) at ([yshift=-0.3cm]L.south west) {El límite más profundo: separa lo real de lo monetario};
  \node[tit, text width=15.3cm] (dims) at ([yshift=-0.08cm]hM.south west)
    {Tres dimensiones: (i) en el \textbf{uso}, flujos reales y financieros se elaboran y se analizan por separado; (ii) las identidades no tienen \textbf{cierre de comportamiento}: no dicen qué saldo se ajusta (GODLEY y CRIPPS, 1983); (iii) el \textbf{tiempo}: en una economía monetaria de producción, la financiación precede a la producción (KEYNES, 1933, 1937).};
  \node[font=\footnotesize\bfseries, anchor=north west] (ta) at ([yshift=-0.1cm]dims.south west) {(a) Las cuentas: el orden en que se registra};
  \foreach \i/\l/\c in {0/{Producción\\ (I)}/blue!8, 1/{Renta\\ (II.1 a II.3)}/blue!8, 2/{Utilización\\ (II.4)}/blue!8, 3/{Capital\\ (III.1)}/blue!8, 4/{Financiera\\ (III.2)}/red!10, 5/{Balances\\ (IV)}/teal!10}
    \node[fase, fill=\c] (a\i) at ([xshift=\i*2.6cm, yshift=-0.08cm]ta.south west) {\l};
  \foreach \i/\j in {0/1,1/2,2/3,3/4,4/5} \draw[->, line width=0.7pt] (a\i) -- (a\j);
  \node[font=\footnotesize\itshape, text=black!65, anchor=north west] (na) at ([yshift=-0.05cm]a0.south west) {un periodo, \textit{ex post}: la financiación \textbf{cierra} el periodo};
  \node[font=\footnotesize\bfseries, anchor=north west] (tb) at ([yshift=-0.12cm]na.south west) {(b) El circuito monetario: el orden en que ocurre (GRAZIANI, 2003)};
  \foreach \i/\l/\c in {0/{\textbf{1} Crédito: los bancos crean depósitos}/red!10, 1/{\textbf{2} Producción: salarios e insumos}/blue!8, 2/{\textbf{3} Renta: cobrada en depósitos}/blue!8, 3/{\textbf{4} Gasto: consumo y ahorro}/blue!8, 4/{\textbf{5} Ventas: el dinero vuelve}/blue!8, 5/{\textbf{6} Reembolso: se destruye el dinero}/red!10}
    \node[fase, fill=\c] (b\i) at ([xshift=\i*2.6cm, yshift=-0.08cm]tb.south west) {\l};
  \foreach \i/\j in {0/1,1/2,2/3,3/4,4/5} \draw[->, line width=0.7pt] (b\i) -- (b\j);
  \draw[->, dashed, red!55!black, line width=0.8pt] (b5.south) -- ++(0,-0.3) -| node[pos=0.25, below, font=\footnotesize, text=red!55!black] {lo ahorrado en depósitos queda como deuda: el stock con el que empieza el periodo siguiente} (b0.south);

  % ================= EL SALTO AL BLOQUE 3 =================
  \node[caja, fill=blue!10, draw=black!85, line width=1.1pt, text width=15.15cm, anchor=north west] (S) at ([yshift=-1.05cm]b0.south west)
    {\textbf{El salto al bloque 3: los modelos stock-flujo.} La financiación, que en las cuentas cierra el periodo, en el circuito lo abre. La salida (TAYLOR, 2004; GODLEY y LAVOIE, 2007): tomar la estructura contable \textbf{completa}, flujos y stocks, real y financiera, como esqueleto de un modelo, y añadirle comportamiento, cierre y tiempo.};
\end{tikzpicture}
