% Figura: bloque de filas de la cuenta financiera (III.2), por instrumentos del SEC 2010.
% Fuente de SCN_financiera.pdf. Convención de GODLEY y LAVOIE (2007): contraer un pasivo es una fuente de fondos (+); adquirir un activo, un uso (-).
\providecommand{\op}[2]{\shortstack[l]{\textbf{#1}\\ \textcolor{black!65}{\scriptsize #2}}}
\begin{tikzpicture}[>=stealth,
  c/.style={draw=black!70, line width=0.5pt, minimum width=1.75cm, minimum height=0.9cm, font=\small, align=center, anchor=center},
  h/.style={c, fill=black!6, font=\footnotesize\bfseries, minimum height=1.25cm},
  ht/.style={h, fill=black!16},
  f/.style={c, text width=5.0cm, minimum width=5.3cm, font=\footnotesize, align=left, fill=black!3},
  fin/.style={c, fill=red!8}, ext/.style={c, fill=green!8},
  tot/.style={c, fill=black!12},
  vac/.style={c, fill=white},
  cero/.style={c, fill=white, text=black!55, minimum width=1.3cm},
  sig/.style={h, minimum width=1.3cm},
  ab/.style={c, fill=red!3, text=black!70},
  sal/.style={c, fill=red!18, font=\small\bfseries},
  salt/.style={sal, fill=black!22}]
  \matrix (m) [matrix of nodes, column sep=-0.5pt, row sep=-0.5pt, nodes in empty cells]
  {
    |[f, fill=white, draw=none]| &
    |[h]| \shortstack{Hogares\\ e ISFLSH} &
    |[h]| Sociedades &
    |[h]| AAPP &
    |[ht]| \shortstack{Total\\ economía} &
    |[h]| \shortstack{Resto\\ del mundo} &
    |[h]| \shortstack{Bienes y\\ servicios} &
    |[sig]| $\Sigma$ \\
    |[f, fill=red!3]| \op{Abre con: capacidad o necesidad}{de financiación (cuenta de capital)} & |[ab]| $+CF_H$ & |[ab]| $+CF_S$ & |[ab]| $+CF_G$ & |[ab, fill=black!8]| $+CF$ & |[ab]| $+CF_{RM}$ & |[vac]| & |[cero]| $0$ \\
    |[f]| \op{F.1 Oro monetario y DEG}{} & |[vac]| & |[fin]| $f^{1}_{S}$ & |[vac]| & |[tot]| $f^{1}$ & |[ext]| $f^{1}_{RM}$ & |[vac]| & |[cero]| $0^{*}$ \\
    |[f]| \op{F.2 Efectivo y depósitos}{} & |[fin]| $f^{2}_{H}$ & |[fin]| $f^{2}_{S}$ & |[fin]| $f^{2}_{G}$ & |[tot]| $f^{2}$ & |[ext]| $f^{2}_{RM}$ & |[vac]| & |[cero]| $0$ \\
    |[f]| \op{F.3 Valores representativos de deuda}{} & |[fin]| $f^{3}_{H}$ & |[fin]| $f^{3}_{S}$ & |[fin]| $f^{3}_{G}$ & |[tot]| $f^{3}$ & |[ext]| $f^{3}_{RM}$ & |[vac]| & |[cero]| $0$ \\
    |[f]| \op{F.4 Préstamos}{} & |[fin]| $f^{4}_{H}$ & |[fin]| $f^{4}_{S}$ & |[fin]| $f^{4}_{G}$ & |[tot]| $f^{4}$ & |[ext]| $f^{4}_{RM}$ & |[vac]| & |[cero]| $0$ \\
    |[f]| \op{F.5 Participaciones en el capital}{y en fondos de inversión} & |[fin]| $f^{5}_{H}$ & |[fin]| $f^{5}_{S}$ & |[fin]| $f^{5}_{G}$ & |[tot]| $f^{5}$ & |[ext]| $f^{5}_{RM}$ & |[vac]| & |[cero]| $0$ \\
    |[f]| \op{F.6 Seguros, pensiones}{y garantías estandarizadas} & |[fin]| $f^{6}_{H}$ & |[fin]| $f^{6}_{S}$ & |[fin]| $f^{6}_{G}$ & |[tot]| $f^{6}$ & |[ext]| $f^{6}_{RM}$ & |[vac]| & |[cero]| $0$ \\
    |[f]| \op{F.7 Derivados financieros}{y opciones sobre acciones de los asalariados} & |[fin]| $f^{7}_{H}$ & |[fin]| $f^{7}_{S}$ & |[fin]| $f^{7}_{G}$ & |[tot]| $f^{7}$ & |[ext]| $f^{7}_{RM}$ & |[vac]| & |[cero]| $0$ \\
    |[f]| \op{F.8 Otras cuentas pendientes}{de cobro y de pago} & |[fin]| $f^{8}_{H}$ & |[fin]| $f^{8}_{S}$ & |[fin]| $f^{8}_{G}$ & |[tot]| $f^{8}$ & |[ext]| $f^{8}_{RM}$ & |[vac]| & |[cero]| $0$ \\
    |[f, fill=red!18]| \op{Saldo}{cada columna suma cero} & |[sal]| $0$ & |[sal]| $0$ & |[sal]| $0$ & |[salt]| $0$ & |[sal, fill=green!16]| $0$ & |[vac]| & |[cero]| \\
  };
  \draw[line width=1.2pt, black!75] (m-11-1.north west) -- (m-11-8.north east);
  \node[font=\scriptsize, text=black!75, anchor=north west, align=left, text width=15.6cm, execute at begin node={\hyphenpenalty=10000}] at ([yshift=-0.3cm]m-11-1.south west)
    {$f^{k}_{j}=\Delta P^{k}_{j}-\Delta A^{k}_{j}$: contracción neta de pasivos menos adquisición neta de activos del sector $j$ en el instrumento $k$. Que la columna sume cero es la identidad $CF_j=\sum_k\left(\Delta A^{k}_{j}-\Delta P^{k}_{j}\right)$: lo que un sector no gasta lo presta, y lo que gasta de más lo pide prestado. Que cada fila sume cero significa que todo activo financiero es el pasivo de otro.\\
     $CF_{RM}=-CF$: suma de la columna del resto del mundo en todos los bloques anteriores. $^{*}$ El oro monetario en lingotes es el único activo financiero sin pasivo como contrapartida.};
\end{tikzpicture}
