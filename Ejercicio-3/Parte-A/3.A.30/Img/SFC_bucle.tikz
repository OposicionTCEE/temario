% Figura: lo que un modelo stock-flujo añade a las cuentas: comportamiento, cierre y tiempo, que encadenan los periodos.
% Fuente de SFC_bucle.pdf. A partir de GODLEY y LAVOIE (2007). Azul: lo que ya registran las cuentas; naranja: lo que añade el modelo.
\begin{tikzpicture}[>=stealth, font=\footnotesize,
  bx/.style={draw=black!70, line width=0.5pt, rounded corners=2pt, text width=2.45cm, minimum height=2.1cm, align=center, inner sep=3pt, fill=#1, execute at begin node={\hyphenpenalty=10000}},
  bx/.default=blue!8,
  fl/.style={->, line width=0.8pt, black!65},
  nt/.style={font=\footnotesize, text=black!75, align=center}]

  \node[bx] (k0) at (0,0) {\textbf{Balances en $t-1$}\\ los stocks heredados: riqueza, deuda, capital};
  \node[bx=orange!22] (cp) at (3.2,0) {\textbf{Comportamiento y cierre}\\ consumo, inversión, cartera y crédito; el banco central fija el tipo de interés};
  \node[bx] (mt) at (6.4,0) {\textbf{Matriz de transacciones en $t$}\\ filas y columnas suman cero: una ecuación es redundante};
  \node[bx] (cc) at (9.6,0) {\textbf{Conciliación}\\ stock final $=$ inicial $+$ operaciones $+$ revalorizaciones};
  \node[bx] (k1) at (12.8,0) {\textbf{Balances en $t$}\\ los stocks con los que empieza $t+1$};
  \foreach \i/\j in {k0/cp, cp/mt, mt/cc, cc/k1} \draw[fl] (\i) -- (\j);

  % Revalorizaciones: entran en la conciliación sin pasar por la matriz
  \node[bx=orange!22, minimum height=0.9cm, text width=3.0cm, dashed] (rv) at (9.6,2.05) {\textbf{Revalorizaciones}: una matriz aparte};
  \draw[fl, orange!60!black] (rv) -- (cc);

  % El tiempo: los stocks de t condicionan los flujos de t+1
  \draw[->, line width=0.9pt, dashed, orange!60!black] (k1.south) -- ++(0,-0.5) -| (cp.south)
    node[pos=0.25, below, nt, text=orange!50!black] {tiempo: los stocks de $t$ condicionan los flujos de $t+1$\\ (intereses sobre la deuda heredada, riqueza en el consumo, normas stock-flujo)};

  % Leyenda
  \node[anchor=north west, font=\footnotesize, text=black!75, text width=14.6cm, align=left, inner sep=0pt,
        execute at begin node={\hyphenpenalty=10000}] at (-1.4,-2.6)
    {Azul: lo que ya registran las cuentas nacionales (bloque anterior). Naranja: lo que añade el modelo, que convierte una sucesión de matrices en una dinámica.};
\end{tikzpicture}
