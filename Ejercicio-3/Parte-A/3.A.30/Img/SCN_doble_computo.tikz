% Figura: el doble cómputo. Dos unidades: la 1 produce un input que vende a la 2, que lo utiliza como consumo intermedio para producir un bien final.
% Fuente de SCN_doble_computo.pdf. Ejemplo abstracto, sin cifras.
\begin{tikzpicture}[>=stealth, x=1cm, y=1cm,
  va/.style={draw=black!70, fill=blue!18, line width=0.5pt},
  ci/.style={draw=black!70, fill=black!14, line width=0.5pt},
  dup/.style={draw=red!60!black, fill=red!18, line width=0.5pt},
  lab/.style={font=\footnotesize, align=center},
  cel/.style={font=\small}]
  % Barra 1: producción de la unidad 1
  \draw[va] (0,0) rectangle (1.6,2.0); \node[cel] at (0.8,1.0) {$VA_1$};
  \node[lab, anchor=north] at (0.8,-0.15) {Producción\\ de la unidad 1\\ ($VP_1$)};
  % Barra 2: producción de la unidad 2
  \draw[ci] (3.0,0) rectangle (4.6,2.0); \node[cel] at (3.8,1.0) {\shortstack{$CI_2$\\ $=VP_1$}};
  \draw[va] (3.0,2.0) rectangle (4.6,3.4); \node[cel] at (3.8,2.7) {$VA_2$};
  \node[lab, anchor=north] at (3.8,-0.15) {Producción\\ de la unidad 2\\ ($VP_2$)};
  % Barra 3: suma de las producciones
  \draw[va] (6.4,0) rectangle (8.0,2.0); \node[cel] at (7.2,1.0) {$VA_1$};
  \draw[dup] (6.4,2.0) rectangle (8.0,4.0); \node[cel] at (7.2,3.0) {\shortstack{$CI_2$\\ $=VP_1$}};
  \draw[va] (6.4,4.0) rectangle (8.0,5.4); \node[cel] at (7.2,4.7) {$VA_2$};
  \node[lab, anchor=north] at (7.2,-0.15) {Producción total\\ $VP_1+VP_2$};
  \draw[decorate, decoration={brace, amplitude=5pt}, line width=0.8pt, red!60!black] (8.15,4.0) -- (8.15,2.0)
    node[midway, right=7pt, lab, text=red!60!black, anchor=west] {contado\\ dos veces};
  % Barra 4: suma de los valores añadidos
  \draw[va] (10.4,0) rectangle (12.0,2.0); \node[cel] at (11.2,1.0) {$VA_1$};
  \draw[va] (10.4,2.0) rectangle (12.0,3.4); \node[cel] at (11.2,2.7) {$VA_2$};
  \node[lab, anchor=north] at (11.2,-0.15) {Suma de los\\ valores añadidos\\ $VA_1+VA_2$};
  % Igualdad con el valor del bien final
  \draw[dashed, line width=0.7pt, black!60] (4.6,3.4) -- (6.3,3.4);
  \draw[dashed, line width=0.7pt, black!60] (10.0,3.4) -- (12.6,3.4)
    node[right, lab, text=black!75, anchor=west] {$=VP_2$: valor\\ del bien final};
  % Eje
  \draw[line width=0.8pt, black!70] (-0.3,0) -- (12.6,0);
\end{tikzpicture}
