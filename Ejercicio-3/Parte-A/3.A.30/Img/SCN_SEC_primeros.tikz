% Figura: estructura del primer SCN (1953) frente al primer SEC (1970, descrito con su 2.ª edición de 1979), en dos paneles.
% Solo conceptos. Fuentes: Naciones Unidas (1953), índice y lista de cuentas y cuadros; Eurostat (1979), apartados 101-139.
% Generar con: bash Code/generar_figura.sh SCN_SEC_primeros
\colorlet{cdif}{orange!30}%
\providecommand{\dif}[1]{{\setlength{\fboxsep}{0.8pt}\colorbox{cdif}{#1}}}%
\providecommand{\aus}[1]{{\color{black!55}\itshape #1}}%
\providecommand{\tema}[1]{{\setlength{\fboxsep}{0.8pt}\fcolorbox{black!40}{white}{\color{black!75}#1}}}%
\begin{tikzpicture}[
  font=\footnotesize,
  cab/.style={draw=#1!55!black, fill=#1!10, rounded corners=2pt, text width=7.25cm, align=center, inner sep=3pt, anchor=north west, execute at begin node={\hyphenpenalty=10000}},
  rama/.style={text width=6.6cm, align=left, inner sep=3pt, anchor=north west,
    execute at begin node={\hyphenpenalty=10000\setlength{\baselineskip}{1.12\baselineskip}}},
  marco/.style={draw=black!40, rounded corners=2pt},
  flecha/.style={black!45, -{Latex[length=1.4mm]}}]
  % Cabeceras (raíz de cada panel)
  \node[cab=blue] (hA) at (0,0) {\textbf{\small SCN 1953}\\ Naciones Unidas $\cdot$ recomendación internacional};
  \node[cab=violet] (hB) at (8.2,0) {\textbf{\small SEC 1970} (2.ª edición, 1979)\\ Comunidades Europeas $\cdot$ documento de trabajo\\ versión comunitaria del SCN 1968};
  \coordinate (eA) at (0.3,0); \coordinate (eB) at (8.5,0);
  \path let \p1=(hA.south), \p2=(hB.south) in coordinate (r1) at (0,{min(\y1,\y2)-0.25cm});
  % Fila 1: clasificación institucional
  \node[rama] (a1) at ($(r1)+(0.6,0)$) {\textbf{Clasificación institucional}\hfill\tema{3.A.30}\\
    3 sectores residentes:\\ empresas\\ hogares e instituciones privadas sin fines de lucro\\ gobierno general*\\ y el resto del mundo \tema{3.B.11}};
  \node[rama] (b1) at ($(r1)+(8.8,0)$) {\textbf{Clasificación institucional}\hfill\tema{3.A.30}\\
    unidades institucionales $\to$ 7 sectores:\\
    S 10 sociedades y cuasisociedades no financieras\\
    \dif{S 40 instituciones de crédito}\\ \dif{S 50 empresas de seguro}\\
    S 60 administraciones públicas \tema{4.B.23}\\ \hspace*{1em}(central, local y seguridad social)\\
    \dif{S 70 instituciones privadas sin fines de lucro}\\ S 80 hogares\\
    S 90 resto del mundo \tema{3.B.11}\\ \hspace*{1em}\dif{Comunidades Europeas / terceros países}};
  \path let \p1=(a1.south), \p2=(b1.south) in coordinate (s1) at (0,{min(\y1,\y2)});
  \coordinate (r2) at ($(s1)+(0,-0.22)$);
  % Fila 2: clasificación funcional
  \node[rama] (a2) at ($(r2)+(0.6,0)$) {\textbf{Clasificación funcional*}\hfill\tema{3.A.31}\\
    origen industrial del producto interior, al coste de los factores};
  \node[rama] (b2) at ($(r2)+(8.8,0)$) {\textbf{Clasificación funcional*}\hfill\tema{3.A.31}\\
    \dif{unidades de producción homogénea $\to$ ramas}\\ \dif{nomenclatura NACE/CLIO}};
  \path let \p1=(a2.south), \p2=(b2.south) in coordinate (s2) at (0,{min(\y1,\y2)});
  \coordinate (r3) at ($(s2)+(0,-0.22)$);
  % Fila 3: operaciones
  \node[rama] (a3) at ($(r3)+(0.6,0)$) {\textbf{Operaciones}\\
    flujos definidos cuenta a cuenta};
  \node[rama] (b3) at ($(r3)+(8.8,0)$) {\textbf{Operaciones}\\
    \dif{una sola clasificación, común a ramas y sectores:}\\ P bienes y servicios $\cdot$ R distributivas* $\cdot$ F financieras};
  \path let \p1=(a3.south), \p2=(b3.south) in coordinate (s3) at (0,{min(\y1,\y2)});
  \coordinate (r4) at ($(s3)+(0,-0.22)$);
  % Fila 4: cuentas
  \node[rama] (a4) at ($(r4)+(0.6,0)$) {\textbf{Cuentas}\hfill\tema{3.A.30}\\
    6 cuentas estándar:\\ 1 producto interior $\cdot$ 2 renta nacional\\ 3 formación interior de capital\\
    4 hogares e instituciones privadas sin fines de lucro\\ 5 gobierno general $\cdot$ 6 transacciones exteriores\\
    (4 a 6: cuenta corriente y de conciliación del capital)};
  \node[rama] (b4) at ($(r4)+(8.8,0)$) {\textbf{Cuentas}\hfill\tema{3.A.30}\\
    por sectores y, en parte, por ramas:\\ bienes y servicios $\cdot$ producción\\ generación de la renta $\cdot$ distribución de la renta\\
    utilización de la renta $\cdot$ capital $\cdot$ \dif{financiera}};
  \path let \p1=(a4.south), \p2=(b4.south) in coordinate (s4) at (0,{min(\y1,\y2)});
  \coordinate (r5) at ($(s4)+(0,-0.22)$);
  % Fila 5: cuadros y extensiones
  \node[rama] (a5) at ($(r5)+(0.6,0)$) {\textbf{Cuadros y extensiones}\\
    12 cuadros estándar (gasto, origen industrial, distribución de la renta, sector exterior\dots)\\
    \aus{sin tablas input-output, sin cuentas financieras}\\ \aus{y sin balances}};
  \node[rama] (b5) at ($(r5)+(8.8,0)$) {\textbf{Cuadros y extensiones}\\
    \dif{tablas input-output} \tema{3.A.31}\\
    cuadros estándar: población ocupada, consumo de los hogares y gasto de las AAPP por finalidades* \tema{4.B.23}\\
    \aus{sin balances: solo registra operaciones}};
  \path let \p1=(a5.south), \p2=(b5.south) in coordinate (s5) at (0,{min(\y1,\y2)});
  % Marcos de igual altura en cada fila, flechas y ejes
  \foreach \i in {1,...,5} {
    \draw[marco] (a\i.north west) rectangle (a\i.east |- s\i);
    \draw[marco] (b\i.north west) rectangle (b\i.east |- s\i);
    \coordinate (ta\i) at ($(a\i.north west)+(0,-0.26)$);
    \coordinate (tb\i) at ($(b\i.north west)+(0,-0.26)$);
    \draw[flecha] (eA |- ta\i) -- (ta\i);
    \draw[flecha] (eB |- tb\i) -- (tb\i);
  }
  \draw[black!45] (eA |- hA.south) -- (eA |- ta5);
  \draw[black!45] (eB |- hB.south) -- (eB |- tb5);
  % Leyenda
  \node[anchor=north west, text width=15.4cm, align=left, inner sep=0pt, font=\footnotesize] at ($(s5)+(0,-0.3)$) {
    \dif{\phantom{xx}} diferencia entre los dos sistemas \quad \aus{cursiva gris}: todavía no existe \quad \tema{3.A.31} tema en que se trata\\[2pt]
    * \textit{Gobierno general}: administraciones públicas en el SEC y en el temario. \textit{Clasificación funcional}: por ramas de actividad, no la del gasto público.
    \textit{R distributivas}: hoy, operaciones de distribución (D). \textit{Finalidades de las AAPP}: hoy, la COFOG.};
\end{tikzpicture}
