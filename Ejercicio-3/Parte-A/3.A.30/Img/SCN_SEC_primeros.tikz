% Figura: estructura del primer SCN (1953) frente al primer SEC (1970, descrito con su 2.ª edición de 1979), en dos paneles con el mismo flujo
% que la figura SCN_SEC_2008_2010: sistema -> clasificaciones -> operaciones -> cuentas por sectores | por ramas; aparte, «+ Cuadros y extensiones».
% En el SCN 1953 el flujo está roto: no hay rama funcional con unidades propias ni cuentas por ramas (gris y marco discontinuo).
% Las diferencias del SEC 1970 se escriben «≠ rasgo ⇒ implicación», sin color.
% Fuentes: Naciones Unidas (1953), índice y lista de cuentas y cuadros; Eurostat (1979), prólogo y apartados 101-139 (en especial 102, 105-109, 117 y 125).
% Generar con: bash Code/generar_figura.sh SCN_SEC_primeros
\providecommand{\tema}[1]{{\upshape\setlength{\fboxsep}{0.8pt}\fcolorbox{black!40}{white}{\color{black!75}#1}}}%
\providecommand{\aus}[1]{{\color{black!55}\itshape #1}}%
\providecommand{\sub}[1]{{\leftskip=1em #1\par}}%
\providecommand{\dif}[2]{{\hangindent=0.9em\hangafter=1 $\neq$\,#1 $\Rightarrow$ \textit{#2}\par}}%
\providecommand{\difs}[1]{{\hangindent=0.9em\hangafter=1 $\neq$\,#1\par}}%
\providecommand{\subdif}[2]{{\leftskip=1em\hangindent=0.9em\hangafter=1 $\neq$\,#1 $\Rightarrow$ \textit{#2}\par}}%
\providecommand{\imp}[1]{{\hangindent=0.9em\hangafter=1 $\Rightarrow$ \textit{#1}\par}}%
\providecommand{\difl}[2]{$\neq$\,#1 $\Rightarrow$ \textit{#2}}%
\begin{tikzpicture}[
  font=\footnotesize,
  cab/.style={draw=#1!55!black, fill=#1!10, rounded corners=2pt, text width=7.588cm, minimum height=1.55cm, align=center, inner sep=3pt, anchor=north west,
    execute at begin node={\hyphenpenalty=10000}},
  txt/.style={text width=#1, align=left, inner sep=3pt, anchor=north west,
    execute at begin node={\hyphenpenalty=10000\parindent=0pt}},
  marco/.style={draw=black!40, rounded corners=2pt},
  ausente/.style={draw=black!35, dashed, rounded corners=2pt},
  linea/.style={black!45},
  lineaaus/.style={black!35, dashed},
  flecha/.style={black!45, -{Latex[length=1.4mm]}},
  flechaaus/.style={black!35, dashed, -{Latex[length=1.4mm]}}]
  % Ejes de cada panel: centro, rama institucional (izquierda) y rama funcional (derecha)
  \coordinate (cA) at (3.9,0);   \coordinate (lA) at (2.2,0);   \coordinate (rA) at (6.2,0);
  \coordinate (cB) at (12.05,0); \coordinate (lB) at (10.35,0); \coordinate (rB) at (14.35,0);
  % Sistema
  \node[cab=blue] (hA) at (0,0) {\textbf{\small SCN 1953}\\ Naciones Unidas\\ recomendación internacional};
  \node[cab=violet] (hB) at (8.15,0) {\textbf{\small SEC 1970} (2.ª edición, 1979)\\ Comunidades Europeas $\cdot$ documento de trabajo\\
    \difl{versión comunitaria del SCN 1968, con conceptos más precisos}{cifras más comparables entre países}};
  \path let \p1=(hA.south), \p2=(hB.south) in coordinate (y0) at (0,{min(\y1,\y2)});
  \coordinate (r1) at ($(y0)+(0,-0.5)$); \coordinate (m0) at ($(y0)!0.5!(r1)$);
  % Clasificaciones de las unidades
  \node[txt=4.188cm] (a1) at ($(r1)+(0,0)$) {\textbf{Clasificación institucional}\hfill\tema{3.A.30}\par
    3 sectores residentes:\par
    empresas\par
    hogares e instituciones privadas sin fines de lucro\par
    gobierno general*\par
    y el resto del mundo \tema{3.B.11}};
  \node[txt=2.988cm] (a2) at ($(r1)+(4.6,0)$) {\textbf{Clasificación funcional*}\par
    \aus{no hay unidades de producción: el origen industrial del producto interior, al coste de los factores, solo aparece en un cuadro}};
  \node[txt=4.188cm] (b1) at ($(r1)+(8.15,0)$) {\textbf{Clasificación institucional}\hfill\tema{3.A.30}\par
    unidades institucionales $\to$ 7 sectores:\par
    S10 sociedades y cuasisociedades no financieras\par
    \dif{S40 instituciones de crédito $\cdot$ S50 empresas de seguro}{cuentas financieras separadas de la banca central y de los demás subsectores del crédito}
    S60 administraciones públicas \tema{4.B.23}\par
    \sub{central $\cdot$ local $\cdot$ seguridad social}
    \difs{S70 instituciones privadas sin fines de lucro, aparte de los hogares}
    S80 hogares\par
    S90 resto del mundo \tema{3.B.11}\par
    \subdif{S91 países de las Comunidades $\cdot$ S92 instituciones comunitarias $\cdot$ S93 terceros países (propio del SEC)}{las relaciones con la Comunidad, por separado}};
  \node[txt=2.988cm] (b2) at ($(r1)+(12.75,0)$) {\textbf{Clasificación funcional*}\hfill\tema{3.A.31}\par
    \dif{unidades de producción homogénea $\to$ ramas}{la producción se analiza al margen del marco institucional}
    \difs{nomenclatura NACE/CLIO (propia del SEC)}};
  \path let \p1=(a1.south), \p2=(a2.south), \p3=(b1.south), \p4=(b2.south) in coordinate (s1) at (0,{min(\y1,\y2,\y3,\y4)});
  \coordinate (r2) at ($(s1)+(0,-0.5)$); \coordinate (m1) at ($(s1)!0.5!(r2)$);
  % Operaciones
  \node[txt=7.588cm] (a3) at ($(r2)+(0,0)$) {\textbf{Operaciones}: \aus{sin clasificación propia}: cada flujo se define en la cuenta en que aparece};
  \node[txt=7.588cm] (b3) at ($(r2)+(8.15,0)$) {\textbf{Operaciones}\par
    \dif{una sola clasificación, común a ramas y sectores: P bienes y servicios $\cdot$ R distributivas* $\cdot$ F financieras}{lo que se registra por ramas y por sectores (p. ej., las subvenciones) suma lo mismo}};
  \path let \p1=(a3.south), \p2=(b3.south) in coordinate (s2) at (0,{min(\y1,\y2)});
  \coordinate (r3) at ($(s2)+(0,-0.5)$); \coordinate (m2) at ($(s2)!0.5!(r3)$);
  % Cuentas
  \node[txt=4.188cm] (a4) at ($(r3)+(0,0)$) {\textbf{Cuentas de la nación y de los sectores}\par
    6 cuentas estándar:\hfill\tema{3.A.30}\par
    1 producto interior $\cdot$ 2 renta nacional\par
    3 formación interior de capital\par
    4 hogares e instituciones privadas sin fines de lucro\par
    5 gobierno general $\cdot$ 6 transacciones exteriores \tema{3.B.11}\par
    (4 a 6: cuenta corriente y de conciliación del capital)\par
    \aus{sin cuenta financiera ni balances}};
  \node[txt=2.988cm] (a5) at ($(r3)+(4.6,0)$) {\textbf{Cuentas por ramas}\par
    \aus{no existen}};
  \node[txt=4.188cm] (b4) at ($(r3)+(8.15,0)$) {\textbf{Cuentas de los sectores}\hfill\tema{3.A.30}\par
    producción $\cdot$ generación, distribución y utilización de la renta $\cdot$ capital\par
    \dif{cuenta financiera (SCN 1968)}{análisis de los sistemas monetario y financiero}
    \aus{sin balances: solo registra operaciones, a diferencia del SCN 1968}};
  \node[txt=2.988cm] (b5) at ($(r3)+(12.75,0)$) {\textbf{Cuentas por ramas}\par
    \dif{bienes y servicios, producción y generación de la renta, que forman la tabla input-output (SCN 1968) \tema{3.A.31}}{más información sobre la producción; por ramas solo se llega al excedente de explotación}};
  \path let \p1=(a4.south), \p2=(a5.south), \p3=(b4.south), \p4=(b5.south) in coordinate (s3) at (0,{min(\y1,\y2,\y3,\y4)});
  \coordinate (r4) at ($(s3)+(0,-0.55)$);
  % Aparte del esquema básico: cuadros y extensiones
  \node[txt=7.588cm] (a6) at ($(r4)+(0,0)$) {\textbf{+ Cuadros y extensiones}\par
    12 cuadros estándar (gasto, origen industrial del producto, distribución de la renta, sector exterior\dots)\par
    \aus{sin tablas input-output}};
  \node[txt=7.588cm] (b6) at ($(r4)+(8.15,0)$) {\textbf{+ Cuadros y extensiones}\par
    cuadros estándar: población ocupada, consumo de los hogares y gasto de las AAPP por finalidades* \tema{4.B.23}};
  \path let \p1=(a6.south), \p2=(b6.south) in coordinate (s4) at (0,{min(\y1,\y2)});
  % Marcos de igual altura en cada fila (discontinuos: todavía no existe)
  \foreach \n/\s/\e in {a1/s1/marco,a2/s1/ausente,b1/s1/marco,b2/s1/marco,a3/s2/marco,b3/s2/marco,a4/s3/marco,a5/s3/ausente,b4/s3/marco,b5/s3/marco,a6/s4/marco,b6/s4/marco}
    \draw[\e] (\n.north west) rectangle (\n.east |- \s);
  % Flujo del SCN 1953: la rama funcional y las cuentas por ramas no existen
  \draw[linea] (cA |- y0) -- (cA |- m0);
  \draw[linea] (lA |- m0) -- (cA |- m0);   \draw[lineaaus] (cA |- m0) -- (rA |- m0);
  \draw[flecha] (lA |- m0) -- (lA |- r1);  \draw[flechaaus] (rA |- m0) -- (rA |- r1);
  \draw[linea] (lA |- s1) -- (lA |- m1);   \draw[lineaaus] (rA |- s1) -- (rA |- m1);
  \draw[linea] (lA |- m1) -- (cA |- m1);   \draw[lineaaus] (cA |- m1) -- (rA |- m1);
  \draw[flecha] (cA |- m1) -- (cA |- r2);
  \draw[linea] (cA |- s2) -- (cA |- m2);
  \draw[linea] (lA |- m2) -- (cA |- m2);   \draw[lineaaus] (cA |- m2) -- (rA |- m2);
  \draw[flecha] (lA |- m2) -- (lA |- r3);  \draw[flechaaus] (rA |- m2) -- (rA |- r3);
  % Flujo del SEC 1970: completo
  \draw[linea] (cB |- y0) -- (cB |- m0);
  \draw[linea] (lB |- m0) -- (rB |- m0);
  \draw[flecha] (lB |- m0) -- (lB |- r1);  \draw[flecha] (rB |- m0) -- (rB |- r1);
  \draw[linea] (lB |- s1) -- (lB |- m1);   \draw[linea] (rB |- s1) -- (rB |- m1);
  \draw[linea] (lB |- m1) -- (rB |- m1);
  \draw[flecha] (cB |- m1) -- (cB |- r2);
  \draw[linea] (cB |- s2) -- (cB |- m2);
  \draw[linea] (lB |- m2) -- (rB |- m2);
  \draw[flecha] (lB |- m2) -- (lB |- r3);  \draw[flecha] (rB |- m2) -- (rB |- r3);
  % Separación del esquema básico
  \draw[black!40, dashed] ($(s3)+(0,-0.275)$) -- ++(15.95,0);
  % Leyenda
  \node[anchor=north west, text width=15.95cm, align=left, inner sep=0pt, font=\footnotesize,
    execute at begin node={\hyphenpenalty=10000}] at ($(s4)+(0,-0.3)$) {
    $\neq$ diferencia del SEC 1970 respecto al SCN 1953 \quad $\Rightarrow$ \textit{implicación} \quad \aus{gris} y marco discontinuo: todavía no existe \quad \tema{3.A.31} tema en que se trata\\[2pt]
    El SEC 1970 es la versión comunitaria del SCN 1968: de él toma, entre otras cosas, la tabla input-output y la cuenta financiera; son propias del SEC la división del resto del mundo y la NACE/CLIO.
    \textit{Cuadros}: traducción de \textit{tables}; presentan los datos en forma de matriz.\\[2pt]
    * \textit{Gobierno general}: administraciones públicas en el SEC y en el temario. \textit{Clasificación funcional}: por ramas de actividad, no la del gasto público.
    \textit{R distributivas}: hoy, operaciones de distribución (D). \textit{Finalidades de las AAPP}: hoy, la COFOG.};
\end{tikzpicture}%
