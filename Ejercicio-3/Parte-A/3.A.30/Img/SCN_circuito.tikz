% Figura: el circuito económico que describe la sucesión de cuentas del SCN/SEC.
% Fuente de SCN_circuito.pdf. Cada flecha lleva el saldo con el que una cuenta pasa a la siguiente.
\begin{tikzpicture}[>=stealth, node distance=0.55cm and 2.0cm,
  cta/.style={draw=black!75, line width=0.6pt, rounded corners=2pt, fill=#1, minimum width=2.55cm, minimum height=1.05cm, align=center, font=\small},
  cta/.default=blue!8,
  sal/.style={font=\footnotesize\itshape, align=center, text=black!80},
  flecha/.style={->, line width=0.9pt, black!70}]
  % Fila superior: cuentas corrientes
  \node[cta] (prod) {Producción};
  \node[cta, right=of prod] (gen) {Generación\\ de la renta};
  \node[cta, right=of gen] (asig) {Asignación de la\\ renta primaria};
  \node[cta, right=of asig] (dist) {Distribución\\ secundaria};
  % Fila inferior: utilización y acumulación
  \node[cta, below=2.1cm of dist] (util) {Utilización\\ de la renta};
  \node[cta=red!8, left=of util] (cap) {Cuenta\\ de capital};
  \node[cta=red!8, left=of cap] (fin) {Cuenta\\ financiera};
  \node[cta=teal!10, left=of fin] (bal) {Balances\\ (stocks)};
  % Saldos
  \draw[flecha] (prod) -- node[sal, above=2pt] {valor\\ añadido} (gen);
  \draw[flecha] (gen) -- node[sal, above=2pt] {excedente\\ y renta mixta} (asig);
  \draw[flecha] (asig) -- node[sal, above=2pt] {saldo de rentas\\ primarias} (dist);
  \draw[flecha] (dist) -- node[sal, right=3pt] {renta\\ disponible} (util);
  \draw[flecha] (util) -- node[sal, below=2pt] {ahorro} (cap);
  \draw[flecha] (cap) -- node[sal, below=2pt] {capacidad o\\ necesidad de\\ financiación} (fin);
  \draw[flecha] (fin) -- node[sal, below=2pt] {variación\\ de activos\\ y pasivos} (bal);
  % Retroalimentación: el gasto vuelve a la producción
  \coordinate (alto) at ([yshift=-0.55cm]prod.south);
  \coordinate (bajo) at ([yshift=-1.15cm]prod.south);
  \draw[->, line width=0.9pt, dashed, blue!55!black] ([xshift=0.3cm]util.north west) |- ([xshift=0.4cm]prod.south |- alto)
    node[pos=0.72, sal, text=blue!55!black, above] {gasto en consumo final} -- ([xshift=0.4cm]prod.south);
  \draw[->, line width=0.9pt, dashed, blue!55!black] (cap.north) |- ([xshift=-0.4cm]prod.south |- bajo)
    node[pos=0.72, sal, text=blue!55!black, below] {formación de capital} -- ([xshift=-0.4cm]prod.south);
  % Resto del mundo
  \node[sal, text=black!65, above=0.55cm of asig] (rm) {Resto del mundo: importaciones, exportaciones, rentas y transferencias con no residentes};
  % Rótulos de grupos
  \draw[decorate, decoration={brace, amplitude=5pt}, black!60] ([yshift=1.15cm]prod.north west) -- ([yshift=1.15cm]dist.north east)
    node[midway, above=5pt, font=\small\bfseries] {Cuentas corrientes};
  \draw[decorate, decoration={brace, amplitude=5pt, mirror}, black!60] ([yshift=-1.15cm]fin.south west) -- ([yshift=-1.15cm]cap.south east)
    node[midway, below=5pt, font=\small\bfseries] {Cuentas de acumulación};
\end{tikzpicture}
