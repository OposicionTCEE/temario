% Figura: el principio de devengo. Una venta se registra en t, cuando se produce, aunque se cobre en t+1; la diferencia se registra como cuenta pendiente de cobro o pago (F.8).
% Fuente de SCN_devengo.pdf. Ejemplo abstracto con un importe x.
\begin{tikzpicture}[>=stealth,
  cj/.style={draw=black!65, rounded corners=3pt, fill=#1, align=left, font=\footnotesize, text width=5.4cm, inner sep=4pt},
  cj/.default=white]
  % Eje temporal
  \draw[->, line width=0.8pt] (-0.5,0) -- (14,0) node[right, font=\footnotesize] {tiempo};
  \foreach \x/\t in {2.9/{Periodo $t$: la empresa vende y entrega el bien}, 10.4/{Periodo $t+1$: el cliente paga}} {
    \fill[black!70] (\x,0) circle (2.5pt);
    \node[above=4pt, font=\small\bfseries, align=center] at (\x,0) {\t};
  }
  % Periodo t
  \node[cj=blue!8, anchor=north] (a1) at (2.9,-0.45) {\textbf{Cuentas corrientes}\\ vendedor: recurso $+x$ (producción vendida)\\ comprador: empleo $-x$ (consumo o inversión)};
  \node[cj=red!8, anchor=north] (a2) at ([yshift=-0.25cm]a1.south) {\textbf{Cuenta financiera}\\ vendedor: adquiere un derecho de cobro $x$\\ comprador: contrae una deuda de pago $x$\\ (otras cuentas pendientes de cobro y pago)};
  % Periodo t+1
  \node[cj=black!3, anchor=north, text=black!60] (b1) at (10.4,-0.45) {\textbf{Cuentas corrientes}\\ sin anotaciones: la renta y el gasto\\ ya se registraron en $t$};
  \node[cj=red!8, anchor=north] (b2) at ([yshift=-0.25cm]b1.south) {\textbf{Cuenta financiera}\\ vendedor: cambia el derecho por efectivo\\ comprador: cancela la deuda con efectivo\\ (solo cambia la composición de los activos)};
  \draw[->, dashed, line width=0.8pt, red!55!black] (a2.east) -- node[below=2pt, font=\scriptsize, text=red!55!black, align=center] {el derecho se\\ cancela al cobrar} (b2.west);
  \node[font=\footnotesize, align=center, text width=12.5cm, anchor=north] at ([yshift=-0.35cm]$(a2.south)!0.5!(b2.south)$)
    {Con criterio de caja, la operación se registraría en $t+1$: la renta y el gasto de $t$ dependerían de cuándo se paga, no de cuándo se produce.};
\end{tikzpicture}
