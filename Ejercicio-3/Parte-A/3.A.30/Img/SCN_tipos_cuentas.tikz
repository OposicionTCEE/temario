% Figura: los tres tipos de cuentas del SEC 2010 en forma de T, con sus dos lados y su saldo contable.
% Fuente de SCN_tipos_cuentas.pdf. Sustituye a la antigua imagen Cuentas_Anotaciones_Doble.png.
\begin{tikzpicture}[
  tit/.style={draw=black!75, line width=0.7pt, fill=#1, minimum width=5.2cm, minimum height=0.75cm, font=\small\bfseries, align=center},
  lado/.style={execute at begin node={\hyphenpenalty=10000}, minimum width=2.6cm, text width=2.5cm, align=center, font=\footnotesize},
  txt/.style={execute at begin node={\hyphenpenalty=10000}, text width=2.5cm, align=center, font=\scriptsize\itshape, text=black!75}]
  \foreach \x/\col/\t/\l/\r/\dl/\dr/\s in {
     0/blue!12/{Cuentas corrientes}/{Empleos\\ \phantom{x}}/{Recursos\\ \phantom{x}}/{operaciones que reducen el valor económico de la unidad}/{operaciones que aumentan el valor económico de la unidad}/{saldo: valor añadido, renta, ahorro},
     5.9/red!12/{Cuentas de acumulación}/{Variación\\ de activos}/{Variación de pasivos\\ y patrimonio neto}/{adquisiciones netas de activos no financieros y financieros}/{contracción neta de pasivos y variación del patrimonio neto}/{saldo: capacidad o necesidad de financiación},
     11.8/teal!12/{Balances}/{Activos\\ \phantom{x}}/{Pasivos y\\ patrimonio neto}/{stock de activos en un momento dado}/{stock de pasivos; el patrimonio neto es el saldo}/{saldo: patrimonio neto}} {
    \node[tit=\col] (t) at (\x,0) {\t};
    \node[lado, anchor=north east] (l) at ([yshift=-0.1cm]t.south) {\textbf{\l}};
    \node[lado, anchor=north west] (r) at ([yshift=-0.1cm]t.south) {\textbf{\r}};
    \draw[line width=0.8pt] ([xshift=-2.6cm, yshift=-1.05cm]t.south) -- ([xshift=2.6cm, yshift=-1.05cm]t.south);
    \draw[line width=0.8pt] ([yshift=-1.05cm]t.south) -- ([yshift=-2.75cm]t.south);
    \node[txt, anchor=north] at ([xshift=-1.3cm, yshift=-1.15cm]t.south) {\dl};
    \node[txt, anchor=north] at ([xshift=1.3cm, yshift=-1.15cm]t.south) {\dr};
    \node[font=\footnotesize, text=black!80, anchor=north, text width=5cm, align=center] at ([yshift=-2.85cm]t.south) {\s};
  }
  \node[font=\footnotesize, text=black!70] at (2.95,-4.15) {flujos durante el periodo};
  \draw[decorate, decoration={brace, amplitude=4pt, mirror}, black!55] (-2.6,-3.85) -- (8.5,-3.85);
  \node[font=\footnotesize, text=black!70] at (11.8,-4.15) {stocks al inicio y al final};
\end{tikzpicture}
