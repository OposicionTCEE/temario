% Figura: la matriz de transacciones vacía del bloque 2 (convención de GODLEY y LAVOIE, 2007, sobre las columnas del cuadro de cuentas económicas integradas del SEC 2010).
% Fuente de SCN_matriz_vacia.pdf. Cada banda de filas es una cuenta; debajo de su nombre, el saldo que la cierra.
\providecommand{\cta}[2]{\shortstack[l]{\textbf{#1}\\ \textcolor{black!65}{\scriptsize\itshape #2}}}
\begin{tikzpicture}[>=stealth,
  c/.style={draw=black!70, line width=0.5pt, minimum width=1.75cm, minimum height=0.95cm, font=\small, align=center, anchor=center},
  h/.style={c, fill=black!6, font=\footnotesize\bfseries, minimum height=1.25cm},
  ht/.style={h, fill=black!16},
  f/.style={c, text width=5.0cm, minimum width=5.3cm, font=\footnotesize, align=left, fill=black!3},
  cor/.style={c, fill=blue!7}, acu/.style={c, fill=red!8},
  tot/.style={c, fill=black!12}, cero/.style={c, fill=white, text=black!55, minimum width=0.9cm},
  sig/.style={h, minimum width=0.9cm},
  sal/.style={font=\scriptsize\itshape, text=black!65}]
  \matrix (m) [matrix of nodes, column sep=-0.5pt, row sep=-0.5pt, nodes in empty cells]
  {
    |[f, fill=white, draw=none]| &
    |[h]| \shortstack{Hogares\\ e ISFLSH\\ {\scriptsize\mdseries(S.14+S.15)}} &
    |[h]| \shortstack{Sociedades\\ {\scriptsize\mdseries(S.11+S.12)}} &
    |[h]| \shortstack{AAPP\\ {\scriptsize\mdseries(S.13)}} &
    |[ht]| \shortstack{Total\\ economía\\ {\scriptsize\mdseries(S.1)}} &
    |[h]| \shortstack{Resto\\ del mundo\\ {\scriptsize\mdseries(S.2)}} &
    |[h]| \shortstack{Bienes y\\ servicios\\ {\scriptsize\mdseries(0)}} &
    |[sig]| $\Sigma$ \\
    |[f]| \cta{I. Producción {\scriptsize(y V.I)}}{cierra con: valor añadido} & |[cor]| & |[cor]| & |[cor]| & |[tot]| & |[cor]| & |[cor]| & |[cero]| $0$ \\
    |[f]| \cta{II.1.1. Explotación}{cierra con: excedente de explotación} & |[cor]| & |[cor]| & |[cor]| & |[tot]| & |[cor]| & |[cor]| & |[cero]| $0$ \\
    |[f]| \cta{II.1.2. Asignación de la renta primaria}{cierra con: saldo de rentas primarias} & |[cor]| & |[cor]| & |[cor]| & |[tot]| & |[cor]| & |[cor]| & |[cero]| $0$ \\
    |[f]| \cta{II.2. Distribución secundaria}{cierra con: renta disponible} & |[cor]| & |[cor]| & |[cor]| & |[tot]| & |[cor]| & |[cor]| & |[cero]| $0$ \\
    |[f]| \cta{II.3. Redistribución en especie}{cierra con: renta disponible ajustada} & |[cor]| & |[cor]| & |[cor]| & |[tot]| & |[cor]| & |[cor]| & |[cero]| $0$ \\
    |[f]| \cta{II.4. Utilización de la renta}{cierra con: ahorro} & |[cor]| & |[cor]| & |[cor]| & |[tot]| & |[cor]| & |[cor]| & |[cero]| $0$ \\
    |[f]| \cta{III.1. Capital}{cierra con: capacidad o necesidad de financiación} & |[acu]| & |[acu]| & |[acu]| & |[tot]| & |[acu]| & |[acu]| & |[cero]| $0$ \\
    |[f]| \cta{III.2. Financiera}{cierra cada columna en cero} & |[acu]| & |[acu]| & |[acu]| & |[tot]| & |[acu]| & |[acu]| & |[cero]| $0$ \\
    |[f, fill=black!6]| \textbf{$\Sigma$} & |[cero, minimum width=1.75cm]| $0$ & |[cero, minimum width=1.75cm]| $0$ & |[cero, minimum width=1.75cm]| $0$ & |[cero, minimum width=1.75cm, fill=black!12]| $0$ & |[cero, minimum width=1.75cm]| $0$ & |[cero, minimum width=1.75cm]| $0$ & |[cero]| $0$ \\
  };
  % Agrupación de las cuentas
  \draw[decorate, decoration={brace, amplitude=5pt, mirror}, line width=0.8pt, blue!55!black]
    ([xshift=-0.15cm]m-2-1.north west) -- ([xshift=-0.15cm]m-7-1.south west)
    node[midway, xshift=-0.45cm, font=\footnotesize\bfseries, text=blue!55!black, rotate=90] {Cuentas corrientes};
  \draw[decorate, decoration={brace, amplitude=5pt, mirror}, line width=0.8pt, red!55!black]
    ([xshift=-0.15cm]m-8-1.north west) -- ([xshift=-0.15cm]m-9-1.south west)
    node[midway, xshift=-0.45cm, font=\footnotesize\bfseries, text=red!55!black, rotate=90] {Acumulación};
  % Encadenamiento de los saldos
  \draw[->, line width=1.0pt, black!60] ([xshift=0.2cm]m-2-8.east) to[bend left=35]
    node[right, font=\scriptsize, text=black!70, align=left, execute at begin node={\hyphenpenalty=10000}] {el saldo de cada\\ cuenta abre\\ la siguiente} ([xshift=0.2cm]m-3-8.east);
  \draw[->, line width=1.0pt, black!60] ([xshift=0.2cm]m-7-8.east) to[bend left=35] ([xshift=0.2cm]m-8-8.east);
  \draw[->, line width=1.0pt, black!60] ([xshift=0.2cm]m-8-8.east) to[bend left=35] ([xshift=0.2cm]m-9-8.east);
  % Reglas de lectura
  \node[font=\scriptsize, text=black!75, anchor=north west, align=left, text width=15.3cm, execute at begin node={\hyphenpenalty=10000}] at ([yshift=-0.25cm]m-10-1.south west)
    {Signo $+$: recurso o fuente de fondos; signo $-$: empleo o uso de fondos. En la columna de bienes y servicios, al revés: la oferta con $-$ y los usos con $+$.\\
     Cada fila suma cero: Hogares $+$ Sociedades $+$ AAPP $+$ Resto del mundo $+$ Bienes y servicios $=0$. El total de la economía (sombreado) es la suma de los tres sectores residentes y no entra en $\Sigma$.};
\end{tikzpicture}
