% Figura: bloque de filas de la cuenta de asignación de la renta primaria (II.1.2). Las rentas se anotan del lado de quien las cobra.
% Fuente de SCN_asignacion_primaria.pdf. Convención de GODLEY y LAVOIE (2007) sobre las columnas del cuadro de cuentas económicas integradas del SEC 2010.
\providecommand{\op}[2]{\shortstack[l]{\textbf{#1}\\ \textcolor{black!65}{\scriptsize #2}}}
\begin{tikzpicture}[>=stealth,
  c/.style={draw=black!70, line width=0.5pt, minimum width=1.75cm, minimum height=0.95cm, font=\small, align=center, anchor=center},
  h/.style={c, fill=black!6, font=\footnotesize\bfseries, minimum height=1.25cm},
  ht/.style={h, fill=black!16},
  f/.style={c, text width=5.0cm, minimum width=5.3cm, font=\footnotesize, align=left, fill=black!3},
  cor/.style={c, fill=blue!7}, ext/.style={c, fill=green!8, font=\footnotesize},
  tot/.style={c, fill=black!12}, vac/.style={c, fill=white},
  cero/.style={c, fill=white, text=black!55, minimum width=1.3cm},
  pen/.style={c, fill=white, text=black!45, font=\scriptsize\itshape, minimum width=1.3cm},
  sig/.style={h, minimum width=1.3cm},
  ab/.style={c, fill=blue!3, text=black!70},
  sal/.style={c, fill=blue!18, font=\small\bfseries},
  salt/.style={sal, fill=black!22}]
  \matrix (m) [matrix of nodes, column sep=-0.5pt, row sep=-0.5pt, nodes in empty cells]
  {
    |[f, fill=white, draw=none]| &
    |[h]| \shortstack{Hogares\\ e ISFLSH} &
    |[h]| Sociedades &
    |[h]| AAPP &
    |[ht]| \shortstack{Total\\ economía} &
    |[h]| \shortstack{Resto\\ del mundo} &
    |[h]| \shortstack{Bienes y\\ servicios} &
    |[sig]| $\Sigma$ \\
    |[f, fill=blue!3]| \op{Abre con: excedente y renta mixta}{saldo de la cuenta de explotación} & |[ab]| \shortstack{$+EBE_H$\\ $+RMB_H$} & |[ab]| $+EBE_S$ & |[ab]| $+EBE_G$ & |[ab, fill=black!8]| \shortstack{$+EBE$\\ $+RMB$} & |[vac]| & |[vac]| & |[cero]| \\
    |[f]| \op{Remuneración de asalariados}{D.1, nacional: del lado de quien la cobra} & |[cor]| $+W^{N}$ & |[vac]| & |[vac]| & |[tot]| $+W^{N}$ & |[ext]| \shortstack{$+(W$\\ $-W^{N})$} & |[vac]| & |[pen]| $0$ con II.1.1 \\
    |[f]| \op{Impuestos netos sobre la producción}{y las importaciones (D.2 $-$ D.3)} & |[vac]| & |[vac]| & |[cor]| $+T^{N}$ & |[tot]| $+T^{N}$ & |[ext]| \shortstack{$+(T_p+T_q$\\ $-T^{N})$} & |[vac]| & |[pen]| $0$ con II.1.1 \\
    |[f]| \op{Rentas de la propiedad}{D.4, netas: cobradas menos pagadas} & |[cor]| $+RP_H$ & |[cor]| $\pm RP_S$ & |[cor]| $-RP_G$ & |[tot]| $\pm RP$ & |[ext]| $\pm RP_{RM}$ & |[vac]| & |[cero]| $0$ \\
    |[f, fill=blue!18]| \op{Saldo}{saldo de rentas primarias (B.5b)} & |[sal]| $SRP_H$ & |[sal]| $SRP_S$ & |[sal]| $SRP_G$ & |[salt]| $RNB$ & |[sal, fill=green!16]| $-RPN$ & |[vac]| & |[cero]| \\
  };
  \draw[line width=1.2pt, black!75] (m-6-1.north west) -- (m-6-8.north east);
  \draw[->, line width=1.0pt, black!60] ([yshift=-0.2cm]m-6-5.south) -- ++(0,-0.6)
    node[below, font=\scriptsize, text=black!75, align=center] {$RNB=PIB+RPN$\\ (la RNB es el saldo de rentas primarias del total)};
  \node[font=\scriptsize, text=black!75, anchor=north west, align=left, text width=15.6cm, execute at begin node={\hyphenpenalty=10000}] at ([yshift=-1.7cm]m-6-1.south west)
    {$W^{N}$ y $T^{N}$: remuneración de asalariados e impuestos netos que cobran las unidades residentes (ámbito nacional). La columna del resto del mundo recoge, desde su punto de vista, lo que los residentes le pagan menos lo que le cobran: los salarios de los no residentes, los impuestos y subvenciones de las instituciones de la Unión y las rentas de la propiedad.\\
     $RPN$: rentas primarias netas recibidas del resto del mundo por los residentes (las cobradas menos las pagadas). Es la diferencia entre la RNB y el PIB.};
\end{tikzpicture}
