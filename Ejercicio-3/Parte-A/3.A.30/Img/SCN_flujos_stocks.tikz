% Figura: relación entre stocks y flujos en el SEC 2010. Los flujos del periodo explican la diferencia entre el balance inicial y el final.
% Fuente de SCN_flujos_stocks.pdf. Sustituye a la antigua imagen Flujo_Stock.png.
\begin{tikzpicture}[>=stealth,
  stock/.style={draw=black!75, line width=0.7pt, fill=teal!10, align=center, font=\small, minimum width=2.6cm, minimum height=1.6cm},
  flujo/.style={draw=black!60, rounded corners=3pt, fill=#1, align=center, font=\footnotesize, text width=4.4cm, execute at begin node={\hyphenpenalty=10000}, minimum height=0.95cm},
  flujo/.default=blue!8,
  fl/.style={->, line width=0.8pt, black!70}]
  \node[stock] (bi) at (0,0) {\textbf{Balance inicial}\\[2pt] activos\\ pasivos\\ patrimonio neto};
  \node[stock] (bf) at (10.2,0) {\textbf{Balance final}\\[2pt] activos\\ pasivos\\ patrimonio neto};
  \node[flujo] (op) at (5.1,1.35) {\textbf{Operaciones} (entre unidades)\\ cuentas de capital y financiera};
  \node[flujo=orange!12] (ov) at (5.1,0) {\textbf{Otras variaciones del volumen}\\ catástrofes, descubrimientos, reclasificaciones};
  \node[flujo=orange!12] (rv) at (5.1,-1.35) {\textbf{Revalorización}\\ ganancias y pérdidas de posesión};
  \foreach \f in {op, ov, rv} { \draw[fl] (bi.east) -- (\f.west); \draw[fl] (\f.east) -- (bf.west); }
  % Eje temporal
  \draw[->, line width=0.6pt, black!60] (-1.3,-2.75) -- (11.5,-2.75) node[right, font=\footnotesize] {tiempo};
  \draw[black!60] (0,-2.65) -- (0,-2.85) node[below, font=\footnotesize] {inicio del periodo (stock)};
  \draw[black!60] (10.2,-2.65) -- (10.2,-2.85) node[below, font=\footnotesize] {final del periodo (stock)};
  \draw[decorate, decoration={brace, amplitude=4pt, mirror}, black!60] (0.3,-2.05) -- (9.9,-2.05)
    node[midway, below=4pt, font=\footnotesize] {flujos durante el periodo};
  \node[font=\footnotesize, text=blue!45!black] at (5.1,2.3) {transacciones entre unidades};
\end{tikzpicture}
