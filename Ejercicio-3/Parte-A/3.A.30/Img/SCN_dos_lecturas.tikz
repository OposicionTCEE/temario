% Figura: las dos lecturas de la columna de bienes y servicios (PIB por la producción y por el gasto), en tres paneles.
% Fuente de SCN_dos_lecturas.pdf. Cuenta de bienes y servicios del SEC 2010 (apartados 8.80, 8.81 y 8.89); convención de signos de GODLEY y LAVOIE (2007).
\begin{tikzpicture}[>=stealth, font=\footnotesize,
  bx/.style={draw=black!70, line width=0.5pt, minimum height=0.62cm, minimum width=1.0cm, inner sep=1pt, anchor=center},
  of/.style={bx, fill=blue!9},
  us/.style={bx, fill=green!12},
  mv/.style={line width=1.2pt, draw=black!85},
  cl/.style={draw=black!70, line width=0.5pt, minimum height=0.62cm, minimum width=1.3cm, inner sep=1pt, anchor=center},
  lb/.style={draw=black!70, line width=0.5pt, fill=black!3, minimum height=0.62cm, text width=4.3cm, align=left, inner sep=2pt, anchor=center},
  hd/.style={draw=black!70, line width=0.5pt, fill=black!8, minimum height=0.9cm, font=\footnotesize\bfseries, inner sep=2pt, anchor=center},
  tit/.style={font=\footnotesize\bfseries, anchor=west, inner sep=0pt},
  br/.style={decorate, decoration={brace, amplitude=4pt}, line width=0.6pt, black!60},
  nt/.style={font=\footnotesize, text=black!75, align=center}]

  % ---------- Panel (a): la columna de la matriz ----------
  \node[tit] at (0,0) {(a) La columna de bienes y servicios suma cero};
  \matrix (a) [matrix of nodes, column sep=-0.5pt, row sep=-0.5pt, nodes in empty cells, anchor=north west] at (0,-0.3)
  {
    |[hd, text width=4.3cm, align=left]| Operación & |[hd, minimum width=1.3cm]| \shortstack{Bienes y\\ servicios} \\
    |[lb]| Producción (P.1) & |[cl, fill=blue!9]| $-VP$ \\
    |[lb]| Importaciones (P.7) & |[cl, fill=blue!9, mv]| $-M$ \\
    |[lb]| Impuestos netos sobre productos & |[cl, fill=blue!9]| $-T_p$ \\
    |[lb]| Consumos intermedios (P.2) & |[cl, fill=green!12, mv]| $+CI$ \\
    |[lb]| Gasto en consumo final (P.3) & |[cl, fill=green!12]| $+C$ \\
    |[lb]| Formación bruta de capital (P.5) & |[cl, fill=green!12]| $+FBC$ \\
    |[lb]| Exportaciones (P.6) & |[cl, fill=green!12]| $+X$ \\
    |[lb, fill=black!12]| \textbf{Suma de la columna} & |[cl, fill=black!12]| $\mathbf{0}$ \\
  };
  \draw[br] ([xshift=3pt]a-2-2.north east) -- ([xshift=3pt]a-4-2.south east)
    node[midway, right=6pt, nt, align=left] {oferta\\ ($-$)};
  \draw[br] ([xshift=3pt]a-5-2.north east) -- ([xshift=3pt]a-8-2.south east)
    node[midway, right=6pt, nt, align=left] {usos\\ ($+$)};

  % ---------- Panel (b): la identidad entre oferta y usos ----------
  \node[tit] at (7.1,0) {(b) Oferta total $=$ usos totales};
  \node[of] (b1) at (7.60,-0.95) {$VP$};
  \node[of, mv] (b2) at (8.68,-0.95) {$+\,M$};
  \node[of] (b3) at (9.76,-0.95) {$+\,T_p$};
  \node at (10.46,-0.95) {$=$};
  \node[us, mv] (b4) at (11.16,-0.95) {$CI$};
  \node[us] (b5) at (12.24,-0.95) {$+\,C$};
  \node[us] (b6) at (13.32,-0.95) {$+\,FBC$};
  \node[us] (b7) at (14.40,-0.95) {$+\,X$};
  \draw[br] ([yshift=-3pt]b3.south east) -- ([yshift=-3pt]b1.south west) node[midway, below=5pt, nt] {oferta\\ (a precios de adquisición)};
  \draw[br] ([yshift=-3pt]b7.south east) -- ([yshift=-3pt]b4.south west) node[midway, below=5pt, nt] {usos intermedios y finales\\ (a precios de adquisición)};

  % ---------- Paso de (b) a (c) ----------
  \draw[->, line width=1.0pt, black!60] (10.46,-2.35) -- (10.46,-3.0)
    node[midway, right=4pt, nt, align=left] {se restan $CI$ y $M$ a los dos lados:\\ cada uno pasa al otro lado con signo negativo};

  % ---------- Panel (c): las dos lecturas ----------
  \node[tit] at (7.1,-3.35) {(c) Dos lecturas de la misma igualdad};
  \node[of] (c1) at (7.60,-4.30) {$VP$};
  \node[us, mv] (c2) at (8.68,-4.30) {$-\,CI$};
  \node[of] (c3) at (9.76,-4.30) {$+\,T_p$};
  \node at (10.46,-4.30) {$=$};
  \node[us] (c4) at (11.16,-4.30) {$C$};
  \node[us] (c5) at (12.24,-4.30) {$+\,FBC$};
  \node[us] (c6) at (13.32,-4.30) {$+\,X$};
  \node[of, mv] (c7) at (14.40,-4.30) {$-\,M$};
  \draw[br] ([yshift=-3pt]c3.south east) -- ([yshift=-3pt]c1.south west) node[midway, below=5pt, nt] {\textbf{PIB por la producción}\\ $=\sum VAB+T_p$};
  \draw[br] ([yshift=-3pt]c7.south east) -- ([yshift=-3pt]c4.south west) node[midway, below=5pt, nt] {\textbf{PIB por el gasto}\\ $=C+FBC+(X-M)$};

  % ---------- Leyenda ----------
  \node[anchor=north west, font=\footnotesize, text=black!75, text width=8.2cm, align=left, inner sep=0pt,
        execute at begin node={\hyphenpenalty=10000}] at (7.1,-5.95)
    {Azul: oferta de productos; verde: sus usos. La matriz los anota con el signo cambiado respecto a las cuentas de los sectores, como la cuenta de bienes y servicios del SEC. En borde grueso, los dos términos que cambian de lado.};
\end{tikzpicture}
