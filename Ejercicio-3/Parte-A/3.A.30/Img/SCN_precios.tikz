% Figura: escalera de precios: del coste de producción al precio de adquisición, con los impuestos, subvenciones y márgenes que entran en cada escalón.
% Definiciones: SEC 2010, 3.05, 3.06 y 3.44 (precios básicos y de adquisición); SCN 2008, 6.51 y 6.64 (precio de productor y de adquisición).
% Rótulos cortos en las cajas; la leyenda de la derecha explica cada color. Sustituye a las antiguas Impuestos_Producción.png e Impuestos_Subvenciones_Tipos.png.
% Generar con: bash Code/generar_figura.sh SCN_precios
\colorlet{cpro}{blue!16}%
\colorlet{cprd}{red!14}%
\colorlet{cmar}{orange!20}%
\colorlet{civa}{red!30}%
\begin{tikzpicture}[
  bl/.style={draw=black!65, line width=0.5pt, fill=#1, minimum width=2.6cm, text width=2.5cm, align=center, font=\footnotesize, inner sep=1pt,
    anchor=south, execute at begin node={\hyphenpenalty=10000}},
  fino/.style={bl=#1, minimum height=0.55cm},
  et/.style={font=\footnotesize\bfseries, align=center},
  cuad/.style={draw=black!50, fill=#1, minimum size=0.3cm, inner sep=0pt},
  ley/.style={anchor=north west, text width=4.0cm, align=left, font=\footnotesize, inner sep=0pt,
    execute at begin node={\hyphenpenalty=10000}}]
  % Columna 1: coste de producción
  \node[bl=black!7, minimum height=2.9cm] (c1) at (0,0) {consumos\\ intermedios\\ $+$\\ remuneración\\ de asalariados\\ $+$\\ excedente o\\ renta mixta};
  % Columna 2: precio básico
  \node[bl=black!7, minimum height=2.9cm] (b1) at (2.8,0) {costes};
  \node[fino=cpro] (b2) at (b1.north) {imp. s/ producción};
  % Columna 3: precio de productor
  \node[bl=black!7, minimum height=2.9cm] (p1) at (5.6,0) {costes};
  \node[fino=cpro] (p2) at (p1.north) {imp. s/ producción};
  \node[fino=cprd] (p3) at (p2.north) {imp. s/ productos};
  % Columna 4: precio de adquisición
  \node[bl=black!7, minimum height=2.9cm] (a1) at (8.4,0) {costes};
  \node[fino=cpro] (a2) at (a1.north) {imp. s/ producción};
  \node[fino=cprd] (a3) at (a2.north) {imp. s/ productos};
  \node[fino=cmar] (a4) at (a3.north) {márgenes};
  \node[fino=civa] (a5) at (a4.north) {IVA};
  % Etiquetas de cada precio
  \node[et, below=0.15cm of c1] {Coste de\\ producción};
  \node[et, below=0.15cm of b1] {Precio\\ básico};
  \node[et, below=0.15cm of p1] {Precio de\\ productor};
  \node[et, below=0.15cm of a1] {Precio de\\ adquisición};
  \node[font=\footnotesize\itshape, text=black!70, above=0.1cm of b2, align=center] {lo que recibe\\ el productor};
  \node[font=\footnotesize\itshape, text=black!70, above=0.1cm of a5, align=center] {lo que paga\\ el comprador};
  % Leyenda: un color por concepto
  \node[cuad=cpro, anchor=north west] (k1) at (9.95,4.35) {};
  \node[ley] (l1) at ($(k1.north east)+(0.15,0)$) {\textbf{Otros impuestos netos sobre la producción}: se pagan por producir, sea cual sea la cantidad (actividades económicas, inmuebles de las empresas), menos las otras subvenciones a la producción. Ya forman parte del precio básico.};
  \node[cuad=cprd, anchor=north west] (k2) at ($(k1.north west |- l1.south)+(0,-0.2)$) {};
  \node[ley] (l2) at ($(k2.north east)+(0.15,0)$) {\textbf{Impuestos netos sobre los productos}, salvo el IVA: se pagan por unidad producida o vendida (impuestos especiales, derechos de importación), menos las subvenciones a los productos.};
  \node[cuad=cmar, anchor=north west] (k3) at ($(k2.north west |- l2.south)+(0,-0.2)$) {};
  \node[ley] (l3) at ($(k3.north east)+(0.15,0)$) {\textbf{Márgenes} de comercio y de transporte: los cobran quienes distribuyen el producto.};
  \node[cuad=civa, anchor=north west] (k4) at ($(k3.north west |- l3.south)+(0,-0.2)$) {};
  \node[ley] (l4) at ($(k4.north east)+(0.15,0)$) {\textbf{IVA no deducible}: solo el que el comprador no puede deducir, sobre todo el de los hogares.};
\end{tikzpicture}
