% Figura: escalera de precios del SEC 2010: del coste de producción al precio de adquisición, con los impuestos y subvenciones que entran en cada escalón.
% Fuente de SCN_precios.pdf. Sustituye a las antiguas imágenes Impuestos_Producción.png e Impuestos_Subvenciones_Tipos.png.
\begin{tikzpicture}[
  bl/.style={draw=black!70, line width=0.5pt, fill=#1, minimum width=2.1cm, align=center, font=\scriptsize, inner sep=1pt},
  et/.style={font=\footnotesize\bfseries, align=center},
  nota/.style={execute at begin node={\hyphenpenalty=10000}, draw=black!50, rounded corners=3pt, fill=white, align=left, font=\scriptsize, text width=5.4cm, inner sep=4pt}]
  % Columna 1: costes
  \node[bl=black!8, minimum height=2.6cm, anchor=south] (c1) at (0,0) {consumos\\ intermedios\\ $+$\\ remuneración\\ de asalariados\\ $+$\\ excedente o\\ renta mixta};
  % Columna 2: precio básico
  \node[bl=black!8, minimum height=2.6cm, anchor=south] (b1) at (2.6,0) {costes};
  \node[bl=blue!14, minimum height=0.55cm, anchor=south] (b2) at (b1.north) {otros imp. netos\\ s/ la producción};
  % Columna 3: precio de productor
  \node[bl=black!8, minimum height=2.6cm, anchor=south] (p1) at (5.2,0) {costes};
  \node[bl=blue!14, minimum height=0.55cm, anchor=south] (p2) at (p1.north) {otros imp. netos\\ s/ la producción};
  \node[bl=red!14, minimum height=0.55cm, anchor=south] (p3) at (p2.north) {imp. netos s/ productos\\ (salvo IVA)};
  % Columna 4: precio de adquisición
  \node[bl=black!8, minimum height=2.6cm, anchor=south] (a1) at (7.8,0) {costes};
  \node[bl=blue!14, minimum height=0.55cm, anchor=south] (a2) at (a1.north) {otros imp. netos\\ s/ la producción};
  \node[bl=red!14, minimum height=0.55cm, anchor=south] (a3) at (a2.north) {imp. netos s/ productos\\ (salvo IVA)};
  \node[bl=orange!18, minimum height=0.55cm, anchor=south] (a4) at (a3.north) {márgenes de comercio\\ y transporte};
  \node[bl=red!22, minimum height=0.45cm, anchor=south] (a5) at (a4.north) {IVA no deducible};
  % Etiquetas
  \node[et, below=0.15cm of c1] {Coste de\\ producción};
  \node[et, below=0.15cm of b1] {Precio\\ básico};
  \node[et, below=0.15cm of p1] {Precio de\\ productor};
  \node[et, below=0.15cm of a1] {Precio de\\ adquisición};
  \node[font=\scriptsize\itshape, text=black!70, above=0.1cm of b2, align=center] {lo que recibe\\ el productor};
  \node[font=\scriptsize\itshape, text=black!70, above=0.1cm of a5, align=center] {lo que paga\\ el comprador};
  % Clasificación de impuestos y subvenciones
  \node[nota, anchor=north west] (n1) at (9.5,4.6) {\textbf{Impuestos sobre los productos} (se pagan por unidad producida o vendida): IVA, impuestos sobre las importaciones (aranceles), impuestos especiales.\\ \textbf{Subvenciones a los productos}: a la importación y otras.\\ \textit{No forman parte del precio básico; sí del de adquisición.}};
  \node[nota, anchor=north west, below=0.25cm of n1] (n2) {\textbf{Otros impuestos sobre la producción} (se pagan por producir, sea cual sea la cantidad): impuestos sobre actividades económicas, sobre los inmuebles de las empresas.\\ \textbf{Otras subvenciones a la producción}.\\ \textit{Forman parte ya del precio básico.}};
  \fill[red!14] ([xshift=-0.35cm, yshift=-0.35cm]n1.north west) rectangle ++(0.22,0.22);
  \fill[blue!14] ([xshift=-0.35cm, yshift=-0.35cm]n2.north west) rectangle ++(0.22,0.22);
\end{tikzpicture}
