% Figura: la partida cuádruple en una matriz de transacciones (convención de GODLEY y LAVOIE, 2007).
% Fuente de SCN_partida_cuadruple.pdf. Ejemplo abstracto: las AAPP pagan una prestación social x a un hogar con un depósito.
\begin{tikzpicture}[>=stealth,
  c/.style={draw=black!70, line width=0.5pt, minimum width=2.6cm, minimum height=0.95cm, font=\small, align=center, anchor=center},
  h/.style={c, fill=black!6, font=\small\bfseries},
  f/.style={c, text width=4.6cm, minimum width=4.9cm, font=\footnotesize, fill=black!3},
  cor/.style={c, fill=blue!10}, fin/.style={c, fill=red!10}, cero/.style={c, fill=white, text=black!55}]
  \matrix (m) [matrix of nodes, column sep=-0.5pt, row sep=-0.5pt, nodes in empty cells]
  {
    |[f, fill=white, draw=none]| & |[h]| Hogares & |[h]| AAPP & |[h]| $\Sigma$ \\
    |[f]| \shortstack{Prestación social\\ (operación corriente)} & |[cor]| $+x$ & |[cor]| $-x$ & |[cero]| $0$ \\
    |[f]| \shortstack{Efectivo y depósitos\\ (operación financiera)} & |[fin]| $-x$ & |[fin]| $+x$ & |[cero]| $0$ \\
    |[f, fill=black!6]| \textbf{$\Sigma$} & |[cero]| $0$ & |[cero]| $0$ & |[cero]| $0$ \\
  };
  % Lectura horizontal
  \draw[->, line width=1.1pt, blue!55!black] ([xshift=0.25cm]m-2-4.east) -- ++(1.0,0)
    node[right, font=\footnotesize, text=blue!55!black, align=left] {\textbf{Horizontal}: lo que es empleo para\\ un sector es recurso para otro};
  \draw[->, line width=1.1pt, red!55!black] ([xshift=0.25cm]m-3-4.east) -- ++(1.0,0)
    node[right, font=\footnotesize, text=red!55!black, align=left] {\textbf{Horizontal}: el activo de uno\\ es el pasivo (o la cesión) de otro};
  % Lectura vertical
  \draw[->, line width=1.1pt, black!65] ([yshift=-0.25cm]m-4-2.south) -- ++(0,-0.7)
    node[below right, font=\footnotesize, align=left, xshift=-0.3cm] {\textbf{Vertical}: cada operación tiene\\ su contrapartida en la unidad};
  \draw[->, line width=1.1pt, black!65] ([yshift=-0.25cm]m-4-3.south) -- ++(0,-0.7);
  % Convenio de signos
  \node[font=\scriptsize, text=black!70, anchor=north west, align=left, text width=4.4cm, execute at begin node={\hyphenpenalty=10000}] at ([yshift=-0.2cm]m-4-1.south west)
    {Signo $+$: recurso o fuente de fondos (venta de un activo, aumento de un pasivo).\\ Signo $-$: empleo o uso de fondos (adquisición de un activo).};
\end{tikzpicture}
