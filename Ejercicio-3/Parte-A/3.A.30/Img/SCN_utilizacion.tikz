% Figura: bloques de filas de la cuenta de redistribución de la renta en especie (II.3) y de utilización de la renta (II.4.1 y II.4.2).
% Fuente de SCN_utilizacion.pdf. Convención de GODLEY y LAVOIE (2007) sobre las columnas del cuadro de cuentas económicas integradas del SEC 2010.
\providecommand{\op}[2]{\shortstack[l]{\textbf{#1}\\ \textcolor{black!65}{\scriptsize #2}}}
\begin{tikzpicture}[>=stealth,
  c/.style={draw=black!70, line width=0.5pt, minimum width=1.75cm, minimum height=0.95cm, font=\small, align=center, anchor=center},
  h/.style={c, fill=black!6, font=\footnotesize\bfseries, minimum height=1.25cm},
  ht/.style={h, fill=black!16},
  f/.style={c, text width=5.0cm, minimum width=5.3cm, font=\footnotesize, align=left, fill=black!3},
  cor/.style={c, fill=blue!7}, esp/.style={c, fill=orange!12},
  tot/.style={c, fill=black!12}, totz/.style={c, fill=black!12, text=black!50},
  vac/.style={c, fill=white}, prev/.style={c, fill=white, text=black!50},
  cero/.style={c, fill=white, text=black!55, minimum width=1.3cm},
  sig/.style={h, minimum width=1.3cm},
  ab/.style={c, fill=blue!3, text=black!70},
  sub/.style={c, fill=orange!22, font=\small\bfseries},
  sal/.style={c, fill=blue!18, font=\small\bfseries},
  salt/.style={sal, fill=black!22}]
  \matrix (m) [matrix of nodes, column sep=-0.5pt, row sep=-0.5pt, nodes in empty cells]
  {
    |[f, fill=white, draw=none]| &
    |[h]| \shortstack{Hogares\\ e ISFLSH} &
    |[h]| Sociedades &
    |[h]| AAPP &
    |[ht]| \shortstack{Total\\ economía} &
    |[h]| \shortstack{Resto\\ del mundo} &
    |[h]| \shortstack{Bienes y\\ servicios} &
    |[sig]| $\Sigma$ \\
    |[f, fill=blue!3]| \op{Abre con: renta disponible bruta}{saldo de la distribución secundaria} & |[ab]| $+RDB_H$ & |[ab]| $+RDB_S$ & |[ab]| $+RDB_G$ & |[ab, fill=black!8]| $+RNDB$ & |[vac]| & |[vac]| & |[cero]| \\
    |[f]| \op{Transferencias sociales en especie}{D.63 (cuenta II.3)} & |[esp]| $+TSE$ & |[vac]| & |[esp]| $-TSE$ & |[totz]| $0$ & |[vac]| & |[vac]| & |[cero]| $0$ \\
    |[f, fill=orange!22]| \op{Subtotal}{renta disponible ajustada (B.7b)} & |[sub]| $RDBA_H$ & |[sub]| $RDB_S$ & |[sub]| $RDBA_G$ & |[sub, fill=black!18]| $RNDB$ & |[vac]| & |[vac]| & |[cero]| \\
    |[f]| \op{Gasto en consumo final}{P.3, quien lo paga (cuenta II.4.1)} & |[cor]| $-C_H$ & |[vac]| & |[cor]| $-C_G$ & |[tot]| $-C$ & |[vac]| & |[prev]| \shortstack{$+C$\\ {\scriptsize (cuenta $0$)}} & |[cero]| $0$ \\
    |[f]| \op{Consumo de las transferencias en especie}{paso al consumo final efectivo (cuenta II.4.2)} & |[esp]| $-TSE$ & |[vac]| & |[esp]| $+TSE$ & |[totz]| $0$ & |[vac]| & |[vac]| & |[cero]| $0$ \\
    |[f]| \op{Ajuste por los derechos por pensiones}{D.8} & |[cor]| $+D8$ & |[cor]| $-D8$ & |[vac]| & |[totz]| $0$ & |[vac]| & |[vac]| & |[cero]| $0$ \\
    |[f, fill=blue!18]| \op{Saldo}{ahorro bruto (B.8b)} & |[sal]| $AB_H$ & |[sal]| $AB_S$ & |[sal]| $AB_G$ & |[salt]| $ANB$ & |[vac]| & |[vac]| & |[cero]| \\
  };
  \draw[line width=1.2pt, black!75] (m-8-1.north west) -- (m-8-8.north east);
  \draw[->, line width=1.0pt, black!60] ([yshift=-0.2cm]m-8-5.south) -- ++(0,-0.6)
    node[below, font=\scriptsize, text=black!75, align=center] {$ANB=RNDB-C$\\ (ahorro nacional bruto)};
  \node[font=\scriptsize, text=black!75, anchor=north west, align=left, text width=15.6cm, execute at begin node={\hyphenpenalty=10000}] at ([yshift=-1.7cm]m-8-1.south west)
    {Las filas naranjas son las de la versión ajustada. Los hogares reciben las transferencias sociales en especie de las AAPP como renta (renta disponible ajustada) y las consumen (consumo final efectivo: $C_H+TSE$); las AAPP se quedan con el consumo colectivo ($C_G-TSE$). Las dos filas se compensan en cada columna, y por eso el ahorro es el mismo en las dos versiones.\\
     Las sociedades no tienen consumo final: su renta disponible pasa al ahorro, salvo el ajuste por pensiones. Las transferencias en especie de las ISFLSH a los hogares quedan dentro de su columna común.};
\end{tikzpicture}
