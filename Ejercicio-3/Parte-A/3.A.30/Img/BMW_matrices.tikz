% Figura: matrices del modelo BMW de GODLEY y LAVOIE (2007, cap. 7): economía cerrada sin Gobierno, con empresas que se financian con préstamos y hogares que ahorran en depósitos bancarios.
% Fuente de BMW_matrices.pdf.
\providecommand{\opc}[2]{\textbf{#1} {\scriptsize\textcolor{black!65}{#2}}}
\begin{tikzpicture}[>=stealth,
  c/.style={draw=black!70, line width=0.5pt, minimum width=1.75cm, minimum height=0.72cm, font=\small, align=center, anchor=center},
  h/.style={c, fill=black!6, font=\footnotesize\bfseries, minimum height=1.15cm},
  f/.style={c, text width=3.6cm, minimum width=3.9cm, font=\footnotesize, align=left, fill=black!3},
  cor/.style={c, fill=blue!7}, fin/.style={c, fill=red!8}, pn/.style={c, fill=yellow!20}, nf/.style={c, fill=orange!12},
  vac/.style={c, fill=white},
  cero/.style={c, fill=white, text=black!55, minimum width=0.9cm},
  sig/.style={h, minimum width=0.9cm},
  tit/.style={font=\footnotesize\bfseries\itshape, text=black!70}]
  % Balance
  \matrix (b) [matrix of nodes, column sep=-0.5pt, row sep=-0.5pt, nodes in empty cells]
  {
    |[f, fill=white, draw=none]| & |[h]| Hogares & |[h]| Empresas & |[h]| Bancos & |[sig]| $\Sigma$ \\
    |[f]| \opc{Depósitos}{$M$} & |[fin]| $+M$ & |[vac]| & |[fin]| $-M$ & |[cero]| $0$ \\
    |[f]| \opc{Préstamos}{$L$} & |[vac]| & |[fin]| $-L$ & |[fin]| $+L$ & |[cero]| $0$ \\
    |[f]| \opc{Capital fijo}{$K$} & |[vac]| & |[nf]| $+K$ & |[vac]| & |[cero]| $+K$ \\
    |[f, fill=yellow!20]| \opc{Patrimonio neto}{} & |[pn]| $-V_h$ & |[pn]| $0$ & |[pn]| $0$ & |[cero]| $-K$ \\
    |[f, fill=black!6]| \textbf{$\Sigma$} & |[cero, minimum width=1.75cm]| $0$ & |[cero, minimum width=1.75cm]| $0$ & |[cero, minimum width=1.75cm]| $0$ & |[cero]| $0$ \\
  };
  \node[tit, anchor=south west] at ([yshift=0.1cm]b-1-1.north west) {Matriz de balances};
  % Transacciones
  \matrix (t) [matrix of nodes, column sep=-0.5pt, row sep=-0.5pt, nodes in empty cells, anchor=north west] at ([xshift=1.0cm]b-1-5.north east)
  {
    |[f, fill=white, draw=none]| & |[h]| Hogares & |[h]| \shortstack{Empresas\\ {\scriptsize\mdseries corriente}} & |[h]| \shortstack{Empresas\\ {\scriptsize\mdseries capital}} & |[h]| Bancos & |[sig]| $\Sigma$ \\
    |[f]| \opc{Consumo}{} & |[cor]| $-C$ & |[cor]| $+C$ & |[vac]| & |[vac]| & |[cero]| $0$ \\
    |[f]| \opc{Inversión}{} & |[vac]| & |[cor]| $+I$ & |[fin]| $-I$ & |[vac]| & |[cero]| $0$ \\
    |[f]| \opc{[Producción]}{} & |[vac]| & |[vac, text=black!55]| $[Y]$ & |[vac]| & |[vac]| & |[cero]| \\
    |[f]| \opc{Salarios}{} & |[cor]| $+WB$ & |[cor]| $-WB$ & |[vac]| & |[vac]| & |[cero]| $0$ \\
    |[f]| \opc{Amortizaciones}{} & |[vac]| & |[cor]| $-AF$ & |[fin]| $+AF$ & |[vac]| & |[cero]| $0$ \\
    |[f]| \opc{Intereses de los préstamos}{} & |[vac]| & |[cor]| $-r_{l}L_{-1}$ & |[vac]| & |[cor]| $+r_{l}L_{-1}$ & |[cero]| $0$ \\
    |[f]| \opc{Intereses de los depósitos}{} & |[cor]| $+r_{m}M_{-1}$ & |[vac]| & |[vac]| & |[cor]| $-r_{m}M_{-1}$ & |[cero]| $0$ \\
    |[f]| \opc{Variación de los préstamos}{} & |[vac]| & |[vac]| & |[fin]| $+\Delta L$ & |[fin]| $-\Delta L$ & |[cero]| $0$ \\
    |[f]| \opc{Variación de los depósitos}{} & |[fin]| $-\Delta M$ & |[vac]| & |[vac]| & |[fin]| $+\Delta M$ & |[cero]| $0$ \\
    |[f, fill=black!6]| \textbf{$\Sigma$} & |[cero, minimum width=1.75cm]| $0$ & |[cero, minimum width=1.75cm]| $0$ & |[cero, minimum width=1.75cm]| $0$ & |[cero, minimum width=1.75cm]| $0$ & |[cero]| $0$ \\
  };
  \node[tit, anchor=south west] at ([yshift=0.1cm]t-1-1.north west) {Matriz de transacciones};
  \node[font=\scriptsize, text=black!75, anchor=north west, align=left, text width=21.0cm, execute at begin node={\hyphenpenalty=10000}] at ([yshift=-0.3cm]t-11-1.south west -| b-1-1.west)
    {Las empresas pagan en salarios todo lo que les queda de sus ventas después de pagar los intereses y de dotar las amortizaciones, y financian con préstamos la parte de la inversión que no cubren las amortizaciones. Los bancos no tienen beneficios ($r_l=r_m$) y su balance es el espejo del de los demás: los depósitos que crean al prestar son los que los hogares mantienen como ahorro.};
\end{tikzpicture}
