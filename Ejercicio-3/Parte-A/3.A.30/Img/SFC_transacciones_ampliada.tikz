% Figura: matriz de transacciones ampliada de una economía cerrada con empresas, bancos, Gobierno y banco central (convención de GODLEY y LAVOIE, 2007).
% Fuente de SFC_transacciones_ampliada.pdf. Las empresas tienen una columna corriente y otra de capital. Los intereses se pagan sobre los stocks del periodo anterior (subíndice -1).
\providecommand{\opc}[2]{\textbf{#1} {\scriptsize\textcolor{black!65}{#2}}}
\begin{tikzpicture}[>=stealth,
  c/.style={draw=black!70, line width=0.5pt, minimum width=1.75cm, minimum height=0.68cm, font=\footnotesize, align=center, anchor=center},
  h/.style={c, fill=black!6, font=\footnotesize\bfseries, minimum height=1.2cm},
  f/.style={c, text width=4.6cm, minimum width=4.9cm, font=\footnotesize, align=left, fill=black!3},
  cor/.style={c, fill=blue!7}, fin/.style={c, fill=red!8},
  vac/.style={c, fill=white},
  cero/.style={c, fill=white, text=black!55, minimum width=0.9cm},
  sig/.style={h, minimum width=0.9cm}]
  \matrix (m) [matrix of nodes, column sep=-0.5pt, row sep=-0.5pt, nodes in empty cells]
  {
    |[f, fill=white, draw=none]| &
    |[h]| Hogares &
    |[h]| \shortstack{Empresas\\ {\scriptsize\mdseries corriente}} &
    |[h]| \shortstack{Empresas\\ {\scriptsize\mdseries capital}} &
    |[h]| Bancos &
    |[h]| Gobierno &
    |[h]| \shortstack{Banco\\ central} &
    |[sig]| $\Sigma$ \\
    |[f]| \opc{Consumo}{} & |[cor]| $-C$ & |[cor]| $+C$ & |[vac]| & |[vac]| & |[vac]| & |[vac]| & |[cero]| $0$ \\
    |[f]| \opc{Gasto público}{} & |[vac]| & |[cor]| $+G$ & |[vac]| & |[vac]| & |[cor]| $-G$ & |[vac]| & |[cero]| $0$ \\
    |[f]| \opc{Inversión}{} & |[vac]| & |[cor]| $+I$ & |[fin]| $-I$ & |[vac]| & |[vac]| & |[vac]| & |[cero]| $0$ \\
    |[f]| \opc{Salarios}{} & |[cor]| $+W$ & |[cor]| $-W$ & |[vac]| & |[vac]| & |[vac]| & |[vac]| & |[cero]| $0$ \\
    |[f]| \opc{Beneficios}{distribuidos y retenidos} & |[cor]| $+F_d$ & |[cor]| $-F$ & |[fin]| $+F_u$ & |[vac]| & |[vac]| & |[vac]| & |[cero]| $0$ \\
    |[f]| \opc{Impuestos}{} & |[cor]| $-T$ & |[vac]| & |[vac]| & |[vac]| & |[cor]| $+T$ & |[vac]| & |[cero]| $0$ \\
    |[f]| \opc{Intereses de los depósitos}{} & |[cor]| $+r_{m}M_{-1}$ & |[vac]| & |[vac]| & |[cor]| $-r_{m}M_{-1}$ & |[vac]| & |[vac]| & |[cero]| $0$ \\
    |[f]| \opc{Intereses de los préstamos}{} & |[vac]| & |[cor]| $-r_{l}L_{-1}$ & |[vac]| & |[cor]| $+r_{l}L_{-1}$ & |[vac]| & |[vac]| & |[cero]| $0$ \\
    |[f]| \opc{Intereses de los bonos}{} & |[cor]| $+r_{b}B_{h,-1}$ & |[vac]| & |[vac]| & |[cor]| $+r_{b}B_{b,-1}$ & |[cor]| $-r_{b}B_{-1}$ & |[cor]| $+r_{b}B_{cb,-1}$ & |[cero]| $0$ \\
    |[f]| \opc{Beneficios del banco central}{} & |[vac]| & |[vac]| & |[vac]| & |[vac]| & |[cor]| $+F_{cb}$ & |[cor]| $-F_{cb}$ & |[cero]| $0$ \\
    |[f]| \opc{Variación del dinero de alta potencia}{} & |[fin]| $-\Delta H_h$ & |[vac]| & |[vac]| & |[fin]| $-\Delta H_b$ & |[vac]| & |[fin]| $+\Delta H$ & |[cero]| $0$ \\
    |[f]| \opc{Variación de los depósitos}{} & |[fin]| $-\Delta M$ & |[vac]| & |[vac]| & |[fin]| $+\Delta M$ & |[vac]| & |[vac]| & |[cero]| $0$ \\
    |[f]| \opc{Variación de los préstamos}{} & |[vac]| & |[vac]| & |[fin]| $+\Delta L$ & |[fin]| $-\Delta L$ & |[vac]| & |[vac]| & |[cero]| $0$ \\
    |[f]| \opc{Variación de los bonos}{} & |[fin]| $-\Delta B_h$ & |[vac]| & |[vac]| & |[fin]| $-\Delta B_b$ & |[fin]| $+\Delta B$ & |[fin]| $-\Delta B_{cb}$ & |[cero]| $0$ \\
    |[f, fill=black!6]| \textbf{$\Sigma$} & |[cero, minimum width=1.75cm]| $0$ & |[cero, minimum width=1.75cm]| $0$ & |[cero, minimum width=1.75cm]| $0$ & |[cero, minimum width=1.75cm]| $0$ & |[cero, minimum width=1.75cm]| $0$ & |[cero, minimum width=1.75cm]| $0$ & |[cero]| $0$ \\
  };
  \draw[line width=1.0pt, black!60] (m-12-1.north west) -- (m-12-8.north east);
  \draw[decorate, decoration={brace, amplitude=4pt, mirror}, line width=0.8pt, blue!55!black]
    ([xshift=-0.12cm]m-2-1.north west) -- ([xshift=-0.12cm]m-11-1.south west)
    node[midway, xshift=-0.4cm, font=\scriptsize\bfseries, text=blue!55!black, rotate=90] {Flujos de renta y gasto};
  \draw[decorate, decoration={brace, amplitude=4pt, mirror}, line width=0.8pt, red!55!black]
    ([xshift=-0.12cm]m-12-1.north west) -- ([xshift=-0.12cm]m-15-1.south west)
    node[midway, xshift=-0.4cm, font=\scriptsize\bfseries, text=red!55!black, rotate=90] {Flujos financieros};
  \node[font=\scriptsize, text=black!75, anchor=north west, align=left, text width=16.8cm, execute at begin node={\hyphenpenalty=10000}] at ([yshift=-0.3cm]m-16-1.south west)
    {Economía cerrada, sin depreciación. Cada fila suma cero y cada columna suma cero: la parte superior de cada columna es el saldo de renta y gasto del sector, y la inferior, cómo lo financia. Los intereses de un periodo se pagan sobre los stocks del periodo anterior ($M_{-1}$, $L_{-1}$, $B_{-1}$): es la forma en que el pasado entra en el presente. Los beneficios de los bancos se suponen nulos por simplicidad.};
\end{tikzpicture}
