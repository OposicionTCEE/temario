% Figura: estructura del SCN 2025 frente al SEC revisado que lo aplicará en la Unión («SEC 2030», en preparación), en dos paneles.
% Solo conceptos. Fuentes: SCN 2025 (índice y «New features»); Eurostat: presentación de M. Kotzeva (4/3/2026) y página «Towards ESA 2030».
% Generar con: bash Code/generar_figura.sh SCN_SEC_2025_2030
\colorlet{cdif}{orange!30}
\colorlet{cnue}{cyan!22}
\providecommand{\dif}[1]{{\setlength{\fboxsep}{0.8pt}\colorbox{cdif}{#1}}}
\providecommand{\nue}[1]{{\setlength{\fboxsep}{0.8pt}\colorbox{cnue}{#1}}}
\providecommand{\aus}[1]{{\color{black!55}\itshape #1}}
\providecommand{\tema}[1]{{\setlength{\fboxsep}{0.8pt}\fcolorbox{black!40}{white}{\color{black!75}#1}}}
\begin{tikzpicture}[
  font=\footnotesize,
  cab/.style={draw=#1!55!black, fill=#1!10, rounded corners=2pt, text width=7.25cm, align=center, inner sep=3pt, anchor=north west, execute at begin node={\hyphenpenalty=10000}},
  rama/.style={text width=6.6cm, align=left, inner sep=3pt, anchor=north west,
    execute at begin node={\hyphenpenalty=10000\setlength{\baselineskip}{1.12\baselineskip}}},
  marco/.style={draw=black!40, rounded corners=2pt},
  previsto/.style={draw=black!40, dashed, rounded corners=2pt},
  flecha/.style={black!45, -{Latex[length=1.4mm]}}]
  % Cabeceras (raíz de cada panel)
  \node[cab=blue] (hA) at (0,0) {\textbf{\small SCN 2025}\\ Naciones Unidas, Comisión Europea, FMI, OCDE y Banco Mundial\\ adoptado en marzo de 2025 $\cdot$ aplicación en 2029-2030};
  \node[cab=violet, dashed] (hB) at (8.2,0) {\textbf{\small SEC 2030} (en preparación)\\ \dif{nuevo Reglamento: propuesta de la Comisión, final de 2026}\\ \dif{cambios centrales en 2030; los demás, después}};
  \coordinate (eA) at (0.3,0); \coordinate (eB) at (8.5,0);
  \path let \p1=(hA.south), \p2=(hB.south) in coordinate (r1) at (0,{min(\y1,\y2)-0.25cm});
  % Fila 1: clasificación institucional
  \node[rama] (a1) at ($(r1)+(0.6,0)$) {\textbf{Clasificación institucional}\hfill\tema{3.A.30}\\
    S.11 a S.15 y S.2, como en el SCN 2008\\
    \nue{sociedades públicas, privadas nacionales}\\ \hspace*{1em}\nue{y bajo control extranjero (multinacionales)}\\
    \nue{más subsectores financieros}\\
    \nue{hogares por decil de renta y de riqueza}};
  \node[rama] (b1) at ($(r1)+(8.8,0)$) {\textbf{Clasificación institucional}\hfill\tema{3.A.30}\\
    \aus{el SEC 2010 se revisa para incorporar}\\ \aus{los cambios del SCN 2025}};
  \path let \p1=(a1.south), \p2=(b1.south) in coordinate (s1) at (0,{min(\y1,\y2)});
  \coordinate (r2) at ($(s1)+(0,-0.22)$);
  % Fila 2: clasificación funcional
  \node[rama] (a2) at ($(r2)+(0.6,0)$) {\textbf{Clasificación funcional*}\hfill\tema{3.A.31}\\
    establecimientos $\to$ industrias* \nue{(CIIU Rev. 5)}\\ cuadros de oferta y utilización};
  \node[rama] (b2) at ($(r2)+(8.8,0)$) {\textbf{Clasificación funcional*}\hfill\tema{3.A.31}\\
    UAE locales $\to$ ramas de actividad\\ \dif{NACE Rev. 2.1 y CPA 2.2, en 2030}};
  \path let \p1=(a2.south), \p2=(b2.south) in coordinate (s2) at (0,{min(\y1,\y2)});
  \coordinate (r3) at ($(s2)+(0,-0.22)$);
  % Fila 3: operaciones
  \node[rama] (a3) at ($(r3)+(0.6,0)$) {\textbf{Operaciones}\\
    P $\cdot$ D $\cdot$ F $\cdot$ K, y además:\\
    \nue{datos: activo fijo producido}\\
    \nue{agotamiento: coste de producción}\\
    \nue{criptoactivos sin pasivo: activo no producido}\\
    \nue{producción no de mercado: costes}\\ \hspace*{1em}\nue{más rendimiento del capital}};
  \node[rama] (b3) at ($(r3)+(8.8,0)$) {\textbf{Operaciones}\\
    \dif{cambios centrales, de una vez en 2030:}\\
    datos $\cdot$ agotamiento $\cdot$ rendimiento del capital\\
    alquileres en la valoración por costes\\
    criptoactivos sin pasivo\\
    \dif{los demás cambios, en fases posteriores}};
  \path let \p1=(a3.south), \p2=(b3.south) in coordinate (s3) at (0,{min(\y1,\y2)});
  \coordinate (r4) at ($(s3)+(0,-0.22)$);
  % Fila 4: cuentas
  \node[rama] (a4) at ($(r4)+(0.6,0)$) {\textbf{Cuentas}\hfill\tema{3.A.30}\\
    producción $\cdot$ \nue{renta ganada*} $\cdot$ \nue{renta de transferencias*}\\
    utilización de la renta $\cdot$ capital $\cdot$ financiera\\
    otras variaciones $\cdot$ balances\\
    \nue{el PIN, medida preferente del crecimiento}};
  \node[rama] (b4) at ($(r4)+(8.8,0)$) {\textbf{Cuentas}\hfill\tema{3.A.30}\\
    programa de transmisión revisado\\
    \dif{junto con el MBP7, también en 2030} \tema{3.B.11}};
  \path let \p1=(a4.south), \p2=(b4.south) in coordinate (s4) at (0,{min(\y1,\y2)});
  \coordinate (r5) at ($(s4)+(0,-0.22)$);
  % Fila 5: cuadros y extensiones
  \node[rama] (a5) at ($(r5)+(0.6,0)$) {\textbf{Cuadros y extensiones}\\
    input-output \tema{3.A.31} $\cdot$ de quién a quién $\cdot$ economía informal\\
    \nue{bienestar y sostenibilidad} \tema{3.A.30}\\
    \nue{digitalización $\cdot$ globalización $\cdot$ finanzas islámicas}\\
    \nue{trabajo doméstico no remunerado, capital humano}};
  \node[rama] (b5) at ($(r5)+(8.8,0)$) {\textbf{Cuadros y extensiones}\\
    \aus{elementos no centrales y cuentas temáticas:}\\ \aus{introducción gradual después de 2030}};
  \path let \p1=(a5.south), \p2=(b5.south) in coordinate (s5) at (0,{min(\y1,\y2)});
  % Marcos de igual altura en cada fila (los del SEC, discontinuos: aún en preparación), flechas y ejes
  \foreach \i in {1,...,5} {
    \draw[marco] (a\i.north west) rectangle (a\i.east |- s\i);
    \draw[previsto] (b\i.north west) rectangle (b\i.east |- s\i);
    \coordinate (ta\i) at ($(a\i.north west)+(0,-0.26)$);
    \coordinate (tb\i) at ($(b\i.north west)+(0,-0.26)$);
    \draw[flecha] (eA |- ta\i) -- (ta\i);
    \draw[flecha] (eB |- tb\i) -- (tb\i);
  }
  \draw[black!45] (eA |- hA.south) -- (eA |- ta5);
  \draw[black!45] (eB |- hB.south) -- (eB |- tb5);
  % Leyenda
  \node[anchor=north west, text width=15.4cm, align=left, inner sep=0pt, font=\footnotesize] at ($(s5)+(0,-0.3)$) {
    \nue{\phantom{xx}} novedad respecto al SCN 2008 \quad \dif{\phantom{xx}} lo propio del SEC \quad \aus{cursiva gris} y marco discontinuo: aún por concretar \quad \tema{3.A.31} tema en que se trata\\[2pt]
    * \textit{Renta ganada} y \textit{renta de transferencias}: nuevos nombres de las cuentas de distribución primaria y secundaria de la renta. \textit{Industrias}: ramas de actividad en el SEC.
    \textit{Clasificación funcional}: por ramas de actividad, no la del gasto público. El contenido del SEC 2030 es el previsto por Eurostat en 2026 y puede cambiar en la tramitación del Reglamento.};
\end{tikzpicture}
