% Figura: estructura del SCN 2025 frente al SEC revisado que lo aplicará en la Unión («SEC 2030», en preparación), en dos paneles con el mismo flujo
% que la figura SCN_SEC_2008_2010: sistema -> clasificaciones -> operaciones -> cuentas por sectores | por ramas; aparte, «+ Cuadros y extensiones».
% Sin color: en el panel del SCN 2025, «≠» marca una novedad respecto al SCN 2008; en el del SEC 2030, una diferencia respecto al SCN 2025.
% El SEC 2030 va con marco discontinuo (en preparación) y en gris lo que está por concretar.
% Fuentes: SCN 2025 (índice y «New features»); Eurostat: presentación de M. Kotzeva (4/3/2026) y página «Towards ESA 2030».
% Generar con: bash Code/generar_figura.sh SCN_SEC_2025_2030
\providecommand{\tema}[1]{{\upshape\setlength{\fboxsep}{0.8pt}\fcolorbox{black!40}{white}{\color{black!75}#1}}}%
\providecommand{\aus}[1]{{\color{black!55}\itshape #1}}%
\providecommand{\sub}[1]{{\leftskip=1em #1\par}}%
\providecommand{\dif}[2]{{\hangindent=0.9em\hangafter=1 $\neq$\,#1 $\Rightarrow$ \textit{#2}\par}}%
\providecommand{\difs}[1]{{\hangindent=0.9em\hangafter=1 $\neq$\,#1\par}}%
\providecommand{\imp}[1]{{\hangindent=0.9em\hangafter=1 $\Rightarrow$ \textit{#1}\par}}%
\providecommand{\difl}[2]{$\neq$\,#1 $\Rightarrow$ \textit{#2}}%
\begin{tikzpicture}[
  font=\footnotesize,
  cab/.style={draw=#1!55!black, fill=#1!10, rounded corners=2pt, text width=7.588cm, minimum height=1.55cm, align=center, inner sep=3pt, anchor=north west,
    execute at begin node={\hyphenpenalty=10000}},
  txt/.style={text width=#1, align=left, inner sep=3pt, anchor=north west,
    execute at begin node={\hyphenpenalty=10000\parindent=0pt}},
  marco/.style={draw=black!40, rounded corners=2pt},
  previsto/.style={draw=black!40, dashed, rounded corners=2pt},
  linea/.style={black!45},
  flecha/.style={black!45, -{Latex[length=1.4mm]}}]
  % Ejes de cada panel: centro, rama institucional (izquierda) y rama funcional (derecha)
  \coordinate (cA) at (3.9,0);   \coordinate (lA) at (2.2,0);   \coordinate (rA) at (6.2,0);
  \coordinate (cB) at (12.05,0); \coordinate (lB) at (10.35,0); \coordinate (rB) at (14.35,0);
  % Sistema
  \node[cab=blue] (hA) at (0,0) {\textbf{\small SCN 2025}\\ Naciones Unidas, Comisión Europea, FMI,\\ OCDE y Banco Mundial\\ adoptado en marzo de 2025 $\cdot$ aplicación en 2029-2030};
  \node[cab=violet, dashed] (hB) at (8.15,0) {\textbf{\small SEC 2030} (en preparación)\\
    \difl{nuevo Reglamento: propuesta de la Comisión a finales de 2026}{obligatorio, como el SEC 2010}\\
    \aus{el SEC 2010 y su programa de transmisión se revisan para incorporar el SCN 2025}};
  \path let \p1=(hA.south), \p2=(hB.south) in coordinate (y0) at (0,{min(\y1,\y2)});
  \coordinate (r1) at ($(y0)+(0,-0.5)$); \coordinate (m0) at ($(y0)!0.5!(r1)$);
  % Clasificaciones de las unidades
  \node[txt=4.188cm] (a1) at ($(r1)+(0,0)$) {\textbf{Clasificación institucional}\hfill\tema{3.A.30}\par
    S.11 a S.15 y S.2, como en el SCN 2008\par
    \dif{sociedades bajo control extranjero, públicas y privadas nacionales}{actividad de las multinacionales: dónde se genera la renta y a quién pertenece}
    \dif{más subsectores financieros}{mejor imagen de los riesgos y vulnerabilidades financieros}
    \dif{hogares por decil de renta y de riqueza}{cómo se reparten la renta, el consumo y la riqueza}};
  \node[txt=2.988cm] (a2) at ($(r1)+(4.6,0)$) {\textbf{Clasificación funcional*}\hfill\tema{3.A.31}\par
    establecimientos* $\to$ industrias*\par
    \difs{CIIU Rev.~5}};
  \node[txt=4.188cm] (b1) at ($(r1)+(8.15,0)$) {\textbf{Clasificación institucional}\hfill\tema{3.A.30}\par
    \aus{por concretar en el nuevo Reglamento}};
  \node[txt=2.988cm] (b2) at ($(r1)+(12.75,0)$) {\textbf{Clasificación funcional*}\hfill\tema{3.A.31}\par
    UAE locales $\to$ ramas de actividad\par
    \difs{NACE Rev.~2.1 y CPA 2.2, en 2030}};
  \path let \p1=(a1.south), \p2=(a2.south), \p3=(b1.south), \p4=(b2.south) in coordinate (s1) at (0,{min(\y1,\y2,\y3,\y4)});
  \coordinate (r2) at ($(s1)+(0,-0.5)$); \coordinate (m1) at ($(s1)!0.5!(r2)$);
  % Operaciones
  \node[txt=7.588cm] (a3) at ($(r2)+(0,0)$) {\textbf{Operaciones}: la misma clasificación (P $\cdot$ D $\cdot$ F $\cdot$ NP; otros flujos: K)\par
    \dif{datos: activo fijo producido}{su creación pasa a ser inversión: más FBCF y más PIB}
    \dif{agotamiento de los recursos naturales: coste de producción, como el consumo de capital fijo}{reduce el PIN y las demás magnitudes netas}
    \dif{criptoactivos sin pasivo (bitcoin): activo no financiero no producido}{en la cuenta de capital, no en la financiera}
    \dif{producción no de mercado: costes más rendimiento del capital}{más producción y valor añadido de las AAPP}};
  \node[txt=7.588cm] (b3) at ($(r2)+(8.15,0)$) {\textbf{Operaciones}\par
    \dif{cambios centrales, de una vez en 2030: datos $\cdot$ agotamiento $\cdot$ rendimiento del capital $\cdot$ alquileres en la valoración por costes $\cdot$ criptoactivos sin pasivo}{afectan a toda la sucesión de cuentas, de la producción al balance, y a los agregados brutos y netos}
    \difs{los demás cambios, por prioridades, en los años siguientes}};
  \path let \p1=(a3.south), \p2=(b3.south) in coordinate (s2) at (0,{min(\y1,\y2)});
  \coordinate (r3) at ($(s2)+(0,-0.5)$); \coordinate (m2) at ($(s2)!0.5!(r3)$);
  % Cuentas
  \node[txt=4.188cm] (a4) at ($(r3)+(0,0)$) {\textbf{Cuentas de los sectores}\hfill\tema{3.A.30}\par
    producción $\cdot$ utilización de la renta $\cdot$ capital $\cdot$ financiera $\cdot$ otras variaciones $\cdot$ balances\par
    \difs{renta ganada* y renta de transferencias*: nombres nuevos}
    \dif{PIN, medida preferente del crecimiento, junto al PIB}{el crecimiento descuenta el desgaste del capital y el agotamiento}};
  \node[txt=2.988cm] (a5) at ($(r3)+(4.6,0)$) {\textbf{Cuentas por industrias*}\par
    solo producción y generación de la renta ganada*, en los cuadros de oferta y utilización \tema{3.A.31}};
  \node[txt=4.188cm] (b4) at ($(r3)+(8.15,0)$) {\textbf{Cuentas de los sectores}\hfill\tema{3.A.30}\par
    programa de transmisión revisado\par
    \dif{con el MBP7, también en 2030 \tema{3.B.11}}{cuentas, balanza de pagos y nomenclaturas cambian a la vez}};
  \node[txt=2.988cm] (b5) at ($(r3)+(12.75,0)$) {\textbf{Cuentas por ramas}\par
    \aus{por concretar}};
  \path let \p1=(a4.south), \p2=(a5.south), \p3=(b4.south), \p4=(b5.south) in coordinate (s3) at (0,{min(\y1,\y2,\y3,\y4)});
  \coordinate (r4) at ($(s3)+(0,-0.55)$);
  % Aparte del esquema básico: cuadros y extensiones
  \node[txt=7.588cm] (a6) at ($(r4)+(0,0)$) {\textbf{+ Cuadros y extensiones}\par
    cuadros: input-output \tema{3.A.31} $\cdot$ de quién a quién, con más peso\par
    \difs{cuadros del mercado de trabajo y de los servicios del capital, dentro del marco integrado}
    extensiones: economía informal\par
    \difs{capítulos nuevos: bienestar y sostenibilidad \tema{3.A.30} $\cdot$ digitalización $\cdot$ globalización $\cdot$ finanzas islámicas}
    \difs{cuentas temáticas: trabajo doméstico no remunerado, salud, educación, capital humano}};
  \node[txt=7.588cm] (b6) at ($(r4)+(8.15,0)$) {\textbf{+ Cuadros y extensiones}\par
    \aus{elementos no centrales y cuentas temáticas: introducción gradual después de 2030}};
  \path let \p1=(a6.south), \p2=(b6.south) in coordinate (s4) at (0,{min(\y1,\y2)});
  % Marcos de igual altura en cada fila (los del SEC, discontinuos: aún en preparación)
  \foreach \n/\s/\e in {a1/s1/marco,a2/s1/marco,b1/s1/previsto,b2/s1/previsto,a3/s2/marco,b3/s2/previsto,a4/s3/marco,a5/s3/marco,b4/s3/previsto,b5/s3/previsto,a6/s4/marco,b6/s4/previsto}
    \draw[\e] (\n.north west) rectangle (\n.east |- \s);
  % Flujo: el sistema se abre en dos clasificaciones, que comparten las operaciones y vuelven a separarse en las cuentas
  \foreach \P in {A,B} {
    \draw[linea] (c\P |- y0) -- (c\P |- m0);
    \draw[linea] (l\P |- m0) -- (r\P |- m0);
    \draw[flecha] (l\P |- m0) -- (l\P |- r1);
    \draw[flecha] (r\P |- m0) -- (r\P |- r1);
    \draw[linea] (l\P |- s1) -- (l\P |- m1);
    \draw[linea] (r\P |- s1) -- (r\P |- m1);
    \draw[linea] (l\P |- m1) -- (r\P |- m1);
    \draw[flecha] (c\P |- m1) -- (c\P |- r2);
    \draw[linea] (c\P |- s2) -- (c\P |- m2);
    \draw[linea] (l\P |- m2) -- (r\P |- m2);
    \draw[flecha] (l\P |- m2) -- (l\P |- r3);
    \draw[flecha] (r\P |- m2) -- (r\P |- r3);
  }
  % Separación del esquema básico
  \draw[black!40, dashed] ($(s3)+(0,-0.275)$) -- ++(15.95,0);
  % Leyenda
  \node[anchor=north west, text width=15.95cm, align=left, inner sep=0pt, font=\footnotesize,
    execute at begin node={\hyphenpenalty=10000}] at ($(s4)+(0,-0.3)$) {
    $\neq$ en el SCN 2025: novedad respecto al SCN 2008; en el SEC 2030: diferencia respecto al SCN 2025 \quad $\Rightarrow$ \textit{implicación}\\
    \aus{gris} y marco discontinuo: por concretar \quad \tema{3.A.31} tema en que se trata \quad \textit{Cuadros}: traducción de \textit{tables} (en el SEC, \textit{tablas}).\\[2pt]
    * \textit{Renta ganada} y \textit{renta de transferencias}: nuevos nombres de las cuentas de distribución primaria y secundaria de la renta. \textit{Establecimientos}: UAE locales en el SEC; \textit{industrias}: ramas de actividad.
    \textit{Clasificación funcional}: por ramas de actividad, no la del gasto público. El contenido del SEC 2030 es el previsto por Eurostat en 2026 y puede cambiar en la tramitación del Reglamento.};
\end{tikzpicture}%
