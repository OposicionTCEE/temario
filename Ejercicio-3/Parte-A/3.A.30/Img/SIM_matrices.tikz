% Figura: matrices del modelo SIM de GODLEY y LAVOIE (2007, cap. 3): balance y transacciones de una economía cerrada con hogares, empresas (producción) y Gobierno, y dinero público.
% Fuente de SIM_matrices.pdf.
\providecommand{\opc}[2]{\textbf{#1} {\scriptsize\textcolor{black!65}{#2}}}
\begin{tikzpicture}[>=stealth,
  c/.style={draw=black!70, line width=0.5pt, minimum width=1.7cm, minimum height=0.72cm, font=\small, align=center, anchor=center},
  h/.style={c, fill=black!6, font=\footnotesize\bfseries, minimum height=1.0cm},
  f/.style={c, text width=3.0cm, minimum width=3.3cm, font=\footnotesize, align=left, fill=black!3},
  cor/.style={c, fill=blue!7}, fin/.style={c, fill=red!8}, pn/.style={c, fill=yellow!20},
  vac/.style={c, fill=white},
  cero/.style={c, fill=white, text=black!55, minimum width=0.9cm},
  sig/.style={h, minimum width=0.9cm},
  tit/.style={font=\footnotesize\bfseries\itshape, text=black!70}]
  % Balance
  \matrix (b) [matrix of nodes, column sep=-0.5pt, row sep=-0.5pt, nodes in empty cells]
  {
    |[f, fill=white, draw=none]| & |[h]| Hogares & |[h]| Producción & |[h]| Gobierno & |[sig]| $\Sigma$ \\
    |[f]| \opc{Dinero}{$H$} & |[fin]| $+H$ & |[vac]| & |[fin]| $-H$ & |[cero]| $0$ \\
    |[f, fill=yellow!20]| \opc{Patrimonio neto}{} & |[pn]| $-V_h$ & |[pn]| $0$ & |[pn]| $+H$ & |[cero]| $0$ \\
    |[f, fill=black!6]| \textbf{$\Sigma$} & |[cero, minimum width=1.7cm]| $0$ & |[cero, minimum width=1.7cm]| $0$ & |[cero, minimum width=1.7cm]| $0$ & |[cero]| $0$ \\
  };
  \node[tit, anchor=south west] at ([yshift=0.1cm]b-1-1.north west) {Matriz de balances};
  % Transacciones
  \matrix (t) [matrix of nodes, column sep=-0.5pt, row sep=-0.5pt, nodes in empty cells, anchor=north west] at ([xshift=1.0cm]b-1-5.north east)
  {
    |[f, fill=white, draw=none]| & |[h]| Hogares & |[h]| Producción & |[h]| Gobierno & |[sig]| $\Sigma$ \\
    |[f]| \opc{Consumo}{} & |[cor]| $-C$ & |[cor]| $+C$ & |[vac]| & |[cero]| $0$ \\
    |[f]| \opc{Gasto público}{} & |[vac]| & |[cor]| $+G$ & |[cor]| $-G$ & |[cero]| $0$ \\
    |[f]| \opc{[Producción]}{} & |[vac]| & |[vac, text=black!55]| $[Y]$ & |[vac]| & |[cero]| \\
    |[f]| \opc{Salarios}{} & |[cor]| $+WB$ & |[cor]| $-WB$ & |[vac]| & |[cero]| $0$ \\
    |[f]| \opc{Impuestos}{} & |[cor]| $-T$ & |[vac]| & |[cor]| $+T$ & |[cero]| $0$ \\
    |[f]| \opc{Variación del dinero}{} & |[fin]| $-\Delta H$ & |[vac]| & |[fin]| $+\Delta H$ & |[cero]| $0$ \\
    |[f, fill=black!6]| \textbf{$\Sigma$} & |[cero, minimum width=1.7cm]| $0$ & |[cero, minimum width=1.7cm]| $0$ & |[cero, minimum width=1.7cm]| $0$ & |[cero]| $0$ \\
  };
  \node[tit, anchor=south west] at ([yshift=0.1cm]t-1-1.north west) {Matriz de transacciones};
  \node[font=\scriptsize, text=black!75, anchor=north west, align=left, text width=17.0cm, execute at begin node={\hyphenpenalty=10000}] at ([yshift=-0.3cm]t-8-1.south west -| b-1-1.west)
    {Las empresas no tienen beneficios ni capital: todo lo que venden ($Y=C+G$) lo pagan en salarios ($WB=Y$). El único activo es el dinero que emite el Gobierno al pagar más de lo que recauda, y el único sector que lo acumula son los hogares. La columna de los hogares dice que su ahorro es su adquisición de dinero ($\Delta H=YD-C$); la del Gobierno, que su déficit es la emisión de dinero ($\Delta H=G-T$).};
\end{tikzpicture}
