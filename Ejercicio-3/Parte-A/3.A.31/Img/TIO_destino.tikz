% Figura: tabla de destino de la economía de dos ramas (productos por ramas y usos finales), a precios de adquisición, en notación general.
% Fuente de TIO_destino.pdf. u_{ij}: compras del producto i por la rama j (matriz U, productos por ramas).
% La versión con valores del ejemplo numérico es TIO_destino_num.tikz. Generar con: bash Code/generar_figura.sh TIO_destino
\begin{tikzpicture}[
  celda/.style={draw=black!75, line width=0.5pt, minimum height=0.8cm, minimum width=1.35cm, font=\small, inner sep=2pt, align=center, anchor=center},
  I/.style={fill=blue!12}, II/.style={fill=green!12}, III/.style={fill=red!10}, T/.style={fill=black!8}]
  \matrix (m) [matrix of nodes, nodes={celda}, column sep=-0.5pt, row sep=-0.5pt,
               column 1/.style={nodes={minimum width=3.1cm}}, column 4/.style={nodes={minimum width=1.7cm}},
               column 10/.style={nodes={minimum width=1.7cm}},
               row 1/.style={nodes={minimum height=1.0cm, font=\footnotesize\bfseries}}]
  {
    Productos & $\boldsymbol{S_1}$ & $\boldsymbol{S_2}$ & |[T]| \shortstack{Total\\ CI} & $\boldsymbol{C}$ & $\boldsymbol{CC}$ & $\boldsymbol{FBK}$ & $\boldsymbol{E}$ & |[T]| \shortstack{Total\\ DF} & |[T]| \shortstack{Total\\ empleos} \\
    $\boldsymbol{P_1}$ & |[I]| $u_{11}$ & |[I]| $u_{12}$ & |[T]| $\sum_j u_{1j}$ & |[II]| $C_1$ & |[II]| $CC_1$ & |[II]| $FBK_1$ & |[II]| $E_1$ & |[T]| $D_1$ & |[T]| $TR^a_1$ \\
    $\boldsymbol{P_2}$ & |[I]| $u_{21}$ & |[I]| $u_{22}$ & |[T]| $\sum_j u_{2j}$ & |[II]| $C_2$ & |[II]| $CC_2$ & |[II]| $FBK_2$ & |[II]| $E_2$ & |[T]| $D_2$ & |[T]| $TR^a_2$ \\
    |[T]| \textbf{CI (p.\ adq.)} & |[T]| $\sum_i u_{i1}$ & |[T]| $\sum_i u_{i2}$ & |[T]| $\sum u_{ij}$ & |[T]| $\sum C_i$ & |[T]| $\sum CC_i$ & |[T]| $\sum FBK_i$ & |[T]| $\sum E_i$ & |[T]| $\sum D_i$ & |[T]| $\sum TR^a_i$ \\
    $\boldsymbol{RA_j}$ & |[III]| $RA_1$ & |[III]| $RA_2$ & |[T]| $\sum RA_j$ \\
    $\boldsymbol{EBE_j}$ & |[III]| $EBE_1$ & |[III]| $EBE_2$ & |[T]| $\sum EBE_j$ \\
    |[T]| \textbf{VAB (p.\ básicos)} & |[T]| $VAB_1$ & |[T]| $VAB_2$ & |[T]| $\sum VAB_j$ \\
    |[T]| \textbf{Producción (p.\ b.)} & |[T]| $g_1$ & |[T]| $g_2$ & |[T]| $\sum g_j$ \\
  };
  \draw[decorate, decoration={brace, amplitude=5pt}, thick] ([yshift=2pt]m-1-2.north west) -- ([yshift=2pt]m-1-3.north east)
    node[midway, above=5pt, font=\footnotesize\bfseries] {Ramas};
  \draw[decorate, decoration={brace, amplitude=5pt}, thick] ([yshift=2pt]m-1-5.north west) -- ([yshift=2pt]m-1-8.north east)
    node[midway, above=5pt, font=\footnotesize\bfseries] {Usos finales};
  \node[font=\footnotesize\itshape, text=black!65, align=left, anchor=north west] at ([xshift=0.6cm, yshift=-0.1cm]m-5-4.north east)
    {Empleos de productos a precios de adquisición;\\ valor añadido y producción a precios básicos.\\
     $u_{ij}$: compras del producto $i$ por la rama $j$.\\[3pt]
     Identidad por ramas: $g_j=\sum_i u_{ij}+VAB_j$.\\
     Identidad por productos (oferta $=$ empleos):\\ $TR^a_i=\sum_j u_{ij}+D_i$.};
\end{tikzpicture}
