% Figura: tabla de destino del ejemplo (productos por ramas y usos finales), a precios de adquisición.
% Fuente de TIO_destino.pdf. Recuadro grueso: casillas que difieren de la tabla a precios básicos por el margen comercial.
\begin{tikzpicture}[
  celda/.style={draw=black!75, line width=0.5pt, minimum height=0.8cm, minimum width=1.1cm, font=\small, inner sep=1pt, align=center, anchor=center},
  I/.style={fill=blue!12}, II/.style={fill=green!12}, III/.style={fill=red!10}, T/.style={fill=black!8}, N/.style={line width=1.4pt}]
  \matrix (m) [matrix of nodes, nodes={celda}, column sep=-0.5pt, row sep=-0.5pt,
               column 1/.style={nodes={minimum width=3.1cm}}, row 1/.style={nodes={minimum height=1.0cm, font=\footnotesize\bfseries}}]
  {
    Productos & $\boldsymbol{S_1}$ & $\boldsymbol{S_2}$ & |[T]| \shortstack{Total\\ CI} & $\boldsymbol{C}$ & $\boldsymbol{CC}$ & $\boldsymbol{FBK}$ & $\boldsymbol{E}$ & |[T]| \shortstack{Total\\ DF} & |[T]| \shortstack{Total\\ empleos} \\
    $\boldsymbol{P_1}$ & |[I,N]| $3$ & |[I]| $1$ & |[T]| $4$ & |[II]| $0$ & |[II]| $3$ & |[II]| $0$ & |[II]| $1$ & |[T]| $4$ & |[T]| $8$ \\
    $\boldsymbol{P_2}$ & |[I,N]| $2$ & |[I]| $1$ & |[T]| $3$ & |[II]| $1$ & |[II]| $0$ & |[II]| $1$ & |[II]| $3$ & |[T]| $5$ & |[T]| $8$ \\
    |[T]| \textbf{CI (p.\ adq.)} & |[T]| $5$ & |[T]| $2$ & |[T]| $7$ & |[T]| $1$ & |[T]| $3$ & |[T]| $1$ & |[T]| $4$ & |[T]| $9$ & |[T]| $\mathbf{16}$ \\
    $\boldsymbol{RA_j}$ & |[III]| $1$ & |[III]| $2$ & |[T]| $3$ \\
    $\boldsymbol{EBE_j}$ & |[III]| $0$ & |[III]| $3$ & |[T]| $3$ \\
    |[T]| \textbf{VAB (p.\ básicos)} & |[T]| $1$ & |[T]| $5$ & |[T]| $6$ \\
    |[T]| \textbf{Producción (p.\ b.)} & |[T]| $6$ & |[T]| $7$ & |[T]| $\mathbf{13}$ \\
  };
  \draw[decorate, decoration={brace, amplitude=5pt}, thick] ([yshift=2pt]m-1-2.north west) -- ([yshift=2pt]m-1-3.north east)
    node[midway, above=5pt, font=\footnotesize\bfseries] {Ramas};
  \draw[decorate, decoration={brace, amplitude=5pt}, thick] ([yshift=2pt]m-1-5.north west) -- ([yshift=2pt]m-1-8.north east)
    node[midway, above=5pt, font=\footnotesize\bfseries] {Usos finales};
  \node[font=\footnotesize\itshape, text=black!65, align=left, anchor=north west] at ([xshift=0.6cm, yshift=-0.1cm]m-5-4.north east)
    {Empleos de productos a precios de adquisición;\\ valor añadido y producción a precios básicos.\\[3pt]
     Recuadro grueso: $S_1$ paga $3$ por $P_1$ ($2$ a precios\\ básicos $+\,1$ de margen comercial) y compra a $S_2$\\ solo $2$ como producto: la unidad de comercio\\ va incluida en el precio de $P_1$.\\[3pt]
     Identidad por ramas: $X_j=CI_j+VAB_j$ ($6=5+1$; $7=2+5$).\\
     Identidad por productos: oferta $=$ empleos ($8$ y $8$).};
\end{tikzpicture}
