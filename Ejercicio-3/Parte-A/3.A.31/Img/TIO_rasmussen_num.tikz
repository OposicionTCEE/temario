% Figura: clasificación de las ramas con los índices de RASMUSSEN (1956) y las dos ramas del ejemplo (economía sin importaciones).
% Fuente de TIO_rasmussen_num.pdf (anexo del ejemplo numérico). Generar con: bash Code/generar_figura.sh TIO_rasmussen_num. Eje x: poder de dispersión (hacia atrás); eje y: sensibilidad de dispersión (hacia adelante); líneas: media = 1.
\begin{tikzpicture}[x=6.5cm, y=9cm, >=stealth,
  cuad/.style={font=\small, align=center, text=black!80, text width=3.4cm},
  pto/.style={circle, fill=black, inner sep=2.2pt}]
  % Cuadrantes sombreados (origen en 0,5 para centrar la figura)
  \fill[yellow!14] (0.5,1) rectangle (1,1.25);
  \fill[blue!10] (1,1) rectangle (1.5,1.25);
  \fill[red!8] (1,0.75) rectangle (1.5,1);
  \fill[black!5] (0.5,0.75) rectangle (1,1);
  % Ejes
  \draw[->, line width=0.8pt] (0.5,0.75) -- (1.55,0.75);
  \draw[->, line width=0.8pt] (0.5,0.75) -- (0.5,1.29) node[above right, font=\small, align=left] {sensibilidad de dispersión $U_{i\cdot}$ \footnotesize (hacia adelante)};
  \node[font=\small, align=center, anchor=north] at (1,0.71) {poder de dispersión $U_{\cdot j}$ \footnotesize (hacia atrás)};
  \foreach \t/\l in {0.6/0{,}6,0.8/0{,}8,1.0/1{,}0,1.2/1{,}2,1.4/1{,}4} \draw (\t,0.75) -- (\t,0.743) node[below, font=\footnotesize] {$\l$};
  \foreach \t/\l in {0.8/0{,}8,0.9/0{,}9,1.0/1{,}0,1.1/1{,}1,1.2/1{,}2} \draw (0.5,\t) -- (0.49,\t) node[left, font=\footnotesize] {$\l$};
  % Medias (= 1)
  \draw[dashed, line width=0.8pt] (1,0.75) -- (1,1.25);
  \draw[dashed, line width=0.8pt] (0.5,1) -- (1.5,1);
  % Etiquetas de los cuadrantes
  \node[cuad] at (0.75,1.19) {\textbf{Sectores base}\\ \footnotesize abastecen al sistema, compran poco};
  \node[cuad] at (1.25,1.19) {\textbf{Sectores clave}\\ \footnotesize arrastran y abastecen};
  \node[cuad] at (1.25,0.80) {\textbf{Sectores motores}\\ \footnotesize arrastran, venden a la DF};
  \node[cuad] at (0.75,0.80) {\textbf{Sectores independientes}\\ \footnotesize poco relacionados};
  % Ramas del ejemplo
  \node[pto, label={[font=\small]right:$S_1\ (1{,}25;\ 0{,}92)$}] at (1.253,0.923) {};
  \node[pto, label={[font=\small]below:$S_2\ (0{,}75;\ 1{,}08)$}] at (0.747,1.077) {};
\end{tikzpicture}
