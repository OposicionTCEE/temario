% Figura: clasificación de CHENERY y WATANABE (1958) de las ramas según sus eslabonamientos directos, en notación general.
% Fuente de TIO_chenery.pdf. Eje x: eslabonamiento hacia atrás (mu); eje y: hacia adelante (omega); líneas: medias.
% La versión con las dos ramas del ejemplo numérico es TIO_chenery_num.tikz. Generar con: bash Code/generar_figura.sh TIO_chenery
\begin{tikzpicture}[x=9cm, y=9cm, >=stealth,
  cuad/.style={font=\small, align=center, text=black!80}]
  % Cuadrantes sombreados
  \fill[yellow!14] (0,0.38) rectangle (0.4,0.75);
  \fill[blue!10] (0.4,0.38) rectangle (0.8,0.75);
  \fill[red!8] (0.4,0) rectangle (0.8,0.38);
  \fill[black!5] (0,0) rectangle (0.4,0.38);
  % Ejes
  \draw[->, line width=0.8pt] (0,0) -- (0.84,0);
  \node[font=\small, align=center, anchor=north] at (0.42,-0.075) {hacia atrás $\mu_j=U^d_j/X_j$ \footnotesize (compras intermedias interiores / producción)};
  \draw[->, line width=0.8pt] (0,0) -- (0,0.79) node[above right, font=\small, align=left] {hacia adelante $\omega_i=W^d_i/X_i$ \footnotesize (ventas intermedias interiores / producción)};
  % Medias
  \draw[dashed, line width=0.8pt] (0.4,0) -- (0.4,0.75);
  \node[below=1pt, font=\footnotesize] at (0.4,0) {$\bar\mu=\frac{1}{n}\sum_j\mu_j$};
  \draw[dashed, line width=0.8pt] (0,0.38) -- (0.8,0.38) node[right, font=\footnotesize] {$\bar\omega=\frac{1}{n}\sum_i\omega_i$};
  % Etiquetas de los cuadrantes
  \node[cuad] at (0.2,0.6) {\textbf{I. Producción primaria}\\ \textbf{intermedia}\\ \footnotesize $\mu_j<\bar\mu$, $\omega_j>\bar\omega$\\ vende a otras ramas,\\ compra poco};
  \node[cuad] at (0.6,0.6) {\textbf{II. Manufactura}\\ \textbf{intermedia}\\ \footnotesize $\mu_j>\bar\mu$, $\omega_j>\bar\omega$\\ compra y vende\\ a otras ramas\\ (sectores clave)};
  \node[cuad] at (0.6,0.18) {\textbf{III. Manufactura final}\\ \footnotesize $\mu_j>\bar\mu$, $\omega_j<\bar\omega$\\ compra a otras ramas,\\ vende a la DF};
  \node[cuad] at (0.2,0.18) {\textbf{IV. Producción}\\ \textbf{primaria final}\\ \footnotesize $\mu_j<\bar\mu$, $\omega_j<\bar\omega$\\ ni compra ni vende\\ a otras ramas};
\end{tikzpicture}
