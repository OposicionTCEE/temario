% Figura: clasificación de CHENERY y WATANABE (1958) con las dos ramas del ejemplo (flujos interiores).
% Fuente de TIO_chenery.pdf. Eje x: eslabonamiento hacia atrás (mu); eje y: hacia adelante (omega); líneas: medias.
\begin{tikzpicture}[x=9cm, y=9cm, >=stealth,
  cuad/.style={font=\small, align=center, text=black!80, text width=3.3cm},
  pto/.style={circle, fill=black, inner sep=2.2pt}]
  % Cuadrantes sombreados
  \fill[yellow!14] (0,0.381) rectangle (0.405,0.75);
  \fill[blue!10] (0.405,0.381) rectangle (0.8,0.75);
  \fill[red!8] (0.405,0) rectangle (0.8,0.381);
  \fill[black!5] (0,0) rectangle (0.405,0.381);
  % Ejes
  \draw[->, line width=0.8pt] (0,0) -- (0.84,0);
  \node[font=\small, align=center, anchor=north] at (0.42,-0.06) {hacia atrás $\mu_j$ \footnotesize (compras intermedias / producción)};
  \draw[->, line width=0.8pt] (0,0) -- (0,0.79) node[above right, font=\small, align=left] {hacia adelante $\omega_i$ \footnotesize (ventas intermedias / producción)};
  \foreach \t/\l in {0.2/0{,}2,0.4/0{,}4,0.6/0{,}6,0.8/0{,}8} \draw (\t,0) -- (\t,-0.012) node[below, font=\footnotesize] {$\l$};
  \foreach \t/\l in {0.2/0{,}2,0.4/0{,}4,0.6/0{,}6} \draw (0,\t) -- (-0.012,\t) node[left, font=\footnotesize] {$\l$};
  % Medias
  \draw[dashed, line width=0.8pt] (0.405,0) -- (0.405,0.75) node[above, font=\footnotesize] {$\bar\mu=0{,}40$};
  \draw[dashed, line width=0.8pt] (0,0.381) -- (0.8,0.381) node[right, font=\footnotesize] {$\bar\omega=0{,}38$};
  % Etiquetas de los cuadrantes
  \node[cuad] at (0.2,0.64) {\textbf{I. Producción primaria}\\ \textbf{intermedia}\\ \footnotesize vende a otras ramas, compra poco};
  \node[cuad] at (0.6,0.64) {\textbf{II. Manufactura}\\ \textbf{intermedia}\\ \footnotesize compra y vende a otras ramas};
  \node[cuad] at (0.6,0.13) {\textbf{III. Manufactura final}\\ \footnotesize compra a otras ramas, vende a la DF};
  \node[cuad] at (0.2,0.13) {\textbf{IV. Producción primaria final}\\ \footnotesize ni compra ni vende a otras ramas};
  % Ramas del ejemplo
  \node[pto, label={[font=\small]right:$S_1\ (0{,}67;\ 0{,}33)$}] at (0.667,0.333) {};
  \node[pto, label={[font=\small]right:$S_2\ (0{,}14;\ 0{,}43)$}] at (0.143,0.429) {};
\end{tikzpicture}
