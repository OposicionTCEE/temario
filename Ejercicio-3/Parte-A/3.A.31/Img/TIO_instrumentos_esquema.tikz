% Figura: esquema de una página de los instrumentos analíticos (anexo de esquemas), como secuencia
% problema (qué dice la tabla sin hipótesis) -> herramienta (coeficientes técnicos y de distribución)
% -> solución (eslabonamientos directos: CHENERY y WATANABE, STREIT) -> límite (paso al modelo) -> glosario.
% Coordenadas absolutas en cm, origen en la esquina superior izquierda. Generar con: bash Code/generar_figura.sh TIO_instrumentos_esquema
\begin{tikzpicture}[>=stealth,
  caja/.style={draw=black!70, rounded corners=3pt, line width=0.6pt, align=left, font=\footnotesize, inner sep=4pt},
  panel/.style={caja, anchor=north west},
  sec/.style={font=\small\bfseries, anchor=north west},
  tit/.style={font=\footnotesize, anchor=north west, align=left},
  flecha/.style={->, line width=0.8pt, black!70},
  mc/.style={draw=black!70, minimum width=0.85cm, minimum height=0.55cm, font=\footnotesize, inner sep=1pt, anchor=center},
  mapa/.style={draw=black!70, minimum width=1.85cm, minimum height=1.0cm, text width=1.75cm, align=center, font=\footnotesize, inner sep=1pt}]

  % ================= EL PROBLEMA =================
  \node[sec, text=red!50!black] at (0,0) {El problema};
  \node[caja, fill=red!6, text width=15.15cm, anchor=north west] (P) at (0,-0.45)
    {\textbf{¿Qué dice la tabla por sí sola, sin añadir ninguna hipótesis?} Los flujos dependen del tamaño de cada rama: para comparar ramas, países o años hay que pasarlos a proporciones.};

  % ================= LA HERRAMIENTA: COEFICIENTES =================
  \node[sec, text=blue!50!black] at (0,-1.6) {La herramienta: los coeficientes, la tabla en proporciones};
  \node[panel, fill=blue!4, minimum width=7.55cm, minimum height=3.3cm] (L) at (0,-2.05) {};
  \node[panel, fill=green!4, minimum width=7.55cm, minimum height=3.3cm] (R) at (8.15,-2.05) {};
  % Por columnas
  \begin{scope}[shift={(0,-2.05)}]
    \node[tit] at (0.12,-0.1) {\textbf{Por columnas: coeficientes técnicos}};
    \matrix (ga) [matrix of math nodes, nodes={mc}, column sep=-0.4pt, row sep=-0.4pt, anchor=north west] at (0.25,-0.75)
      { x_{11} & |[fill=blue!22]| x_{12} \\ x_{21} & |[fill=blue!22]| x_{22} \\ };
    \node[font=\footnotesize, text=blue!55!black, anchor=north] at ([yshift=-1pt]ga-2-2.south) {$\div X_2$};
    \node[tit, text width=5.15cm] at (2.2,-0.6)
      {$a_{ij}=x_{ij}/X_j$: lo que $j$ necesita de $i$ por unidad producida. \textbf{La receta.}\\[2pt]
       Con $v_j=VAB_j/X_j$: $\sum_i a_{ij}+v_j=1$, luego $\sum_i a_{ij}<1$.\\[2pt]
       Depende de la tecnología: es razonable tratarlo como estable.};
  \end{scope}
  % Por filas
  \begin{scope}[shift={(8.15,-2.05)}]
    \node[tit] at (0.12,-0.1) {\textbf{Por filas: coeficientes de distribución}};
    \matrix (gb) [matrix of math nodes, nodes={mc}, column sep=-0.4pt, row sep=-0.4pt, anchor=north west] at (0.25,-0.75)
      { |[fill=green!25]| x_{11} & |[fill=green!25]| x_{12} \\ x_{21} & x_{22} \\ };
    \node[font=\footnotesize, text=green!45!black, anchor=north] at ([yshift=-1pt]$(gb-2-1.south)!0.5!(gb-2-2.south)$) {fila 1 $\div\, TR_1$};
    \node[tit, text width=5.15cm] at (2.2,-0.6)
      {$b_{ij}=x_{ij}/TR_i$: qué parte de la oferta de $i$ va a $j$. \textbf{El mercado.}\\[2pt]
       Con la parte que va a la demanda final, $D_i/TR_i$, cada fila suma $1$.\\[2pt]
       Depende de la demanda de los clientes: poco estable (de ahí la crítica al modelo de GHOSH).};
  \end{scope}
  % Dos advertencias
  \node[panel, fill=black!3, text width=7.25cm, minimum height=1.6cm] (W1) at (0,-5.6)
    {\textbf{Según el origen:} $a_{ij}=a^d_{ij}+a^m_{ij}$, y $m_j=\sum_i a^m_{ij}$ es el contenido importado directo. Los totales describen la tecnología (comparar); los interiores, el arrastre sobre la producción nacional.};
  \node[panel, fill=black!3, text width=7.25cm, minimum height=1.6cm] (W2) at (8.15,-5.6)
    {\textbf{Cuidado: son monetarios.} $a_{ij}=\dfrac{q_{ij}}{Q_j}\cdot\dfrac{p_i}{p_j}$: técnica física por precio relativo. Si cambian los precios relativos, cambia $a_{ij}$ aunque la técnica sea la misma.};

  % ================= LA SOLUCIÓN: ESLABONAMIENTOS DIRECTOS =================
  \node[sec, text=blue!50!black] at (0,-7.55) {La solución: los eslabonamientos directos, la posición de cada rama en la red (con flujos interiores)};
  \node[panel, fill=black!2, minimum width=5.0cm, minimum height=4.4cm] (A) at (0,-8.0) {};
  \node[panel, fill=blue!3, minimum width=5.35cm, minimum height=4.4cm] (B) at (5.18,-8.0) {};
  \node[panel, fill=blue!3, minimum width=5.0cm, minimum height=4.4cm] (C) at (10.7,-8.0) {};

  % Panel A: mapa de medidas
  \begin{scope}[shift={(0,-8.0)}]
    \node[tit] at (0.12,-0.1) {\textbf{Dos dimensiones}};
    \node[font=\footnotesize, anchor=south] at (2.08,-1.0) {global};
    \node[font=\footnotesize, anchor=south] at (3.93,-1.0) {bilateral};
    \node[font=\footnotesize, anchor=east] at (1.13,-1.5) {directo};
    \node[font=\footnotesize, anchor=east] at (1.13,-2.5) {total};
    \node[mapa, fill=blue!18] at (2.08,-1.5) {CHENERY y WATANABE};
    \node[mapa, fill=blue!18] at (3.93,-1.5) {STREIT};
    \node[mapa, fill=green!15] at (2.08,-2.5) {RASMUSSEN};
    \node[mapa, fill=green!15] at (3.93,-2.5) {$l_{ij}$ de la inversa};
    \node[tit, text width=4.55cm] at (0.12,-3.1)
      {\textcolor{blue!55!black}{\textbf{Azul}}: solo coeficientes (aquí). \textcolor{green!45!black}{\textbf{Verde}}: exigen el modelo (bloque 2).};
  \end{scope}

  % Panel B: CHENERY y WATANABE
  \begin{scope}[shift={(5.18,-8.0)}]
    \node[tit] at (0.12,-0.1) {\textbf{CHENERY y WATANABE (1958)}: globales};
    \node[tit, text width=5.2cm] at (0.12,-0.5)
      {Atrás, $\mu_j=\sum_i a_{ij}$ (columna); adelante, $\omega_i=\sum_j b_{ij}$ (fila); frente a la media.};
    \draw[->, line width=0.7pt] (0.6,-4.0) -- (5.2,-4.0) node[anchor=north east, font=\footnotesize] {$\mu_j$};
    \draw[->, line width=0.7pt] (0.6,-4.0) -- (0.6,-1.5) node[anchor=north east, font=\footnotesize] {$\omega_i$};
    \draw[dashed, black!60] (2.9,-1.5) -- (2.9,-4.0) node[anchor=north, font=\footnotesize] {$\bar\mu$};
    \draw[dashed, black!60] (0.6,-2.75) -- (5.1,-2.75);
    \node[font=\footnotesize, anchor=east] at (0.6,-2.75) {$\bar\omega$};
    \fill[blue!15] (2.92,-1.5) rectangle (5.1,-2.73);
    \node[font=\footnotesize, align=center] at (4.0,-2.12) {\textbf{Manufactura}\\ \textbf{intermedia}: clave};
    \node[font=\footnotesize, align=center] at (4.0,-3.37) {Manufactura\\ final};
    \node[font=\footnotesize, align=center] at (1.75,-2.12) {Primaria\\ intermedia};
    \node[font=\footnotesize, align=center] at (1.75,-3.37) {Primaria\\ final};
  \end{scope}

  % Panel C: STREIT
  \begin{scope}[shift={(10.7,-8.0)}]
    \node[tit] at (0.12,-0.1) {\textbf{STREIT (1969)}: bilaterales};
    \node[circle, draw=black!70, fill=blue!12, minimum size=0.8cm, font=\footnotesize] (si) at (1.0,-1.45) {$i$};
    \node[circle, draw=black!70, fill=blue!12, minimum size=0.8cm, font=\footnotesize] (sj) at (4.1,-1.45) {$j$};
    \draw[->, line width=0.8pt] (si) to[bend left=22] node[midway, above, font=\footnotesize] {$x_{ij}$} (sj);
    \draw[->, line width=0.8pt] (sj) to[bend left=22] node[midway, below, font=\footnotesize] {$x_{ji}$} (si);
    \node[tit, text width=4.7cm] at (0.12,-2.25)
      {Cuatro ligazones, dos por sentido: de oferta, $x_{ij}/W_i$ ($j$ como cliente), y de demanda, $x_{ij}/U_j$ ($i$ como proveedor).\\[2pt]
       $ST_{ij}$, su media $\to$ \textbf{complejos industriales} y su sector polarizante.};
  \end{scope}

  % ================= EL LÍMITE: PASO AL MODELO =================
  \node[caja, fill=orange!8, draw=orange!80!black, text width=15.15cm, anchor=north west] (Lim) at (0,-12.7)
    {\textbf{El límite: tres cosas que las medidas directas no ven.} (i) Solo la primera ronda de compras: ignoran los efectos indirectos. (ii) Son proporciones sin ponderar: ignoran el tamaño de la rama. (iii) No miden la dispersión: no distinguen un arrastre concentrado de uno repartido. Corregirlo exige la inversa de LEONTIEF, es decir, suponer coeficientes fijos: es el \textbf{modelo} (esquema siguiente, con RASMUSSEN).};

  % ================= GLOSARIO =================
  \node[caja, fill=black!3, anchor=north west, inner sep=5pt, text width=15.15cm] at ([yshift=-0.35cm]Lim.south west)
    {\textbf{Glosario de notación.} {\itshape $i$: rama vendedora (fila); $j$: rama compradora (columna).}\\[2pt]
     \renewcommand{\arraystretch}{1.05}%
     \begin{tabular}{@{}>{$}l<{$}@{\;\;}>{\raggedright\arraybackslash}p{3.6cm}@{\quad}>{$}l<{$}@{\;\;}>{\raggedright\arraybackslash}p{3.6cm}@{\quad}>{$}l<{$}@{\;\;}>{\raggedright\arraybackslash}p{3.6cm}@{}}
       a_{ij} & coeficiente técnico & m_j & contenido importado directo & \mu_j,\,\bar\mu & eslabonamiento atrás; media \\
       b_{ij} & coeficiente de distribución & q_{ij},\,Q_j & cantidades físicas & \omega_i,\,\bar\omega & eslabonamiento adelante; media \\
       v_j & valor añadido por unidad & p_i & precio del producto de $i$ & ST_{ij} & coeficiente de STREIT \\
       a^d_{ij},\,a^m_{ij} & parte interior e importada & X_j,\,TR_i & producción; oferta total & l_{ij} & elemento de la inversa \\
       W_i,\,U_j & ventas y compras intermedias & & & & \\
     \end{tabular}};
\end{tikzpicture}
