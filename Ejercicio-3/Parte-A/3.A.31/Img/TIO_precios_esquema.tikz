% Figura: esquema de una página del modelo de precios (anexo de esquemas), como secuencia
% problema -> herramienta (hipótesis propias: qué suponen y qué pasa si fallan) -> solución (ecuación, transmisión,
% una matriz y dos lecturas con la dualidad, economía abierta) -> usos y límites -> glosario.
% Generar con: bash Code/generar_figura.sh TIO_precios_esquema
\begin{tikzpicture}[>=stealth,
  caja/.style={draw=black!70, rounded corners=3pt, line width=0.6pt, align=left, font=\footnotesize, inner sep=4pt},
  panel/.style={caja, anchor=north west},
  sec/.style={font=\small\bfseries, anchor=north west},
  tit/.style={font=\footnotesize, anchor=north west, align=left},
  mc/.style={draw=black!70, minimum width=0.8cm, minimum height=0.55cm, font=\footnotesize, inner sep=1pt, anchor=center}]

  % ================= EL PROBLEMA =================
  \node[sec, text=red!50!black] at (0,0) {El problema};
  \node[caja, fill=red!6, text width=15.15cm, anchor=north west] (P) at (0,-0.45)
    {\textbf{Si cambia un coste en una rama (salarios, impuestos, energía importada, productividad), ¿cuánto suben los precios de todas?} Es la pregunta inversa a la del modelo de demanda: los costes se transmiten hacia adelante, de los proveedores a sus clientes.};

  % ================= LA HERRAMIENTA: LAS HIPÓTESIS =================
  \node[sec, text=blue!50!black] (hH) at ([yshift=-0.3cm]P.south west) {La herramienta: los supuestos};
  \node[caja, fill=blue!4, text width=15.15cm, anchor=north west] (H) at ([yshift=-0.12cm]hH.south west)
    {Comparte las del modelo de demanda, sobre todo los \textbf{coeficientes fijos}. La tabla está en valores: los precios iniciales son $1$ y el modelo da \textbf{índices} de precios.\\[3pt]
     \renewcommand{\arraystretch}{1.12}%
     \begin{tabular}{@{}>{\raggedright\arraybackslash}p{3.0cm}@{\quad}>{\raggedright\arraybackslash}p{4.9cm}@{\quad}>{\raggedright\arraybackslash}p{6.4cm}@{}}
       \textbf{Hipótesis} & \textbf{Qué supone} & \textbf{Si falla} \\ \hline
       Precio $=$ coste unitario & $p_j=\sum_i a_{ij}p_i+v_j$: traslación íntegra, excedente por unidad constante & con márgenes porcentuales, la traslación es mayor; con poder de mercado y demanda elástica, menor \\
       Valor añadido por unidad exógeno & salarios, impuestos y márgenes por unidad, $v_j$, dados & con indiciación salarial hay efectos de segunda ronda, que el modelo no recoge \\
       Precios y cantidades separados & ni la demanda ni la técnica responden a los precios & el resultado es un \textbf{techo} \\
     \end{tabular}};

  % ================= LA SOLUCIÓN: CADENA DE PASOS =================
  % Cada paso: [qué se hace y su fórmula] [qué significa] [ilustración]; entre pasos, la maniobra que lleva al siguiente.
  \tikzset{paso/.style={draw=black!70, rounded corners=3pt, line width=0.6pt, fill=blue!3, minimum width=15.43cm, minimum height=1.45cm, anchor=north west, inner sep=0pt},
           num/.style={circle, fill=black!80, text=white, font=\footnotesize\bfseries, inner sep=1.2pt, minimum size=0.45cm},
           enlace/.style={->, line width=1pt, blue!50!black},
           maniobra/.style={font=\footnotesize\itshape, text=blue!50!black, anchor=west}}
  \node[sec, text=blue!50!black] (hS) at ([yshift=-0.3cm]H.south west) {La solución: la ecuación de precios};

  % Paso 1: del dato a la regla
  \node[paso] (k1) at ([yshift=-0.15cm]hS.south west) {};
  \node[num] at (k1.north west) {1};
  \begin{scope}[shift={(k1.north west)}]
    \node[tit, text width=4.1cm] at (0.25,-0.1) {\textbf{Del dato a la regla}\\[1pt] $p_j=\sum_i a_{ij}p_i+v_j$\\[1pt] $\Rightarrow\;p'=p'A+v'$};
    \node[tit, text width=6.4cm] at (4.6,-0.1) {La \textbf{columna} en proporciones, $1=\sum_i a_{ij}+v_j$, es una identidad; valorando cada input a su precio pasa a ser una ecuación de precios, con $v_j$ como dato.};
    \fill[blue!30] (11.4,-0.75) rectangle ++(1.3,0.45);
    \fill[blue!18] (12.7,-0.75) rectangle ++(1.0,0.45);
    \fill[red!25] (13.7,-0.75) rectangle ++(1.5,0.45);
    \draw[black!60] (11.4,-0.75) rectangle (15.2,-0.3);
    \node[font=\footnotesize] at (12.05,-0.53) {$a_{1j}p_1$};
    \node[font=\footnotesize] at (13.2,-0.53) {$a_{2j}p_2$};
    \node[font=\footnotesize] at (14.45,-0.53) {$v_j$};
    \node[font=\footnotesize, anchor=north] at (13.3,-0.8) {precio de $j$: $p_j$};
  \end{scope}

  % Paso 2: resolver
  \node[paso] (k2) at ([yshift=-0.42cm]k1.south west) {};
  \node[num] at (k2.north west) {2};
  \draw[enlace] ([xshift=2.2cm]k1.south west) -- ([xshift=2.2cm]k2.north west) node[midway, maniobra, xshift=2pt] {se despeja $p'$};
  \begin{scope}[shift={(k2.north west)}]
    \node[tit, text width=4.1cm] at (0.25,-0.1) {\textbf{Resolver: la misma inversa}\\[1pt] $p'=v'(I-A)^{-1}=v'L$\\[1pt] $=v'+v'A+v'A^2+\dots$};
    \node[tit, text width=6.4cm] at (4.6,-0.1) {El precio suma el valor añadido directo y el incorporado en los inputs, en los de los inputs\dots: \textbf{rondas hacia adelante}. Base: $p'=1'$; simular: $\Delta p'=\Delta v'L$.};
    \foreach \x/\h/\l in {11.6/0.75/v', 12.2/0.45/v'A, 12.85/0.27/v'A^2} {
      \fill[red!25] (\x-0.2,-1.15) rectangle ++(0.4,\h);
      \node[font=\footnotesize, anchor=north] at (\x,-1.15) {$\l$};
    }
    \node[font=\footnotesize] at (13.4,-1.05) {$\dots$};
    \node[font=\footnotesize] at (13.85,-0.8) {$\Rightarrow$};
    \fill[red!25] (14.25,-1.15) rectangle ++(0.45,0.75); \fill[red!15] (14.25,-0.4) rectangle ++(0.45,0.25);
    \draw[black!60] (14.25,-1.15) rectangle (14.7,-0.12);
    \node[font=\footnotesize, anchor=north] at (14.48,-1.15) {$p'$};
  \end{scope}

  % Paso 3: transmisión
  \node[paso] (k3) at ([yshift=-0.42cm]k2.south west) {};
  \node[num] at (k3.north west) {3};
  \draw[enlace] ([xshift=2.2cm]k2.south west) -- ([xshift=2.2cm]k3.north west) node[midway, maniobra, xshift=2pt] {se lee $L$ por filas};
  \begin{scope}[shift={(k3.north west)}]
    \node[tit, text width=4.1cm] at (0.25,-0.1) {\textbf{Medir la transmisión}\\[1pt] fila $i$ de $L$: $\Delta p_j=l_{ij}\,\Delta v_i$};
    \node[tit, text width=6.4cm] at (4.6,-0.1) {Si suben los salarios de $S_2$, $p_1$ sube $l_{21}\Delta v_2$ sin que cambien sus costes directos (compra a $S_2$), y $p_2$, $l_{22}\Delta v_2\geq\Delta v_2$. Lo indirecto puede superar a lo directo.};
    \fill[red!30] (11.75,-1.0) rectangle ++(0.6,0.55);
    \fill[red!20] (12.95,-1.0) rectangle ++(0.6,0.8);
    \fill[red!12] (14.15,-1.0) rectangle ++(0.6,0.3);
    \draw[black!50] (11.55,-1.0) -- (14.95,-1.0);
    \node[font=\footnotesize, anchor=north] at (12.05,-1.02) {$\Delta v_2$};
    \node[font=\footnotesize, anchor=north] at (13.25,-1.02) {$\Delta p_2$};
    \node[font=\footnotesize, anchor=north] at (14.45,-1.02) {$\Delta p_1$};
  \end{scope}

  % Paso 4: economía abierta
  \node[paso, fill=yellow!6] (k4) at ([yshift=-0.42cm]k3.south west) {};
  \node[num] at (k4.north west) {4};
  \draw[enlace] ([xshift=2.2cm]k3.south west) -- ([xshift=2.2cm]k4.north west) node[midway, maniobra, xshift=2pt] {se abre la economía: entran los precios de importación};
  \begin{scope}[shift={(k4.north west)}]
    \node[tit, text width=4.1cm] at (0.25,-0.1) {\textbf{Abrir: la inflación importada}\\[1pt] $p'=\left(v'+p^{m\prime}A^m\right)L^d$};
    \node[tit, text width=6.4cm] at (4.6,-0.1) {$p^m$ es un coste exógeno más y se transmite con la inversa \textbf{interior}: se importa inflación según el contenido importado directo e indirecto (energía, depreciación).};
    \node[draw=black!60, fill=yellow!40, rounded corners=2pt, font=\footnotesize, inner sep=2pt] (pm) at (11.75,-0.72) {$p^m_1$};
    \node[draw=black!60, fill=blue!15, rounded corners=2pt, font=\footnotesize, inner sep=2pt] (s1) at (13.05,-0.72) {$S_1$};
    \node[draw=black!60, fill=blue!15, rounded corners=2pt, font=\footnotesize, inner sep=2pt] (s2) at (14.6,-0.72) {$S_2$};
    \draw[->, line width=0.8pt] (pm) -- node[above, font=\footnotesize] {$a^m_{11}$} (s1);
    \draw[->, line width=0.8pt] (s1) -- node[above, font=\footnotesize] {$l^d$} (s2);
    \node[font=\footnotesize, anchor=north] at (13.6,-1.0) {$S_2$ sube sin importar};
  \end{scope}

  % Paso 5: dualidad
  \node[paso, fill=green!4] (k5) at ([yshift=-0.42cm]k4.south west) {};
  \node[num] at (k5.north west) {5};
  \draw[enlace] ([xshift=2.2cm]k4.south west) -- ([xshift=2.2cm]k5.north west) node[midway, maniobra, xshift=2pt] {se compara con el modelo de demanda};
  \begin{scope}[shift={(k5.north west)}]
    \node[tit, text width=4.1cm] at (0.25,-0.1) {\textbf{Cerrar: la dualidad}\\[1pt] $p'D=v'L\,D=v'X$\\[1pt] GHOSH: la misma lectura por filas};
    \node[tit, text width=6.4cm] at (4.6,-0.1) {La misma matriz leída al revés: la demanda arrastra \textbf{hacia atrás} (columna) y los costes empujan \textbf{hacia adelante} (fila); el PIB por el gasto iguala al de la renta.};
    \matrix (m5) [matrix of math nodes, nodes={mc}, column sep=-0.4pt, row sep=-0.4pt, anchor=north west] at (11.2,-0.12)
      { |[fill=violet!22]| l_{11} & |[fill=red!22]| l_{12} \\ |[fill=blue!22]| l_{21} & l_{22} \\ };
    \node[font=\footnotesize, anchor=west, align=left] at ([xshift=3pt]$(m5-1-2.east)!0.5!(m5-2-2.east)$) {\textcolor{blue!55!black}{columna}: demanda\\ \textcolor{red!55!black}{fila}: precios};
  \end{scope}

  % ================= USOS Y LÍMITES =================
  \node[sec, text=black!75] (hU) at ([yshift=-0.3cm]k5.south west) {Para qué sirve y dónde falla};
  \node[panel, fill=green!5, text width=7.1cm, minimum height=3.45cm] (U) at ([yshift=-0.12cm]hU.south west)
    {\textbf{Usos} ($\Delta p'=\Delta v'L$)\\[2pt]
     \textbf{Inflación}: efectos directos e indirectos (la energía en la subyacente de 2022).\\
     \textbf{Impuestos indirectos} y precio del carbono: traslación y progresividad.\\
     \textbf{Rentas y competitividad}: salarios, salario mínimo, tipo de cambio.\\
     \textbf{Competencia y regulación}: abaratar los inputs de muchas ramas (energía, transporte) abarata toda la economía.};
  \node[panel, fill=orange!6, text width=7.1cm, minimum height=3.45cm] (Li) at ([xshift=0.65cm]U.north east)
    {\textbf{Límites} ($\to$ alternativa)\\[2pt]
     Traslación completa e inmediata: un techo a largo plazo.\\
     Márgenes fijos: sin poder de mercado ($\to$ márgenes endógenos).\\
     Sin sustitución: exagera las perturbaciones grandes.\\
     $v$ exógeno: sin espiral de precios y salarios.\\
     Precios y cantidades separados ($\to$ equilibrio general aplicado).\\
     Medida: precios básicos, no el IPC.};

  % ================= GLOSARIO =================
  \node[caja, fill=black!3, anchor=north west, inner sep=5pt, text width=15.15cm] at ([yshift=-0.35cm]U.south west)
    {\textbf{Glosario de notación.} {\itshape $p'$, $v'$: vectores fila; $1'$: vector fila de unos.}\\[2pt]
     \renewcommand{\arraystretch}{1.05}%
     \begin{tabular}{@{}>{$}l<{$}@{\;\;}>{\raggedright\arraybackslash}p{3.6cm}@{\quad}>{$}l<{$}@{\;\;}>{\raggedright\arraybackslash}p{3.6cm}@{\quad}>{$}l<{$}@{\;\;}>{\raggedright\arraybackslash}p{3.6cm}@{}}
       p',\,p_j & precios (índices) & A,\,L & coeficientes técnicos; inversa & A^d,\,A^m & interiores e importados \\
       v',\,v_j & valor añadido por unidad & l_{ij} & elemento de la inversa & p^m & precios de importación \\
       \Delta v,\,\Delta p & variaciones & D,\,X & demanda final; producción & & \\
     \end{tabular}};
\end{tikzpicture}
