% Figura: esquema de una página del modelo de precios (anexo de esquemas), como secuencia
% problema -> herramienta (hipótesis propias: qué suponen y qué pasa si fallan) -> solución (ecuación, transmisión,
% una matriz y dos lecturas con la dualidad, economía abierta) -> usos y límites -> glosario.
% Generar con: bash Code/generar_figura.sh TIO_precios_esquema
\begin{tikzpicture}[>=stealth,
  caja/.style={draw=black!70, rounded corners=3pt, line width=0.6pt, align=left, font=\footnotesize, inner sep=4pt},
  panel/.style={caja, anchor=north west},
  sec/.style={font=\small\bfseries, anchor=north west},
  tit/.style={font=\footnotesize, anchor=north west, align=left},
  mc/.style={draw=black!70, minimum width=0.8cm, minimum height=0.55cm, font=\footnotesize, inner sep=1pt, anchor=center}]

  % ================= EL PROBLEMA =================
  \node[sec, text=red!50!black] at (0,0) {El problema};
  \node[caja, fill=red!6, text width=15.15cm, anchor=north west] (P) at (0,-0.45)
    {\textbf{Si cambia un coste en una rama (salarios, impuestos, energía importada, productividad), ¿cuánto suben los precios de todas?} Es la pregunta inversa a la del modelo de demanda: los costes se transmiten hacia adelante, de los proveedores a sus clientes.};

  % ================= LA HERRAMIENTA: LAS HIPÓTESIS =================
  \node[sec, text=blue!50!black] (hH) at ([yshift=-0.3cm]P.south west) {La herramienta: las hipótesis del modelo de demanda y tres propias};
  \node[caja, fill=blue!4, text width=15.15cm, anchor=north west] (H) at ([yshift=-0.12cm]hH.south west)
    {Comparte las del modelo de demanda, sobre todo los \textbf{coeficientes fijos}. La tabla está en valores: los precios iniciales son $1$ y el modelo da \textbf{índices} de precios.\\[3pt]
     \renewcommand{\arraystretch}{1.12}%
     \begin{tabular}{@{}>{\raggedright\arraybackslash}p{3.0cm}@{\quad}>{\raggedright\arraybackslash}p{4.9cm}@{\quad}>{\raggedright\arraybackslash}p{6.4cm}@{}}
       \textbf{Hipótesis} & \textbf{Qué supone} & \textbf{Si falla} \\ \hline
       Precio $=$ coste unitario & $p_j=\sum_i a_{ij}p_i+v_j$: traslación íntegra, excedente por unidad constante & con márgenes porcentuales, la traslación es mayor; con poder de mercado y demanda elástica, menor \\
       Valor añadido por unidad exógeno & salarios, impuestos y márgenes por unidad, $v_j$, dados & con indiciación salarial hay efectos de segunda ronda, que el modelo no recoge \\
       Precios y cantidades separados & ni la demanda ni la técnica responden a los precios & el resultado es un \textbf{techo} \\
     \end{tabular}};

  % ================= LA SOLUCIÓN =================
  \node[sec, text=blue!50!black] (hS) at ([yshift=-0.3cm]H.south west) {La solución: la misma inversa, leída por filas};
  \node[panel, fill=blue!3, minimum width=7.55cm, minimum height=3.3cm] (S1) at ([yshift=-0.12cm]hS.south west) {};
  \node[panel, fill=blue!3, minimum width=7.55cm, minimum height=3.3cm] (S2) at ([xshift=0.6cm]S1.north east) {};
  \node[panel, fill=green!4, minimum width=7.55cm, minimum height=3.3cm] (S3) at ([yshift=-0.25cm]S1.south west) {};
  \node[panel, fill=yellow!6, minimum width=7.55cm, minimum height=3.3cm] (S4) at ([xshift=0.6cm]S3.north east) {};

  % La ecuación: la columna de la tabla
  \begin{scope}[shift={(S1.north west)}]
    \node[tit] at (0.12,-0.1) {\textbf{La ecuación: la columna de la tabla}};
    \node[tit, text width=4.9cm] at (0.12,-0.55)
      {Cada columna en proporciones: $1=\sum_i a_{ij}+v_j$.\\[2pt]
       Con precios: $p'=p'A+v'$\\[2pt]
       $\Rightarrow p'=v'(I-A)^{-1}=v'L$\\[3pt]
       Con el $v$ observado, $p'=1'$: reproduce el año base. Si cambia, $\Delta p'=\Delta v'L$.};
    % un euro de producción de la rama j: inputs y valor añadido
    \fill[blue!30] (5.6,-2.95) rectangle ++(0.7,0.75);
    \fill[blue!18] (5.6,-2.2) rectangle ++(0.7,0.55);
    \fill[red!25] (5.6,-1.65) rectangle ++(0.7,0.95);
    \draw[black!60] (5.6,-2.95) rectangle (6.3,-0.7);
    \node[font=\footnotesize, anchor=west] at (6.35,-2.57) {$a_{1j}p_1$};
    \node[font=\footnotesize, anchor=west] at (6.35,-1.92) {$a_{2j}p_2$};
    \node[font=\footnotesize, anchor=west] at (6.35,-1.17) {$v_j$};
    \node[font=\footnotesize, anchor=south] at (5.95,-0.68) {$p_j$};
  \end{scope}

  % La transmisión
  \begin{scope}[shift={(S2.north west)}]
    \node[tit] at (0.12,-0.1) {\textbf{La transmisión: la fila de $L$}};
    \node[tit, text width=4.1cm] at (0.12,-0.55)
      {Sube el valor añadido por unidad de $S_2$, $\Delta v_2$ (una subida salarial).\\[2pt]
       $S_1$ sube aunque sus costes directos no cambien: compra a $S_2$.\\[2pt]
       $S_2$ sube más que el impulso, porque $l_{22}\geq1$.};
    \fill[red!30] (4.55,-2.9) rectangle ++(0.65,1.0);
    \fill[blue!30] (5.55,-2.9) rectangle ++(0.65,1.3);
    \fill[blue!18] (6.55,-2.9) rectangle ++(0.65,0.5);
    \draw[black!50] (4.4,-2.9) -- (7.35,-2.9);
    \node[font=\footnotesize, anchor=south] at (4.88,-1.9) {$\Delta v_2$};
    \node[font=\footnotesize, anchor=south] at (5.88,-1.6) {$l_{22}\Delta v_2$};
    \node[font=\footnotesize, anchor=south] at (6.88,-2.4) {$l_{21}\Delta v_2$};
    \node[font=\footnotesize, anchor=north] at (4.88,-2.92) {impulso};
    \node[font=\footnotesize, anchor=north] at (5.88,-2.92) {$p_2$};
    \node[font=\footnotesize, anchor=north] at (6.88,-2.92) {$p_1$};
  \end{scope}

  % Una matriz, dos lecturas
  \begin{scope}[shift={(S3.north west)}]
    \node[tit] at (0.12,-0.1) {\textbf{Una matriz, dos lecturas, y su dualidad}};
    \matrix (ml) [matrix of math nodes, nodes={mc}, column sep=-0.4pt, row sep=-0.4pt, anchor=north west] at (0.3,-0.75)
      { |[fill=violet!22]| l_{11} & |[fill=red!22]| l_{12} \\ |[fill=blue!22]| l_{21} & l_{22} \\ };
    \node[font=\footnotesize, anchor=north west, align=left] at ([yshift=-2pt]ml-2-1.south west) {\textcolor{blue!55!black}{columna: demanda}\\ \textcolor{red!55!black}{fila: precios}};
    \node[tit, text width=4.5cm] at (2.8,-0.55)
      {La demanda arrastra \textbf{hacia atrás}; los costes empujan \textbf{hacia adelante}.\\[2pt]
       Dualidad: $p'D=v'LD=v'X$, PIB por el gasto $=$ por la renta.\\[2pt]
       GHOSH, como modelo de precios, describe lo mismo (DIETZENBACHER).};
  \end{scope}

  % Economía abierta
  \begin{scope}[shift={(S4.north west)}]
    \node[tit] at (0.12,-0.1) {\textbf{Economía abierta: la inflación importada}};
    \node[tit, text width=7.2cm] at (0.12,-0.55)
      {Los precios de importación, $p^m$, entran como un coste exógeno más y se transmiten con la inversa interior:\\[3pt]
       \hspace*{1.2cm}$p'=\left(v'+p^{m\prime}A^m\right)\left(I-A^d\right)^{-1}$\\[3pt]
       Una economía importa inflación según el contenido importado, directo e indirecto, de sus productos: $S_2$ se encarece aunque no importe energía, porque la compra incorporada en lo que le vende $S_1$. Igual con una depreciación.};
  \end{scope}

  % ================= USOS Y LÍMITES =================
  \node[sec, text=black!75] (hU) at ([yshift=-0.3cm]S3.south west) {Para qué sirve y dónde falla};
  \node[panel, fill=green!5, text width=7.25cm, minimum height=3.45cm] (U) at ([yshift=-0.12cm]hU.south west)
    {\textbf{Usos} ($\Delta p'=\Delta v'L$)\\[2pt]
     \textbf{Inflación}: efectos directos e indirectos (la energía en la subyacente de 2022).\\
     \textbf{Impuestos indirectos} y precio del carbono: traslación y progresividad.\\
     \textbf{Rentas y competitividad}: salarios, salario mínimo, tipo de cambio.\\
     \textbf{Competencia y regulación}: abaratar los inputs de muchas ramas (energía, transporte) abarata toda la economía.};
  \node[panel, fill=orange!6, text width=7.25cm, minimum height=3.45cm] (Li) at ([xshift=0.6cm]U.north east)
    {\textbf{Límites} ($\to$ alternativa)\\[2pt]
     Traslación completa e inmediata: un techo a largo plazo.\\
     Márgenes fijos: sin poder de mercado ($\to$ márgenes endógenos).\\
     Sin sustitución: exagera las perturbaciones grandes.\\
     $v$ exógeno: sin espiral de precios y salarios.\\
     Precios y cantidades separados ($\to$ equilibrio general aplicado).\\
     Medida: precios básicos, no el IPC.};

  % ================= GLOSARIO =================
  \node[caja, fill=black!3, anchor=north west, inner sep=5pt, text width=15.15cm] at ([yshift=-0.35cm]U.south west)
    {\textbf{Glosario de notación.} {\itshape $p'$, $v'$: vectores fila; $1'$: vector fila de unos.}\\[2pt]
     \renewcommand{\arraystretch}{1.05}%
     \begin{tabular}{@{}>{$}l<{$}@{\;\;}>{\raggedright\arraybackslash}p{3.6cm}@{\quad}>{$}l<{$}@{\;\;}>{\raggedright\arraybackslash}p{3.6cm}@{\quad}>{$}l<{$}@{\;\;}>{\raggedright\arraybackslash}p{3.6cm}@{}}
       p',\,p_j & precios (índices) & A,\,L & coeficientes técnicos; inversa & A^d,\,A^m & interiores e importados \\
       v',\,v_j & valor añadido por unidad & l_{ij} & elemento de la inversa & p^m & precios de importación \\
       \Delta v,\,\Delta p & variaciones & D,\,X & demanda final; producción & & \\
     \end{tabular}};
\end{tikzpicture}
