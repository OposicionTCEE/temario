% Figura: una matriz, dos lecturas. El modelo de demanda recorre la inversa de LEONTIEF por columnas y el de precios, por filas.
% Fuente de TIO_dos_lecturas_num.pdf (anexo del ejemplo numérico). Generar con: bash Code/generar_figura.sh TIO_dos_lecturas_num. Ejemplo sin importaciones: L = [[12/7, 2/7], [1, 4/3]].
\begin{tikzpicture}[>=stealth,
  celda/.style={draw=black!75, line width=0.5pt, minimum height=1.05cm, minimum width=1.6cm, font=\small, inner sep=1pt, align=center, anchor=center},
  hl/.style={fill=blue!18, line width=1.2pt}, hr/.style={fill=red!14, line width=1.2pt}, n/.style={fill=white},
  tit/.style={font=\small\bfseries, align=center}]
  % --- Lectura por columnas: modelo de demanda
  \matrix (a) [matrix of nodes, nodes={celda}, column sep=-0.5pt, row sep=-0.5pt,
               column 1/.style={nodes={draw=none, minimum width=0.8cm}}, row 1/.style={nodes={draw=none, minimum height=0.6cm}}]
  {
    & $\boldsymbol{S_1}$ & $\boldsymbol{S_2}$ \\
    $\boldsymbol{S_1}$ & |[hl]| \shortstack{$\frac{12}{7}$\\[1pt] $1{,}71$} & |[n]| \shortstack{$\frac{2}{7}$\\[1pt] $0{,}29$} \\
    $\boldsymbol{S_2}$ & |[hl]| \shortstack{$1$\\[1pt] $1{,}00$} & |[n]| \shortstack{$\frac{4}{3}$\\[1pt] $1{,}33$} \\
  };
  \node[tit, anchor=south] at ([yshift=0.9cm]a-1-2.north east) {Modelo de demanda: lectura por columnas};
  \draw[->, line width=1.6pt, blue!60!black] ([yshift=-0.05cm]a-3-2.south) -- ([yshift=-0.55cm]a-3-2.south)
    node[below, font=\footnotesize, text=blue!60!black, align=center] {$\Delta D_1=1\ \Rightarrow\ \Delta X=(1{,}71;\ 1{,}00)$\\ arrastre hacia atrás};
  \node[font=\footnotesize, anchor=north, align=center] at ([yshift=-1.55cm]$(a-3-2.south)!0.5!(a-3-3.south)$) {$\Delta X=L\,\Delta D$};
  % --- Lectura por filas: modelo de precios
  \matrix (b) [matrix of nodes, nodes={celda}, column sep=-0.5pt, row sep=-0.5pt, anchor=north west,
               column 1/.style={nodes={draw=none, minimum width=0.8cm}}, row 1/.style={nodes={draw=none, minimum height=0.6cm}}]
    at ([xshift=2.6cm]a-1-3.north east)
  {
    & $\boldsymbol{S_1}$ & $\boldsymbol{S_2}$ \\
    $\boldsymbol{S_1}$ & |[n]| \shortstack{$\frac{12}{7}$\\[1pt] $1{,}71$} & |[n]| \shortstack{$\frac{2}{7}$\\[1pt] $0{,}29$} \\
    $\boldsymbol{S_2}$ & |[hr]| \shortstack{$1$\\[1pt] $1{,}00$} & |[hr]| \shortstack{$\frac{4}{3}$\\[1pt] $1{,}33$} \\
  };
  \node[tit, anchor=south] at ([yshift=0.9cm]b-1-2.north east) {Modelo de precios: lectura por filas};
  \draw[->, line width=1.6pt, red!60!black] ([xshift=0.05cm]b-3-3.east) -- ([xshift=0.6cm]b-3-3.east)
    node[right, font=\footnotesize, text=red!60!black, align=left] {$\Delta v_2=0{,}1\ \Rightarrow$\\ $\Delta p=(0{,}10;\ 0{,}13)$\\ empuje hacia adelante};
  \node[font=\footnotesize, anchor=north, align=center] at ([yshift=-1.55cm]$(b-3-2.south)!0.5!(b-3-3.south)$) {$\Delta p'=\Delta v'\,L$};
  % Rótulo común
  \node[font=\small, anchor=north, align=center] at ([yshift=-2.25cm]$(a-3-3.south east)!0.5!(b-3-1.south west)$)
    {La misma matriz inversa $L=(I-A)^{-1}$: una perturbación de demanda en $j$ se propaga por la \textbf{columna} $j$;\\ una perturbación de costes en $i$, por la \textbf{fila} $i$.};
\end{tikzpicture}
