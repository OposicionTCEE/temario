% Figura: coeficientes técnicos (lectura por columnas) y de distribución (lectura por filas) del ejemplo.
% Fuente de TIO_coeficientes_num.pdf (anexo del ejemplo numérico). Generar con: bash Code/generar_figura.sh TIO_coeficientes_num. Tabla de flujos totales con importaciones (TIO_abierta).
\begin{tikzpicture}[
  celda/.style={draw=black!75, line width=0.5pt, minimum height=1.15cm, minimum width=1.5cm, font=\small, inner sep=1pt, align=center, anchor=center},
  I/.style={fill=blue!12}, II/.style={fill=green!12}, III/.style={fill=red!10}, T/.style={fill=black!8}]
  \matrix (a) [matrix of nodes, nodes={celda}, column sep=-0.5pt, row sep=-0.5pt,
               column 1/.style={nodes={minimum width=1.9cm}}, row 1/.style={nodes={minimum height=0.8cm, font=\small\bfseries}}]
  {
    & $\boldsymbol{S_1}$ & $\boldsymbol{S_2}$ \\
    $\boldsymbol{S_1}$ & |[I]| \shortstack{$a_{11}=\frac{2}{6}$\\[2pt] $0{,}33$} & |[I]| \shortstack{$a_{12}=\frac{1}{7}$\\[2pt] $0{,}14$} \\
    $\boldsymbol{S_2}$ & |[I]| \shortstack{$a_{21}=\frac{3}{6}$\\[2pt] $0{,}50$} & |[I]| \shortstack{$a_{22}=\frac{1}{7}$\\[2pt] $0{,}14$} \\
    $\boldsymbol{VAB_j/X_j}$ & |[III]| \shortstack{$v_1=\frac{1}{6}$\\[2pt] $0{,}17$} & |[III]| \shortstack{$v_2=\frac{5}{7}$\\[2pt] $0{,}71$} \\
    |[T]| \textbf{Total} & |[T]| $1$ & |[T]| $1$ \\
  };
  \node[font=\small\bfseries, anchor=south] at ([yshift=6pt]$(a-1-2.north)!0.5!(a-1-3.north)$) {Coeficientes técnicos: $a_{ij}=x_{ij}/X_j$};
  \node[font=\footnotesize\itshape, text=black!65, anchor=north] at ([yshift=-4pt]$(a-5-1.south)!0.5!(a-5-3.south)$) {Cada columna suma $1$: estructura de costes};

  \matrix (b) [matrix of nodes, nodes={celda}, column sep=-0.5pt, row sep=-0.5pt, anchor=north west,
               column 1/.style={nodes={minimum width=1.2cm}}, row 1/.style={nodes={minimum height=0.8cm, font=\small\bfseries}}]
    at ([xshift=1.6cm]a-1-3.north east)
  {
    & $\boldsymbol{S_1}$ & $\boldsymbol{S_2}$ & |[T]| \shortstack{Demanda\\ final} & |[T]| \textbf{Total} \\
    $\boldsymbol{S_1}$ & |[I]| \shortstack{$b_{11}=\frac{2}{7}$\\[2pt] $0{,}29$} & |[I]| \shortstack{$b_{12}=\frac{1}{7}$\\[2pt] $0{,}14$} & |[II]| \shortstack{$\frac{4}{7}$\\[2pt] $0{,}57$} & |[T]| $1$ \\
    $\boldsymbol{S_2}$ & |[I]| \shortstack{$b_{21}=\frac{3}{9}$\\[2pt] $0{,}33$} & |[I]| \shortstack{$b_{22}=\frac{1}{9}$\\[2pt] $0{,}11$} & |[II]| \shortstack{$\frac{5}{9}$\\[2pt] $0{,}56$} & |[T]| $1$ \\
  };
  \node[font=\small\bfseries, anchor=south] at ([yshift=6pt]$(b-1-2.north)!0.5!(b-1-5.north)$) {Coeficientes de distribución: $b_{ij}=x_{ij}/TR_i$};
  \node[font=\footnotesize\itshape, text=black!65, anchor=north, align=center] at ([yshift=-4pt]$(b-3-1.south)!0.5!(b-3-5.south)$) {Cada fila suma $1$: estructura de los destinos};
\end{tikzpicture}
