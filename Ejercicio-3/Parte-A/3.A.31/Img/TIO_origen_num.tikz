% Figura: tabla de origen del ejemplo (productos por ramas), a precios básicos y transición a precios de adquisición.
% Fuente de TIO_origen_num.pdf (anexo del ejemplo numérico). Generar con: bash Code/generar_figura.sh TIO_origen_num. Coherente con TIO_abierta (precios básicos) y TIO_destino (precios de adquisición).
\begin{tikzpicture}[
  celda/.style={draw=black!75, line width=0.5pt, minimum height=0.85cm, minimum width=1.55cm, font=\small, inner sep=1pt, align=center, anchor=center},
  P/.style={fill=blue!12}, T/.style={fill=black!8}, M/.style={fill=yellow!35}, V/.style={fill=violet!12}]
  \matrix (m) [matrix of nodes, nodes={celda}, column sep=-0.5pt, row sep=-0.5pt,
               column 1/.style={nodes={minimum width=1.9cm}}, row 1/.style={nodes={minimum height=1.15cm, font=\footnotesize\bfseries}}]
  {
    Productos & \shortstack{Rama\\ $\boldsymbol{S_1}$} & \shortstack{Rama\\ $\boldsymbol{S_2}$} & |[T]| \shortstack{Producción\\ $\boldsymbol{X_i}$} & |[M]| \shortstack{Importac.\\ (CIF) $\boldsymbol{M_i}$} & |[T]| \shortstack{Oferta\\ a p. básicos} & |[V]| \shortstack{Márgenes\\ comercio y\\ transporte} & |[V]| \shortstack{Impuestos\\ netos sobre\\ productos} & |[T]| \shortstack{Oferta\\ a p. de\\ adquisición} \\
    $\boldsymbol{P_1}$ & |[P]| $6$ & |[P]| $0$ & |[T]| $6$ & |[M]| $1$ & |[T]| $7$ & |[V]| $+1$ & |[V]| $0$ & |[T]| $8$ \\
    $\boldsymbol{P_2}$ & |[P]| $0$ & |[P]| $7$ & |[T]| $7$ & |[M]| $2$ & |[T]| $9$ & |[V]| $-1$ & |[V]| $0$ & |[T]| $8$ \\
    |[T]| \textbf{Total} & |[T]| $6$ & |[T]| $7$ & |[T]| $13$ & |[T]| $3$ & |[T]| $16$ & |[T]| $0$ & |[T]| $0$ & |[T]| $\mathbf{16}$ \\
  };
  \draw[decorate, decoration={brace, amplitude=5pt}, thick] ([yshift=2pt]m-1-2.north west) -- ([yshift=2pt]m-1-3.north east)
    node[midway, above=5pt, font=\footnotesize\bfseries] {Matriz de producción};
  \draw[decorate, decoration={brace, amplitude=5pt}, thick] ([yshift=2pt]m-1-7.north west) -- ([yshift=2pt]m-1-8.north east)
    node[midway, above=5pt, font=\footnotesize\bfseries] {Transición a precios de adquisición};
  \node[font=\footnotesize\itshape, text=black!65, align=left, anchor=north west] at ([yshift=-0.2cm]m-4-1.south west)
    {Diagonal: producción principal de cada rama; fuera de la diagonal (aquí, cero): producción secundaria.\\
     Los márgenes suman cero: el servicio de comercio de $S_2$ pasa a formar parte del precio de $P_1$.};
\end{tikzpicture}
