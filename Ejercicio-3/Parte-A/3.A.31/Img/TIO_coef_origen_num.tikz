% Figura: descomposición de los coeficientes técnicos totales en interiores e importados (A = A^d + A^m) del ejemplo.
% Fuente de TIO_coef_origen_num.pdf (anexo del ejemplo numérico). Generar con: bash Code/generar_figura.sh TIO_coef_origen_num.
\begin{tikzpicture}[
  celda/.style={draw=black!75, line width=0.5pt, minimum height=1.05cm, minimum width=1.35cm, font=\small, inner sep=1pt, align=center, anchor=center},
  I/.style={fill=blue!12}, M/.style={fill=yellow!35}, T/.style={fill=black!8},
  lab/.style={font=\small\bfseries, anchor=south, align=center}, op/.style={font=\LARGE}]
  % Matriz total
  \matrix (t) [matrix of nodes, nodes={celda}, column sep=-0.5pt, row sep=-0.5pt,
               column 1/.style={nodes={minimum width=0.9cm, draw=none}}, row 1/.style={nodes={minimum height=0.6cm, draw=none, font=\small\bfseries}}]
  {
    & $\boldsymbol{S_1}$ & $\boldsymbol{S_2}$ \\
    $\boldsymbol{S_1}$ & |[I]| \shortstack{$\frac{2}{6}$\\[1pt] $0{,}33$} & |[I]| \shortstack{$\frac{1}{7}$\\[1pt] $0{,}14$} \\
    $\boldsymbol{S_2}$ & |[I]| \shortstack{$\frac{3}{6}$\\[1pt] $0{,}50$} & |[I]| \shortstack{$\frac{1}{7}$\\[1pt] $0{,}14$} \\
  };
  \node[lab] at ([yshift=4pt]$(t-1-2.north)!0.5!(t-1-3.north)$) {Totales $\mathbf{A}$};
  \node[op] (eq) at ([xshift=0.6cm]$(t-2-3.east)!0.5!(t-3-3.east)$) {$=$};
  % Matriz interior
  \matrix (d) [matrix of nodes, nodes={celda}, column sep=-0.5pt, row sep=-0.5pt, anchor=west,
               row 1/.style={nodes={minimum height=0.6cm, draw=none, font=\small\bfseries}}]
    at ([xshift=0.6cm]eq.east |- t.center)
  {
    $\boldsymbol{S_1}$ & $\boldsymbol{S_2}$ \\
    |[I]| \shortstack{$\frac{1}{6}$\\[1pt] $0{,}17$} & |[I]| \shortstack{$\frac{1}{7}$\\[1pt] $0{,}14$} \\
    |[I]| \shortstack{$\frac{3}{6}$\\[1pt] $0{,}50$} & |[I]| \shortstack{$0$\\[1pt] $0{,}00$} \\
  };
  \node[lab] at ([yshift=4pt]$(d-1-1.north)!0.5!(d-1-2.north)$) {Interiores $\mathbf{A}^d$};
  \node[op] (plus) at ([xshift=0.6cm]$(d-2-2.east)!0.5!(d-3-2.east)$) {$+$};
  % Matriz de importaciones
  \matrix (m) [matrix of nodes, nodes={celda}, column sep=-0.5pt, row sep=-0.5pt, anchor=west,
               row 1/.style={nodes={minimum height=0.6cm, draw=none, font=\small\bfseries}}]
    at ([xshift=0.6cm]plus.east |- t.center)
  {
    $\boldsymbol{S_1}$ & $\boldsymbol{S_2}$ \\
    |[M]| \shortstack{$\frac{1}{6}$\\[1pt] $0{,}17$} & |[M]| \shortstack{$0$\\[1pt] $0{,}00$} \\
    |[M]| \shortstack{$0$\\[1pt] $0{,}00$} & |[M]| \shortstack{$\frac{1}{7}$\\[1pt] $0{,}14$} \\
  };
  \node[lab] at ([yshift=4pt]$(m-1-1.north)!0.5!(m-1-2.north)$) {Importados $\mathbf{A}^m$};
  % Contenido importado directo
  \node[font=\footnotesize, anchor=north west, align=left] at ([yshift=-0.35cm]t-3-1.south west)
    {\textbf{Contenido importado directo} por unidad producida (suma de cada columna de $\mathbf{A}^m$): $m_1=\frac{1}{6}\approx0{,}17$ en $S_1$ y $m_2=\frac{1}{7}\approx0{,}14$ en $S_2$.\\
     Cada columna de la tabla interior suma $1$ añadiendo a $\mathbf{A}^d$ el contenido importado y el valor añadido: $S_1$: $\tfrac{1}{6}+\tfrac{3}{6}+\tfrac{1}{6}+\tfrac{1}{6}=1$; \ $S_2$: $\tfrac{1}{7}+0+\tfrac{1}{7}+\tfrac{5}{7}=1$.};
\end{tikzpicture}
