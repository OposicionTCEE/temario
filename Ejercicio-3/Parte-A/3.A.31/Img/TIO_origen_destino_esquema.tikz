% Figura: esquema de una página «De la estadística al análisis» (anexo de esquemas).
% Secuencia: problema (¿quién produce qué y quién lo usa?) -> herramienta (tablas de origen y destino y su conciliación)
% -> metodología (tres problemas, tres soluciones: valoración, origen, hipótesis tecnológica) -> resultado (tabla simétrica).
% Coordenadas absolutas en cm, origen en la esquina superior izquierda. Generar con: bash Code/generar_figura.sh TIO_origen_destino_esquema
\begin{tikzpicture}[>=stealth,
  base/.style={draw=black!70, rounded corners=3pt, line width=0.6pt, align=left, font=\footnotesize, inner sep=4pt},
  prob/.style={base, fill=red!6, text width=4.3cm, anchor=north west},
  panel/.style={base, fill=blue!4, minimum width=10.3cm, anchor=north west},
  celda/.style={draw=black!70, line width=0.4pt, minimum height=0.55cm, minimum width=1.0cm, font=\footnotesize, inner sep=1pt, text height=1.5ex, text depth=0.4ex, anchor=center},
  P/.style={fill=blue!12}, Sec/.style={fill=orange!40}, G/.style={fill=black!8}, Mi/.style={fill=yellow!35}, Va/.style={fill=red!10}, Df/.style={fill=green!12},
  sec/.style={font=\small\bfseries, anchor=north west},
  tit/.style={font=\footnotesize, anchor=north west, align=left},
  num/.style={circle, fill=black!80, text=white, font=\footnotesize\bfseries, inner sep=1.2pt, minimum size=0.45cm},
  cont/.style={rounded corners=2pt, fill=green!30, font=\footnotesize\bfseries, inner sep=2pt, anchor=north east},
  hip/.style={rounded corners=2pt, fill=orange!45, font=\footnotesize\bfseries, inner sep=2pt, anchor=north east},
  flecha/.style={->, line width=0.9pt, black!70},
  concilia/.style={<->, line width=1pt, blue!55!black}]

  % ================= 1. EL PROBLEMA =================
  \node[sec, text=red!50!black] at (0,0) {El problema};
  \node[base, fill=red!6, text width=15.2cm, anchor=north west] (A) at (0,-0.5)
    {\textbf{¿Quién produce qué y quién lo usa?} Es lo que registra el bloque I de la tabla simétrica: lo que cada rama $j$ compra a cada rama $i$, $x_{ij}$, con una rama por producto y un solo precio por producto. Pero las estadísticas no observan la economía así.};

  % ================= 2. LA HERRAMIENTA =================
  \node[sec, text=blue!50!black] at (0,-1.9) {La herramienta: lo que tenemos, las tablas de origen y destino};
  \node[tit, text width=15.5cm] at (0,-2.35)
    {¿Por qué estas? Porque es lo que se observa: los productores declaran qué productos venden y lo que cobran por ellos (\textbf{origen}); los compradores, qué compran y lo que pagan (\textbf{destino}). Las dos cruzan productos (filas) y ramas (columnas).};

  % Tabla de origen
  \matrix (o) [matrix of math nodes, nodes={celda}, column sep=-0.4pt, row sep=-0.4pt, anchor=north west,
               column 1/.style={nodes={minimum width=1.15cm}}, column 5/.style={nodes={minimum width=1.6cm}},
               column 6/.style={nodes={minimum width=1.15cm}}] at (0,-4.3)
  {
    \phantom{P} & \mathbf{S_1}    & \mathbf{S_2}    & |[Mi]| \mathbf{M} & \mathbf{MC+T} & |[G]| \text{\textbf{Oferta}} \\
    \mathbf{P_1} & |[P]| v_{11}    & |[Sec]| v_{21}  & |[Mi]| M_1        & MC_1+T_1      & |[G]| TR^a_1 \\
    \mathbf{P_2} & |[Sec]| v_{12}  & |[P]| v_{22}    & |[Mi]| M_2        & MC_2+T_2      & |[G]| TR^a_2 \\
    |[G]| \mathbf{g_j} & |[G]| g_1 & |[G]| g_2 \\
  };
  \node[tit, anchor=south west] at ([yshift=2pt]o-1-1.north west)
    {\textbf{Tabla de origen}\\ precios básicos: lo que cobra el productor\\ \textcolor{orange!75!black}{\textbf{naranja}}: producción secundaria ($\to$ paso 3)};

  % Tabla de destino
  \matrix (d) [matrix of math nodes, nodes={celda}, column sep=-0.4pt, row sep=-0.4pt, anchor=north west,
               column 1/.style={nodes={minimum width=1.15cm}}, column 4/.style={nodes={minimum width=1.1cm}}] at (9.9,-4.3)
  {
    \phantom{P}       & \mathbf{S_1}     & \mathbf{S_2}     & |[Df]| \mathbf{D} \\
    \mathbf{P_1}       & u_{11}           & u_{12}           & |[Df]| D_1 \\
    \mathbf{P_2}       & u_{21}           & u_{22}           & |[Df]| D_2 \\
    |[Va]| \mathbf{VAB_j} & |[Va]| VAB_1  & |[Va]| VAB_2 \\
    |[G]| \mathbf{g_j} & |[G]| g_1        & |[G]| g_2 \\
  };
  \node[tit, anchor=south west] at ([yshift=2pt]d-1-1.north west)
    {\textbf{Tabla de destino}\\ precios de adquisición:\\ lo que paga el comprador};

  % Conciliación por producto (filas) y por rama (columnas)
  \draw[concilia] ([xshift=2pt]$(o-2-6.east)!0.5!(o-3-6.east)$) -- ([xshift=-2pt]$(d-2-1.west)!0.5!(d-3-1.west)$)
    node[midway, above=1pt, font=\footnotesize\bfseries, text=blue!55!black] {por producto}
    node[midway, below=1pt, font=\footnotesize, align=center] {oferta $=$ empleos\\ $TR^a_i=\sum_j u_{ij}+D_i$};
  \draw[concilia] (o-4-2.south) |- ([yshift=-0.3cm]d-5-2.south) -- (d-5-2.south);
  \node[font=\footnotesize, anchor=north, align=center] at ([yshift=-0.32cm]$(o-4-2.south |- d-5-2.south)!0.5!(d-5-2.south)$)
    {\textbf{\textcolor{blue!55!black}{por rama:}} producción (origen) $=$ consumos intermedios $+$ valor añadido (destino): $g_j=\sum_i u_{ij}+VAB_j$};
  \node[tit, text width=15.5cm] at (0,-8.05)
    {\textbf{Conciliación:} la oferta y los empleos proceden de fuentes distintas y de entrada no cuadran. Se revisan producto a producto y rama a rama hasta que se cumplen las dos igualdades: así se equilibran las cuentas nacionales y los tres enfoques del PIB.};

  % ================= 3. LA METODOLOGÍA =================
  \node[sec, text=black!75] at (0,-9.1) {La metodología: tres problemas, tres soluciones (de las tablas observadas a la tabla simétrica)};

  % --- Paso 1: valoración ---
  \node[prob, minimum height=3.6cm] (p1) at (0,-9.6)
    {\textbf{Problema 1: dos precios}\\[2pt]
     \textit{a) Conciliación de precios, entre tablas:} el origen recoge lo que cobra el productor; el destino, lo que paga el comprador.\\[2pt]
     \textit{b) Conciliación de la valoración, dentro de una fila:} el mismo producto cuesta distinto según quién lo compre.};
  \node[panel, minimum height=3.6cm] (s1) at (5.3,-9.6) {};
  \node[num] at (p1.north west) {1};
  \draw[flecha] (p1.east) -- (s1.west);
  \begin{scope}[shift={(5.3,-9.6)}]
    \node[cont] at (10.2,-0.1) {contable};
    \node[tit] at (0.12,-0.1) {\textbf{Paso 1. Valoración: todo a precios básicos}};
    % Dos compradores del mismo producto
    \node[font=\footnotesize, anchor=west] at (0.12,-1.17) {Empresa};
    \node[font=\footnotesize, anchor=west] at (0.12,-1.77) {Hogar};
    \fill[blue!25] (1.3,-1.39) rectangle ++(2.6,0.44);  \fill[red!35] (3.9,-1.39) rectangle ++(0.2,0.44);  \fill[yellow!55] (4.1,-1.39) rectangle ++(0.5,0.44);
    \fill[blue!25] (1.3,-1.99) rectangle ++(2.6,0.44);  \fill[red!35] (3.9,-1.99) rectangle ++(0.7,0.44);  \fill[yellow!55] (4.6,-1.99) rectangle ++(1.0,0.44);
    \draw[black!60] (1.3,-1.39) rectangle (4.6,-0.95);  \draw[black!60] (1.3,-1.99) rectangle (5.6,-1.55);
    \node[font=\footnotesize, anchor=west] at (4.65,-1.17) {$p^a$};
    \node[font=\footnotesize, anchor=west] at (5.65,-1.77) {$p^a$};
    \draw[dashed, line width=0.8pt, blue!60!black] (3.9,-0.85) -- (3.9,-2.1);
    \node[font=\footnotesize, text=blue!50!black, anchor=south] at (2.6,-0.93) {mismo precio básico};
    % Leyenda
    \fill[blue!25] (0.15,-2.55) rectangle ++(0.3,0.22); \node[font=\footnotesize, anchor=west] at (0.5,-2.44) {precio básico: lo que cobra el productor};
    \fill[red!35] (0.15,-2.93) rectangle ++(0.3,0.22); \node[font=\footnotesize, anchor=west] at (0.5,-2.82) {impuestos netos sobre el producto};
    \fill[yellow!55] (0.15,-3.31) rectangle ++(0.3,0.22); \node[font=\footnotesize, anchor=west] at (0.5,-3.20) {márgenes de comercio y transporte};
    % Maniobra y resultado
    \node[tit, text width=3.75cm] at (6.3,-0.6)
      {\textbf{Maniobra:} de cada $u_{ij}$ se restan el margen, que vuelve a la fila de comercio y transporte, y el impuesto, que pasa a una fila propia: queda $x_{ij}$.\\[3pt]
       \textbf{Resultado:} un precio por fila; origen y destino, en la misma valoración.};
  \end{scope}

  % --- Paso 2: origen ---
  \node[prob, minimum height=3.0cm] (p2) at (0,-13.45)
    {\textbf{Problema 2: ¿interior o importado?}\\[2pt]
     Ya a precios básicos, cada $x_{ij}$ suma producto nacional e importado: la tabla de destino registra el uso, no la procedencia.};
  \node[panel, minimum height=3.0cm] (s2) at (5.3,-13.45) {};
  \node[num] at (p2.north west) {2};
  \draw[flecha] (p2.east) -- (s2.west);
  \begin{scope}[shift={(5.3,-13.45)}]
    \node[cont] at (10.2,-0.1) {contable};
    \node[tit] at (0.12,-0.1) {\textbf{Paso 2. Origen: cada casilla se parte en dos}, con los datos de los importadores};
    \foreach \x/\c/\s in {1.2/black!12/{x_{ij}}, 4.65/blue!20/{x^d_{ij}}, 8.1/yellow!45/{x^m_{ij}}} {
      \fill[\c] (\x-0.5,-1.9) rectangle ++(1.0,0.8);
      \draw[black!70] (\x-0.5,-1.9) rectangle ++(1.0,0.8);
      \draw[black!70] (\x,-1.9) -- ++(0,0.8);  \draw[black!70] (\x-0.5,-1.5) -- ++(1.0,0);
      \node[font=\footnotesize, anchor=south] at (\x,-1.08) {$\s$};
    }
    \node[font=\large] at (2.92,-1.5) {$=$};
    \node[font=\large] at (6.37,-1.5) {$+$};
    \node[font=\footnotesize, align=center, text width=3.3cm, anchor=north] at (1.2,-1.95) {\textbf{Tabla total}\\ la tecnología: comparar países y años};
    \node[font=\footnotesize, align=center, text width=3.3cm, anchor=north] at (4.65,-1.95) {\textbf{Tabla interior}\\ el impacto nacional: multiplicadores};
    \node[font=\footnotesize, align=center, text width=3.3cm, anchor=north] at (8.1,-1.95) {\textbf{Importaciones}\\ la fuga y el contenido importado};
  \end{scope}

  % --- Paso 3: hipótesis tecnológica ---
  \node[prob, minimum height=3.9cm, fill=orange!8] (p3) at (0,-16.7)
    {\textbf{Problema 3: ramas multiproducto}\\[2pt]
     $S_1$ fabrica también $P_2$ (producción secundaria, casillas naranjas del origen): su columna mezcla dos técnicas y deja de corresponder a un solo producto.};
  \node[panel, minimum height=3.9cm, fill=orange!4] (s3) at (5.3,-16.7) {};
  \node[num] at (p3.north west) {3};
  \draw[flecha] (p3.east) -- (s3.west);
  \begin{scope}[shift={(5.3,-16.7)}]
    \node[hip] at (10.2,-0.1) {hipótesis};
    \node[tit, text width=8.4cm] at (0.12,-0.1)
      {\textbf{Paso 3. Hipótesis tecnológica:} un supuesto, no un dato, sobre con qué técnica se fabrica la producción secundaria.};
    \node[draw=black!70, fill=orange!40, rounded corners=2pt, font=\footnotesize, align=center, inner sep=3pt] (v) at (1.05,-1.95)
      {$v_{12}$\\ $P_2$ hecho\\ por $S_1$};
    \node[base, fill=white, text width=7.3cm, anchor=west] (tp) at (2.4,-1.45)
      {\textbf{Tecnología de producto:} con la técnica de $S_2$, la rama propia de $P_2$. Una técnica por producto, la más coherente; pero puede dar coeficientes negativos.};
    \node[base, fill=white, text width=7.3cm, anchor=west] (tr) at (2.4,-2.5)
      {\textbf{Tecnología de rama:} con la técnica de $S_1$, como todo lo que produce. Nunca da negativos, pero $P_2$ mezcla dos técnicas.};
    \draw[flecha] (v.east) -- (tp.west);
    \draw[flecha] (v.east) -- (tr.west);
    \node[tit, text width=9.9cm] at (0.12,-3.05)
      {\textbf{Dos decisiones:} qué técnica (de producto o de rama) y qué tabla (producto $\times$ producto o rama $\times$ rama). El INE: producto $\times$ producto, con un \textbf{método híbrido}.};
  \end{scope}

  % ================= 4. EL RESULTADO =================
  \node[base, fill=blue!12, draw=black!85, line width=1.1pt, text width=15.2cm, anchor=north west] (R) at (0,-20.9)
    {\textbf{Resultado: la tabla simétrica}, producto $\times$ producto, a precios básicos, en versión total, interior e importada. Responde al problema de partida: su bloque I da los $x_{ij}$ (esquema anterior). Los pasos 1 y 2 son contables; el 3 es una hipótesis y la fuente de las mayores dudas sobre los coeficientes.};
  \draw[flecha, line width=1.2pt] (s3.south) -- (s3.south |- R.north);
\end{tikzpicture}
