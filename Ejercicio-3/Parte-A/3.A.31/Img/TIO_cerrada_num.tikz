% Figura: TIO simétrica completa (bloques I, II y III) del ejemplo numérico de dos ramas, sin importaciones.
% Fuente de TIO_cerrada_num.pdf (anexo del ejemplo numérico). Última fila: empleo (ocupados) de cada rama,
% usado en los multiplicadores de empleo. Generar con: bash Code/generar_figura.sh TIO_cerrada_num
\begin{tikzpicture}[
  celda/.style={draw=black!75, line width=0.5pt, minimum height=0.75cm, minimum width=1.1cm, font=\small, inner sep=1pt, text height=1.6ex, text depth=0.5ex, anchor=center},
  I/.style={fill=blue!12}, II/.style={fill=green!12}, III/.style={fill=red!10}, T/.style={fill=black!8}, E/.style={fill=cyan!10}]
  \matrix (m) [matrix of math nodes, nodes={celda}, column sep=-0.5pt, row sep=-0.5pt,
               column 1/.style={nodes={minimum width=1.6cm}}]
  {
    \text{\textbf{Ramas}} & \mathbf{S_1} & \mathbf{S_2} & |[T]| \mathbf{W_i} & \mathbf{C} & \mathbf{CC} & \mathbf{FBK} & \mathbf{E} & |[T]| \mathbf{D_i} & |[T]| \mathbf{TE_i} \\
    \mathbf{S_1} & |[I]| 2 & |[I]| 1 & |[T]| 3 & |[II]| 0 & |[II]| 3 & |[II]| 0 & |[II]| 0 & |[T]| 3 & |[T]| 6 \\
    \mathbf{S_2} & |[I]| 3 & |[I]| 1 & |[T]| 4 & |[II]| 1 & |[II]| 0 & |[II]| 1 & |[II]| 1 & |[T]| 3 & |[T]| 7 \\
    |[T]| \mathbf{U_j} & |[T]| 5 & |[T]| 2 & |[T]| 7 & |[T]| 1 & |[T]| 3 & |[T]| 1 & |[T]| 1 & |[T]| 6 & |[T]| \mathbf{13} \\
    \mathbf{RA_j} & |[III]| 1 & |[III]| 2 & |[T]| 3 \\
    \mathbf{EBE_j} & |[III]| 0 & |[III]| 3 & |[T]| 3 \\
    |[T]| \mathbf{VAB_j} & |[T]| 1 & |[T]| 5 & |[T]| 6 \\
    |[T]| \mathbf{X_j} & |[T]| 6 & |[T]| 7 & |[T]| \mathbf{13} \\
    |[E]| \mathbf{N_j} & |[E]| 2 & |[E]| 4 & |[E]| 6 \\
  };
  \draw[decorate, decoration={brace, amplitude=5pt}, thick] ([yshift=2pt]m-1-2.north west) -- ([yshift=2pt]m-1-3.north east)
    node[midway, above=5pt, font=\footnotesize\bfseries] {I. Consumos intermedios};
  \draw[decorate, decoration={brace, amplitude=5pt}, thick] ([yshift=2pt]m-1-5.north west) -- ([yshift=2pt]m-1-8.north east)
    node[midway, above=5pt, font=\footnotesize\bfseries] {II. Demanda final};
  % Corchete abierto hacia la matriz (la punta señala la etiqueta).
  \draw[decorate, decoration={brace, amplitude=5pt}, thick] ([xshift=6pt]m-5-4.north east) -- ([xshift=6pt]m-6-4.south east)
    node[midway, right=7pt, font=\footnotesize\bfseries, align=left] {III. Inputs\\ primarios};
  \node[font=\footnotesize\itshape, text=black!65, align=left, anchor=west] at ([xshift=0.6cm]m-8-4.east)
    {Comprobación: $\sum_i D_i=6=\sum_j VAB_j=\sum_j(RA_j+EBE_j)$\\ $N_j$: empleo (ocupados) de cada rama};
\end{tikzpicture}
