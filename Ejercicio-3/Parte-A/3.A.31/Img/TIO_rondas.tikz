% Figura: rondas sucesivas de producción en el modelo de demanda (economía de dos ramas sin importaciones), esquema sin valores.
% Fuente de TIO_rondas.pdf. Producción acumulada X = D + AD + A^2 D + ... que converge a X = (I-A)^{-1} D.
% Las alturas de las barras son solo ilustrativas (forma de la convergencia). La versión con valores es TIO_rondas_num.tikz.
% Generar con: bash Code/generar_figura.sh TIO_rondas
\begin{tikzpicture}[x=1.15cm, y=0.62cm, >=stealth]
  % Ejes (sin escala numérica)
  \draw[->, line width=0.8pt] (-0.3,0) -- (9.1,0) node[below left, font=\small] {ronda};
  \draw[->, line width=0.8pt] (-0.3,0) -- (-0.3,8.2) node[above, font=\small, align=center] {producción\\ acumulada};
  % Niveles finales
  \draw[dashed, blue!60!black, line width=0.8pt] (-0.3,6) -- (8.9,6) node[right, font=\footnotesize, text=blue!60!black] {$X_1$};
  \draw[dashed, green!45!black, line width=0.8pt] (-0.3,7) -- (8.9,7) node[right, font=\footnotesize, text=green!45!black] {$X_2$};
  % Barras acumuladas: S1 (azul), S2 (verde)
  \foreach \k/\a/\b in {0/3.000/3.000, 1/4.429/4.929, 2/5.180/5.918, 3/5.572/6.436, 4/5.777/6.705, 5/5.884/6.846, 6/5.939/6.920, 7/5.968/6.958, 8/5.983/6.978} {
    \fill[blue!30, draw=blue!60!black] (\k-0.34,0) rectangle (\k-0.02,\a);
    \fill[green!30, draw=green!45!black] (\k+0.02,0) rectangle (\k+0.34,\b);
    \node[below, font=\footnotesize] at (\k,0) {$\k$};
  }
  % Ronda 0 y primeras rondas
  \node[font=\footnotesize, align=center, anchor=south] at (0,3.15) {$D$};
  \node[font=\footnotesize, align=center, anchor=south] at (1,5.05) {$+AD$};
  \node[font=\footnotesize, align=center, anchor=south] at (2,6.05) {$+A^2D$};
  % Leyenda y nota (bajo el eje)
  \fill[blue!30, draw=blue!60!black] (0.2,-1.55) rectangle (0.5,-1.2); \node[right, font=\footnotesize] at (0.5,-1.37) {$S_1$};
  \fill[green!30, draw=green!45!black] (1.3,-1.55) rectangle (1.6,-1.2); \node[right, font=\footnotesize] at (1.6,-1.37) {$S_2$};
  \node[font=\footnotesize, anchor=west] at (2.6,-1.37) {Cada ronda es $A$ veces la anterior; la suma converge a $X=(I-A)^{-1}D$.};
\end{tikzpicture}
