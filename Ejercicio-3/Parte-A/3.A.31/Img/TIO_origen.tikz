% Figura: tabla de origen de la economía de dos ramas (productos por ramas), a precios básicos y transición a precios de adquisición, en notación general.
% Fuente de TIO_origen.pdf. v_{ji}: producción del producto i por la rama j (matriz V, ramas por productos, traspuesta).
% La versión con valores del ejemplo numérico es TIO_origen_num.tikz. Generar con: bash Code/generar_figura.sh TIO_origen
\begin{tikzpicture}[
  celda/.style={draw=black!75, line width=0.5pt, minimum height=0.85cm, minimum width=1.6cm, font=\small, inner sep=2pt, align=center, anchor=center},
  P/.style={fill=blue!12}, T/.style={fill=black!8}, M/.style={fill=yellow!35}, V/.style={fill=violet!12}]
  \matrix (m) [matrix of nodes, nodes={celda}, column sep=-0.5pt, row sep=-0.5pt,
               column 1/.style={nodes={minimum width=1.9cm}}, column 6/.style={nodes={minimum width=1.9cm}},
               column 7/.style={nodes={minimum width=1.8cm}}, column 8/.style={nodes={minimum width=1.8cm}}, column 9/.style={nodes={minimum width=2.7cm}},
               row 1/.style={nodes={minimum height=1.15cm, font=\footnotesize\bfseries}}]
  {
    Productos & \shortstack{Rama\\ $\boldsymbol{S_1}$} & \shortstack{Rama\\ $\boldsymbol{S_2}$} & |[T]| \shortstack{Producción\\ $\boldsymbol{q_i}$} & |[M]| \shortstack{Importac.\\ (CIF) $\boldsymbol{M_i}$} & |[T]| \shortstack{Oferta a p.\\ básicos $\boldsymbol{TR_i}$} & |[V]| \shortstack{Márgenes\\ comercio y\\ transp. $\boldsymbol{MC_i}$} & |[V]| \shortstack{Impuestos\\ netos sobre\\ productos $\boldsymbol{T_i}$} & |[T]| \shortstack{Oferta a p. de\\ adquisición\\ $\boldsymbol{TR^a_i}$} \\
    $\boldsymbol{P_1}$ & |[P]| $v_{11}$ & |[P]| $v_{21}$ & |[T]| $q_1$ & |[M]| $M_1$ & |[T]| $q_1+M_1$ & |[V]| $MC_1$ & |[V]| $T_1$ & |[T]| $TR_1+MC_1+T_1$ \\
    $\boldsymbol{P_2}$ & |[P]| $v_{12}$ & |[P]| $v_{22}$ & |[T]| $q_2$ & |[M]| $M_2$ & |[T]| $q_2+M_2$ & |[V]| $MC_2$ & |[V]| $T_2$ & |[T]| $TR_2+MC_2+T_2$ \\
    |[T]| \textbf{Total} & |[T]| $g_1$ & |[T]| $g_2$ & |[T]| $\sum q_i$ & |[T]| $\sum M_i$ & |[T]| $\sum TR_i$ & |[T]| $\sum MC_i=0$ & |[T]| $\sum T_i$ & |[T]| $\sum TR^a_i$ \\
  };
  \draw[decorate, decoration={brace, amplitude=5pt}, thick] ([yshift=2pt]m-1-2.north west) -- ([yshift=2pt]m-1-3.north east)
    node[midway, above=5pt, font=\footnotesize\bfseries] {Matriz de producción};
  \draw[decorate, decoration={brace, amplitude=5pt}, thick] ([yshift=2pt]m-1-7.north west) -- ([yshift=2pt]m-1-8.north east)
    node[midway, above=5pt, font=\footnotesize\bfseries] {Transición a precios de adquisición};
  \node[font=\footnotesize\itshape, text=black!65, align=left, anchor=north west] at ([yshift=-0.2cm]m-4-1.south west)
    {$v_{ji}$: producción del producto $i$ por la rama $j$. Filas: $q_i=\sum_j v_{ji}$; columnas: $g_j=\sum_i v_{ji}$.\\
     Diagonal: producción principal de cada rama; fuera de la diagonal: producción secundaria (sin ella, $q_i=g_i=X_i$).\\
     Los márgenes suman cero: el servicio de comercio y transporte pasa a formar parte del precio de los bienes que se distribuyen.};
\end{tikzpicture}
