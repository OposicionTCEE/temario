% Figura: TIO de flujos interiores de la economía de dos ramas, en notación general (las importaciones intermedias, como una fila de costes).
% Fuente de TIO_interior.pdf. La versión con valores del ejemplo numérico es TIO_interior_num.tikz.
% Generar con: bash Code/generar_figura.sh TIO_interior
\begin{tikzpicture}[
  celda/.style={draw=black!75, line width=0.5pt, minimum height=0.75cm, minimum width=1.35cm, font=\small, inner sep=2pt, text height=1.6ex, text depth=0.5ex, anchor=center},
  I/.style={fill=blue!12}, II/.style={fill=green!12}, III/.style={fill=red!10}, T/.style={fill=black!8},
  M/.style={fill=yellow!35}]
  \matrix (m) [matrix of math nodes, nodes={celda}, column sep=-0.5pt, row sep=-0.5pt,
               column 1/.style={nodes={minimum width=1.6cm}}, column 4/.style={nodes={minimum width=1.75cm}},
               column 10/.style={nodes={minimum width=1.75cm}}]
  {
    \text{\textbf{Ramas}} & \mathbf{S_1} & \mathbf{S_2} & |[T]| \mathbf{W^d_i} & \mathbf{C} & \mathbf{CC} & \mathbf{FBK} & \mathbf{E} & |[T]| \mathbf{D^d_i} & |[T]| \mathbf{X_i} \\
    \mathbf{S_1} & |[I]| x^d_{11} & |[I]| x^d_{12} & |[T]| W^d_1 & |[II]| C^d_1 & |[II]| CC^d_1 & |[II]| FBK^d_1 & |[II]| E^d_1 & |[T]| D^d_1 & |[T]| X_1 \\
    \mathbf{S_2} & |[I]| x^d_{21} & |[I]| x^d_{22} & |[T]| W^d_2 & |[II]| C^d_2 & |[II]| CC^d_2 & |[II]| FBK^d_2 & |[II]| E^d_2 & |[T]| D^d_2 & |[T]| X_2 \\
    |[T]| \mathbf{U^d_j} & |[T]| U^d_1 & |[T]| U^d_2 & |[T]| \sum x^d_{ij} & |[T]| \sum C^d_i & |[T]| \sum CC^d_i & |[T]| \sum FBK^d_i & |[T]| \sum E^d_i & |[T]| \sum D^d_i & |[T]| \sum X_i \\
    |[M]| \mathbf{U^m_j} & |[M]| U^m_1 & |[M]| U^m_2 & |[M]| \sum U^m_j \\
    \mathbf{RA_j} & |[III]| RA_1 & |[III]| RA_2 & |[T]| \sum RA_j \\
    \mathbf{EBE_j} & |[III]| EBE_1 & |[III]| EBE_2 & |[T]| \sum EBE_j \\
    |[T]| \mathbf{X_j} & |[T]| X_1 & |[T]| X_2 & |[T]| \sum X_j \\
  };
  \draw[decorate, decoration={brace, amplitude=5pt}, thick] ([yshift=2pt]m-1-2.north west) -- ([yshift=2pt]m-1-3.north east)
    node[midway, above=5pt, font=\footnotesize\bfseries] {I. Consumos intermedios interiores};
  \draw[decorate, decoration={brace, amplitude=5pt}, thick] ([yshift=2pt]m-1-5.north west) -- ([yshift=2pt]m-1-8.north east)
    node[midway, above=5pt, font=\footnotesize\bfseries] {II. Demanda final interior};
  % Corchete abierto hacia la matriz (la punta señala la etiqueta).
  \draw[decorate, decoration={brace, amplitude=5pt}, thick] ([xshift=6pt]m-5-4.north east) -- ([xshift=6pt]m-7-4.south east)
    node[midway, right=7pt, font=\footnotesize, align=left] {\textbf{Costes no interiores}:\\ inputs importados\\ y factores primarios};
  \node[font=\footnotesize\itshape, text=black!65, align=left, anchor=west] at ([xshift=0.6cm]m-8-4.east)
    {Fila $i$: $X_i=W^d_i+D^d_i$ \quad Columna $j$: $X_j=U^d_j+U^m_j+VAB_j$};
\end{tikzpicture}
