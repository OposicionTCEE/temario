% Figura: matriz de importaciones del ejemplo de dos ramas (destino de los productos importados).
% Fuente de TIO_importaciones.pdf.
\begin{tikzpicture}[
  celda/.style={draw=black!75, line width=0.5pt, minimum height=0.75cm, minimum width=1.1cm, font=\small, inner sep=1pt, text height=1.6ex, text depth=0.5ex, anchor=center},
  I/.style={fill=blue!12}, II/.style={fill=green!12}, T/.style={fill=black!8}, M/.style={fill=yellow!35}]
  \matrix (m) [matrix of math nodes, nodes={celda}, column sep=-0.5pt, row sep=-0.5pt,
               column 1/.style={nodes={minimum width=2.2cm}}]
  {
    \text{\textbf{Importado}} & \mathbf{S_1} & \mathbf{S_2} & |[T]| \mathbf{W^m_i} & \mathbf{C} & \mathbf{CC} & \mathbf{FBK} & \mathbf{E} & |[T]| \mathbf{D^m_i} & |[M]| \mathbf{M_i} \\
    \mathbf{S_1} & |[I]| 1 & |[I]| 0 & |[T]| 1 & |[II]| 0 & |[II]| 0 & |[II]| 0 & |[II]| 0 & |[T]| 0 & |[M]| 1 \\
    \mathbf{S_2} & |[I]| 0 & |[I]| 1 & |[T]| 1 & |[II]| 1 & |[II]| 0 & |[II]| 0 & |[II]| 0 & |[T]| 1 & |[M]| 2 \\
    |[M]| \mathbf{U^m_j} & |[M]| 1 & |[M]| 1 & |[M]| 2 & |[T]| 1 & |[T]| 0 & |[T]| 0 & |[T]| 0 & |[T]| 1 & |[M]| \mathbf{3} \\
  };
  \node[font=\footnotesize\itshape, text=black!65, align=left, anchor=north west] at ([yshift=-0.2cm]m-4-1.south west)
    {Tabla total $=$ tabla interior $+$ matriz de importaciones, casilla a casilla: $x_{ij}=x^d_{ij}+x^m_{ij}$.};
\end{tikzpicture}
