% Figura: matriz de importaciones de la economía de dos ramas (destino de los productos importados), en notación general.
% Fuente de TIO_importaciones.pdf. La versión con valores del ejemplo numérico es TIO_importaciones_num.tikz.
% Generar con: bash Code/generar_figura.sh TIO_importaciones
\begin{tikzpicture}[
  celda/.style={draw=black!75, line width=0.5pt, minimum height=0.75cm, minimum width=1.35cm, font=\small, inner sep=2pt, text height=1.6ex, text depth=0.5ex, anchor=center},
  I/.style={fill=blue!12}, II/.style={fill=green!12}, T/.style={fill=black!8}, M/.style={fill=yellow!35}]
  \matrix (m) [matrix of math nodes, nodes={celda}, column sep=-0.5pt, row sep=-0.5pt,
               column 1/.style={nodes={minimum width=2.2cm}}, column 4/.style={nodes={minimum width=1.75cm}},
               column 10/.style={nodes={minimum width=1.75cm}}]
  {
    \text{\textbf{Importado}} & \mathbf{S_1} & \mathbf{S_2} & |[T]| \mathbf{W^m_i} & \mathbf{C} & \mathbf{CC} & \mathbf{FBK} & \mathbf{E} & |[T]| \mathbf{D^m_i} & |[M]| \mathbf{M_i} \\
    \mathbf{S_1} & |[I]| x^m_{11} & |[I]| x^m_{12} & |[T]| W^m_1 & |[II]| C^m_1 & |[II]| CC^m_1 & |[II]| FBK^m_1 & |[II]| E^m_1 & |[T]| D^m_1 & |[M]| M_1 \\
    \mathbf{S_2} & |[I]| x^m_{21} & |[I]| x^m_{22} & |[T]| W^m_2 & |[II]| C^m_2 & |[II]| CC^m_2 & |[II]| FBK^m_2 & |[II]| E^m_2 & |[T]| D^m_2 & |[M]| M_2 \\
    |[M]| \mathbf{U^m_j} & |[M]| U^m_1 & |[M]| U^m_2 & |[M]| \sum x^m_{ij} & |[T]| \sum C^m_i & |[T]| \sum CC^m_i & |[T]| \sum FBK^m_i & |[T]| \sum E^m_i & |[T]| \sum D^m_i & |[M]| \sum M_i \\
  };
  \node[font=\footnotesize\itshape, text=black!65, align=left, anchor=north west] at ([yshift=-0.2cm]m-4-1.south west)
    {Fila $i$: $M_i=W^m_i+D^m_i$\qquad Tabla total $=$ tabla interior $+$ matriz de importaciones, casilla a casilla: $x_{ij}=x^d_{ij}+x^m_{ij}$.};
\end{tikzpicture}
