% Figura: estructura general de la TIO simétrica (tres bloques), con la notación del tema.
% Fuente de TIO_esquema.pdf.
\begin{tikzpicture}[>=stealth,
  caja/.style={draw=black!75, line width=0.6pt, minimum height=2.3cm, align=center, font=\small},
  tot/.style={draw=black!75, line width=0.6pt, fill=black!8, align=center, font=\small},
  cab/.style={font=\small\bfseries, align=center}]
  \node[caja, fill=blue!12, minimum width=5.2cm] (I) at (0,0)
    {\textbf{I. Consumos intermedios}\\[3pt] $x_{ij}$: compras de la rama $j$\\ a la rama $i$};
  \node[tot, minimum width=2.1cm, minimum height=2.3cm, anchor=west] (W) at (I.east)
    {Demanda\\ intermedia\\[2pt] $W_i=\sum_j x_{ij}$};
  \node[caja, fill=green!12, minimum width=4.6cm, anchor=west] (II) at (W.east)
    {\textbf{II. Demanda final}\\[3pt] $D_i=C_i+CC_i+FBK_i+E_i$};
  \node[tot, minimum width=2.1cm, minimum height=2.3cm, anchor=west] (TE) at (II.east)
    {Total\\ empleos\\[2pt] $TE_i=W_i+D_i$};
  \node[tot, minimum width=5.2cm, minimum height=1.0cm, anchor=north] (U) at (I.south)
    {Consumos intermedios: $U_j=\sum_i x_{ij}$};
  \node[caja, fill=red!10, minimum width=5.2cm, minimum height=1.8cm, anchor=north] (III) at (U.south)
    {\textbf{III. Inputs primarios}\\[3pt] $VAB_j=RA_j+EBE_j$};
  \node[tot, minimum width=5.2cm, minimum height=1.0cm, anchor=north] (X) at (III.south)
    {Producción: $X_j=U_j+VAB_j$};
  \node[draw=black!45, dashed, minimum width=8.8cm, minimum height=3.8cm, anchor=north west,
        font=\small\itshape, text=black!60, align=center] at (W.south west)
    {Cuadrante vacío: todo el valor añadido\\ se genera en alguna rama};
  \node[cab, anchor=south] at ([yshift=0.75cm]I.north) {Ramas compradoras $j=1,\dots,n$};
  \node[cab, anchor=south] at ([yshift=0.75cm]II.north) {Usos finales};
  \node[cab, rotate=90, anchor=south] at ([xshift=-0.85cm]I.west) {Ramas $i=1,\dots,n$};
  \node[cab, rotate=90, anchor=south] at ([xshift=-0.85cm]III.west) {Factores};
  \draw[->, line width=1pt, black!80] ([yshift=0.3cm]I.north west) -- ([yshift=0.3cm]TE.north east)
    node[pos=0.5, above=1pt, font=\footnotesize\itshape] {fila $i$: destinos (empleos) de la producción de $i$};
  \draw[->, line width=1pt, black!80] ([xshift=-0.3cm]I.north west) -- ([xshift=-0.3cm]X.south west)
    node[pos=0.5, below=1pt, sloped, font=\footnotesize\itshape] {columna $j$: costes de $j$};
\end{tikzpicture}
