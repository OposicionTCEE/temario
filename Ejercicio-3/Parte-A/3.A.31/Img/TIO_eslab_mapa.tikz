% Figura: mapa de las medidas de eslabonamiento según su alcance (directo o total) y su ámbito (global o bilateral).
% Fuente de TIO_eslab_mapa.pdf.
\begin{tikzpicture}[
  celda/.style={draw=black!75, line width=0.6pt, minimum height=2.0cm, text width=5.4cm, align=center, font=\small},
  cab/.style={draw=black!75, line width=0.6pt, fill=black!8, align=center, font=\small\bfseries}]
  \node[cab, minimum height=0.9cm, text width=5.4cm] (g) at (0,0) {Global\\ \mdseries\footnotesize una rama frente al conjunto del sistema};
  \node[cab, minimum height=0.9cm, text width=5.4cm, anchor=west] (b) at (g.east) {Bilateral\\ \mdseries\footnotesize una rama frente a otra};
  \node[cab, minimum width=2.6cm, minimum height=2.0cm, text width=2.4cm, anchor=north east] (d) at (g.south west) {Directo\\ \mdseries\footnotesize coeficientes\\ (bloque 1)};
  \node[cab, minimum width=2.6cm, minimum height=2.0cm, text width=2.4cm, anchor=north] (t) at (d.south) {Total\\ \mdseries\footnotesize inversa de LEONTIEF\\ (bloque 2)};
  \node[celda, fill=blue!10, anchor=north] (dg) at (g.south) {\textbf{CHENERY y WATANABE (1958)}\\[2pt] compras intermedias / producción\\ ventas intermedias / producción};
  \node[celda, fill=blue!10, anchor=north] (db) at (b.south) {\textbf{STREIT (1969)}\\[2pt] media de las cuatro ligazones\\ de oferta y de demanda entre $i$ y $j$};
  \node[celda, fill=green!10, anchor=north] (tg) at (dg.south) {\textbf{RASMUSSEN (1956)}\\[2pt] poder y sensibilidad de dispersión\\ (medias normalizadas de la inversa)};
  \node[celda, fill=green!10, anchor=north] (tb) at (db.south) {\textbf{Elementos $l_{ij}$ de la inversa}\\[2pt] requerimientos totales de $i$ por\\ unidad de demanda final de $j$};
\end{tikzpicture}
