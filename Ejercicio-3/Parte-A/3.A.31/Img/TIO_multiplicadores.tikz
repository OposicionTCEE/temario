% Figura: matriz inversa de LEONTIEF del ejemplo (economía sin importaciones) y multiplicadores por columnas.
% Fuente de TIO_multiplicadores.pdf.
\begin{tikzpicture}[
  celda/.style={draw=black!75, line width=0.5pt, minimum height=1.05cm, minimum width=1.9cm, font=\small, inner sep=1pt, align=center, anchor=center},
  L/.style={fill=blue!12}, T/.style={fill=black!8}, V/.style={fill=red!10}, E/.style={fill=cyan!10}]
  \matrix (m) [matrix of nodes, nodes={celda}, column sep=-0.5pt, row sep=-0.5pt,
               column 1/.style={nodes={minimum width=4.9cm, align=left, text width=4.6cm}}, row 1/.style={nodes={minimum height=0.8cm, font=\small\bfseries}}]
  {
    \textbf{Por unidad de demanda final de\dots} & $\boldsymbol{S_1}$ & $\boldsymbol{S_2}$ \\
    Producción requerida de $S_1$ ($l_{1j}$) & |[L]| \shortstack{$\frac{12}{7}$\\[1pt] $1{,}71$} & |[L]| \shortstack{$\frac{2}{7}$\\[1pt] $0{,}29$} \\
    Producción requerida de $S_2$ ($l_{2j}$) & |[L]| \shortstack{$1$\\[1pt] $1{,}00$} & |[L]| \shortstack{$\frac{4}{3}$\\[1pt] $1{,}33$} \\
    |[T]| \textbf{Multiplicador de producción} ($\sum_i l_{ij}$) & |[T]| $\mathbf{2{,}71}$ & |[T]| $\mathbf{1{,}62}$ \\
    |[V]| Valor añadido generado ($\sum_i v_i\, l_{ij}$) & |[V]| $1{,}00$ & |[V]| $1{,}00$ \\
    |[V]| Remuneración de asalariados ($\sum_i r_i\, l_{ij}$) & |[V]| $0{,}57$ & |[V]| $0{,}43$ \\
    |[E]| Empleo (ocupados, $\sum_i e_i\, l_{ij}$) & |[E]| $1{,}14$ & |[E]| $0{,}86$ \\
  };
  \draw[decorate, decoration={brace, amplitude=5pt, mirror}, thick] ([xshift=6pt]m-2-3.north east) -- ([xshift=6pt]m-3-3.south east)
    node[midway, right=6pt, font=\footnotesize, align=left] {\textbf{Inversa de LEONTIEF}\\ $L=(I-A)^{-1}$\\ \textit{cada columna: lo que}\\ \textit{arrastra una unidad de $D_j$}};
  \draw[decorate, decoration={brace, amplitude=5pt, mirror}, thick] ([xshift=6pt]m-4-3.north east) -- ([xshift=6pt]m-7-3.south east)
    node[midway, right=6pt, font=\footnotesize, align=left] {\textbf{Multiplicadores}\\ coeficientes directos\\ ($v$, $r$, $e$) ponderados\\ por la columna de $L$};
\end{tikzpicture}
