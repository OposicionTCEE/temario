% Figura: matriz inversa de LEONTIEF de la economía de dos ramas (sin importaciones) y multiplicadores por columnas, en notación general.
% Fuente de TIO_multiplicadores.pdf. La versión con valores del ejemplo numérico es TIO_multiplicadores_num.tikz.
% Generar con: bash Code/generar_figura.sh TIO_multiplicadores
\begin{tikzpicture}[
  celda/.style={draw=black!75, line width=0.5pt, minimum height=1.05cm, minimum width=2.9cm, font=\small, inner sep=2pt, align=center, anchor=center},
  L/.style={fill=blue!12}, T/.style={fill=black!8}, V/.style={fill=red!10}, E/.style={fill=cyan!10}]
  \matrix (m) [matrix of nodes, nodes={celda}, column sep=-0.5pt, row sep=-0.5pt,
               column 1/.style={nodes={minimum width=4.9cm, align=left, text width=4.6cm}}, row 1/.style={nodes={minimum height=0.8cm, font=\small\bfseries}}]
  {
    \textbf{Por unidad de demanda final de\dots} & $\boldsymbol{S_1}$ & $\boldsymbol{S_2}$ \\
    Producción requerida de $S_1$ ($l_{1j}$) & |[L]| $l_{11}$ & |[L]| $l_{12}$ \\
    Producción requerida de $S_2$ ($l_{2j}$) & |[L]| $l_{21}$ & |[L]| $l_{22}$ \\
    |[T]| \textbf{Multiplicador de producción} ($\sum_i l_{ij}$) & |[T]| $l_{11}+l_{21}$ & |[T]| $l_{12}+l_{22}$ \\
    |[V]| Valor añadido generado ($\sum_i v_i\, l_{ij}$) & |[V]| $v_1l_{11}+v_2l_{21}=1$ & |[V]| $v_1l_{12}+v_2l_{22}=1$ \\
    |[V]| Remuneración de asalariados ($\sum_i r_i\, l_{ij}$) & |[V]| $r_1l_{11}+r_2l_{21}$ & |[V]| $r_1l_{12}+r_2l_{22}$ \\
    |[E]| Empleo (ocupados, $\sum_i e_i\, l_{ij}$) & |[E]| $e_1l_{11}+e_2l_{21}$ & |[E]| $e_1l_{12}+e_2l_{22}$ \\
  };
  % Corchetes abiertos hacia la matriz (la punta señala la etiqueta).
  \draw[decorate, decoration={brace, amplitude=5pt}, thick] ([xshift=6pt]m-2-3.north east) -- ([xshift=6pt]m-3-3.south east)
    node[midway, right=7pt, font=\footnotesize, align=left] {\textbf{Inversa de LEONTIEF}\\ $L=(I-A)^{-1}$\\ \textit{cada columna: lo que}\\ \textit{arrastra una unidad de $D_j$}};
  \draw[decorate, decoration={brace, amplitude=5pt}, thick] ([xshift=6pt]m-4-3.north east) -- ([xshift=6pt]m-7-3.south east)
    node[midway, right=7pt, font=\footnotesize, align=left] {\textbf{Multiplicadores}\\ coeficientes directos\\ ($v$, $r$, $e$) ponderados\\ por la columna de $L$\\[2pt] \textit{sin importaciones,}\\ \textit{valor añadido $=1$}};
\end{tikzpicture}
