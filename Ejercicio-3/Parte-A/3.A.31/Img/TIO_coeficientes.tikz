% Figura: coeficientes técnicos (lectura por columnas) y de distribución (lectura por filas) de la economía de dos ramas, en notación general.
% Fuente de TIO_coeficientes.pdf. Tabla de flujos totales (TIO_abierta).
% La versión con valores del ejemplo numérico es TIO_coeficientes_num.tikz. Generar con: bash Code/generar_figura.sh TIO_coeficientes
\begin{tikzpicture}[
  celda/.style={draw=black!75, line width=0.5pt, minimum height=1.15cm, minimum width=1.7cm, font=\small, inner sep=2pt, align=center, anchor=center},
  I/.style={fill=blue!12}, II/.style={fill=green!12}, III/.style={fill=red!10}, T/.style={fill=black!8}]
  \matrix (a) [matrix of nodes, nodes={celda}, column sep=-0.5pt, row sep=-0.5pt,
               column 1/.style={nodes={minimum width=1.9cm}}, row 1/.style={nodes={minimum height=0.8cm, font=\small\bfseries}}]
  {
    & $\boldsymbol{S_1}$ & $\boldsymbol{S_2}$ \\
    $\boldsymbol{S_1}$ & |[I]| $a_{11}=\dfrac{x_{11}}{X_1}$ & |[I]| $a_{12}=\dfrac{x_{12}}{X_2}$ \\
    $\boldsymbol{S_2}$ & |[I]| $a_{21}=\dfrac{x_{21}}{X_1}$ & |[I]| $a_{22}=\dfrac{x_{22}}{X_2}$ \\
    $\boldsymbol{VAB_j/X_j}$ & |[III]| $v_1=\dfrac{VAB_1}{X_1}$ & |[III]| $v_2=\dfrac{VAB_2}{X_2}$ \\
    |[T]| \textbf{Total} & |[T]| $1$ & |[T]| $1$ \\
  };
  \node[font=\small\bfseries, anchor=south] at ([yshift=6pt]$(a-1-2.north)!0.5!(a-1-3.north)$) {Coeficientes técnicos: $a_{ij}=x_{ij}/X_j$};
  \node[font=\footnotesize\itshape, text=black!65, anchor=north, align=center] at ([yshift=-4pt]$(a-5-1.south)!0.5!(a-5-3.south)$) {Cada columna suma $1$: estructura de costes\\ $\sum_i a_{ij}+v_j=1$};

  \matrix (b) [matrix of nodes, nodes={celda}, column sep=-0.5pt, row sep=-0.5pt, anchor=north west,
               column 1/.style={nodes={minimum width=1.2cm}}, row 1/.style={nodes={minimum height=0.8cm, font=\small\bfseries}}]
    at ([xshift=1.6cm]a-1-3.north east)
  {
    & $\boldsymbol{S_1}$ & $\boldsymbol{S_2}$ & |[T]| \shortstack{Demanda\\ final} & |[T]| \textbf{Total} \\
    $\boldsymbol{S_1}$ & |[I]| $b_{11}=\dfrac{x_{11}}{TR_1}$ & |[I]| $b_{12}=\dfrac{x_{12}}{TR_1}$ & |[II]| $\dfrac{D_1}{TR_1}$ & |[T]| $1$ \\
    $\boldsymbol{S_2}$ & |[I]| $b_{21}=\dfrac{x_{21}}{TR_2}$ & |[I]| $b_{22}=\dfrac{x_{22}}{TR_2}$ & |[II]| $\dfrac{D_2}{TR_2}$ & |[T]| $1$ \\
  };
  \node[font=\small\bfseries, anchor=south] at ([yshift=6pt]$(b-1-2.north)!0.5!(b-1-5.north)$) {Coeficientes de distribución: $b_{ij}=x_{ij}/TR_i$};
  \node[font=\footnotesize\itshape, text=black!65, anchor=north, align=center] at ([yshift=-4pt]$(b-3-1.south)!0.5!(b-3-5.south)$) {Cada fila suma $1$: estructura de los destinos\\ $\sum_j b_{ij}+D_i/TR_i=1$};
\end{tikzpicture}
