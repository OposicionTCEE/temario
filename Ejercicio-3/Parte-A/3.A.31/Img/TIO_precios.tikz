% Figura: efecto de un aumento Delta v_2 del valor añadido por unidad de S2 (por ejemplo, salarios) sobre los precios, en notación general.
% Fuente de TIO_precios.pdf. Efecto directo (solo la rama que soporta el aumento) frente a efecto total (Delta p' = Delta v' L).
% Las alturas de las barras son solo ilustrativas. La versión con valores del ejemplo numérico es TIO_precios_num.tikz.
% Generar con: bash Code/generar_figura.sh TIO_precios
\begin{tikzpicture}[x=3.4cm, y=28cm, >=stealth]
  \draw[->, line width=0.8pt] (0,0) -- (3.55,0);
  \draw[->, line width=0.8pt] (0,0) -- (0,0.165) node[above, font=\small, align=center] {aumento del precio\\ (precio inicial $=1$)};
  % Barras: directo (gris) y total (rojo)
  \foreach \x/\d/\t/\lab/\dl/\tl in {0.6/0.000/0.100/{Precio de $S_1$}/{$0$}/{$l_{21}\Delta v_2$}, 1.7/0.100/0.1333/{Precio de $S_2$}/{$\Delta v_2$}/{$l_{22}\Delta v_2$}, 2.8/0.050/0.1167/{Precio de la demanda final}/{$\Delta v_2\dfrac{D_2}{\sum_i D_i}$}/{$\Delta v_2\dfrac{l_{21}D_1+l_{22}D_2}{\sum_i D_i}$}} {
    \fill[black!25, draw=black!60] (\x-0.3,0) rectangle (\x-0.02,\d);
    \fill[red!35, draw=red!60!black] (\x+0.02,0) rectangle (\x+0.3,\t);
    \node[above, font=\footnotesize] at (\x-0.2,\d) {\dl};
    \node[above, font=\footnotesize] at (\x+0.2,\t) {\tl};
    \node[below, font=\footnotesize, align=center, text width=3.2cm] at (\x,0) {\lab};
  }
  % Leyenda
  \fill[black!25, draw=black!60] (0.25,0.155) rectangle (0.33,0.1605); \node[right, font=\footnotesize] at (0.33,0.1578) {efecto directo};
  \fill[red!35, draw=red!60!black] (0.25,0.145) rectangle (0.33,0.1505); \node[right, font=\footnotesize] at (0.33,0.1478) {efecto total};
\end{tikzpicture}
