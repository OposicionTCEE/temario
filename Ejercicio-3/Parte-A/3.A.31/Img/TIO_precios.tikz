% Figura: efecto de un aumento de 0,1 en el valor añadido por unidad de S2 (por ejemplo, salarios) sobre los precios del ejemplo.
% Fuente de TIO_precios.pdf. Efecto directo (solo la rama que soporta el aumento) frente a efecto total (Delta p' = Delta v' L).
\begin{tikzpicture}[x=2.3cm, y=28cm, >=stealth]
  \draw[->, line width=0.8pt] (0,0) -- (3.55,0);
  \draw[->, line width=0.8pt] (0,0) -- (0,0.158) node[above, font=\small, align=center] {aumento del precio\\ (precio inicial $=1$)};
  \foreach \y/\l in {0.05/0{,}05,0.10/0{,}10,0.15/0{,}15} \draw (0,\y) -- (-0.04,\y) node[left, font=\footnotesize] {$\l$};
  % Barras: directo (gris) y total (rojo)
  \foreach \x/\d/\t/\lab/\dl/\tl in {0.6/0.000/0.100/{Precio de $S_1$}/{0}/{0{,}10}, 1.7/0.100/0.1333/{Precio de $S_2$}/{0{,}10}/{0{,}13}, 2.8/0.050/0.1167/{Precio de la demanda final}/{0{,}05}/{0{,}12}} {
    \fill[black!25, draw=black!60] (\x-0.36,0) rectangle (\x-0.02,\d);
    \fill[red!35, draw=red!60!black] (\x+0.02,0) rectangle (\x+0.36,\t);
    \node[above, font=\footnotesize] at (\x-0.19,\d) {$\dl$};
    \node[above, font=\footnotesize] at (\x+0.19,\t) {$\tl$};
    \node[below, font=\footnotesize, align=center, text width=3.2cm] at (\x,0) {\lab};
  }
  % Leyenda
  \fill[black!25, draw=black!60] (2.2,0.150) rectangle (2.32,0.1555); \node[right, font=\footnotesize] at (2.32,0.1528) {efecto directo};
  \fill[red!35, draw=red!60!black] (2.2,0.140) rectangle (2.32,0.1455); \node[right, font=\footnotesize] at (2.32,0.1428) {efecto total};
\end{tikzpicture}
