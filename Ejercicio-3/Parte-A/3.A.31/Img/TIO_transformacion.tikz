% Figura: de las tablas de origen y destino a la tabla simétrica (pasos de la transformación).
% Fuente de TIO_transformacion.pdf.
\begin{tikzpicture}[>=stealth, node distance=0.55cm,
  fuente/.style={draw=black!75, rounded corners=3pt, line width=0.6pt, align=center, font=\small, text width=4.6cm, minimum height=1.5cm},
  paso/.style={draw=black!75, rounded corners=3pt, line width=0.6pt, align=left, font=\small, text width=10.4cm, minimum height=1.05cm, fill=black!5},
  meta/.style={draw=black!85, rounded corners=3pt, line width=1.2pt, align=center, font=\small, text width=10.4cm, minimum height=1.3cm, fill=blue!10}]
  \node[fuente, fill=yellow!20] (O) {\textbf{Tabla de origen}\\ productos $\times$ ramas\\ precios básicos};
  \node[fuente, fill=green!12, right=1.2cm of O] (D) {\textbf{Tabla de destino}\\ productos $\times$ ramas\\ precios de adquisición};
  \node[paso, below=0.9cm of $(O.south)!0.5!(D.south)$] (P1)
    {\textbf{1. Valoración.} Se restan de cada empleo los márgenes y los impuestos netos sobre los productos (matrices de valoración): la tabla de destino pasa a precios básicos.};
  \node[paso, below=of P1] (P2)
    {\textbf{2. Origen.} Se separa cada empleo en su parte interior y su parte importada: tabla total, tabla interior y matriz de importaciones.};
  \node[paso, below=of P2] (P3)
    {\textbf{3. Hipótesis tecnológica.} Se reasigna la producción secundaria y sus inputs para que cada fila y cada columna se refieran a un mismo producto (tecnología de producto, de rama o método híbrido).};
  \node[meta, below=of P3] (S)
    {\textbf{Tabla input-output simétrica}\\ producto $\times$ producto (o rama $\times$ rama), precios básicos: total, interior e importada};
  \draw[->, line width=1pt] (O.south) -- (O.south |- P1.north);
  \draw[->, line width=1pt] (D.south) -- (D.south |- P1.north);
  \draw[->, line width=1pt] (P1) -- (P2);
  \draw[->, line width=1pt] (P2) -- (P3);
  \draw[->, line width=1pt] (P3) -- (S);
  \node[font=\footnotesize\itshape, text=black!65, anchor=west, align=left] at ([xshift=0.3cm]D.east)
    {Lo que observan\\ las estadísticas};
  \node[font=\footnotesize\itshape, text=black!65, anchor=west, align=left] at ([xshift=0.3cm]S.east)
    {Lo que usa\\ el análisis};
\end{tikzpicture}
