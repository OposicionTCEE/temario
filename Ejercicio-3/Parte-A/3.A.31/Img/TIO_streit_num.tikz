% Figura: las cuatro ligazones de STREIT (1969) entre las dos ramas del ejemplo (flujos interiores).
% Fuente de TIO_streit_num.pdf (anexo del ejemplo numérico). Generar con: bash Code/generar_figura.sh TIO_streit_num.
\begin{tikzpicture}[>=stealth,
  rama/.style={draw=black!80, line width=1pt, circle, minimum size=2.4cm, align=center, font=\small},
  lig/.style={font=\footnotesize, align=center, fill=white, inner sep=2pt}]
  \node[rama, fill=blue!10] (A) at (0,0) {\textbf{$S_1$}\\[2pt] vende $W^d_1=2$\\ compra $U^d_1=4$};
  \node[rama, fill=blue!10] (B) at (8,0) {\textbf{$S_2$}\\[2pt] vende $W^d_2=3$\\ compra $U^d_2=1$};
  \draw[->, line width=1.2pt] ([yshift=0.45cm]A.east) -- ([yshift=0.45cm]B.west)
    node[midway, above=2pt, font=\small] {$x^d_{12}=1$};
  \draw[->, line width=2.4pt] ([yshift=-0.45cm]B.west) -- ([yshift=-0.45cm]A.east)
    node[midway, below=2pt, font=\small] {$x^d_{21}=3$};
  \node[lig, anchor=south] at ([yshift=1.25cm]$(A)!0.5!(B)$)
    {\textbf{Flujo de $S_1$ a $S_2$}\\
     oferta: $x_{12}/W_1=\tfrac{1}{2}=0{,}50$ \quad demanda: $x_{12}/U_2=\tfrac{1}{1}=1{,}00$};
  \node[lig, anchor=north] at ([yshift=-1.25cm]$(A)!0.5!(B)$)
    {\textbf{Flujo de $S_2$ a $S_1$}\\
     oferta: $x_{21}/W_2=\tfrac{3}{3}=1{,}00$ \quad demanda: $x_{21}/U_1=\tfrac{3}{4}=0{,}75$};
  \node[font=\small, anchor=north] at ([yshift=-2.55cm]$(A)!0.5!(B)$)
    {Coeficiente de STREIT: $ST_{12}=\frac{0{,}50+1{,}00+1{,}00+0{,}75}{4}\approx0{,}81$};
\end{tikzpicture}
