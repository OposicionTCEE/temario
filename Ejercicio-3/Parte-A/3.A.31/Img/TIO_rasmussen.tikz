% Figura: clasificación de las ramas con los índices de RASMUSSEN (1956), en notación general.
% Fuente de TIO_rasmussen.pdf. Eje x: poder de dispersión (hacia atrás); eje y: sensibilidad de dispersión (hacia adelante); líneas: media = 1.
% La versión con las dos ramas del ejemplo numérico es TIO_rasmussen_num.tikz. Generar con: bash Code/generar_figura.sh TIO_rasmussen
\begin{tikzpicture}[x=6.5cm, y=9cm, >=stealth,
  cuad/.style={font=\small, align=center, text=black!80}]
  % Cuadrantes sombreados
  \fill[yellow!14] (0.5,1) rectangle (1,1.25);
  \fill[blue!10] (1,1) rectangle (1.5,1.25);
  \fill[red!8] (1,0.75) rectangle (1.5,1);
  \fill[black!5] (0.5,0.75) rectangle (1,1);
  % Ejes
  \draw[->, line width=0.8pt] (0.5,0.75) -- (1.55,0.75);
  \draw[->, line width=0.8pt] (0.5,0.75) -- (0.5,1.29) node[above right, font=\small, align=left] {sensibilidad de dispersión $U_{i\cdot}$ \footnotesize (hacia adelante)};
  \node[font=\small, align=center, anchor=north] at (1,0.70) {poder de dispersión $U_{\cdot j}$ \footnotesize (hacia atrás)};
  % Medias (= 1)
  \draw[dashed, line width=0.8pt] (1,0.75) -- (1,1.25);
  \node[below=1pt, font=\footnotesize] at (1,0.75) {$U_{\cdot j}=1$};
  \draw[dashed, line width=0.8pt] (0.5,1) -- (1.5,1) node[right, font=\footnotesize] {$U_{i\cdot}=1$};
  % Etiquetas de los cuadrantes
  \node[cuad] at (0.75,1.13) {\textbf{Sectores base}\\ $U_{\cdot j}<1$, $U_{i\cdot}>1$\\ abastecen al sistema,\\ compran poco};
  \node[cuad] at (1.25,1.13) {\textbf{Sectores clave}\\ $U_{\cdot j}>1$, $U_{i\cdot}>1$\\ arrastran y abastecen};
  \node[cuad] at (1.25,0.87) {\textbf{Sectores motores}\\ $U_{\cdot j}>1$, $U_{i\cdot}<1$\\ arrastran, venden a la DF};
  \node[cuad] at (0.75,0.87) {\textbf{Sectores independientes}\\ $U_{\cdot j}<1$, $U_{i\cdot}<1$\\ poco relacionados};
\end{tikzpicture}
