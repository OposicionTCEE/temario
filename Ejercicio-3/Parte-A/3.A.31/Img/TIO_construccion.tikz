% Figura: esquema de una página de la tabla simétrica (anexo de esquemas), como secuencia
% problema -> herramienta (la tabla cerrada construida bloque a bloque) -> resultado (identidades y PIB)
% -> ampliación a economía abierta (problema, herramienta, resultado) -> glosario de notación.
% Generar con: bash Code/generar_figura.sh TIO_construccion
\begin{tikzpicture}[>=stealth,
  celda/.style={draw=black!75, line width=0.5pt, minimum height=0.7cm, minimum width=1.2cm, font=\small, inner sep=2pt, text height=1.6ex, text depth=0.5ex, anchor=center},
  I/.style={fill=blue!12}, II/.style={fill=green!12}, III/.style={fill=red!10}, T/.style={fill=black!8}, M/.style={fill=yellow!35},
  caja/.style={draw=black!70, rounded corners=3pt, line width=0.6pt, align=left, font=\footnotesize, inner sep=4pt},
  num/.style={circle, fill=black!80, text=white, font=\footnotesize\bfseries, inner sep=1.2pt, minimum size=0.45cm},
  sec/.style={font=\small\bfseries, anchor=north west},
  flecha/.style={->, line width=0.8pt, black!70}]
  \coordinate (o) at (0,0);

  % ================= EL PROBLEMA =================
  \node[sec, text=red!50!black] at (0,0) {El problema};
  \node[caja, fill=red!6, text width=15.15cm, anchor=north west] (P) at (0,-0.45)
    {\textbf{¿Cómo registrar en un solo cuadro quién vende a quién, para qué y con qué costes, de forma que cuadre con el PIB?}};

  % ================= LA HERRAMIENTA =================
  \node[sec, text=blue!50!black] (hH) at ([yshift=-0.3cm]P.south west) {La herramienta: la tabla simétrica};
  \node[caja, fill=blue!6, text width=7.15cm, anchor=north west, minimum height=1.75cm] (c1) at ([yshift=-0.15cm]hH.south west)
    {\textbf{Bloque I. Consumos intermedios}\\[1pt]
     $x_{ij}$: lo que $j$ compra a $i$. Por filas, demanda intermedia, $W_i$; por columnas, consumos intermedios, $U_j$.\\
     Cuadran en total, $\sum W_i=\sum U_j$, pero no rama a rama.};
  \node[caja, fill=green!6, text width=7.65cm, anchor=north east, minimum height=1.75cm] (c2) at ([yshift=-0.15cm]hH.south west -| 15.7,0)
    {\textbf{Bloque II. Demanda final}\\[1pt]
     $D_i=C_i+CC_i+FBK_i+E_i$: lo final o intermedio lo decide el uso, no el producto.\\
     Fila completa: total de empleos, $TE_i=W_i+D_i$.};
  \node[num] at (c1.north west) {1};
  \node[num] at (c2.north west) {2};

  % Tabla cerrada (centro) y filas añadidas de la economía abierta. Ancho de la tabla: 12,7 cm
  \matrix (m) [matrix of math nodes, nodes={celda}, column sep=-0.5pt, row sep=-0.5pt, anchor=north west,
               column 1/.style={nodes={minimum width=1.4cm}}, column 4/.style={nodes={minimum width=1.5cm}},
               column 9/.style={nodes={minimum width=1.3cm}}, column 10/.style={nodes={minimum width=1.3cm}}] at ([yshift=-0.55cm]c1.south west -| 1.5,0)
  {
    \text{\textbf{Ramas}} & \mathbf{S_1} & \mathbf{S_2} & |[T]| \mathbf{W_i} & \mathbf{C} & \mathbf{CC} & \mathbf{FBK} & \mathbf{E} & |[T]| \mathbf{D_i} & |[T]| \mathbf{TE_i} \\
    \mathbf{S_1} & |[I]| x_{11} & |[I]| x_{12} & |[T]| W_1 & |[II]| C_1 & |[II]| CC_1 & |[II]| FBK_1 & |[II]| E_1 & |[T]| D_1 & |[T]| TE_1 \\
    \mathbf{S_2} & |[I]| x_{21} & |[I]| x_{22} & |[T]| W_2 & |[II]| C_2 & |[II]| CC_2 & |[II]| FBK_2 & |[II]| E_2 & |[T]| D_2 & |[T]| TE_2 \\
    |[T]| \mathbf{U_j} & |[T]| U_1 & |[T]| U_2 & |[T]| \sum x_{ij} & |[T]| \sum C_i & |[T]| \sum CC_i & |[T]| \sum FBK_i & |[T]| \sum E_i & |[T]| \sum D_i & |[T]| \sum TE_i \\
    \mathbf{RA_j} & |[III]| RA_1 & |[III]| RA_2 & |[T]| \sum RA_j \\
    \mathbf{EBE_j} & |[III]| EBE_1 & |[III]| EBE_2 & |[T]| \sum EBE_j \\
    |[T]| \mathbf{VAB_j} & |[T]| VAB_1 & |[T]| VAB_2 & |[T]| \sum VAB_j \\
    |[T]| \mathbf{X_j} & |[T]| X_1 & |[T]| X_2 & |[T]| \sum X_j \\
    |[M]| \mathbf{M_j} & |[M]| M_1 & |[M]| M_2 & |[M]| \sum M_j \\
    |[M]| \mathbf{TR_j} & |[M]| TR_1 & |[M]| TR_2 & |[M]| \sum TR_j \\
  };
  \draw[flecha] (c1.south -| m-1-3.west) -- (m-1-3.north west);
  \draw[flecha] (c2.south -| m-1-7.west) -- (m-1-7.north west);
  \draw[dashed, line width=1.2pt, orange!80!black] ([xshift=-4pt]m-8-1.south west) -- ([xshift=4pt]m-8-4.south east);
  \node[font=\footnotesize\itshape, text=black!60, anchor=east, align=right] at ([xshift=-0.1cm]$(m-1-1.north west)!0.5!(m-8-1.south west)$) {economía\\ cerrada};
  \node[font=\footnotesize\itshape, text=orange!50!black, anchor=east, align=right] at ([xshift=-0.1cm]$(m-9-1.north west)!0.5!(m-10-1.south west)$) {economía\\ abierta};

  % Bloque III, en el cuadrante vacío
  \node[caja, fill=red!5, text width=6.85cm, anchor=north west] (c3) at ([xshift=0.15cm, yshift=-0.15cm]m-4-5.south west)
    {\textbf{Bloque III. Inputs primarios}\\[1pt]
     $VAB_j=RA_j+EBE_j$; producción, $X_j=U_j+VAB_j$.\\
     El $EBE_j$ es el saldo que cierra la columna.\\
     Dato no monetario: los ocupados, $N_j$.};
  \node[num] at (c3.north west) {3};
  \draw[flecha] (c3.west) -- (c3.west -| m-6-4.east);
  \node[font=\footnotesize\itshape, text=orange!50!black, anchor=west, align=left] at ([xshift=0.3cm]m-9-4.south east)
    {filas amarillas: ampliación a economía abierta (abajo)};

  % ================= EL RESULTADO =================
  \node[sec, text=black!75] (hR) at ([yshift=-0.35cm]o |- m-10-1.south) {El resultado: dos lecturas que cuadran};
  \node[caja, fill=black!4, text width=15.15cm, anchor=north west] (R) at ([yshift=-0.12cm]hR.south west)
    {La fila dice para quién produce cada rama ($TE_i$); la columna, cómo produce ($X_j$); y $TE_i=X_i$. Sumando filas y columnas,
     $\sum_i D_i=\sum_j VAB_j$: \textbf{PIB por el gasto $=$ por la producción $=$ por la renta}. La producción total supera al PIB en $\sum\sum x_{ij}$: el valor añadido evita contar dos veces los inputs.};

  % ================= AMPLIACIÓN: ECONOMÍA ABIERTA =================
  \node[sec, text=orange!50!black] (hA) at ([yshift=-0.3cm]R.south west) {Ampliación: economía abierta};
  \node[caja, draw=orange!80!black, fill=yellow!10, text width=4.68cm, anchor=north west, minimum height=2.3cm] (a) at ([yshift=-0.12cm]hA.south west)
    {\textbf{Problema}\\[1pt]
     La oferta deja de ser solo producción interior, y cada empleo, intermedio o final, puede venir en parte de fuera.};
  \node[caja, draw=orange!80!black, fill=yellow!10, text width=4.68cm, anchor=north west, minimum height=2.3cm] (b) at ([xshift=0.3cm]a.north east)
    {\textbf{Herramienta}\\[1pt]
     Dos filas nuevas, sin tocar las columnas: importaciones de productos similares, $M_j$, asignadas a la rama que los produce, y oferta total, $TR_j=X_j+M_j=TE_j$.};
  \node[caja, draw=orange!80!black, fill=yellow!10, text width=4.68cm, anchor=north west, minimum height=2.3cm] (c) at ([xshift=0.3cm]b.north east)
    {\textbf{Resultado}\\[1pt]
     $\sum D_i-\sum M_i=\sum VAB_j$: aparece el saldo comercial. Queda abierto el origen de cada casilla: tabla interior $+$ importaciones (esquema siguiente, paso 2).};
  \draw[flecha, orange!80!black] (a.east) -- (b.west);
  \draw[flecha, orange!80!black] (b.east) -- (c.west);

  % ================= GLOSARIO =================
  \node[caja, fill=black!3, anchor=north west, inner sep=5pt, text width=15.15cm] (glos) at ([yshift=-0.4cm]a.south west)
    {\textbf{Glosario de notación.} {\itshape $i$: rama vendedora (fila); $j$: rama compradora (columna); $S_1$, $S_2$: las dos ramas.}\\[2pt]
     \renewcommand{\arraystretch}{1.05}%
     \begin{tabular}{@{}>{$}l<{$}@{\;\;}>{\raggedright\arraybackslash}p{3.7cm}@{\quad}>{$}l<{$}@{\;\;}>{\raggedright\arraybackslash}p{3.75cm}@{\quad}>{$}l<{$}@{\;\;}>{\raggedright\arraybackslash}p{3.45cm}@{}}
       x_{ij} & compras de $j$ a $i$ & D_i & demanda final & N_j & ocupados de la rama \\
       W_i & demanda intermedia (fila) & TE_i & total de empleos & M_i & importaciones similares a $i$ \\
       U_j & consumos intermedios (columna) & RA_j & remuneración de asalariados & TR_i & oferta total o recursos \\
       C_i,\,CC_i & consumo individual y colectivo & EBE_j & excedente bruto de explotación & x^d_{ij},\,x^m_{ij} & parte interior e importada \\
       FBK_i & formación bruta de capital & VAB_j & valor añadido bruto & & \\
       E_i & exportaciones & X_j & producción de la rama & & \\
     \end{tabular}};
\end{tikzpicture}
