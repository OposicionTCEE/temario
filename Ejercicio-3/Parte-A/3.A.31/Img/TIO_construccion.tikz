% Figura: esquema de una página de la construcción progresiva de la TIO simétrica (anexo de esquemas).
% Centro: la tabla cerrada de dos ramas (TIO_cerrada), con llamadas numeradas por bloques e identidades,
% y una tira añadida con la ampliación a economía abierta (cambios, problema e implicaciones).
% Generar con: bash Code/generar_figura.sh TIO_construccion
\begin{tikzpicture}[>=stealth,
  celda/.style={draw=black!75, line width=0.5pt, minimum height=0.7cm, minimum width=1.2cm, font=\small, inner sep=2pt, text height=1.6ex, text depth=0.5ex, anchor=center},
  I/.style={fill=blue!12}, II/.style={fill=green!12}, III/.style={fill=red!10}, T/.style={fill=black!8}, M/.style={fill=yellow!35},
  caja/.style={draw=black!70, rounded corners=3pt, line width=0.6pt, align=left, font=\footnotesize, inner sep=4pt},
  num/.style={circle, fill=black!80, text=white, font=\footnotesize\bfseries, inner sep=1.2pt, minimum size=0.45cm},
  flecha/.style={->, line width=0.8pt, black!70}]
  % --- Tabla cerrada (centro) y filas añadidas de la economía abierta. Ancho de la tabla: 12,7 cm ---
  \matrix (m) [matrix of math nodes, nodes={celda}, column sep=-0.5pt, row sep=-0.5pt, anchor=north west,
               column 1/.style={nodes={minimum width=1.4cm}}, column 4/.style={nodes={minimum width=1.5cm}},
               column 9/.style={nodes={minimum width=1.3cm}}, column 10/.style={nodes={minimum width=1.3cm}}] at (1.5,-3.75)
  {
    \text{\textbf{Ramas}} & \mathbf{S_1} & \mathbf{S_2} & |[T]| \mathbf{W_i} & \mathbf{C} & \mathbf{CC} & \mathbf{FBK} & \mathbf{E} & |[T]| \mathbf{D_i} & |[T]| \mathbf{TE_i} \\
    \mathbf{S_1} & |[I]| x_{11} & |[I]| x_{12} & |[T]| W_1 & |[II]| C_1 & |[II]| CC_1 & |[II]| FBK_1 & |[II]| E_1 & |[T]| D_1 & |[T]| TE_1 \\
    \mathbf{S_2} & |[I]| x_{21} & |[I]| x_{22} & |[T]| W_2 & |[II]| C_2 & |[II]| CC_2 & |[II]| FBK_2 & |[II]| E_2 & |[T]| D_2 & |[T]| TE_2 \\
    |[T]| \mathbf{U_j} & |[T]| U_1 & |[T]| U_2 & |[T]| \sum x_{ij} & |[T]| \sum C_i & |[T]| \sum CC_i & |[T]| \sum FBK_i & |[T]| \sum E_i & |[T]| \sum D_i & |[T]| \sum TE_i \\
    \mathbf{RA_j} & |[III]| RA_1 & |[III]| RA_2 & |[T]| \sum RA_j \\
    \mathbf{EBE_j} & |[III]| EBE_1 & |[III]| EBE_2 & |[T]| \sum EBE_j \\
    |[T]| \mathbf{VAB_j} & |[T]| VAB_1 & |[T]| VAB_2 & |[T]| \sum VAB_j \\
    |[T]| \mathbf{X_j} & |[T]| X_1 & |[T]| X_2 & |[T]| \sum X_j \\
    |[M]| \mathbf{M_j} & |[M]| M_1 & |[M]| M_2 & |[M]| \sum M_j \\
    |[M]| \mathbf{TR_j} & |[M]| TR_1 & |[M]| TR_2 & |[M]| \sum TR_j \\
  };
  % Línea que separa la tabla cerrada de las filas añadidas
  \draw[dashed, line width=1.2pt, orange!80!black] ([xshift=-4pt]m-8-1.south west) -- ([xshift=4pt]m-8-4.south east);
  \node[font=\footnotesize\itshape, text=orange!50!black, anchor=east, align=right] at ([xshift=-0.1cm]$(m-9-1.north west)!0.5!(m-10-1.south west)$) {economía\\ abierta};
  \node[font=\footnotesize\itshape, text=black!60, anchor=east, align=right] at ([xshift=-0.1cm]$(m-1-1.north west)!0.5!(m-8-1.south west)$) {economía\\ cerrada};

  % --- 1 y 2: encima de la tabla ---
  \node[caja, fill=blue!6, text width=7.15cm, anchor=north west, minimum height=3.05cm] (c1) at (0,0)
    {\textbf{Bloque I. Consumos intermedios}\\[1pt]
     $x_{ij}$: lo que la rama $j$ compra a la rama $i$. Por filas, demanda intermedia, $W_i$; por columnas, consumos intermedios, $U_j$.\\
     $\sum W_i=\sum U_j$, pero no rama a rama: $U_1-W_1=x_{21}-x_{12}$, una rama compradora neta y otra suministradora neta.\\
     La diagonal depende del grado de agregación.};
  \node[caja, fill=green!6, text width=7.65cm, anchor=north east, minimum height=3.05cm] (c2) at (15.7,0)
    {\textbf{Bloque II. Demanda final}\\[1pt]
     $D_i=C_i+CC_i+FBK_i+E_i$. Intermedio o final según el uso, no según el producto (la FBK es final: el capital dura varios periodos).\\
     Fila completa: total de empleos, $TE_i=W_i+D_i$.\\
     $W_i>D_i$: la rama depende de las demás ramas; $D_i>W_i$: del gasto final.};
  \node[num] at (c1.north west) {1};
  \node[num] at (c2.north west) {2};
  \draw[flecha] (c1.south -| m-1-3.west) -- (m-1-3.north west);
  \draw[flecha] (c2.south -| m-1-7.west) -- (m-1-7.north west);

  % --- 3: en el cuadrante vacío, junto al bloque III ---
  \node[caja, fill=red!5, text width=6.85cm, anchor=north west] (c3) at ([xshift=0.15cm, yshift=-0.1cm]m-4-5.south west)
    {\textbf{Bloque III. Inputs primarios}\\[1pt]
     $VAB_j=RA_j+EBE_j$; producción, $X_j=U_j+VAB_j$.\\
     El $EBE_j$ es un saldo: la tabla \textbf{cuadra por construcción}, $TE_i=X_i$.\\
     Columna: cómo produce la rama (costes); fila: para quién (destinos).\\
     Además, los ocupados, $N_j$ (dato no monetario).};
  \node[num] at (c3.north west) {3};
  \draw[flecha] (c3.west) -- (c3.west -| m-6-4.east);

  % --- 5 (junto a las filas añadidas) ---
  \node[caja, draw=orange!80!black, fill=yellow!15, text width=6.35cm, anchor=west] (c5e) at ([xshift=0.65cm]m-9-4.south east)
    {Se añaden dos filas y las columnas no cambian: importaciones de productos similares, $M_j$, y oferta total, $TR_j=X_j+M_j$.};
  \node[num, fill=orange!80!black] at (c5e.north west) {5};
  \draw[flecha, orange!80!black] (c5e.west) -- (c5e.west -| m-9-4.east);

  % --- 4: identidades, debajo de la tabla ---
  \node[caja, fill=black!4, text width=15.15cm, anchor=north west] (c4) at (0,-11.35)
    {\textbf{Identidades: de la tabla al PIB.} Filas y columnas suman lo mismo, y el bloque I también, luego
     $\sum_i D_i=\sum_j VAB_j$: \textbf{gasto} $=$ \textbf{producción} $=$ \textbf{renta}. Con importaciones, $\sum_i D_i-\sum_i M_i=\sum_j VAB_j$. La producción total supera al PIB en $\sum\sum x_{ij}$: el valor añadido evita contar dos veces los inputs.};
  \node[num] at (c4.north west) {4};

  % --- 5: la ampliación a economía abierta ---
  \node[font=\small\bfseries, anchor=north west, text=orange!50!black] (t5) at ([yshift=-0.3cm]c4.south west)
    {Ampliación a economía abierta: qué cambia, qué problema aparece y qué implica};
  \node[caja, draw=orange!80!black, fill=yellow!10, text width=4.68cm, anchor=north west] (a) at ([yshift=-0.12cm]t5.south west)
    {\textbf{Qué cambia}\\[1pt]
     Oferta $=$ producción interior $+$ importaciones: $TR_i=X_i+M_i=TE_i$.\\
     Las importaciones van a la rama que produce bienes similares, no a quien importa (homogeneidad).\\
     Las columnas no cambian: $X_j=U_j+VAB_j$.\\
     Con la misma producción, el PIB no depende de lo que se importe; cambia la composición del gasto: aparece el saldo comercial, $\sum E_i-\sum M_i$.};
  \node[caja, draw=orange!80!black, fill=yellow!10, text width=4.68cm, anchor=north west] (b) at ([xshift=0.3cm]a.north east)
    {\textbf{Qué problema aparece}\\[1pt]
     La tabla total no dice de dónde viene cada empleo: $x_{21}$ o $C_2$ pueden ser en parte interiores y en parte importados.\\
     Lo técnico (lo que una rama necesita) deja de coincidir con lo nacional (lo que arrastra a los productores residentes).\\
     Las importaciones sin equivalente interior (complementarias) no tienen rama: van en una fila aparte.};
  \node[caja, draw=orange!80!black, fill=yellow!10, text width=4.68cm, anchor=north west] (c) at ([xshift=0.3cm]b.north east)
    {\textbf{Qué implica}\\[1pt]
     $x_{ij}=x^d_{ij}+x^m_{ij}$: tabla total $=$ \textbf{tabla interior} $+$ \textbf{matriz de importaciones}.\\
     En la interior, los inputs importados, $U^m_j$, son un coste más, como un input primario: una \textbf{fuga} del circuito, y multiplicadores interiores menores que los totales.\\
     Impacto nacional: tabla interior; tecnología y comparaciones: tabla total; contenido importado de las exportaciones: las dos.};
  \draw[flecha, orange!80!black] ([yshift=-1.2cm]a.north east) -- ([yshift=-1.2cm]b.north west);
  \draw[flecha, orange!80!black] ([yshift=-1.2cm]b.north east) -- ([yshift=-1.2cm]c.north west);

  % --- Glosario de notación (debajo de todo) ---
  \coordinate (o) at (0,0);
  \path (current bounding box.south) coordinate (fin);
  \node[caja, fill=black!3, anchor=north west, inner sep=5pt, text width=15.15cm] (glos) at ([yshift=-0.4cm]o |- fin)
    {\textbf{Glosario de notación.} {\itshape $i$: rama vendedora (fila); $j$: rama compradora (columna); $S_1$, $S_2$: las dos ramas.}\\[2pt]
     \renewcommand{\arraystretch}{1.05}%
     \begin{tabular}{@{}>{$}l<{$}@{\;\;}>{\raggedright\arraybackslash}p{3.7cm}@{\quad}>{$}l<{$}@{\;\;}>{\raggedright\arraybackslash}p{3.75cm}@{\quad}>{$}l<{$}@{\;\;}>{\raggedright\arraybackslash}p{3.45cm}@{}}
       x_{ij} & compras de $j$ a $i$ & D_i & demanda final & M_i & importaciones similares a $i$ \\
       W_i & demanda intermedia (fila) & TE_i & total de empleos & TR_i & oferta total o recursos \\
       U_j & consumos intermedios (columna) & RA_j & remuneración de asalariados & x^d_{ij},\,x^m_{ij} & parte interior e importada \\
       C_i,\,CC_i & consumo individual y colectivo & EBE_j & excedente bruto de explotación & W^d_i,\,D^d_i & empleos de origen interior \\
       FBK_i & formación bruta de capital & VAB_j & valor añadido bruto & W^m_i,\,D^m_i & empleos de lo importado \\
       E_i & exportaciones & X_j,\;N_j & producción; ocupados & U^d_j,\,U^m_j & inputs interiores e importados \\
     \end{tabular}};
\end{tikzpicture}
