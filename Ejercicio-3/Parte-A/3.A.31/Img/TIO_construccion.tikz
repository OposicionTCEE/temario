% Figura: esquema de una página de la construcción progresiva de la TIO simétrica (anexo de esquemas).
% Centro: la tabla cerrada de dos ramas (TIO_cerrada), con llamadas numeradas por bloques e identidades,
% y una tira añadida con la ampliación a economía abierta (cambios, problema e implicaciones).
% Generar con: bash Code/generar_figura.sh TIO_construccion
\begin{tikzpicture}[>=stealth,
  celda/.style={draw=black!75, line width=0.5pt, minimum height=0.7cm, minimum width=1.2cm, font=\small, inner sep=2pt, text height=1.6ex, text depth=0.5ex, anchor=center},
  I/.style={fill=blue!12}, II/.style={fill=green!12}, III/.style={fill=red!10}, T/.style={fill=black!8}, M/.style={fill=yellow!35},
  caja/.style={draw=black!70, rounded corners=3pt, line width=0.6pt, align=left, font=\footnotesize, inner sep=4pt},
  num/.style={circle, fill=black!80, text=white, font=\footnotesize\bfseries, inner sep=1.2pt, minimum size=0.45cm},
  flecha/.style={->, line width=0.8pt, black!70}]
  % --- Tabla cerrada (centro) y filas de la economía abierta ---
  \matrix (m) [matrix of math nodes, nodes={celda}, column sep=-0.5pt, row sep=-0.5pt,
               column 1/.style={nodes={minimum width=1.4cm}}, column 4/.style={nodes={minimum width=1.5cm}},
               column 9/.style={nodes={minimum width=1.3cm}}, column 10/.style={nodes={minimum width=1.3cm}}]
  {
    \text{\textbf{Ramas}} & \mathbf{S_1} & \mathbf{S_2} & |[T]| \mathbf{W_i} & \mathbf{C} & \mathbf{CC} & \mathbf{FBK} & \mathbf{E} & |[T]| \mathbf{D_i} & |[T]| \mathbf{TE_i} \\
    \mathbf{S_1} & |[I]| x_{11} & |[I]| x_{12} & |[T]| W_1 & |[II]| C_1 & |[II]| CC_1 & |[II]| FBK_1 & |[II]| E_1 & |[T]| D_1 & |[T]| TE_1 \\
    \mathbf{S_2} & |[I]| x_{21} & |[I]| x_{22} & |[T]| W_2 & |[II]| C_2 & |[II]| CC_2 & |[II]| FBK_2 & |[II]| E_2 & |[T]| D_2 & |[T]| TE_2 \\
    |[T]| \mathbf{U_j} & |[T]| U_1 & |[T]| U_2 & |[T]| \sum x_{ij} & |[T]| \sum C_i & |[T]| \sum CC_i & |[T]| \sum FBK_i & |[T]| \sum E_i & |[T]| \sum D_i & |[T]| \sum TE_i \\
    \mathbf{RA_j} & |[III]| RA_1 & |[III]| RA_2 & |[T]| \sum RA_j \\
    \mathbf{EBE_j} & |[III]| EBE_1 & |[III]| EBE_2 & |[T]| \sum EBE_j \\
    |[T]| \mathbf{VAB_j} & |[T]| VAB_1 & |[T]| VAB_2 & |[T]| \sum VAB_j \\
    |[T]| \mathbf{X_j} & |[T]| X_1 & |[T]| X_2 & |[T]| \sum X_j \\
    |[M]| \mathbf{M_j} & |[M]| M_1 & |[M]| M_2 & |[M]| \sum M_j \\
    |[M]| \mathbf{TR_j} & |[M]| TR_1 & |[M]| TR_2 & |[M]| \sum TR_j \\
  };
  % Separación visual entre la tabla cerrada y la ampliación
  \draw[dashed, line width=1pt, orange!80!black] ([xshift=-3pt, yshift=-1.5pt]m-8-1.south west) -- ([xshift=3pt, yshift=-1.5pt]m-8-4.south east);
  % Números sobre los bloques de la tabla
  \node[num] (n1t) at ($(m-2-2.north west)!0.5!(m-3-3.south east)$) {1};
  \node[num] (n2t) at ($(m-2-5.north west)!0.5!(m-3-8.south east)$) {2};
  \node[num] (n3t) at ($(m-5-2.north west)!0.5!(m-6-3.south east)$) {3};
  \node[num] (n5t) at ([xshift=-0.45cm]$(m-9-1.north west)!0.5!(m-10-1.south west)$) {5};
  \node[num] (n4t) at ([xshift=-0.45cm]$(m-7-1.north west)!0.5!(m-8-1.south west)$) {4};

  % --- 1 y 2: encima de la tabla ---
  \node[caja, fill=blue!6, text width=6.3cm, anchor=south west] (c1) at ([yshift=0.55cm]m-1-1.north west)
    {\textbf{Bloque I. Consumos intermedios}\\[1pt]
     $x_{ij}$: lo que la rama $j$ compra a la rama $i$.\\
     Por filas, demanda intermedia $W_i$; por columnas, consumos intermedios $U_j$.\\
     $\sum W_i=\sum U_j$, pero no rama a rama: $U_1-W_1=x_{21}-x_{12}$ (una rama compradora neta, otra suministradora neta).\\
     La diagonal depende del grado de agregación.};
  \node[caja, fill=green!6, text width=7.6cm, anchor=south east] (c2) at ([yshift=0.55cm]m-1-10.north east)
    {\textbf{Bloque II. Demanda final}\\[1pt]
     $D_i=C_i+CC_i+FBK_i+E_i$. Lo que distingue intermedio y final es el uso, no el producto (la FBK es final: el capital dura varios periodos).\\
     Fila completa: total de empleos, $TE_i=W_i+D_i$.\\
     $W_i>D_i$: la rama depende de las demás ramas; $D_i>W_i$: del gasto de hogares, Administraciones, inversores y resto del mundo.};
  \node[num] at (c1.north west) {1};
  \node[num] at (c2.north west) {2};
  \draw[flecha] (c1.south) -- (c1.south |- m-1-2.north);
  \draw[flecha] (c2.south) -- (c2.south |- m-1-6.north);

  % --- 3: en el cuadrante vacío, junto al bloque III ---
  \node[caja, fill=red!5, text width=7.3cm, anchor=north west] (c3) at ([xshift=0.15cm, yshift=-0.05cm]m-5-5.north west)
    {\textbf{Bloque III. Inputs primarios}\\[1pt]
     $VAB_j=RA_j+EBE_j$; producción, $X_j=U_j+VAB_j$.\\
     El $EBE_j$ se calcula como saldo: la tabla \textbf{cuadra por construcción}, $TE_i=X_i$.\\
     Dos lecturas: la columna dice cómo produce la rama (costes); la fila, para quién produce (destinos).\\
     Información no monetaria: ocupados $N_j$ (multiplicadores de empleo).};
  \node[num] at (c3.north west) {3};
  \draw[flecha] (c3.west) -- ([xshift=1pt]c3.west -| m-6-4.east);

  % --- 5 (etiqueta junto a las filas añadidas) ---
  \node[caja, draw=orange!80!black, fill=yellow!15, text width=7.3cm, anchor=west] (c5e) at ([xshift=0.15cm]$(m-9-4.north east)!0.5!(m-10-4.south east)$)
    {\textbf{Economía abierta:} se añaden dos filas, sin tocar las columnas: importaciones de productos similares, $M_j$, y oferta total, $TR_j=X_j+M_j$.};
  \node[num, fill=orange!80!black] at (c5e.north west) {5};

  % --- 4: identidades, debajo de la tabla ---
  \node[caja, fill=black!4, text width=15.4cm, anchor=north] (c4) at ([yshift=-0.45cm]$(m-10-1.south west)!0.5!(m-10-10.south east)$)
    {\textbf{Identidades: de la tabla al PIB.} Filas y columnas suman lo mismo, y el bloque I también, luego
     $\sum_i D_i=\sum_j VAB_j$: \textbf{gasto} $=$ \textbf{producción} $=$ \textbf{renta}. La producción total supera al PIB en $\sum\sum x_{ij}$: el valor añadido evita contar dos veces los inputs.};
  \node[num] at (c4.north west) {4};

  % --- 5: la ampliación a economía abierta ---
  \node[font=\small\bfseries, anchor=north west, text=orange!50!black] (t5) at ([yshift=-0.35cm]c4.south west)
    {Ampliación a economía abierta: qué cambia, qué problema aparece y qué implica};
  \node[caja, draw=orange!80!black, fill=yellow!10, text width=4.75cm, anchor=north west, minimum height=5.1cm] (a) at ([yshift=-0.15cm]t5.south west)
    {\textbf{Qué cambia}\\[1pt]
     Oferta $=$ producción interior $+$ importaciones: $TR_i=X_i+M_i=TE_i$.\\
     Las importaciones se asignan a la rama que produce bienes similares, no a quien importa (homogeneidad).\\
     Las columnas no cambian: $X_j=U_j+VAB_j$.\\
     PIB: $\sum_i D_i-\sum_i M_i=\sum_j VAB_j$. Aparece el saldo comercial, $\sum E_i-\sum M_i$.};
  \node[caja, draw=orange!80!black, fill=yellow!10, text width=4.75cm, anchor=north west, minimum height=5.1cm] (b) at ([xshift=0.3cm]a.north east)
    {\textbf{Qué problema aparece}\\[1pt]
     La tabla total no dice de dónde viene cada empleo: $x_{21}$ o $C_2$ pueden ser en parte interiores y en parte importados.\\
     Lo técnico (lo que una rama necesita) deja de coincidir con lo nacional (lo que arrastra a los productores residentes).\\
     Las importaciones sin equivalente interior (complementarias) no tienen rama: van en una fila aparte.};
  \node[caja, draw=orange!80!black, fill=yellow!10, text width=4.75cm, anchor=north west, minimum height=5.1cm] (c) at ([xshift=0.3cm]b.north east)
    {\textbf{Qué implica}\\[1pt]
     $x_{ij}=x^d_{ij}+x^m_{ij}$: tabla total $=$ \textbf{tabla interior} $+$ \textbf{matriz de importaciones}.\\
     En la interior, los inputs importados $U^m_j$ son un coste más, como un input primario: una \textbf{fuga} del circuito.\\
     Multiplicadores interiores $<$ totales. Impacto nacional: tabla interior; tecnología y comparaciones: tabla total; contenido importado de las exportaciones: las dos.};
  \draw[flecha, orange!80!black] (a.east) -- (b.west);
  \draw[flecha, orange!80!black] (b.east) -- (c.west);
\end{tikzpicture}
