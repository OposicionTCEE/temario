% Figura: las cuatro ligazones de STREIT (1969) entre las dos ramas de la economía (flujos interiores), en notación general.
% Fuente de TIO_streit.pdf. La versión con valores del ejemplo numérico es TIO_streit_num.tikz.
% Generar con: bash Code/generar_figura.sh TIO_streit
\begin{tikzpicture}[>=stealth,
  rama/.style={draw=black!80, line width=1pt, circle, minimum size=2.4cm, align=center, font=\small},
  lig/.style={font=\footnotesize, align=center, fill=white, inner sep=2pt}]
  \node[rama, fill=blue!10] (A) at (0,0) {\textbf{$S_1$}\\[2pt] vende $W^d_1$\\ compra $U^d_1$};
  \node[rama, fill=blue!10] (B) at (8,0) {\textbf{$S_2$}\\[2pt] vende $W^d_2$\\ compra $U^d_2$};
  \draw[->, line width=1.2pt] ([yshift=0.45cm]A.east) -- ([yshift=0.45cm]B.west)
    node[midway, above=2pt, font=\small] {$x^d_{12}$};
  \draw[->, line width=1.2pt] ([yshift=-0.45cm]B.west) -- ([yshift=-0.45cm]A.east)
    node[midway, below=2pt, font=\small] {$x^d_{21}$};
  \node[lig, anchor=south] at ([yshift=1.25cm]$(A)!0.5!(B)$)
    {\textbf{Flujo de $S_1$ a $S_2$}\\
     oferta: $x^d_{12}/W^d_1$ ($S_2$ como cliente de $S_1$) \quad demanda: $x^d_{12}/U^d_2$ ($S_1$ como proveedor de $S_2$)};
  \node[lig, anchor=north] at ([yshift=-1.25cm]$(A)!0.5!(B)$)
    {\textbf{Flujo de $S_2$ a $S_1$}\\
     oferta: $x^d_{21}/W^d_2$ ($S_1$ como cliente de $S_2$) \quad demanda: $x^d_{21}/U^d_1$ ($S_2$ como proveedor de $S_1$)};
  \node[font=\small, anchor=north] at ([yshift=-2.55cm]$(A)!0.5!(B)$)
    {Coeficiente de STREIT: $ST_{12}=\dfrac{1}{4}\left(\dfrac{x^d_{12}}{W^d_1}+\dfrac{x^d_{12}}{U^d_2}+\dfrac{x^d_{21}}{W^d_2}+\dfrac{x^d_{21}}{U^d_1}\right)$};
\end{tikzpicture}
