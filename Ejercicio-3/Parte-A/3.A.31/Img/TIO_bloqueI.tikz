% Figura: bloque I (consumos intermedios) de la economía de dos ramas, en notación general.
% Fuente de TIO_bloqueI.pdf. Generar con: bash Code/generar_figura.sh TIO_bloqueI
\begin{tikzpicture}[
  celda/.style={draw=black!75, line width=0.5pt, minimum height=0.8cm, minimum width=2.9cm, font=\small, inner sep=2pt, text height=1.6ex, text depth=0.5ex, anchor=center},
  I/.style={fill=blue!12}, T/.style={fill=black!8}]
  \matrix (m) [matrix of math nodes, nodes={celda}, column sep=-0.5pt, row sep=-0.5pt,
               column 1/.style={nodes={minimum width=3.4cm}}, column 4/.style={nodes={minimum width=3.6cm}}]
  {
    \text{\textbf{Ramas}} & \mathbf{S_1} & \mathbf{S_2} & |[T]| \text{Demanda intermedia } W_i \\
    \mathbf{S_1} & |[I]| x_{11} & |[I]| x_{12} & |[T]| W_1=x_{11}+x_{12} \\
    \mathbf{S_2} & |[I]| x_{21} & |[I]| x_{22} & |[T]| W_2=x_{21}+x_{22} \\
    |[T]| \text{Consumos intermedios } U_j & |[T]| U_1=x_{11}+x_{21} & |[T]| U_2=x_{12}+x_{22} & |[T]| \sum_i W_i=\sum_j U_j \\
  };
  \node[font=\footnotesize\itshape, text=black!65, anchor=north west, align=left] at ([yshift=-4pt]m-4-1.south west)
    {$x_{ij}$: productos de la rama $i$ (fila) utilizados por la rama $j$ (columna). Diagonal: compras dentro de la misma rama.};
\end{tikzpicture}
