% Figura: esquema de una página del modelo de demanda (anexo de esquemas), como secuencia
% problema -> herramienta (hipótesis: qué suponen y qué pasa si fallan) -> solución (ecuación y rondas, multiplicadores,
% economía abierta, RASMUSSEN) -> usos y límites -> glosario.
% Coordenadas absolutas en cm, origen en la esquina superior izquierda. Generar con: bash Code/generar_figura.sh TIO_demanda_esquema
\begin{tikzpicture}[>=stealth,
  caja/.style={draw=black!70, rounded corners=3pt, line width=0.6pt, align=left, font=\footnotesize, inner sep=4pt},
  panel/.style={caja, anchor=north west},
  sec/.style={font=\small\bfseries, anchor=north west},
  tit/.style={font=\footnotesize, anchor=north west, align=left},
  mc/.style={draw=black!70, minimum width=0.8cm, minimum height=0.55cm, font=\footnotesize, inner sep=1pt, anchor=center}]

  % ================= EL PROBLEMA =================
  \node[sec, text=red!50!black] at (0,0) {El problema};
  \node[caja, fill=red!6, text width=15.15cm, anchor=north west] (P) at (0,-0.45)
    {\textbf{¿Cuánto tiene que producir cada rama, y con cuánto empleo, renta e importaciones, para atender una demanda final dada?} Es la pregunta de LEONTIEF ante la desmovilización: la demanda final se fija fuera (\textbf{modelo abierto}) y la producción se ajusta a ella.};

  % ================= LA HERRAMIENTA: LAS HIPÓTESIS =================
  \node[sec, text=blue!50!black] at (0,-1.65) {La herramienta: una hipótesis convierte la tabla en modelo};
  \node[caja, fill=blue!4, text width=15.15cm, anchor=north west] (H) at (0,-2.1)
    {\textbf{Coeficientes fijos:} lo que la tabla describía de un año pasa a ser una regla de comportamiento, $x_{ij}=a_{ij}X_j$, para cualquier nivel de producción. Detrás hay seis supuestos:\\[3pt]
     \renewcommand{\arraystretch}{1.12}%
     \begin{tabular}{@{}>{\raggedright\arraybackslash}p{3.0cm}@{\quad}>{\raggedright\arraybackslash}p{4.9cm}@{\quad}>{\raggedright\arraybackslash}p{6.4cm}@{}}
       \textbf{Hipótesis} & \textbf{Qué supone} & \textbf{Si falla} \\ \hline
       Homogeneidad & una rama, un producto, una técnica & coeficientes que mezclan técnicas \\
       Proporcionalidad & sin economías de escala & $a_{ij}(X_j)$: el sistema deja de ser lineal \\
       Aditividad & sin externalidades: los efectos se suman & importan la combinación y el orden de los proyectos \\
       Sin restricción de recursos & la oferta atiende cualquier demanda & la demanda acaba en precios e importaciones: un \textbf{techo} \\
       Coeficientes fijos & función de LEONTIEF: sin sustitución & $a_{ij}(p)$: equilibrio general aplicado \\
       Demanda final exógena & no depende de la renta que genera & faltan los efectos inducidos: modelo cerrado \\
     \end{tabular}};

  % ================= LA SOLUCIÓN: CADENA DE PASOS =================
  % Cada paso: [qué se hace y su fórmula] [qué significa] [ilustración]; entre pasos, la maniobra que lleva al siguiente.
  \tikzset{paso/.style={draw=black!70, rounded corners=3pt, line width=0.6pt, fill=blue!3, minimum width=15.43cm, minimum height=1.45cm, anchor=north west, inner sep=0pt},
           num/.style={circle, fill=black!80, text=white, font=\footnotesize\bfseries, inner sep=1.2pt, minimum size=0.45cm},
           enlace/.style={->, line width=1pt, blue!50!black},
           maniobra/.style={font=\footnotesize\itshape, text=blue!50!black, anchor=west}}
  \node[sec, text=blue!50!black] (hS) at ([yshift=-0.3cm]H.south west) {La solución, paso a paso: de la identidad contable al multiplicador};

  % Paso 1: del dato a la regla
  \node[paso] (k1) at ([yshift=-0.15cm]hS.south west) {};
  \node[num] at (k1.north west) {1};
  \begin{scope}[shift={(k1.north west)}]
    \node[tit, text width=4.1cm] at (0.25,-0.1) {\textbf{Del dato a la regla}\\[1pt] $X_i=\sum_j x_{ij}+D_i$, con $x_{ij}=a_{ij}X_j$\\[1pt] $\Rightarrow\;X=AX+D$};
    \node[tit, text width=6.4cm] at (4.6,-0.1) {La \textbf{fila} (producción $=$ usos) es una identidad contable; con coeficientes fijos pasa a ser un sistema de ecuaciones, con la demanda final como dato.};
    \matrix [matrix of math nodes, nodes={mc, minimum width=1.15cm}, column sep=-0.4pt, anchor=north west] at (11.35,-0.25)
      { |[fill=blue!15]| a_{i1}X_1 & |[fill=blue!15]| a_{i2}X_2 & |[fill=green!15]| D_i \\ };
    \node[font=\footnotesize, anchor=north west] at (11.35,-0.85) {fila $i$: suma $X_i$};
  \end{scope}

  % Paso 2: resolver
  \node[paso] (k2) at ([yshift=-0.42cm]k1.south west) {};
  \node[num] at (k2.north west) {2};
  \draw[enlace] ([xshift=2.2cm]k1.south west) -- ([xshift=2.2cm]k2.north west) node[midway, maniobra, xshift=2pt] {se despeja $X$};
  \begin{scope}[shift={(k2.north west)}]
    \node[tit, text width=4.1cm] at (0.25,-0.1) {\textbf{Resolver: la inversa}\\[1pt] $X=(I-A)^{-1}D=L\,D$\\[1pt] $L=I+A+A^2+\dots$};
    \node[tit, text width=6.4cm] at (4.6,-0.1) {$L$ suma las \textbf{rondas} de compras: la primera, $AD$, es el efecto directo; las demás, los indirectos. Converge si $\sum_i a_{ij}<1$ (HAWKINS y SIMON). Simular: $\Delta X=L\,\Delta D$.};
    \foreach \x/\h/\l in {11.6/0.75/D, 12.2/0.45/AD, 12.8/0.27/A^2D} {
      \fill[blue!30] (\x-0.2,-1.15) rectangle ++(0.4,\h);
      \node[font=\footnotesize, anchor=north] at (\x,-1.15) {$\l$};
    }
    \node[font=\footnotesize] at (13.35,-1.05) {$\dots$};
    \node[font=\footnotesize] at (13.85,-0.8) {$\Rightarrow$};
    \fill[blue!30] (14.25,-1.15) rectangle ++(0.45,0.75); \fill[blue!20] (14.25,-0.4) rectangle ++(0.45,0.25);
    \draw[black!60] (14.25,-1.15) rectangle (14.7,-0.12);
    \node[font=\footnotesize, anchor=north] at (14.48,-1.15) {$X$};
  \end{scope}

  % Paso 3: multiplicadores
  \node[paso] (k3) at ([yshift=-0.42cm]k2.south west) {};
  \node[num] at (k3.north west) {3};
  \draw[enlace] ([xshift=2.2cm]k2.south west) -- ([xshift=2.2cm]k3.north west) node[midway, maniobra, xshift=2pt] {se lee $L$ por columnas};
  \begin{scope}[shift={(k3.north west)}]
    \node[tit, text width=4.1cm] at (0.25,-0.1) {\textbf{Medir el arrastre}\\[1pt] multiplicador de $j$: $\sum_i l_{ij}$\\[1pt] de renta y empleo: $v'L$, $e'L$};
    \node[tit, text width=6.4cm] at (4.6,-0.1) {Cada \textbf{columna} de $L$: lo que exige a todas las ramas una unidad de demanda de $j$. Sin importaciones, $v'L=1'$: el modelo dice \textbf{dónde} se genera la renta.};
    \matrix (m3) [matrix of math nodes, nodes={mc}, column sep=-0.4pt, row sep=-0.4pt, anchor=north west] at (11.6,-0.12)
      { |[fill=blue!22]| l_{11} & l_{12} \\ |[fill=blue!22]| l_{21} & l_{22} \\ };
    \node[font=\footnotesize, text=blue!55!black, anchor=west, align=left] at ([xshift=2pt]m3-2-2.east) {$\Sigma$ columna:\\ multiplicador};
  \end{scope}

  % Paso 4: RASMUSSEN
  \node[paso] (k4) at ([yshift=-0.42cm]k3.south west) {};
  \node[num] at (k4.north west) {4};
  \draw[enlace] ([xshift=2.2cm]k3.south west) -- ([xshift=2.2cm]k4.north west) node[midway, maniobra, xshift=2pt] {se comparan columnas y filas con la media};
  \begin{scope}[shift={(k4.north west)}]
    \node[tit, text width=4.1cm] at (0.25,-0.1) {\textbf{Clasificar: RASMUSSEN (1956)}\\[1pt] columna: poder de dispersión\\[1pt] fila: sensibilidad de dispersión};
    \node[tit, text width=6.4cm] at (4.6,-0.1) {\textbf{Eslabonamientos totales}: los de CHENERY y WATANABE con todas las rondas, frente a la media ($1$). El coeficiente de variación mide si el arrastre se concentra.};
    \draw[black!60] (11.35,-0.15) rectangle (15.25,-1.3);
    \draw[black!60] (13.3,-0.15) -- (13.3,-1.3); \draw[black!60] (11.35,-0.725) -- (15.25,-0.725);
    \fill[green!20] (13.32,-0.17) rectangle (15.23,-0.705);
    \node[font=\footnotesize] at (12.32,-0.44) {Base};
    \node[font=\footnotesize] at (14.27,-0.44) {\textbf{Clave}};
    \node[font=\footnotesize] at (12.32,-1.01) {Independientes};
    \node[font=\footnotesize] at (14.27,-1.01) {Motores};
  \end{scope}

  % Paso 5: economía abierta
  \node[paso, fill=yellow!6] (k5) at ([yshift=-0.42cm]k4.south west) {};
  \node[num] at (k5.north west) {5};
  \draw[enlace] ([xshift=2.2cm]k4.south west) -- ([xshift=2.2cm]k5.north west) node[midway, maniobra, xshift=2pt] {se abre la economía: $A\to A^d$, $D\to D^d$};
  \begin{scope}[shift={(k5.north west)}]
    \node[tit, text width=4.1cm] at (0.25,-0.1) {\textbf{Abrir: la fuga}\\[1pt] $X=(I-A^d)^{-1}D^d=L^dD^d$\\[1pt] $v'L^d+m'L^d=1'$};
    \node[tit, text width=6.4cm] at (4.6,-0.1) {Los inputs importados no arrastran producción nacional: cada unidad de demanda acaba en \textbf{renta nacional o importaciones}; multiplicadores interiores menores.};
    \node[font=\footnotesize, anchor=east] at (12.3,-0.42) {cerrada};
    \node[font=\footnotesize, anchor=east] at (12.3,-0.98) {abierta};
    \fill[blue!30] (12.4,-0.6) rectangle (15.2,-0.24);
    \node[font=\footnotesize] at (13.8,-0.42) {renta $=1$};
    \fill[blue!30] (12.4,-1.16) rectangle (14.2,-0.8);
    \fill[yellow!55] (14.2,-1.16) rectangle (15.2,-0.8);
    \node[font=\footnotesize] at (13.3,-0.98) {renta};
    \node[font=\footnotesize] at (14.7,-0.98) {import.};
  \end{scope}

  % ================= USOS Y LÍMITES =================
  \node[sec, text=black!75] (hU) at ([yshift=-0.3cm]k5.south west) {Para qué sirve y dónde falla};
  \node[panel, fill=green!5, text width=7.1cm, minimum height=3.55cm] (U) at ([yshift=-0.12cm]hU.south west)
    {\textbf{Usos} ($\Delta X=L\,\Delta D$)\\[2pt]
     \textbf{Impacto} de proyectos, turismo o fondos europeos: efectos \textit{brutos}, no netos.\\
     \textbf{Previsión y planificación}: cuellos de botella.\\
     \textbf{Política industrial}: sectores clave (identificar no es justificar la intervención).\\
     \textbf{Sector exterior}: contenido importado, cadenas de valor.\\
     \textbf{Ambiente y empleo}: huellas, multiplicadores de empleo.};
  \node[panel, fill=orange!6, text width=7.1cm, minimum height=3.55cm] (Li) at ([xshift=0.65cm]U.north east)
    {\textbf{Límites} ($\to$ alternativa)\\[2pt]
     Coeficientes fijos y envejecidos ($\to$ equilibrio general aplicado, RAS).\\
     Sin restricciones de oferta: un techo ($\to$ modelos mixtos).\\
     Lineal: solo cambios pequeños.\\
     Estático ($\to$ modelo dinámico de LEONTIEF).\\
     Demanda exógena ($\to$ modelo cerrado, matriz de contabilidad social).\\
     Ignora los precios ($\to$ modelo de precios).};

  % ================= GLOSARIO =================
  \node[caja, fill=black!3, anchor=north west, inner sep=5pt, text width=15.15cm] at ([yshift=-0.35cm]U.south west)
    {\textbf{Glosario de notación.} {\itshape Vectores de columna, salvo los marcados con $'$ (fila); $1'$: vector fila de unos.}\\[2pt]
     \renewcommand{\arraystretch}{1.05}%
     \begin{tabular}{@{}>{$}l<{$}@{\;\;}>{\raggedright\arraybackslash}p{3.6cm}@{\quad}>{$}l<{$}@{\;\;}>{\raggedright\arraybackslash}p{3.6cm}@{\quad}>{$}l<{$}@{\;\;}>{\raggedright\arraybackslash}p{3.6cm}@{}}
       A,\,a_{ij} & coeficientes técnicos & X,\,D & producción, demanda final & v_i,\,e_i & VAB y empleo por unidad \\
       L,\,l_{ij} & inversa de LEONTIEF & A^d,\,L^d,\,D^d & versiones interiores & m' & contenido importado directo \\
       I & matriz identidad & \Delta X,\,\Delta D & variaciones & U_{\cdot j},\,U_{i\cdot} & índices de RASMUSSEN \\
     \end{tabular}};
\end{tikzpicture}
