% Figura: esquema de una página del modelo de demanda (anexo de esquemas), como secuencia
% problema -> herramienta (hipótesis: qué suponen y qué pasa si fallan) -> solución (ecuación y rondas, multiplicadores,
% economía abierta, RASMUSSEN) -> usos y límites -> glosario.
% Coordenadas absolutas en cm, origen en la esquina superior izquierda. Generar con: bash Code/generar_figura.sh TIO_demanda_esquema
\begin{tikzpicture}[>=stealth,
  caja/.style={draw=black!70, rounded corners=3pt, line width=0.6pt, align=left, font=\footnotesize, inner sep=4pt},
  panel/.style={caja, anchor=north west},
  sec/.style={font=\small\bfseries, anchor=north west},
  tit/.style={font=\footnotesize, anchor=north west, align=left},
  mc/.style={draw=black!70, minimum width=0.8cm, minimum height=0.55cm, font=\footnotesize, inner sep=1pt, anchor=center}]

  % ================= EL PROBLEMA =================
  \node[sec, text=red!50!black] at (0,0) {El problema};
  \node[caja, fill=red!6, text width=15.15cm, anchor=north west] (P) at (0,-0.45)
    {\textbf{¿Cuánto tiene que producir cada rama, y con cuánto empleo, renta e importaciones, para atender una demanda final dada?} Es la pregunta de LEONTIEF ante la desmovilización: la demanda final se fija fuera (\textbf{modelo abierto}) y la producción se ajusta a ella.};

  % ================= LA HERRAMIENTA: LAS HIPÓTESIS =================
  \node[sec, text=blue!50!black] at (0,-1.65) {La herramienta: una hipótesis convierte la tabla en modelo};
  \node[caja, fill=blue!4, text width=15.15cm, anchor=north west] (H) at (0,-2.1)
    {\textbf{Coeficientes fijos:} lo que la tabla describía de un año pasa a ser una regla de comportamiento, $x_{ij}=a_{ij}X_j$, para cualquier nivel de producción. Detrás hay seis supuestos:\\[3pt]
     \renewcommand{\arraystretch}{1.12}%
     \begin{tabular}{@{}>{\raggedright\arraybackslash}p{3.0cm}@{\quad}>{\raggedright\arraybackslash}p{4.9cm}@{\quad}>{\raggedright\arraybackslash}p{6.4cm}@{}}
       \textbf{Hipótesis} & \textbf{Qué supone} & \textbf{Si falla} \\ \hline
       Homogeneidad & una rama, un producto, una técnica & coeficientes que mezclan técnicas y cambian con la composición \\
       Proporcionalidad & sin economías de escala & $a_{ij}(X_j)$: el sistema deja de ser lineal \\
       Aditividad & sin externalidades: los efectos se suman & importan la combinación y el orden de los proyectos \\
       Sin restricción de recursos & la oferta atiende cualquier demanda & la demanda acaba en precios e importaciones: un \textbf{techo} \\
       Coeficientes fijos & función de LEONTIEF: sin sustitución & $a_{ij}(p)$: equilibrio general aplicado \\
       Demanda final exógena & no depende de la renta que genera & faltan los efectos inducidos: modelo cerrado \\
     \end{tabular}};

  % ================= LA SOLUCIÓN =================
  \node[sec, text=blue!50!black] (hS) at ([yshift=-0.3cm]H.south west) {La solución: la inversa de LEONTIEF};
  \node[panel, fill=blue!3, minimum width=7.55cm, minimum height=3.3cm] (S1) at ([yshift=-0.12cm]hS.south west) {};
  \node[panel, fill=blue!3, minimum width=7.55cm, minimum height=3.3cm] (S2) at ([xshift=0.6cm]S1.north east) {};
  \node[panel, fill=yellow!6, minimum width=7.55cm, minimum height=3.45cm] (S3) at ([yshift=-0.25cm]S1.south west) {};
  \node[panel, fill=green!4, minimum width=7.55cm, minimum height=3.45cm] (S4) at ([xshift=0.6cm]S3.north east) {};

  % Ecuación y rondas
  \begin{scope}[shift={(S1.north west)}]
    \node[tit] at (0.12,-0.1) {\textbf{La ecuación: la fila de la tabla}};
    \node[tit, text width=3.6cm] at (0.12,-0.55)
      {$X=AX+D$\\[2pt] $\Rightarrow X=(I-A)^{-1}D=L\,D$\\[4pt]
       Intuición: las \textbf{rondas} de compras. Cada una es menor que la anterior porque $\sum_i a_{ij}<1$ (HAWKINS y SIMON).};
    \foreach \x/\h/\l in {4.05/1.0/D, 4.65/0.6/AD, 5.25/0.36/A^2D, 5.85/0.22/A^3D} {
      \fill[blue!30] (\x-0.2,-2.85) rectangle ++(0.4,\h);
      \node[font=\footnotesize, anchor=north] at (\x,-2.88) {$\l$};
    }
    \node[font=\footnotesize] at (6.35,-2.75) {$\dots$};
    \fill[blue!30] (6.75,-2.85) rectangle ++(0.45,1.0);
    \fill[blue!22] (6.75,-1.85) rectangle ++(0.45,0.6);
    \fill[blue!30] (6.75,-1.25) rectangle ++(0.45,0.36);
    \fill[blue!22] (6.75,-0.89) rectangle ++(0.45,0.22);
    \draw[black!60] (6.75,-2.85) rectangle (7.2,-0.6);
    \node[font=\footnotesize, anchor=north] at (6.98,-2.88) {$X$};
  \end{scope}

  % Multiplicadores
  \begin{scope}[shift={(S2.north west)}]
    \node[tit] at (0.12,-0.1) {\textbf{Los multiplicadores: las columnas de $L$}};
    \matrix (ml) [matrix of math nodes, nodes={mc}, column sep=-0.4pt, row sep=-0.4pt, anchor=north west] at (0.25,-0.75)
      { |[fill=blue!22]| l_{11} & l_{12} \\ |[fill=blue!22]| l_{21} & l_{22} \\ };
    \node[font=\footnotesize, text=blue!55!black, anchor=north, align=center] at ([yshift=-1pt]ml-2-1.south) {$\Sigma$: multipl.\\ de $S_1$};
    \node[tit, text width=5.0cm] at (2.3,-0.55)
      {$l_{ij}$: producción de $i$ (directa e indirecta) por unidad de demanda final de $j$.\\[2pt]
       Columna: \textbf{multiplicador de producción}; ponderada por $v_i$ o $e_i$, de \textbf{renta} o de \textbf{empleo}.\\[2pt]
       Sin importaciones, $v'L=1'$: el modelo dice \textbf{dónde} se genera la renta.};
  \end{scope}

  % Economía abierta
  \begin{scope}[shift={(S3.north west)}]
    \node[tit] at (0.12,-0.1) {\textbf{Economía abierta: la fuga}};
    \node[tit, text width=7.2cm] at (0.12,-0.5)
      {Se invierte la matriz interior y se usa la demanda dirigida a la producción interior: $X=(I-A^d)^{-1}D^d=L^dD^d$.};
    \node[font=\footnotesize, anchor=east] at (1.35,-1.65) {Cerrada};
    \node[font=\footnotesize, anchor=east] at (1.35,-2.3) {Abierta};
    \fill[blue!30] (1.5,-1.85) rectangle (6.3,-1.45);
    \node[font=\footnotesize] at (3.9,-1.65) {renta: $v'L=1$};
    \fill[blue!30] (1.5,-2.5) rectangle (4.6,-2.1);
    \fill[yellow!55] (4.6,-2.5) rectangle (6.3,-2.1);
    \node[font=\footnotesize] at (3.05,-2.3) {renta: $v'L^d$};
    \node[font=\footnotesize] at (5.45,-2.3) {import.: $m'L^d$};
    \node[tit, text width=7.2cm] at (0.12,-2.6)
      {Renta nacional o importaciones: multiplicadores interiores menores.};
  \end{scope}

  % RASMUSSEN
  \begin{scope}[shift={(S4.north west)}]
    \node[tit] at (0.12,-0.1) {\textbf{RASMUSSEN (1956): eslabonamientos totales}};
    \node[tit, text width=3.25cm] at (0.12,-0.55)
      {Poder de dispersión, $U_{\cdot j}$: columna de $L$ (arrastre).\\[2pt] Sensibilidad, $U_{i\cdot}$: fila de $L$.\\[2pt] Ambos frente a $1$, con su coeficiente de variación.};
    \draw[->, line width=0.7pt] (4.1,-2.7) -- (7.35,-2.7) node[anchor=north east, font=\footnotesize] {$U_{\cdot j}$};
    \draw[->, line width=0.7pt] (4.1,-2.7) -- (4.1,-0.5) node[anchor=north west, font=\footnotesize] {$U_{i\cdot}$};
    \draw[dashed, black!60] (5.7,-0.55) -- (5.7,-2.7) node[anchor=north, font=\footnotesize] {$1$};
    \draw[dashed, black!60] (4.1,-1.62) -- (7.3,-1.62) node[anchor=west, font=\footnotesize] {};
    \node[font=\footnotesize, anchor=east] at (4.1,-1.62) {$1$};
    \fill[green!20] (5.72,-0.55) rectangle (7.3,-1.6);
    \node[font=\footnotesize, align=center] at (6.5,-1.08) {\textbf{Clave}};
    \node[font=\footnotesize, align=center] at (6.5,-2.16) {Motores};
    \node[font=\footnotesize, align=center] at (4.9,-1.08) {Base};
    \node[font=\footnotesize, align=center] at (4.9,-2.16) {Indepen-\\ dientes};
  \end{scope}

  % ================= USOS Y LÍMITES =================
  \node[sec, text=black!75] (hU) at ([yshift=-0.3cm]S3.south west) {Para qué sirve y dónde falla};
  \node[panel, fill=green!5, text width=7.25cm, minimum height=3.55cm] (U) at ([yshift=-0.12cm]hU.south west)
    {\textbf{Usos} ($\Delta X=L\,\Delta D$)\\[2pt]
     \textbf{Impacto} de proyectos, turismo o fondos europeos: efectos \textit{brutos}, no netos.\\
     \textbf{Previsión y planificación}: cuellos de botella.\\
     \textbf{Política industrial}: sectores clave (identificar no es justificar la intervención).\\
     \textbf{Sector exterior}: contenido importado, cadenas de valor.\\
     \textbf{Ambiente y empleo}: huellas, multiplicadores de empleo.};
  \node[panel, fill=orange!6, text width=7.25cm, minimum height=3.55cm] (Li) at ([xshift=0.6cm]U.north east)
    {\textbf{Límites} ($\to$ alternativa)\\[2pt]
     Coeficientes fijos y envejecidos ($\to$ equilibrio general aplicado, RAS).\\
     Sin restricciones de oferta: un techo ($\to$ modelos mixtos).\\
     Lineal: solo cambios pequeños.\\
     Estático ($\to$ modelo dinámico de LEONTIEF).\\
     Demanda exógena ($\to$ modelo cerrado, matriz de contabilidad social).\\
     Ignora los precios ($\to$ modelo de precios).};

  % ================= GLOSARIO =================
  \node[caja, fill=black!3, anchor=north west, inner sep=5pt, text width=15.15cm] at ([yshift=-0.35cm]U.south west)
    {\textbf{Glosario de notación.} {\itshape Vectores de columna, salvo los marcados con $'$ (fila); $1'$: vector fila de unos.}\\[2pt]
     \renewcommand{\arraystretch}{1.05}%
     \begin{tabular}{@{}>{$}l<{$}@{\;\;}>{\raggedright\arraybackslash}p{3.6cm}@{\quad}>{$}l<{$}@{\;\;}>{\raggedright\arraybackslash}p{3.6cm}@{\quad}>{$}l<{$}@{\;\;}>{\raggedright\arraybackslash}p{3.6cm}@{}}
       A,\,a_{ij} & coeficientes técnicos & X,\,D & producción, demanda final & v_i,\,e_i & VAB y empleo por unidad \\
       L,\,l_{ij} & inversa de LEONTIEF & A^d,\,L^d,\,D^d & versiones interiores & m' & contenido importado directo \\
       I & matriz identidad & \Delta X,\,\Delta D & variaciones & U_{\cdot j},\,U_{i\cdot} & índices de RASMUSSEN \\
     \end{tabular}};
\end{tikzpicture}
