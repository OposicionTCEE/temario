% Figura: bloques I y II de la economía de dos ramas (sin importaciones), en notación general.
% Fuente de TIO_bloquesI_II.pdf. Generar con: bash Code/generar_figura.sh TIO_bloquesI_II
\begin{tikzpicture}[
  celda/.style={draw=black!75, line width=0.5pt, minimum height=0.8cm, minimum width=1.35cm, font=\small, inner sep=2pt, text height=1.6ex, text depth=0.5ex, anchor=center},
  I/.style={fill=blue!12}, II/.style={fill=green!12}, T/.style={fill=black!8}]
  \matrix (m) [matrix of math nodes, nodes={celda}, column sep=-0.5pt, row sep=-0.5pt,
               column 1/.style={nodes={minimum width=1.6cm}}, column 4/.style={nodes={minimum width=1.6cm}},
               column 10/.style={nodes={minimum width=1.6cm}}]
  {
    \text{\textbf{Ramas}} & \mathbf{S_1} & \mathbf{S_2} & |[T]| \mathbf{W_i} & \mathbf{C} & \mathbf{CC} & \mathbf{FBK} & \mathbf{E} & |[T]| \mathbf{D_i} & |[T]| \mathbf{TE_i} \\
    \mathbf{S_1} & |[I]| x_{11} & |[I]| x_{12} & |[T]| W_1 & |[II]| C_1 & |[II]| CC_1 & |[II]| FBK_1 & |[II]| E_1 & |[T]| D_1 & |[T]| TE_1 \\
    \mathbf{S_2} & |[I]| x_{21} & |[I]| x_{22} & |[T]| W_2 & |[II]| C_2 & |[II]| CC_2 & |[II]| FBK_2 & |[II]| E_2 & |[T]| D_2 & |[T]| TE_2 \\
    |[T]| \mathbf{U_j} & |[T]| U_1 & |[T]| U_2 & |[T]| \sum x_{ij} & |[T]| \sum C_i & |[T]| \sum CC_i & |[T]| \sum FBK_i & |[T]| \sum E_i & |[T]| \sum D_i & |[T]| \sum TE_i \\
  };
  \draw[decorate, decoration={brace, amplitude=5pt}, thick] ([yshift=2pt]m-1-2.north west) -- ([yshift=2pt]m-1-3.north east)
    node[midway, above=5pt, font=\footnotesize\bfseries] {I. Consumos intermedios};
  \draw[decorate, decoration={brace, amplitude=5pt}, thick] ([yshift=2pt]m-1-5.north west) -- ([yshift=2pt]m-1-8.north east)
    node[midway, above=5pt, font=\footnotesize\bfseries] {II. Demanda final};
  \node[font=\footnotesize\itshape, text=black!65, anchor=north west, align=left] at ([yshift=-4pt]m-4-1.south west)
    {$D_i=C_i+CC_i+FBK_i+E_i$\qquad $TE_i=W_i+D_i$};
\end{tikzpicture}
