% Figura: TIO simétrica de flujos totales de la economía de dos ramas, con importaciones, en notación general.
% Fuente de TIO_abierta.pdf. Añade a TIO_cerrada las filas M_j y TR_j.
% La versión con valores del ejemplo numérico es TIO_abierta_num.tikz. Generar con: bash Code/generar_figura.sh TIO_abierta
\begin{tikzpicture}[
  celda/.style={draw=black!75, line width=0.5pt, minimum height=0.75cm, minimum width=1.35cm, font=\small, inner sep=2pt, text height=1.6ex, text depth=0.5ex, anchor=center},
  I/.style={fill=blue!12}, II/.style={fill=green!12}, III/.style={fill=red!10}, T/.style={fill=black!8},
  M/.style={fill=yellow!35}]
  \matrix (m) [matrix of math nodes, nodes={celda}, column sep=-0.5pt, row sep=-0.5pt,
               column 1/.style={nodes={minimum width=1.6cm}}, column 4/.style={nodes={minimum width=1.75cm}},
               column 10/.style={nodes={minimum width=1.75cm}}]
  {
    \text{\textbf{Ramas}} & \mathbf{S_1} & \mathbf{S_2} & |[T]| \mathbf{W_i} & \mathbf{C} & \mathbf{CC} & \mathbf{FBK} & \mathbf{E} & |[T]| \mathbf{D_i} & |[T]| \mathbf{TE_i} \\
    \mathbf{S_1} & |[I]| x_{11} & |[I]| x_{12} & |[T]| W_1 & |[II]| C_1 & |[II]| CC_1 & |[II]| FBK_1 & |[II]| E_1 & |[T]| D_1 & |[T]| TE_1 \\
    \mathbf{S_2} & |[I]| x_{21} & |[I]| x_{22} & |[T]| W_2 & |[II]| C_2 & |[II]| CC_2 & |[II]| FBK_2 & |[II]| E_2 & |[T]| D_2 & |[T]| TE_2 \\
    |[T]| \mathbf{U_j} & |[T]| U_1 & |[T]| U_2 & |[T]| \sum x_{ij} & |[T]| \sum C_i & |[T]| \sum CC_i & |[T]| \sum FBK_i & |[T]| \sum E_i & |[T]| \sum D_i & |[T]| \sum TE_i \\
    \mathbf{RA_j} & |[III]| RA_1 & |[III]| RA_2 & |[T]| \sum RA_j \\
    \mathbf{EBE_j} & |[III]| EBE_1 & |[III]| EBE_2 & |[T]| \sum EBE_j \\
    |[T]| \mathbf{VAB_j} & |[T]| VAB_1 & |[T]| VAB_2 & |[T]| \sum VAB_j \\
    |[T]| \mathbf{X_j} & |[T]| X_1 & |[T]| X_2 & |[T]| \sum X_j \\
    |[M]| \mathbf{M_j} & |[M]| M_1 & |[M]| M_2 & |[M]| \sum M_j \\
    |[M]| \mathbf{TR_j} & |[M]| TR_1 & |[M]| TR_2 & |[M]| \sum TR_j \\
  };
  \draw[decorate, decoration={brace, amplitude=5pt}, thick] ([yshift=2pt]m-1-2.north west) -- ([yshift=2pt]m-1-3.north east)
    node[midway, above=5pt, font=\footnotesize\bfseries] {I. Consumos intermedios};
  \draw[decorate, decoration={brace, amplitude=5pt}, thick] ([yshift=2pt]m-1-5.north west) -- ([yshift=2pt]m-1-8.north east)
    node[midway, above=5pt, font=\footnotesize\bfseries] {II. Demanda final};
  % Corchetes abiertos hacia la matriz (la punta señala la etiqueta).
  \draw[decorate, decoration={brace, amplitude=5pt}, thick] ([xshift=6pt]m-5-4.north east) -- ([xshift=6pt]m-6-4.south east)
    node[midway, right=7pt, font=\footnotesize\bfseries, align=left] {III. Inputs\\ primarios};
  \draw[decorate, decoration={brace, amplitude=5pt}, thick] ([xshift=6pt]m-9-4.north east) -- ([xshift=6pt]m-10-4.south east)
    node[midway, right=7pt, font=\footnotesize, align=left] {\textbf{Oferta del producto} $j$:\\ $TR_j=X_j+M_j=TE_j$};
  \node[font=\footnotesize\itshape, text=black!65, align=left, anchor=north west] at ([xshift=0.6cm, yshift=-0.1cm]m-7-4.north east)
    {Filas: $TE_i=W_i+D_i=X_i+M_i=TR_i$\\ Columnas: $X_j=U_j+VAB_j$ ($U_j$: inputs interiores e importados)\\ Comprobación: $\sum_i D_i-\sum_i M_i=\sum_j VAB_j$};
\end{tikzpicture}
