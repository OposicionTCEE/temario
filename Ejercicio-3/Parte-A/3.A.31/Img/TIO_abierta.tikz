% Figura: TIO simétrica de flujos totales del ejemplo de dos ramas, con importaciones.
% Fuente de TIO_abierta.pdf. Mismas producciones y VAB que TIO_cerrada; cambian E y se añaden M y TR.
\begin{tikzpicture}[
  celda/.style={draw=black!75, line width=0.5pt, minimum height=0.75cm, minimum width=1.1cm, font=\small, inner sep=1pt, text height=1.6ex, text depth=0.5ex, anchor=center},
  I/.style={fill=blue!12}, II/.style={fill=green!12}, III/.style={fill=red!10}, T/.style={fill=black!8},
  M/.style={fill=yellow!35}, N/.style={line width=1.4pt}]
  \matrix (m) [matrix of math nodes, nodes={celda}, column sep=-0.5pt, row sep=-0.5pt,
               column 1/.style={nodes={minimum width=1.6cm}}]
  {
    \text{\textbf{Ramas}} & \mathbf{S_1} & \mathbf{S_2} & |[T]| \mathbf{W_i} & \mathbf{C} & \mathbf{CC} & \mathbf{FBK} & \mathbf{E} & |[T]| \mathbf{D_i} & |[T]| \mathbf{TE_i} \\
    \mathbf{S_1} & |[I]| 2 & |[I]| 1 & |[T]| 3 & |[II]| 0 & |[II]| 3 & |[II]| 0 & |[II,N]| 1 & |[T]| 4 & |[T]| 7 \\
    \mathbf{S_2} & |[I]| 3 & |[I]| 1 & |[T]| 4 & |[II]| 1 & |[II]| 0 & |[II]| 1 & |[II,N]| 3 & |[T]| 5 & |[T]| 9 \\
    |[T]| \mathbf{U_j} & |[T]| 5 & |[T]| 2 & |[T]| 7 & |[T]| 1 & |[T]| 3 & |[T]| 1 & |[T]| 4 & |[T]| 9 & |[T]| \mathbf{16} \\
    \mathbf{RA_j} & |[III]| 1 & |[III]| 2 & |[T]| 3 \\
    \mathbf{EBE_j} & |[III]| 0 & |[III]| 3 & |[T]| 3 \\
    |[T]| \mathbf{VAB_j} & |[T]| 1 & |[T]| 5 & |[T]| 6 \\
    |[T]| \mathbf{X_j} & |[T]| 6 & |[T]| 7 & |[T]| 13 \\
    |[M]| \mathbf{M_j} & |[M]| 1 & |[M]| 2 & |[M]| 3 \\
    |[M]| \mathbf{TR_j} & |[M]| 7 & |[M]| 9 & |[M]| \mathbf{16} \\
  };
  \draw[decorate, decoration={brace, amplitude=5pt}, thick] ([yshift=2pt]m-1-2.north west) -- ([yshift=2pt]m-1-3.north east)
    node[midway, above=5pt, font=\footnotesize\bfseries] {I. Consumos intermedios};
  \draw[decorate, decoration={brace, amplitude=5pt}, thick] ([yshift=2pt]m-1-5.north west) -- ([yshift=2pt]m-1-8.north east)
    node[midway, above=5pt, font=\footnotesize\bfseries] {II. Demanda final};
  \draw[decorate, decoration={brace, amplitude=5pt, mirror}, thick] ([xshift=6pt]m-5-4.north east) -- ([xshift=6pt]m-6-4.south east)
    node[midway, right=6pt, font=\footnotesize\bfseries, align=left] {III. Inputs\\ primarios};
  \draw[decorate, decoration={brace, amplitude=5pt, mirror}, thick] ([xshift=6pt]m-9-4.north east) -- ([xshift=6pt]m-10-4.south east)
    node[midway, right=6pt, font=\footnotesize, align=left] {\textbf{Oferta del producto} $j$:\\ $TR_j=X_j+M_j=TE_j$};
  \node[font=\footnotesize\itshape, text=black!65, align=left, anchor=north west] at ([xshift=0.6cm, yshift=-0.1cm]m-7-4.north east)
    {Cambian respecto a la tabla sin importaciones:\\ las exportaciones (recuadro grueso) y las filas $M_j$ y $TR_j$.\\[2pt]
     Comprobación: $\sum_i D_i-\sum_i M_i=9-3=6=\sum_j VAB_j$};
\end{tikzpicture}
