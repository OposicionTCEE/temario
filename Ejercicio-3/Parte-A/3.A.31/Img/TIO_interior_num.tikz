% Figura: TIO de flujos interiores del ejemplo de dos ramas (las importaciones intermedias, como una fila de costes).
% Fuente de TIO_interior_num.pdf (anexo del ejemplo numérico). Generar con: bash Code/generar_figura.sh TIO_interior_num
\begin{tikzpicture}[
  celda/.style={draw=black!75, line width=0.5pt, minimum height=0.75cm, minimum width=1.1cm, font=\small, inner sep=1pt, text height=1.6ex, text depth=0.5ex, anchor=center},
  I/.style={fill=blue!12}, II/.style={fill=green!12}, III/.style={fill=red!10}, T/.style={fill=black!8},
  M/.style={fill=yellow!35}]
  \matrix (m) [matrix of math nodes, nodes={celda}, column sep=-0.5pt, row sep=-0.5pt,
               column 1/.style={nodes={minimum width=1.6cm}}]
  {
    \text{\textbf{Ramas}} & \mathbf{S_1} & \mathbf{S_2} & |[T]| \mathbf{W^d_i} & \mathbf{C} & \mathbf{CC} & \mathbf{FBK} & \mathbf{E} & |[T]| \mathbf{D^d_i} & |[T]| \mathbf{X_i} \\
    \mathbf{S_1} & |[I]| 1 & |[I]| 1 & |[T]| 2 & |[II]| 0 & |[II]| 3 & |[II]| 0 & |[II]| 1 & |[T]| 4 & |[T]| 6 \\
    \mathbf{S_2} & |[I]| 3 & |[I]| 0 & |[T]| 3 & |[II]| 0 & |[II]| 0 & |[II]| 1 & |[II]| 3 & |[T]| 4 & |[T]| 7 \\
    |[T]| \mathbf{U^d_j} & |[T]| 4 & |[T]| 1 & |[T]| 5 & |[T]| 0 & |[T]| 3 & |[T]| 1 & |[T]| 4 & |[T]| 8 & |[T]| \mathbf{13} \\
    |[M]| \mathbf{U^m_j} & |[M]| 1 & |[M]| 1 & |[M]| 2 \\
    \mathbf{RA_j} & |[III]| 1 & |[III]| 2 & |[T]| 3 \\
    \mathbf{EBE_j} & |[III]| 0 & |[III]| 3 & |[T]| 3 \\
    |[T]| \mathbf{X_j} & |[T]| 6 & |[T]| 7 & |[T]| \mathbf{13} \\
  };
  \draw[decorate, decoration={brace, amplitude=5pt}, thick] ([yshift=2pt]m-1-2.north west) -- ([yshift=2pt]m-1-3.north east)
    node[midway, above=5pt, font=\footnotesize\bfseries] {I. Consumos intermedios interiores};
  \draw[decorate, decoration={brace, amplitude=5pt}, thick] ([yshift=2pt]m-1-5.north west) -- ([yshift=2pt]m-1-8.north east)
    node[midway, above=5pt, font=\footnotesize\bfseries] {II. Demanda final interior};
  \draw[decorate, decoration={brace, amplitude=5pt}, thick] ([xshift=6pt]m-5-4.north east) -- ([xshift=6pt]m-7-4.south east)
    node[midway, right=7pt, font=\footnotesize, align=left] {\textbf{Costes no interiores}:\\ inputs importados\\ y factores primarios};
  \node[font=\footnotesize\itshape, text=black!65, align=left, anchor=west] at ([xshift=0.6cm]m-8-4.east)
    {Fila $i$: $X_i=W^d_i+D^d_i$ \quad Columna $j$: $X_j=U^d_j+U^m_j+VAB_j$};
\end{tikzpicture}
