% Figura (Anexo III, «Primeras críticas: seguros y loterías»).
% (a) FRIEDMAN y SAVAGE (1948): utilidad de la riqueza cóncava-convexa-cóncava.
%     u(w) = 1,2 ln(1+w) + 0,9 / (1 + e^{-2,5 (w-3,2)}); puntos de inflexión aproximados en w = 2,1 y w = 4,1.
% (b) MARKOWITZ (1952b): utilidad de las variaciones de riqueza x respecto de la riqueza habitual (x = 0):
%     convexa (pérdidas grandes), cóncava (pérdidas pequeñas), convexa (ganancias pequeñas), cóncava (ganancias grandes).
%     u(x) = L(x+1,4) + L(x-1,4) - 1 + 0,05 x, con L(z) = 1 / (1 + e^{-2,2 z}); escala vertical 1,3.
% Rehace la figura img1_p27 del tema antiguo.
% Generar con: bash Code/generar_figura.sh anx_friedman_markowitz
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  % ---------------- (a) FRIEDMAN y SAVAGE ----------------
  \node[font=\footnotesize\bfseries] at (3.0,4.15) {(a) FRIEDMAN y SAVAGE (1948)};
  \draw[->] (0,0) -- (6.4,0) node[below] {$w$};
  \draw[->] (0,0) -- (0,3.7) node[above] {$u(w)$};
  \draw[very thick, domain=0:6.1, samples=80] plot (\x, {1.2*ln(1+\x) + 0.9/(1+exp(-2.5*(\x-3.2)))});
  \draw[dotted] (2.1,0) node[below] {$w_1$} -- (2.1,2.35);
  \draw[dotted] (4.1,0) node[below] {$w_2$} -- (4.1,2.8);
  \node[align=center] at (1.05,-0.75) {cóncava};
  \node[align=center] at (3.1,-0.75) {convexa};
  \node[align=center] at (5.15,-0.75) {cóncava};
  % ---------------- (b) MARKOWITZ ----------------
  \begin{scope}[xshift=10.3cm, yshift=1.6cm]
    \node[font=\footnotesize\bfseries] at (0,2.55) {(b) MARKOWITZ (1952b)};
    \draw[->] (-3.3,0) -- (3.4,0) node[below] {$x$};
    \draw[->] (0,-1.75) -- (0,2.0) node[above] {$u(x)$};
    \draw[very thick, domain=-3.1:3.1, samples=100] plot (\x, {1.3*(1/(1+exp(-2.2*(\x+1.4))) + 1/(1+exp(-2.2*(\x-1.4))) - 1 + 0.05*\x)});
    \draw[dotted] (-1.4,0) -- (-1.4,-0.68);
    \draw[dotted] (1.4,0) -- (1.4,0.68);
    \node[below left] at (0,0) {$0$};
    \node[align=center] at (-2.35,-2.25) {pérdidas\\grandes};
    \node[align=center] at (-0.7,-2.25) {pérdidas\\pequeñas};
    \node[align=center] at (0.7,-2.25) {ganancias\\pequeñas};
    \node[align=center] at (2.35,-2.25) {ganancias\\grandes};
  \end{scope}
\end{tikzpicture}
