% Figura (bloque 3, «Función de valor»): función de valor ilustrativa con las tres propiedades de la teoría de las perspectivas.
% Forma ilustrativa (no la estimada): v(x) = c (1 - e^{-kx}) si x >= 0; v(x) = -lambda c (1 - e^{kx}) si x < 0,
% con c = 2, k = 0,45, lambda = 2,25: cóncava en ganancias, convexa en pérdidas, pendiente en el origen k c = 0,9 a la derecha
% y lambda k c = 2,025 a la izquierda (el pliegue). Escala vertical 0,75. La misma base se usa en b3_contabilidad_mental,
% b3_orden_aversion y b3_dotacion_disposicion. La forma y los parámetros de TVERSKY y KAHNEMAN (1992) van en nota al pie.
% Generar con: bash Code/generar_figura.sh b3_funcion_valor
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1cm, y=0.75cm]
  \draw[->] (-4.5,0) -- (4.7,0) node[right] {$x$};
  \draw[->] (0,-4.3) -- (0,2.6) node[above] {$v(x)$};
  \draw[very thick, domain=0:4.2, samples=50] plot (\x, {2*(1-exp(-0.45*\x))});
  \draw[very thick, domain=-4.2:0, samples=50] plot (\x, {-2.25*2*(1-exp(0.45*\x))});
  \draw[gray, dashed, domain=-4.2:0, samples=50] plot (\x, {-2*(1-exp(0.45*\x))}) node[left, black] {$-v(-x)$};
  \node[anchor=south east] at (-0.1,0.05) {punto de referencia};
  \node at (2.6,-0.45) {ganancias};
  \node at (-2.6,0.45) {pérdidas};
  \node[anchor=west] at (3.0,1.55) {cóncava};
  \node[anchor=east] at (-3.1,-3.9) {convexa};
\end{tikzpicture}
