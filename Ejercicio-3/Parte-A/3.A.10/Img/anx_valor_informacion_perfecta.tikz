% Figura (Anexo I, «El valor privado de la información»): valor de la información perfecta en el problema del paraguas.
% Valores ilustrativos en unidades de dibujo: u_N2 = 3,0; u_N1 = 0,6; u_L2 = 1,6; u_L1 = 2,8 (cumplen u_L1 > u_N1 y u_N2 > u_L2).
% U_N(p) = 3,0 - 2,4 p ; U_L(p) = 1,6 + 1,2 p ; se cortan en p^ = 1,4/3,6 = 0,3889 (altura 2,0667).
% Con información perfecta: p u_L1 + (1-p) u_N2 = 3,0 - 0,2 p (2,9222 en p^).
% (a) la distancia vertical entre la recta discontinua y la envolvente es VIP(p);
% (b) VIP(p) = min{ p (u_L1 - u_N1), (1-p)(u_N2 - u_L2) } = min{ 2,2 p, 1,4 (1-p) }, máximo 0,8556 en p^.
% Generar con: bash Code/generar_figura.sh anx_valor_informacion_perfecta
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  \def\W{5.6}  % ancho de cada eje (p de 0 a 1)
  \def\H{3.6}  % alto del eje de (a)
  % ---------------- (a) Utilidad esperada ----------------
  \node[font=\footnotesize\bfseries, anchor=south] at (\W/2,\H+0.35) {(a) Utilidad esperada con y sin información};
  \fill[gray!20] (0,3.0) -- (2.178,2.0667) -- (\W,2.8) -- (\W,2.8) -- cycle;
  \draw[->] (0,0) -- (\W+0.35,0) node[below] {$p$};
  \draw[->] (0,0) -- (0,\H) node[above] {Utilidad esperada};
  \node[below] at (0,0) {$0$};
  \draw (\W,0.06) -- (\W,-0.06) node[below] {$1$};
  % Rectas de cada acto
  \draw[gray] (0,3.0) -- (\W,0.6) node[right, black] {$U_N(p)$};
  \draw[gray] (0,1.6) -- (\W,2.8);
  \node[right] at (\W,2.55) {$U_L(p)$};
  % Envolvente: decidir sin información
  \draw[very thick] (0,3.0) -- (2.178,2.0667) -- (\W,2.8);
  % Decidir con información perfecta
  \draw[thick, dashed] (0,3.0) -- (\W,2.8);
  \node[right] at (\W,3.0) {con información};
  \node[anchor=north, align=center] at (3.9,2.08) {sin información};
  % Umbral
  \draw[dotted] (2.178,2.0667) -- (2.178,0) node[below] {$\hat p$};
  \draw[<->] (2.178,2.0667) -- (2.178,2.9222);
  \node[anchor=west] at (2.25,2.5) {$VIP(\hat p)$};
  % Ejes de valores
  \node[left] at (0,3.0) {$u_{N2}$};
  \node[left] at (0,1.6) {$u_{L2}$};
  % ---------------- (b) Valor de la información perfecta ----------------
  \begin{scope}[xshift=8.2cm]
    \node[font=\footnotesize\bfseries, anchor=south] at (\W/2,\H+0.35) {(b) Valor de la información perfecta};
    \draw[->] (0,0) -- (\W+0.35,0) node[below] {$p$};
    \draw[->] (0,0) -- (0,\H) node[above] {$VIP(p)$};
    \node[below] at (0,0) {$0$};
    \draw (\W,0.06) -- (\W,-0.06) node[below] {$1$};
    % Escala vertical x2 para que se vea la forma
    \draw[gray, dashed] (0,0) -- (3.6,2.829) node[above, black] {$p\,(u_{L1}-u_{N1})$};
    \draw[gray, dashed] (0,2.8) -- (\W,0);
    \node[left] at (0,2.8) {$u_{N2}-u_{L2}$};
    \draw[very thick] (0,0) -- (2.178,1.711) -- (\W,0);
    \draw[dotted] (2.178,1.711) -- (2.178,0) node[below] {$\hat p$};
    \node[anchor=south west] at (3.3,1.45) {$(1-p)\,(u_{N2}-u_{L2})$};
  \end{scope}
\end{tikzpicture}
