% Figura (bloque 1, «Estados contingentes: ¿cuál es el coste del riesgo?»): prima de riesgo de un agente con riqueza w
% que puede perder L con probabilidad p. Misma base que anx_primas_seguro (bloque 2 y anexo II), sin las primas del seguro.
% Utilidad ilustrativa u(x) = 4 (1 - e^{-0,45 x}); w - L = 2; w = 7; p = 0,4.
% u(2) = 2,374; u(7) = 3,829; valor esperado w - pL = 5, u(5) = 3,578; E[u] = 3,247 (cuerda); EC = 3,710; pi = 1,29.
% Generar con: bash Code/generar_figura.sh b1_coste_riesgo
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1.05cm, y=1.05cm]
  \draw[->] (0,0) -- (8.4,0) node[below] {riqueza};
  \draw[->] (0,0) -- (0,4.4) node[above] {utilidad};
  \draw[very thick, domain=0.6:8.1, samples=60] plot (\x, {4*(1-exp(-0.45*\x))}) node[right] {$u$};
  % Cuerda: utilidad esperada de la situación arriesgada
  \draw (2,2.374) -- (7,3.829);
  \fill (2,2.374) circle (1.4pt); \fill (7,3.829) circle (1.4pt);
  \fill (5,3.247) circle (1.4pt);
  % Utilidad del valor esperado, sobre la curva
  \fill (5,3.578) circle (1.4pt);
  \draw[dashed] (0,3.578) node[left] {$u(w-pL)$} -- (5,3.578);
  % Equivalente cierto
  \fill (3.710,3.247) circle (1.4pt);
  \draw[dashed] (0,3.247) node[left] {$E[u]$} -- (3.710,3.247);
  \draw[->] (5,3.247) -- (3.78,3.247);
  \draw[dashed] (2,2.374) -- (2,0) node[below] {$w-L$};
  \draw[dashed] (7,3.829) -- (7,0) node[below] {$w$};
  \draw[dashed] (5,3.578) -- (5,0) node[below] {$w-pL$};
  \draw[dashed] (3.710,3.247) -- (3.710,0) node[below] {$EC$};
  \draw[decorate, decoration={brace, amplitude=3pt, mirror}] (3.71,-0.5) -- (5,-0.5) node[midway, below=3pt] {$\pi$};
  \node at (4.2,-1.45) {$E[u]=p\,u(w-L)+(1-p)\,u(w)$ \qquad $u(EC)=E[u]$ \qquad $\pi=(w-pL)-EC$};
\end{tikzpicture}
