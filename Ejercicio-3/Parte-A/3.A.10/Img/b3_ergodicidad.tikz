% Figura (bloque 3, «Incertidumbre radical»): por qué las frecuencias del pasado pueden no informar sobre el futuro.
% Serie simulada (semilla 7, 60 periodos): media 2 y desviación 0,32 hasta «hoy» (t = 40); la banda gris es media ± 2 desviaciones
% del pasado ([1,36; 2,64]) y se prolonga, discontinua, hacia el futuro.
% (a) Proceso estacionario: el futuro sigue la misma distribución (media 2, desviación 0,32).
% (b) Ruptura estructural: desde «hoy», media 1 y desviación 0,6; la banda del pasado deja de describir lo que ocurre.
% Coordenadas desplazadas 0,9 hacia arriba (scope shift) para que el eje horizontal quede bajo el mínimo (-0,51).
% Generar con: bash Code/generar_figura.sh b3_ergodicidad
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1.05cm, y=0.9cm]
  \foreach \i/\titulo in {0/{(a) Proceso estacionario}, 1/{(b) Ruptura estructural}} {
    \begin{scope}[xshift=\i*7.6cm]
      \node[font=\footnotesize\bfseries] at (3.1,4.55) {\titulo};
      \draw[->] (0,0) -- (6.4,0) node[below left] {tiempo};
      \draw[->] (0,0) -- (0,4.0);
      \begin{scope}[shift={(0,0.9)}]
        \fill[gray!14] (0,1.36) rectangle (3.9,2.64);
        \draw[dashed, gray] (3.9,1.36) rectangle (6.0,2.64);
        \draw[thick] plot coordinates {(0.00,1.92) (0.10,2.16) (0.20,1.93) (0.30,1.90) (0.40,1.70) (0.50,1.93) (0.60,2.36) (0.70,2.14) (0.80,2.33) (0.90,2.08) (1.00,2.13) (1.10,2.06) (1.20,1.47) (1.30,2.27) (1.40,2.16) (1.50,2.16) (1.60,1.46) (1.70,1.44) (1.80,1.72) (1.90,1.85) (2.00,2.10) (2.10,1.99) (2.20,2.17) (2.30,1.79) (2.40,2.10) (2.50,2.13) (2.60,1.79) (2.70,2.55) (2.80,2.18) (2.90,2.38) (3.00,1.80) (3.10,1.76) (3.20,1.89) (3.30,1.97) (3.40,2.20) (3.50,2.08) (3.60,1.86) (3.70,1.69) (3.80,1.83) (3.90,2.39)};
        \draw[dotted] (3.9,-0.9) -- (3.9,2.95);
        \node[above] at (3.9,2.95) {hoy};
        \node at (1.95,2.95) {pasado};
        \node at (5.0,2.95) {futuro};
      \end{scope}
    \end{scope}
  }
  % (a) El futuro sigue la misma distribución
  \begin{scope}[shift={(0,0.9)}]
    \draw[thick, gray] plot coordinates {(3.90,2.39) (4.00,1.74) (4.10,2.14) (4.20,2.02) (4.30,1.36) (4.40,1.97) (4.50,2.16) (4.60,1.53) (4.70,2.21) (4.80,2.46) (4.90,2.04) (5.00,2.20) (5.10,1.86) (5.20,1.69) (5.30,2.41) (5.40,1.53) (5.50,2.46) (5.60,1.39) (5.70,2.11) (5.80,1.64) (5.90,2.35)};
  \end{scope}
  % (b) Ruptura: nueva media y más dispersión
  \begin{scope}[xshift=7.6cm, shift={(0,0.9)}]
    \draw[thick, gray] plot coordinates {(3.90,2.39) (4.00,1.15) (4.10,0.11) (4.20,1.78) (4.30,0.81) (4.40,0.51) (4.50,0.96) (4.60,1.50) (4.70,1.57) (4.80,1.22) (4.90,0.22) (5.00,0.63) (5.10,0.24) (5.20,0.68) (5.30,-0.22) (5.40,1.14) (5.50,1.35) (5.60,-0.51) (5.70,0.56) (5.80,1.59) (5.90,1.09)};
  \end{scope}
\end{tikzpicture}
