% Figura (Anexo II, «El enfoque de los estados de la naturaleza»): caja de EDGEWORTH con bienes contingentes.
% Dos agentes, A (origen abajo a la izquierda) y B (arriba a la derecha), con las mismas probabilidades (p = 1/2) y utilidad logarítmica.
% Eje horizontal: renta en el estado 1; vertical: renta en el estado 2. Líneas de certeza a 45 grados desde cada origen.
% (a) Sin riesgo agregado: dotación total 4 en cada estado; las dos líneas de certeza coinciden con la diagonal, que es la curva de contrato.
%     Tangencia en (2,2): A: y = 4/x; B: y = 4 - 4/(4-x).
% (b) Con riesgo agregado: dotación total 5 en el estado 1 y 3,5 en el estado 2; certeza de A: y = x; de B: y = x - 1,5.
%     Curva de contrato (utilidades CRRA iguales): la diagonal de la caja, y = 0,7 x, entre las dos líneas de certeza.
%     Tangencia en (2,5; 1,75): A: y = 4,375/x; B: y = 3,5 - 4,375/(5-x).
% Generar con: bash Code/generar_figura.sh anx_caja_contingente
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=0.95cm, y=0.95cm]
  % ---------------- (a) Sin riesgo agregado ----------------
  \node[font=\footnotesize\bfseries] at (2,5.0) {(a) Sin riesgo agregado};
  \draw[thick] (0,0) rectangle (4,4);
  \node[below left] at (0,0) {$O_A$};
  \node[above right] at (4,4) {$O_B$};
  \draw[very thick] (0,0) -- (4,4);
  \node[anchor=west, align=left] at (4.3,2.9) {certeza de A y de B\\ = curva de contrato};
  \draw[->] (4.28,2.9) -- (3.15,3.05);
  \draw[domain=1.1:3.6, samples=40] plot (\x, {4/\x});
  \draw[domain=0.4:2.9, samples=40] plot (\x, {4-4/(4-\x)});
  \fill (2,2) circle (1.5pt);
  \fill (3.2,0.6) circle (1.5pt) node[right] {$e$};
  \node[below] at (2,0) {renta en el estado 1};
  \node[rotate=90, above] at (0,2) {renta en el estado 2};
  % ---------------- (b) Con riesgo agregado ----------------
  \begin{scope}[xshift=7.4cm]
    \node[font=\footnotesize\bfseries] at (2.5,5.0) {(b) Con riesgo agregado};
    \draw[thick] (0,0) rectangle (5,3.5);
    \node[below left] at (0,0) {$O_A$};
    \node[above right] at (5,3.5) {$O_B$};
    \draw[dashed] (0,0) -- (3.5,3.5) node[above] {certeza de A};
    \draw[dashed] (1.5,0) -- (5,3.5);
    \node[below] at (1.5,0) {certeza de B};
    \draw[very thick] (0,0) -- (5,3.5);
    \node[anchor=west] at (5.1,2.6) {curva de contrato};
    \draw[->] (5.08,2.6) -- (4.1,2.9);
    \draw[domain=1.35:4.2, samples=40] plot (\x, {4.375/\x});
    \draw[domain=0.8:3.65, samples=40] plot (\x, {3.5-4.375/(5-\x)});
    \fill (2.5,1.75) circle (1.5pt);
    \node[below] at (2.5,-0.45) {renta en el estado 1};
  \end{scope}
\end{tikzpicture}
