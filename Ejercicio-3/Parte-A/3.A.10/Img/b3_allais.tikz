% Figura (bloque 3, «Paradoja de ALLAIS»): las loterías de ALLAIS en el triángulo de MARSCHAK-MACHINA del bloque 2.
% Premios: nada, 1 millón y 5 millones. Ejes: p_1 = probabilidad de nada; p_3 = probabilidad de 5 millones. Lado 4.
% Posiciones esquemáticas (no a escala; en realidad B = (0,01; 0,10), C = (0,89; 0), D = (0,90; 0,10)):
%   A = (0; 0) [1 millón seguro]; B = (0,35; 1,05); C = (2,4; 0); D = (2,75; 1,05). AB y CD paralelos (pendiente 3).
% (a) Utilidad esperada: rectas paralelas de pendiente 4 (más inclinadas que AB): A > B y C > D.
% (b) Abanico (MACHINA, 1982): rectas que salen de P = (-2,4; -9,6), fuera del triángulo; pendiente 4 por A y 2 por C:
%     A > B (B bajo la recta de A) y D > C (D sobre la recta de C), como la mayoría de los sujetos.
% Generar con: bash Code/generar_figura.sh b3_allais
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  \def\S{4.0}
  \foreach \i/\titulo/\cond in {0/{(a) Utilidad esperada: rectas paralelas}/{$A\succ B\iff C\succ D$}, 1/{(b) Abanico de curvas de indiferencia}/{$A\succ B$ \ y \ $D\succ C$}} {
    \begin{scope}[xshift=\i*7.8cm]
      \node[font=\footnotesize\bfseries] at (2.0,\S+1.0) {\titulo};
      \fill[gray!12] (0,0) -- (\S,0) -- (0,\S) -- cycle;
      \draw[->] (0,0) -- (\S+0.5,0) node[right] {$p_1$};
      \draw[->] (0,0) -- (0,\S+0.5) node[above] {$p_3$};
      \draw[thick] (0,0) -- (\S,0) -- (0,\S) -- cycle;
      \node[left] at (0,\S) {5 millones};
      \node[below] at (\S,0) {nada};
      % Loterías
      \draw[thick, ->] (0,0) -- (0.33,0.99);
      \draw[thick, ->] (2.4,0) -- (2.73,0.99);
      \fill (0,0) circle (1.6pt) node[below left] {$A$: 1 millón};
      \fill (0.35,1.05) circle (1.6pt) node[left] {$B$};
      \fill (2.4,0) circle (1.6pt) node[below] {$C$};
      \fill (2.75,1.05) circle (1.6pt) node[right] {$D$};
      \node at (2.0,-0.85) {\cond};
    \end{scope}
  }
  % (a) Rectas paralelas
  \begin{scope}
    \clip (0,0) -- (\S,0) -- (0,\S) -- cycle;
    \foreach \x in {0,0.8,1.6,2.4,3.2} {\draw[gray] (\x,0) -- (\x+1,4);}
    \draw[gray] (0,1.4) -- (1,5.4);
    \draw[gray] (0,2.6) -- (1,6.6);
  \end{scope}
  % (b) Abanico desde P = (-2,4; -9,6)
  \begin{scope}[xshift=7.8cm]
    \clip (0,0) -- (\S,0) -- (0,\S) -- cycle;
    \foreach \x in {0,0.8,1.6,2.4,3.2} {\draw[gray] (-2.4,-9.6) -- ($(-2.4,-9.6)!1.6!(\x,0)$);}
    \foreach \y in {1.2,2.4} {\draw[gray] (-2.4,-9.6) -- ($(-2.4,-9.6)!1.6!(0,\y)$);}
  \end{scope}
\end{tikzpicture}
