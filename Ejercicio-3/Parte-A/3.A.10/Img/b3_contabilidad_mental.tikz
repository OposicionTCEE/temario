% Figura (bloque 3, «Contabilidad mental»): separar ganancias y juntar pérdidas sobre la función de valor de b3_funcion_valor.
% v(x) = 2 (1 - e^{-0,45 x}) en ganancias; v(x) = -2,25 · 2 (1 - e^{0,45 x}) en pérdidas. a = b = 1,6.
% (a) v(a) = 1,026; v(a+b) = 1,526; v(a) + v(b) = 2,053 > v(a+b). Escala vertical 1,4.
% (b) v(-a) = -2,309; v(-a-b) = -3,434; v(-a) + v(-b) = -4,618 < v(-a-b). Escala vertical 0,62.
% Las barras apiladas comparan la suma de los valores por separado con el valor del total.
% Generar con: bash Code/generar_figura.sh b3_contabilidad_mental
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  % ---------------- (a) Ganancias ----------------
  \begin{scope}[x=1cm, y=1.4cm]
    \node[font=\footnotesize\bfseries] at (2.1,3.55) {(a) Ganancias: mejor por separado};
    \draw[->] (0,0) -- (4.6,0) node[right] {$x$};
    \draw[->] (0,0) -- (0,3.1) node[above] {$v(x)$};
    \draw[very thick, domain=0:3.6, samples=50] plot (\x, {2*(1-exp(-0.45*\x))});
    \fill (1.6,1.026) circle (1.5pt); \fill (3.2,1.526) circle (1.5pt);
    \draw[dashed] (1.6,1.026) -- (1.6,0) node[below] {$a$};
    \draw[dashed] (3.2,1.526) -- (3.2,0) node[below] {$a+b$};
    \draw[dashed] (0,1.026) node[left] {$v(a)$} -- (1.6,1.026);
    \draw[dashed] (0,1.526) node[left] {$v(a+b)$} -- (3.2,1.526);
    % Barras apiladas: v(a) + v(b)
    \fill[gray!45] (3.9,0) rectangle (4.2,1.026);
    \fill[gray!25] (3.9,1.026) rectangle (4.2,2.053);
    \draw (3.9,0) rectangle (4.2,2.053); \draw (3.9,1.026) -- (4.2,1.026);
    \draw[dashed] (0,2.053) node[left] {$v(a)+v(b)$} -- (3.9,2.053);
    \node at (2.1,-0.75) {$v(a)+v(b)>v(a+b)$};
  \end{scope}
  % ---------------- (b) Pérdidas ----------------
  \begin{scope}[xshift=12.6cm, yshift=3.0cm, x=1cm, y=0.62cm]
    \node[font=\footnotesize\bfseries] at (-2.1,3.1) {(b) Pérdidas: mejor juntas};
    \draw[->] (-4.6,0) -- (0.4,0) node[right] {$x$};
    \draw[->] (0,-5.0) -- (0,0.6) node[above] {$v(x)$};
    \draw[very thick, domain=-3.6:0, samples=50] plot (\x, {-2.25*2*(1-exp(0.45*\x))});
    \fill (-1.6,-2.309) circle (1.5pt); \fill (-3.2,-3.434) circle (1.5pt);
    \draw[dashed] (-1.6,-2.309) -- (-1.6,0) node[above] {$-a$};
    \draw[dashed] (-3.2,-3.434) -- (-3.2,0) node[above] {$-a-b$};
    \draw[dashed] (0,-2.309) node[right] {$v(-a)$} -- (-1.6,-2.309);
    \draw[dashed] (0,-3.434) node[right] {$v(-a-b)$} -- (-3.2,-3.434);
    % Barras apiladas: v(-a) + v(-b)
    \fill[gray!45] (-4.2,0) rectangle (-3.9,-2.309);
    \fill[gray!25] (-4.2,-2.309) rectangle (-3.9,-4.618);
    \draw (-4.2,0) rectangle (-3.9,-4.618); \draw (-4.2,-2.309) -- (-3.9,-2.309);
    \draw[dashed] (0,-4.618) node[right] {$v(-a)+v(-b)$} -- (-3.9,-4.618);
    \node at (-2.1,-5.9) {$v(-a-b)>v(-a)+v(-b)$};
  \end{scope}
\end{tikzpicture}
