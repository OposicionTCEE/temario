% Figura (Anexo II, «Las primas del seguro»): riqueza w, pérdida L con probabilidad p.
% Utilidad ilustrativa u(x) = 4 (1 - e^{-0,45 x}); w - L = 2; w = 7; p = 0,4.
% u(2) = 2,374; u(7) = 3,829; E = w - pL = 5; E[u] = 3,247 (cuerda); EC = 3,710.
% Prima justa pL = 2 (de E a w); prima de riesgo pi = 1,29 (de EC a E); prima de reserva R = 3,29 (de EC a w).
% Generar con: bash Code/generar_figura.sh anx_primas_seguro
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1.05cm, y=1.05cm]
  \draw[->] (0,0) -- (8.4,0) node[below] {riqueza};
  \draw[->] (0,0) -- (0,4.4) node[above] {utilidad};
  \draw[very thick, domain=0.6:8.1, samples=60] plot (\x, {4*(1-exp(-0.45*\x))}) node[right] {$u$};
  \draw (2,2.374) -- (7,3.829);
  \fill (2,2.374) circle (1.4pt); \fill (7,3.829) circle (1.4pt);
  \fill (5,3.247) circle (1.4pt); \fill (3.710,3.247) circle (1.4pt);
  \draw[dashed] (2,2.374) -- (2,0) node[below] {$w-L$};
  \draw[dashed] (7,3.829) -- (7,0) node[below] {$w$};
  \draw[dashed] (5,3.247) -- (5,0) node[below] {$w-pL$};
  \draw[dashed] (3.710,3.247) -- (3.710,0) node[below] {$EC$};
  \draw[dashed] (0,3.247) node[left] {$E[u]$} -- (5,3.247);
  % Primas
  \draw[decorate, decoration={brace, amplitude=3pt, mirror}] (5,-0.5) -- (7,-0.5) node[midway, below=3pt] {prima justa, $pL$};
  \draw[decorate, decoration={brace, amplitude=3pt, mirror}] (3.71,-0.5) -- (5,-0.5) node[midway, below=3pt] {prima de riesgo, $\pi$};
  \draw[decorate, decoration={brace, amplitude=4pt, mirror}] (3.71,-1.15) -- (7,-1.15) node[midway, below=4pt] {prima de reserva, $R=pL+\pi$};
\end{tikzpicture}
