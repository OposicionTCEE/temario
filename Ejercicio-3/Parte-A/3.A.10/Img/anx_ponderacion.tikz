% Figura (Anexo III, «Los pesos de decisión»): función de ponderación de las probabilidades.
% Forma de TVERSKY y KAHNEMAN (1992) para ganancias: w(p) = p^g / (p^g + (1-p)^g)^(1/g), con g = 0,61.
% Se cruza con la diagonal en p ~ 0,34: sobrepondera las probabilidades pequeñas e infrapondera las medias y altas.
% Rehace la figura img1_p40 del tema antiguo.
% Generar con: bash Code/generar_figura.sh anx_ponderacion
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=4.6cm, y=4.6cm]
  \draw[->] (0,0) -- (1.08,0) node[below] {$p$};
  \draw[->] (0,0) -- (0,1.08) node[above] {$w(p)$};
  \draw[dashed] (0,0) -- (1,1);
  \draw[dotted] (1,0) -- (1,1) -- (0,1);
  \draw[very thick, domain=0.0005:0.9995, samples=120] plot (\x, {(\x)^0.61/((\x)^0.61+(1-\x)^0.61)^(1/0.61)}) -- (1,1);
  \node[below] at (0,0) {$0$};
  \node[below] at (1,0) {$1$};
  \node[left] at (0,1) {$1$};
  \draw[dotted] (0.34,0) node[below] {$\approx 0{,}34$} -- (0.34,0.34);
  \node[anchor=west] at (0.03,0.47) {$w(p)>p$};
  \node[anchor=west] at (0.62,0.45) {$w(p)<p$};
\end{tikzpicture}
