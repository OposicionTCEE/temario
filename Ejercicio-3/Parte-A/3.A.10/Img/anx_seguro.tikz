% Figura (Anexo II, «La demanda de seguro»): agente averso al riesgo en el espacio de riqueza contingente.
% w_1: riqueza sin siniestro (probabilidad 1-p); w_2: con siniestro (probabilidad p). Dotación A = (w, w-L) = (4; 1,5).
% Utilidad ilustrativa u = ln, p = 0,4. Curva de indiferencia: w_2 = C w_1^{-1,5}. Recta: w_1 = w - qS, w_2 = w - L + (1-q)S.
% (a) q = p = 0,4: recta w_2 = 7,5 - 1,5 w_1; óptimo en la línea de certeza E = (3; 3), S = L; C = 15,588.
% (b) q = 0,5 > p: recta w_2 = 5,5 - w_1; óptimo (3,3; 2,2), S = 1,4 < L; C = 13,19.
% (c) q = 0,3 < p: recta w_2 = 10,833 - 2,333 w_1; óptimo (2,786; 4,333), S = 4,05 > L; C = 20,15.
% Rehace las figuras img7_p20, img1_p21 e img2_p21 del tema antiguo (los nueve casos van en la tabla del texto).
% Generar con: bash Code/generar_figura.sh anx_seguro
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=0.78cm, y=0.78cm]
  \def\M{5.0}
  \def\S{5.35}
  \foreach \i/\titulo in {0/{(a) Prima justa: $q=p$}, 1/{(b) Prima con recargo: $q>p$}, 2/{(c) Prima favorable: $q<p$}} {
    \begin{scope}[xshift=\i*\S cm]
      \node[font=\footnotesize\bfseries] at (2.6,\M+1.0) {\titulo};
      \draw[->] (0,0) -- (\M+0.4,0) node[below] {$w_1$};
      \draw[->] (0,0) -- (0,\M+0.3) node[above] {$w_2$};
      \draw[dashed] (0,0) -- (4.9,4.9) node[above right] {$w_1=w_2$};
      \fill (4,1.5) circle (1.5pt) node[right=1pt] {$A$};
    \end{scope}
  }
  % (a)
  \draw[thick] (1.8,4.8) -- (4.6,0.6);
  \draw[very thick, domain=2.15:5, samples=50] plot (\x, {15.588*\x^(-1.5)});
  \fill (3,3) circle (1.5pt) node[above right] {$E$};
  % (b)
  \begin{scope}[xshift=\S cm]
    \draw[thick] (0.8,4.7) -- (5,0.5);
    \draw[very thick, domain=1.95:5, samples=50] plot (\x, {13.19*\x^(-1.5)});
    \fill (3.3,2.2) circle (1.5pt) node[above right] {$E$};
  \end{scope}
  % (c)
  \begin{scope}[xshift=2*\S cm]
    \draw[thick] (2.5,5.0) -- (4.4,0.567);
    \draw[very thick, domain=2.55:5, samples=50] plot (\x, {20.15*\x^(-1.5)});
    \fill (2.786,4.333) circle (1.5pt) node[left] {$E$};
  \end{scope}
  % Leyenda común
  \node[align=center] at (8.3,-1.5) {$A=(w,\ w-L)$: sin seguro \qquad $E$: óptimo\\ pendiente de la recta: $-(1-q)/q$ \qquad pendiente de la curva de indiferencia en $w_1=w_2$: $-(1-p)/p$};
\end{tikzpicture}
