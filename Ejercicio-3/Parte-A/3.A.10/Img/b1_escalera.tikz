% Figura (bloque 1, «Riesgo, ambigüedad e incertidumbre radical»): la escalera de la incertidumbre.
% Cada peldaño supone menos información que el anterior: qué se conoce y con qué teoría se analiza.
% Generar con: bash Code/generar_figura.sh b1_escalera
\begin{tikzpicture}[font=\footnotesize,
  peldano/.style={draw, thick, fill=gray!10, text width=3.25cm, minimum height=1.9cm, align=center, inner sep=4pt}]
  \node[peldano] (r) at (0,0) {\textbf{Riesgo}\\[2pt] estados y\\ probabilidades conocidos\\[2pt] \textit{utilidad esperada}};
  \node[peldano] (s) at (3.85,-0.75) {\textbf{Incertidumbre reducible}\\[2pt] una probabilidad subjetiva\\[2pt] \textit{utilidad esperada subjetiva}};
  \node[peldano] (a) at (7.7,-1.5) {\textbf{Ambigüedad}\\[2pt] varias probabilidades posibles\\[2pt] \textit{modelos de ambigüedad}};
  \node[peldano] (i) at (11.55,-2.25) {\textbf{Incertidumbre radical}\\[2pt] ni siquiera los estados\\[2pt] \textit{robustez, reglas, narrativas}};
  \draw[-{Stealth[length=5pt]}, thick] (-1.6,-1.65) -- (9.9,-3.85) node[midway, below, sloped] {menos información};
\end{tikzpicture}
