% Figura (Anexo III, «Finanzas conductuales»): el efecto disposición sobre la función de valor de b3_funcion_valor.
% v(x) = 2 (1 - e^{-0,45 x}) en ganancias; v(x) = -2,25 · 2 (1 - e^{0,45 x}) en pérdidas. Escala vertical 0,75. d = 2.
% Plusvalía latente d: vender da v(d) = 1,187; mantener da 0 o 2d al 50 %: media de v = (0 + 1,669)/2 = 0,835 < v(d): se vende.
% Minusvalía latente -d: vender da v(-d) = -2,670; mantener da 0 o -2d al 50 %: media de v = (0 - 3,756)/2 = -1,878 > v(-d): se mantiene.
% Era el panel (b) de b3_dotacion_disposicion, rehecho con la notación del anexo (precio de compra P_0, variación d).
% Generar con: bash Code/generar_figura.sh anx_disposicion
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, y=0.75cm]
  \draw[->] (-4.8,0) -- (4.8,0) node[right] {$x$};
  \draw[->] (0,-4.4) -- (0,2.4) node[above] {$v(x)$};
  \draw[very thick, domain=0:4.4, samples=50] plot (\x, {2*(1-exp(-0.45*\x))});
  \draw[very thick, domain=-4.4:0, samples=50] plot (\x, {-2.25*2*(1-exp(0.45*\x))});
  % Plusvalía latente d: cuerda entre 0 y 2d
  \draw (0,0) -- (4,1.669);
  \fill (4,1.669) circle (1.3pt);
  \draw[dotted] (4,1.669) -- (4,0) node[below] {$2d$};
  \draw[dotted] (2,1.187) -- (2,0) node[below] {$d$};
  \fill (2,1.187) circle (1.6pt) node[above left] {vender};
  \fill[gray] (2,0.835) circle (1.4pt) node[below right] {mantener};
  % Minusvalía latente -d: cuerda entre 0 y -2d
  \draw (0,0) -- (-4,-3.756);
  \fill (-4,-3.756) circle (1.3pt);
  \draw[dotted] (-4,-3.756) -- (-4,0) node[above] {$-2d$};
  \draw[dotted] (-2,-2.670) -- (-2,0) node[above] {$-d$};
  \fill (-2,-2.670) circle (1.6pt) node[below right] {vender};
  \fill[gray] (-2,-1.878) circle (1.4pt) node[above left] {mantener};
\end{tikzpicture}
