% Figura (Anexo II, «Prudencia y ahorro precautorio»): utilidad marginal del consumo futuro, c_1 o c_2 con probabilidad 1/2.
% (a) u'' ' > 0 (utilidad marginal convexa): u'(c) = 2,4 / c; c_1 = 0,8 -> 3,0; c_2 = 3,2 -> 0,75; cbar = 2 -> 1,2; E[u'] = 1,875.
% (b) u'' ' = 0 (utilidad cuadrática, utilidad marginal lineal): u'(c) = 3,2 - 0,8 c; c_1 -> 2,56; c_2 -> 0,64; cbar -> 1,6 = E[u'].
% Generar con: bash Code/generar_figura.sh anx_prudencia
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  \def\W{4.0}
  \def\H{3.4}
  \def\S{6.6}
  \foreach \i/\titulo in {0/{(a) $u'''>0$: utilidad marginal convexa}, 1/{(b) $u'''=0$: utilidad cuadrática}} {
    \begin{scope}[xshift=\i*\S cm]
      \node[font=\footnotesize\bfseries] at (2.0,\H+0.5) {\titulo};
      \draw[->] (0,0) -- (\W+0.3,0) node[below] {$c$};
      \draw[->] (0,0) -- (0,\H+0.1) node[above] {$u'(c)$};
      \draw[dashed] (0.8,0) node[below] {$c_1$} -- (0.8,0.1);
      \draw[dashed] (3.2,0) node[below] {$c_2$} -- (3.2,0.1);
    \end{scope}
  }
  % (a)
  \draw[very thick, domain=0.72:3.9, samples=60] plot (\x, {2.4/\x}) node[right] {$u'$};
  \draw (0.8,3.0) -- (3.2,0.75);
  \foreach \p in {(0.8,3.0), (3.2,0.75), (2,1.2), (2,1.875)} \fill \p circle (1.3pt);
  \draw[dashed] (0.8,3.0) -- (0.8,0);
  \draw[dashed] (3.2,0.75) -- (3.2,0);
  \draw[dashed] (2,1.875) -- (2,0) node[below] {$\bar c$};
  \draw[dashed] (0,1.875) node[left] {$E[u'(\tilde c)]$} -- (2,1.875);
  \draw[dashed] (0,1.2) node[left] {$u'(\bar c)$} -- (2,1.2);
  % (b)
  \begin{scope}[xshift=\S cm]
    \draw[very thick] (0.3,2.96) -- (3.9,0.08) node[right] {$u'$};
    \foreach \p in {(0.8,2.56), (3.2,0.64), (2,1.6)} \fill \p circle (1.3pt);
    \draw[dashed] (0.8,2.56) -- (0.8,0);
    \draw[dashed] (3.2,0.64) -- (3.2,0);
    \draw[dashed] (2,1.6) -- (2,0) node[below] {$\bar c$};
    \draw[dashed] (0,1.6) node[left, align=right] {$E[u'(\tilde c)]$\\$=u'(\bar c)$} -- (2,1.6);
  \end{scope}
\end{tikzpicture}
