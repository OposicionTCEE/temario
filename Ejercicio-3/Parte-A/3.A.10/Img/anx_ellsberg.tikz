% Figura (Anexo III, «La paradoja de ELLSBERG»): las urnas de ELLSBERG (1961).
% (a) Dos urnas: la I con n bolas rojas (R) y n negras (N); la II con 2n bolas rojas o negras en proporción desconocida (?).
% (b) Tres colores: n bolas rojas y 2n negras o amarillas en proporción desconocida.
% Rehace la figura img1_p35 del tema antiguo.
% Generar con: bash Code/generar_figura.sh anx_ellsberg
\begin{tikzpicture}[font=\footnotesize,
  bola/.style={draw, circle, minimum size=5.2mm, inner sep=0pt, font=\scriptsize},
  urna/.style={draw, thick, rounded corners=6pt, minimum width=2.6cm, minimum height=2.5cm}]
  % ---------------- (a) Dos urnas ----------------
  \node[font=\footnotesize\bfseries] at (2.6,2.25) {(a) Dos urnas};
  \node[urna] at (1.1,0) {};
  \node[urna] at (4.3,0) {};
  \foreach \x/\y/\c in {0.45/0.6/R, 1.1/0.6/R, 1.75/0.6/R, 0.45/0/R, 1.1/0/N, 1.75/0/N, 0.45/-0.6/N, 1.1/-0.6/N, 1.75/-0.6/N} {
    \node[bola, fill=\ifx\c R gray!35\else white\fi] at (\x,\y) {$\c$};
  }
  \foreach \x/\y in {3.65/0.6, 4.3/0.6, 4.95/0.6, 3.65/0, 4.3/0, 4.95/0, 3.65/-0.6, 4.3/-0.6, 4.95/-0.6} {
    \node[bola] at (\x,\y) {?};
  }
  \node[align=center] at (1.1,-1.75) {Urna I\\ mitad rojas, mitad negras};
  \node[align=center] at (4.3,-1.75) {Urna II\\ rojas y negras en\\ proporción desconocida};
  % ---------------- (b) Tres colores ----------------
  \begin{scope}[xshift=8.6cm]
    \node[font=\footnotesize\bfseries] at (1.6,2.25) {(b) Tres colores};
    \node[urna, minimum width=3.4cm] at (1.6,0) {};
    \foreach \x/\y in {0.6/0.6, 1.25/0.6, 1.9/0.6} {
      \node[bola, fill=gray!35] at (\x,\y) {$R$};
    }
    \foreach \x/\y in {2.55/0.6, 0.6/0, 1.25/0, 1.9/0, 2.55/0, 0.6/-0.6, 1.25/-0.6, 1.9/-0.6, 2.55/-0.6} {
      \node[bola] at (\x,\y) {?};
    }
    \node[align=center] at (1.6,-1.75) {$n$ rojas ($R$) y $2n$ negras o amarillas\\ en proporción desconocida};
  \end{scope}
\end{tikzpicture}
