% Figura (Anexo III, «La paradoja de ELLSBERG»): las urnas de ELLSBERG (1961).
% (a) Dos urnas: la I con n bolas rojas (R) y n negras (N) (aquí n = 4); la II con 2n bolas rojas o negras en proporción desconocida (?).
% (b) Tres colores: n bolas rojas y 2n negras o amarillas en proporción desconocida (aquí n = 3).
% Rehace la figura img1_p35 del tema antiguo.
% Generar con: bash Code/generar_figura.sh anx_ellsberg
\begin{tikzpicture}[font=\footnotesize,
  bola/.style={draw, circle, minimum size=5.2mm, inner sep=0pt, font=\scriptsize},
  roja/.style={bola, fill=gray!35},
  urna/.style={draw, thick, rounded corners=6pt, minimum width=3.0cm, minimum height=1.9cm}]
  % ---------------- (a) Dos urnas ----------------
  \node[font=\footnotesize\bfseries] at (2.0,1.75) {(a) Dos urnas};
  \node[urna] at (0,0) {};
  \node[urna] at (4.0,0) {};
  \foreach \x in {-0.98,-0.33,0.33,0.98} {
    \node[roja] at (\x,0.33) {$R$};
    \node[bola] at (\x,-0.33) {$N$};
    \node[bola] at (\x+4.0,0.33) {?};
    \node[bola] at (\x+4.0,-0.33) {?};
  }
  \node[align=center] at (0,-1.45) {Urna I: $n$ rojas y $n$ negras};
  \node[align=center] at (4.0,-1.45) {Urna II: $2n$ rojas o negras\\ en proporción desconocida};
  % ---------------- (b) Tres colores ----------------
  \begin{scope}[xshift=9.4cm]
    \node[font=\footnotesize\bfseries] at (0,1.75) {(b) Tres colores};
    \node[urna, minimum width=2.4cm, minimum height=2.5cm] at (0,0) {};
    \foreach \x in {-0.65,0,0.65} {
      \node[roja] at (\x,0.65) {$R$};
      \node[bola] at (\x,0) {?};
      \node[bola] at (\x,-0.65) {?};
    }
    \node[align=center] at (0,-1.75) {$n$ rojas y $2n$ negras o amarillas\\ en proporción desconocida};
  \end{scope}
\end{tikzpicture}
