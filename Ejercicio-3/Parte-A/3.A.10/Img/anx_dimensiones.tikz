% Figura (Anexo I, «Adaptarse a la incertidumbre o reducirla»): las dos dimensiones de la información imperfecta.
% Filas: sobre qué recae la incertidumbre (HIRSHLEIFER, 1971): la naturaleza (información simétrica) o los demás (asimétrica).
% Columnas: qué hace el agente (HIRSHLEIFER y RILEY, 1979, 1992): adaptarse (acciones terminales) o reducirla (acciones informativas).
% La fila superior, sombreada, es el objeto del tema 3.A.10.
% Generar con: bash Code/generar_figura.sh anx_dimensiones
\begin{tikzpicture}[font=\footnotesize,
  celda/.style={draw, minimum width=4.9cm, minimum height=2.1cm, text width=4.6cm, align=center, inner sep=4pt},
  cab/.style={minimum width=4.9cm, text width=4.6cm, align=center, inner sep=3pt},
  fila/.style={text width=3.3cm, align=center, inner sep=3pt}]
  % Cabeceras de columna
  \node[cab] (c1) at (0,0) {\textbf{Adaptarse a la incertidumbre}\\ acciones terminales\\ (economía de la incertidumbre)};
  \node[cab] (c2) at (4.9,0) {\textbf{Reducir la incertidumbre}\\ acciones informativas\\ (economía de la información)};
  % Celdas
  \node[celda, fill=gray!15] (a11) at (0,-1.9) {Elección con riesgo, ambigüedad e incertidumbre radical; reparto del riesgo y mercados contingentes\\[3pt] \textit{Tema 3.A.10 (anexos II y III); Tema 3.A.21}};
  \node[celda, fill=gray!15] (a12) at (4.9,-1.9) {Valor privado y social de la información; búsqueda, experimentación, investigación\\[3pt] \textit{Tema 3.A.10 (anexo I)}};
  \node[celda] (a21) at (0,-4.0) {Contratos con información oculta o acción oculta: selección adversa y riesgo moral\\[3pt] \textit{Tema 3.A.13}};
  \node[celda] (a22) at (4.9,-4.0) {Señalización, filtrado y revelación de información por los precios\\[3pt] \textit{Tema 3.A.13; Tema 3.A.14}};
  % Cabeceras de fila
  \node[fila, anchor=east] at (-2.5,-1.9) {\textbf{Incertidumbre tecnológica}\\ sobre el estado de la naturaleza\\ (información simétrica)};
  \node[fila, anchor=east] at (-2.5,-4.0) {\textbf{Incertidumbre de mercado}\\ sobre lo que saben o hacen los demás\\ (información asimétrica)};
  % Llave: objeto del tema
  \draw[decorate, decoration={brace, amplitude=5pt}] (7.5,-0.85) -- (7.5,-2.95)
    node[midway, right=6pt, text width=1.4cm, align=left] {objeto del tema};
\end{tikzpicture}
