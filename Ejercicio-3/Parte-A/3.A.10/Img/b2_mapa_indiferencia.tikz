% Figura (bloque 2, «Función de utilidad esperada»): el mapa de indiferencia de la utilidad esperada en el triángulo
% de MARSCHAK-MACHINA (premios 0 < y < x; p_1 = prob. de nada, p_3 = prob. de x). Lado 4.
% (a) Rectas paralelas de pendiente 0,625; L = (0,4; 0,95) y L' = (1,8; 1,825) en la misma recta (p_3 = 0,7 + 0,625 p_1);
%     su mezcla con alpha = 1/2, (1,1; 1,3875), en la misma recta.
% (b) Pendiente (u_2 - u_1)/(u_3 - u_2). Con x = 2y, el neutral (u lineal) tiene pendiente 1 (rectas de igual valor
%     esperado); un averso, 1,8. Rectas por el origen (y seguro) y una más de cada familia (p_3 = p_1 - 1,2; p_3 = 1,8 (p_1 - 0,8)).
%     Q = (1,5; 1,5) tiene el mismo valor esperado que y seguro y queda por debajo de la recta del averso por el origen.
% Generar con: bash Code/generar_figura.sh b2_mapa_indiferencia
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  \def\S{4.0}
  % ---------------- (a) Rectas paralelas ----------------
  \node[font=\footnotesize\bfseries] at (2.0,\S+1.0) {(a) Curvas de indiferencia rectas y paralelas};
  \fill[gray!12] (0,0) -- (\S,0) -- (0,\S) -- cycle;
  \draw[->] (0,0) -- (\S+0.5,0) node[right] {$p_1$};
  \draw[->] (0,0) -- (0,\S+0.5) node[above] {$p_3$};
  \begin{scope}
    \clip (0,0) -- (\S,0) -- (0,\S) -- cycle;
    \foreach \b in {-1.2,-0.3,1.5,2.3,3.1} {\draw[gray] (0,\b) -- (\S,\b+0.625*\S);}
    \draw[very thick] (0,0.7) -- (\S,0.7+0.625*\S);
  \end{scope}
  \draw[thick] (0,0) -- (\S,0) -- (0,\S) -- cycle;
  \fill (0.4,0.95) circle (1.5pt) node[above left] {$L$};
  \fill (1.8,1.825) circle (1.5pt) node[above left] {$L'$};
  \fill (1.1,1.3875) circle (1.5pt);
  \draw (1.1,1.3875) -- (1.55,0.75) node[below, fill=gray!12, inner sep=1.5pt] {$\alpha L+(1-\alpha)L'$};
  \draw[->, thick] (0.75,2.45) -- (0.42,2.98);
  % ---------------- (b) Pendiente y actitud frente al riesgo ----------------
  \begin{scope}[xshift=7.6cm]
    \node[font=\footnotesize\bfseries] at (2.0,\S+1.0) {(b) La pendiente y la actitud frente al riesgo};
    \fill[gray!12] (0,0) -- (\S,0) -- (0,\S) -- cycle;
    \draw[->] (0,0) -- (\S+0.5,0) node[right] {$p_1$};
    \draw[->] (0,0) -- (0,\S+0.5) node[above] {$p_3$};
    \begin{scope}
      \clip (0,0) -- (\S,0) -- (0,\S) -- cycle;
      \draw[dashed] (0,0) -- (\S,\S);
      \draw[dashed] (1.2,0) -- (\S+1.2,\S);
      \draw[very thick] (0,0) -- (\S,1.8*\S);
      \draw[very thick] (0.8,0) -- (0.8+\S,1.8*\S);
    \end{scope}
    \draw[thick] (0,0) -- (\S,0) -- (0,\S) -- cycle;
    \node[anchor=south west] at (2.0,2.0) {neutral};
    \node[anchor=south west] at (1.43,2.57) {averso};
    \fill (1.5,1.5) circle (1.5pt) node[below right] {$Q$};
    \node[below left] at (0,0) {$y$};
    \node[anchor=west] at (3.3,3.2) {pendiente $=\dfrac{u_2-u_1}{u_3-u_2}$};
  \end{scope}
\end{tikzpicture}
