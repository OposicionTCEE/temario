% Figura (Anexo II, «Aversión, neutralidad y preferencia por el riesgo»): lotería con dos resultados x_1 y x_2, igual probabilidad.
% xbar = E[x] (punto medio). La cuerda da E[u(x)]; la curva en xbar da u(xbar); EC es el equivalente cierto.
% (a) u cóncava: u(x) = 3,2 (1 - e^{-0,7 x}); x_1 = 0,8 -> 1,372; x_2 = 3,6 -> 2,942; xbar = 2,2: u = 2,514, E[u] = 2,157; EC = 1,601.
% (b) u lineal: u(x) = 0,4 + 0,7 x; u(x_1) = 0,96; u(x_2) = 2,92; E[u] = u(xbar) = 1,94; EC = xbar.
% (c) u convexa: u(x) = 0,3 + 0,18 x^2; u(x_1) = 0,415; u(x_2) = 2,633; u(xbar) = 1,171; E[u] = 1,524; EC = 2,608.
% Rehace la figura img3_p16 del tema antiguo.
% Generar con: bash Code/generar_figura.sh anx_actitud_riesgo
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  \def\W{3.9}
  \def\H{3.3}
  \def\S{5.35}
  % Ejes y marcas comunes
  \foreach \i/\titulo in {0/{(a) Averso: $u$ cóncava}, 1/{(b) Neutral: $u$ lineal}, 2/{(c) Amante: $u$ convexa}} {
    \begin{scope}[xshift=\i*\S cm]
      \node[font=\footnotesize\bfseries] at (2.0,\H+0.55) {\titulo};
      \draw[->] (0,0) -- (\W+0.25,0) node[below] {$x$};
      \draw[->] (0,0) -- (0,\H+0.1);
    \end{scope}
  }
  % ---------------- (a) Averso ----------------
  \draw[very thick, domain=0.3:3.9, samples=60] plot (\x, {3.2*(1-exp(-0.7*\x))}) node[right] {$u$};
  \draw (0.8,1.372) -- (3.6,2.942);
  \fill (0.8,1.372) circle (1.3pt); \fill (3.6,2.942) circle (1.3pt);
  \fill (2.2,2.514) circle (1.3pt); \fill (2.2,2.157) circle (1.3pt);
  \draw[dashed] (0.8,1.372) -- (0.8,0) node[below] {$x_1$};
  \draw[dashed] (3.6,2.942) -- (3.6,0) node[below] {$x_2$};
  \draw[dashed] (2.2,2.514) -- (2.2,0) node[below] {$\bar x$};
  \draw[dashed] (0,2.514) node[left] {$u(\bar x)$} -- (2.2,2.514);
  \draw[dashed] (0,2.157) node[left] {$E[u]$} -- (2.2,2.157);
  \draw[dotted] (1.601,2.157) -- (1.601,0) node[below] {$EC$};
  \draw[decorate, decoration={brace, amplitude=3pt, mirror}] (1.601,-0.42) -- (2.2,-0.42) node[midway, below=2pt] {$\pi>0$};
  % ---------------- (b) Neutral ----------------
  \begin{scope}[xshift=\S cm]
    \draw[very thick] (0.3,0.61) -- (3.9,3.13) node[right] {$u$};
    \fill (0.8,0.96) circle (1.3pt); \fill (3.6,2.92) circle (1.3pt); \fill (2.2,1.94) circle (1.3pt);
    \draw[dashed] (0.8,0.96) -- (0.8,0) node[below] {$x_1$};
    \draw[dashed] (3.6,2.92) -- (3.6,0) node[below] {$x_2$};
    \draw[dashed] (2.2,1.94) -- (2.2,0) node[below] {$\bar x=EC$};
    \draw[dashed] (0,1.94) node[left, align=right] {$u(\bar x)$\\$=E[u]$} -- (2.2,1.94);
    \node at (2.2,-0.78) {$\pi=0$};
  \end{scope}
  % ---------------- (c) Amante ----------------
  \begin{scope}[xshift=2*\S cm]
    \draw[very thick, domain=0.2:3.9, samples=60] plot (\x, {0.3+0.18*\x*\x}) node[right] {$u$};
    \draw (0.8,0.415) -- (3.6,2.633);
    \fill (0.8,0.415) circle (1.3pt); \fill (3.6,2.633) circle (1.3pt);
    \fill (2.2,1.171) circle (1.3pt); \fill (2.2,1.524) circle (1.3pt);
    \draw[dashed] (0.8,0.415) -- (0.8,0) node[below] {$x_1$};
    \draw[dashed] (3.6,2.633) -- (3.6,0) node[below] {$x_2$};
    \draw[dashed] (2.2,1.524) -- (2.2,0) node[below] {$\bar x$};
    \draw[dashed] (0,1.524) node[left] {$E[u]$} -- (2.608,1.524);
    \draw[dashed] (0,1.171) node[left] {$u(\bar x)$} -- (2.2,1.171);
    \draw[dotted] (2.608,1.524) -- (2.608,0) node[below] {$EC$};
    \draw[decorate, decoration={brace, amplitude=3pt, mirror}] (2.2,-0.42) -- (2.608,-0.42) node[midway, below=2pt] {$\pi<0$};
  \end{scope}
  % Leyenda común
  \node at ({(2*\S+\W)/2},-1.35) {Lotería: $x_1$ o $x_2$ con probabilidad $\tfrac12$ \qquad $\bar x=E[\tilde x]$ \qquad $E[u]=E[u(\tilde x)]$ \qquad $u(EC)=E[u]$ \qquad $\pi=\bar x-EC$};
\end{tikzpicture}
