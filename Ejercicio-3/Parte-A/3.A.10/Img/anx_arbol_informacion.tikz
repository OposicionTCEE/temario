% Figura (Anexo I, «El valor privado de la información»): el problema del paraguas como árbol de decisión.
% (a) Sin información: el individuo decide (cuadrado) antes de que la naturaleza mueva (círculo).
% (b) Con información perfecta: la naturaleza mueve primero y el individuo decide conociendo el estado.
% En (b), trazo grueso: el acto óptimo en cada estado, dado que u_{L1} > u_{N1} y u_{N2} > u_{L2}.
% Generar con: bash Code/generar_figura.sh anx_arbol_informacion
\begin{tikzpicture}[font=\footnotesize,
  dec/.style={draw, fill=white, minimum size=7pt, inner sep=0pt},
  azar/.style={draw, circle, fill=white, minimum size=7pt, inner sep=0pt},
  rama/.style={draw},
  opt/.style={draw, very thick}]
  % ---------------- (a) Sin información ----------------
  \node[font=\footnotesize\bfseries] at (2.3,2.55) {(a) Decidir sin información};
  \coordinate (D) at (0,0);
  \coordinate (CL) at (2.2,1.1);
  \coordinate (CN) at (2.2,-1.1);
  \draw[rama] (D) -- node[above left=-1pt] {$a_L$} (CL);
  \draw[rama] (D) -- node[below left=-1pt] {$a_N$} (CN);
  \draw[rama] (CL) -- node[above, sloped] {$\theta_1\ (p)$} (4.4,1.75) node[right] {$u_{L1}$};
  \draw[rama] (CL) -- node[below, sloped] {$\theta_2\ (1-p)$} (4.4,0.45) node[right] {$u_{L2}$};
  \draw[rama] (CN) -- node[above, sloped] {$\theta_1\ (p)$} (4.4,-0.45) node[right] {$u_{N1}$};
  \draw[rama] (CN) -- node[below, sloped] {$\theta_2\ (1-p)$} (4.4,-1.75) node[right] {$u_{N2}$};
  \node[dec] at (D) {};
  \node[azar] at (CL) {};
  \node[azar] at (CN) {};
  % ---------------- (b) Con información perfecta ----------------
  \begin{scope}[xshift=8.2cm]
    \node[font=\footnotesize\bfseries] at (2.3,2.55) {(b) Decidir con información perfecta};
    \coordinate (C) at (0,0);
    \coordinate (D1) at (2.2,1.1);
    \coordinate (D2) at (2.2,-1.1);
    \draw[rama] (C) -- node[above left=-1pt] {$\theta_1\ (p)$} (D1);
    \draw[rama] (C) -- node[below left=-1pt] {$\theta_2\ (1-p)$} (D2);
    \draw[opt] (D1) -- node[above, sloped] {$a_L$} (4.4,1.75) node[right] {$u_{L1}$};
    \draw[rama] (D1) -- node[below, sloped] {$a_N$} (4.4,0.45) node[right] {$u_{N1}$};
    \draw[rama] (D2) -- node[above, sloped] {$a_L$} (4.4,-0.45) node[right] {$u_{L2}$};
    \draw[opt] (D2) -- node[below, sloped] {$a_N$} (4.4,-1.75) node[right] {$u_{N2}$};
    \node[azar] at (C) {};
    \node[dec] at (D1) {};
    \node[dec] at (D2) {};
  \end{scope}
  % Leyenda común
  \node[align=center] at (6.4,-2.75) {%
    \tikz\node[draw, minimum size=6pt, inner sep=0pt]{}; nodo de decisión \qquad
    \tikz\node[draw, circle, minimum size=6pt, inner sep=0pt]{}; nodo de azar \qquad
    $a_L$: llevar paraguas \quad $a_N$: no llevarlo \quad $\theta_1$: llueve \quad $\theta_2$: no llueve \qquad
    $u_{L1}>u_{N1}$, \ $u_{N2}>u_{L2}$};
\end{tikzpicture}
