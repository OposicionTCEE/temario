% Figura (Anexo II, «Loterías simples y compuestas»): una lotería compuesta y su lotería reducida.
% (a) Primera etapa: con probabilidad alfa se juega L_1 = (p_1, p_2, p_3) y con 1 - alfa, L_2 = (q_1, q_2, q_3).
% (b) Lotería reducida: cada consecuencia c_n con probabilidad alfa p_n + (1 - alfa) q_n.
% Generar con: bash Code/generar_figura.sh anx_loteria_compuesta
\begin{tikzpicture}[font=\footnotesize,
  azar/.style={draw, circle, fill=white, minimum size=7pt, inner sep=0pt}]
  % ---------------- (a) Lotería compuesta ----------------
  \node[font=\footnotesize\bfseries] at (2.3,2.75) {(a) Lotería compuesta};
  \coordinate (R) at (0,0);
  \coordinate (A) at (2.0,1.25);
  \coordinate (B) at (2.0,-1.25);
  \draw (R) -- node[above left=-1pt] {$\alpha$} (A);
  \draw (R) -- node[below left=-1pt] {$1-\alpha$} (B);
  \node[left=3pt] at (A) {$L_1$};
  \node[left=3pt] at (B) {$L_2$};
  \foreach \y/\c/\p in {2.05/1/p_1, 1.25/2/p_2, 0.45/3/p_3} {
    \draw (A) -- node[above, sloped, pos=0.55] {$\p$} (4.2,\y) node[right] {$c_\c$};
  }
  \foreach \y/\c/\p in {-0.45/1/q_1, -1.25/2/q_2, -2.05/3/q_3} {
    \draw (B) -- node[above, sloped, pos=0.55] {$\p$} (4.2,\y) node[right] {$c_\c$};
  }
  \node[azar] at (R) {};
  \node[azar] at (A) {};
  \node[azar] at (B) {};
  % ---------------- (b) Lotería reducida ----------------
  \begin{scope}[xshift=8.0cm]
    \node[font=\footnotesize\bfseries] at (2.3,2.75) {(b) Lotería reducida};
    \coordinate (R2) at (0,0);
    \draw (R2) -- node[above, sloped] {$\alpha p_1+(1-\alpha)q_1$} (4.2,1.6) node[right] {$c_1$};
    \draw (R2) -- node[above] {$\alpha p_2+(1-\alpha)q_2$} (4.2,0) node[right] {$c_2$};
    \draw (R2) -- node[below, sloped] {$\alpha p_3+(1-\alpha)q_3$} (4.2,-1.6) node[right] {$c_3$};
    \node[azar] at (R2) {};
  \end{scope}
  % Flecha entre paneles
  \draw[-{Stealth[length=5pt]}, thick] (5.4,0) -- node[above] {se reduce a} (7.4,0);
\end{tikzpicture}
