% Figura (Anexo II, «Dominancia estocástica»): funciones de distribución.
% (a) Primer orden: F(x) <= G(x) para todo x (logísticas de pendiente 2,2 centradas en 2,7 y 1,7).
% (b) Aumento del riesgo (ROTHSCHILD y STIGLITZ, 1970): G tiene la misma media que F y más dispersión
%     (logísticas centradas en 2,2, pendientes 3,2 y 1,3): se cortan una vez y las dos áreas sombreadas son iguales.
% Rehace las figuras img1_p23 e img1_p25 del tema antiguo.
% Generar con: bash Code/generar_figura.sh anx_dominancia
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  \def\W{4.6}
  \def\H{3.0}
  \def\S{7.6}
  \foreach \i/\titulo in {0/{(a) Dominancia de primer orden}, 1/{(b) Aumento del riesgo con igual media}} {
    \begin{scope}[xshift=\i*\S cm]
      \node[font=\footnotesize\bfseries] at (2.3,\H+0.75) {\titulo};
      \draw[->] (0,0) -- (\W+0.3,0) node[below] {$x$};
      \draw[->] (0,0) -- (0,\H+0.35);
      \draw[dotted] (0,\H) node[left] {$1$} -- (\W,\H);
    \end{scope}
  }
  % (a)
  \draw[very thick, domain=0:4.6, samples=80] plot (\x, {3/(1+exp(-2.2*(\x-1.7)))}) node[right] {$G$};
  \draw[very thick, dashed, domain=0:4.6, samples=80] plot (\x, {3/(1+exp(-2.2*(\x-2.7)))}) node[right] {$F$};
  \node at (2.3,-0.65) {$F(x)\leq G(x)$ para todo $x$};
  % (b)
  \begin{scope}[xshift=\S cm]
    \fill[gray!25, domain=0:2.2, samples=60] plot (\x, {3/(1+exp(-1.3*(\x-2.2)))}) -- plot[domain=2.2:0] (\x, {3/(1+exp(-3.2*(\x-2.2)))}) -- cycle;
    \fill[gray!25, domain=2.2:4.6, samples=60] plot (\x, {3/(1+exp(-3.2*(\x-2.2)))}) -- plot[domain=4.6:2.2] (\x, {3/(1+exp(-1.3*(\x-2.2)))}) -- cycle;
    \draw[very thick, domain=0:4.6, samples=80] plot (\x, {3/(1+exp(-1.3*(\x-2.2)))}) node[right] {$G$};
    \draw[very thick, dashed, domain=0:4.6, samples=80] plot (\x, {3/(1+exp(-3.2*(\x-2.2)))}) node[above right] {$F$};
    \draw[dotted] (2.2,1.5) -- (2.2,0) node[below] {$\mu$};
    \node at (2.3,-0.65) {misma media $\mu$; áreas sombreadas iguales};
  \end{scope}
\end{tikzpicture}
