% Figura (Anexo III, «El abanico de las curvas de indiferencia»): la paradoja de ALLAIS en el triángulo de MARSCHAK-MACHINA.
% Ejes: p_1 (probabilidad de 0, la peor consecuencia) y p_3 (probabilidad de x, la mejor); la intermedia es y.
% Posiciones esquemáticas: A = (0; 0) [y seguro]; B = (0,25; 1); C = (2,6; 0); D = (2,85; 1). AB y CD son paralelos (pendiente 4).
% (a) Utilidad esperada: rectas paralelas de pendiente 5 por x0 = 0; 0,9; 1,8; 2,6: A > B y C > D.
% (b) Abanico (MACHINA, 1982): pendientes 5; 4,4; 3,7; 3 por los mismos puntos: A > B y D > C, como la mayoría de los sujetos.
% Rehace la tabla img1_p33 del tema antiguo (las loterías van en la tabla del texto).
% Generar con: bash Code/generar_figura.sh anx_allais_abanico
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  \def\S{4.0}
  \foreach \i/\titulo in {0/{(a) Utilidad esperada: rectas paralelas}, 1/{(b) Abanico de curvas de indiferencia}} {
    \begin{scope}[xshift=\i*7.6cm]
      \node[font=\footnotesize\bfseries] at (2.1,\S+1.0) {\titulo};
      \fill[gray!12] (0,0) -- (\S,0) -- (0,\S) -- cycle;
      \draw[->] (0,0) -- (\S+0.5,0) node[right] {$p_1$};
      \draw[->] (0,0) -- (0,\S+0.5) node[above] {$p_3$};
      \draw[thick] (0,0) -- (\S,0) -- (0,\S) -- cycle;
      \draw[dashed, thick] (0,0) -- (0.25,1.0);
      \draw[dashed, thick] (2.6,0) -- (2.85,1.0);
      \fill (0,0) circle (1.5pt) node[below left] {$A$};
      \fill (0.25,1.0) circle (1.5pt) node[right] {$B$};
      \fill (2.6,0) circle (1.5pt) node[below] {$C$};
      \fill (2.85,1.0) circle (1.5pt) node[right] {$D$};
    \end{scope}
  }
  % (a) Paralelas
  \draw (0,0) -- (0.667,3.333);
  \draw (0.9,0) -- (1.417,2.583);
  \draw (1.8,0) -- (2.167,1.833);
  \draw (2.6,0) -- (2.833,1.167);
  \node at (2.1,-0.75) {$A\succ B$ y $C\succ D$, o bien $B\succ A$ y $D\succ C$};
  % (b) Abanico
  \begin{scope}[xshift=7.6cm]
    \draw (0,0) -- (0.667,3.333);
    \draw (0.9,0) -- (1.474,2.526);
    \draw (1.8,0) -- (2.268,1.732);
    \draw (2.6,0) -- (2.95,1.05);
    \node at (2.1,-0.75) {$A\succ B$ y $D\succ C$};
  \end{scope}
\end{tikzpicture}
