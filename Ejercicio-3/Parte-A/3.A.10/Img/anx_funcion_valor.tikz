% Figura (Anexo III, «La función de valor»): función de valor de la teoría de las perspectivas.
% Forma de TVERSKY y KAHNEMAN (1992): v(x) = x^0,88 si x >= 0; v(x) = -2,25 (-x)^0,88 si x < 0 (escala de dibujo 0,55).
% Cóncava en ganancias, convexa en pérdidas y más inclinada en pérdidas (aversión a las pérdidas); pliegue en el punto de referencia.
% Rehace la figura img1_p38 del tema antiguo.
% Generar con: bash Code/generar_figura.sh anx_funcion_valor
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  \draw[->] (-4.2,0) -- (4.4,0) node[below] {$x$};
  \draw[->] (0,-3.9) -- (0,2.5) node[above] {$v(x)$};
  \draw[very thick, domain=0:4.0, samples=60] plot (\x, {0.55*(\x)^0.88});
  \draw[very thick, domain=-2.65:0, samples=60] plot (\x, {-0.55*2.25*(-\x)^0.88});
  \node[below left] at (0,0) {$0$};
  % Simetría de referencia: la rama de ganancias reflejada, para comparar con la de pérdidas
  \draw[dashed, gray, domain=-4.0:0, samples=60] plot (\x, {-0.55*(-\x)^0.88});
  \node[align=center] at (2.6,-0.55) {ganancias};
  \node[align=center] at (-2.6,0.4) {pérdidas};
  \node[anchor=west] at (4.05,1.85) {cóncava};
  \node[anchor=east] at (-2.75,-3.2) {convexa};
  \node[anchor=west, gray] at (-4.15,-1.75) {$-v(-x)$};
\end{tikzpicture}
