% Figura (bloque 3, «Aversión a las pérdidas»): efecto dotación y efecto disposición sobre la función de valor de b3_funcion_valor.
% v(x) = 2 (1 - e^{-0,45 x}) en ganancias; v(x) = -2,25 · 2 (1 - e^{0,45 x}) en pérdidas. Escala vertical 0,75.
% (a) Dotación: un bien de valor m = 2: v(m) = 1,187 (adquirirlo); v(-m) = -2,670 = -lambda v(m) (desprenderse de él).
% (b) Disposición: G = plusvalía latente de 2; mantener = 1 o 3 al 50 %: media de v = (0,725 + 1,482)/2 = 1,104 < v(2) = 1,187:
%     se vende. P = minusvalía latente de -2; mantener = -1 o -3 al 50 %: media de v = (-1,631 - 3,334)/2 = -2,483 > v(-2) = -2,670:
%     se mantiene.
% Generar con: bash Code/generar_figura.sh b3_dotacion_disposicion
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, y=0.75cm]
  % ---------------- (a) Dotación ----------------
  \node[font=\footnotesize\bfseries] at (0,2.6) {(a) Efecto dotación};
  \draw[->] (-3.6,0) -- (3.6,0) node[right] {$x$};
  \draw[->] (0,-4.0) -- (0,2.1) node[above] {$v(x)$};
  \draw[very thick, domain=0:3.3, samples=40] plot (\x, {2*(1-exp(-0.45*\x))});
  \draw[very thick, domain=-3.3:0, samples=40] plot (\x, {-2.25*2*(1-exp(0.45*\x))});
  \fill (2,1.187) circle (1.5pt); \fill (-2,-2.670) circle (1.5pt);
  \draw[dashed] (2,1.187) -- (2,0) node[below] {$m$};
  \draw[dashed] (-2,-2.670) -- (-2,0) node[above] {$-m$};
  \draw[dashed] (0,1.187) node[left] {$v(m)$} -- (2,1.187);
  \draw[dashed] (0,-2.670) node[right] {$v(-m)$} -- (-2,-2.670);
  \node at (0,-4.7) {$|v(-m)|=\lambda\,v(m)$};
  % ---------------- (b) Disposición ----------------
  \begin{scope}[xshift=8.4cm]
    \node[font=\footnotesize\bfseries] at (0,2.6) {(b) Efecto disposición};
    \draw[->] (-3.6,0) -- (3.6,0) node[right] {$x$};
    \draw[->] (0,-4.0) -- (0,2.1) node[above] {$v(x)$};
    \draw[very thick, domain=0:3.3, samples=40] plot (\x, {2*(1-exp(-0.45*\x))});
    \draw[very thick, domain=-3.3:0, samples=40] plot (\x, {-2.25*2*(1-exp(0.45*\x))});
    % Plusvalía G = 2: cuerda entre 1 y 3
    \draw (1,0.725) -- (3,1.482);
    \fill (1,0.725) circle (1.3pt); \fill (3,1.482) circle (1.3pt);
    \fill (2,1.187) circle (1.6pt) node[above left] {$G$};
    \fill[gray] (2,1.104) circle (1.4pt);
    \draw[dotted] (2,1.104) -- (2,0) node[below] {$2$};
    % Minusvalía P = -2: cuerda entre -1 y -3
    \draw (-1,-1.631) -- (-3,-3.334);
    \fill (-1,-1.631) circle (1.3pt); \fill (-3,-3.334) circle (1.3pt);
    \fill (-2,-2.670) circle (1.6pt) node[below right] {$P$};
    \fill[gray] (-2,-2.483) circle (1.4pt);
    \draw[dotted] (-2,-2.483) -- (-2,0) node[above] {$-2$};
    \node at (0,-4.7) {$G$: plusvalía latente \qquad $P$: minusvalía latente};
  \end{scope}
\end{tikzpicture}
