% Figura (bloque 2, «Loterías y axiomas»): el triángulo de MARSCHAK-MACHINA con premios 0 < y < x y el axioma de independencia.
% Ejes: p_1, probabilidad de no ganar nada; p_3, probabilidad de ganar x; p_2 = 1 - p_1 - p_3 (probabilidad de y). Lado 4.
% (a) Vértices: origen = y seguro; (4,0) = nada seguro; (0,4) = x seguro. Lotería L = (1,2; 1,4).
% (b) L = (0,4; 1,9), L' = (1,6; 1,3), L'' = (2,6; 0,3), alpha = 1/2:
%     M = alpha L + (1 - alpha) L'' = (1,5; 1,1); M' = alpha L' + (1 - alpha) L'' = (2,1; 0,8).
%     Pendiente de LL' y de MM': -0,5 (paralelos: la mezcla es una homotecia de centro L'' y razón alpha).
% Generar con: bash Code/generar_figura.sh b2_triangulo
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  \def\S{4.0}
  % ---------------- (a) El triángulo ----------------
  \node[font=\footnotesize\bfseries] at (2.0,\S+1.0) {(a) El triángulo de MARSCHAK-MACHINA};
  \fill[gray!12] (0,0) -- (\S,0) -- (0,\S) -- cycle;
  \draw[->] (0,0) -- (\S+0.5,0) node[right] {$p_1$};
  \draw[->] (0,0) -- (0,\S+0.5) node[above] {$p_3$};
  \draw[thick] (0,0) -- (\S,0) -- (0,\S) -- cycle;
  \node[below left] at (0,0) {$y$ seguro};
  \node[below] at (\S,0) {nada seguro};
  \node[left] at (0,\S) {$x$ seguro};
  \fill (1.2,1.4) circle (1.5pt) node[above right] {$L$};
  \draw[dashed] (1.2,1.4) -- (1.2,0) node[below] {$p_1^L$};
  \draw[dashed] (1.2,1.4) -- (0,1.4) node[left] {$p_3^L$};
  \draw[->, thick] (0.95,2.35) -- (0.55,2.85);
  % ---------------- (b) La independencia ----------------
  \begin{scope}[xshift=7.6cm]
    \node[font=\footnotesize\bfseries] at (2.0,\S+1.0) {(b) El axioma de independencia};
    \fill[gray!12] (0,0) -- (\S,0) -- (0,\S) -- cycle;
    \draw[->] (0,0) -- (\S+0.5,0) node[right] {$p_1$};
    \draw[->] (0,0) -- (0,\S+0.5) node[above] {$p_3$};
    \draw[thick] (0,0) -- (\S,0) -- (0,\S) -- cycle;
    \draw[dashed] (0.4,1.9) -- (2.6,0.3);
    \draw[dashed] (1.6,1.3) -- (2.6,0.3);
    \draw[thick] (0.4,1.9) -- (1.6,1.3);
    \draw[thick] (1.5,1.1) -- (2.1,0.8);
    \fill (0.4,1.9) circle (1.5pt) node[above] {$L$};
    \fill (1.6,1.3) circle (1.5pt) node[above right] {$L'$};
    \fill (2.6,0.3) circle (1.5pt) node[right] {$L''$};
    \fill (1.5,1.1) circle (1.5pt) node[below left] {$M$};
    \fill (2.1,0.8) circle (1.5pt) node[above right] {$M'$};
    \node[align=left, anchor=west] at (3.3,2.4) {$M=\alpha L+(1-\alpha)L''$\\ $M'=\alpha L'+(1-\alpha)L''$\\[3pt] $L\succsim L'\iff M\succsim M'$};
  \end{scope}
\end{tikzpicture}
