% Figura (Anexo II, «Loterías simples y compuestas»): el conjunto de loterías con tres consecuencias.
% (a) El símplex en el espacio de probabilidades (p_1, p_2, p_3): el triángulo de vértices (1,0,0), (0,1,0), (0,0,1).
% (b) Triángulo de MARSCHAK-MACHINA: proyección sobre (p_1, p_3), con c_1 la peor consecuencia y c_3 la mejor;
%     p_2 = 1 - p_1 - p_3. Cada vértice es una lotería degenerada (una consecuencia segura).
% Rehace la «Imagen 2» del tema antiguo (MAS-COLELL, WHINSTON y GREEN, 1995).
% Generar con: bash Code/generar_figura.sh anx_simplex
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  % ---------------- (a) El símplex en R^3 ----------------
  \node[font=\footnotesize\bfseries] at (0.6,4.25) {(a) El símplex de probabilidades};
  % Proyección oblicua: p_1 hacia abajo a la izquierda, p_2 a la derecha, p_3 hacia arriba
  \coordinate (O) at (0,0);
  \coordinate (E1) at (-1.6,-1.2);
  \coordinate (E2) at (3.0,0);
  \coordinate (E3) at (0,3.0);
  \draw[->] (O) -- (-2.1,-1.575) node[below left] {$p_1$};
  \draw[->] (O) -- (3.6,0) node[right] {$p_2$};
  \draw[->] (O) -- (0,3.5) node[above] {$p_3$};
  \fill[gray!20] (E1) -- (E2) -- (E3) -- cycle;
  \draw[thick] (E1) -- (E2) -- (E3) -- cycle;
  \node[left=2pt] at (E1) {$(1,0,0)$};
  \node[below right] at (E2) {$(0,1,0)$};
  \node[right] at (E3) {$(0,0,1)$};
  % Una lotería: (0,3; 0,4; 0,3) en la proyección
  \coordinate (L) at ($0.3*(E1)+0.4*(E2)+0.3*(E3)$);
  \fill (L) circle (1.5pt) node[above right] {$L$};
  \node at (0.55,-1.85) {$p_1+p_2+p_3=1$};
  % ---------------- (b) Triángulo de MARSCHAK-MACHINA ----------------
  \begin{scope}[xshift=7.6cm, yshift=-1.0cm]
    \node[font=\footnotesize\bfseries] at (2.0,5.25) {(b) Triángulo de MARSCHAK-MACHINA};
    \def\S{4.0}
    \fill[gray!20] (0,0) -- (\S,0) -- (0,\S) -- cycle;
    \draw[->] (0,0) -- (\S+0.5,0) node[right] {$p_1$};
    \draw[->] (0,0) -- (0,\S+0.5) node[above] {$p_3$};
    \draw[thick] (0,0) -- (\S,0) -- (0,\S) -- cycle;
    \node[below left] at (0,0) {$c_2$ segura};
    \node[below] at (\S,0) {$c_1$ segura};
    \node[left] at (0,\S) {$c_3$ segura};
    \node[above right, rotate=-45] at (2.05,2.05) {$p_2=0$};
    % La misma lotería L
    \fill (1.2,1.2) circle (1.5pt) node[above right] {$L$};
    \draw[dashed] (1.2,1.2) -- (1.2,0) node[below] {$p_1$};
    \draw[dashed] (1.2,1.2) -- (0,1.2) node[left] {$p_3$};
  \end{scope}
\end{tikzpicture}
