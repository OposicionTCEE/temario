% Figura (bloque 1, «Información: ¿cuánto valoramos una decisión informada?»).
% (a) Igual que el panel (a) de anx_valor_informacion_perfecta (anexo I): u_N2 = 3,0; u_N1 = 0,6; u_L2 = 1,6; u_L1 = 2,8;
%     U_N(p) = 3,0 - 2,4 p ; U_L(p) = 1,6 + 1,2 p ; p^ = 0,3889; con información: 3,0 - 0,2 p.
% (b) VIP(p) = min{ p a, (1-p) b }, con a = u_L1 - u_N1 y b = u_N2 - u_L2; umbral p^ = b/(a+b). Escala vertical x3.
%     Agente 1 (el del panel a): a = 2,2; b = 1,4; p^_1 = 0,389; máximo 0,856 (2,567 dibujado); en p = 1/2: 0,7 (2,1).
%     Agente 2 (mojarse le importa poco): a = 0,42; b = 1,4; p^_2 = 0,769; máximo 0,323 (0,969); en p = 1/2: 0,21 (0,63).
% Generar con: bash Code/generar_figura.sh b1_valor_informacion
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  \def\W{5.0}  % ancho de cada eje (p de 0 a 1)
  \def\H{3.6}  % alto de cada eje
  % ---------------- (a) Utilidad esperada ----------------
  \node[font=\footnotesize\bfseries, anchor=south] at (\W/2,\H+0.35) {(a) Utilidad esperada con y sin información};
  \fill[gray!20] (0,3.0) -- (1.944,2.0667) -- (\W,2.8) -- cycle;
  \draw[->] (0,0) -- (\W+0.35,0) node[below] {$p$};
  \draw[->] (0,0) -- (0,\H) node[above] {Utilidad esperada};
  \node[below] at (0,0) {$0$};
  \draw (\W,0.06) -- (\W,-0.06) node[below] {$1$};
  \draw[gray] (0,3.0) -- (\W,0.6) node[right, black] {$U_N(p)$};
  \draw[gray] (0,1.6) -- (\W,2.8) node[right, black] {$U_L(p)$};
  \draw[very thick] (0,3.0) -- (1.944,2.0667) -- (\W,2.8);
  \draw[thick, dashed] (0,3.0) -- (\W,2.8);
  \node[anchor=south] at (3.6,2.86) {con información};
  \node[anchor=north] at (3.6,2.35) {sin información};
  \draw[dotted] (1.944,2.0667) -- (1.944,0) node[below] {$\hat p$};
  \draw[<->] (1.944,2.0667) -- (1.944,2.9222);
  \node[anchor=west] at (2.0,2.48) {$VIP(\hat p)$};
  \node[left] at (0,3.0) {$u_{N2}$};
  \node[left] at (0,1.6) {$u_{L2}$};
  % ---------------- (b) Dos agentes ----------------
  \begin{scope}[xshift=8.6cm]
    \node[font=\footnotesize\bfseries, anchor=south] at (\W/2,\H+0.35) {(b) Valor de la información de dos agentes};
    \draw[->] (0,0) -- (\W+0.35,0) node[below] {$p$};
    \draw[->] (0,0) -- (0,\H) node[above] {$VIP(p)$};
    \node[below] at (0,0) {$0$};
    \draw (\W,0.06) -- (\W,-0.06) node[below] {$1$};
    % Agente 1
    \draw[very thick] (0,0) -- (1.944,2.567) -- (\W,0);
    \node[anchor=south] at (1.944,2.6) {agente 1};
    \draw[dotted] (1.944,2.567) -- (1.944,0) node[below] {$\hat p_1$};
    % Agente 2
    \draw[very thick, gray] (0,0) -- (3.846,0.969) -- (\W,0);
    \node[anchor=south, gray] at (4.05,1.0) {agente 2};
    \draw[dotted] (3.846,0.969) -- (3.846,0) node[below] {$\hat p_2$};
    % Misma probabilidad de lluvia
    \draw[dashed] (2.5,0) node[below] {$\tfrac12$} -- (2.5,2.35);
    \fill (2.5,2.1) circle (1.4pt);
    \fill (2.5,0.63) circle (1.4pt);
  \end{scope}
\end{tikzpicture}
