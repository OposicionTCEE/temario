% Figura (Anexo II, «El axioma de independencia»): lo que implica la independencia en el triángulo de MARSCHAK-MACHINA.
% Ejes: p_1 (probabilidad de la peor consecuencia, c_1) y p_3 (de la mejor, c_3).
% (a) Rectas: si L ~ L', cualquier mezcla de ambas está en la misma curva de indiferencia (segmento LL').
% (b) Paralelas: al mezclar L y L' con una tercera lotería L'' en la misma proporción, los puntos M y M' quedan en una recta
%     paralela a la de L y L' (la mezcla es una homotecia de centro L''); por independencia, M ~ M'.
% Recta de L y L': p_3 = 0,7 + 0,625 p_1 (unidades de dibujo; lados del triángulo de 4).
% L = (0,4; 0,95), L' = (1,8; 1,825), L'' = (2,6; 0,3), beta = 1/2: M = (1,5; 0,625), M' = (2,2; 1,0625).
% Generar con: bash Code/generar_figura.sh anx_independencia
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  \def\S{4.0}
  \foreach \i/\titulo in {0/{(a) Las curvas de indiferencia son rectas}, 1/{(b) Las rectas son paralelas}} {
    \begin{scope}[xshift=\i*7.4cm]
      \node[font=\footnotesize\bfseries] at (2.1,\S+0.85) {\titulo};
      \fill[gray!12] (0,0) -- (\S,0) -- (0,\S) -- cycle;
      \draw[->] (0,0) -- (\S+0.5,0) node[right] {$p_1$};
      \draw[->] (0,0) -- (0,\S+0.5) node[above] {$p_3$};
      \draw[thick] (0,0) -- (\S,0) -- (0,\S) -- cycle;
      % Curva de indiferencia de L y L'
      \draw[very thick] (0,0.7) -- (2.031,1.969);
      \fill (0.4,0.95) circle (1.5pt) node[above left] {$L$};
      \fill (1.8,1.825) circle (1.5pt) node[above left] {$L'$};
      % Dirección de preferencia creciente
      \draw[->, thick] (0.75,2.45) -- (0.42,2.98);
    \end{scope}
  }
  % (a) La mezcla de L y L' está en la misma recta
  \fill (1.1,1.3875) circle (1.5pt);
  \node[below right] at (1.1,1.3875) {$\alpha L+(1-\alpha)L'$};
  % (b) Mezclas con L''
  \begin{scope}[xshift=7.4cm]
    \draw[dashed] (0.4,0.95) -- (2.6,0.3);
    \draw[dashed] (1.8,1.825) -- (2.6,0.3);
    \fill (2.6,0.3) circle (1.5pt) node[right] {$L''$};
    \draw[very thick] (0.5,0) -- (2.654,1.346);
    \fill (1.5,0.625) circle (1.5pt) node[below right] {$M$};
    \fill (2.2,1.0625) circle (1.5pt) node[above left] {$M'$};
    % Otras curvas de indiferencia, paralelas
    \draw[gray] (0,1.5) -- (1.538,2.462);
    \draw[gray] (0,2.3) -- (1.046,2.954);
    \node[align=left, anchor=west] at (4.4,1.6) {$M=\beta L+(1-\beta)L''$\\ $M'=\beta L'+(1-\beta)L''$};
  \end{scope}
\end{tikzpicture}
