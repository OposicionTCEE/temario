% La misma matriz de pagos en los dos episodios, para ver que lo que cambió no fue la casilla sino la
% ESTRUCTURA de los pagos. Subrayada la mejor respuesta de cada autoridad; sombreada la casilla realizada.
% (a) 2010-2013: nadie tiene estrategia dominante, hay dos equilibrios y el conflicto se plantea.
% (b) 2020-2021: cada autoridad tiene estrategia dominante y el equilibrio es único; el conflicto no llega a plantearse.
\begin{tikzpicture}[font=\footnotesize, line cap=round,
    jug/.style={font=\scriptsize\bfseries},
    acc/.style={font=\scriptsize\itshape},
    tit/.style={font=\footnotesize\bfseries}]

\foreach \px/\titulo/\ua/\ub/\uc/\ud in {%
    0/{(a) 2010-2013}/{a_{M}\,,\,a_{F}}/{\underline{b_{M}}\,,\,\underline{b_{F}}}/{\underline{c_{M}}\,,\,\underline{c_{F}}}/{d_{M}\,,\,d_{F}},
    6.6/{(b) 2020-2021}/{a_{M}\,,\,\underline{a_{F}}}/{b_{M}\,,\,b_{F}}/{\underline{c_{M}}\,,\,\underline{c_{F}}}/{\underline{d_{M}}\,,\,d_{F}}}{
  \begin{scope}[xshift=\px cm]
    \node[tit] at (3.05,0.75) {\titulo};
    % bandas
    \fill[black!8] (1.1,0.35) rectangle (5.5,-0.25);
    \fill[black!8] (0,-0.25) rectangle (1.1,-1.65);
    % casilla realizada
    \fill[black!14] (1.1,-0.95) rectangle (3.3,-1.65);
    % reglas
    \draw[line width=0.5pt] (1.1,0.35) -- (5.5,0.35);
    \draw[line width=0.5pt] (0,-0.25) -- (5.5,-0.25);
    \draw[line width=0.5pt] (0,-0.95) -- (5.5,-0.95);
    \draw[line width=0.5pt] (0,-1.65) -- (5.5,-1.65);
    \draw[line width=0.5pt] (0,-0.25) -- (0,-1.65);
    \draw[line width=0.5pt] (1.1,0.35) -- (1.1,-1.65);
    \draw[line width=0.5pt] (3.3,-0.25) -- (3.3,-1.65);
    \draw[line width=0.5pt] (5.5,0.35) -- (5.5,-1.65);
    % cabeceras
    \node[acc] at (2.2,0.05) {Fiscal cede};
    \node[acc] at (4.4,0.05) {Fiscal no cede};
    \node[acc, rotate=90] at (0.55,-0.60) {M.\ cede};
    \node[acc, rotate=90] at (0.55,-1.30) {M.\ no cede};
    % casillas
    \node at (2.2,-0.60) {$\left(\ua\right)$};
    \node at (4.4,-0.60) {$\left(\ub\right)$};
    \node at (2.2,-1.30) {$\left(\uc\right)$};
    \node at (4.4,-1.30) {$\left(\ud\right)$};
  \end{scope}}

\end{tikzpicture}
