\begin{tikzpicture}[font=\footnotesize,
    celda/.style={draw, very thick, minimum width=5.0cm, minimum height=2.1cm, align=center, inner sep=5pt, text width=4.6cm},
    cab/.style={align=center}]

  % --- Celdas ---------------------------------------------------------------
  \node[celda] (a) at (0,0)      {\textbf{Dominancia monetaria}\\[3pt] Equilibrio único: la inflación la fija el banco central};
  \node[celda] (b) at (5.1,0)    {\textbf{Ambas activas}\\[3pt] No hay equilibrio estable: la deuda explota};
  \node[celda] (c) at (0,-2.2)   {\textbf{Ambas pasivas}\\[3pt] Indeterminación: nada ancla el nivel de precios};
  \node[celda] (d) at (5.1,-2.2) {\textbf{Dominancia fiscal}\\[3pt] Equilibrio único: la inflación la fija el Tesoro};

  % --- Cabeceras de columna -------------------------------------------------
  \node[cab] at (0,1.55)   {\textbf{Fiscal pasiva}\\ $\psi>r-g$};
  \node[cab] at (5.1,1.55) {\textbf{Fiscal activa}\\ $\psi<r-g$};

  % --- Cabeceras de fila ----------------------------------------------------
  \node[cab, anchor=east] at (-2.75,0)    {\textbf{Monetaria activa}\\ $\varphi_{\pi}>1$};
  \node[cab, anchor=east] at (-2.75,-2.2) {\textbf{Monetaria pasiva}\\ $\varphi_{\pi}<1$};

\end{tikzpicture}
