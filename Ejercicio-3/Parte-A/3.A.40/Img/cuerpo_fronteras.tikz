\begin{tikzpicture}[>=stealth, font=\footnotesize, x=1cm, y=1cm,
    celda/.style={draw, thick, minimum width=5.4cm, minimum height=1.15cm, align=center, inner sep=4pt},
    final/.style={draw, very thick, minimum width=11.4cm, minimum height=1.0cm, align=center, inner sep=4pt}]

  % --- Cabeceras ------------------------------------------------------------
  \node at (0,0)   {\textbf{La frontera fiscal}};
  \node at (6.0,0) {\textbf{La frontera monetaria}};

  % --- Columna fiscal -------------------------------------------------------
  \node[celda] at (0,-0.95) {\textit{Supone}\\ que el potencial no depende de la demanda};
  \node[celda] at (0,-2.75) {\textit{Lo rompe}\\ la histéresis y el componente de oferta\\ de la inversión pública};
  \node[celda] at (0,-4.55) {\textit{Queda en pie}\\ son objetos distintos:\\ trimestres frente a décadas};

  % --- Columna monetaria ----------------------------------------------------
  \node[celda] at (6.0,-0.95) {\textit{Supone}\\ que estabilizar no reparte};
  \node[celda] at (6.0,-2.75) {\textit{Lo rompe}\\ que cuatro quintos de la transmisión\\ sean renta laboral};
  \node[celda] at (6.0,-4.55) {\textit{Queda en pie}\\ se delega por compromiso,\\ no por neutralidad};

  % --- Flechas --------------------------------------------------------------
  \draw[->, thick] (0,-1.57) -- (0,-2.13);
  \draw[->, thick] (0,-3.37) -- (0,-3.93);
  \draw[->, thick] (6.0,-1.57) -- (6.0,-2.13);
  \draw[->, thick] (6.0,-3.37) -- (6.0,-3.93);
  \draw[->, thick] (0,-5.17)   -- (2.30,-5.80);
  \draw[->, thick] (6.0,-5.17) -- (3.70,-5.80);

  % --- Cierre ---------------------------------------------------------------
  \node[final] at (3.0,-6.35) {\textbf{No es una refutación: es una delimitación}};

\end{tikzpicture}
