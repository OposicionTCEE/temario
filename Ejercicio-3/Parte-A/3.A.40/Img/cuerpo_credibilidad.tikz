% Adaptación de b3_impago del 3.B.16: equilibrios múltiples en la deuda pública.
% Estructura de OBSTFELD (1996) trasladada a la deuda como el cálculo de costes y beneficios del impago
% de DE GRAUWE (2011, 2020): coste de seguir pagando si se espera que el Estado pague, L1 = 0,11 b^2,
% y si se espera el impago, L2 = 0,24 b^2; coste del impago Q = 4. Cortes en b_bajo = 4,08 y b_alto = 6,03.
% Umbrales renombrados a la notación de este tema y añadido b_0 dentro de la zona de crisis.
\begin{tikzpicture}[font=\footnotesize, x=1.20cm, y=0.58cm, >={Stealth[length=2mm]}]
  \draw[->] (0,0) -- (9.3,0);
  \node[anchor=south east] at (9.3,0.15) {deuda pública en proporción del PIB, $b$};
  \draw[->] (0,0) -- (0,8.6);
  \node[anchor=south west] at (0,8.6) {coste para el Estado};

  % --- coste del impago -----------------------------------------------------
  \draw[black!85, thick] (0,4) -- (8.6,4) node[right] {$Q$};

  % --- costes de seguir pagando --------------------------------------------
  \draw[black!85, thick, domain=0:8.5, samples=60] plot (\x, {0.11*\x*\x}) node[right] {$L_{1}$};
  \draw[black!60, thick, domain=0:5.85, samples=60] plot (\x, {0.24*\x*\x}) node[right] {$L_{2}$};

  % --- cortes ---------------------------------------------------------------
  \draw[black!40, densely dotted] (4.08,0) -- (4.08,4);
  \draw[black!40, densely dotted] (6.03,0) -- (6.03,4);
  \fill (4.08,4) circle (1.6pt) node[above left] {$B$};
  \fill (6.03,4) circle (1.6pt) node[below right] {$A$};
  \node[below] at (4.08,0) {$\underline{b}$};
  \node[below] at (6.03,0) {$\bar{b}$};

  % --- el nivel que admite los dos resultados ------------------------------
  \draw[densely dotted] (5.05,0) -- (5.05,6.12);
  \fill (5.05,2.81) circle (1.8pt);
  \fill (5.05,6.12) circle (1.8pt);
  \node[anchor=east] at (4.97,2.81) {$E^{g}$};
  \node[anchor=east] at (4.97,6.12) {$E^{m}$};
  \node[below] at (5.05,-0.02) {$b_{0}$};

  % --- zonas ----------------------------------------------------------------
  \draw[decorate, decoration={brace, mirror, amplitude=4pt}, black!60] (0.05,-0.95) -- (4.03,-0.95) node[midway, below=4pt, black] {paga siempre};
  \draw[decorate, decoration={brace, mirror, amplitude=4pt}, black!60] (4.13,-0.95) -- (5.98,-0.95) node[midway, below=4pt, black, align=center] {deciden las\\expectativas};
  \draw[decorate, decoration={brace, mirror, amplitude=4pt}, black!60] (6.08,-0.95) -- (9.1,-0.95) node[midway, below=4pt, black] {impago};

  % --- respaldo monetario ---------------------------------------------------
  \draw[->, thick, black!70, dashed] (6.60,6.20) -- (6.60,3.30);
  \node[anchor=west, align=left, font=\scriptsize] at (6.72,6.90) {con respaldo creíble,\\$L_{2}$ se acerca a $L_{1}$};

\end{tikzpicture}
