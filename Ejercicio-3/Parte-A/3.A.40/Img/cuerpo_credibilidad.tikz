\begin{tikzpicture}[>=stealth, font=\footnotesize, x=1cm, y=1cm]

  % --- Zona de crisis -------------------------------------------------------
  \fill[black!8] (3.6,0) rectangle (8.4,5.2);

  % --- Ejes -----------------------------------------------------------------
  \draw[->] (0,0) -- (10.6,0);
  \node[anchor=west] at (10.7,0) {Deuda, $b$};
  \draw[->] (0,0) -- (0,5.7);
  \node[anchor=south west] at (0,5.75) {Prima de riesgo, $\varrho$};

  % --- Umbrales -------------------------------------------------------------
  \draw[dashed] (3.6,0) -- (3.6,5.2);
  \draw[dashed] (8.4,0) -- (8.4,5.2);
  \node[anchor=north] at (3.6,-0.08) {$\underline{b}$};
  \node[anchor=north] at (8.4,-0.08) {$\bar{b}$};

  % --- Ramas ----------------------------------------------------------------
  \draw[very thick] (0,0.45) .. controls (3,0.65) and (6,1.00) .. (8.4,1.55);
  \node[anchor=north west] at (7.1,1.18) {$E^{g}$};
  \draw[very thick] (3.6,2.85) .. controls (5.6,3.60) and (7.0,4.10) .. (8.4,4.80);
  \fill (3.6,2.85) circle (1.7pt);
  \node[anchor=south east] at (7.3,4.18) {$E^{m}$};
  \draw[very thick] (8.4,1.55) -- (8.4,4.80);

  % --- El mismo nivel de deuda, dos resultados ------------------------------
  \draw[dotted, thick] (6.0,0) -- (6.0,3.80);
  \node[anchor=north] at (6.0,-0.08) {$b_{0}$};
  \fill (6.0,1.00) circle (2pt);
  \fill (6.0,3.80) circle (2pt);
  \draw[<->, thick] (6.35,1.15) -- (6.35,3.65);
  \node[anchor=west, align=left] at (6.5,2.40) {expectativas};

  % --- Efecto del respaldo --------------------------------------------------
  \draw[->, thick, dash pattern=on 3pt off 2pt] (3.6,-0.95) -- (6.3,-0.95);
  \node[anchor=west] at (6.4,-0.95) {$\underline{b}\,'$};
  \node[anchor=north] at (4.95,-1.05) {respaldo};

  % --- Rotulo de la zona ----------------------------------------------------
  \node[anchor=north] at (6.0,5.15) {zona de crisis};

\end{tikzpicture}
