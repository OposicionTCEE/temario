% Misma base canónica que la figura anterior (reparto_mgs del 3.A.29), con la solución:
% la regla de transferencias z que lleva de la autarquía E al punto de la regla de oro G.
% G = (2,15 ; 2,15), tangencia de u^G: c^V = 4,6225/c^J con la recta factible.
\begin{tikzpicture}[xscale=1.70,yscale=1.35,font=\footnotesize]

  \draw[->,thick] (0,0) -- (5.0,0) node[right] {$c^{J}$};
  \draw[->,thick] (0,0) -- (0,5.0) node[above] {$c^{V}$};

  % ---- recta de asignaciones estacionarias factibles ----
  \draw[very thick] (0,4.3) -- (4.3,0);

  % ---- curvas de indiferencia ----
  \draw[very thick,dash pattern=on 4pt off 2pt,domain=0.62:4.70,samples=120,smooth,variable=\x]
       plot ({\x},{2.8/\x});
  \node[below right] at (4.55,{2.8/4.55+0.06}) {$u^{E}$};
  \draw[very thick,dash pattern=on 4pt off 2pt,domain=1.10:4.25,samples=120,smooth,variable=\x]
       plot ({\x},{4.6225/\x});
  \node[above right] at (4.15,{4.6225/4.15}) {$u^{G}$};

  % ---- dotación y regla de oro ----
  \node[circle,fill,inner sep=1.5pt] at (3.5,0.8) {};
  \node[below right] at (3.54,0.78) {$E$};
  \node[circle,fill,inner sep=1.5pt] at (2.15,2.15) {};
  \node[above right] at (2.21,2.17) {$G$};

  \draw[dotted,gray] (3.5,0) -- (3.5,0.8);
  \draw[dotted,gray] (0,0.8) -- (3.5,0.8);
  \draw[dotted,gray] (2.15,0) -- (2.15,2.15);
  \draw[dotted,gray] (0,2.15) -- (2.15,2.15);
  \node[below] at (3.5,-0.1) {$e^{J}$};
  \node[below] at (2.15,-0.1) {$c^{J}_{G}$};
  \node[left] at (0,0.8) {$e^{V}$};
  \node[left] at (0,2.15) {$c^{V}_{G}$};

  % ---- la transferencia que lleva de E a G ----
  \draw[-{Stealth[length=5pt]},very thick] (3.5,0.28) -- (2.15,0.28);
  \node[below] at (2.83,0.26) {$z$};
  \draw[-{Stealth[length=5pt]},very thick] (0.42,0.8) -- (0.42,2.15);
  \node[right] at (0.46,1.48) {$z$};

\end{tikzpicture}
