% Concepción estabilizadora: corregir la desviación del producto efectivo respecto del potencial,
% sin alterar el potencial. Mitad del antiguo cuerpo_potencial, dividido a petición del usuario.
\begin{tikzpicture}[>=stealth, font=\footnotesize, x=1cm, y=1cm]

  % --- Ejes -----------------------------------------------------------------
  \draw[->] (0,0) -- (11.4,0);
  \node[anchor=west] at (11.5,0) {tiempo};
  \draw[->] (0,0) -- (0,4.2);
  \node[anchor=south west] at (0,4.25) {producto};

  % --- Producto potencial ---------------------------------------------------
  \draw[very thick] (0.4,1.30) -- (9.8,3.40);
  \node[anchor=west] at (9.9,3.40) {$Y^{*}$};

  % --- Producto efectivo ----------------------------------------------------
  \draw[very thick, dashed]
    (0.4,1.30) .. controls (1.4,2.05) and (2.1,2.10) .. (3.0,1.52)
    .. controls (3.9,0.95) and (4.6,0.95) .. (5.5,1.95)
    .. controls (6.4,2.95) and (7.2,3.30) .. (8.2,2.55)
    .. controls (8.9,2.02) and (9.4,2.30) .. (9.8,2.85);
  \node[anchor=north west] at (9.9,2.75) {$Y$};

  % --- La brecha y su cierre ------------------------------------------------
  \draw[<->, thick] (3.9,1.02) -- (3.9,1.98);
  \node[anchor=north] at (3.9,0.80) {brecha};
  \draw[->, thick] (6.9,3.52) -- (6.9,3.14);
  \node[anchor=south] at (6.9,3.56) {estabilizar};

\end{tikzpicture}
