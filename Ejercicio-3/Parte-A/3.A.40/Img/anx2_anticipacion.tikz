\begin{tikzpicture}[>=stealth, font=\footnotesize, x=1cm, y=1cm]

  % --- Linea de tiempo ------------------------------------------------------
  \draw[->, very thick] (0,0) -- (13.2,0);
  \node[anchor=west] at (13.3,0) {tiempo};

  \fill (3,0) circle (2.4pt);
  \fill (9,0) circle (2.4pt);
  \draw[very thick] (3,-0.18) -- (3,0.18);
  \draw[very thick] (9,-0.18) -- (9,0.18);

  % --- Rotulos de los dos instantes -----------------------------------------
  \node[anchor=south] at (3,0.30) {\textbf{Anuncio}};
  \node[anchor=south] at (9,0.30) {\textbf{Ejecución del gasto}};
  \node[anchor=north] at (3,-0.28) {$t_{0}$};
  \node[anchor=north] at (9,-0.28) {$t_{1}$};

  % --- Lo que ocurre en la ventana ------------------------------------------
  \draw[<->, thick] (3.15,1.25) -- (8.85,1.25);
  \node[anchor=south] at (6,1.32) {$C$ y $w$ ya responden};
  \draw[dotted] (3,0.75) -- (3,1.25);
  \draw[dotted] (9,0.75) -- (9,1.25);

  % --- Llave de la anticipacion ---------------------------------------------
  \draw[decorate, decoration={brace, amplitude=6pt, mirror}] (3,-0.75) -- (9,-0.75);
  \node[anchor=north] at (6,-1.05) {anticipación};

  % --- Que fecha cada cosa --------------------------------------------------
  \node[anchor=north, align=center] at (3,-1.70) {Perturbación\\ verdadera};
  \node[anchor=north, align=center] at (9,-1.70) {Perturbación que\\ fecha el VAR};

\end{tikzpicture}
