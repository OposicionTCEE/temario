% Cierre del anexo II: las dos fronteras como la rotura de dos separaciones que el marco necesita.
% Registro de tabla con reglas, como anx2_canales, y no de cajas, que es el del cuerpo.
% La separación se dibuja como un recuadro partido por una línea INTERRUMPIDA: es la que cada frontera rompe.
\begin{tikzpicture}[>=stealth, font=\footnotesize, x=1cm, y=1cm,
    fila/.style={align=center},
    etq/.style={anchor=west, font=\footnotesize\itshape}]

  % --- Reglas ---------------------------------------------------------------
  \draw[very thick] (0,0)      -- (14.4,0);
  \draw[thick]      (0,-0.70)  -- (14.4,-0.70);
  \draw[thin]       (0,-2.00)  -- (14.4,-2.00);
  \draw[thin]       (0,-3.30)  -- (14.4,-3.30);
  \draw[very thick] (0,-4.60)  -- (14.4,-4.60);
  \draw[thin]       (2.4,0)    -- (2.4,-4.60);
  \draw[thin]       (8.4,0)    -- (8.4,-4.60);

  % --- Cabecera -------------------------------------------------------------
  \node[font=\footnotesize\bfseries] at (5.4,-0.35)  {La frontera fiscal};
  \node[font=\footnotesize\bfseries] at (11.4,-0.35) {La frontera monetaria};

  % --- Separa: el recuadro partido por la línea interrumpida ----------------
  \node[etq] at (0.10,-1.35) {Separa};

  \draw[thick] (3.0,-0.925) rectangle (7.8,-1.775);
  \draw[thick] (5.4,-0.925) -- (5.4,-1.16);
  \draw[thick] (5.4,-1.54)  -- (5.4,-1.775);
  \node at (4.2,-1.35) {demanda};
  \node at (6.6,-1.35) {oferta};

  \draw[thick] (9.0,-0.925) rectangle (13.8,-1.775);
  \draw[thick] (11.4,-0.925) -- (11.4,-1.16);
  \draw[thick] (11.4,-1.54)  -- (11.4,-1.775);
  \node at (10.2,-1.35) {estabilización};
  \node at (12.6,-1.35) {distribución};

  % --- Permite --------------------------------------------------------------
  \node[etq] at (0.10,-2.65) {Permite};
  \node[fila] at (5.4,-2.65)  {tratar el nivel potencial\\ como un dato};
  \node[fila] at (11.4,-2.65) {repartir las funciones entre\\ una autoridad técnica y otra política};

  % --- La rompe -------------------------------------------------------------
  \node[etq] at (0.10,-3.95) {La rompe};
  \node[fila] at (5.4,-3.95)  {la histéresis, y el componente de oferta\\ de la inversión pública};
  \node[fila] at (11.4,-3.95) {que cuatro quintas partes\\ de la transmisión sean renta laboral};

  % --- Lo que resulta de las dos --------------------------------------------
  \draw[->] (5.4,-4.70)  -- (6.5,-5.15);
  \draw[->] (11.4,-4.70) -- (7.9,-5.15);
  \node[fila, font=\footnotesize\bfseries] at (7.2,-5.55)
    {Las dos particiones sobre las que descansa el reparto de papeles\\ son aproximaciones, no propiedades};

\end{tikzpicture}
