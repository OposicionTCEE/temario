% Los dos canales distributivos de una relajación monetaria, que empujan en sentidos opuestos.
% Esquema abstracto para el cuerpo; el detalle de los cuatro canales está en el anexo (anx2_canales).
\begin{tikzpicture}[>=stealth, font=\footnotesize, x=1cm, y=1cm,
    caja/.style={draw, thick, minimum width=4.6cm, minimum height=1.0cm, align=center, inner sep=3pt},
    orig/.style={draw, very thick, minimum width=4.6cm, minimum height=0.8cm, align=center, inner sep=3pt},
    fin/.style={draw, very thick, minimum width=10.6cm, minimum height=0.8cm, align=center, inner sep=3pt}]

  % --- Origen ---------------------------------------------------------------
  \node[orig] (m) at (2.65,0) {\textbf{Relajación monetaria}};

  % --- Los dos canales ------------------------------------------------------
  \node[caja] (l) at (-0.35,-1.75) {\textbf{Renta laboral}\\ más demanda, empleo y salarios};
  \node[caja] (a) at (5.65,-1.75) {\textbf{Activos}\\ revaluación y crédito más fácil};

  \draw[->, thick] (1.55,-0.42) -- (0.30,-1.23);
  \draw[->, thick] (3.75,-0.42) -- (5.00,-1.23);

  % --- A quién favorece cada uno -------------------------------------------
  \node[caja] (l2) at (-0.35,-3.45) {favorece al hogar \textbf{sin}\\ riqueza líquida};
  \node[caja] (a2) at (5.65,-3.45) {favorece a quien \textbf{tiene}\\ activos y colateral};
  \draw[->, thick] (-0.35,-2.27) -- (-0.35,-2.93);
  \draw[->, thick] (5.65,-2.27) -- (5.65,-2.93);

  % --- Cierre ---------------------------------------------------------------
  \node[fin] (s) at (2.65,-5.0) {\textbf{Signo neto sobre la desigualdad: no establecido}};
  \draw[->, thick] (-0.35,-3.97) -- (0.90,-4.58);
  \draw[->, thick] (5.65,-3.97) -- (4.40,-4.58);

\end{tikzpicture}
