\begin{tikzpicture}[font=\footnotesize, x=1cm, y=1cm]

  % --- Reglas ---------------------------------------------------------------
  \draw[very thick] (0,0)     -- (14,0);
  \draw[thick]      (0,-0.70) -- (14,-0.70);
  \draw[very thick] (0,-3.70) -- (14,-3.70);

  % --- Cabecera -------------------------------------------------------------
  \node[anchor=west] at (0.10,-0.35) {\textbf{Canal}};
  \node[anchor=west] at (3.70,-0.35) {\textbf{Efecto de una relajación monetaria}};

  % --- Filas ----------------------------------------------------------------
  \node[anchor=west] at (0.10,-1.075) {Renta laboral};
  \node[anchor=west] at (3.70,-1.075) {Suben el empleo y el salario $\Rightarrow$ gana el hogar restringido};

  \node[anchor=west] at (0.10,-1.825) {Precios de los activos};
  \node[anchor=west] at (3.70,-1.825) {Se revalorizan bonos y acciones $\Rightarrow$ gana quien los posee};

  \node[anchor=west] at (0.10,-2.575) {Posición nominal neta};
  \node[anchor=west] at (3.70,-2.575) {La inflación no esperada $\Rightarrow$ gana el deudor nominal, y el mayor es el Estado};

  \node[anchor=west] at (0.10,-3.325) {Remuneración del ahorro};
  \node[anchor=west] at (3.70,-3.325) {Cae el rendimiento del depósito $\Rightarrow$ pierde el ahorrador sin activos largos};

\end{tikzpicture}
