\begin{tikzpicture}[>=stealth, font=\footnotesize, x=1cm, y=1cm,
    caja/.style={draw, very thick, minimum height=1.1cm, align=center, inner sep=4pt}]

  % --- Bloques --------------------------------------------------------------
  \node[caja, minimum width=3.4cm] (pm) at (1.0,2.6) {\textbf{Política monetaria}\\ regla de TAYLOR: $\varphi_{\pi}$};
  \node[caja, minimum width=3.4cm] (pf) at (7.0,2.6) {\textbf{Política fiscal}\\ gasto $\hat{G}_{t}$ y regla $\psi$};
  \node[caja, minimum width=9.4cm] (ec) at (4.0,0)   {\textbf{Economía privada}\\ demanda (IS) y oferta (Phillips)};

  % --- Enlaces de la política monetaria -------------------------------------
  \draw[->, very thick] (0.2,2.05) -- (0.2,0.55);
  \node[anchor=east] at (0.12,1.30) {$i_{t}$};
  \draw[->, very thick] (1.8,0.55) -- (1.8,2.05);
  \node[anchor=west] at (1.88,1.30) {$\pi_{t}$, $x_{t}$};

  % --- Enlaces de la política fiscal ----------------------------------------
  \draw[->, very thick] (6.2,2.05) -- (6.2,0.55);
  \node[anchor=east] at (6.12,1.30) {$\hat{G}_{t}$};
  \draw[->, very thick] (7.8,0.55) -- (7.8,2.05);
  \node[anchor=west] at (7.88,1.30) {$s_{t}$};

  % --- El punto en que se tocan las dos políticas ---------------------------
  \draw[<->, very thick] (2.75,2.6) -- (5.25,2.6);
  \node[anchor=south] at (4.0,2.68) {$r-g$};

\end{tikzpicture}
