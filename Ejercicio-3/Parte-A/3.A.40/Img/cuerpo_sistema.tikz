\begin{tikzpicture}[>=stealth, font=\footnotesize, x=1cm, y=1cm,
    caja/.style={draw, very thick, minimum width=4.2cm, minimum height=1.1cm, align=center, inner sep=4pt}]

  % --- Bloques --------------------------------------------------------------
  \node[caja] (pm) at (0,2.6)   {\textbf{Política monetaria}\\ regla de TAYLOR: $\varphi_{\pi}$};
  \node[caja] (pf) at (7.2,2.6) {\textbf{Política fiscal}\\ gasto $\hat{G}_{t}$ y regla $\psi$};
  \node[caja, minimum width=5.6cm] (ec) at (3.6,0) {\textbf{Economía privada}\\ demanda (IS) y oferta (Phillips)};

  % --- Enlaces con la economía ---------------------------------------------
  \draw[->, very thick] (-0.9,2.05) -- (-0.9,0.55) -- (0.9,0.55);
  \node[anchor=east] at (-0.95,1.30) {$i_{t}$};
  \draw[->, very thick] (8.1,2.05) -- (8.1,0.55) -- (6.3,0.55);
  \node[anchor=west] at (8.15,1.30) {$\hat{G}_{t}$};
  \draw[->, very thick] (0.9,-0.55) -- (-0.9,-0.55) -- (-0.9,2.05);
  \node[anchor=north] at (0.0,-0.60) {$\pi_{t}$, $x_{t}$};
  \draw[->, very thick] (6.3,-0.55) -- (8.1,-0.55) -- (8.1,2.05);
  \node[anchor=north] at (7.2,-0.60) {$s_{t}$};

  % --- El punto en que se tocan las dos políticas ---------------------------
  \draw[<->, very thick] (pm) -- (pf);
  \node[anchor=south] at (3.6,2.70) {$r-g$};
  \node[anchor=north] at (3.6,2.50) {dinámica de la deuda};

\end{tikzpicture}
