\begin{tikzpicture}[>=stealth, font=\footnotesize, x=1cm, y=1cm,
    caja/.style={draw, very thick, minimum height=0.95cm, align=center, inner sep=4pt}]

  % --- Bloques --------------------------------------------------------------
  \node[caja, minimum width=3.0cm] (pm) at (0.9,1.95) {\textbf{Política monetaria}\\ regla de TAYLOR: $\varphi_{\pi}$};
  \node[caja, minimum width=3.0cm] (pf) at (6.3,1.95) {\textbf{Política fiscal}\\ gasto $\hat{G}_{t}$ y regla $\psi$};
  \node[caja, minimum width=8.4cm] (ec) at (3.6,0)   {\textbf{Economía privada}\\ demanda (IS) y oferta (Phillips)};

  % --- Enlaces de la política monetaria -------------------------------------
  \draw[->, very thick] (0.15,1.47) -- (0.15,0.50);
  \node[anchor=east] at (0.07,0.98) {$i_{t}$};
  \draw[->, very thick] (1.65,0.50) -- (1.65,1.47);
  \node[anchor=west] at (1.73,0.98) {$\pi_{t}$, $x_{t}$};

  % --- Enlaces de la política fiscal ----------------------------------------
  \draw[->, very thick] (5.55,1.47) -- (5.55,0.50);
  \node[anchor=east] at (5.47,0.98) {$\hat{G}_{t}$};
  \draw[->, very thick] (7.05,0.50) -- (7.05,1.47);
  \node[anchor=west] at (7.13,0.98) {$s_{t}$};

  % --- El punto en que se tocan las dos políticas ---------------------------
