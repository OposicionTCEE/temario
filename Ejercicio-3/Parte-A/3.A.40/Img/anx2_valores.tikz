\begin{tikzpicture}[>=stealth, font=\footnotesize, x=2.6cm, y=0.66cm]

  % --- Referencia de la unidad ----------------------------------------------
  \draw[dashed] (1,0.6) -- (1,-7.2);

  % --- Eje horizontal -------------------------------------------------------
  \draw[->] (0,-7.2) -- (3.15,-7.2);
  \foreach \x in {0,0.5,1,1.5,2,2.5,3} \draw (\x,-7.2) -- (\x,-7.34);
  \node[anchor=north] at (0,-7.42) {$0$};
  \node[anchor=north] at (1,-7.42) {$1$};
  \node[anchor=north] at (2,-7.42) {$2$};
  \node[anchor=north] at (3,-7.42) {$3$};

  % --- Filas ----------------------------------------------------------------
  \node[anchor=east] at (-0.03,0)  {Tipo de cambio flexible (ILZETZKI et al.)};
  \fill (0,0) circle (2.2pt);

  \node[anchor=east] at (-0.03,-1) {En expansión (AUERBACH y GORODNICHENKO)};
  \fill (0,-1) circle (2.2pt);

  \node[anchor=east] at (-0.03,-2) {Supuesto de los programas de 2010 (BLANCHARD y LEIGH)};
  \fill (0.5,-2) circle (2.2pt);

  \node[anchor=east] at (-0.03,-3) {Media de los regímenes, gasto (RAMEY)};
  \draw[line width=2.6pt] (0.6,-3) -- (1.0,-3);

  \node[anchor=east] at (-0.03,-4) {Años treinta, suelo de tipos (ALMUNIA et al.)};
  \fill (1.6,-4) circle (2.2pt);

  \node[anchor=east] at (-0.03,-5) {Sin respuesta monetaria (CHODOROW-REICH)};
  \fill (1.7,-5) circle (2.2pt);
  \draw[->, thick] (1.74,-5) -- (2.15,-5);

  \node[anchor=east] at (-0.03,-6) {En recesión (AUERBACH y GORODNICHENKO)};
  \fill (2.5,-6) circle (2.2pt);

\end{tikzpicture}
