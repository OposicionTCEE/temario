\begin{tikzpicture}[>=stealth, font=\footnotesize, x=1cm, y=1cm,
    gen/.style={draw, thick, minimum width=1.9cm, minimum height=0.6cm, inner sep=3pt}]

  % --- Nodos por periodo ----------------------------------------------------
  \node[gen] (j0) at (0,2.2)  {Jóvenes};
  \node[gen] (m0) at (0,0)    {Mayores};
  \node[gen] (j1) at (4,2.2)  {Jóvenes};
  \node[gen] (m1) at (4,0)    {Mayores};
  \node[gen] (j2) at (8,2.2)  {Jóvenes};
  \node[gen] (m2) at (8,0)    {Mayores};

  % --- Transferencia dentro de cada periodo ---------------------------------
  \draw[->, very thick] (j0) -- (m0);
  \draw[->, very thick] (j1) -- (m1);
  \draw[->, very thick] (j2) -- (m2);
  \node[anchor=west] at (0.25,1.1) {transferencia};

  % --- La misma generación envejece -----------------------------------------
  \draw[->, dotted, thick] (j0) -- (m1);
  \draw[->, dotted, thick] (j1) -- (m2);
  \node[anchor=south, align=center] at (2.6,0.55) {la misma\\ generación};

  % --- El mercado que falta -------------------------------------------------
  \draw[dashed] (j0) -- (j1);
  \draw[very thick] (1.85,2.45) -- (2.15,1.95);
  \draw[very thick] (1.85,1.95) -- (2.15,2.45);
  \node[anchor=south] at (2.0,2.55) {mercado que falta};

  % --- Eje de tiempo --------------------------------------------------------
  \draw[->] (-1.4,-0.95) -- (9.6,-0.95);
  \node[anchor=west] at (9.7,-0.95) {tiempo};
  \foreach \x/\t in {0/{$t$}, 4/{$t+1$}, 8/{$t+2$}} {
    \draw (\x,-0.88) -- (\x,-1.02);
    \node[anchor=north] at (\x,-1.08) {\t};
  }

\end{tikzpicture}
