% Base canónica del modelo de generaciones solapadas, adaptada de reparto_mgs del 3.A.29:
% plano (consumo de joven, consumo de mayor), recta de asignaciones estacionarias factibles
% y curva de indiferencia por la dotación. Aquí solo el problema: la autarquía E y el tramo
% de asignaciones factibles que TODAS las generaciones prefieren. La solución, en la figura siguiente.
% Dotaciones e^J = 3,5 y e^V = 0,8; recta c^J + c^V = 4,3; u^E: c^V = 2,8/c^J, que corta la recta en E y en (0,8 ; 3,5).
\begin{tikzpicture}[xscale=1.70,yscale=1.35,font=\footnotesize]

  \draw[->,thick] (0,0) -- (5.0,0) node[right] {$c^{J}$};
  \draw[->,thick] (0,0) -- (0,5.0) node[above] {$c^{V}$};

  % ---- recta de asignaciones estacionarias factibles ----
  \draw[very thick] (0,4.3) -- (4.3,0);
  \node[align=center] at (3.95,3.30) {asignaciones factibles\\pendiente $-(1+n)$};
  \draw[gray,thin] (3.30,2.90) -- (2.45,1.95);

  % ---- tramo preferido a la autarquía ----
  \draw[line width=2.4pt,black!35] (0.80,3.50) -- (3.50,0.80);
  \draw[very thick] (0,4.3) -- (4.3,0);
  \node[align=center] at (1.05,1.35) {todas las generaciones\\lo prefieren a $E$};
  \draw[gray,thin] (1.55,1.72) -- (2.00,2.30);

  % ---- curva de indiferencia por la dotación ----
  \draw[very thick,dash pattern=on 4pt off 2pt,domain=0.62:4.70,samples=120,smooth,variable=\x]
       plot ({\x},{2.8/\x});
  \node[below right] at (4.55,{2.8/4.55+0.06}) {$u^{E}$};

  % ---- la dotación ----
  \node[circle,fill,inner sep=1.5pt] at (3.5,0.8) {};
  \node[below right] at (3.54,0.78) {$E$};
  \draw[dotted,gray] (3.5,0) -- (3.5,0.8);
  \draw[dotted,gray] (0,0.8) -- (3.5,0.8);
  \node[below] at (3.5,-0.1) {$e^{J}$};
  \node[left] at (0,0.8) {$e^{V}$};
  \node[circle,draw,inner sep=1.3pt] at (0.80,3.50) {};

\end{tikzpicture}
