% Concepción promotora: mover el propio producto potencial. Mitad del antiguo cuerpo_potencial.
\begin{tikzpicture}[>=stealth, font=\footnotesize, x=1cm, y=1cm]

  % --- Ejes -----------------------------------------------------------------
  \draw[->] (0,0) -- (11.4,0);
  \node[anchor=west] at (11.5,0) {tiempo};
  \draw[->] (0,0) -- (0,4.6);
  \node[anchor=south west] at (0,4.65) {producto};

  % --- Producto potencial de partida ---------------------------------------
  \draw[very thick] (0.4,1.30) -- (9.8,3.40);
  \node[anchor=west] at (9.9,3.40) {$Y^{*}_{0}$};

  % --- Producto potencial tras la actuación --------------------------------
  \draw[very thick] (4.0,2.10) .. controls (6.0,2.90) and (7.8,3.60) .. (9.8,4.30);
  \node[anchor=west] at (9.9,4.30) {$Y^{*}_{1}$};

  % --- Lo que se mueve ------------------------------------------------------
  \draw[->, thick] (7.6,3.02) -- (7.6,3.82);
  \node[anchor=west] at (7.75,3.42) {promover};

  % --- El punto en que la senda se separa -----------------------------------
  \fill (4.0,2.10) circle (2pt);
  \draw[densely dotted] (4.0,2.10) -- (4.0,0);
  \node[anchor=north] at (4.0,-0.05) {actuación};

\end{tikzpicture}
