\begin{tikzpicture}[font=\footnotesize,
    celda/.style={draw, very thick, minimum width=4.4cm, minimum height=1.9cm, align=center, inner sep=5pt},
    cab/.style={align=center}]

  % --- Celdas ---------------------------------------------------------------
  \node[celda] (a) at (0,0)      {$\left(3\,,\,3\right)$\\[3pt] Ambas pasivas:\\ nada ancla los precios};
  \node[celda] (b) at (4.5,0)    {$\left(\underline{2}\,,\,\underline{4}\right)$\\[3pt] \textbf{Dominancia fiscal}};
  \node[celda] (c) at (0,-2.0)   {$\left(\underline{4}\,,\,\underline{2}\right)$\\[3pt] \textbf{Dominancia monetaria}};
  \node[celda] (d) at (4.5,-2.0) {$\left(1\,,\,1\right)$\\[3pt] Ambas activas:\\ ni equilibrio ni ancla};

  % --- Cabeceras de columna -------------------------------------------------
  \node[cab] at (0,1.25)   {\textbf{Fiscal cede}\\ (pasiva)};
  \node[cab] at (4.5,1.25) {\textbf{Fiscal no cede}\\ (activa)};

  % --- Cabeceras de fila ----------------------------------------------------
  \node[cab, anchor=east] at (-2.45,0)    {\textbf{Monetaria cede}\\ (pasiva)};
  \node[cab, anchor=east] at (-2.45,-2.0) {\textbf{Monetaria no cede}\\ (activa)};

  % --- Lectura de los pagos -------------------------------------------------
  \node[cab, anchor=east] at (-2.45,1.25) {\textit{(pago monetaria,}\\ \textit{pago fiscal)}};

\end{tikzpicture}
