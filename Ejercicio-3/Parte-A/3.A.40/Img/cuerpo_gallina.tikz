% Forma normal del juego de la cesión, al estilo de JE_forma_normal del 3.A.14: pagos ordinales en letras,
% subrayada la mejor respuesta de cada autoridad. Cada casilla lleva, en pequeño, el régimen que le corresponde.
% Primer pago, autoridad monetaria; segundo, autoridad fiscal.
\begin{tikzpicture}[font=\footnotesize, line cap=round,
    jug/.style={font=\footnotesize\bfseries},
    acc/.style={font=\footnotesize\itshape},
    reg/.style={font=\scriptsize}]

  % --- Bandas ---------------------------------------------------------------
  \fill[black!8] (0,0.15) rectangle (9.0,-0.95);
  \fill[black!8] (0,-0.95) rectangle (2.2,-3.15);

  % --- Reglas ---------------------------------------------------------------
  \draw[line width=0.5pt] (2.2,0.15) -- (9.0,0.15);
  \draw[line width=0.5pt] (2.2,-0.40) -- (9.0,-0.40);
  \draw[line width=0.5pt] (0,-0.95) -- (9.0,-0.95);
  \draw[line width=0.5pt] (0.6,-2.05) -- (9.0,-2.05);
  \draw[line width=0.5pt] (0,-3.15) -- (9.0,-3.15);
  \draw[line width=0.5pt] (0,-0.95) -- (0,-3.15);
  \draw[line width=0.5pt] (0.6,-0.95) -- (0.6,-3.15);
  \draw[line width=0.5pt] (2.2,0.15) -- (2.2,-3.15);
  \draw[line width=0.5pt] (5.6,-0.40) -- (5.6,-3.15);
  \draw[line width=0.5pt] (9.0,0.15) -- (9.0,-3.15);

  % --- Cabeceras ------------------------------------------------------------
  \node[jug] at (5.6,-0.125) {Autoridad fiscal};
  \node[acc] at (3.9,-0.675) {Cede};
  \node[acc] at (7.3,-0.675) {No cede};
  \node[jug, rotate=90] at (0.3,-2.05) {Aut. monetaria};
  \node[acc] at (1.4,-1.50) {Cede};
  \node[acc] at (1.4,-2.60) {No cede};

  % --- Casillas -------------------------------------------------------------
  \node[align=center] at (3.9,-1.50) {$\left(a_{M}\,,\,a_{F}\right)$\\[1pt] {\scriptsize ambas pasivas}};
  \node[align=center] at (7.3,-1.50) {$\left(\underline{b_{M}}\,,\,\underline{b_{F}}\right)$\\[1pt] {\scriptsize dominancia fiscal}};
  \node[align=center] at (3.9,-2.60) {$\left(\underline{c_{M}}\,,\,\underline{c_{F}}\right)$\\[1pt] {\scriptsize dominancia monetaria}};
  \node[align=center] at (7.3,-2.60) {$\left(d_{M}\,,\,d_{F}\right)$\\[1pt] {\scriptsize ambas activas}};

\end{tikzpicture}
