% Mismo plano canónico que cuerpo_expulsion: brecha en horizontal, inflación en vertical, curvas IS y CP,
% y los ejes cruzándose en el origen (el eje horizontal ES la línea de inflación nula).
% Diferencia: la IS queda QUEBRADA, con pendiente negativa mientras la regla opera y POSITIVA por debajo
% del nivel de inflación en que el suelo muerde (allí el tipo real se mueve al revés que la inflación).
% Toda la escena está en el tercer cuadrante porque el episodio del suelo es de brecha negativa y deflación.
% Calibración: CP pi = 0,5x; tramo con suelo de la IS, pendiente 2,0; quiebro en pi = 0,30; Ghat = 1,0.
% E_0 = (-1,6 ; -0,8); E_1 = (-0,267 ; -0,133); multiplicador 1,333/1,0 = 1,33.
\begin{tikzpicture}[>=stealth, font=\footnotesize, x=3.9cm, y=2.5cm]

  % --- Ejes -----------------------------------------------------------------
  \draw[->] (-2.05,0) -- (0.60,0);
  \node[anchor=west] at (0.62,0) {$x$};
  \draw[->] (0,-1.15) -- (0,0.95);
  \node[anchor=south] at (0,0.96) {$\pi$};

  % --- Curva de PHILLIPS ----------------------------------------------------
  \draw[very thick] (-2.00,-1.00) -- (0.45,0.225);
  \node[anchor=west] at (0.47,0.225) {$CP$};

  % --- Demanda quebrada -----------------------------------------------------
  \draw[very thick, dashed] (-1.75,-1.10) -- (-1.05,0.30) -- (-1.58,0.83);
  \node[anchor=south east] at (-1.56,0.85) {$IS_{0}$};
  \draw[very thick, dashed] (-0.75,-1.10) -- (-0.05,0.30) -- (-0.58,0.83);
  \node[anchor=south west] at (-0.56,0.85) {$IS_{1}$};

  % --- Los dos tramos -------------------------------------------------------
  \node[anchor=east] at (-1.46,0.62) {$i>\underline{i}$};
  \node[anchor=west] at (-1.38,-0.52) {$i=\underline{i}$};

  % --- Equilibrios ----------------------------------------------------------
  \fill (-1.60,-0.80) circle (1.8pt);
  \node[anchor=south east] at (-1.66,-0.74) {$E_{0}$};
  \fill (-0.2667,-0.1333) circle (1.8pt);
  \node[anchor=north west] at (-0.21,-0.16) {$E_{1}$};
  \draw (-0.60,-0.80) circle (1.8pt);

  % --- Proyecciones ---------------------------------------------------------
  \draw[densely dotted] (-1.60,-0.80) -- (-1.60,-1.30);
  \draw[densely dotted] (-0.60,-0.80) -- (-0.60,-1.30);
  \draw[densely dotted] (-0.2667,-0.1333) -- (-0.2667,-1.30);

  % --- La medida: el impulso y lo que de él resulta -------------------------
  \draw[<->, thick] (-1.60,-1.30) -- (-0.2667,-1.30);
  \draw[thick] (-0.60,-1.26) -- (-0.60,-1.34);
  \node[anchor=north] at (-1.10,-1.33) {$\hat{G}$};
  \node[anchor=north] at (-0.433,-1.33) {arrastre};
  \node at (-0.933,-1.18) {$\Delta x$};

\end{tikzpicture}
