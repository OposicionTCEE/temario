\begin{tikzpicture}[>=stealth, font=\footnotesize, x=2.2cm, y=1.6cm]

  % --- Ejes -----------------------------------------------------------------
  \draw[->] (3.00,-1.55) -- (7.30,-1.55);
  \node[anchor=west] at (7.35,-1.55) {$Y$};
  \draw[->] (3.00,-1.55) -- (3.00,1.45);
  \node[anchor=south] at (3.00,1.50) {$\pi$};

  % --- Inflacion nula y producto natural ------------------------------------
  \draw[dashed] (3.00,0.25) -- (6.45,0.25);
  \node[anchor=east] at (2.96,0.25) {$\pi=0$};
  \draw[dotted] (6.333,0.25) -- (6.333,-1.55);
  \node[anchor=north] at (6.36,-1.59) {$Y^{n}$};

  % --- Oferta agregada ------------------------------------------------------
  \draw[very thick] (3.60,-0.98) -- (7.00,0.55);
  \node[anchor=west] at (7.02,0.55) {$OA$};

  % --- Demanda agregada, quebrada en el suelo -------------------------------
  \draw[very thick, dashed] (3.682,-1.15) -- (5.227,0.55) -- (4.227,1.25);
  \node[anchor=south east] at (4.21,1.27) {$DA_{0}$};
  \draw[very thick, dashed] (4.682,-1.15) -- (6.227,0.55) -- (5.227,1.25);
  \node[anchor=south west] at (5.25,1.27) {$DA_{1}$};

  % --- Los dos tramos -------------------------------------------------------
  \node[anchor=east] at (4.70,0.65) {$i>\underline{i}$};
  \node[anchor=east] at (4.30,-0.25) {$i=\underline{i}$};

  % --- Desplazamiento: el impulso -------------------------------------------
  \draw[->, thick] (4.584,1.00) -- (5.584,1.00);
  \node[anchor=south] at (5.084,1.02) {$\hat{G}$};

  % --- Equilibrios ----------------------------------------------------------
  \fill (4.000,-0.800) circle (2pt);  \node[anchor=south east] at (3.96,-0.74) {$E_{0}$};
  \fill (5.692,-0.039) circle (2pt);  \node[anchor=south east] at (5.65,0.02) {$E_{1}$};

  % --- Proyecciones ---------------------------------------------------------
  \draw[dotted] (4.000,-0.800) -- (4.000,-1.55);
  \draw[dotted] (5.692,-0.039) -- (5.692,-1.55);
  \node[anchor=north] at (3.98,-1.59) {$Y_{0}$};
  \node[anchor=north] at (5.71,-1.59) {$Y_{1}$};
  \draw[<->, thick] (4.000,-1.42) -- (5.692,-1.42);

  % --- Precios --------------------------------------------------------------
  \draw[dotted] (4.000,-0.800) -- (3.00,-0.800);
  \draw[dotted] (5.692,-0.039) -- (3.00,-0.039);
  \node[anchor=east] at (2.96,-0.80) {$\pi_{0}$};
  \node[anchor=east] at (2.96,-0.04) {$\pi_{1}$};

\end{tikzpicture}
