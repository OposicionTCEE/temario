\begin{tikzpicture}[>=stealth, font=\footnotesize, x=1.25cm, y=1.05cm]

  % --- Ejes -----------------------------------------------------------------
  \draw[->] (0,0) -- (9.0,0);
  \node[anchor=west] at (9.1,0) {$N$};
  \draw[->] (0,0) -- (0,5.4);
  \node[anchor=south] at (0,5.5) {$w$};

  % --- Demanda de trabajo ---------------------------------------------------
  \draw[very thick] (1.0,4.60) -- (8.0,1.20);
  \node[anchor=west] at (8.0,1.20) {$N^{d}$};

  % --- Oferta de trabajo ----------------------------------------------------
  \draw[very thick, dashed] (1.5,1.00) -- (7.0,4.80);
  \node[anchor=south east] at (1.95,1.25) {$N^{s}_{0}$};
  \draw[very thick, dashed] (2.7,1.00) -- (8.2,4.80);
  \node[anchor=north west] at (3.05,1.15) {$N^{s}_{1}$};
  \draw[->, thick] (2.50,1.62) -- (3.45,1.62);

  % --- Equilibrios ----------------------------------------------------------
  \fill (4.35,2.97) circle (2pt);   \node[anchor=south east] at (4.28,3.04) {$E_{0}$};
  \fill (5.06,2.63) circle (2pt);   \node[anchor=west] at (5.14,2.70) {$E_{1}$};

  % --- Proyecciones ---------------------------------------------------------
