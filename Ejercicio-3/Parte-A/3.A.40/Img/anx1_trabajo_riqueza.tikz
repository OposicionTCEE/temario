  \draw[dotted] (5.06,2.63) -- (5.06,0);  \node[anchor=north] at (5.12,-0.06) {$N_{1}$};
  \draw[dotted] (4.35,2.97) -- (0,2.97);  \node[anchor=east] at (-0.05,3.02) {$w_{0}$};
  \draw[dotted] (5.06,2.63) -- (0,2.63);  \node[anchor=east] at (-0.05,2.56) {$w_{1}$};

\end{tikzpicture}
