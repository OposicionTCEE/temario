\begin{tikzpicture}[>=stealth, font=\footnotesize, x=1.15cm, y=1.45cm]

  % --- Ejes -----------------------------------------------------------------
  \draw[->] (0,-2) -- (9.3,-2);
  \node[anchor=west] at (9.4,-2) {$Y$};
  \draw[->] (0,-2) -- (0,1.6);
  \node[anchor=south] at (0,1.7) {$\pi$};

  % --- Linea de inflacion nula ----------------------------------------------
  \draw[dashed] (0,0) -- (8.3,0);
  \node[anchor=west] at (8.35,0) {$\pi=0$};

  % --- Oferta agregada ------------------------------------------------------
  \draw[very thick] (2.6,-1.755) -- (8.6,0.945);
  \node[anchor=west] at (8.62,0.945) {$OA$};

  % --- Demanda agregada, quebrada en el suelo -------------------------------
  \draw[very thick, dashed] (3.33,-1.75) -- (5.8,0.6) -- (4.657,1.4);
  \node[anchor=south east] at (4.64,1.42) {$DA_{0}$};
  \draw[very thick, dashed] (4.33,-1.75) -- (6.8,0.6) -- (5.657,1.4);
  \node[anchor=south west] at (5.68,1.42) {$DA_{1}$};
  \draw[->, thick] (5.35,1.00) -- (6.11,1.00);

  % --- Equilibrios ----------------------------------------------------------
  \fill (3.97,-1.14) circle (2pt);  \node[anchor=south east] at (3.90,-1.10) {$E_{0}$};
  \fill (5.87,-0.28) circle (2pt);  \node[anchor=west] at (5.97,-0.34) {$E_{1}$};

  % --- Proyecciones ---------------------------------------------------------
  \draw[dotted] (3.97,-1.14) -- (3.97,-2);  \node[anchor=north] at (3.97,-2.06) {$Y_{0}$};
  \draw[dotted] (5.87,-0.28) -- (5.87,-2);  \node[anchor=north] at (5.85,-2.06) {$Y_{1}$};
  \draw[dotted] (6.50,0) -- (6.50,-2);      \node[anchor=north] at (6.56,-2.06) {$Y^{n}$};
  \draw[dotted] (3.97,-1.14) -- (0,-1.14);  \node[anchor=east] at (-0.08,-1.14) {$\pi_{0}$};
  \draw[dotted] (5.87,-0.28) -- (0,-0.28);  \node[anchor=east] at (-0.08,-0.28) {$\pi_{1}$};

\end{tikzpicture}
