% Plano canónico de la NEK: brecha de producción en horizontal, inflación en vertical.
% IS = demanda con la REGLA MONETARIA ya sustituida dentro (por eso tiene pendiente negativa);
% CP = curva de PHILLIPS. Con phi_y = 0, el desplazamiento horizontal de la IS es exactamente Ghat.
% Cada recta se dibuja simétrica respecto de su propio anclaje (el origen, o el punto hueco).
% Calibración: CP pi = 0,75x; IS pendiente -1; Ghat = 0,84; IS_1' (regla más firme) pendiente -0,45.
% E_1 = (0,48 ; 0,36) -> multiplicador 0,57;  E_2 = (0,315 ; 0,236) -> multiplicador 0,38.
\begin{tikzpicture}[>=stealth, font=\footnotesize, x=3.6cm, y=2.4cm]

  % --- Ejes -----------------------------------------------------------------
  \draw[->] (-1.10,0) -- (1.82,0);
  \node[anchor=west] at (1.84,0) {$x$};
  \draw[->] (0,-0.84) -- (0,0.86);
  \node[anchor=south] at (0,0.87) {$\pi$};

  % --- Curva de PHILLIPS ----------------------------------------------------
  \draw[very thick] (-1.00,-0.75) -- (1.00,0.75);
  \node[anchor=west] at (1.02,0.75) {$CP$};

  % --- Demanda con la regla monetaria dentro --------------------------------
  \draw[very thick, dashed] (-0.62,0.62) -- (0.62,-0.62);
  \node[anchor=east] at (-0.64,0.63) {$IS_{0}$};
  \draw[very thick, dashed] (0.22,0.62) -- (1.46,-0.62);
  \node[anchor=west] at (0.24,0.63) {$IS_{1}$};
  \draw[very thick, dash pattern=on 5pt off 2pt on 1pt off 2pt] (0.06,0.351) -- (1.62,-0.351);
  \node[anchor=west] at (1.64,-0.351) {$IS_{1}'$};

  % --- El desplazamiento mide exactamente el programa -----------------------
  \draw[<->, thick] (-0.47,0.47) -- (0.37,0.47);
  \node[anchor=south] at (0.16,0.485) {$\hat{G}$};

  % --- Equilibrios ----------------------------------------------------------
  \fill (0,0) circle (1.8pt);
  \node[anchor=south east] at (-0.20,0.05) {$E_{0}$};
  \fill (0.48,0.36) circle (1.8pt);
  \node[anchor=west] at (0.62,0.30) {$E_{1}$};
  \fill (0.315,0.23625) circle (1.8pt);
  \node[anchor=south] at (0.30,0.33) {$E_{2}$};
  \draw (0.84,0) circle (1.8pt);

  % --- Proyecciones sobre el eje de la brecha -------------------------------
  \draw[densely dotted] (0.48,0.36) -- (0.48,-0.92);
  \node[anchor=north east] at (0.455,-0.02) {$x_{1}$};
  \draw[densely dotted] (0.84,0) -- (0.84,-0.92);

  % --- La medida: lo que llega y lo que el banco central retira -------------
  \draw[<->, thick] (0,-0.92) -- (0.84,-0.92);
  \draw[thick] (0.48,-0.88) -- (0.48,-0.96);
  \node[anchor=north] at (0.24,-0.95) {$\Delta x$};
  \node[anchor=north] at (0.66,-0.95) {expulsión};

\end{tikzpicture}
