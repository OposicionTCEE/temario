% Plano canónico de la NEK: brecha de producción en horizontal, inflación en vertical.
% IS = demanda con la REGLA MONETARIA ya sustituida dentro (por eso tiene pendiente negativa);
% CP = curva de PHILLIPS. Con phi_y = 0, el desplazamiento horizontal de la IS es exactamente Ghat.
% Cada recta se dibuja simétrica respecto de su propio anclaje (el origen, o el punto hueco).
% Calibración: CP pi = 0,75x; IS pendiente -1; Ghat = 0,84; IS_1' (regla más firme) pendiente -0,45.
% E_1 = (0,48 ; 0,36) -> multiplicador 0,57;  E_2 = (0,315 ; 0,236) -> multiplicador 0,38.
\begin{tikzpicture}[>=stealth, font=\footnotesize, x=3.6cm, y=2.4cm]

  % --- Ejes -----------------------------------------------------------------
  \draw[->] (-1.20,0) -- (1.95,0);
  \node[anchor=west] at (1.97,0) {$x$};
  \draw[->] (0,-0.95) -- (0,0.95);
  \node[anchor=south] at (0,0.96) {$\pi$};

  % --- Curva de PHILLIPS ----------------------------------------------------
  \draw[very thick] (-1.05,-0.7875) -- (1.05,0.7875);
  \node[anchor=west] at (1.07,0.7875) {$CP$};

  % --- Demanda con la regla monetaria dentro --------------------------------
  \draw[very thick, dashed] (-0.72,0.72) -- (0.72,-0.72);
  \node[anchor=east] at (-0.74,0.73) {$IS_{0}$};
  \draw[very thick, dashed] (0.12,0.72) -- (1.56,-0.72);
  \node[anchor=west] at (0.14,0.73) {$IS_{1}$};
  \draw[very thick, dash pattern=on 5pt off 2pt on 1pt off 2pt] (-0.06,0.405) -- (1.74,-0.405);
  \node[anchor=west] at (1.76,-0.405) {$IS_{1}'$};

  % --- El desplazamiento mide exactamente el programa -----------------------
  \draw[<->, thick] (-0.56,0.56) -- (0.28,0.56);
  \node[anchor=south] at (-0.14,0.575) {$\hat{G}$};

  % --- Equilibrios ----------------------------------------------------------
  \fill (0,0) circle (1.8pt);
  \node[anchor=north west] at (0.05,-0.26) {$E_{0}$};
  \fill (0.48,0.36) circle (1.8pt);
  \node[anchor=south] at (0.50,0.46) {$E_{1}$};
  \fill (0.315,0.23625) circle (1.8pt);
  \node[anchor=south] at (0.27,0.32) {$E_{2}$};
  \draw (0.84,0) circle (1.8pt);

  % --- Proyecciones sobre el eje de la brecha -------------------------------
  \draw[densely dotted] (0.48,0.36) -- (0.48,-1.05);
  \node[anchor=north east] at (0.46,-0.04) {$x_{1}$};
  \draw[densely dotted] (0.84,0) -- (0.84,-1.05);

  % --- La medida: lo que llega y lo que el banco central retira -------------
  \draw[<->, thick] (0,-1.05) -- (0.84,-1.05);
  \draw[thick] (0.48,-1.01) -- (0.48,-1.09);
  \node[anchor=north] at (0.24,-1.08) {$\Delta x$};
  \node[anchor=north] at (0.66,-1.08) {expulsión};

\end{tikzpicture}
