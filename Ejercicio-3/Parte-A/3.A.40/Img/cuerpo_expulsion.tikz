\begin{tikzpicture}[>=stealth, font=\footnotesize, x=2.2cm, y=1.6cm]

  % --- Ejes -----------------------------------------------------------------
  \draw[->] (2.6,-1.20) -- (7.30,-1.20);
  \node[anchor=west] at (7.35,-1.20) {$Y$};
  \draw[->] (2.60,-1.20) -- (2.60,1.45);
  \node[anchor=south] at (2.60,1.50) {$\pi$};

  % --- Oferta agregada ------------------------------------------------------
  \draw[very thick] (3.00,-0.36) -- (6.60,1.26);
  \node[anchor=west] at (6.62,1.26) {$OA$};

  % --- Demanda agregada -----------------------------------------------------
  \draw[very thick, dashed] (2.80,1.16) -- (5.80,-0.94);
  \node[anchor=north] at (5.80,-0.98) {$DA_{0}$};
  \draw[very thick, dashed] (4.00,1.16) -- (7.00,-0.94);
  \node[anchor=north] at (7.00,-0.98) {$DA_{1}$};

  % --- Desplazamiento: el impulso -------------------------------------------
  \draw[->, thick] (3.17,0.90) -- (4.37,0.90);
  \node[anchor=south] at (3.77,0.92) {$\hat{G}$};

  % --- Equilibrios ----------------------------------------------------------
  \fill (4.20,0.18) circle (2pt);  \node[anchor=north east] at (4.24,0.13) {$E_{0}$};
  \fill (4.93,0.51) circle (2pt);  \node[anchor=north west] at (4.97,0.47) {$E_{1}$};

  % --- Proyecciones ---------------------------------------------------------
  \draw[dotted] (4.20,0.18) -- (4.20,-1.20);
  \draw[dotted] (4.93,0.51) -- (4.93,-1.20);
  \node[anchor=north] at (4.18,-1.24) {$Y_{0}$};
  \node[anchor=north] at (4.97,-1.24) {$Y_{1}$};
  \draw[<->, thick] (4.20,-1.03) -- (4.93,-1.03);

  % --- Precios --------------------------------------------------------------
  \draw[dotted] (4.20,0.18) -- (2.60,0.18);
  \draw[dotted] (4.93,0.51) -- (2.60,0.51);
  \node[anchor=east] at (2.56,0.16) {$\pi_{0}$};
  \node[anchor=east] at (2.56,0.53) {$\pi_{1}$};

\end{tikzpicture}
