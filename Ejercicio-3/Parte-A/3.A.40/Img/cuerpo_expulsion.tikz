% Plano canónico de la NEK: brecha de producción en horizontal, inflación en vertical.
% IS = demanda con la REGLA MONETARIA ya sustituida dentro (por eso tiene pendiente negativa);
% CP = curva de PHILLIPS. Con phi_y = 0, el desplazamiento horizontal de la IS es exactamente Ghat,
% que es la abscisa del punto hueco (IS_0 pasa por el origen).
% Cada recta se dibuja a ambos lados de su propio anclaje (el origen, o el punto hueco).
% Calibración: CP pi = 0,75x; IS pendiente -1; Ghat = 0,84; IS_1' (regla más firme) pendiente -0,45.
% E_1 = (0,48 ; 0,36) -> multiplicador 0,57;  E_2 = (0,315 ; 0,236) -> multiplicador 0,38.
\begin{tikzpicture}[>=stealth, font=\footnotesize, x=3.6cm, y=2.4cm]

  % --- Ejes -----------------------------------------------------------------
  \draw[->] (-0.95,0) -- (1.70,0);
  \node[anchor=west] at (1.72,0) {$x$};
  \draw[->] (0,-0.70) -- (0,0.74);
  \node[anchor=south] at (0,0.75) {$\pi$};

  % --- Curva de PHILLIPS ----------------------------------------------------
  \draw[very thick] (-0.85,-0.6375) -- (0.85,0.6375);
  \node[anchor=west] at (0.87,0.6375) {$CP$};

  % --- Demanda con la regla monetaria dentro --------------------------------
  \draw[very thick, dashed] (-0.52,0.52) -- (0.52,-0.52);
  \node[anchor=east] at (-0.54,0.53) {$IS_{0}$};
  \draw[very thick, dashed] (0.32,0.52) -- (1.36,-0.52);
  \node[anchor=south east] at (0.30,0.54) {$IS_{1}$};
  \draw[very thick, dash pattern=on 5pt off 2pt on 1pt off 2pt] (0.14,0.315) -- (1.54,-0.315);
  \node[anchor=west] at (1.56,-0.315) {$IS_{1}'$};

  % --- Equilibrios ----------------------------------------------------------
  \fill (0,0) circle (1.8pt);
  \node[anchor=south east] at (-0.20,0.04) {$E_{0}$};
  \fill (0.48,0.36) circle (1.8pt);
  \node[anchor=south] at (0.50,0.47) {$E_{1}$};
  \fill (0.315,0.23625) circle (1.8pt);
  \node[anchor=south] at (0.28,0.31) {$E_{2}$};
  \draw (0.84,0) circle (1.8pt);
  \node[anchor=south west] at (0.87,0.02) {$\hat{G}$};

  % --- Proyecciones sobre el eje de la brecha -------------------------------
  \draw[densely dotted] (0.48,0.36) -- (0.48,-0.75);
  \node[anchor=north east] at (0.455,-0.02) {$x_{1}$};
  \draw[densely dotted] (0.84,0) -- (0.84,-0.75);

  % --- La medida: lo que llega y lo que el banco central retira -------------
  \draw[<->, thick] (0,-0.75) -- (0.84,-0.75);
  \draw[thick] (0.48,-0.71) -- (0.48,-0.79);
  \node[anchor=north] at (0.24,-0.78) {$\Delta x$};
  \node[anchor=north] at (0.66,-0.78) {expulsión};

\end{tikzpicture}
