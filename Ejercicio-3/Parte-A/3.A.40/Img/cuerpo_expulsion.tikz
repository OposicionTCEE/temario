% Plano canónico de la NEK: brecha de producción en horizontal, inflación en vertical.
% IS = demanda con la REGLA MONETARIA ya sustituida dentro (por eso tiene pendiente negativa);
% CP = curva de PHILLIPS. Con phi_y = 0, el desplazamiento horizontal de la IS es exactamente Ghat.
% Calibración: CP pi = 0,5x; IS_0 pendiente -1 por el origen; Ghat = 1,6; IS_1 pi = 1,6 - x;
% IS_1' (regla más firme) pendiente -0,45 por el mismo punto (1,6 ; 0).
% E_1 = (1,067 ; 0,533) -> multiplicador 0,67;  E_2 = (0,758 ; 0,379) -> multiplicador 0,47.
\begin{tikzpicture}[>=stealth, font=\footnotesize, x=3.0cm, y=2.6cm]

  % --- Ejes -----------------------------------------------------------------
  \draw[->] (-1.00,0) -- (2.50,0);
  \node[anchor=west] at (2.53,0) {$x$};
  \draw[->] (0,-0.52) -- (0,1.08);
  \node[anchor=south] at (0,1.10) {$\pi$};

  % --- Curva de PHILLIPS ----------------------------------------------------
  \draw[very thick] (-0.30,-0.15) -- (2.10,1.05);
  \node[anchor=west] at (2.12,1.05) {$CP$};

  % --- Demanda con la regla dentro ------------------------------------------
  \draw[very thick, dashed] (-0.90,0.90) -- (0.10,-0.10);
  \node[anchor=south east] at (-0.86,0.90) {$IS_{0}$};
  \draw[very thick, dashed] (0.70,0.90) -- (1.70,-0.10);
  \node[anchor=south west] at (0.74,0.90) {$IS_{1}$};
  \draw[very thick, dash pattern=on 5pt off 2pt on 1pt off 2pt] (0.30,0.585) -- (2.00,-0.18);
  \node[anchor=west] at (2.03,-0.18) {$IS_{1}'$};

  % --- Equilibrios ----------------------------------------------------------
  \fill (0,0) circle (1.8pt);
  \node[anchor=north west] at (0.05,-0.03) {$E_{0}$};
  \fill (1.0667,0.5333) circle (1.8pt);
  \node[anchor=west] at (1.13,0.555) {$E_{1}$};
  \fill (0.7579,0.3789) circle (1.8pt);
  \node[anchor=east] at (0.70,0.40) {$E_{2}$};
  \draw (1.60,0) circle (1.8pt);

  % --- Proyección del equilibrio nuevo --------------------------------------
  \draw[densely dotted] (1.0667,0.5333) -- (1.0667,-0.30);
  \draw[densely dotted] (1.60,0) -- (1.60,-0.30);

  % --- La medida: el impulso y lo que de él llega ---------------------------
  \draw[<->, thick] (0,-0.30) -- (1.60,-0.30);
  \draw[thick] (1.0667,-0.26) -- (1.0667,-0.34);
  \node[anchor=north] at (0.533,-0.33) {$\Delta x$};
  \node[anchor=north] at (1.333,-0.33) {expulsión};
  \node[anchor=west] at (1.66,-0.30) {$\hat{G}$};

\end{tikzpicture}
