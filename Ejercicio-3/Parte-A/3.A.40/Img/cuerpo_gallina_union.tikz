% Variante para un miembro de una unión monetaria: la fila superior se raya porque su autoridad
% monetaria es común y no cede ante un solo socio. Deriva de cuerpo_gallina: pagos ordinales en letras,
% las MISMAS para las dos autoridades, con a > b > c > d, y subrayada la mejor respuesta de cada una.
% Clave arriba a la derecha: primer pago, autoridad monetaria; segundo, autoridad fiscal.
\begin{tikzpicture}[font=\footnotesize, line cap=round,
    jug/.style={font=\footnotesize\bfseries},
    acc/.style={font=\footnotesize\itshape}]

  % --- Clave de lectura -----------------------------------------------------
  \node[anchor=south east, font=\scriptsize] at (9.0,0.24)
    {(pago de la monetaria, pago de la fiscal), con $a>b>c>d$};

  % --- Reglas ---------------------------------------------------------------
  \draw[line width=0.5pt] (2.2,0.15) -- (9.0,0.15);
  \draw[line width=0.5pt] (2.2,-0.40) -- (9.0,-0.40);
  \draw[line width=0.5pt] (0,-0.95) -- (9.0,-0.95);
  \draw[line width=0.5pt] (0.6,-2.05) -- (9.0,-2.05);
  \draw[line width=0.5pt] (0,-3.15) -- (9.0,-3.15);
  \draw[line width=0.5pt] (0,-0.95) -- (0,-3.15);
  \draw[line width=0.5pt] (0.6,-0.95) -- (0.6,-3.15);
  \draw[line width=0.5pt] (2.2,0.15) -- (2.2,-3.15);
  \draw[line width=0.5pt] (5.6,-0.40) -- (5.6,-3.15);
  \draw[line width=0.5pt] (9.0,0.15) -- (9.0,-3.15);

  % --- Cabeceras ------------------------------------------------------------
  \node[jug] at (5.6,-0.125) {Autoridad fiscal};
  \node[acc] at (3.9,-0.675) {Cede};
  \node[acc] at (7.3,-0.675) {No cede};
  \node[jug, rotate=90] at (0.3,-2.05) {Aut. monetaria};
  \node[acc] at (1.4,-1.50) {Cede};
  \node[acc] at (1.4,-2.60) {No cede};

  % --- La fila que no existe para un miembro de una unión --------------------
  \begin{scope}
    \clip (2.2,-0.95) rectangle (9.0,-2.05);
    \foreach \k in {-3,-2.7,...,10}{\draw[black!28, line width=0.5pt] (\k,-2.25) -- (\k+1.4,-0.75);}
  \end{scope}

  % --- Casillas -------------------------------------------------------------
  \node[align=center] at (3.9,-1.50) {$\left(b\,,\,b\right)$\\[1pt] {\scriptsize ambas pasivas}};
  \node[align=center] at (7.3,-1.50) {$\left(\underline{c}\,,\,\underline{a}\right)$\\[1pt] {\scriptsize dominancia fiscal}};
  \node[align=center] at (3.9,-2.60) {$\left(\underline{a}\,,\,\underline{c}\right)$\\[1pt] {\scriptsize dominancia monetaria}};
  \node[align=center] at (7.3,-2.60) {$\left(d\,,\,d\right)$\\[1pt] {\scriptsize ambas activas}};

\end{tikzpicture}
