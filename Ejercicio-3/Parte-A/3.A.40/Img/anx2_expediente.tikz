\begin{tikzpicture}[font=\scriptsize, x=0.72cm, y=1cm]

  % --- Etiquetas de fila ----------------------------------------------------
  \node[anchor=east] at (-0.25,2.90) {Monetaria};
  \node[anchor=east] at (-0.25,1.90) {Fiscal};
  \node[anchor=east] at (-0.25,0.90) {Combinación};

  % --- Fila monetaria -------------------------------------------------------
  \fill[black!15] (3.25,2.5) rectangle (3.95,3.3);
  \draw[thick] (0,2.5) rectangle (14,3.3);
  \draw[thick] (14,2.5) rectangle (17,3.3);
  \node at (7.0,2.90) {Expansiva};
  \node at (15.5,2.90) {Restrictiva};
  \draw (3.60,3.30) -- (3.60,3.52);
  \node[anchor=south] at (3.60,3.50) {Subidas de 2011};

  % --- Fila fiscal ----------------------------------------------------------
  \draw[thick] (0,1.5)  rectangle (2,2.3);   \node at (1.0,1.90) {Expansiva};
  \draw[thick] (2,1.5)  rectangle (6,2.3);   \node at (4.0,1.90) {Restrictiva};
  \draw[thick] (6,1.5)  rectangle (12,2.3);  \node at (9.0,1.90) {Neutral};
  \draw[thick] (12,1.5) rectangle (14,2.3);  \node at (13.0,1.90) {Expansiva};
  \draw[thick] (14,1.5) rectangle (17,2.3);  \node[align=center] at (15.5,1.90) {Expansiva\\(energía)};

  % --- Fila de la combinación -----------------------------------------------
  \draw[thick] (0,0.5)  rectangle (2,1.3);   \node at (1.0,0.90) {Coherente};
  \draw[thick] (2,0.5)  rectangle (6,1.3);   \node at (4.0,0.90) {Opuesta};
  \draw[thick] (6,0.5)  rectangle (12,1.3);  \node at (9.0,0.90) {Neutra};
  \draw[thick] (12,0.5) rectangle (14,1.3);  \node at (13.0,0.90) {Coherente};
  \draw[thick] (14,0.5) rectangle (17,1.3);  \node at (15.5,0.90) {Opuesta};

  % --- Fases ----------------------------------------------------------------
  \node[anchor=north, align=center] at (1.0,0.40)  {2008-09\\Estímulo};
  \node[anchor=north, align=center] at (4.0,0.40)  {2010-13\\Austeridad};
  \node[anchor=north, align=center] at (9.0,0.40)  {2014-19\\Normalización};
  \node[anchor=north, align=center] at (13.0,0.40) {2020-21\\Pandemia};
  \node[anchor=north, align=center] at (15.5,0.40) {2022-24\\Inflación};

\end{tikzpicture}
