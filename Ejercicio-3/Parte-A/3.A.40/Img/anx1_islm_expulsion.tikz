\begin{tikzpicture}[>=stealth, font=\footnotesize, x=1.25cm, y=1.05cm]

  % --- Ejes -----------------------------------------------------------------
  \draw[->] (0,0) -- (9.6,0);
  \node[anchor=west] at (9.7,0) {$Y$};
  \draw[->] (0,0) -- (0,5.7);
  \node[anchor=south] at (0,5.8) {$i$};

  % --- Curvas IS (paralelas, pendiente -2/3) --------------------------------
  \draw[very thick] (1.5,4.167) -- (7.5,0.167);
  \node[anchor=south east] at (1.75,4.10) {$IS_{0}$};
  \draw[very thick] (3.9,4.167) -- (8.9,0.833);
  \node[anchor=south west] at (3.95,4.12) {$IS_{1}$};
  \draw[->, thick] (6.15,1.15) -- (8.25,1.15);
  \node[anchor=north] at (7.20,1.10) {$\uparrow G$};

  % --- Curvas LM ------------------------------------------------------------
  \draw[very thick, dashed] (1.0,2.20) -- (8.9,2.99);
  \node[anchor=west] at (8.9,2.99) {$LM^{K}$};
  \draw[very thick, dash pattern=on 5pt off 2pt on 1pt off 2pt] (3.15,0.46) -- (5.30,5.62);
  \node[anchor=south] at (5.35,5.62) {$LM^{M}$};

  % --- Equilibrios ----------------------------------------------------------
  \fill (4.00,2.50) circle (2pt);   \node[anchor=north east] at (4.05,2.42) {$E_{0}$};
  \fill (6.40,2.50) circle (2pt);   \node[anchor=north west] at (6.46,2.46) {$E_{1}$};
  \fill (6.09,2.71) circle (2pt);   \node[anchor=south east] at (6.06,2.76) {$E_{2}$};
  \fill (4.52,3.75) circle (2pt);   \node[anchor=east] at (4.44,3.80) {$E_{3}$};

  % --- Proyecciones sobre el eje -------------------------------------------
  \draw[dotted] (4.00,2.50) -- (4.00,0);      \node[anchor=north] at (4.00,-0.06) {$Y_{0}$};
  \draw[dotted] (4.52,3.75) -- (4.52,-0.52);  \node[anchor=north] at (4.60,-0.52) {$Y_{3}$};
  \draw[dotted] (6.09,2.71) -- (6.09,-0.52);  \node[anchor=north] at (6.01,-0.52) {$Y_{2}$};
  \draw[dotted] (6.40,2.50) -- (6.40,0);      \node[anchor=north] at (6.46,-0.06) {$Y_{1}$};

  % --- Tipo de interes de partida ------------------------------------------
  \draw[dotted] (0,2.50) -- (4.00,2.50);      \node[anchor=east] at (-0.05,2.50) {$i_{0}$};

\end{tikzpicture}
