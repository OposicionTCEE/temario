\begin{tikzpicture}[>=stealth, font=\footnotesize]

  % --- Regiones -------------------------------------------------------------
  \fill[black!5]  (0,0) rectangle (4.2,5.2);
  \fill[black!14] (4.2,0) rectangle (8.4,5.2);
  \fill[black!28] (8.4,0) rectangle (11.4,5.2);

  % --- Ejes -----------------------------------------------------------------
  \draw[->] (0,0) -- (12.2,0);
  \node[anchor=west] at (12.3,0) {Deuda, $b$};
  \draw[->] (0,0) -- (0,5.7);
  \node[anchor=south west] at (0,5.75) {Prima de riesgo, $\varrho$};

  % --- Umbrales -------------------------------------------------------------
  \draw[dashed] (4.2,0) -- (4.2,5.2);
  \draw[dashed] (8.4,0) -- (8.4,5.2);
  \node[anchor=north] at (4.2,-0.08) {$\underline{b}$};
  \node[anchor=north] at (8.4,-0.08) {$\bar{b}$};

  % --- Rama de equilibrio bueno --------------------------------------------
  \draw[very thick] (0,0.45) .. controls (3,0.65) and (6,1.00) .. (8.4,1.55);
  \node[anchor=south] at (7.0,1.20) {$E^{g}$};

  % --- Rama de equilibrio malo ---------------------------------------------
  \draw[very thick] (4.2,3.05) .. controls (6,3.70) and (7.2,4.15) .. (8.4,4.80);
  \fill (4.2,3.05) circle (1.7pt);
  \node[anchor=west] at (4.35,2.80) {$E^{m}$};

  % --- Cierre del mercado en b barra ---------------------------------------
  \draw[very thick] (8.4,1.55) -- (8.4,4.80);

  % --- Indeterminacion entre ramas -----------------------------------------
  \draw[<->, thick] (6.3,1.40) -- (6.3,3.85);

  % --- Rotulos de region ----------------------------------------------------
  \node[anchor=north] at (2.1,5.15) {equilibrio único};
  \node[anchor=north] at (6.3,5.15) {zona de crisis};
  \node[anchor=north] at (9.9,5.15) {impago};

  % --- Efecto del respaldo --------------------------------------------------
  \draw[->, thick, dash pattern=on 3pt off 2pt] (4.2,-0.95) -- (6.9,-0.95);
  \node[anchor=west] at (7.0,-0.95) {$\underline{b}\,'$};
  \node[anchor=north] at (5.55,-1.05) {respaldo};

\end{tikzpicture}
