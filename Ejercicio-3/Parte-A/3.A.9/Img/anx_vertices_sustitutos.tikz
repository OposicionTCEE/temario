% Figura (Anexo I, «Tramos rectos y vértices»): sustitutos perfectos. Un tramo recto en las preferencias es un vértice en el gasto.
% Sustituye, con anx_vertices_complementarios, a anx_vertices.
% (a) u = x_1 + x_2, U = 3: curva de indiferencia recta x_1 + x_2 = 3 (gruesa). Con p_1 < p_2 (pendiente -1/2) la recta de gasto
%     mínimo, x_2 = 1,5 - 0,5 x_1, toca solo en (3; 0); con p_1 > p_2 (pendiente -2), x_2 = 3 - 2 x_1... en (0; 3); con p_1 = p_2,
%     la recta de gasto mínimo es la propia curva y todas sus cestas son óptimas: se marcan (3; 0), (1,5; 1,5) y (0; 3).
% (b) Gasto con p_2 = 1: E = U min(p_1, p_2) = 3 p_1 si p_1 <= 1 y 3 si p_1 >= 1 (gruesa), con un vértice en p_1 = p_2. Rectas finas:
%     consumidores pasivos de las tres cestas marcadas, E = 3 p_1, E = 1,5 p_1 + 1,5 y E = 3, que pasan todas por el vértice (1; 3).
% Escala: (a) 1 unidad = 1 cm; (b) p_1: 1 unidad = 2 cm; gasto: 1 unidad = 0,62 cm.
% Generar con: bash Code/generar_figura.sh anx_vertices_sustitutos
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  % ---------------- (a) Preferencias ----------------
  \begin{scope}[x=1cm, y=1cm]
    \node[font=\footnotesize\bfseries] at (2.4,4.45) {(a) Curva de indiferencia recta};
    \draw[->] (0,0) -- (4.8,0) node[below] {$x_1$};
    \draw[->] (0,0) -- (0,4.1) node[left] {$x_2$};
    \draw[thin] (0,1.5) -- (3,0);
    \draw[thin] (0,3) -- (1.5,0);
    \draw[very thick] (0,3) -- (3,0);
    \node[above right] at (1.5,1.5) {$U$};
    \fill (3,0) circle (1.5pt);
    \fill (1.5,1.5) circle (1.5pt);
    \fill (0,3) circle (1.5pt);
  \end{scope}
  % ---------------- (b) Gasto ----------------
  \begin{scope}[xshift=7.4cm, x=2cm, y=0.62cm]
    \node[font=\footnotesize\bfseries] at (1.2,7.18) {(b) Gasto con un vértice};
    \draw[->] (0,0) -- (2.4,0) node[below] {$p_1$};
    \draw[->] (0,0) -- (0,6.6) node[left] {Gasto};
    \draw[thin] (0,0) -- (2.2,6.6);
    \draw[thin] (0,1.5) -- (2.2,4.8);
    \draw[thin] (0,3) -- (1,3);
    \draw[very thick] (0,0) -- (1,3) -- (2.2,3) node[right] {$E(p,U)$};
    \draw[dotted] (1,3) -- (1,0) node[below] {$p_1=p_2$};
    \fill (1,3) circle (1.5pt);
  \end{scope}
\end{tikzpicture}
