% Figura (Anexo II, «Forma polar de GORMAN»): curvas de ENGEL de dos hogares y una redistribución del gasto.
% (a) Forma polar con la misma b(p): rectas paralelas de pendiente b_i/b = 0,5, x = 0,4 + 0,5 W (hogar 1, gruesa) y
%     x = 1,6 + 0,5 W (hogar 2, discontinua). Se traslada un gasto Delta = 2 del hogar 1 (W: 6,5 -> 4,5) al hogar 2
%     (W: 1,5 -> 3,5): el hogar 1 compra 1 unidad menos y el hogar 2, 1 más (triángulos iguales); el agregado no cambia.
% (b) Pendientes distintas: x = 1,2 + 0,25 W (hogar 1) y x = 0,6 + 0,85 W (hogar 2). La misma redistribución resta
%     0,5 unidades al hogar 1 y suma 1,7 al hogar 2: el agregado cambia.
% Puntos llenos: antes de la redistribución; huecos: después.
% Escala: 1 unidad = 0,8 cm en los dos ejes.
% Generar con: bash Code/generar_figura.sh anx_gorman_agregacion
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=0.8cm, y=0.8cm]
  % ---------------- (a) Pendientes iguales ----------------
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (3.8,6.15) {(a) Pendientes iguales};
    \draw[->] (0,0) -- (7.9,0) node[below] {$W^h$};
    \draw[->] (0,0) -- (0,5.8) node[left] {$x_i^h$};
    \draw[very thick] (0,0.4) -- (7.2,4.0) node[right] {Hogar 1};
    \draw[thick, dashed] (0,1.6) -- (7.2,5.2) node[right] {Hogar 2};
    % hogar 1: de (6,5; 3,65) a (4,5; 2,65)
    \draw[dotted] (4.5,2.65) -- (6.5,2.65) -- (6.5,3.65);
    \node[below] at (5.5,2.65) {$\Delta$};
    \node[right] at (6.5,3.05) {$\frac{b_i}{b}\Delta$};
    \fill (6.5,3.65) circle (1.6pt);
    \draw[fill=white] (4.5,2.65) circle (1.6pt);
    % hogar 2: de (1,5; 2,35) a (3,5; 3,35)
    \draw[dotted] (1.5,2.35) -- (3.5,2.35) -- (3.5,3.35);
    \node[below] at (2.5,2.35) {$\Delta$};
    \node[right] at (3.5,2.75) {$\frac{b_i}{b}\Delta$};
    \fill (1.5,2.35) circle (1.6pt);
    \draw[fill=white] (3.5,3.35) circle (1.6pt);
  \end{scope}
  % ---------------- (b) Pendientes distintas ----------------
  \begin{scope}[xshift=8.4cm]
    \node[font=\footnotesize\bfseries] at (3.8,6.15) {(b) Pendientes distintas};
    \draw[->] (0,0) -- (7.9,0) node[below] {$W^h$};
    \draw[->] (0,0) -- (0,5.8) node[left] {$x_i^h$};
    \draw[very thick] (0,1.2) -- (7.2,3.0) node[right] {Hogar 1};
    \draw[thick, dashed] (0,0.6) -- (5.6,5.36) node[right] {Hogar 2};
    % hogar 1: de (6,5; 2,825) a (4,5; 2,325)
    \draw[dotted] (4.5,2.325) -- (6.5,2.325) -- (6.5,2.825);
    \node[below] at (5.5,2.325) {$\Delta$};
    \node[right] at (6.5,2.45) {$\frac{b_i^1}{b^1}\Delta$};
    \fill (6.5,2.825) circle (1.6pt);
    \draw[fill=white] (4.5,2.325) circle (1.6pt);
    % hogar 2: de (1,5; 1,875) a (3,5; 3,575)
    \draw[dotted] (1.5,1.875) -- (3.5,1.875) -- (3.5,3.575);
    \node[below] at (2.5,1.875) {$\Delta$};
    \node[right] at (3.5,2.6) {$\frac{b_i^2}{b^2}\Delta$};
    \fill (1.5,1.875) circle (1.6pt);
    \draw[fill=white] (3.5,3.575) circle (1.6pt);
  \end{scope}
\end{tikzpicture}
