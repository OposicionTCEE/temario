% Variación del excedente del consumidor ante la caída del precio de x1, bajo la demanda marshalliana. Elaboración propia a partir de www.salasweb.info/cursos/microsupI/MicrosIt6.ppt.
\begin{tikzpicture}[x=1.3cm, y=1.2cm, font=\footnotesize, line cap=round, >={Stealth[length=4.5pt]},
    eje/.style={->, line width=0.6pt},
    dm/.style={line width=1.1pt, violet!75!black},
    dh/.style={line width=0.9pt, black!30},
    pun/.style={densely dotted, line width=0.5pt}]
  \fill[yellow!55] (0,2) -- (2,2) -- plot[domain=2:4, samples=40] (\x,{4/\x}) -- (0,1) -- cycle;
  \draw[dh, domain=1.65:3.6, samples=50] plot (\x,{8/(\x*\x)});
  \draw[dh, domain=2.35:5.1, samples=50] plot (\x,{16/(\x*\x)});
  \draw[dm, domain=1.05:5.4, samples=60] plot (\x,{4/\x});
  \draw[pun] (0,2) -- (2,2) -- (2,0);
  \draw[pun] (0,1) -- (4,1) -- (4,0);
  \fill (2,2) circle (1.4pt); \fill (4,1) circle (1.4pt);
  \node[align=center, font=\footnotesize\bfseries] at (1.0,1.5) {Variación del\\excedente del\\consumidor};
  \draw[eje] (0,0) -- (5.8,0) node[below] {$x_1$};
  \draw[eje] (0,0) -- (0,4.3) node[left] {$p_1$};
  \node[left] at (0,2) {$p_1^0$};
  \node[left] at (0,1) {$p_1^1$};
  \draw[->, line width=0.6pt] (-0.75,2.15) -- node[left, rotate=90, anchor=south, font=\footnotesize] {caída del precio} (-0.75,0.85);
  \node[below] at (2,0) {$x_1^*$};
  \node[below] at (4,0) {$x_1^{**}$};
  \node[text=violet!75!black] at (1.75,3.25) {$x_1^d(p,\bar W)$};
  \node[align=left, anchor=west] at (1.2,4.25) {Curva de demanda ordinaria (marshalliana)};
\end{tikzpicture}
