% Figura (Anexo I, «Tramos rectos y vértices»): lo que es un tramo recto en las preferencias es un vértice en el gasto, y al revés.
% (a) Sustitutos perfectos u = x_1 + x_2, U = 3: curva de indiferencia recta x_1 + x_2 = 3. Con p_1 < p_2 (pendiente -1/2) se
%     compra solo el bien 1, (3; 0); con p_1 > p_2 (pendiente -2), solo el bien 2, (0; 3); con p_1 = p_2, cualquier cesta de la recta.
% (b) Su función de gasto con p_2 = 1: E = U min(p_1, p_2) = 3 p_1 si p_1 <= 1 y 3 si p_1 >= 1: vértice en p_1 = p_2.
% (c) Complementarios perfectos u = min(x_1, x_2), U = 2: curva en ángulo recto con vértice en (2; 2); dos rectas de gasto
%     mínimo con pendientes -1/2 y -2 tocan en el vértice.
% (d) Su función de gasto con p_2 = 1: E = U (p_1 + p_2) = 2 p_1 + 2: lineal, con pendiente U = h_1 (sin sustitución).
% Escala: 1 unidad = 1 cm en (a) y (c); en (b) y (d), p_1: 1 unidad = 2 cm, gasto: 1 unidad = 0,62 cm.
% Generar con: bash Code/generar_figura.sh anx_vertices
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  % ---------------- (a) Sustitutos perfectos: preferencias ----------------
  \begin{scope}[x=1cm, y=1cm]
    \node[font=\footnotesize\bfseries] at (2.4,4.45) {(a) Sustitutos perfectos};
    \draw[->] (0,0) -- (4.8,0) node[below] {$x_1$};
    \draw[->] (0,0) -- (0,4.1) node[left] {$x_2$};
    \draw[very thick] (0,3) -- (3,0);
    \node[above right] at (1.5,1.5) {$U$};
    \draw[thin] (0,1.5) -- (3,0);
    \draw[thin] (0,3) -- (1.5,0);
    \fill (3,0) circle (1.4pt);
    \fill (0,3) circle (1.4pt);
  \end{scope}
  % ---------------- (b) Sustitutos perfectos: gasto ----------------
  \begin{scope}[xshift=7.4cm, x=2cm, y=0.62cm]
    \node[font=\footnotesize\bfseries] at (1.2,7.18) {(b) Gasto con un vértice};
    \draw[->] (0,0) -- (2.4,0) node[below] {$p_1$};
    \draw[->] (0,0) -- (0,6.6) node[left] {Gasto};
    \draw[very thick] (0,0) -- (1,3) -- (2.2,3) node[right] {$E(p,U)$};
    \draw[dotted] (1,3) -- (1,0) node[below] {$p_1=p_2$};
    \fill (1,3) circle (1.4pt);
  \end{scope}
  % ---------------- (c) Complementarios perfectos: preferencias ----------------
  \begin{scope}[yshift=-5.6cm, x=1cm, y=1cm]
    \node[font=\footnotesize\bfseries] at (2.4,4.45) {(c) Complementarios perfectos};
    \draw[->] (0,0) -- (4.8,0) node[below] {$x_1$};
    \draw[->] (0,0) -- (0,4.1) node[left] {$x_2$};
    \draw[very thick] (2,3.9) -- (2,2) -- (4.5,2) node[above] {$U$};
    \begin{scope}
      \clip (0,0) rectangle (4.6,4.0);
      \draw[thin] (0,3) -- (6,0);
      \draw[thin] (0,6) -- (3,0);
    \end{scope}
    \fill (2,2) circle (1.4pt);
  \end{scope}
  % ---------------- (d) Complementarios perfectos: gasto ----------------
  \begin{scope}[xshift=7.4cm, yshift=-5.6cm, x=2cm, y=0.62cm]
    \node[font=\footnotesize\bfseries] at (1.2,7.18) {(d) Gasto lineal};
    \draw[->] (0,0) -- (2.4,0) node[below] {$p_1$};
    \draw[->] (0,0) -- (0,6.6) node[left] {Gasto};
    \draw[very thick] (0,2) -- (2.2,6.4) node[right] {$E(p,U)$};
  \end{scope}
\end{tikzpicture}
