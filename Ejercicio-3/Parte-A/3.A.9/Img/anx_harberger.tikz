% Figura (Anexo III, «Pérdida irrecuperable»): recaudación y pérdida irrecuperable de un impuesto unitario.
% Demanda compensada de la utilidad final (gruesa): x = 4 + 0,8 (5 - p). Marshalliana (discontinua), que la corta en
% el precio con impuesto: x = 4 + 1,3 (5 - p), más plana por ser el bien normal.
% Sin impuesto, p^0 = 3; con el impuesto t = 2, p^1 = 5 y se compran 4 unidades.
% Recaudación T = t x1(p^1, W) = 8: rectángulo (0;3)-(4;5) (gris claro). Pérdida irrecuperable con la compensada:
% triángulo (4;5)-(4;3)-(5,6;3), área 1,6 (gris oscuro). Lo que añadiría la marshalliana: triángulo
% (4;5)-(5,6;3)-(6,6;3), área 1,0 (gris medio).
% Escala: 1 unidad = 0,7 cm en los dos ejes.
% Generar con: bash Code/generar_figura.sh anx_harberger
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=0.7cm, y=0.7cm]
  % áreas
  \fill[gray!14] (0,3) rectangle (4,5);
  \fill[gray!58] (4,5) -- (4,3) -- (5.6,3) -- cycle;
  \fill[gray!30] (4,5) -- (5.6,3) -- (6.6,3) -- cycle;
  % ejes
  \draw[->] (0,0) -- (10.2,0) node[below] {$x_1$};
  \draw[->] (0,0) -- (0,8.2) node[left] {$p_1$};
  % demandas
  \draw[very thick] (2.4,7) -- (6.8,1.5) node[right] {$h_1(p,U^1)$};
  \draw[thick, dashed] (2.05,6.5) -- (7.9,2) node[right] {$x_1(p,W)$};
  % precios
  \draw[dotted] (0,5) -- (4,5);
  \draw[dotted] (4,0) -- (4,3);
  \node[left] at (0,5) {$p_1^1$};
  \node[left] at (0,3) {$p_1^0$};
  \node[below] at (4,0) {$x_1(p^1,W)$};
  \draw[decorate, decoration={brace, amplitude=3pt}] (-0.75,3) -- (-0.75,5) node[midway, left=4pt] {$t$};
  % rótulos
  \node at (2,4) {$T$};
  \draw[->, thin] (6.6,5.6) node[right, font=\scriptsize, align=left] {pérdida\\irrecuperable} -- (4.55,3.55);
  \draw[->, thin] (7.8,4.1) node[right, font=\scriptsize, align=left] {lo que añade\\la marshalliana} -- (5.8,3.25);
\end{tikzpicture}
