% Figura (Anexo II, «Especificación» del sistema casi ideal): efecto de una subida del precio propio sobre la participación.
% Antes (gruesa): omega = 0,6 - 0,15 ln W (bien necesario, beta_i = -0,15). Sube p_i: el índice de precios sube
% Delta ln P = 0,5 y el término gamma_ii Delta ln p_i vale 0,06. Después (discontinua): omega = 0,735 - 0,15 ln W.
% Con el gasto nominal fijo, ln W = 2,4: A = (2,4; 0,24) antes; B = (1,9; 0,315), la participación de la recta inicial
% con el gasto real reducido en Delta ln P (efecto del gasto real, -beta_i Delta ln P = 0,075); C = (2,4; 0,375) después
% (efecto de los precios relativos, gamma_ii Delta ln p_i = 0,06).
% Escala: ln W, 1 unidad = 2,4 cm; participación, 1 unidad = 6 cm.
% Generar con: bash Code/generar_figura.sh anx_aids_precios
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=2.4cm, y=6cm]
  \draw[->] (0,0) -- (3.55,0) node[below] {$\ln W$};
  \draw[->] (0,0) -- (0,0.82) node[left] {$\omega_i$};
  \draw[very thick] (0,0.6) -- (3.4,0.09) node[right] {Antes};
  \draw[thick, dashed] (0,0.735) -- (3.4,0.225) node[right] {Después};
  % gasto nominal fijo
  \draw[dotted] (2.4,0) -- (2.4,0.375);
  \draw[dotted] (1.9,0) -- (1.9,0.315);
  \node[below] at (2.4,0) {$\ln W$};
  \node[below left] at (1.93,0) {$\ln W-\Delta\ln P$};
  % puntos
  \fill (2.4,0.24) circle (1.6pt) node[below left] {$A$};
  \fill (1.9,0.315) circle (1.6pt) node[below left] {$B$};
  \fill (2.4,0.375) circle (1.6pt) node[above right] {$C$};
  \draw[dotted] (1.9,0.315) -- (2.4,0.315);
  % descomposición
  \draw[decorate, decoration={brace, amplitude=3pt, mirror}] (2.47,0.24) -- (2.47,0.315) node[midway, right=4pt] {$-\beta_i\,\Delta\ln P$};
  \draw[decorate, decoration={brace, amplitude=3pt, mirror}] (2.47,0.315) -- (2.47,0.375) node[midway, right=4pt] {$\gamma_{ii}\,\Delta\ln p_i$};
\end{tikzpicture}
