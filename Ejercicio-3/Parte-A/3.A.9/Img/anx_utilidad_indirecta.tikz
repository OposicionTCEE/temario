% Figura (Anexo I, «Relaciones»): la utilidad de una cesta es la del peor presupuesto que permite comprarla, u(x) = min_p V(p, p.x).
% COBB-DOUGLAS con a = 1/2 y p_2 = 1; cesta x = (2; 2), con u(x) = 2 (curva x_1 x_2 = 4, muy gruesa).
% Tres rectas de balance que pasan por x: con p_1 = 1/4, x_2 = 2,5 - 0,25 x_1 (renta 2,5); con p_1 = 1, x_2 = 4 - x_1 (renta 4,
% tangente en x); con p_1 = 4, x_2 = 10 - 4 x_1 (renta 10). Con las rectas no tangentes el consumidor alcanza U' = 2,5
% (curva x_1 x_2 = 6,25, gruesa) en (5; 1,25) y en (1,25; 5); con la tangente solo alcanza u(x) = 2.
% Escala: 1 unidad = 0,9 cm; recorte [0; 6,6]^2.
% Generar con: bash Code/generar_figura.sh anx_utilidad_indirecta
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=0.9cm, y=0.9cm]
  \begin{scope}
    \clip (0,0) rectangle (6.6,6.6);
    \draw[thin] (0,2.5) -- (10,0);
    \draw[thin] (0,4) -- (4,0);
    \draw[thin] (0,10) -- (2.5,0);
    \draw[very thick] plot[domain=0.62:6.6, samples=150] (\x,{4/\x});
    \draw[thick] plot[domain=0.96:6.6, samples=150] (\x,{6.25/\x});
  \end{scope}
  \draw[->] (0,0) -- (6.9,0) node[below] {$x_1$};
  \draw[->] (0,0) -- (0,6.9) node[left] {$x_2$};
  \node[right] at (6.6,0.606) {$u(x)$};
  \node[right] at (6.6,0.947) {$U'$};
  \fill (2,2) circle (1.6pt) node[below left] {$x$};
  \fill (5,1.25) circle (1.4pt);
  \fill (1.25,5) circle (1.4pt);
\end{tikzpicture}
