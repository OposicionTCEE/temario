% Figura (Anexo I, «Demanda hicksiana»): de la elección a la curva de demanda hicksiana.
% COBB-DOUGLAS u = (x_1 x_2)^{1/2} (a = 1/2), utilidad exigida U = 2 (curva x_1 x_2 = 4), p_2 = 1; p_1 baja de 2 a 1 y a 1/2.
% (a) Rectas isogasto de gasto mínimo, tangentes a la curva: con p_1 = 2, x_2 = 5,657 - 2 x_1 (gasto 5,657) en A' = (1,414; 2,828);
%     con p_1 = 1, x_2 = 4 - x_1 (gasto 4) en B = (2; 2); con p_1 = 1/2, x_2 = 2,828 - 0,5 x_1 (gasto 2,828) en C' = (2,828; 1,414).
%     B es la misma cesta que en la figura de la demanda marshalliana (con W = 4 y p_1 = 1 la utilidad máxima es U = 2).
% (b) Demanda hicksiana h_1 = U (p_2/p_1)^{1/2} = 2/p_1^{1/2}, es decir, p_1 = 4/h_1^2, con los mismos puntos.
% Escala: x_1, 1 unidad = 1,1 cm en los dos paneles; (a) x_2, 1 unidad = 0,62 cm; (b) p_1, 1 unidad = 1,35 cm.
% Generar con: bash Code/generar_figura.sh anx_hicksiana
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  % ---------------- (a) La cesta más barata con tres precios ----------------
  \begin{scope}[x=1.1cm, y=0.62cm]
    \node[font=\footnotesize\bfseries] at (3.3,6.95) {(a) La cesta más barata con tres precios};
    \draw[->] (0,0) -- (6.7,0) node[below] {$x_1$};
    \draw[->] (0,0) -- (0,6.45) node[left] {$x_2$};
    \draw[thin] (0,5.657) -- (2.828,0);
    \draw[thin] (0,4) -- (4,0);
    \draw[thin] (0,2.828) -- (5.657,0);
    \draw[very thick] plot[domain=0.65:6.3, samples=150] (\x,{4/\x}) node[above] {$U$};
    \fill (1.414,2.828) circle (1.5pt) node[above right] {$A'$};
    \fill (2,2) circle (1.5pt) node[above right] {$B$};
    \fill (2.828,1.414) circle (1.5pt) node[above right] {$C'$};
  \end{scope}
  % ---------------- (b) La curva de demanda ----------------
  \begin{scope}[yshift=-5.5cm, x=1.1cm, y=1.35cm]
    \node[font=\footnotesize\bfseries] at (3.3,3.0) {(b) La curva de demanda hicksiana};
    \draw[->] (0,0) -- (6.7,0) node[below] {$x_1$};
    \draw[->] (0,0) -- (0,2.75) node[left] {$p_1$};
    \draw[very thick] plot[domain=1.24:6.3, samples=150] (\x,{4/(\x*\x)}) node[above] {$h_1(p,U)$};
    \draw[dotted] (0,2) node[left] {$p_1^0$} -- (1.414,2);
    \draw[dotted] (0,1) node[left] {$p_1^1$} -- (2,1);
    \draw[dotted] (0,0.5) node[left] {$p_1^2$} -- (2.828,0.5);
    \fill (1.414,2) circle (1.5pt) node[above right] {$A'$};
    \fill (2,1) circle (1.5pt) node[above right] {$B$};
    \fill (2.828,0.5) circle (1.5pt) node[above right] {$C'$};
  \end{scope}
  % Líneas de puntos de cada cesta a su punto de la curva (coordenadas absolutas)
  \draw[dotted] (1.555,1.753) -- (1.555,-2.8);
  \draw[dotted] (2.2,1.24) -- (2.2,-4.15);
  \draw[dotted] (3.111,0.877) -- (3.111,-4.825);
\end{tikzpicture}
