% Figura (cuerpo, «Diferenciabilidad»): lo que es recto en las preferencias es un vértice en el gasto, y viceversa.
% Adapta a un solo par de paneles las figuras anx_vertices_sustitutos y anx_vertices_complementarios del anexo I.
% (a) Preferencias: sustitutos perfectos u = x_1 + x_2 con U = 3 (recta x_1 + x_2 = 3, gruesa) y complementarios perfectos
%     u = min{x_1, x_2} con U = 2 (ángulo recto con vértice en (2; 2), grueso); tres rectas de gasto mínimo de los complementarios,
%     con p_1/p_2 = 1/2, 1 y 2 (x_2 = 3 - 0,5 x_1, x_2 = 4 - x_1 y x_2 = 6 - 2 x_1, discontinuas), apoyadas todas en el vértice.
% (b) Gasto con p_2 = 1: sustitutos E = 3 min{p_1, 1} (vértice en p_1 = p_2 = 1); complementarios E = 2 (p_1 + 1) (lineal).
% Escala: (a) 1 unidad = 1,15 cm; (b) p_1, 1 unidad = 2,2 cm; gasto, 1 unidad = 0,62 cm.
% Generar con: bash Code/generar_figura.sh b3_vertices
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  % ---------------- (a) Preferencias ----------------
  \begin{scope}[x=1.15cm, y=1.15cm]
    \node[font=\footnotesize\bfseries] at (2.25,4.95) {(a) Preferencias: un tramo recto y un vértice};
    \draw[->] (0,0) -- (4.7,0) node[below] {$x_1$};
    \draw[->] (0,0) -- (0,4.6) node[left] {$x_2$};
    \begin{scope}
      \clip (0,0) rectangle (4.5,4.4);
      \draw[thin, dashed] (0,3) -- (6,0);
      \draw[thin, dashed] (0,4) -- (4,0);
      \draw[thin, dashed] (0,6) -- (3,0);
    \end{scope}
    \draw[very thick] (0,3) -- (3,0);
    \draw[very thick] (2,4.3) -- (2,2) -- (4.4,2);
    \fill (2,2) circle (1.6pt);
    \node[below left, font=\scriptsize] at (1.05,1.95) {$x_1+x_2=U$};
    \node[above right, font=\scriptsize] at (2.05,3.55) {$\min\{x_1,x_2\}=U$};
  \end{scope}
  % ---------------- (b) Gasto ----------------
  \begin{scope}[xshift=8.0cm, x=2.2cm, y=0.62cm]
    \node[font=\footnotesize\bfseries] at (1.3,8.0) {(b) Gasto: un vértice y un tramo recto};
    \draw[->] (0,0) -- (2.75,0) node[below] {$p_1$};
    \draw[->] (0,0) -- (0,7.4) node[left] {Gasto};
    \draw[very thick] (0,0) -- (1,3) -- (2.6,3);
    \draw[very thick] (0,2) -- (2.6,7.2);
    \fill (1,3) circle (1.6pt);
    \draw[dotted] (1,3) -- (1,0) node[below] {$p_1=p_2$};
    \node[below right, font=\scriptsize] at (1.75,3.0) {$U\min\{p_1,p_2\}$};
    \node[above left, font=\scriptsize] at (2.35,6.7) {$U(p_1+p_2)$};
  \end{scope}
\end{tikzpicture}
