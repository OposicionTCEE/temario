% Figura (Anexo I, «Elasticidades»): pendientes de la demanda marshalliana y de la hicksiana según el tipo de bien.
% Curvas esquemáticas (rectas) con el precio en ordenadas que se cortan en B = (2; 1), con el precio p_1^1 (las letras de las
% figuras de la COBB-DOUGLAS, donde las dos demandas se cortan en B): hicksiana p = 3 - x (discontinua) en todos los
% paneles; marshalliana (gruesa): (a) bien normal, p = 2 - x/2, más plana; (b) bien inferior, p = 5 - 2x, más inclinada;
% (c) bien frontera, coincide con la hicksiana; (d) bien de GIFFEN, p = 2x - 3, creciente.
% Escala: 1 unidad = 1 cm; paneles en una rejilla de 2 x 2.
% Generar con: bash Code/generar_figura.sh anx_pendientes
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1cm, y=1cm]
  \foreach \px/\py/\tit in {0/0/{(a) Bien normal}, 5.9/0/{(b) Bien inferior}, 0/-4.6/{(c) Bien frontera}, 5.9/-4.6/{(d) Bien de GIFFEN}} {
    \begin{scope}[shift={(\px,\py)}]
      \node[font=\footnotesize\bfseries] at (2.1,3.65) {\tit};
      \draw[->] (0,0) -- (4.6,0) node[below] {$x_1$};
      \draw[->] (0,0) -- (0,3.4) node[left] {$p_1$};
      \draw[dotted] (0,1) node[left] {$p_1^1$} -- (2,1) -- (2,0);
    \end{scope}
  }
  % (a) Bien normal: la marshalliana, más plana
  \begin{scope}
    \draw[thick, dashed] (0.1,2.9) node[right=2pt] {$h_1(p,U)$} -- (2.9,0.1);
    \draw[very thick] (0,2) -- (4,0);
    \node at (3.4,0.62) {$x_1(p,W)$};
    \fill (2,1) circle (1.5pt) node[above right] {$B$};
  \end{scope}
  % (b) Bien inferior: la marshalliana, más inclinada
  \begin{scope}[shift={(5.9,0)}]
    \draw[thick, dashed] (0.1,2.9) -- (2.9,0.1) node[right] {$h_1(p,U)$};
    \draw[very thick] (1.05,2.9) node[right=2pt] {$x_1(p,W)$} -- (2.45,0.1);
    \fill (2,1) circle (1.5pt) node[above right] {$B$};
  \end{scope}
  % (c) Bien frontera: coinciden
  \begin{scope}[shift={(0,-4.6)}]
    \draw[very thick] (0.1,2.9) node[right=2pt] {$x_1(p,W)=h_1(p,U)$} -- (2.9,0.1);
    \fill (2,1) circle (1.5pt) node[above right] {$B$};
  \end{scope}
  % (d) Bien de GIFFEN: la marshalliana, creciente
  \begin{scope}[shift={(5.9,-4.6)}]
    \draw[thick, dashed] (0.1,2.9) -- (2.9,0.1) node[right] {$h_1(p,U)$};
    \draw[very thick] (1.55,0.1) -- (3.1,3.2) node[right] {$x_1(p,W)$};
    \fill (2,1) circle (1.5pt) node[right=2pt] {$B$};
  \end{scope}
\end{tikzpicture}
