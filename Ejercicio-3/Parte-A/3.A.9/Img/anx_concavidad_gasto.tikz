% Figura (Anexo I, «La función de gasto y el lema de SHEPHARD»): la función de gasto es cóncava en los precios.
% Preferencias COBB-DOUGLAS u = (x_1 x_2)^{1/2}, con U = 1 y p_2 = 1: E(p_1) = 2 (p_1)^{1/2}; h_1 = (p_2/p_1)^{1/2} U.
% En p_1^0 = 1: E^0 = 2 y h_1^0 = 1. Gasto del consumidor pasivo (que no cambia de cesta): E^0 + h_1^0 (p_1 - p_1^0) = p_1 + 1,
% tangente en p_1^0. Mismo dibujo que anx_concavidad_costes del 3.A.12, con el consumidor en lugar de la empresa.
% Escala: eje horizontal 1 unidad = 1,45 cm; vertical 1 unidad = 1,05 cm.
% Generar con: bash Code/generar_figura.sh anx_concavidad_gasto
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1.45cm, y=1.05cm]
  \draw[->] (0,0) -- (3.7,0) node[below] {$p_1$};
  \draw[->] (0,0) -- (0,4.6) node[left] {$E$};
  \draw[very thick] plot[domain=0.12:3.3, samples=80] (\x,{2*sqrt(\x)}) node[right] {$E(p,U)$};
  \draw[thick, dashed] (0.15,1.15) -- (3.3,4.3) node[right] {$E^0+h_1^0\,(p_1-p_1^0)$};
  \draw[dotted] (1,2) -- (1,0) node[below] {$p_1^0$};
  \draw[dotted] (1,2) -- (0,2) node[left] {$E^0$};
  \fill (1,2) circle (1.4pt);
  \node at (1.85,-0.75) {$p_2$ y $U$ dados};
\end{tikzpicture}
