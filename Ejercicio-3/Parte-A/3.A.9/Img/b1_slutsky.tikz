% Figura (cuerpo, «Ecuación de SLUTSKY»): la descomposición y su lectura con lo que se observa.
% Une, como paneles (a) y (b), las figuras anx_slutsky_descomposicion y anx_slutsky_observable del anexo I (mismos datos).
% COBB-DOUGLAS u = (x_1 x_2)^{1/2}, p_2 = 1, W = 4; el precio del bien 1 baja de p_1^1 = 1 a p_1^2 = 1/2.
% B = x(p^1, W) = (2; 2), con U^0 = 2; C = x(p^2, W) = (4; 2), con U^1 = 2,828; C' = h(p^2, U^0) = (2,828; 1,414).
% (a) Espacio de bienes: recta inicial x_1 + x_2 = 4, final 0,5 x_1 + x_2 = 4 y compensada 0,5 x_1 + x_2 = 2,828 (discontinua).
%     Efecto sustitución B -> C' (ES) y efecto renta C' -> C (ER). Escala: 1 unidad = 1 cm.
% (b) Precio en ordenadas: marshalliana x_1 = 2/p_1 (gruesa), por B y C; hicksianas h_1(p,U^0) = 2 p_1^{-1/2}, por B y C', y
%     h_1(p,U^1) = 2,828 p_1^{-1/2}, por C (discontinuas). B y C se observan (puntos llenos); C' se construye (punto hueco).
%     Escala: x_1, 1 unidad = 1 cm; p_1, 1 unidad = 3 cm.
% Generar con: bash Code/generar_figura.sh b1_slutsky
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  % ---------------- (a) Efecto sustitución y efecto renta ----------------
  \begin{scope}[x=1cm, y=1cm]
    \node[font=\footnotesize\bfseries] at (3.2,5.55) {(a) Efecto sustitución y efecto renta};
    \draw[->] (0,0) -- (6.6,0) node[below] {$x_1$};
    \draw[->] (0,0) -- (0,5.0) node[left] {$x_2$};
    \begin{scope}
      \clip (0,0) rectangle (6.3,4.8);
      \draw[thin] (0,4) -- (4,0);
      \draw[thin] (0,4) -- (8,0);
      \draw[thick, dashed] (0,2.828) -- (5.657,0);
    \end{scope}
    \draw[thick] plot[domain=0.85:6.2, samples=100] (\x,{4/\x}) node[right] {$U^0$};
    \draw[thick] plot[domain=1.7:6.2, samples=100] (\x,{8/\x}) node[right] {$U^1$};
    \draw[dotted] (2,2) -- (2,0);
    \draw[dotted] (2.828,1.414) -- (2.828,0);
    \draw[dotted] (4,2) -- (4,0);
    \fill (2,2) circle (1.5pt) node[above right] {$B$};
    \fill (2.828,1.414) circle (1.5pt) node[above right] {$C'$};
    \fill (4,2) circle (1.5pt) node[above right] {$C$};
    \draw[decorate, decoration={brace, mirror, amplitude=4pt}] (2,-0.45) -- (2.828,-0.45) node[midway, below=4pt] {ES};
    \draw[decorate, decoration={brace, mirror, amplitude=4pt}] (2.828,-0.45) -- (4,-0.45) node[midway, below=4pt] {ER};
  \end{scope}
  % ---------------- (b) Lo que se observa y lo que se construye ----------------
  \begin{scope}[xshift=8.1cm, x=1cm, y=3cm]
    \node[font=\footnotesize\bfseries] at (3.2,1.85) {(b) Lo que se observa y lo que se construye};
    \draw[->] (0,0) -- (6.4,0) node[below] {$x_1$};
    \draw[->] (0,0) -- (0,1.66) node[left] {$p_1$};
    \draw[very thick] plot[domain=0.34:1.5, samples=90] ({2/\x},\x);
    \node[left] at (1.333,1.5) {$x_1(p,W)$};
    \draw[thick, dashed] plot[domain=0.12:1.5, samples=90] ({2/sqrt(\x)},\x);
    \node[above] at (1.633,1.5) {$h_1(p,U^0)$};
    \draw[thick, dashed] plot[domain=0.23:1.5, samples=90] ({2.828/sqrt(\x)},\x);
    \node[right] at (2.309,1.5) {$h_1(p,U^1)$};
    \draw[dotted] (0,1) node[left] {$p_1^1$} -- (2,1) -- (2,0);
    \draw[dotted] (0,0.5) node[left] {$p_1^2$} -- (4,0.5) -- (4,0);
    \draw[dotted] (2.828,0.5) -- (2.828,0);
    \fill (2,1) circle (1.6pt) node[above right] {$B$};
    \draw[fill=white] (2.828,0.5) circle (1.8pt) node[above right] {$C'$};
    \fill (4,0.5) circle (1.6pt) node[above right] {$C$};
  \end{scope}
\end{tikzpicture}
