% Figura (Anexo II, «El sistema lineal de gasto»): la geometría del LES y sus participaciones.
% Preferencias de STONE-GEARY u = (x_1 - 2)^{0,3} (x_2 - 1)^{0,7}: gamma = (2; 1), beta = (0,3; 0,7); precios p_1 = p_2 = 1.
% (a) Curvas de indiferencia: COBB-DOUGLAS con el origen en gamma. Rectas de balance W = 5 y W = 8; cestas elegidas
%     A = (2,6; 2,4) y B = (3,5; 4,5), con U^0 = 1,0858 y U^1 = 2,714: x_2 = 1 + U^{1/0,7} (x_1 - 2)^{-0,3/0,7}, es decir,
%     x_2 = 1 + 1,1248 (x_1 - 2)^{-0,4286} y x_2 = 1 + 4,1636 (x_1 - 2)^{-0,4286}. Senda de expansión: recta desde gamma con
%     pendiente beta_2/beta_1 = 7/3. Escala: 1 unidad = 0,9 cm.
% (b) Participaciones: omega_1 = 0,3 + 1,1/W y omega_2 = 0,7 - 1,1/W desde W = p.gamma = 3; tienden a beta_1 y beta_2.
%     Escala: W, 1 unidad = 0,2 cm; participación, 1 unidad = 4,2 cm.
% Generar con: bash Code/generar_figura.sh anx_les
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  % ---------------- (a) Preferencias de STONE-GEARY ----------------
  \begin{scope}[x=0.9cm, y=0.9cm]
    \node[font=\footnotesize\bfseries] at (3.4,7.25) {(a) Preferencias de STONE-GEARY};
    \draw[->] (0,0) -- (7.0,0) node[below] {$x_1$};
    \draw[->] (0,0) -- (0,6.9) node[left] {$x_2$};
    \begin{scope}
      \clip (0,0) rectangle (6.7,6.7);
      \draw[thin] (0,5) -- (5,0);
      \draw[thin] (0,8) -- (8,0);
    \end{scope}
    \draw[dashed] (2,1) -- (2,6.6);
    \draw[dashed] (2,1) -- (6.6,1);
    \draw[dotted] (2,0) node[below] {$\gamma_1$} -- (2,1);
    \draw[dotted] (0,1) node[left] {$\gamma_2$} -- (2,1);
    \draw[very thick] plot[domain=2.028:6.5, samples=150] (\x,{1+1.1248*pow(\x-2,-0.4286)}) node[above] {$U^0$};
    \draw[very thick] plot[domain=2.53:6.5, samples=150] (\x,{1+4.1636*pow(\x-2,-0.4286)}) node[above] {$U^1$};
    \draw[thick] (2,1) -- (4.357,6.5);
    \fill (2,1) circle (1.5pt) node[below right] {$\gamma$};
    \fill (2.6,2.4) circle (1.4pt);
    \fill (3.5,4.5) circle (1.4pt);
  \end{scope}
  % ---------------- (b) Participaciones en el gasto ----------------
  \begin{scope}[xshift=8.6cm, x=0.2cm, y=4.2cm]
    \node[font=\footnotesize\bfseries] at (16,1.488) {(b) Participaciones en el gasto};
    \draw[->] (0,0) -- (34,0) node[below] {$W$};
    \draw[->] (0,0) -- (0,1.08) node[left] {$\omega_i$};
    \draw[dotted] (0,0.3) node[left] {$\beta_1$} -- (31,0.3);
    \draw[dotted] (0,0.7) node[left] {$\beta_2$} -- (31,0.7);
    \draw[dotted] (3,0) node[below] {$p\cdot\gamma$} -- (3,0.6667);
    \draw[very thick] plot[domain=3:31, samples=120] (\x,{0.3+1.1/\x}) node[right] {$\omega_1$};
    \draw[very thick] plot[domain=3:31, samples=120] (\x,{0.7-1.1/\x}) node[right] {$\omega_2$};
  \end{scope}
\end{tikzpicture}
