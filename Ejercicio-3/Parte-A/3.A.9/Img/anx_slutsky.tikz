% Figura (Anexo I, «La ecuación de SLUTSKY»): efecto sustitución y efecto renta, y demanda marshalliana frente a hicksiana.
% Preferencias COBB-DOUGLAS u = (x_1 x_2)^{1/2}, p_2 = 1, W = 4. El precio del bien 1 baja de p_1^0 = 1 a p_1^1 = 1/2.
% (a) A = x(p^0,W) = (2; 2), con U^0 = 2; C = x(p^1,W) = (4; 2), con U^1 = 8^{1/2} = 2,828;
%     B = h(p^1,U^0) = (2,828; 1,414), sobre la recta compensada 0,5 x_1 + x_2 = E(p^1,U^0) = 2,828 (discontinua).
%     Recta inicial x_1 + x_2 = 4; final 0,5 x_1 + x_2 = 4. Efecto sustitución A -> B (de 2 a 2,828); efecto renta B -> C (de 2,828 a 4).
% (b) Representación inversa (precio en ordenadas): marshalliana x_1 = 2/p_1; hicksianas h_1(p,U^0) = 2 p_1^{-1/2} y
%     h_1(p,U^1) = 2,828 p_1^{-1/2}. La marshalliana pasa por A y C y es más plana que las hicksianas (bien normal).
% Escala: (a) 1 unidad = 1 cm; (b) x_1: 1 unidad = 1 cm; p_1: 1 unidad = 3 cm.
% Generar con: bash Code/generar_figura.sh anx_slutsky
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  % ---------------- (a) Descomposición ----------------
  \begin{scope}[x=1cm, y=1cm]
    \node[font=\footnotesize\bfseries] at (3.1,5.35) {(a) Efecto sustitución y efecto renta};
    \draw[->] (0,0) -- (6.6,0) node[below] {$x_1$};
    \draw[->] (0,0) -- (0,5.0) node[left] {$x_2$};
    \begin{scope}
      \clip (0,0) rectangle (6.3,4.8);
      \draw[thick] (0,4) -- (4,0);
      \draw[thick] (0,4) -- (8,0);
      \draw[thick, dashed] (0,2.828) -- (5.657,0);
    \end{scope}
    \draw[thick] plot[domain=0.85:6.2, samples=80] (\x,{4/\x}) node[right] {$U^0$};
    \draw[thick] plot[domain=1.7:6.2, samples=80] (\x,{8/\x}) node[right] {$U^1$};
    \draw[dotted] (2,2) -- (2,0);
    \draw[dotted] (2.828,1.414) -- (2.828,0);
    \draw[dotted] (4,2) -- (4,0);
    \fill (2,2) circle (1.4pt) node[above right] {$A$};
    \fill (2.828,1.414) circle (1.4pt) node[above right] {$B$};
    \fill (4,2) circle (1.4pt) node[above right] {$C$};
    \draw[decorate, decoration={brace, mirror, amplitude=4pt}] (2,-0.45) -- (2.828,-0.45) node[midway, below=4pt] {ES};
    \draw[decorate, decoration={brace, mirror, amplitude=4pt}] (2.828,-0.45) -- (4,-0.45) node[midway, below=4pt] {ER};
  \end{scope}
  % ---------------- (b) Marshalliana y hicksianas ----------------
  \begin{scope}[xshift=7.9cm, x=1cm, y=3cm]
    \node[font=\footnotesize\bfseries] at (3.0,1.783) {(b) Demanda marshalliana y hicksiana};
    \draw[->] (0,0) -- (6.4,0) node[below] {$x_1$};
    \draw[->] (0,0) -- (0,1.66) node[left] {$p_1$};
    \draw[very thick] plot[domain=0.34:1.5, samples=80] ({2/\x},\x);
    \node[left] at (1.333,1.5) {$x_1(p,W)$};
    \draw[thick, dashed] plot[domain=0.12:1.5, samples=80] ({2/sqrt(\x)},\x);
    \node[above] at (1.633,1.5) {$h_1(p,U^0)$};
    \draw[thick, dashed] plot[domain=0.23:1.5, samples=80] ({2.828/sqrt(\x)},\x);
    \node[right] at (2.309,1.5) {$h_1(p,U^1)$};
    \draw[dotted] (0,1) node[left] {$p_1^0$} -- (2,1) -- (2,0);
    \draw[dotted] (0,0.5) node[left] {$p_1^1$} -- (4,0.5) -- (4,0);
    \draw[dotted] (2.828,0.5) -- (2.828,0);
    \fill (2,1) circle (1.4pt) node[above right] {$A$};
    \fill (2.828,0.5) circle (1.4pt) node[above right] {$B$};
    \fill (4,0.5) circle (1.4pt) node[above right] {$C$};
  \end{scope}
\end{tikzpicture}
