% Figura (Anexo III, «Variación equivalente»): la misma bajada de precio, medida con los precios iniciales.
% Preferencias COBB-DOUGLAS del primer anexo (a = 1/2), W = 4 y p2 = 1. El precio baja de p1^0 = 1 a p1^1 = 1/2.
% Recta inicial (gruesa) x1 + x2 = 4, elección B = (2; 2) en U^0 = 2; recta final (punteada) x1/2 + x2 = 4, elección
% C = (4; 2) en U^1 = 2,828.
% Recta equivalente (discontinua): precios iniciales y gasto E(p^0, U^1) = 2 U^1 = 5,657, tangente a U^1 en
% B' = (2,828; 2,828). VE = E(p^0, U^1) - W = 5,657 - 4 = 1,657 (llave en el eje vertical).
% Escala: 1 unidad = 0,9 cm en los dos ejes.
% Generar con: bash Code/generar_figura.sh anx_ve
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=0.9cm, y=0.9cm]
  \draw[->] (0,0) -- (8.8,0) node[below] {$x_1$};
  \draw[->] (0,0) -- (0,6.3) node[left] {$x_2$};
  % curvas de indiferencia
  \draw[thick] plot[domain=0.75:7.6, samples=80] (\x,{4/\x}) node[right] {$U^0$};
  \draw[thick] plot[domain=1.42:8.4, samples=80] (\x,{8/\x}) node[right] {$U^1$};
  % rectas de balance
  \draw[very thick] (0,4) -- (4,0);
  \draw[dotted, thick] (0,4) -- (8,0);
  \draw[thick, dashed] (0,5.6569) -- (5.6569,0);
  % puntos
  \fill (2,2) circle (1.7pt) node[below left] {$B$};
  \fill (4,2) circle (1.7pt) node[above right] {$C$};
  \fill (2.8284,2.8284) circle (1.7pt) node[above right] {$B'$};
  % gastos en el eje vertical y variación equivalente
  \node[left] at (-0.55,5.6569) {$E(p^0,U^1)$};
  \node[left] at (-0.55,4) {$W$};
  \draw[decorate, decoration={brace, amplitude=3pt, mirror}] (-0.12,5.6569) -- (-0.12,4) node[midway, left=4pt] {VE};
\end{tikzpicture}
