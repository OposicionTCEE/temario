% Figura (Anexo I, «Identidad de ROY»): la demanda es el cociente de las dos pendientes de la función indirecta de utilidad.
% COBB-DOUGLAS con a = 1/2 y p_2 = 1: V(p, W) = W / c(p), c(p) = 2 p_1^{1/2}. Cesta B de las figuras anteriores: p_1 = 1, W = 4,
% V = 2, x_1 = 2.
% (a) Con p_1 = 1, V = W/2: recta de pendiente lambda = 1/2 (triángulo de lados 1 y lambda en B = (4; 2)).
% (b) Con W = 4, V = 2/p_1^{1/2}: en p_1 = 1 la pendiente es -1 = -lambda x_1 (tangente discontinua V = 3 - p_1;
%     triángulo de lados 1 y lambda x_1 entre (1; 2), (2; 2) y (2; 1)).
% Escala: (a) W, 1 unidad = 0,75 cm; (b) p_1, 1 unidad = 1,6 cm; V, 1 unidad = 1 cm en los dos.
% Generar con: bash Code/generar_figura.sh anx_roy
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  % ---------------- (a) Utilidad máxima y renta ----------------
  \begin{scope}[x=0.75cm, y=1cm]
    \node[font=\footnotesize\bfseries] at (3.6,4.05) {(a) Utilidad máxima y renta};
    \draw[->] (0,0) -- (7.4,0) node[below] {$W$};
    \draw[->] (0,0) -- (0,3.7) node[left] {$V$};
    \draw[very thick] (0,0) -- (6.9,3.45) node[right] {$V(p,W)$};
    \draw[dotted] (4,0) node[below] {$W^0$} -- (4,2);
    \draw[dotted] (0,2) node[left] {$U$} -- (4,2);
    \draw (4,2) -- (5,2) node[midway, below] {$1$} -- (5,2.5) node[midway, right] {$\lambda$};
    \fill (4,2) circle (1.5pt) node[above left] {$B$};
  \end{scope}
  % ---------------- (b) Utilidad máxima y precio ----------------
  \begin{scope}[xshift=7.6cm, x=1.6cm, y=1cm]
    \node[font=\footnotesize\bfseries] at (1.65,4.05) {(b) Utilidad máxima y precio};
    \draw[->] (0,0) -- (3.5,0) node[below] {$p_1$};
    \draw[->] (0,0) -- (0,3.7) node[left] {$V$};
    \draw[very thick] plot[domain=0.32:3.2, samples=120] (\x,{2/sqrt(\x)}) node[above] {$V(p,W)$};
    \draw[thick, dashed] (0.35,2.65) -- (2.35,0.65);
    \draw[dotted] (1,0) node[below] {$p_1^1$} -- (1,2);
    \draw[dotted] (0,2) node[left] {$U$} -- (1,2);
    \draw (1,2) -- (1,1) node[midway, left] {$\lambda\,x_1$} -- (2,1) node[midway, below] {$1$};
    \fill (1,2) circle (1.5pt) node[above right] {$B$};
  \end{scope}
\end{tikzpicture}
