% Figura (Anexo III, «Variación compensatoria»): una bajada del precio del bien 1 en el espacio de bienes.
% Preferencias COBB-DOUGLAS del primer anexo (a = 1/2), W = 4 y p2 = 1, de modo que la ordenada en el origen de cada
% recta de balance es un gasto. El precio baja de p1^0 = 1 a p1^1 = 1/2.
% Recta inicial (punteada) x1 + x2 = 4, elección B = (2; 2) en U^0 = 2 (curva x1 x2 = 4); recta final (gruesa)
% x1/2 + x2 = 4, elección C = (4; 2) en U^1 = 2,828 (curva x1 x2 = 8).
% Recta compensada (discontinua): precios finales y gasto E(p^1, U^0) = 2 U^0 raiz(p1) = 2,828, tangente a U^0 en
% C' = (2,828; 1,414). VC = W - E(p^1, U^0) = 4 - 2,828 = 1,172 (llave en el eje vertical).
% Escala: 1 unidad = 0,9 cm en los dos ejes.
% Generar con: bash Code/generar_figura.sh anx_vc
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=0.9cm, y=0.9cm]
  \draw[->] (0,0) -- (8.8,0) node[below] {$x_1$};
  \draw[->] (0,0) -- (0,6.3) node[left] {$x_2$};
  % curvas de indiferencia
  \draw[thick] plot[domain=0.75:7.6, samples=80] (\x,{4/\x}) node[right] {$U^0$};
  \draw[thick] plot[domain=1.42:8.4, samples=80] (\x,{8/\x}) node[right] {$U^1$};
  % rectas de balance
  \draw[dotted, thick] (0,4) -- (4,0);
  \draw[very thick] (0,4) -- (8,0);
  \draw[thick, dashed] (0,2.8284) -- (5.6569,0);
  % puntos
  \fill (2,2) circle (1.7pt) node[below left] {$B$};
  \fill (4,2) circle (1.7pt) node[above right] {$C$};
  \fill (2.8284,1.4142) circle (1.7pt) node[below left] {$C'$};
  % gastos en el eje vertical y variación compensatoria
  \node[left] at (-0.55,4) {$W$};
  \node[left] at (-0.55,2.8284) {$E(p^1,U^0)$};
  \draw[decorate, decoration={brace, amplitude=3pt, mirror}] (-0.12,4) -- (-0.12,2.8284) node[midway, left=4pt] {VC};
\end{tikzpicture}
