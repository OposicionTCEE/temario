% Figura (Anexo III, «LASPEYRES y PAASCHE»): los índices de cestas fijas frente al índice verdadero.
% Preferencias COBB-DOUGLAS del primer anexo (a = 1/2), W = 4, p2 = 1: la ordenada en el origen de cada recta es un
% gasto. El precio del bien 1 pasa de p1^0 = 1 a p1^1 = 4. Índice verdadero: raiz(4) = 2 con cualquier utilidad.
% (a) LASPEYRES: cesta inicial x^0 = (2; 2) en U^0 = 2 (curva x1 x2 = 4), elegida con la recta inicial x1 + x2 = 4
%     (punteada). Con los precios finales cuesta p^1·x^0 = 10 (recta x2 = 10 - 4 x1, discontinua), pero U^0 se
%     alcanza con E(p^1, U^0) = 8 en h(p^1, U^0) = (1; 4) (recta x2 = 8 - 4 x1, gruesa). P_L = 2,5 > 2.
% (b) PAASCHE: cesta final x^1 = (0,5; 2) en U^1 = 1 (curva x1 x2 = 1), elegida con la recta final 4 x1 + x2 = 4
%     (punteada). Con los precios iniciales costaría p^0·x^1 = 2,5 (recta x2 = 2,5 - x1, discontinua), pero U^1 se
%     alcanza con E(p^0, U^1) = 2 en h(p^0, U^1) = (1; 1) (recta x2 = 2 - x1, gruesa). P_P = 4/2,5 = 1,6 < 2.
% Escala: (a) x1, 1 unidad = 1,5 cm; x2, 1 unidad = 0,45 cm. (b) 1 unidad = 1,5 cm en los dos ejes.
% Generar con: bash Code/generar_figura.sh anx_laspeyres_paasche
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  % ---------------- (a) LASPEYRES ----------------
  \begin{scope}[x=1.5cm, y=0.45cm]
    \node[font=\footnotesize\bfseries] at (1.6,11.9) {(a) LASPEYRES: cota superior};
    \draw[->] (0,0) -- (3.4,0) node[below] {$x_1$};
    \draw[->] (0,0) -- (0,11.2) node[left] {$x_2$};
    \draw[thick] plot[domain=0.37:3.2, samples=80] (\x,{4/\x}) node[right] {$U^0$};
    \draw[dotted, thick] (0,4) -- (3.4,0.6);
    \draw[thick, dashed] (0,10) -- (2.5,0);
    \draw[very thick] (0,8) -- (2,0);
    \fill (2,2) circle (1.7pt) node[above right] {$x^0$};
    \fill (1,4) circle (1.7pt) node[below left] {$h(p^1,U^0)$};
    \node[left] at (-0.42,10) {$p^1\!\cdot x^0$};
    \node[left] at (-0.42,8) {$E(p^1,U^0)$};
    \draw[decorate, decoration={brace, amplitude=3pt, mirror}] (-0.07,10) -- (-0.07,8) node[midway, left=3pt, font=\scriptsize] {sesgo};
  \end{scope}
  % ---------------- (b) PAASCHE ----------------
  \begin{scope}[xshift=8.6cm, x=1.5cm, y=1.5cm]
    \node[font=\footnotesize\bfseries] at (1.5,3.57) {(b) PAASCHE: cota inferior};
    \draw[->] (0,0) -- (3.2,0) node[below] {$x_1$};
    \draw[->] (0,0) -- (0,3.36) node[left] {$x_2$};
    \draw[thick] plot[domain=0.31:3.0, samples=80] (\x,{1/\x}) node[right] {$U^1$};
    \draw[dotted, thick] (0.2,3.2) -- (1,0);
    \draw[thick, dashed] (0,2.5) -- (2.5,0);
    \draw[very thick] (0,2) -- (2,0);
    \fill (0.5,2) circle (1.7pt) node[above right] {$x^1$};
    \fill (1,1) circle (1.7pt);
    \draw[->, thin] (2.05,1.5) node[right] {$h(p^0,U^1)$} -- (1.06,1.04);
    \node[left] at (-0.14,2.5) {$p^0\!\cdot x^1$};
    \node[left] at (-0.14,2) {$E(p^0,U^1)$};
    \draw[decorate, decoration={brace, amplitude=2.5pt, mirror}] (-0.04,2.5) -- (-0.04,2) node[midway, left=2pt, font=\scriptsize] {sesgo};
  \end{scope}
\end{tikzpicture}
