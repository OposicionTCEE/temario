% Figura (cuerpo, cierre del bloque 1): las relaciones de dualidad, con lo que se observa y lo que no.
% Versión del cuerpo de anx_esquema_dualidad: marco continuo y grueso para lo que se observa (la demanda marshalliana) y
% discontinuo para lo que no se observa (preferencias, funciones de valor y demanda hicksiana), con una leyenda; la flecha de la
% integrabilidad, continua y gruesa, porque es la única que parte de algo que se observa.
% Generar con: bash Code/generar_figura.sh b1_esquema_dualidad
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]},
    noobs/.style={draw, thick, dashed, rounded corners=2pt, align=center, inner sep=3pt},
    obs/.style={draw, very thick, rounded corners=2pt, align=center, inner sep=3pt}]
  \node[noobs, minimum width=3.9cm, minimum height=1.25cm] (V) at (-5.6,0) {\textbf{Función indirecta}\\[-1pt]\textbf{de utilidad}\\[1pt] $V(p,W)$};
  \node[noobs, minimum width=2.6cm, minimum height=1.25cm] (P) at (0,0) {\textbf{Preferencias}\\[2pt] $u(x)$};
  \node[noobs, minimum width=3.9cm, minimum height=1.25cm] (E) at (5.6,0) {\textbf{Función de gasto}\\[2pt] $E(p,U)$};
  \node[obs, minimum width=3.9cm, minimum height=1.0cm] (x) at (-5.6,-2.7) {Demanda marshalliana\\[2pt] $x(p,W)$};
  \node[noobs, minimum width=3.9cm, minimum height=1.0cm] (h) at (5.6,-2.7) {Demanda hicksiana\\[2pt] $h(p,U)$};
  % Preferencias <-> función indirecta de utilidad
  \draw[->] ([yshift=0.18cm]P.west) -- node[above] {$\max\ u(x)$} ([yshift=0.18cm]V.east);
  \draw[->] ([yshift=-0.18cm]V.east) -- node[below] {$\min_p V(p,p\cdot x)$} ([yshift=-0.18cm]P.west);
  % Preferencias <-> función de gasto
  \draw[->] ([yshift=0.18cm]P.east) -- node[above] {$\min\ p\cdot x$} ([yshift=0.18cm]E.west);
  \draw[->] ([yshift=-0.18cm]E.west) -- node[below] {envolvente} ([yshift=-0.18cm]P.east);
  % Funciones de valor inversas
  \draw[<->] (V.north) to[out=35, in=145] node[above] {inversas: $V(p,\cdot)=E^{-1}(p,\cdot)$} (E.north);
  % Demandas
  \draw[->] (V.south) -- node[left] {ROY} (x.north);
  \draw[->] (E.south) -- node[right] {SHEPHARD} (h.north);
  \draw[<->] (x.east) -- node[below] {SLUTSKY} (h.west);
  % Integrabilidad
  \draw[->, very thick] (x.north east) -- node[above, sloped] {integrabilidad} (E.south west);
  % Leyenda
  \node[obs, minimum width=0.7cm, minimum height=0.32cm, inner sep=0pt] (l1) at (-1.9,-4.05) {};
  \node[right=2pt of l1] {se observa};
  \node[noobs, minimum width=0.7cm, minimum height=0.32cm, inner sep=0pt] (l2) at (1.0,-4.05) {};
  \node[right=2pt of l2] {no se observa};
\end{tikzpicture}
