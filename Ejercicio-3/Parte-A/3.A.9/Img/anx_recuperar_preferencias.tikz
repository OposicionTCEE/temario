% Figura (Anexo I, «Gasto: ¿cómo y cuándo obtiene las preferencias?»): de la función de gasto a la curva de indiferencia, en tres pasos.
% COBB-DOUGLAS con a = 1/2 y U = 2: la curva que se busca es x_1 x_2 = 4 (punteada en (a) y (b)). Con el cociente de precios
% p_1/p_2 = 4/t^2, la recta de gasto mínimo es tangente a la curva en (t; 4/t): x_2 = 8/t - (4/t^2) x_1. Cada precio descarta las
% cestas que quedan por debajo de su recta; el área gris es lo que queda: el semiplano en (a), la intersección de tres semiplanos
% en (b) y la de ocho en (c), que ya casi coincide con el contorno superior de la curva (envolvente, gruesa en (c)).
% (a) t = 2: x_2 = 4 - x_1. (b) t = 1, 2 y 4: x_2 = 8 - 4 x_1, 4 - x_1, 2 - 0,25 x_1.
% (c) t = 0,7; 0,9; 1,2; 1,6; 2,1; 2,8; 3,7 y 4,9.
% Escala: 1 unidad = 0,85 cm; recorte [0; 5,2]^2; paneles separados 5,2 cm.
% Generar con: bash Code/generar_figura.sh anx_recuperar_preferencias
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=0.85cm, y=0.85cm]
  % ---------------- (a) Un precio ----------------
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (2.7,6.0) {(a) Un precio};
    \begin{scope}
      \clip (0,0) rectangle (5.2,5.2);
      \fill[gray!18] (0,4) -- (4,0) -- (5.2,0) -- (5.2,5.2) -- (0,5.2) -- cycle;
      \draw[thin] (0,4) -- (4,0);
      \draw[dotted, thick] plot[domain=0.77:5.2, samples=120] (\x,{4/\x});
    \end{scope}
    \draw[->] (0,0) -- (5.5,0) node[below] {$x_1$};
    \draw[->] (0,0) -- (0,5.5) node[left] {$x_2$};
  \end{scope}
  % ---------------- (b) Tres precios ----------------
  \begin{scope}[xshift=5.2cm]
    \node[font=\footnotesize\bfseries] at (2.7,6.0) {(b) Tres precios};
    \begin{scope}
      \clip (0,0) rectangle (5.2,5.2);
      \fill[gray!18] plot[domain=0:5.2, samples=240] (\x,{max(8-4*\x,4-\x,2-0.25*\x,0)}) -- (5.2,5.2) -- (0,5.2) -- cycle;
      \draw[thin] (0,8) -- (2,0);
      \draw[thin] (0,4) -- (4,0);
      \draw[thin] (0,2) -- (8,0);
      \draw[dotted, thick] plot[domain=0.77:5.2, samples=120] (\x,{4/\x});
    \end{scope}
    \draw[->] (0,0) -- (5.5,0) node[below] {$x_1$};
    \draw[->] (0,0) -- (0,5.5) node[left] {$x_2$};
  \end{scope}
  % ---------------- (c) Todos los precios ----------------
  \begin{scope}[xshift=10.4cm]
    \node[font=\footnotesize\bfseries] at (2.7,6.0) {(c) Todos los precios};
    \begin{scope}
      \clip (0,0) rectangle (5.2,5.2);
      \fill[gray!18] plot[domain=0:5.2, samples=300] (\x,{max(11.429-8.163*\x,8.889-4.938*\x,6.667-2.778*\x,5-1.5625*\x,3.810-0.9070*\x,2.857-0.5102*\x,2.162-0.2922*\x,1.633-0.1666*\x,0)}) -- (5.2,5.2) -- (0,5.2) -- cycle;
      \foreach \t in {0.7,0.9,1.2,1.6,2.1,2.8,3.7,4.9} {
        \draw[thin] (0,{8/\t}) -- ({2*\t},0);
      }
      \draw[very thick] plot[domain=0.77:5.2, samples=120] (\x,{4/\x});
    \end{scope}
    \draw[->] (0,0) -- (5.5,0) node[below] {$x_1$};
    \draw[->] (0,0) -- (0,5.5) node[left] {$x_2$};
    \node[above] at (5.0,0.8) {$U$};
  \end{scope}
\end{tikzpicture}
