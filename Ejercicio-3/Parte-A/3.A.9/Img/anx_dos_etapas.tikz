% Figura (Anexo II, «La separabilidad débil y la segunda etapa»): el árbol de utilidad y el presupuesto en dos etapas.
% (a) Separabilidad débil (árbol de utilidad de STROTZ, 1957): u = f(v_1(x^1), v_2(x^2), v_3(x^3)); siete bienes en tres grupos
%     (alimentación: x_1-x_3; vivienda: x_4-x_5; resto: x_6-x_7).
% (b) Presupuesto en dos etapas (GORMAN, 1959): primera etapa, el gasto total W se reparte entre los grupos con sus índices de
%     precios, W_g = W_g(P_1, P_2, P_3, W); segunda etapa, el gasto de cada grupo se reparte entre sus bienes, x_i = g_i(p^g, W_g).
% Las dos ramas tienen la misma forma para que se lean una sobre otra. Ancho: 15,8 cm.
% Generar con: bash Code/generar_figura.sh anx_dos_etapas
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]},
    raiz/.style={draw, thick, rounded corners=2pt, align=center, minimum height=0.7cm, inner sep=3pt},
    grupo/.style={draw, rounded corners=2pt, align=center, minimum width=2.3cm, inner sep=2.5pt},
    bien/.style={draw, circle, inner sep=1.2pt, minimum size=0.62cm}]
  % ---------------- (a) Árbol de utilidad ----------------
  \node[font=\footnotesize\bfseries, anchor=west] at (0,0.85) {(a) Separabilidad débil: el árbol de utilidad};
  \node[raiz] (u) at (7.5,0) {$u$};
  \node[anchor=west] at (8.0,0) {$u=f\big(v_1(x^1),\,v_2(x^2),\,v_3(x^3)\big)$};
  \node[grupo] (v1) at (3.0,-1.5) {$v_1(x^1)$\\[-1pt]{\scriptsize Alimentación}};
  \node[grupo] (v2) at (7.5,-1.5) {$v_2(x^2)$\\[-1pt]{\scriptsize Vivienda}};
  \node[grupo] (v3) at (12.0,-1.5) {$v_3(x^3)$\\[-1pt]{\scriptsize Resto}};
  \foreach \g in {v1,v2,v3} \draw[->] (u) -- (\g);
  \node[bien] (a1) at (1.9,-3.0) {$x_1$};
  \node[bien] (a2) at (3.0,-3.0) {$x_2$};
  \node[bien] (a3) at (4.1,-3.0) {$x_3$};
  \node[bien] (a4) at (6.95,-3.0) {$x_4$};
  \node[bien] (a5) at (8.05,-3.0) {$x_5$};
  \node[bien] (a6) at (11.45,-3.0) {$x_6$};
  \node[bien] (a7) at (12.55,-3.0) {$x_7$};
  \foreach \b in {a1,a2,a3} \draw[->] (v1) -- (\b);
  \foreach \b in {a4,a5} \draw[->] (v2) -- (\b);
  \foreach \b in {a6,a7} \draw[->] (v3) -- (\b);
  % ---------------- (b) Presupuesto en dos etapas ----------------
  \begin{scope}[yshift=-5.0cm]
    \node[font=\footnotesize\bfseries, anchor=west] at (0,0.85) {(b) El presupuesto en dos etapas};
    \node[raiz] (W) at (7.5,0) {$W$};
    \node[grupo] (W1) at (3.0,-1.5) {$W_1,\ P_1$\\[-1pt]{\scriptsize Alimentación}};
    \node[grupo] (W2) at (7.5,-1.5) {$W_2,\ P_2$\\[-1pt]{\scriptsize Vivienda}};
    \node[grupo] (W3) at (12.0,-1.5) {$W_3,\ P_3$\\[-1pt]{\scriptsize Resto}};
    \foreach \g in {W1,W2,W3} \draw[->] (W) -- (\g);
    \node[bien] (b1) at (1.9,-3.0) {$x_1$};
    \node[bien] (b2) at (3.0,-3.0) {$x_2$};
    \node[bien] (b3) at (4.1,-3.0) {$x_3$};
    \node[bien] (b4) at (6.95,-3.0) {$x_4$};
    \node[bien] (b5) at (8.05,-3.0) {$x_5$};
    \node[bien] (b6) at (11.45,-3.0) {$x_6$};
    \node[bien] (b7) at (12.55,-3.0) {$x_7$};
    \foreach \b in {b1,b2,b3} \draw[->] (W1) -- (\b);
    \foreach \b in {b4,b5} \draw[->] (W2) -- (\b);
    \foreach \b in {b6,b7} \draw[->] (W3) -- (\b);
    \node[anchor=west, align=left] at (0,-0.75) {\textbf{Primera etapa}};
    \node[anchor=west] at (13.35,-0.75) {$W_g(P_1,P_2,P_3,W)$};
    \node[anchor=west, align=left] at (0,-2.25) {\textbf{Segunda etapa}};
    \node[anchor=west] at (13.35,-2.25) {$x_i=g_i(p^g,W_g)$};
  \end{scope}
\end{tikzpicture}
