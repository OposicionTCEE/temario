% Figura (Anexo II, «La elección de la función de referencia: tres vías»): de dónde sale cada sistema de demanda.
% Vía primal: u(x) -> maximización -> x(p,W) (LES). Vía dual: E(p,U) o V(p,W) -> SHEPHARD o ROY -> omega(p,W) (translog, AIDS,
% QUAIDS, EASI). Vía diferencial: diferencial de una demanda cualquiera + SLUTSKY -> coeficientes constantes (Rotterdam).
% Las dos primeras cumplen las restricciones por construcción; la tercera las impone sobre los parámetros. Ancho: 15,6 cm.
% Generar con: bash Code/generar_figura.sh anx_vias_sistemas
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]},
    origen/.style={draw, thick, rounded corners=2pt, align=center, minimum width=4.4cm, minimum height=1.1cm, inner sep=3pt},
    sistema/.style={draw, rounded corners=2pt, align=center, minimum width=4.4cm, minimum height=1.0cm, inner sep=3pt}]
  % Cabeceras
  \node[font=\footnotesize\bfseries] at (0,1.15) {Vía primal};
  \node[font=\footnotesize\bfseries] at (5.6,1.15) {Vía dual};
  \node[font=\footnotesize\bfseries] at (11.2,1.15) {Vía diferencial};
  % Puntos de partida
  \node[origen] (u) at (0,0) {Función de utilidad\\[2pt] $u(x)$};
  \node[origen] (e) at (5.6,0) {Función de gasto o indirecta\\[2pt] $E(p,U)$\quad o\quad $V(p,W)$};
  \node[origen] (d) at (11.2,0) {Diferencial de una demanda\\[2pt] $dx_i(p,W)$};
  % Sistemas
  \node[sistema] (xu) at (0,-2.6) {$x(p,W)$};
  \node[sistema] (xe) at (5.6,-2.6) {$\omega_i=\dfrac{\partial\ln E}{\partial\ln p_i}$};
  \node[sistema] (xd) at (11.2,-2.6) {$\omega_i\,d\ln x_i=b_i\,d\ln\bar Q+\sum_j c_{ij}\,d\ln p_j$};
  % Operaciones
  \draw[->] (u) -- node[right, align=left] {$\max\ u(x)$\\ s.a. $p\cdot x=W$} (xu);
  \draw[->] (e) -- node[right, align=left] {SHEPHARD\\ o ROY} (xe);
  \draw[->] (d) -- node[right, align=left] {SLUTSKY y\\ coeficientes\\ constantes} (xd);
  % Ejemplos
  \node[align=center] at (0,-3.75) {LES};
  \node[align=center] at (5.6,-3.75) {Translog, AIDS, QUAIDS, EASI};
  \node[align=center] at (11.2,-3.75) {Rotterdam};
  % Restricciones
  \draw[decorate, decoration={brace, mirror, amplitude=5pt}] (-2.2,-4.2) -- (7.8,-4.2)
    node[midway, below=6pt] {Restricciones: por construcción};
  \draw[decorate, decoration={brace, mirror, amplitude=5pt}] (9.0,-4.2) -- (13.4,-4.2)
    node[midway, below=6pt] {Restricciones: sobre los parámetros};
\end{tikzpicture}
