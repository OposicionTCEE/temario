% Figura (Anexo I, «Contrastación»): lo que se observa y lo que se construye.
% Mismos datos que anx_slutsky_descomposicion, con el precio en ordenadas: demanda marshalliana x_1 = 2/p_1 (gruesa), que pasa por
% B (p_1^1 = 1) y C (p_1^2 = 1/2), y demandas hicksianas h_1(p,U^0) = 2 p_1^{-1/2}, por B y C', y h_1(p,U^1) = 2,828 p_1^{-1/2}, por C
% (discontinuas). B y C (puntos llenos) se observan; C' (punto hueco) es la elección de un consumidor compensado, que no se observa.
% Escala: x_1, 1 unidad = 1 cm; p_1, 1 unidad = 3 cm. Sustituye al panel (b) de anx_slutsky.
% Generar con: bash Code/generar_figura.sh anx_slutsky_observable
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1cm, y=3cm]
  \draw[->] (0,0) -- (6.4,0) node[below] {$x_1$};
  \draw[->] (0,0) -- (0,1.66) node[left] {$p_1$};
  \draw[very thick] plot[domain=0.34:1.5, samples=90] ({2/\x},\x);
  \node[left] at (1.333,1.5) {$x_1(p,W)$};
  \draw[thick, dashed] plot[domain=0.12:1.5, samples=90] ({2/sqrt(\x)},\x);
  \node[above] at (1.633,1.5) {$h_1(p,U^0)$};
  \draw[thick, dashed] plot[domain=0.23:1.5, samples=90] ({2.828/sqrt(\x)},\x);
  \node[right] at (2.309,1.5) {$h_1(p,U^1)$};
  \draw[dotted] (0,1) node[left] {$p_1^1$} -- (2,1) -- (2,0);
  \draw[dotted] (0,0.5) node[left] {$p_1^2$} -- (4,0.5) -- (4,0);
  \draw[dotted] (2.828,0.5) -- (2.828,0);
  \fill (2,1) circle (1.6pt) node[above right] {$B$};
  \draw[fill=white] (2.828,0.5) circle (1.8pt) node[above right] {$C'$};
  \fill (4,0.5) circle (1.6pt) node[above right] {$C$};
\end{tikzpicture}
