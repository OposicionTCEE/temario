% Figura (Anexo II, «La forma de WORKING-LESER»): curvas de ENGEL en cantidades y en participaciones.
% Tres bienes con participaciones de WORKING-LESER (precios iguales a uno):
%   lujo       omega_L = 0,10 + 0,13 ln W
%   necesario  omega_N = 0,40 - 0,03 ln W
%   inferior   omega_I = 0,50 - 0,10 ln W   (necesario con gasto bajo; inferior desde ln W* = 4, donde omega_I = -beta_I = 0,1)
% Suman uno: 0,10 + 0,40 + 0,50 = 1 y 0,13 - 0,03 - 0,10 = 0.
% (a) Cantidades x_i = omega_i W para W en [1; 110], cada bien en sus propias unidades, normalizadas para que las tres curvas
%     pasen por el mismo punto en W* = e^4 = 54,6 (altura 2 cm): x_L(W*) = 33,85; x_N(W*) = 15,29; x_I(W*) = 5,46.
%     La recta desde el origen por ese punto es la de elasticidad unitaria: el bien de lujo la corta desde abajo, el necesario
%     desde arriba y el inferior tiene en W* pendiente nula. Eje W: 0,058 cm por unidad.
% (b) Participaciones frente a ln W en [0; 4,7]; la del bien inferior se prolonga (discontinua) hasta cero en ln W = 5.
%     Eje ln W: 1,2 cm por unidad; participación: 5 cm por unidad.
% Generar con: bash Code/generar_figura.sh anx_engel
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  % ---------------- (a) Curvas de ENGEL en cantidades ----------------
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (3.3,4.75) {(a) Curvas de ENGEL};
    \draw[->] (0,0) -- (6.9,0) node[below] {$W$};
    \draw[->] (0,0) -- (0,4.4) node[left] {$x_i$};
    \draw[dotted] (0,0) -- (6.38,4.03) node[right] {$\eta_i=1$};
    \draw[very thick] plot[domain=1:110, samples=120] ({0.058*\x},{(2/33.85)*(0.10+0.13*ln(\x))*\x}) node[right] {Lujo};
    \draw[very thick] plot[domain=1:110, samples=120] ({0.058*\x},{(2/15.29)*(0.40-0.03*ln(\x))*\x}) node[right] {Necesario};
    \draw[very thick] plot[domain=1:110, samples=120] ({0.058*\x},{(2/5.46)*(0.50-0.10*ln(\x))*\x}) node[right] {Inferior};
    \draw[dotted] (3.167,0) node[below] {$W^*$} -- (3.167,2);
    \fill (3.167,2) circle (1.5pt);
  \end{scope}
  % ---------------- (b) Participaciones de WORKING-LESER ----------------
  \begin{scope}[xshift=8.3cm, x=1.2cm, y=5cm]
    \node[font=\footnotesize\bfseries] at (2.6,0.95) {(b) Participaciones};
    \draw[->] (0,0) -- (5.4,0) node[below] {$\ln W$};
    \draw[->] (0,0) -- (0,0.88) node[left] {$\omega_i$};
    \draw[very thick] (0,0.10) -- (4.7,0.711) node[right] {Lujo};
    \draw[very thick] (0,0.40) -- (4.7,0.259) node[right] {Necesario};
    \draw[very thick] (0,0.50) -- (4.7,0.03);
    \draw[thick, dashed] (4.7,0.03) -- (5.0,0);
    \node[above right] at (3.1,0.19) {Inferior};
    \draw[dotted] (4,0.10) -- (4,0) node[below] {$\ln W^*$};
  \end{scope}
\end{tikzpicture}
