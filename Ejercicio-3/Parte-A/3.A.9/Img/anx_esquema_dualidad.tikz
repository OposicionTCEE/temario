% Figura (Anexo I, «El esquema de la dualidad»): las relaciones de dualidad en la teoría de la demanda.
% Mismo estilo que anx_esquema_dualidad del 3.A.12. Las preferencias en el centro; a la izquierda, el problema primal
% (máximo de la utilidad -> función indirecta de utilidad, y vuelta por el mínimo sobre los precios); a la derecha, el dual
% (mínimo del gasto -> función de gasto, y vuelta por la envolvente). Las dos funciones de valor son inversas. Las demandas se
% obtienen con ROY y SHEPHARD, SLUTSKY las relaciona, y la integrabilidad lleva de la demanda observada a la función de gasto.
% Sustituye a CD_esquema_dualidad (copiada de apuntes). Ancho: 15,1 cm.
% Generar con: bash Code/generar_figura.sh anx_esquema_dualidad
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]},
    caja/.style={draw, thick, rounded corners=2pt, align=center, minimum height=1.25cm, inner sep=3pt},
    demanda/.style={draw, rounded corners=2pt, align=center, minimum height=1.0cm, inner sep=3pt}]
  \node[caja, minimum width=3.9cm] (V) at (-5.6,0) {\textbf{Función indirecta}\\[-1pt]\textbf{de utilidad}\\[1pt] $V(p,W)$};
  \node[caja, minimum width=2.6cm] (P) at (0,0) {\textbf{Preferencias}\\[2pt] $u(x)$};
  \node[caja, minimum width=3.9cm] (E) at (5.6,0) {\textbf{Función de gasto}\\[2pt] $E(p,U)$};
  \node[demanda, minimum width=3.9cm] (x) at (-5.6,-2.7) {Demanda marshalliana\\[2pt] $x(p,W)$};
  \node[demanda, minimum width=3.9cm] (h) at (5.6,-2.7) {Demanda hicksiana\\[2pt] $h(p,U)$};
  % Preferencias <-> función indirecta de utilidad
  \draw[->] ([yshift=0.18cm]P.west) -- node[above] {$\max\ u(x)$} ([yshift=0.18cm]V.east);
  \draw[->] ([yshift=-0.18cm]V.east) -- node[below] {$\min_p V(p,p\cdot x)$} ([yshift=-0.18cm]P.west);
  % Preferencias <-> función de gasto
  \draw[->] ([yshift=0.18cm]P.east) -- node[above] {$\min\ p\cdot x$} ([yshift=0.18cm]E.west);
  \draw[->] ([yshift=-0.18cm]E.west) -- node[below] {envolvente} ([yshift=-0.18cm]P.east);
  % Funciones de valor inversas
  \draw[<->] (V.north) to[out=35, in=145] node[above] {inversas: $V(p,\cdot)=E^{-1}(p,\cdot)$} (E.north);
  % Demandas
  \draw[->] (V.south) -- node[left] {ROY} (x.north);
  \draw[->] (E.south) -- node[right] {SHEPHARD} (h.north);
  \draw[<->] (x.east) -- node[below] {SLUTSKY} (h.west);
  % Integrabilidad
  \draw[->, thick, dashed] (x.north east) -- node[above, sloped] {integrabilidad} (E.south west);
\end{tikzpicture}
