% Figura (Anexo I, «Función de gasto» y «Lema de SHEPHARD»): la función de gasto es la envolvente inferior de las rectas del
% consumidor pasivo, y su pendiente es la demanda compensada. Sustituye a anx_concavidad_gasto.
% COBB-DOUGLAS con a = 1/2, p_2 = 1 y U = 2: E(p_1) = U c(p) = 4 p_1^{1/2}. Cestas de la figura de la demanda hicksiana:
% A' = (1,414; 2,828), óptima con p_1 = 2; B = (2; 2), con p_1 = 1; C' = (2,828; 1,414), con p_1 = 1/2.
% (a) Rectas del consumidor pasivo (gasto de mantener cada cesta): A': 1,414 p_1 + 2,828; B: 2 p_1 + 2; C': 2,828 p_1 + 1,414.
%     Cada una toca E en el precio en que su cesta es la óptima, con pendiente igual a la cantidad del bien 1 de la cesta.
% (b) Demanda compensada h_1 = 2/p_1^{1/2} con el precio en abscisas: la altura de (b) es la pendiente de (a).
% Escala: p_1, 1 unidad = 1,7 cm en los dos paneles; (a) gasto, 1 unidad = 0,55 cm; (b) cantidad, 1 unidad = 0,9 cm.
% Generar con: bash Code/generar_figura.sh anx_shephard
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  % ---------------- (a) Función de gasto ----------------
  \begin{scope}[x=1.7cm, y=0.55cm]
    \node[font=\footnotesize\bfseries] at (1.7,8.75) {(a) Función de gasto y consumidores pasivos};
    \draw[->] (0,0) -- (3.4,0) node[below] {$p_1$};
    \draw[->] (0,0) -- (0,8.2) node[left] {Gasto};
    \begin{scope}
      \clip (0,0) rectangle (3.1,7.9);
      \draw[thin] (0,2.828) -- (3.1,7.212);
      \draw[thin] (0,2) -- (3.1,8.2);
      \draw[thin] (0,1.414) -- (3.1,10.18);
    \end{scope}
    \draw[very thick] plot[domain=0:3.05, samples=150] (\x,{4*sqrt(\x)}) node[right] {$E(p,U)$};
    \fill (2,5.657) circle (1.5pt) node[below right] {$A'$};
    \fill (1,4) circle (1.5pt) node[below right] {$B$};
    \fill (0.5,2.828) circle (1.5pt) node[below right] {$C'$};
  \end{scope}
  % ---------------- (b) Demanda compensada ----------------
  \begin{scope}[yshift=-6.4cm, x=1.7cm, y=0.9cm]
    \node[font=\footnotesize\bfseries] at (1.7,4.3) {(b) Demanda compensada};
    \draw[->] (0,0) -- (3.4,0) node[below] {$p_1$};
    \draw[->] (0,0) -- (0,4.0) node[left] {$x_1$};
    \draw[very thick] plot[domain=0.3:3.05, samples=150] (\x,{2/sqrt(\x)}) node[above] {$h_1(p,U)$};
    \fill (2,1.414) circle (1.5pt) node[above right] {$A'$};
    \fill (1,2) circle (1.5pt) node[above right] {$B$};
    \fill (0.5,2.828) circle (1.5pt) node[above right] {$C'$};
    \node[below] at (0.5,0) {$p_1^2$};
    \node[below] at (1,0) {$p_1^1$};
    \node[below] at (2,0) {$p_1^0$};
  \end{scope}
  % Líneas de puntos de cada contacto a su punto de la demanda (coordenadas absolutas), interrumpidas en el título de (b)
  \foreach \xa/\ya/\yb in {0.85/1.555/-3.855, 1.7/2.2/-4.6, 3.4/3.111/-5.127} {
    \draw[dotted] (\xa,\ya) -- (\xa,-2.25);
    \draw[dotted] (\xa,-2.75) -- (\xa,\yb);
  }
\end{tikzpicture}
