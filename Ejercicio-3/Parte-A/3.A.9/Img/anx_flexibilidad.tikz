% Figura (Anexo II, «La flexibilidad y la regularidad»): una forma flexible solo es fiable cerca del punto de aproximación.
% Función de gasto verdadera: CES de dos bienes con elasticidad de sustitución 4, p_2 = 1 y U = 1:
%   E(p_1) = (p_1^{-3} + 1)^{-1/3}; demanda compensada h_1 = E / (p_1 (1 + p_1^3)).
% Aproximación translog en p_1^0 = 1 (iguala nivel, pendiente y curvatura de ln E en ln p_1):
%   ln E_T = -(1/3) ln 2 + (1/2) ln p_1 - (3/8) (ln p_1)^2;  h_T = E_T (1/2 - (3/4) ln p_1) / p_1.
% La participación del translog, 1/2 - (3/4) ln p_1, se anula en bar p_1 = e^{2/3} = 1,948: desde ahí E_T decrece y h_T < 0.
% Escala: p_1, 1 unidad = 1,45 cm; gasto, 1 unidad = 3,6 cm; demanda, 1 unidad = 3 cm.
% Generar con: bash Code/generar_figura.sh anx_flexibilidad
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  % ---------------- (a) Función de gasto ----------------
  \begin{scope}[x=1.45cm, y=3.6cm]
    \node[font=\footnotesize\bfseries] at (2.15,1.26) {(a) Función de gasto};
    \draw[->] (0,0) -- (4.6,0) node[below] {$p_1$};
    \draw[->] (0,0) -- (0,1.15) node[left] {Gasto};
    \draw[very thick] plot[domain=0.12:4.1, samples=160] (\x,{pow(1/(\x*\x*\x)+1,-1/3)}) node[right] {$E(p,U)$};
    \draw[thick, dashed] plot[domain=0.12:4.1, samples=160] (\x,{0.7937*exp(0.5*ln(\x)-0.375*ln(\x)*ln(\x))}) node[right] {Translog};
    \draw[dotted] (1,0) node[below] {$p_1^0$} -- (1,0.7937);
    \draw[dotted] (1.948,0) node[below] {$\bar p_1$} -- (1.948,0.9377);
    \fill (1,0.7937) circle (1.5pt);
  \end{scope}
  % ---------------- (b) Demanda compensada ----------------
  \begin{scope}[xshift=8.5cm, x=1.45cm, y=3cm]
    \node[font=\footnotesize\bfseries] at (2.15,1.513) {(b) Demanda compensada};
    \draw[->] (0,0) -- (4.6,0) node[below] {$p_1$};
    \draw[->] (0,-0.25) -- (0,1.38) node[left] {$h_1$};
    \draw[very thick] plot[domain=0.22:4.1, samples=160] (\x,{pow(1/(\x*\x*\x)+1,-1/3)/(\x*(1+\x*\x*\x))});
    \node[above right] at (2.35,0.06) {$h_1(p,U)$};
    \draw[thick, dashed] plot[domain=0.22:4.1, samples=160] (\x,{0.7937*exp(0.5*ln(\x)-0.375*ln(\x)*ln(\x))*(0.5-0.75*ln(\x))/\x}) node[right] {Translog};
    \draw[dotted] (1,0) -- (1,0.3969);
    \node[below left] at (1,0) {$p_1^0$};
    \node[above] at (1.948,0) {$\bar p_1$};
    \fill (1,0.3969) circle (1.5pt);
    \fill (1.948,0) circle (1.5pt);
  \end{scope}
\end{tikzpicture}
