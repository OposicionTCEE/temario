% Figura (Anexo I, «Saciedad»): un punto de saturación y la identidad que falla.
% (a) Utilidad u = -(x_1 - 2)^2 - (x_2 - 1,5)^2, con punto de saturación hat x = (2; 1,5) y curvas de indiferencia circulares de
%     radios 0,5, 1 y 1,4. Precios p = (1; 1) y renta W = 5: conjunto presupuestario sombreado, recta de balance x_1 + x_2 = 5.
%     El consumidor elige hat x, que cuesta p.hat x = 3,5 < W; recta discontinua x_1 + x_2 = 3,5: gasto mínimo para su utilidad máxima.
% (b) Gasto mínimo para alcanzar la utilidad máxima, E(p, V(p, W)) = min(W; p.hat x) (gruesa), frente a la renta (diagonal
%     punteada): coinciden hasta W = p.hat x = 3,5 y después el gasto se queda en 3,5; la llave marca la renta sin gastar con W = 6.
% Escala: (a) 1 unidad = 0,9 cm; (b) 1 unidad = 0,75 cm.
% Generar con: bash Code/generar_figura.sh anx_saciedad
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  % ---------------- (a) Punto de saturación ----------------
  \begin{scope}[x=0.9cm, y=0.9cm]
    \node[font=\footnotesize\bfseries] at (2.9,6.15) {(a) Un punto de saturación};
    \fill[gray!15] (0,0) -- (5,0) -- (0,5) -- cycle;
    \draw[->] (0,0) -- (6.0,0) node[below] {$x_1$};
    \draw[->] (0,0) -- (0,5.7) node[left] {$x_2$};
    \draw[thin] (0,5) -- (5,0);
    \draw[thick, dashed] (0,3.5) -- (3.5,0);
    \foreach \r in {0.5,1.0,1.4} {
      \draw[thick] (2,1.5) circle (\r);
    }
    \fill (2,1.5) circle (1.6pt) node[above right] {$\hat x$};
    \node[below] at (5,0) {$W/p_1$};
    \node[below] at (3.5,0) {$p\cdot\hat x/p_1$};
  \end{scope}
  % ---------------- (b) La identidad que falla ----------------
  \begin{scope}[xshift=7.6cm, x=0.75cm, y=0.75cm]
    \node[font=\footnotesize\bfseries] at (3.6,7.38) {(b) Gasto mínimo y renta};
    \draw[->] (0,0) -- (7.4,0) node[below] {$W$};
    \draw[->] (0,0) -- (0,6.9) node[left] {Gasto};
    \draw[dotted] (0,0) -- (6.6,6.6) node[above right] {$W$};
    \draw[very thick] (0,0) -- (3.5,3.5) -- (6.8,3.5) node[right] {$E\big(p,V(p,W)\big)$};
    \draw[dotted] (3.5,3.5) -- (3.5,0) node[below] {$p\cdot\hat x$};
    \draw[decorate, decoration={brace, amplitude=4pt}] (6.15,3.55) -- (6.15,5.95) node[midway, right=5pt] {$W-p\cdot\hat x$};
    \draw[dotted] (6,3.5) -- (6,6);
  \end{scope}
\end{tikzpicture}
