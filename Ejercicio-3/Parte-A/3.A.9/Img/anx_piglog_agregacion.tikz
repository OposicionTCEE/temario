% Figura (Anexo II, «Preferencias PIGLOG»): la participación agregada es la de un consumidor con gasto W_0.
% Participación de WORKING-LESER común a todos los hogares: omega = 0,6 - 0,15 ln W.
% Tres hogares con ln W^h = 0,8, 1,8 y 2,8 (W^h = 2,226, 6,050 y 16,445; participaciones 0,48, 0,33 y 0,18).
% Participación agregada = media de las participaciones ponderada por el gasto = 0,2437, que es la de un hogar con
% ln W_0 = (sum W^h ln W^h)/(sum W^h) = 2,375 (punto hueco). La media del gasto es W barra = 8,24, ln W barra = 2,109:
% ln W_0 - ln W barra = 0,266 = índice de THEIL de la distribución del gasto (llave T).
% Escala: ln W, 1 unidad = 2,4 cm; participación, 1 unidad = 6,5 cm.
% Generar con: bash Code/generar_figura.sh anx_piglog_agregacion
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=2.4cm, y=6.5cm]
  \draw[->] (0,0) -- (3.55,0) node[below] {$\ln W$};
  \draw[->] (0,0) -- (0,0.68) node[left] {$\omega_i$};
  \draw[very thick] (0,0.6) -- (3.4,0.09) node[right] {$\omega_i=\alpha_i+\beta_i\ln W$};
  % hogares
  \fill (0.8,0.48) circle (1.6pt) node[above right] {$h=1$};
  \fill (1.8,0.33) circle (1.6pt) node[above right] {$h=2$};
  \fill (2.8,0.18) circle (1.6pt) node[above right] {$h=3$};
  % consumidor representativo
  \draw[dotted] (0,0.2437) node[left] {$\bar\omega_i$} -- (2.375,0.2437) -- (2.375,0);
  \draw[fill=white] (2.375,0.2437) circle (1.8pt);
  \draw[dotted] (2.109,0) -- (2.109,0.06);
  \node[below left] at (2.135,0) {$\ln\bar W$};
  \node[below right] at (2.35,0) {$\ln W_0$};
  \draw[decorate, decoration={brace, amplitude=3pt}] (2.109,0.075) -- (2.375,0.075) node[midway, above=3pt] {$T$};
\end{tikzpicture}
