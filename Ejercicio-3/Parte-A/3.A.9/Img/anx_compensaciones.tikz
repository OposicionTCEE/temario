% Figura (Anexo I, «Contrastación»): la compensación de HICKS y la de SLUTSKY.
% COBB-DOUGLAS u = (x_1 x_2)^{1/2}, p_2 = 1; cesta inicial B = (2; 2) con p_1 = 1 y W = 4 (recta x_1 + x_2 = 4, fina), U^0 = 2.
% El precio del bien 1 baja a 1/2. Compensación de HICKS (discontinua): renta 2,828, la justa para alcanzar U^0 a los precios nuevos,
% recta 0,5 x_1 + x_2 = 2,828, tangente a U^0 en C' = (2,828; 1,414). Compensación de SLUTSKY (trazo y punto): renta 3, la justa
% para comprar B a los precios nuevos, recta 0,5 x_1 + x_2 = 3, que pasa por B; con ella se elige S = (3; 1,5), con utilidad
% U_S = 4,5^{1/2} = 2,121 > U^0 (curva x_1 x_2 = 4,5, fina). Leyenda de las dos rectas arriba a la derecha.
% Escala: 1 unidad = 1 cm.
% Generar con: bash Code/generar_figura.sh anx_compensaciones
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1cm, y=1cm]
  \draw[->] (0,0) -- (6.8,0) node[below] {$x_1$};
  \draw[->] (0,0) -- (0,4.6) node[left] {$x_2$};
  \begin{scope}
    \clip (0,0) rectangle (6.5,4.4);
    \draw[thin] (0,4) -- (4,0);
    \draw[thick, dashed] (0,2.828) -- (5.657,0);
    \draw[thick, dash dot] (0,3) -- (6,0);
  \end{scope}
  \draw[very thick] plot[domain=0.92:6.4, samples=100] (\x,{4/\x}) node[below right] {$U^0$};
  \draw[thin] plot[domain=1.03:6.4, samples=100] (\x,{4.5/\x}) node[above right] {$U_S$};
  % Leyenda
  \draw[thick, dashed] (4.0,4.15) -- (4.7,4.15) node[right] {Compensación de HICKS};
  \draw[thick, dash dot] (4.0,3.7) -- (4.7,3.7) node[right] {Compensación de SLUTSKY};
  \fill (2,2) circle (1.5pt) node[above right] {$B$};
  \fill (2.828,1.414) circle (1.5pt) node[below left] {$C'$};
  \fill (3,1.5) circle (1.5pt) node[above right] {$S$};
\end{tikzpicture}
