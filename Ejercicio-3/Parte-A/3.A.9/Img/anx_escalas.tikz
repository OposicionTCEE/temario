% Figura (Anexo II, «Características del hogar»): escalas de equivalencia por los métodos de ENGEL y de ROTHBARTH.
% (a) ENGEL: participación de la alimentación de WORKING-LESER, omega_f = 0,65 - 0,15 ln W sin hijos (gruesa) y
%     omega_f = 0,71 - 0,15 ln W con un hijo (discontinua; delta_f = 0,06). Participación de referencia 0,35:
%     ln W^0 = 2,0 y ln W^1 = 2,4, de modo que ln m_E = -delta_f/beta_f = 0,4 (m_E = e^0,4 = 1,49).
% (b) ROTHBARTH: gasto en bienes de adultos, ln e_A = 0,2 + 0,8 ln W sin hijos (gruesa) y ln e_A = -0,05 + 0,8 ln W
%     con un hijo (discontinua; c_A = 0,25). Gasto de referencia ln e_A = 1,8: ln W^0 = 2,0 y ln W^1 = 2,3125, de modo
%     que ln m_R = c_A/b_A = 0,3125 (m_R = 1,37 < m_E).
% Las llaves, bajo el eje, miden el logaritmo de cada escala.
% Escala: (a) ln W, 1 unidad = 1,7 cm; participación, 1 unidad = 6,2 cm. (b) ln W, 1,7 cm; ln e_A, 1,5 cm.
% Generar con: bash Code/generar_figura.sh anx_escalas
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  % ---------------- (a) Método de ENGEL ----------------
  \begin{scope}[x=1.7cm, y=6.2cm]
    \node[font=\footnotesize\bfseries] at (1.75,0.84) {(a) Método de ENGEL};
    \draw[->] (0,0) -- (3.6,0) node[below] {$\ln W$};
    \draw[->] (0,0) -- (0,0.78) node[left] {$\omega_f$};
    \draw[very thick] (0,0.65) -- (3.4,0.14);
    \draw[thick, dashed] (0,0.71) -- (3.4,0.20);
    \node[above right, inner sep=1pt] at (0.95,0.60) {Con un hijo};
    \node[below left, inner sep=1pt] at (1.0,0.47) {Sin hijos};
    % desplazamiento delta
    \draw[<->] (0.45,0.5825) -- (0.45,0.6425);
    \node[right] at (0.45,0.6125) {$\delta_f$};
    % participación de referencia
    \draw[dotted] (0,0.35) node[left] {$\bar\omega_f$} -- (2.4,0.35);
    \draw[dotted] (2.0,0) -- (2.0,0.35);
    \draw[dotted] (2.4,0) -- (2.4,0.35);
    \fill (2.0,0.35) circle (1.6pt);
    \fill (2.4,0.35) circle (1.6pt);
    \node[below left, inner sep=1pt] at (2.05,-0.005) {$\ln W^0$};
    \node[below right, inner sep=1pt] at (2.35,-0.005) {$\ln W^1$};
    \draw[decorate, decoration={brace, amplitude=3pt, mirror}] (2.0,-0.075) -- (2.4,-0.075) node[midway, below=3pt] {$\ln m_E=-\delta_f/\beta_f$};
  \end{scope}
  % ---------------- (b) Método de ROTHBARTH ----------------
  \begin{scope}[xshift=7.6cm, x=1.7cm, y=1.5cm]
    \node[font=\footnotesize\bfseries] at (1.75,3.47) {(b) Método de ROTHBARTH};
    \draw[->] (0,0) -- (3.6,0) node[below] {$\ln W$};
    \draw[->] (0,0) -- (0,3.22) node[left] {$\ln e_A$};
    \draw[very thick] (0.25,0.4) -- (3.4,2.92);
    \draw[thick, dashed] (0.25,0.15) -- (3.4,2.67);
    \node[above left] at (3.05,2.64) {Sin hijos};
    \node[below right] at (2.85,2.2) {Con un hijo};
    % desplazamiento c
    \draw[<->] (0.9,0.67) -- (0.9,0.92);
    \node[right] at (0.9,0.795) {$c_A$};
    % gasto de referencia
    \draw[dotted] (0,1.8) node[left] {$\ln\bar e_A$} -- (2.3125,1.8);
    \draw[dotted] (2.0,0) -- (2.0,1.8);
    \draw[dotted] (2.3125,0) -- (2.3125,1.8);
    \fill (2.0,1.8) circle (1.6pt);
    \fill (2.3125,1.8) circle (1.6pt);
    \node[below left, inner sep=1pt] at (2.05,-0.02) {$\ln W^0$};
    \node[below right, inner sep=1pt] at (2.26,-0.02) {$\ln W^1$};
    \draw[decorate, decoration={brace, amplitude=3pt, mirror}] (2.0,-0.31) -- (2.3125,-0.31) node[midway, below=3pt] {$\ln m_R=c_A/b_A$};
  \end{scope}
\end{tikzpicture}
