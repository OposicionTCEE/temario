% Figura (Anexo III, «Excedente del consumidor»): excedente y su variación con una demanda lineal abstracta.
% Demanda inversa p = 8 - x. Con p^0 = 5 se compra x^0 = 3 y el excedente es el triángulo (0;8)-(0;5)-(3;5)
% (gris claro). Si el precio baja a p^1 = 3, se compra x^1 = 5 y el excedente aumenta en el rectángulo
% (p^0 - p^1) x^0, lo que se ahorra en las unidades que ya se compraban (gris oscuro), más el triángulo de las
% unidades nuevas, (3;5)-(3;3)-(5;3) (gris medio).
% Escala: 1 unidad = 0,75 cm en los dos ejes.
% Generar con: bash Code/generar_figura.sh anx_excedente
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=0.75cm, y=0.75cm]
  % áreas
  \fill[gray!15] (0,8) -- (0,5) -- (3,5) -- cycle;
  \fill[gray!50] (0,5) -- (3,5) -- (3,3) -- (0,3) -- cycle;
  \fill[gray!30] (3,5) -- (3,3) -- (5,3) -- cycle;
  % ejes y demanda
  \draw[->] (0,0) -- (9.2,0) node[below] {$x$};
  \draw[->] (0,0) -- (0,8.8) node[left] {$p$};
  \draw[very thick] (0,8) -- (8,0) node[above right] {$x(p,W)$};
  % precios y cantidades
  \draw[dotted] (3,5) -- (3,0);
  \draw[dotted] (5,3) -- (5,0);
  \node[left] at (0,5) {$p^0$};
  \node[left] at (0,3) {$p^1$};
  \node[below] at (3,0) {$x^0$};
  \node[below] at (5,0) {$x^1$};
  % rótulos de las áreas
  \node at (0.95,5.95) {$EC^0$};
  \node[font=\scriptsize, align=center] at (1.5,4) {$(p^0-p^1)\,x^0$};
  \draw[->, thin] (5.6,4.6) node[right, font=\scriptsize, align=left] {unidades\\nuevas} -- (3.75,3.6);
\end{tikzpicture}
