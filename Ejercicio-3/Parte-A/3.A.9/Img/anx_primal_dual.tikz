% Figura (Anexo I, «La coincidencia de las soluciones»): el problema primal y el dual eligen la misma cesta.
% Preferencias COBB-DOUGLAS u = (x_1 x_2)^{1/2} (a = 1/2), p_1 = p_2 = 1, W = 4: x(p,W) = (2; 2) y V(p,W) = 2.
% (a) Conjunto presupuestario sombreado; curvas de indiferencia x_1 x_2 = 2,25; 4 (la más alta alcanzable); 8.
% (b) Con U = 2, contorno superior sombreado; rectas isogasto x_1 + x_2 = 3 (inalcanzable), 4 (gasto mínimo, E(p,U) = 4,
%     tangente en h(p,U) = (2; 2)) y 5,6. Los cortes con los ejes, W/p_i y E(p,U)/p_i, coinciden.
% Escala: 1 unidad = 1 cm. Sustituye a CD_primal_dual y CD_problema_dual (copiadas de apuntes).
% Generar con: bash Code/generar_figura.sh anx_primal_dual
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1cm, y=1cm]
  % ---------------- (a) Maximización de la utilidad ----------------
  \node[font=\footnotesize\bfseries] at (2.7,5.95) {(a) Maximización de la utilidad};
  \fill[black!12] (0,0) -- (4,0) -- (0,4) -- cycle;
  \draw[->] (0,0) -- (5.6,0) node[below] {$x_1$};
  \draw[->] (0,0) -- (0,5.6) node[left] {$x_2$};
  \draw[very thick] (0,4) -- (4,0);
  \node[below] at (4,0) {$W/p_1$};
  \node[left] at (0,4) {$W/p_2$};
  \draw[thin] plot[domain=0.43:5.3, samples=80] (\x,{2.25/\x});
  \draw[very thick] plot[domain=0.76:5.3, samples=80] (\x,{4/\x}) node[above] {$V(p,W)$};
  \draw[thin] plot[domain=1.51:5.3, samples=80] (\x,{8/\x});
  \fill (2,2) circle (1.4pt) node[above right] {$x(p,W)$};
  \node at (1.05,0.85) {$p\cdot x\le W$};
  % ---------------- (b) Minimización del gasto ----------------
  \begin{scope}[xshift=7.4cm]
    \node[font=\footnotesize\bfseries] at (2.7,5.95) {(b) Minimización del gasto};
    \fill[black!12] plot[domain=0.755:5.3, samples=80] (\x,{4/\x}) -- (5.3,5.3) -- (0.755,5.3) -- cycle;
    \draw[->] (0,0) -- (5.6,0) node[below] {$x_1$};
    \draw[->] (0,0) -- (0,5.6) node[left] {$x_2$};
    \draw[thin] (0,3) -- (3,0);
    \draw[very thick] (0,4) -- (4,0);
    \draw[thin] (0.3,5.3) -- (5.3,0.3);
    \node[below] at (4,0) {$E(p,U)/p_1$};
    \node[left] at (0,4) {$E(p,U)/p_2$};
    \draw[very thick] plot[domain=0.76:5.3, samples=80] (\x,{4/\x}) node[above] {$U$};
    \fill (2,2) circle (1.4pt) node[above right] {$h(p,U)$};
    \node at (3.95,4.05) {$u(x)\ge U$};
  \end{scope}
\end{tikzpicture}
