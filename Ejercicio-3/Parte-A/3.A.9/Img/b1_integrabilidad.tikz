% Figura (cuerpo, «Integrar la demanda»): de las elecciones observadas a las curvas de indiferencia, con dos bienes.
% Versión del cuerpo de anx_integrabilidad: el panel (a) añade tres elecciones observadas y sus rectas de balance, que son las
% que revelan la pendiente de la curva de indiferencia en cada cesta.
% Demanda COBB-DOUGLAS con a = 1/2: la cesta x se elige cuando p_1/p_2 = x_2/x_1, de modo que la pendiente de la curva de
% indiferencia que pasa por x es -x_2/x_1.
% (a) Campo de pendientes en la rejilla {0,6; 1,2; ...; 4,8}^2 (gris) y tres elecciones sobre x_1 x_2 = 5 con su recta de balance:
%     x^1 = (1,25; 4), recta x_2 = 8 - 3,2 x_1; x^2 = (2,236; 2,236), recta x_2 = 4,472 - x_1; x^3 = (4; 1,25), recta
%     x_2 = 2,5 - 0,3125 x_1.
% (b) El mismo campo y las curvas que lo siguen, x_1 x_2 = 1; 2,5; 5; 9; las tres elecciones están sobre la curva x_1 x_2 = 5.
% Escala: 1 unidad = 1 cm.
% Generar con: bash Code/generar_figura.sh b1_integrabilidad
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1cm, y=1cm]
  % ---------------- (a) Las pendientes que revelan las elecciones ----------------
  \node[font=\footnotesize\bfseries] at (2.7,5.95) {(a) Las pendientes que revelan las elecciones};
  \draw[->] (0,0) -- (5.6,0) node[below] {$x_1$};
  \draw[->] (0,0) -- (0,5.6) node[left] {$x_2$};
  \foreach \X in {0.6,1.2,...,4.81} {
    \foreach \Y in {0.6,1.2,...,4.81} {
      \pgfmathsetmacro{\m}{-\Y/\X}
      \pgfmathsetmacro{\d}{0.18/sqrt(1+\m*\m)}
      \draw[black!40] ({\X-\d},{\Y-\m*\d}) -- ({\X+\d},{\Y+\m*\d});
    }
  }
  \draw[thin] (0.84375,5.3) -- (2.5,0);
  \draw[thin] (0,4.472) -- (4.472,0);
  \draw[thin] (0,2.5) -- (5.3,0.84375);
  \fill (1.25,4) circle (1.7pt) node[above right] {$x^1$};
  \fill (2.236,2.236) circle (1.7pt) node[above right] {$x^2$};
  \fill (4,1.25) circle (1.7pt) node[above right] {$x^3$};
  % ---------------- (b) Las curvas de indiferencia recuperadas ----------------
  \begin{scope}[xshift=7.2cm]
    \node[font=\footnotesize\bfseries] at (2.7,5.95) {(b) Las curvas de indiferencia recuperadas};
    \draw[->] (0,0) -- (5.6,0) node[below] {$x_1$};
    \draw[->] (0,0) -- (0,5.6) node[left] {$x_2$};
    \foreach \X in {0.6,1.2,...,4.81} {
      \foreach \Y in {0.6,1.2,...,4.81} {
        \pgfmathsetmacro{\m}{-\Y/\X}
        \pgfmathsetmacro{\d}{0.18/sqrt(1+\m*\m)}
        \draw[black!40] ({\X-\d},{\Y-\m*\d}) -- ({\X+\d},{\Y+\m*\d});
      }
    }
    \foreach \k in {1,2.5,5,9} {
      \draw[very thick] plot[domain={\k/5.2}:5.2, samples=80] (\x,{\k/\x});
    }
    \fill (1.25,4) circle (1.7pt);
    \fill (2.236,2.236) circle (1.7pt);
    \fill (4,1.25) circle (1.7pt);
  \end{scope}
\end{tikzpicture}
