% Esquema de relaciones entre el problema primal (maximización de la utilidad) y su dual (minimización del gasto):
% soluciones (SCEDM, SCEDC), funciones valor (FIU, FG), identidad de Roy, lema de Shephard, ecuación de Slutsky,
% dualidad entre soluciones y entre funciones valor, e integrabilidad. Elaboración propia a partir de los apuntes de Víctor Gutiérrez.
\begin{tikzpicture}[font=\footnotesize, line cap=round, >={Stealth[length=5pt]},
    caja/.style={draw, line width=0.6pt, align=center, inner sep=4pt, fill=white, minimum width=3.45cm},
    gris/.style={text=black!60},
    flecha/.style={->, line width=0.7pt},
    flechag/.style={->, line width=0.6pt, black!50},
    disc/.style={dashed, line width=0.6pt, black!50},
    etq/.style={font=\footnotesize\itshape, align=center}]
  % ---------------------------------------------------------------- recuadro central
  \draw[dashed, line width=0.9pt, black!55] (5.9,-0.45) rectangle (10.1,9.95);
  \node[gris, font=\small\itshape] at (8,9.55) {Problemas duales};
  % ---------------------------------------------------------------- columna primal
  \node[font=\small\itshape, text=green!45!black] at (3.35,9.95) {[Problema primal]};
  \node[text=green!45!black] at (3.35,9.52) {Maximización de la utilidad};
  \node[caja, minimum height=1.85cm] (P) at (3.35,8.1) {%
    $\begin{aligned}&\max_{x}\ \ U(x)\\[2pt]&\text{s.a.}\ \begin{cases}p\cdot x\le\bar W\\ x\ge 0\end{cases}\end{aligned}$};
  \node[caja, minimum height=1.05cm] (M) at (3.35,4.9) {\textbf{\textit{SCEDM:}}\\ $x^*=x(p,\bar W)$};
  \node[caja, minimum height=1.05cm] (V) at (3.35,0.6) {\textbf{\textit{FIU:}}\\ $U^*=V(p,\bar W)=U(x^*)$};
  \draw[flecha] (P.south) -- node[etq, left] {Resolviendo} (M.north);
  \draw[flecha] ([xshift=4mm]M.south) -- node[etq, left] {Función\\de valor} ([xshift=4mm]V.north);
  \draw[flechag] ([xshift=-8mm]V.north) -- node[etq, gris, left, xshift=-1pt] {Identidad de Roy\\[3pt]
      $x_i^*=-\dfrac{\partial V(p,\bar W)/\partial p_i}{\partial V(p,\bar W)/\partial \bar W}$} ([xshift=-8mm]M.south);
  \draw[->, dashed, line width=0.5pt, black!45] ([xshift=-2mm,yshift=-1pt]M.north east) .. controls +(0.55,0.5) and +(0.55,-0.5) ..
      node[etq, gris, left, xshift=-1pt] {Integrabilidad\\de las\\preferencias} ([xshift=-2mm,yshift=1pt]P.south east);
  % ---------------------------------------------------------------- columna dual
  \node[font=\small\itshape, text=red!70!black] at (12.65,9.95) {[Problema dual]};
  \node[text=red!70!black] at (12.65,9.52) {Minimización del gasto};
  \node[caja, minimum height=1.85cm] (D) at (12.65,8.1) {%
    $\begin{aligned}&\min_{h}\ \ p\cdot h\\[2pt]&\text{s.a.}\ \begin{cases}U(h)\ge\bar U\\ h\ge 0\end{cases}\end{aligned}$};
  \node[caja, minimum height=1.05cm] (C) at (12.65,4.9) {\textbf{\textit{SCEDC:}}\\ $h^*=h(p,\bar U)$};
  \node[caja, minimum height=1.05cm] (G) at (12.65,0.6) {\textbf{\textit{FG:}}\\ $E^*=E(p,\bar U)=p\cdot h^*$};
  \draw[flecha] (D.south) -- node[etq, right] {Resolviendo} (C.north);
  \draw[flecha] ([xshift=-4mm]C.south) -- node[etq, right] {Función\\de valor} ([xshift=-4mm]G.north);
  \draw[flechag] ([xshift=8mm]G.north) -- node[etq, gris, right, xshift=1pt] {Lema de\\Shephard\\[3pt]
      $h_i^*=\dfrac{\partial E(p,\bar U)}{\partial p_i}$} ([xshift=8mm]C.south);
  % ---------------------------------------------------------------- dualidad entre problemas
  \draw[<->, line width=0.9pt] (P.east) -- (D.west);
  \node[gris] at (8,9.05) {$\bar W=E^*$};
  \node[gris] at (8,8.55) {$\bar U=U^*$};
  % ---------------------------------------------------------------- ecuación de Slutsky
  \draw[flecha] ([yshift=3mm]C.west) -- ([yshift=3mm]M.east);
  \draw[flecha] ([yshift=-3mm]M.east) -- ([yshift=-3mm]C.west);
  \node[gris] at (8,4.9) {\itshape Ecuación de Slutsky};
  \node[gris, align=center] at (8,6.55) {$\dfrac{\partial x_i(p,\bar W)}{\partial p_j}=\dfrac{\partial h_i(p,\bar U)}{\partial p_j}$\\[2pt]
      $-x_j^*\cdot\dfrac{\partial x_i(p,\bar W)}{\partial \bar W},\ \forall i,j$\\[1pt]
      \itshape (efecto total $=$ efecto sustitución\\ \itshape $+$ efecto renta)};
  % ---------------------------------------------------------------- dualidad entre soluciones (líneas discontinuas)
  % SCEDC y FIU dan el SCEDM: x(p,W) = h(p,V(p,W))
  \draw[disc] ([xshift=-2mm]V.north east) -- node[gris, sloped, fill=white, inner sep=1pt, pos=0.78] {$x(p,\bar W)=h\big(p,V(p,\bar W)\big)$}
      ([xshift=3mm]C.south west);
  \draw[disc, ->] ([xshift=-2mm]V.north east) -- ([xshift=12mm]M.south);
  % SCEDM y FG dan el SCEDC: h(p,U) = x(p,E(p,U))
  \draw[disc] ([xshift=-3mm]M.south east) -- node[gris, sloped, fill=white, inner sep=1pt, pos=0.22] {$h(p,\bar U)=x\big(p,E(p,\bar U)\big)$}
      ([xshift=2mm]G.north west);
  \draw[disc, ->] ([xshift=2mm]G.north west) -- ([xshift=-12mm]C.south);
  % ---------------------------------------------------------------- dualidad entre funciones valor
  \draw[flecha] ([yshift=3.2mm]G.west) -- ([yshift=3.2mm]V.east);
  \draw[flecha] ([yshift=-3.2mm]V.east) -- ([yshift=-3.2mm]G.west);
  \node[gris] at (8,1.45) {$V(p,\bar W)=E^{-1}(p,\bar W)$};
  \node[gris] at (8,0.6) {\itshape Inversas (dualidad entre funciones valor)};
  \node[gris] at (8,-0.25) {$E(p,\bar U)=V^{-1}(p,\bar U)$};
\end{tikzpicture}
