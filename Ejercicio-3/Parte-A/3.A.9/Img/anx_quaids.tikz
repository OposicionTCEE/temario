% Figura (Anexo II, «QUAIDS»): una curva de ENGEL cuadrática y la recta del sistema casi ideal que mejor la aproxima.
% QUAIDS (gruesa): omega = 0,05 + 0,2 ln W - 0,04 (ln W)^2 en ln W de 0 a 4: máximo en ln W* = 2,5 (omega = 0,30);
% a su izquierda la participación crece (eta_i > 1, bien de lujo) y a su derecha decrece (eta_i < 1, necesario).
% AIDS (discontinua): recta de mínimos cuadrados de la parábola en [0; 4], omega = 0,1567 + 0,04 ln W, que crece en
% todo el intervalo: describiría el bien como de lujo con cualquier gasto.
% Escala: ln W, 1 unidad = 1,9 cm; participación, 1 unidad = 12 cm.
% Generar con: bash Code/generar_figura.sh anx_quaids
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1.9cm, y=12cm]
  \draw[->] (0,0) -- (4.45,0) node[below] {$\ln W$};
  \draw[->] (0,0) -- (0,0.4) node[left] {$\omega_i$};
  \draw[very thick] plot[domain=0:4, samples=80] (\x,{0.05+0.2*\x-0.04*\x*\x}) node[right] {QUAIDS};
  \draw[thick, dashed] (0,0.1567) -- (4,0.3167) node[right] {AIDS};
  \draw[dotted] (2.5,0) node[below] {$\ln W^*$} -- (2.5,0.30);
  \node at (1.25,0.335) {$\eta_i>1$};
  \node at (3.6,0.255) {$\eta_i<1$};
\end{tikzpicture}
