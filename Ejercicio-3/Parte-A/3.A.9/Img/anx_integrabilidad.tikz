% Figura (Anexo I, «Dos bienes: por qué la simetría es automática»): integrar es reconstruir las curvas a partir de sus pendientes.
% Demanda COBB-DOUGLAS con a = 1/2: la cesta x se elige cuando p_1/p_2 = x_2/x_1, de modo que la pendiente de la curva de
% indiferencia que pasa por x es -x_2/x_1.
% (a) Campo de pendientes: en cada punto de la rejilla {0,6; 1,2; ...; 4,8}^2, un segmento de pendiente -x_2/x_1 (semilongitud 0,18).
% (b) El mismo campo y las curvas que lo siguen, x_1 x_2 = 1; 2,5; 5; 9 (las curvas de indiferencia recuperadas).
% Escala: 1 unidad = 1 cm.
% Generar con: bash Code/generar_figura.sh anx_integrabilidad
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1cm, y=1cm]
  % ---------------- (a) Las pendientes ----------------
  \node[font=\footnotesize\bfseries] at (2.7,5.95) {(a) Las pendientes};
  \draw[->] (0,0) -- (5.6,0) node[below] {$x_1$};
  \draw[->] (0,0) -- (0,5.6) node[left] {$x_2$};
  \foreach \X in {0.6,1.2,...,4.81} {
    \foreach \Y in {0.6,1.2,...,4.81} {
      \pgfmathsetmacro{\m}{-\Y/\X}
      \pgfmathsetmacro{\d}{0.18/sqrt(1+\m*\m)}
      \draw[thin] ({\X-\d},{\Y-\m*\d}) -- ({\X+\d},{\Y+\m*\d});
    }
  }
  % ---------------- (b) Las curvas ----------------
  \begin{scope}[xshift=7.2cm]
    \node[font=\footnotesize\bfseries] at (2.7,5.95) {(b) Las curvas de indiferencia};
    \draw[->] (0,0) -- (5.6,0) node[below] {$x_1$};
    \draw[->] (0,0) -- (0,5.6) node[left] {$x_2$};
    \foreach \X in {0.6,1.2,...,4.81} {
      \foreach \Y in {0.6,1.2,...,4.81} {
        \pgfmathsetmacro{\m}{-\Y/\X}
        \pgfmathsetmacro{\d}{0.18/sqrt(1+\m*\m)}
        \draw[black!40] ({\X-\d},{\Y-\m*\d}) -- ({\X+\d},{\Y+\m*\d});
      }
    }
    \foreach \k in {1,2.5,5,9} {
      \draw[very thick] plot[domain={\k/5.2}:5.2, samples=80] (\x,{\k/\x});
    }
  \end{scope}
\end{tikzpicture}
