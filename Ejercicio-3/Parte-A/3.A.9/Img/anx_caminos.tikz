% Figura (Anexo III, «Varios precios»): dos caminos entre los mismos precios inicial y final.
% Espacio de precios (p1, p2). p^0 = (4; 3,5) y p^1 = (1,5; 1,5). Camino A (gruesa): primero baja p1, después p2.
% Camino B (discontinua): primero baja p2, después p1. Camino C (punteada): un camino cualquiera.
% Con las demandas compensadas, la integral es la misma por los tres caminos (es la diferencia de la función de
% gasto); con las marshallianas, solo si sus derivadas cruzadas son simétricas.
% Escala: 1 unidad = 1 cm en los dos ejes.
% Generar con: bash Code/generar_figura.sh anx_caminos
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=5pt]}, x=1cm, y=1cm]
  \draw[->] (0,0) -- (5.2,0) node[below] {$p_1$};
  \draw[->] (0,0) -- (0,4.6) node[left] {$p_2$};
  % camino A: primero p1
  \draw[very thick, ->] (4,3.5) -- (1.5,3.5);
  \draw[very thick, ->] (1.5,3.5) -- (1.5,1.5);
  \node[above] at (2.75,3.5) {A: primero baja $p_1$};
  % camino B: primero p2
  \draw[thick, dashed, ->] (4,3.5) -- (4,1.5);
  \draw[thick, dashed, ->] (4,1.5) -- (1.5,1.5);
  \node[below] at (2.75,1.5) {B: primero baja $p_2$};
  % camino C: cualquiera
  \draw[thick, dotted, ->] (4,3.5) .. controls (3.2,1.9) and (2.6,3.0) .. (1.5,1.5);
  \node[font=\scriptsize] at (3.05,2.15) {C};
  % puntos
  \fill (4,3.5) circle (1.8pt) node[above right] {$p^0$};
  \fill (1.5,1.5) circle (1.8pt) node[below left] {$p^1$};
\end{tikzpicture}
