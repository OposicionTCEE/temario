% Figura (Anexo II, «Ceros»): una curva de ENGEL con soluciones de esquina (datos simulados).
% Demanda latente x* = -3 + 0,8 W + u, con u normal de desviación típica 1,3 (semilla 9 de random de Python),
% para 33 hogares con W = 0,8; 1,05; ...; 8,8. Demanda observada x = max{0, x*}: 14 ceros (círculos huecos sobre el eje).
% Rectas: latente verdadera (gruesa), -3 + 0,8 W; MCO solo con los hogares que compran (discontinua), -1,566 + 0,58 W;
% MCO con todos, ceros incluidos (punteada), -1,245 + 0,50 W. Las dos estimadas son más planas que la verdadera.
% Escala: W, 1 unidad = 0,9 cm; x, 1 unidad = 0,75 cm.
% Generar con: bash Code/generar_figura.sh anx_ceros
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=0.9cm, y=0.75cm]
  \draw[->] (0,0) -- (10.0,0) node[below] {$W$};
  \draw[->] (0,-2.7) -- (0,5.4) node[left] {$x_i$};
  % rectas
  \draw[very thick] (0.6,-2.52) -- (9.6,4.68) node[right] {demanda latente, $x_i^*$};
  \draw[thick, dashed] (2.7,0) -- (9.6,4.002) node[right] {MCO solo con $x_i>0$};
  \draw[thick, dotted] (2.49,0) -- (9.6,3.555) node[right] {MCO con todos};
  % hogares que compran
  \foreach \p in {(1.55,0.24), (3.30,0.87), (3.55,0.16), (4.30,0.32), (4.80,0.89), (5.05,1.67), (5.55,1.32), (6.05,0.63), (6.30,0.44), (6.55,3.68), (6.80,3.31), (7.05,3.28), (7.30,1.88), (7.55,1.18), (7.80,2.75), (8.05,3.70), (8.30,3.55), (8.55,4.73), (8.80,3.58)}
    \fill \p circle (1.5pt);
  % ceros
  \foreach \w in {0.80, 1.05, 1.30, 1.80, 2.05, 2.30, 2.55, 2.80, 3.05, 3.80, 4.05, 4.55, 5.30, 5.80}
    \draw[fill=white] (\w,0) circle (1.5pt);
  \node[below] at (3.3,-0.05) {ceros observados};
  \node[right, align=left] at (0.15,-1.95) {$x_i^*<0$: el hogar no compra};
\end{tikzpicture}
