% Figura (Anexo III, «Medida exacta»): la función de gasto recorrida con la demanda observada.
% Demanda C-D del primer anexo, x1 = W/(2 p1), con W = 4 y p1 de 1 a 1/2.
% Exacta (gruesa): solución de dE/dp1 = x1(p1, E) = E/(2 p1) con E(1) = 4, E = 4 raiz(p1); en p1 = 1/2 vale 2,828,
% y VC = 4 - 2,828 = 1,172.
% Excedente (discontinua): el mismo punto de partida con la pendiente de la demanda a renta fija, x1(p1, W) = 2/p1:
% G = 4 + 2 ln p1; en p1 = 1/2 vale 2,614, y Delta EC = 4 - 2,614 = 1,386.
% El eje vertical empieza en 2,3 para ampliar la zona útil; el horizontal, en 0,2.
% Escala: p1, 1 unidad = 8 cm; euros, 1 unidad = 2,6 cm.
% Generar con: bash Code/generar_figura.sh anx_hausman
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=8cm, y=2.6cm]
  \draw[->] (0.2,2.3) -- (1.17,2.3) node[below] {$p_1$};
  \draw[->] (0.2,2.3) -- (0.2,4.45) node[left] {euros};
  % renta y precios
  \draw[dotted] (0.2,4) node[left] {$W$} -- (1.0,4);
  \draw[dotted] (1.0,2.3) node[below] {$p_1^0$} -- (1.0,4);
  \draw[dotted] (0.5,2.3) node[below] {$p_1^1$} -- (0.5,2.6137);
  % curvas
  \draw[very thick] plot[domain=0.45:1.08, samples=60] (\x,{4*sqrt(\x)});
  \draw[thick, dashed] plot[domain=0.46:1.08, samples=60] (\x,{4+2*ln(\x)});
  \node[above left, inner sep=2pt] at (0.64,3.26) {$E(p_1,U^0)$};
  \node[below right, inner sep=2pt] at (0.68,3.18) {$W-\int_{p_1}^{p_1^0}x_1(s,W)\,ds$};
  % puntos y medidas
  \fill (1,4) circle (1.6pt);
  \fill (0.5,2.8284) circle (1.6pt);
  \fill (0.5,2.6137) circle (1.6pt);
  \draw[decorate, decoration={brace, amplitude=3pt, mirror}] (0.47,4) -- (0.47,2.8284) node[midway, left=3pt] {VC};
  \draw[decorate, decoration={brace, amplitude=3pt, mirror}] (0.38,4) -- (0.38,2.6137) node[midway, left=3pt] {$\Delta EC$};
\end{tikzpicture}
