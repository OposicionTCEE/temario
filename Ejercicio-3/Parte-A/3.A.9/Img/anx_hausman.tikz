% Figura (Anexo III, «Medida exacta»): la función de gasto recorrida con la demanda observada.
% Demanda C-D del primer anexo, x1 = W/(2 p1), con W = 4 y p1 de 1 a 1/2.
% Exacta (gruesa): solución de dE/dp1 = x1(p1, E) = E/(2 p1) con E(1) = 4, E = 4 raiz(p1); en p1 = 1/2 vale 2,828,
% y VC = 4 - 2,828 = 1,172.
% Excedente (discontinua): la misma recta de partida con la pendiente de la demanda a renta fija, x1(p1, W) = 2/p1:
% G = 4 + 2 ln p1; en p1 = 1/2 vale 2,614, y Delta EC = 4 - 2,614 = 1,386.
% Pendientes marcadas en p1 = 0,7: exacta E/(2 p1) = 2,390 (E = 3,347); excedente 2/p1 = 2,857 (G = 3,287).
% Escala: p1, 1 unidad = 6 cm; euros, 1 unidad = 1,2 cm.
% Generar con: bash Code/generar_figura.sh anx_hausman
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=6cm, y=1.2cm]
  \draw[->] (0,0) -- (1.3,0) node[below] {$p_1$};
  \draw[->] (0,0) -- (0,4.9) node[left] {euros};
  % renta
  \draw[dotted] (0,4) node[left] {$W$} -- (1.0,4);
  \draw[dotted] (1.0,0) node[below] {$p_1^0$} -- (1.0,4);
  \draw[dotted] (0.5,0) node[below] {$p_1^1$} -- (0.5,2.614);
  % curvas
  \draw[very thick] plot[domain=0.47:1.12, samples=60] (\x,{4*sqrt(\x)}) node[right] {$E(p_1,U^0)$};
  \draw[thick, dashed] plot[domain=0.47:1.12, samples=60] (\x,{4+2*ln(\x)});
  \node[right] at (1.12,3.98) {$W-\!\int x_1(p_1,W)\,dp_1$};
  % pendientes en p1 = 0,7
  \draw[thin] (0.62,3.156) -- (0.78,3.538);
  \node[above left, font=\scriptsize] at (0.66,3.27) {pendiente $x_1(p_1,E)$};
  \draw[thin] (0.62,3.058) -- (0.78,3.515);
  \node[below right, font=\scriptsize] at (0.72,3.13) {pendiente $x_1(p_1,W)$};
  % puntos y medidas
  \fill (1,4) circle (1.6pt);
  \fill (0.5,2.8284) circle (1.6pt);
  \fill (0.5,2.6137) circle (1.6pt);
  \draw[decorate, decoration={brace, amplitude=3pt, mirror}] (0.47,4) -- (0.47,2.8284) node[midway, left=3pt] {VC};
  \draw[decorate, decoration={brace, amplitude=3pt, mirror}] (0.39,4) -- (0.39,2.6137) node[midway, left=3pt] {$\Delta EC$};
\end{tikzpicture}
