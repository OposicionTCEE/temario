% Figura (Anexo I, «Función de utilidad»): preferencias lexicográficas.
% (a) Cesta x = (2; 2). Son mejores que x todas las cestas con más del bien 1 (zona gris, x_1 > 2) y las que tienen la misma cantidad
%     del bien 1 y más del bien 2 (semirrecta superior, gruesa); son peores las de menos del bien 1 y las de la semirrecta inferior
%     (discontinua). Ninguna otra cesta es indiferente a x: cada «curva de indiferencia» es un punto, y el conjunto de cestas al menos
%     tan buenas como x no es cerrado (la semirrecta inferior es frontera de la zona gris, pero no pertenece a ella).
% (b) Con p = (1; 1) y W = 4 (recta de balance x_1 + x_2 = 4), el consumidor compra solo el bien 1, x = (4; 0): la misma elección que
%     con la utilidad u = x_1, cuya curva de indiferencia por esa cesta es la vertical x_1 = 4 (discontinua).
% Escala: 1 unidad = 0,95 cm en los dos paneles.
% Generar con: bash Code/generar_figura.sh anx_lexicograficas
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=0.95cm, y=0.95cm]
  % ---------------- (a) Mejor y peor que x ----------------
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (2.7,5.75) {(a) Cestas mejores y peores que $x$};
    \fill[gray!18] (2,0) rectangle (5.2,5.2);
    \draw[->] (0,0) -- (5.6,0) node[below] {$x_1$};
    \draw[->] (0,0) -- (0,5.5) node[left] {$x_2$};
    \draw[very thick] (2,2) -- (2,5.2);
    \draw[thick, dashed] (2,0) -- (2,2);
    \fill (2,2) circle (1.7pt) node[left] {$x$};
    \node at (3.6,3.6) {Mejores};
    \node at (1.0,3.6) {Peores};
  \end{scope}
  % ---------------- (b) La elección ----------------
  \begin{scope}[xshift=6.9cm]
    \node[font=\footnotesize\bfseries] at (2.7,5.75) {(b) La elección};
    \draw[->] (0,0) -- (5.6,0) node[below] {$x_1$};
    \draw[->] (0,0) -- (0,5.5) node[left] {$x_2$};
    \draw[thin] (0,4) -- (4,0);
    \draw[thick, dashed] (4,0) -- (4,5.0) node[above] {$u=x_1$};
    \fill (4,0) circle (1.7pt) node[below left] {$x(p,W)$};
  \end{scope}
\end{tikzpicture}
