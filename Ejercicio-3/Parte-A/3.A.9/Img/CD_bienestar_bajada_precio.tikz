% Variación del bienestar ante la bajada del precio de x1: el consumidor pasa de CI_1 a CI_2. Elaboración propia a partir de www.salasweb.info/cursos/microsupI/MicrosIt6.ppt.
\begin{tikzpicture}[x=1.15cm, y=1.1cm, font=\footnotesize, line cap=round, >={Stealth[length=4.5pt]},
    eje/.style={->, line width=0.6pt},
    ci/.style={line width=0.5pt, cyan!55!black},
    cig/.style={line width=1.4pt, blue!70!black},
    pto/.style={circle, fill=red!70!black, inner sep=0pt, minimum size=4pt}]
  % conjuntos presupuestarios: inicial (p1 = 1) y final (p1 = 0,5)
  \fill[green!55!black!35] (0,0) -- (0,4) -- (4,0) -- cycle;
  \fill[yellow!35] (0,4) -- (8,0) -- (4,0) -- cycle;
  \draw[line width=0.8pt, green!45!black] (0,4) -- (4,0);
  \draw[line width=0.8pt, green!45!black] (0,4) -- (8,0);
  % banda entre las dos curvas de indiferencia: la mejora de bienestar
  \fill[orange!35, opacity=0.8, domain=0.8:5.4, samples=80] plot (\x,{4/\x}) -- plot[domain=5.4:1.6] (\x,{8/\x}) -- cycle;
  \draw[ci, domain=0.55:5.0, samples=60] plot (\x,{2.2/\x});
  \draw[ci, domain=2.6:7.2, samples=60] plot (\x,{13/\x});
  \draw[cig, domain=0.8:5.4, samples=80] plot (\x,{4/\x});
  \node[font=\footnotesize\bfseries, text=blue!70!black, above] at (0.8,5) {$CI_1$};
  \draw[cig, domain=1.6:5.4, samples=80] plot (\x,{8/\x});
  \node[font=\footnotesize\bfseries, text=blue!70!black, above] at (1.6,5) {$CI_2$};
  \node[pto, label={[font=\footnotesize]below left:{$x^*$}}] at (2,2) {};
  \node[pto, label={[font=\footnotesize]above:{$x^{**}$}}] at (4,2) {};
  \draw[eje] (0,0) -- (8.6,0) node[below] {$x_1$};
  \draw[eje] (0,0) -- (0,5.4) node[left] {$x_2$};
  \node[draw=blue!60!black, fill=cyan!8, rounded corners=3pt, align=left, inner sep=4pt] (q) at (6.7,3.0) {¿Cómo medimos\\esa variación?};
  \draw[line width=0.5pt, blue!60!black] (q.west) -- (4.75,1.85);
\end{tikzpicture}
