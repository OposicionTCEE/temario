% Figura (Anexo I, «Del gasto a las preferencias»): las dos caras de la dualidad.
% Preferencias COBB-DOUGLAS u = (x_1 x_2)^{1/2} (a = 1/2), U = 2 y p_2 = 1: curva de indiferencia x_2 = 4/x_1.
% Cinco precios del bien 1: p_1 = 1/4, 1/2, 1, 2, 3. Gasto mínimo E = 2U (p_1 p_2)^{1/2} = 4 p_1^{1/2}; cesta óptima
% h = (2/p_1^{1/2}; 2 p_1^{1/2}): (4; 1), C' = (2,828; 1,414), B = (2; 2), A' = (1,414; 2,828) y (1,155; 3,464)
% (las letras de las figuras de la demanda hicksiana y de la función de gasto: A' con p_1^0 = 2, B con p_1^1 = 1, C' con p_1^2 = 1/2).
% (a) Rectas de gasto mínimo p_1 x_1 + x_2 = 4 p_1^{1/2}: cada una toca la curva en su cesta óptima y todas juntas la envuelven.
% (b) Gasto del consumidor pasivo con cada cesta, g(p_1) = p_1 x_1 + x_2: 4 p_1 + 1; C': 2,828 p_1 + 1,414; B: 2 p_1 + 2;
%     A': 1,414 p_1 + 2,828; 1,155 p_1 + 3,464. Su envolvente inferior es E(p_1) = 4 p_1^{1/2}, que toca cada recta en el precio
%     al que esa cesta es la óptima (p_1^2 = 1/2, p_1^1 = 1, p_1^0 = 2), con pendiente x_1 (lema de SHEPHARD).
%     Una cesta es un punto en (a) y una recta en (b); un precio es una recta en (a) y un punto en (b).
% Escala: (a) 1 unidad = 1 cm; (b) p_1: 1 unidad = 1,25 cm; gasto: 1 unidad = 0,57 cm. Recortes: (a) [0; 5,3]^2; (b) [0; 4,2] x [0; 9,3].
% Generar con: bash Code/generar_figura.sh anx_dos_caras
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  % ---------------- (a) Del gasto a las preferencias ----------------
  \begin{scope}[x=1cm, y=1cm]
    \node[font=\footnotesize\bfseries] at (2.7,5.95) {(a) Del gasto a las preferencias};
    \draw[->] (0,0) -- (5.6,0) node[below] {$x_1$};
    \draw[->] (0,0) -- (0,5.6) node[left] {$x_2$};
    \begin{scope}
      \clip (0,0) rectangle (5.3,5.3);
      \foreach \p in {0.25,0.5,1,2,3} {
        \draw[thin] (0,{4*sqrt(\p)}) -- ({4/sqrt(\p)},0);
      }
    \end{scope}
    \draw[very thick] plot[domain=0.76:5.3, samples=100] (\x,{4/\x}) node[above] {$U$};
    \fill (4,1) circle (1.1pt);
    \fill (1.155,3.464) circle (1.1pt);
    \fill (2.828,1.414) circle (1.4pt) node[above right] {$C'$};
    \fill (2,2) circle (1.4pt) node[above right] {$B$};
    \fill (1.414,2.828) circle (1.4pt) node[above right] {$A'$};
    \node at (2.7,-0.75) {$p_2$ y $U$ dados};
  \end{scope}
  % ---------------- (b) De las preferencias al gasto ----------------
  \begin{scope}[xshift=7.4cm, x=1.25cm, y=0.57cm]
    \node[font=\footnotesize\bfseries] at (2.15,10.44) {(b) De las preferencias al gasto};
    \draw[->] (0,0) -- (4.5,0) node[below] {$p_1$};
    \draw[->] (0,0) -- (0,9.8) node[left] {Gasto};
    \begin{scope}
      \clip (0,0) rectangle (4.2,9.3);
      \draw[thin] (0,1) -- (4.2,17.8);
      \draw[thin] (0,1.414) -- (4.2,13.292);
      \draw[thin] (0,2) -- (4.2,10.4);
      \draw[thin] (0,2.828) -- (4.2,8.767);
      \draw[thin] (0,3.464) -- (4.2,8.315);
    \end{scope}
    \node[above] at (2.789,9.3) {$C'$};
    \node[above] at (3.65,9.3) {$B$};
    \node[right] at (4.2,8.767) {$A'$};
    \draw[very thick] plot[domain=0.02:4.0, samples=120] (\x,{4*sqrt(\x)});
    \node[below right] at (3.0,6.55) {$E(p,U)$};
    \fill (0.25,2) circle (1.1pt);
    \fill (3,6.928) circle (1.1pt);
    \draw[dotted] (0.5,2.828) -- (0.5,0) node[below] {$p_1^2$};
    \draw[dotted] (1,4) -- (1,0) node[below] {$p_1^1$};
    \draw[dotted] (2,5.657) -- (2,0) node[below] {$p_1^0$};
    \fill (0.5,2.828) circle (1.4pt);
    \fill (1,4) circle (1.4pt);
    \fill (2,5.657) circle (1.4pt);
    \node at (2.15,-1.32) {$p_2$ y $U$ dados};
  \end{scope}
\end{tikzpicture}
