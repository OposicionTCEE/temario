% Figura (Anexo I, «Derivación dual» de la ecuación de SLUTSKY): efecto sustitución y efecto renta.
% COBB-DOUGLAS u = (x_1 x_2)^{1/2}, p_2 = 1, W = 4; el precio del bien 1 baja de p_1^1 = 1 a p_1^2 = 1/2 (las cestas llevan las
% mismas letras que en las figuras de las demandas marshalliana y hicksiana).
% B = x(p^1, W) = (2; 2), con U^0 = 2; C = x(p^2, W) = (4; 2), con U^1 = 8^{1/2} = 2,828;
% C' = h(p^2, U^0) = (2,828; 1,414), sobre la recta compensada 0,5 x_1 + x_2 = E(p^2, U^0) = 2,828 (discontinua).
% Recta inicial x_1 + x_2 = 4; final 0,5 x_1 + x_2 = 4. Efecto sustitución B -> C' (de 2 a 2,828); efecto renta C' -> C (de 2,828 a 4).
% Escala: 1 unidad = 1 cm. Sustituye al panel (a) de anx_slutsky.
% Generar con: bash Code/generar_figura.sh anx_slutsky_descomposicion
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1cm, y=1cm]
  \draw[->] (0,0) -- (6.6,0) node[below] {$x_1$};
  \draw[->] (0,0) -- (0,5.0) node[left] {$x_2$};
  \begin{scope}
    \clip (0,0) rectangle (6.3,4.8);
    \draw[thin] (0,4) -- (4,0);
    \draw[thin] (0,4) -- (8,0);
    \draw[thick, dashed] (0,2.828) -- (5.657,0);
  \end{scope}
  \draw[thick] plot[domain=0.85:6.2, samples=100] (\x,{4/\x}) node[right] {$U^0$};
  \draw[thick] plot[domain=1.7:6.2, samples=100] (\x,{8/\x}) node[right] {$U^1$};
  \draw[dotted] (2,2) -- (2,0);
  \draw[dotted] (2.828,1.414) -- (2.828,0);
  \draw[dotted] (4,2) -- (4,0);
  \fill (2,2) circle (1.5pt) node[above right] {$B$};
  \fill (2.828,1.414) circle (1.5pt) node[above right] {$C'$};
  \fill (4,2) circle (1.5pt) node[above right] {$C$};
  \draw[decorate, decoration={brace, mirror, amplitude=4pt}] (2,-0.45) -- (2.828,-0.45) node[midway, below=4pt] {ES};
  \draw[decorate, decoration={brace, mirror, amplitude=4pt}] (2.828,-0.45) -- (4,-0.45) node[midway, below=4pt] {ER};
\end{tikzpicture}
