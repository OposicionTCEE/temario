% Figura (Anexo I, «Tramos rectos y vértices»): complementarios perfectos. Un vértice en las preferencias es un tramo recto en el gasto.
% Sustituye, con anx_vertices_sustitutos, a anx_vertices.
% (a) u = min(x_1, x_2), U = 2: curva en ángulo recto con vértice en (2; 2) (gruesa). Tres rectas de gasto mínimo, con
%     p_1/p_2 = 1/2 (x_2 = 3 - 0,5 x_1), 1 (x_2 = 4 - x_1) y 2 (x_2 = 6 - 2 x_1), pasan todas por el vértice.
% (b) Gasto con p_2 = 1: E = U (p_1 + p_2) = 2 p_1 + 2, lineal, con pendiente U = h_1 = 2 (sin sustitución). Los tres precios de (a)
%     son tres puntos de esa recta: (0,5; 3), (1; 4) y (2; 6).
% Escala: (a) 1 unidad = 1 cm; (b) p_1: 1 unidad = 2 cm; gasto: 1 unidad = 0,62 cm.
% Generar con: bash Code/generar_figura.sh anx_vertices_complementarios
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  % ---------------- (a) Preferencias ----------------
  \begin{scope}[x=1cm, y=1cm]
    \node[font=\footnotesize\bfseries] at (2.4,4.45) {(a) Curva de indiferencia con un vértice};
    \draw[->] (0,0) -- (4.8,0) node[below] {$x_1$};
    \draw[->] (0,0) -- (0,4.1) node[left] {$x_2$};
    \begin{scope}
      \clip (0,0) rectangle (4.6,4.0);
      \draw[thin] (0,3) -- (6,0);
      \draw[thin] (0,4) -- (4,0);
      \draw[thin] (0,6) -- (3,0);
    \end{scope}
    \draw[very thick] (2,3.9) -- (2,2) -- (4.5,2) node[above] {$U$};
    \fill (2,2) circle (1.5pt);
  \end{scope}
  % ---------------- (b) Gasto ----------------
  \begin{scope}[xshift=7.4cm, x=2cm, y=0.62cm]
    \node[font=\footnotesize\bfseries] at (1.2,7.18) {(b) Gasto lineal};
    \draw[->] (0,0) -- (2.4,0) node[below] {$p_1$};
    \draw[->] (0,0) -- (0,6.6) node[left] {Gasto};
    \draw[very thick] (0,2) -- (2.2,6.4) node[right] {$E(p,U)$};
    \fill (0.5,3) circle (1.5pt);
    \fill (1,4) circle (1.5pt);
    \fill (2,6) circle (1.5pt);
    \draw[dotted] (0.5,3) -- (0.5,0);
    \draw[dotted] (1,4) -- (1,0);
    \draw[dotted] (2,6) -- (2,0);
  \end{scope}
\end{tikzpicture}
