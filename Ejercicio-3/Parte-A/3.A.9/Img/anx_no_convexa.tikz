% Figura (Anexo I, «Sin convexidad: la envolvente convexa»): lo que la función de gasto no ve.
% (a) Curva de indiferencia no convexa x_2 = 4/x_1 + 0,9 exp(-((x_1 - 2)/0,42)^2) (la misma forma que la isocuanta de
%     anx_dualidad_envolvente del 3.A.12). Recta bitangente x_2 = 4,5203 - 1,105 x_1, que toca en A = (1,42; 2,951) y
%     B = (2,668; 1,571); rectas de gasto mínimo en x_1 = 1 (x_2 = 7,968 - 3,965 x_1) y en x_1 = 3,6 (x_2 = 2,222 - 0,309 x_1).
%     El segmento AB (discontinuo) es la envolvente convexa: la función de gasto es la misma que con esa curva convexificada.
% (b) Demanda compensada del bien 1 con p_2 = 1: p_1 = -pendiente de la curva en la cesta elegida,
%     p_1(x_1) = 4/x_1^2 + 0,9 exp(-((x_1 - 2)/0,42)^2) * 2 (x_1 - 2)/0,1764, en los tramos convexos x_1 <= 1,42 y x_1 >= 2,668.
%     Con p_1^* = 1,105 son óptimas A y B, y la demanda salta de una a otra: las cestas entre ambas no se eligen con ningún precio.
% Escala: (a) 1 unidad = 1 cm, recorte [0; 5,3]^2; (b) x_1: 1 unidad = 1 cm; p_1: 1 unidad = 1,5 cm.
% Generar con: bash Code/generar_figura.sh anx_no_convexa
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  % ---------------- (a) Preferencias no convexas ----------------
  \begin{scope}[x=1cm, y=1cm]
    \node[font=\footnotesize\bfseries] at (2.7,5.95) {(a) Preferencias no convexas};
    \draw[->] (0,0) -- (5.6,0) node[below] {$x_1$};
    \draw[->] (0,0) -- (0,5.6) node[left] {$x_2$};
    \begin{scope}
      \clip (0,0) rectangle (5.3,5.3);
      \draw[thin] (0,7.968) -- (2.010,0);
      \draw[thin] (0,4.5203) -- (4.0891,0);
      \draw[thin] (0,2.222) -- (7.2,0);
    \end{scope}
    \draw[very thick] plot[domain=0.76:5.2, samples=160] (\x,{4/\x+0.9*exp(-((\x-2)/0.42)^2)}) node[above] {$U$};
    \draw[thick, dashed] (1.42,2.951) -- (2.668,1.571);
    \fill (1.42,2.951) circle (1.4pt) node[above right] {$A$};
    \fill (2.668,1.571) circle (1.4pt) node[above right] {$B$};
  \end{scope}
  % ---------------- (b) Demanda compensada ----------------
  \begin{scope}[xshift=7.4cm, x=1cm, y=1.5cm]
    \node[font=\footnotesize\bfseries] at (2.7,3.967) {(b) Demanda compensada};
    \draw[->] (0,0) -- (5.6,0) node[below] {$x_1$};
    \draw[->] (0,0) -- (0,3.73) node[left] {$p_1$};
    \draw[very thick] plot[domain=1.15:1.42, samples=60] (\x,{4/\x^2+0.9*exp(-((\x-2)/0.42)^2)*2*(\x-2)/0.1764});
    \draw[very thick] plot[domain=2.668:5.3, samples=120] (\x,{4/\x^2+0.9*exp(-((\x-2)/0.42)^2)*2*(\x-2)/0.1764}) node[above] {$h_1(p,U)$};
    \draw[thick, dashed] (1.42,1.105) -- (2.668,1.105);
    \draw[dotted] (0,1.105) node[left] {$p_1^*$} -- (1.42,1.105);
    \draw[dotted] (1.42,1.105) -- (1.42,0);
    \draw[dotted] (2.668,1.105) -- (2.668,0);
    \fill (1.42,1.105) circle (1.4pt) node[above left] {$A$};
    \fill (2.668,1.105) circle (1.4pt) node[above right] {$B$};
  \end{scope}
\end{tikzpicture}
