% Figura (Anexo I, «Demanda marshalliana»): de la elección a la curva de demanda marshalliana.
% COBB-DOUGLAS u = (x_1 x_2)^{1/2} (a = 1/2), renta W = 4, p_2 = 1; el precio del bien 1 baja de p_1^0 = 2 a p_1^1 = 1 y p_1^2 = 1/2.
% (a) Rectas de balance x_2 = 4 - p_1 x_1, que giran en torno a W/p_2 = 4; cestas elegidas A = (1; 2), B = (2; 2) y C = (4; 2),
%     en las curvas de indiferencia x_1 x_2 = 2, 4 y 8. La senda precio-consumo (discontinua) es horizontal: x_2 = (1 - a) W/p_2 = 2.
% (b) Demanda marshalliana x_1 = a W/p_1 = 2/p_1, con los mismos puntos; las líneas de puntos bajan de cada cesta a su punto.
% Escala: x_1, 1 unidad = 0,85 cm en los dos paneles; (a) x_2, 1 unidad = 0,8 cm; (b) p_1, 1 unidad = 1,35 cm.
% Generar con: bash Code/generar_figura.sh anx_marshalliana
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  % ---------------- (a) La elección con tres precios ----------------
  \begin{scope}[x=0.85cm, y=0.8cm]
    \node[font=\footnotesize\bfseries] at (4.4,5.4) {(a) La elección con tres precios};
    \draw[->] (0,0) -- (9.0,0) node[below] {$x_1$};
    \draw[->] (0,0) -- (0,5.0) node[left] {$x_2$};
    \draw[thin] (0,4) -- (2,0);
    \draw[thin] (0,4) -- (4,0);
    \draw[thin] (0,4) -- (8,0);
    \node[left] at (0,4) {$W/p_2$};
    \node[below] at (2,0) {$W/p_1^0$};
    \node[below] at (4,0) {$W/p_1^1$};
    \node[below] at (8,0) {$W/p_1^2$};
    \draw[thick] plot[domain=0.43:8.6, samples=140] (\x,{2/\x});
    \draw[thick] plot[domain=0.86:8.6, samples=140] (\x,{4/\x});
    \draw[thick] plot[domain=1.72:8.6, samples=140] (\x,{8/\x});
    \draw[very thick, dashed] (0.35,2) -- (8.6,2);
    \fill (1,2) circle (1.5pt) node[above right] {$A$};
    \fill (2,2) circle (1.5pt) node[above right] {$B$};
    \fill (4,2) circle (1.5pt) node[above right] {$C$};
  \end{scope}
  % ---------------- (b) La curva de demanda ----------------
  \begin{scope}[yshift=-5.7cm, x=0.85cm, y=1.35cm]
    \node[font=\footnotesize\bfseries] at (4.4,3.0) {(b) La curva de demanda marshalliana};
    \draw[->] (0,0) -- (9.0,0) node[below] {$x_1$};
    \draw[->] (0,0) -- (0,2.75) node[left] {$p_1$};
    \draw[very thick] plot[domain=0.78:8.6, samples=140] (\x,{2/\x}) node[above] {$x_1(p,W)$};
    \draw[dotted] (0,2) node[left] {$p_1^0$} -- (1,2);
    \draw[dotted] (0,1) node[left] {$p_1^1$} -- (2,1);
    \draw[dotted] (0,0.5) node[left] {$p_1^2$} -- (4,0.5);
    \fill (1,2) circle (1.5pt) node[above right] {$A$};
    \fill (2,1) circle (1.5pt) node[above right] {$B$};
    \fill (4,0.5) circle (1.5pt) node[above right] {$C$};
  \end{scope}
  % Líneas de puntos de cada cesta a su punto de la curva (coordenadas absolutas), interrumpidas bajo el eje de (a)
  % para no tapar los cortes de las rectas de balance
  \draw[dotted] (0.85,1.6) -- (0.85,0);
  \draw[dotted] (1.70,1.6) -- (1.70,0);
  \draw[dotted] (3.40,1.6) -- (3.40,0);
  \draw[dotted] (0.85,-0.8) -- (0.85,-3.0);
  \draw[dotted] (1.70,-0.8) -- (1.70,-4.35);
  \draw[dotted] (3.40,-0.8) -- (3.40,-5.025);
\end{tikzpicture}
