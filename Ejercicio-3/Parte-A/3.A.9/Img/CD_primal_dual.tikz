% Problema primal y problema dual: la cesta óptima coincide si se intercambia la información (W = E*, U = U*). Elaboración propia a partir de MATÉ GARCÍA y PÉREZ DOMÍNGUEZ (2007).
\begin{tikzpicture}[x=1.1cm, y=1cm, font=\footnotesize, line cap=round, >={Stealth[length=4.5pt]},
    eje/.style={->, line width=0.6pt},
    ci/.style={line width=0.5pt, black!60},
    cig/.style={line width=1.4pt},
    rp/.style={line width=0.5pt, black!60},
    rpg/.style={line width=1.1pt},
    etq/.style={draw, fill=white, inner sep=2pt, line width=0.4pt},
    enl/.style={<->, line width=0.4pt, black!55},
    pto/.style={circle, fill=black!45, draw=black!70, inner sep=0pt, minimum size=5pt}]
  % ---- Panel primal: maximización de la utilidad (U = x1 x2, p1 = p2, W/p1 = 4,4)
  \begin{scope}[shift={(0,0)}]
    \fill[black!13] (0,0) -- (0,4.4) -- (4.4,0) -- cycle;
    \node at (1.05,0.95) {$p\cdot x\le\bar W$};
    \draw[ci, domain=0.68:4.6, samples=60] plot (\x,{3/\x});
    \draw[ci, domain=1.5:5.0, samples=60] plot (\x,{7.3/\x});
    \draw[cig, domain=1.02:4.75, samples=80] plot (\x,{4.84/\x});
    \draw[rpg] (0,4.4) -- (4.4,0);
    \draw[eje] (0,0) -- (5.3,0) node[below] {$x_1$};
    \draw[eje] (0,0) -- (0,5.2) node[left] {$x_2$};
    \node[font=\footnotesize\bfseries\itshape] at (2.65,5.35) {Primal \textup{[P]}};
    \node[pto] (xs) at (2.2,2.2) {};
    \node[etq, anchor=south west] (lx) at (2.75,3.15) {$x^*=x(p,\bar W)$};
    \draw[line width=0.4pt] (xs) -- (lx.south west);
    \node[etq, anchor=west] (lu) at (4.8,1.02) {$U^*=V(p,\bar W)$};
    \node[below=1pt] (lw) at (4.4,0) {$\dfrac{\fbox{$\bar W$}}{p_1}$};
  \end{scope}
  % ---- Panel dual: minimización del gasto (misma curva de indiferencia; rectas isogasto x1 + x2 = c)
  \begin{scope}[shift={(7.6,0)}]
    \fill[black!13, domain=1.02:4.75, samples=80] plot (\x,{4.84/\x}) -- (5.05,1.02) -- (5.05,4.75) -- (1.02,4.75) -- cycle;
    \node at (4.25,2.45) {$u(h)\ge\bar U$};
    \draw[rp] (0,3.4) -- (3.4,0);
    \draw[rp] (0.25,5.15) -- (5.15,0.25);
    \draw[rpg] (0,4.4) -- (4.4,0);
    \draw[cig, domain=1.02:4.75, samples=80] plot (\x,{4.84/\x});
    \draw[eje] (0,0) -- (5.3,0) node[below] {$x_1$};
    \draw[eje] (0,0) -- (0,5.2) node[left] {$x_2$};
    \node[font=\footnotesize\bfseries\itshape] at (2.65,5.35) {Dual \textup{[D]}};
    \node[pto] (hs) at (2.2,2.2) {};
    \node[etq, anchor=south west] (lh) at (2.75,3.15) {$h^*=h(p,\bar U)$};
    \draw[line width=0.4pt] (hs) -- (lh.south west);
    \node[etq, anchor=west] (lU) at (4.8,1.02) {$\bar U$};
    \node[below=1pt] (le) at (4.4,0) {$\dfrac{\fbox{$E^*$}}{p_1}$};
  \end{scope}
  % ---- Intercambio de información entre los dos problemas
  \draw[enl] (lx.north) to[out=30, in=150] (lh.north);
  \draw[enl] (lU.south) to[out=-150, in=-20] (lu.south east);
  \draw[enl] (lw.south east) to[out=-15, in=-165] (le.south west);
\end{tikzpicture}
