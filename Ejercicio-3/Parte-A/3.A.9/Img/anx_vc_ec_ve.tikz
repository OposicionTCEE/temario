% Figura (Anexo III, «Comparación»): variación compensatoria, excedente y variación equivalente como áreas.
% Demandas COBB-DOUGLAS del primer anexo (a = 1/2, W = 4, p2 = 1) en función del precio del bien 1:
% marshalliana x1 = 2/p1 (muy gruesa); hicksianas h1(p, U^0) = 2/raiz(p1) con U^0 = 2 (discontinua) y
% h1(p, U^1) = 2,828/raiz(p1) con U^1 = 2,828 (raya y punto). El precio baja de p1^0 = 1 a p1^1 = 1/2.
% Puntos: B = (2; 1) y C = (4; 1/2), en la marshalliana; B' = (2,828; 1) y C' = (2,828; 1/2), en las hicksianas.
% Áreas entre p1 = 1/2 y p1 = 1, a la izquierda de cada curva: VC = 4 (1 - raiz(1/2)) = 1,172 (gris oscuro);
% excedente = 2 ln 2 = 1,386 (gris oscuro y medio); VE = 5,657 (1 - raiz(1/2)) = 1,657 (los tres grises).
% Escala: x1, 1 unidad = 1,6 cm; p1, 1 unidad = 4,5 cm.
% Generar con: bash Code/generar_figura.sh anx_vc_ec_ve
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1.6cm, y=4.5cm]
  % áreas
  \fill[gray!12] plot[domain=0.5:1, samples=40] ({2.828427/sqrt(\x)},\x) -- plot[domain=1:0.5, samples=40] ({2/\x},\x) -- cycle;
  \fill[gray!32] plot[domain=0.5:1, samples=40] ({2/\x},\x) -- plot[domain=1:0.5, samples=40] ({2/sqrt(\x)},\x) -- cycle;
  \fill[gray!58] (0,0.5) -- plot[domain=0.5:1, samples=40] ({2/sqrt(\x)},\x) -- (0,1) -- cycle;
  % ejes
  \draw[->] (0,0) -- (5.2,0) node[below] {$x_1$};
  \draw[->] (0,0) -- (0,1.38) node[left] {$p_1$};
  % precios
  \draw[dotted] (0,1) -- (2.8284,1);
  \draw[dotted] (0,0.5) -- (4,0.5);
  \node[left] at (0,1) {$p_1^0$};
  \node[left] at (0,0.5) {$p_1^1$};
  % demandas
  \draw[thick, dashed] plot[domain=0.45:1.25, samples=60] ({2/sqrt(\x)},\x);
  \draw[thick, dash dot] plot[domain=0.45:1.25, samples=60] ({2.828427/sqrt(\x)},\x);
  \draw[very thick] plot[domain=0.45:1.25, samples=60] ({2/\x},\x);
  \node[below] at (2.98,0.44) {$h_1(p,U^0)$};
  \node[below] at (4.5,0.44) {$x_1(p,W)$};
  \node[above] at (2.53,1.26) {$h_1(p,U^1)$};
  % puntos
  \fill (2,1) circle (1.6pt) node[above left] {$B$};
  \fill (2.8284,1) circle (1.6pt) node[above right] {$B'$};
  \fill (2.8284,0.5) circle (1.6pt) node[below left] {$C'$};
  \fill (4,0.5) circle (1.6pt) node[above right] {$C$};
  \node at (0.95,0.74) {VC};
\end{tikzpicture}
