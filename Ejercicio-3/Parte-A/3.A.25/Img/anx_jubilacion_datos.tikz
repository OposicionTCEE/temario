% Figura (Anexo III, «Jubilación»): la tasa de jubilación por edad y el efecto de retrasar la edad normal
% (GRUBER y WISE 1999; BEHAGHEL y BLAU 2012). Curvas ilustrativas: J(a) = 0,03 + 0,004 (a - 55) + 0,12 g(a - 62) + 0,16 g(a - a_N),
% con g(d) = exp(-(d/0,35)^2), edad anticipada a_A = 62 y edad normal a_N = 65; en (b), a_N' = 66 tras la reforma.
% La coordenada x es la edad menos 55.
% Escala: x = 0,4 cm por año; y = 13 cm. Generar con: bash Code/generar_figura.sh anx_jubilacion_datos
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=0.4cm, y=13cm]
  % ---------------- (a) Tasa de jubilación por edad ----------------
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (8,0.305) {(a) Tasa de jubilación por edad};
    \draw[->] (0,0) -- (16.5,0) node[below] {$a$};
    \draw[->] (0,0) -- (0,0.27) node[left] {$J$};
    \draw[very thick] plot[domain=0:15, samples=301] (\x,{0.03+0.004*\x+0.12*exp(-1*(((\x-7)/0.35)^2))+0.16*exp(-1*(((\x-10)/0.35)^2))});
    \draw[dotted] (7,0) -- (7,0.18);
    \draw[dotted] (10,0) -- (10,0.23);
    \node[below] at (7,0) {$a_A$};
    \node[below] at (10,0) {$a_N$};
  \end{scope}
  % ---------------- (b) Retraso de la edad normal ----------------
  \begin{scope}[xshift=8.2cm]
    \node[font=\footnotesize\bfseries] at (8,0.305) {(b) Retraso de la edad normal};
    \draw[->] (0,0) -- (16.5,0) node[below] {$a$};
    \draw[->] (0,0) -- (0,0.27) node[left] {$J$};
    \draw[thick, dashed] plot[domain=0:15, samples=301] (\x,{0.03+0.004*\x+0.12*exp(-1*(((\x-7)/0.35)^2))+0.16*exp(-1*(((\x-10)/0.35)^2))});
    \draw[very thick] plot[domain=0:15, samples=301] (\x,{0.03+0.004*\x+0.12*exp(-1*(((\x-7)/0.35)^2))+0.16*exp(-1*(((\x-11)/0.35)^2))});
    \draw[dotted] (7,0) -- (7,0.18);
    \draw[dotted] (10,0) -- (10,0.23);
    \draw[dotted] (11,0) -- (11,0.23);
    \node[below] at (7,0) {$a_A$};
    \node[below] at (10,0) {$a_N$};
    \node[below] at (11.2,0) {$a_N'$};
  \end{scope}
\end{tikzpicture}
