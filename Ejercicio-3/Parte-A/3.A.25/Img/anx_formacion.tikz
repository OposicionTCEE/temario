% Figura (Anexo II, «General y específica»): quién paga y quién cobra la formación en la empresa (BECKER 1962, 1964).
% Dos periodos: 0 (formación) y 1 (después). Sin formación, la productividad es \bar y = 2 en los dos periodos, y es
% también el salario que pagan las demás empresas. Con formación, la productividad neta es y_0 = 1,2 y después y_1 = 3,2.
% (a) General: w_0 = y_0, w_1 = y_1 (el trabajador paga y cobra todo). (b) Específica: y_0 < w_0 = 1,6 < \bar y < w_1 = 2,6 < y_1
% (la empresa paga w_0 - y_0 y recupera y_1 - w_1; el trabajador paga \bar y - w_0 y recupera w_1 - \bar y).
% Trazo grueso: salario; fino: productividad; de puntos: productividad sin formación.
% Escala: x = 2,6 cm por periodo; y = 0,95 cm. Generar con: bash Code/generar_figura.sh anx_formacion
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  % ---------------- (a) Formación general ----------------
  \begin{scope}[x=2.6cm, y=0.95cm]
    \node[font=\footnotesize\bfseries] at (1.15,4.35) {(a) Formación general};
    \draw[->] (0,0) -- (2.35,0) node[below] {$t$};
    \draw[->] (0,0) -- (0,4.0);
    \draw[dashed, thin] (1,0) -- (1,3.7);
    \node[below] at (0.5,0) {$0$};
    \node[below] at (1.5,0) {$1$};
    \draw[thick, dotted] (0,2) -- (2,2);
    \draw[very thick] (0,1.2) -- (1,1.2);
    \draw[very thick] (1,3.2) -- (2,3.2);
    \node[left] at (0,1.2) {$w_0=y_0$};
    \node[left] at (0,2) {$\bar y$};
    \node[right] at (2,3.2) {$w_1=y_1$};
  \end{scope}
  % ---------------- (b) Formación específica ----------------
  \begin{scope}[xshift=8.1cm, x=2.6cm, y=0.95cm]
    \node[font=\footnotesize\bfseries] at (1.15,4.35) {(b) Formación específica};
    \draw[->] (0,0) -- (2.35,0) node[below] {$t$};
    \draw[->] (0,0) -- (0,4.0);
    \draw[dashed, thin] (1,0) -- (1,3.7);
    \node[below] at (0.5,0) {$0$};
    \node[below] at (1.5,0) {$1$};
    \draw[thick, dotted] (0,2) -- (2,2);
    \draw[thin] (0,1.2) -- (1,1.2);
    \draw[thin] (1,3.2) -- (2,3.2);
    \draw[very thick] (0,1.6) -- (1,1.6);
    \draw[very thick] (1,2.6) -- (2,2.6);
    \node[left] at (0,1.2) {$y_0$};
    \node[left] at (0,1.6) {$w_0$};
    \node[left] at (0,2) {$\bar y$};
    \node[right] at (2,3.2) {$y_1$};
    \node[right] at (2,2.6) {$w_1$};
  \end{scope}
\end{tikzpicture}
