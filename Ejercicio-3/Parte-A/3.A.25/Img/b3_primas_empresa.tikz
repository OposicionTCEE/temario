% Figura (cuerpo, 3.5.3 «Primas de las empresas»): por qué empresas distintas pagan salarios distintos a trabajadores
% iguales si cada una se enfrenta a una oferta creciente (b1_monopsonio). Sustituye, el 03/11/2026 (segunda pasada), al
% intercambio de empresas de ABOWD, KRAMARZ y MARGOLIS (1999), demasiado ligado a un estudio.
% Oferta de trabajadores iguales a cada empresa w = 0,5 + 0,35 L (CMe_L) y coste marginal CMg_L = 0,5 + 0,7 L, las mismas
% para las dos. Valor del producto marginal de la empresa más productiva, A: w = 4 - 0,45 L; de la menos productiva, B:
% w = 3 - 0,45 L. Monopsonio: A contrata L_A = 3,043 y paga w_A = 1,565; B contrata L_B = 2,174 y paga w_B = 1,261.
% Con competencia, las dos pagarían el salario del mercado. Rectas ilustrativas.
% Escala: x = 0,8 cm, y = 1,05 cm. Generar con: bash Code/generar_figura.sh b3_primas_empresa
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=0.8cm, y=1.05cm]
  \draw[->] (0,0) -- (8.0,0) node[below] {$L$};
  \draw[->] (0,0) -- (0,4.1) node[left] {$w$};
  \draw[very thick] (0,0.5) -- (7.4,3.09) node[right] {$CMe_L$};
  \draw[thick, dashed] (0,0.5) -- (5.0,4.0) node[above] {$CMg_L$};
  \draw[very thick] (0,4) -- (7.6,0.58) node[right] {$VPMg_A$};
  \draw[very thick] (0,3) -- (6.4,0.12) node[right] {$VPMg_B$};
  \fill (3.043,2.630) circle (1.5pt);
  \fill (2.174,2.022) circle (1.5pt);
  \fill (3.043,1.565) circle (1.8pt) node[below right] {$M_A$};
  \fill (2.174,1.261) circle (1.8pt) node[below right] {$M_B$};
  \draw[dotted] (3.043,2.630) -- (3.043,0);
  \draw[dotted] (2.174,2.022) -- (2.174,0);
  \draw[dotted] (0,1.565) -- (3.043,1.565);
  \draw[dotted] (0,1.261) -- (2.174,1.261);
  \node[left] at (0,1.62) {$w_A$};
  \node[left] at (0,1.21) {$w_B$};
  \node[below] at (2.174,0) {$L_B$};
  \node[below] at (3.043,0) {$L_A$};
\end{tikzpicture}
