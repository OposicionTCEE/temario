% Figura (cuerpo, 1.4.3 «Impuestos»): por qué la pérdida de eficiencia se mide con la elasticidad compensada. Adaptada de
% anx_exceso_gravamen (mismos valores): en el cuerpo, (a) muestra que el impuesto no cambia las horas y aun así deja a la
% persona peor que un impuesto de cuantía fija con la misma recaudación, y (b) que la oferta observada no responde y la
% compensada sí.
% COBB-DOUGLAS U = (C ell)^(1/2), T = 5, R = 0 (E = (5; 0)), w = 1, tipo t = 0,7.
% (a) Sin impuesto, recta (5; 0)-(0; 5) y A = (2,5; 2,5); con el impuesto, recta (5; 0)-(0; 1,5) y B = (2,5; 0,75) en
%     C ell = 1,875; cuantía fija con la misma recaudación (1,75): recta C = 3,25 - ell y D = (1,625; 1,625) en
%     C ell = 2,6406; recta paralela tangente a U_B: C = 2,7386 - ell. Exceso de gravamen: 3,25 - 2,7386 = 0,511.
% (b) Oferta no compensada vertical en h = 2,5; compensada con la utilidad U_B, h^c(w') = 5 - 1,3693/sqrt(w'); salarios
%     w = 1 y w(1 - t) = 0,3; área sombreada = exceso de gravamen.
% Generar con: bash Code/generar_figura.sh b1_exceso_gravamen
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  % ---------------- (a) Mismas horas, menos utilidad ----------------
  \begin{scope}[x=1.0cm, y=1.0cm]
    \node[font=\footnotesize\bfseries] at (2.9,5.75) {(a) Mismas horas, menos utilidad};
    \draw[->] (0,0) -- (5.9,0) node[below] {$\ell$};
    \draw[->] (0,0) -- (0,5.4) node[left] {$C$};
    \draw[thick, black!55] (0,5) -- (5,0);
    \draw[very thick] (0,1.5) -- (5,0);
    \draw[very thick] (0,3.25) -- (3.25,0);
    \draw[dashed] (0,2.7386) -- (2.7386,0);
    \draw[thick] plot[domain=0.75:5.5, samples=100] (\x,{1.875/\x});
    \draw[thick] plot[domain=0.95:5.5, samples=100] (\x,{2.6406/\x});
    \node[right] at (5.5,{1.875/5.5-0.06}) {$U_B$};
    \node[right] at (5.5,{2.6406/5.5+0.1}) {$U_D$};
    \fill (2.5,2.5) circle (1.8pt) node[above right] {$A$};
    \fill (2.5,0.75) circle (1.8pt);
    \draw[thin] (2.5,0.75) -- (3.05,1.3) node[above right, inner sep=1pt] {$B$};
    \fill (1.625,1.625) circle (1.8pt) node[above right] {$D$};
    \draw[dotted] (2.5,2.5) -- (2.5,0);
    \node[below] at (5,0) {$T$};
    \draw[decorate, decoration={brace, amplitude=3pt}] (-0.12,2.7386) -- (-0.12,3.25) node[midway, left=3pt] {$EG$};
  \end{scope}
  % ---------------- (b) Oferta observada y compensada ----------------
  \begin{scope}[xshift=7.6cm, x=1.1cm, y=3.6cm]
    \node[font=\footnotesize\bfseries] at (2.0,1.6) {(b) Oferta observada y compensada};
    \fill[black!15] (2.5,0.3) -- plot[domain=0.3:1, samples=60] ({5-1.3693/sqrt(\x)},\x) -- (2.5,1) -- cycle;
    \draw[->] (0,0) -- (4.3,0) node[below] {$h$};
    \draw[->] (0,0) -- (0,1.38) node[left] {$w$};
    \draw[very thick] (2.5,0.05) -- (2.5,1.3) node[above] {$h^M$};
    \draw[thick] plot[domain=0.12:1.28, samples=100] ({5-1.3693/sqrt(\x)},\x);
    \node[right] at ({5-1.3693/sqrt(1.28)},1.28) {$h^c$};
    \draw[dashed] (0,1) -- (4.1,1);
    \draw[dashed] (0,0.3) -- (4.1,0.3);
    \node[left] at (0,1) {$w$};
    \node[left] at (0,0.3) {$w(1-t)$};
    \fill (2.5,0.3) circle (1.8pt) node[below right] {$B$};
    \node at (2.88,0.72) {$EG$};
  \end{scope}
\end{tikzpicture}
