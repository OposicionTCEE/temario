% Figura (cuerpo, 2.3 «Formación»): la inversión en capital humano a lo largo de la vida (BEN-PORATH 1967). Adaptada de
% anx_ben_porath: se quitan los ingresos de quien no invierte y el punto de alcance, que el cuerpo no comenta.
% Simulación ilustrativa: K_{t+1} = K_t + 0,11 (s_t K_t)^0,5 - 0,015 K_t, K_0 = 1; s_t = 1 durante 4 periodos de estudio y
% después s_t = (1 - (t - 4)/41)^2,5 hasta t = 45. Ingresos potenciales K_t; observados E_t = K_t (1 - s_t).
% Escala: x = 0,13 cm por periodo. Generar con: bash Code/generar_figura.sh b2_formacion
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  % ---------------- (a) Inversión ----------------
  \begin{scope}[x=0.13cm, y=4cm]
    \node[font=\footnotesize\bfseries] at (24,1.27) {(a) Inversión};
    \draw[->] (0,0) -- (50,0) node[below] {$t$};
    \draw[->] (0,0) -- (0,1.15) node[left] {$s_t$};
    \draw[very thick] (0,1) -- (4,1);
    \draw[very thick] plot[smooth] coordinates {(4,1.000) (6,0.882) (8,0.774) (10,0.673) (12,0.581) (14,0.497) (16,0.421) (18,0.352) (20,0.290) (22,0.236) (24,0.188) (26,0.146) (28,0.111) (30,0.081) (32,0.057) (34,0.037) (36,0.023) (38,0.012) (40,0.005) (42,0.001) (44,0.000)};
    \draw[dotted] (4,1) -- (4,0);
    \node[below] at (4,0) {$S$};
    \node[left] at (0,1) {$1$};
  \end{scope}
  % ---------------- (b) Ingresos ----------------
  \begin{scope}[xshift=7.6cm, x=0.13cm, y=1.3cm]
    \node[font=\footnotesize\bfseries] at (24,3.9) {(b) Ingresos};
    \draw[->] (0,0) -- (50,0) node[below] {$t$};
    \draw[->] (0,0) -- (0,3.6);
    \draw[thick, dashed] plot[smooth] coordinates {(0,1.000) (2,1.194) (4,1.402) (6,1.619) (8,1.832) (10,2.037) (12,2.230) (14,2.410) (16,2.574) (18,2.722) (20,2.851) (22,2.960) (24,3.050) (26,3.120) (28,3.170) (30,3.201) (32,3.212) (34,3.205) (36,3.181) (38,3.140) (40,3.086) (42,3.018) (44,2.940) (46,2.854)};
    \draw[very thick] (0,0) -- (4,0);
    \draw[very thick] plot[smooth] coordinates {(4,0.000) (5,0.090) (6,0.190) (7,0.299) (8,0.415) (9,0.537) (10,0.665) (11,0.798) (12,0.934) (14,1.212) (16,1.491) (18,1.764) (20,2.023) (22,2.263) (24,2.478) (26,2.664) (28,2.819) (30,2.942) (32,3.030) (34,3.086) (36,3.109) (38,3.103) (40,3.070) (42,3.014) (44,2.939) (46,2.854)};
    \node[above] at (31,3.25) {$K_t$};
