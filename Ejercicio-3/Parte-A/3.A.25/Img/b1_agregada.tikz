% Figura (cuerpo, 1.2.3 «Agregación»): la oferta de quien trabaja y la agregada. Horas de quien trabaja,
% h(w) = 2 + 0,4 (w - 0,6), y horas por persona en edad de trabajar, H(w) = F(w) h(w), con F la proporción que
% participa (la de b1_participacion): de w0 = 0,9 a w1 = 1,1, h pasa de 2,12 a 2,20 y H de 0,80 a 1,37. Valores ilustrativos.
% Escala: x = 2,3 cm, y = 2,6 cm. Generar con: bash Code/generar_figura.sh b1_agregada
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=2.3cm, y=2.6cm]
  \draw[->] (0,0) -- (2.75,0) node[below] {$h,\,H$};
  \draw[->] (0,0) -- (0,1.8) node[left] {$w$};
  \draw[very thick] plot[smooth] coordinates {(1.940,0.45) (2.000,0.60) (2.060,0.75) (2.120,0.90) (2.180,1.05) (2.240,1.20) (2.300,1.35) (2.360,1.50) (2.420,1.65)} node[above] {$h(w)$};
  \draw[very thick, dashed] plot[smooth] coordinates {(0.117,0.45) (0.189,0.55) (0.299,0.65) (0.459,0.75) (0.674,0.85) (0.937,0.95) (1.226,1.05) (1.508,1.15) (1.757,1.25) (1.959,1.35) (2.117,1.45) (2.237,1.55) (2.330,1.65)};
  \node[below] at (0.117,0.45) {$H(w)$};
  \draw[dotted] (0,0.9) -- (2.12,0.9);
  \draw[dotted] (0,1.1) -- (2.20,1.1);
  \foreach \p in {(0.800,0.9), (1.369,1.1), (2.120,0.9), (2.200,1.1)} \fill \p circle (1.6pt);
  \node[left] at (0,0.9) {$w_0$};
  \node[left] at (0,1.1) {$w_1$};
\end{tikzpicture}
