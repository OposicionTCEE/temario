% Figura (cuerpo, 1.2.3 «Agregación»): la oferta agregada como suma horizontal de las ofertas individuales. Rehecha el
% 04/11/2026 a petición del usuario: tres personas con salarios de reserva distintos (w_R1 = 0,4; w_R2 = 0,8;
% w_R3 = 1,2) que, por los costes fijos de trabajar, entran con un mínimo de una hora, y cuyas horas crecen después con el
% salario: h_i(w) = 1 + 0,6 (w - w_Ri) si w >= w_Ri.
% (a) Las tres ofertas individuales; de puntos, la entrada de cada persona en su salario de reserva.
% (b) La agregada, su suma horizontal: 0 hasta w_R1; 1 + 0,6 (w - 0,4) hasta w_R2 (de 1,00 a 1,24); salto a 2,24 y
%     2 + 0,6 [(w - 0,4) + (w - 0,8)] hasta w_R3 (a 2,72); salto a 3,72 y 3 + 0,6 [(w - 0,4) + (w - 0,8) + (w - 1,2)]
%     hasta w = 1,8 (4,8). Saltos (de puntos): margen extensivo; tramos crecientes: margen intensivo. Discontinua: la
%     agregada con muchas personas, por el centro de los saltos. Valores ilustrativos.
% Escala: (a) x = 2,2 cm por hora; (b) x = 1 cm por hora; y = 2,2 cm. Generar con: bash Code/generar_figura.sh b1_agregada
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  % ---------------- (a) Ofertas individuales ----------------
  \begin{scope}[x=2.2cm, y=2.2cm]
    \node[font=\footnotesize\bfseries] at (1.1,2.3) {(a) Ofertas individuales};
    \draw[->] (0,0) -- (2.3,0) node[below] {$h$};
    \draw[->] (0,0) -- (0,2.05) node[left] {$w$};
    \foreach \r/\n in {0.4/1, 0.8/2, 1.2/3} {
      \draw[dotted, thick] (0,\r) -- (1.0,\r);
      \draw[very thick] (1.0,\r) -- ({1.0+0.6*(1.8-\r)},1.8) node[above] {$h_{\n}$};
      \node[left] at (0,\r) {$w_{R\n}$};
    }
    \node[below] at (1.0,0) {$h_{\min}$};
    \draw[dotted] (1.0,0) -- (1.0,0.4);
  \end{scope}
  % ---------------- (b) Oferta agregada ----------------
  \begin{scope}[xshift=6.6cm, x=1cm, y=2.2cm]
    \node[font=\footnotesize\bfseries] at (2.7,2.3) {(b) Oferta agregada};
    \draw[->] (0,0) -- (5.4,0) node[below] {$H$};
    \draw[->] (0,0) -- (0,2.05) node[left] {$w$};
    \draw[very thick] (0,0) -- (0,0.4);
    \draw[very thick] (1.0,0.4) -- (1.24,0.8);
    \draw[very thick] (2.24,0.8) -- (2.72,1.2);
    \draw[very thick] (3.72,1.2) -- (4.8,1.8) node[above] {$H$};
    \draw[dotted, thick] (0,0.4) -- (1.0,0.4);
    \draw[dotted, thick] (1.24,0.8) -- (2.24,0.8);
    \draw[dotted, thick] (2.72,1.2) -- (3.72,1.2);
    \draw[dashed] plot[smooth] coordinates {(0.25,0.32) (0.5,0.4) (1.74,0.8) (3.22,1.2) (4.8,1.75)};
    \node[left] at (0,0.4) {$w_{R1}$};
    \node[left] at (0,0.8) {$w_{R2}$};
    \node[left] at (0,1.2) {$w_{R3}$};
  \end{scope}
\end{tikzpicture}
