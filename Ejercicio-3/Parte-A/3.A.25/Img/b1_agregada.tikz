% Figura (cuerpo, 1.2.3 «Agregación»): la participación hace más elástica la oferta agregada.
% (a) Salarios de reserva distribuidos con la densidad logística f(w_R) = F(1 - F)/0,2, F = 1/(1 + exp(-(w_R - 1)/0,2));
%     al subir el salario de w0 = 0,9 a w1 = 1,1 entran a trabajar las personas con w_R entre ambos (área sombreada).
% (b) Horas de quien trabaja, h(w) = 2 + 0,4 (w - 0,6), y horas por persona en edad de trabajar, H(w) = F(w) h(w):
%     de w0 a w1, h pasa de 2,12 a 2,20 y H de 0,80 a 1,37. Valores ilustrativos.
% Escala: (a) x = 3,2 cm, y = 3 cm; (b) x = 2,3 cm, y = 2,6 cm. Generar con: bash Code/generar_figura.sh b1_agregada
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  % ---------------- (a) Salarios de reserva ----------------
  \begin{scope}[x=3.2cm, y=3cm]
    \node[font=\footnotesize\bfseries] at (1.0,1.7) {(a) Salarios de reserva};
    \fill[black!15] plot[domain=0.9:1.1, samples=20] (\x,{exp(-(\x-1)/0.2)/(0.2*(1+exp(-(\x-1)/0.2))^2)}) -- (1.1,0) -- (0.9,0) -- cycle;
    \draw[->] (0,0) -- (2.05,0) node[below] {$w_R$};
    \draw[->] (0,0) -- (0,1.45) node[left] {$f(w_R)$};
    \draw[very thick] plot[domain=0.15:1.9, samples=80] (\x,{exp(-(\x-1)/0.2)/(0.2*(1+exp(-(\x-1)/0.2))^2)});
    \draw[dotted] (0.9,0) -- (0.9,1.3);
    \draw[dotted] (1.1,0) -- (1.1,1.3);
    \node[below] at (0.9,0) {$w_0$};
    \node[below] at (1.1,0) {$w_1$};
    \node at (1.0,0.5) {$\Delta N$};
  \end{scope}
  % ---------------- (b) Oferta individual y agregada ----------------
  \begin{scope}[xshift=8.0cm, x=2.3cm, y=2.6cm]
    \node[font=\footnotesize\bfseries] at (1.3,1.96) {(b) Oferta individual y agregada};
    \draw[->] (0,0) -- (2.75,0) node[below] {$h,\,H$};
    \draw[->] (0,0) -- (0,1.8) node[left] {$w$};
    \draw[very thick] plot[smooth] coordinates {(1.940,0.45) (2.000,0.60) (2.060,0.75) (2.120,0.90) (2.180,1.05) (2.240,1.20) (2.300,1.35) (2.360,1.50) (2.420,1.65)} node[above] {$h(w)$};
    \draw[very thick, dashed] plot[smooth] coordinates {(0.117,0.45) (0.189,0.55) (0.299,0.65) (0.459,0.75) (0.674,0.85) (0.937,0.95) (1.226,1.05) (1.508,1.15) (1.757,1.25) (1.959,1.35) (2.117,1.45) (2.237,1.55) (2.330,1.65)};
    \node[below] at (0.117,0.45) {$H(w)$};
    \draw[dotted] (0,0.9) -- (2.12,0.9);
    \draw[dotted] (0,1.1) -- (2.20,1.1);
    \foreach \p in {(0.800,0.9), (1.369,1.1), (2.120,0.9), (2.200,1.1)} \fill \p circle (1.6pt);
    \node[left] at (0,0.9) {$w_0$};
    \node[left] at (0,1.1) {$w_1$};
  \end{scope}
\end{tikzpicture}
