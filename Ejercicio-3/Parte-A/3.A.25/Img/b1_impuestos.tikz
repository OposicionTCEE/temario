% Figura (cuerpo, 1.4.3 «Impuestos»): un impuesto sobre el trabajo con salario flexible y con salario rígido.
% Demanda w = 5,5 - 0,9 L; oferta poco elástica w = 0,5 + 1,2 L; equilibrio E = (2,381; 3,357); cuña tau = 1.
% (a) Salario flexible: L = 1,905; coste para la empresa w_E = 3,786 y salario neto w_N = 2,786: el trabajador soporta
%     la mayor parte; triángulo sombreado = pérdida de eficiencia.
% (b) Salario neto rígido en w_ = 3,357: la empresa paga w_ + tau = 4,357 y contrata L_R = 1,270 (R); a ese salario
%     quieren trabajar L* = 2,381, de modo que la cuña crea paro. Rectas ilustrativas.
% Escala: x = 1,2 cm; y = 0,9 cm. Generar con: bash Code/generar_figura.sh b1_impuestos
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1.2cm, y=0.9cm]
  % ---------------- (a) Salario flexible ----------------
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (2.5,6.25) {(a) Salario flexible};
    \fill[black!15] (1.905,3.786) -- (1.905,2.786) -- (2.381,3.357) -- cycle;
    \draw[->] (0,0) -- (5.2,0) node[below] {$L$};
    \draw[->] (0,0) -- (0,5.8) node[left] {$w$};
    \draw[very thick] (0.2,5.32) -- (5.0,1.0) node[right] {$L^d$};
    \draw[very thick] (0,0.5) -- (4.0,5.3) node[above] {$L^s$};
    \fill (2.381,3.357) circle (1.8pt) node[right] {$E$};
    \draw[dotted] (0,3.786) -- (1.905,3.786);
    \draw[dotted] (0,3.357) -- (2.381,3.357);
    \draw[dotted] (0,2.786) -- (1.905,2.786);
    \draw[dotted] (1.905,2.786) -- (1.905,0);
    \node[left] at (0,3.786) {$w_E$};
    \node[left] at (0,3.357) {$w^*$};
    \node[left] at (0,2.786) {$w_N$};
    \draw[decorate, decoration={brace, amplitude=3pt}] (1.75,2.786) -- (1.75,3.786) node[midway, left=3pt] {$\tau$};
  \end{scope}
  % ---------------- (b) Salario rígido ----------------
  \begin{scope}[xshift=8.0cm]
    \node[font=\footnotesize\bfseries] at (2.5,6.25) {(b) Salario rígido};
    \draw[->] (0,0) -- (5.2,0) node[below] {$L$};
    \draw[->] (0,0) -- (0,5.8) node[left] {$w$};
    \draw[very thick] (0.2,5.32) -- (5.0,1.0) node[right] {$L^d$};
    \draw[very thick] (0,0.5) -- (4.0,5.3) node[above] {$L^s$};
    \draw[dashed] (0,4.357) -- (1.270,4.357);
    \draw[dashed] (0,3.357) -- (2.381,3.357);
    \fill (2.381,3.357) circle (1.8pt) node[right] {$E$};
    \fill (1.270,4.357) circle (1.8pt) node[above right] {$R$};
    \draw[dotted] (1.270,4.357) -- (1.270,0);
    \draw[dotted] (2.381,3.357) -- (2.381,0);
    \node[left] at (0,4.357) {$\bar w+\tau$};
    \node[left] at (0,3.357) {$\bar w$};
    \node[below] at (1.270,0) {$L_R$};
    \node[below] at (2.381,0) {$L^*$};
  \end{scope}
\end{tikzpicture}
