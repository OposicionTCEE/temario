% Figura (cuerpo, 1.4.3 «Impuestos»): un impuesto sobre el trabajo con salario flexible. Rehecha el 02/11/2026 a petición
% del usuario: oferta mucho menos elástica que la demanda, para que se vea que la cuña recae sobre todo en el trabajador.
% El caso del salario rígido va aparte, en b1_impuestos_rigido, porque el texto lo comenta en otro párrafo.
% Demanda w = 6 - L; oferta w = 1 + 2,5 L; equilibrio E = (1,4286; 4,5714). Cuña tau = 1: L_1 = 1,1429, coste para la
% empresa w_E = 4,8571 y salario neto w_N = 3,8571: el trabajador soporta 2,5/3,5 = 71 % de la cuña y la empresa, 29 %.
% Triángulo sombreado: pérdida de eficiencia (0,143). Rectas ilustrativas.
% Escala: x = 2,3 cm, y = 0,72 cm. Generar con: bash Code/generar_figura.sh b1_impuestos
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=2.3cm, y=0.72cm]
  \fill[black!15] (1.1429,4.8571) -- (1.4286,4.5714) -- (1.1429,3.8571) -- cycle;
  \draw[->] (0,0) -- (3.0,0) node[below] {$L$};
  \draw[->] (0,0) -- (0,6.9) node[left] {$w$};
  \draw[very thick] (0,1) -- (2.15,6.375) node[above] {$L^s$};
  \draw[very thick] (0,6) -- (2.8,3.2) node[right] {$L^d$};
  \draw[very thick] (1.1429,3.8571) -- (1.1429,4.8571);
  \node[left, font=\scriptsize] at (1.1429,4.36) {$\tau$};
  \fill (1.4286,4.5714) circle (1.6pt) node[below right] {$E$};
  \fill (1.1429,4.8571) circle (1.6pt);
  \fill (1.1429,3.8571) circle (1.6pt);
  \draw[dotted] (0,4.8571) -- (1.1429,4.8571);
  \draw[dotted] (0,4.5714) -- (1.4286,4.5714);
  \draw[dotted] (0,3.8571) -- (1.1429,3.8571);
  \draw[dotted] (1.1429,3.8571) -- (1.1429,0);
  \draw[dotted] (1.4286,4.5714) -- (1.4286,0);
  \node[left] at (0,4.95) {$w_E$};
  \node[left] at (0,4.47) {$w^*$};
  \node[left] at (0,3.8571) {$w_N$};
  \node[below] at (1.1429,0) {$L_1$};
  \node[below] at (1.4286,0) {$L^*$};
\end{tikzpicture}
