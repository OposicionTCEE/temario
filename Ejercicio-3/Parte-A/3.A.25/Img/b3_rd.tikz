% Figura (cuerpo, 3.1 «Metodología», experimentos naturales): la discontinuidad en la regresión. Adaptada del panel (b)
% de anx_cuasiexperimentos.
% Resultado 1 + 0,4 x a la izquierda del umbral x = 2 y 2,6 + 0,35 (x - 2) a la derecha; salto beta_RD = 0,8 en el
% umbral; puntos ilustrativos alrededor de las rectas.
% Escala: x = 1,15 cm; y = 0,5 cm. Generar con: bash Code/generar_figura.sh b3_rd
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1.15cm, y=0.5cm]
  \draw[->] (0,0) -- (4.3,0) node[below] {$x$};
  \draw[->] (0,0) -- (0,3.75) node[left] {$y$};
  \foreach \p in {(0.2,0.95), (0.45,1.35), (0.7,1.1), (0.95,1.55), (1.2,1.3), (1.45,1.75), (1.7,1.55), (1.9,1.85), (2.1,2.75), (2.35,2.6), (2.6,3.0), (2.85,2.8), (3.1,3.15), (3.35,2.95), (3.6,3.35), (3.85,3.1)}
    \fill[black!60] \p circle (1.1pt);
  \draw[very thick] (0,1.0) -- (2,1.8);
  \draw[very thick] (2,2.6) -- (4,3.3);
  \draw[dotted] (2,0) -- (2,3.5);
  \draw[<->, thin] (2.15,1.82) -- (2.15,2.58);
  \node[right] at (2.15,2.2) {$\beta_{RD}$};
  \node[below] at (2,0) {$\bar x$};
\end{tikzpicture}
