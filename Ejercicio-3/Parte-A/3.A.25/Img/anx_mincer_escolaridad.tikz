% Figura (Anexo II, «Escolaridad»): la función de ingresos como condición de equilibrio (MINCER 1958).
% Tres escolaridades, S = 0, S_1 = 4 y S_2 = 8 años; cada persona trabaja N = 40 años al terminar los estudios con ingresos
% constantes; ln w(S) = ln w(0) + r S con r = 0,08 (el origen del eje vertical es arbitrario: ln w(0) se dibuja en 0,5).
% Los puntos en que empieza cada perfil están sobre la recta de pendiente r, que es la función ln w(S).
% Escala: x = 0,15 cm por año; y = 2,6 cm. Generar con: bash Code/generar_figura.sh anx_mincer_escolaridad
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=0.15cm, y=2.6cm]
  \draw[->] (0,0) -- (52,0) node[below] {$t$};
  \draw[->] (0,0) -- (0,1.6) node[left] {$\ln w$};
  \draw[very thick] (0,0.5) -- (40,0.5) node[right] {$\ln w(0)$};
  \draw[very thick] (4,0.82) -- (44,0.82) node[right] {$\ln w(S_1)$};
  \draw[very thick] (8,1.14) -- (48,1.14) node[right] {$\ln w(S_2)$};
  \draw[thick, dashed] (0,0.5) -- (12.5,1.5) node[above] {$\ln w(S)$};
  \fill (0,0.5) circle (1.8pt);
  \fill (4,0.82) circle (1.8pt);
  \fill (8,1.14) circle (1.8pt);
  \draw[dotted] (4,0.82) -- (4,0);
  \draw[dotted] (8,1.14) -- (8,0);
  \node[below] at (4,0) {$S_1$};
  \node[below] at (8,0) {$S_2$};
\end{tikzpicture}
