% Figura (Anexo I, «Impuestos»): incidencia de un impuesto sobre el trabajo (cuña fiscal de 1 por hora) y pérdida de
% eficiencia, con la misma demanda w = 4,5 - 0,5 L y dos ofertas.
% (a) Oferta poco elástica, w = 0,5 + 1,2 L: sin impuesto, E = (2,353; 3,324); con el impuesto, L = 1,765, coste para la
%     empresa w_E = 3,618 y salario neto w_N = 2,618: el trabajador soporta 0,706 de cada unidad.
% (b) Oferta elástica, w = 2,3 + 0,3 L: E = (2,75; 3,125); con el impuesto, L = 1,5, w_E = 3,75, w_N = 2,75: el
%     trabajador soporta 0,375. Triángulos sombreados: pérdida de eficiencia. Rectas ilustrativas.
% Escala: x = 1,25 cm, y = 1,05 cm. Generar con: bash Code/generar_figura.sh anx_incidencia
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1.25cm, y=1.05cm]
  % ---------------- (a) Oferta poco elástica ----------------
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (2.4,5.1) {(a) Oferta poco elástica};
    \fill[black!15] (1.765,3.618) -- (2.353,3.324) -- (1.765,2.618) -- cycle;
    \draw[->] (0,0) -- (4.9,0) node[below] {$L$};
    \draw[->] (0,0) -- (0,4.8) node[left] {$w$};
    \draw[very thick] (0.3,0.86) -- (3.4,4.58) node[above] {$L^s$};
    \draw[very thick] (0.3,4.35) -- (4.5,2.25) node[right] {$L^d$};
    \draw[dotted] (0,3.618) -- (1.765,3.618);
    \draw[dotted] (0,2.618) -- (1.765,2.618);
    \draw[dotted] (0,3.324) -- (2.353,3.324);
    \draw[dotted] (1.765,2.618) -- (1.765,0);
    \draw[dotted] (2.353,3.324) -- (2.353,0);
    \fill (2.353,3.324) circle (1.6pt) node[right] {$E$};
    \node[left] at (0,3.618) {$w_E$};
    \node[left] at (0,3.324) {$w^*$};
    \node[left] at (0,2.618) {$w_N$};
    \draw[decorate, decoration={brace, amplitude=3pt}] (1.62,2.618) -- (1.62,3.618) node[midway, left=3pt] {$\tau$};
  \end{scope}
  % ---------------- (b) Oferta elástica ----------------
  \begin{scope}[xshift=7.4cm]
    \node[font=\footnotesize\bfseries] at (2.4,5.1) {(b) Oferta elástica};
    \fill[black!15] (1.5,3.75) -- (2.75,3.125) -- (1.5,2.75) -- cycle;
    \draw[->] (0,0) -- (4.9,0) node[below] {$L$};
    \draw[->] (0,0) -- (0,4.8) node[left] {$w$};
    \draw[very thick] (0.2,2.36) -- (4.5,3.65) node[right] {$L^s$};
    \draw[very thick] (0.3,4.35) -- (4.5,2.25) node[right] {$L^d$};
    \draw[dotted] (0,3.75) -- (1.5,3.75);
    \draw[dotted] (0,2.75) -- (1.5,2.75);
    \draw[dotted] (0,3.125) -- (2.75,3.125);
    \draw[dotted] (1.5,2.75) -- (1.5,0);
    \draw[dotted] (2.75,3.125) -- (2.75,0);
    \fill (2.75,3.125) circle (1.6pt) node[above right] {$E$};
    \node[left] at (0,3.75) {$w_E$};
    \node[left] at (0,3.125) {$w^*$};
    \node[left] at (0,2.75) {$w_N$};
    \draw[decorate, decoration={brace, amplitude=3pt}] (1.36,2.75) -- (1.36,3.75) node[midway, left=3pt] {$\tau$};
  \end{scope}
\end{tikzpicture}
