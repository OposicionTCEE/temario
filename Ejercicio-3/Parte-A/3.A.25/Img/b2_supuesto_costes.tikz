% Figura (cuerpo, 2.4 «Función de ingresos»): si estudiar tiene costes directos, el coeficiente sobrestima la tasa
% interna de rendimiento. Pedida por el usuario el 02/11/2026 («¿Ilustrar lo que sucedería sin estos supuestos?»).
% Relación de equilibrio entre escolaridad e ingresos (MINCER 1958), con origen arbitrario ln w(0) = 0,5: solo con el
% coste de oportunidad, pendiente r = 0,10 (discontinua); con costes directos, para que el valor presente sea el mismo con
% cualquier escolaridad, los ingresos tienen que crecer más con S: pendiente rho = 0,16 > r (continua). S_1 = 4, S_2 = 8.
% Valores ilustrativos. Escala: x = 0,55 cm por año, y = 1,6 cm. Generar con: bash Code/generar_figura.sh b2_supuesto_costes
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=0.55cm, y=1.6cm]
  \draw[->] (0,0) -- (11,0) node[below] {$S$};
  \draw[->] (0,0) -- (0,3.1) node[left] {$\ln w$};
  \draw[thick, dashed] (0,0.5) -- (10,1.5) node[right] {$\ln w(0)+r\,S$};
  \draw[very thick] (0,0.5) -- (10,2.1) node[right] {$\ln w(0)+\rho\,S$};
  \foreach \s in {4,8} {
    \fill (\s,{0.5+0.1*\s}) circle (1.6pt);
    \fill (\s,{0.5+0.16*\s}) circle (1.8pt);
    \draw[dotted] (\s,{0.5+0.16*\s}) -- (\s,0);
  }
  \node[below] at (4,0) {$S_1$};
  \node[below] at (8,0) {$S_2$};
\end{tikzpicture}
