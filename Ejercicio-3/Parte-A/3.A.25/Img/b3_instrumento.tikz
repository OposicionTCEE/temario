% Figura (cuerpo, 3.1 «Metodología», variables instrumentales): adaptada del esquema de pizarra del usuario
% (Img/IMG_7472.jpg, 02/11/2026, borrado después).
% (a) Instrumento y resultados potenciales: la asignación Z da dos tratamientos potenciales, D(0) y D(1), y cada
%     tratamiento dos resultados potenciales, Y(0) e Y(1); de cada persona solo se observa uno, Y_i = Y_i(D_i), que es el
%     problema fundamental de la inferencia causal (HOLLAND 1986).
% (b) Tipos de comportamiento según los tratamientos potenciales (IMBENS y ANGRIST 1994; ANGRIST, IMBENS y RUBIN 1996):
%     nunca tratados (0, 0), cumplidores (0, 1), siempre tratados (1, 1) y desafiantes (1, 0); el instrumento solo cambia
%     el tratamiento de los cumplidores (sombreado), y la monotonía descarta a los desafiantes (en gris).
% Generar con: bash Code/generar_figura.sh b3_instrumento
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  % ---------------- (a) Instrumento y resultados potenciales ----------------
  \begin{scope}[x=1cm, y=1cm]
    \node[font=\footnotesize\bfseries] at (3,4.75) {(a) Instrumento y resultados potenciales};
    \node (Z) at (3,4) {$Z$};
    \node (D0) at (1.5,2.6) {$D(0)$};
    \node (D1) at (4.5,2.6) {$D(1)$};
    \node (Y00) at (0.75,1.1) {$Y(0)$};
    \node (Y01) at (2.25,1.1) {$Y(1)$};
    \node (Y10) at (3.75,1.1) {$Y(0)$};
    \node (Y11) at (5.25,1.1) {$Y(1)$};
    \draw[thick] (Z) -- (D0) node[midway, above left, font=\scriptsize] {$Z=0$};
    \draw[thick] (Z) -- (D1) node[midway, above right, font=\scriptsize] {$Z=1$};
    \draw[thick] (D0) -- (Y00);
    \draw[thick] (D0) -- (Y01);
    \draw[thick] (D1) -- (Y10);
    \draw[thick] (D1) -- (Y11);
    \draw[decorate, decoration={brace, amplitude=4pt, mirror}] (0.35,0.75) -- (2.65,0.75) node[midway, below=5pt] {$Y_i=Y_i(D_i)$};
  \end{scope}
  % ---------------- (b) Tipos de comportamiento ----------------
  \begin{scope}[xshift=7.6cm, x=2.4cm, y=1.25cm]
    \node[font=\footnotesize\bfseries] at (1,3.8) {(b) Tipos de comportamiento};
    \fill[black!15] (1,1) rectangle (2,2);
    \fill[black!5] (0,0) rectangle (1,1);
    \draw[thick] (0,0) rectangle (2,2);
    \draw[thick] (1,0) -- (1,2);
    \draw[thick] (0,1) -- (2,1);
    \node[font=\scriptsize] at (0.5,1.5) {nunca tratados};
    \node[font=\scriptsize\bfseries] at (1.5,1.5) {cumplidores};
    \node[font=\scriptsize, black!55] at (0.5,0.5) {desafiantes};
    \node[font=\scriptsize] at (1.5,0.5) {siempre tratados};
    \node at (0.5,2.3) {$0$};
    \node at (1.5,2.3) {$1$};
    \node at (1,2.75) {$D(1)$};
    \node at (-0.18,1.5) {$0$};
    \node at (-0.18,0.5) {$1$};
    \node at (-0.55,1) {$D(0)$};
  \end{scope}
\end{tikzpicture}
