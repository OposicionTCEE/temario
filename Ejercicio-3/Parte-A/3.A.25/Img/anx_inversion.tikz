% Figura (Anexo II, «Decisión»): perfiles de ingresos por edad con y sin estudios superiores (BECKER 1964).
% Edad de 18 a 65. Sin estudios superiores: w_B(t) = 1 + 0,06 (t - 18) - 0,0009 (t - 18)^2.
% Con estudios superiores: costes directos de 0,4 entre los 18 y los 22 años (por debajo del eje) y, desde los 22,
% w_U(t) = 1,5 + 0,1 (t - 22) - 0,0013 (t - 22)^2. Áreas: C_d costes directos; C_o ingresos a los que se renuncia;
% B ganancia de ingresos. Curvas ilustrativas.
% Escala: x = 0,24 cm por año; y = 1,1 cm. Generar con: bash Code/generar_figura.sh anx_inversion
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=0.24cm, y=1.1cm]
  % áreas
  \fill[black!25] (18,0) rectangle (22,-0.4);
  \fill[black!10] (18,0) -- plot[domain=18:22, samples=20] (\x,{1+0.06*(\x-18)-0.0009*(\x-18)^2}) -- (22,0) -- cycle;
  \fill[black!15] plot[domain=22:65, samples=80] (\x,{1.5+0.1*(\x-22)-0.0013*(\x-22)^2}) -- plot[domain=65:22, samples=80] (\x,{1+0.06*(\x-18)-0.0009*(\x-18)^2}) -- cycle;
  % ejes
  \draw[->] (16,0) -- (68,0) node[below] {$t$};
  \draw[->] (16,-0.7) -- (16,4.0) node[left] {$w$};
  % curvas
  \draw[very thick] plot[domain=18:65, samples=80] (\x,{1+0.06*(\x-18)-0.0009*(\x-18)^2}) node[right] {$w_B(t)$};
  \draw[very thick] (18,-0.4) -- (22,-0.4) -- (22,1.5);
  \draw[very thick] plot[domain=22:65, samples=80] (\x,{1.5+0.1*(\x-22)-0.0013*(\x-22)^2}) node[right] {$w_U(t)$};
  % rótulos
  \node at (20,-0.2) {$C_d$};
  \node at (20,0.5) {$C_o$};
  \node at (45,2.35) {$B$};
  \draw[dotted] (18,0) -- (18,-0.7) node[below] {$18$};
  \draw[dotted] (22,-0.4) -- (22,-0.7) node[below] {$22$};
  \node[below] at (65,0) {$65$};
\end{tikzpicture}
