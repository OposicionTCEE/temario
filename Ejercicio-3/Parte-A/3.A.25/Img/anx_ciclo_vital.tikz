% Figura (Anexo I, «Ciclo vital»): la oferta de trabajo a lo largo de la vida.
% (a) Perfiles previstos con utilidad separable e isoelástica, beta(1+r) = 1 y elasticidad de FRISCH 0,5: salario
%     w_t = exp(0,06 t - 0,0012 t^2) (máximo hacia t = 25); horas h_t = sqrt(w_t) (siguen al salario, con menos amplitud);
%     consumo constante (nivel ilustrativo). Edad t de 0 a 45 (1 unidad = 0,12 cm); valores en índice (w_0 = h_0 = 1; 1 unidad = 2,2 cm,
%     eje desde 0,8).
% (b) Tres respuestas de las horas a un mismo cambio del salario desde A: FRISCH (la más plana), HICKS y MARSHALL
%     (la más empinada), rectas ilustrativas por A = (2; 1,5) con pendientes dh/dw = 1,6, 0,8 y 0,25.
% Generar con: bash Code/generar_figura.sh anx_ciclo_vital
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  % ---------------- (a) Perfiles a lo largo de la vida ----------------
  \begin{scope}[x=0.12cm, y=2.2cm]
    \node[font=\footnotesize\bfseries] at (24,2.5) {(a) Perfiles a lo largo de la vida};
    \draw[->] (0,0.8) -- (49,0.8) node[below] {$t$};
    \draw[->] (0,0.8) -- (0,2.35);
    \draw[very thick] plot[smooth] coordinates {(0,1.000) (3,1.184) (6,1.373) (9,1.557) (12,1.728) (15,1.878) (18,1.996) (21,2.077) (24,2.114) (27,2.107) (30,2.054) (33,1.961) (36,1.831) (39,1.673) (42,1.497) (45,1.310)};
    \draw[thick, dashed] plot[smooth] coordinates {(0,1.000) (3,1.088) (6,1.172) (9,1.248) (12,1.315) (15,1.370) (18,1.413) (21,1.441) (24,1.454) (27,1.452) (30,1.433) (33,1.400) (36,1.353) (39,1.294) (42,1.223) (45,1.145)};
    \draw[thick, dotted] (0,1.65) -- (45,1.65);
    \node[right] at (45,1.310) {$w_t$};
    \node[right] at (45,1.145) {$h_t$};
    \node[right] at (45,1.65) {$C_t$};
    \node[below] at (0,0.8) {$0$};
    \node[below] at (45,0.8) {$J$};
  \end{scope}
  % ---------------- (b) Tres elasticidades ----------------
  \begin{scope}[xshift=7.8cm, x=1.5cm, y=2.4cm]
    \node[font=\footnotesize\bfseries] at (1.6,2.42) {(b) Tres respuestas al salario};
    \draw[->] (0,0) -- (3.6,0) node[below] {$h$};
    \draw[->] (0,0) -- (0,2.1) node[left] {$w$};
    \draw[very thick] (1.2,1.0) -- (2.72,1.95) node[right] {$h^F$};
    \draw[very thick] (1.6,1.0) -- (2.36,1.95) node[above] {$h^H$};
    \draw[very thick] (1.875,1.0) -- (2.1125,1.95) node[above] {$h^M$};
    \fill (2,1.5) circle (1.8pt);
    \node[left] at (1.97,1.5) {$A$};
    \draw[dotted] (0,1.5) -- (2,1.5);
    \draw[dotted] (2,1.5) -- (2,0);
    \node[left] at (0,1.5) {$w_0$};
    \node[below] at (2,0) {$h_0$};
  \end{scope}
\end{tikzpicture}
