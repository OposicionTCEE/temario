% Figura (Anexo II, «Mercados imperfectos»): la compresión salarial y la formación general que paga la empresa
% (ACEMOGLU y PISCHKE 1998, 1999). Formación tau; productividad f(tau) = 1 + 2 ln(1 + tau); salario comprimido
% w(tau) = 1 + 1,2 ln(1 + tau); renta de la empresa Delta(tau) = f - w = 0,8 ln(1 + tau); coste marginal c'(tau) = 0,4 tau.
% (a) Productividad y salario, con la renta Delta en tau = 2,2. (b) Formación elegida: Delta'(tau*) = c'(tau*) en tau* = 1;
% eficiente f'(tau^e) = c'(tau^e) en tau^e = (sqrt(21) - 1)/2 = 1,79.
% Escala: x = 1,8 cm; (a) y = 0,8 cm; (b) y = 1,5 cm. Generar con: bash Code/generar_figura.sh anx_compresion
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  % ---------------- (a) Productividad y salario ----------------
  \begin{scope}[x=1.8cm, y=0.8cm]
    \node[font=\footnotesize\bfseries] at (1.6,4.75) {(a) Productividad y salario};
    \draw[->] (0,0) -- (3.35,0) node[below] {$\tau$};
    \draw[->] (0,0) -- (0,4.3);
    \draw[very thick] plot[smooth] coordinates {(0.000,1.000) (0.250,1.446) (0.500,1.811) (0.750,2.119) (1.000,2.386) (1.250,2.622) (1.500,2.833) (1.750,3.023) (2.000,3.197) (2.250,3.357) (2.500,3.506) (2.750,3.644) (3.000,3.773)} node[right] {$f(\tau)$};
    \draw[very thick, dashed] plot[smooth] coordinates {(0.000,1.000) (0.250,1.268) (0.500,1.487) (0.750,1.672) (1.000,1.832) (1.250,1.973) (1.500,2.100) (1.750,2.214) (2.000,2.318) (2.250,2.414) (2.500,2.503) (2.750,2.586) (3.000,2.664)} node[right] {$w(\tau)$};
    \draw[<->, thin] (2.2,2.42) -- (2.2,3.30);
    \node[left] at (2.2,2.86) {$\Delta(\tau)$};
  \end{scope}
  % ---------------- (b) Formación elegida ----------------
  \begin{scope}[xshift=8.0cm, x=1.8cm, y=1.5cm]
    \node[font=\footnotesize\bfseries] at (1.6,2.53) {(b) Formación elegida};
    \draw[->] (0,0) -- (3.35,0) node[below] {$\tau$};
    \draw[->] (0,0) -- (0,2.3);
    \draw[very thick] plot[smooth] coordinates {(0.000,2.000) (0.250,1.600) (0.500,1.333) (0.750,1.143) (1.000,1.000) (1.250,0.889) (1.500,0.800) (1.750,0.727) (2.000,0.667) (2.250,0.615) (2.500,0.571) (2.750,0.533) (3.000,0.500)} node[right] {$f'(\tau)$};
    \draw[very thick, dashed] plot[smooth] coordinates {(0.000,0.800) (0.250,0.640) (0.500,0.533) (0.750,0.457) (1.000,0.400) (1.250,0.356) (1.500,0.320) (1.750,0.291) (2.000,0.267) (2.250,0.246) (2.500,0.229) (2.750,0.213) (3.000,0.200)} node[right] {$\Delta'(\tau)$};
    \draw[thick] (0,0) -- (3,1.2) node[right] {$c'(\tau)$};
    \fill (1,0.4) circle (1.8pt);
    \fill (1.7913,0.7165) circle (1.8pt);
    \draw[dotted] (1,0.4) -- (1,0);
    \draw[dotted] (1.7913,0.7165) -- (1.7913,0);
    \node[below] at (1,0) {$\tau^*$};
    \node[below] at (1.7913,0) {$\tau^e$};
  \end{scope}
\end{tikzpicture}
