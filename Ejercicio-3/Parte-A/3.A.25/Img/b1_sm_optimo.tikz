% Figura (cuerpo, 1.4.2 «Salario mínimo»): el salario mínimo con monopsonio y el salario mínimo óptimo. Junta la
% competencia (b1_sm_competencia) y el monopsonio (b1_monopsonio), como pidió el usuario el 02/11/2026.
% Mismas rectas: oferta w = 0,5 + 0,35 L; CMg_L = 0,5 + 0,7 L; demanda w = 4 - 0,45 L; M = (3,043; 1,565); E = (4,375; 2,031).
% (a) Un mínimo de 1,9, entre w_M y w*: el coste marginal es el propio mínimo hasta la oferta (N = (4; 1,9)) y salta
%     después al CMg_L (3,3 en L = 4).
% (b) Empleo según el mínimo: con monopsonio, L_M mientras el mínimo no supera w_M; L^s(w_) = (w_ - 0,5)/0,35 entre w_M y w*;
%     L^d(w_) = (4 - w_)/0,45 por encima de w*. Con competencia (discontinua), L* hasta w* y la demanda después.
% Escala: (a) x = 0,8 cm, y = 1,05 cm; (b) x = 1,55 cm, y = 0,85 cm. Generar con: bash Code/generar_figura.sh b1_sm_optimo
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  % ---------------- (a) Salario mínimo con monopsonio ----------------
  \begin{scope}[x=0.8cm, y=1.05cm]
    \node[font=\footnotesize\bfseries] at (3.8,4.6) {(a) Salario mínimo con monopsonio};
    \draw[->] (0,0) -- (8.0,0) node[below] {$L$};
    \draw[->] (0,0) -- (0,4.1) node[left] {$w$};
    \draw[very thick] (0,0.5) -- (7.4,3.09) node[right] {$L^s$};
    \draw[very thick] (0,4) -- (7.6,0.58) node[right] {$L^d$};
    \draw[thin, dashed] (0,0.5) -- (5.0,4.0) node[above] {$CMg_L$};
    \draw[very thick, dashed] (0,1.9) -- (4.0,1.9);
    \draw[very thick, dashed] (4.0,3.3) -- (5.0,4.0);
    \draw[dotted] (4.0,1.9) -- (4.0,3.3);
    \fill (3.043,1.565) circle (1.8pt) node[below right] {$M$};
    \fill (4.0,1.9) circle (1.8pt) node[below right] {$N$};
    \fill (4.375,2.031) circle (1.8pt) node[above right] {$E$};
    \draw[dotted] (0,1.565) -- (3.043,1.565);
    \draw[dotted] (4.0,1.9) -- (4.0,0);
    \node[left] at (0,1.9) {$\underline w$};
    \node[left] at (0,1.565) {$w_M$};
    \node[below] at (4.0,0) {$L^s(\underline w)$};
  \end{scope}
  % ---------------- (b) Empleo según el salario mínimo ----------------
  \begin{scope}[xshift=8.3cm, x=1.55cm, y=0.85cm]
    \node[font=\footnotesize\bfseries] at (1.9,5.7) {(b) Empleo según el salario mínimo};
    \draw[->] (0,0) -- (3.9,0) node[below] {$\underline w$};
    \draw[->] (0,0) -- (0,5.2) node[left] {$L$};
    \draw[very thick] (0.8,3.043) -- (1.565,3.043) -- (2.031,4.375) -- (3.6,0.889);
    \draw[thick, dashed] (0.8,4.375) -- (2.031,4.375);
    \fill (2.031,4.375) circle (1.8pt) node[above right] {$E$};
    \fill (1.565,3.043) circle (1.8pt) node[below right] {$M$};
    \draw[dotted] (1.565,3.043) -- (1.565,0);
    \draw[dotted] (2.031,4.375) -- (2.031,0);
    \draw[dotted] (0,3.043) -- (0.8,3.043);
    \draw[dotted] (0,4.375) -- (0.8,4.375);
    \node[below] at (1.565,0) {$w_M$};
    \node[below] at (2.031,0) {$w^*$};
    \node[left] at (0,3.043) {$L_M$};
    \node[left] at (0,4.375) {$L^*$};
  \end{scope}
\end{tikzpicture}
