% Figura (Anexo III, «Experimentos naturales» de la educación; estaba en el cuerpo y se trasladó el 04/11/2026): lo que mide una variable instrumental sobre el mercado de la escolaridad de
% BECKER (1967) y CARD (2001) (b2_escolaridad_optima). Rehecha el 03/11/2026 (segunda pasada): el sesgo de capacidad pasó
% a b2_supuesto_capacidad, y la recta de la variable instrumental, a la metodología (b3_instrumento).
% Rendimiento marginal de dos personas con la misma capacidad, rho = 0,22 - 0,01 S. Coste marginal de quien se financia
% bien, i_1 = 0,04 + 0,002 S (A = (15; 0,07)), y de quien se financia mal, i_2 = 0,10 + 0,002 S (B = (10; 0,12)). Un
% instrumento que abarata los estudios a quien se financia mal (una beca, una universidad cercana) baja su coste a
% i_2' = 0,07 + 0,002 S (discontinua): pasa a B' = (12,5; 0,095), y el rendimiento de sus años adicionales, entre 0,12 y
% 0,095, supera el marginal de A (0,07).
% Escala: x = 0,3 cm por año, y = 16 cm. Generar con: bash Code/generar_figura.sh anx_instrumento_escolaridad
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=0.3cm, y=16cm]
  \fill[black!15] (10,0) -- (10,0.12) -- (12.5,0.095) -- (12.5,0) -- cycle;
  \draw[->] (0,0) -- (23.5,0) node[below] {$S$};
  \draw[->] (0,0) -- (0,0.27) node[left] {$\rho,\ i$};
  \draw[very thick] (0,0.22) -- (22,0.0) node[above right] {$\rho$};
  \draw[very thick, dashed] (0,0.04) -- (22,0.084) node[right] {$i_1$};
  \draw[very thick, dashed] (0,0.10) -- (22,0.144) node[right] {$i_2$};
  \draw[thick, dotted] (0,0.07) -- (22,0.114) node[right] {$i_2'$};
  \fill (15,0.07) circle (1.8pt) node[below] {$A$};
  \fill (10,0.12) circle (1.8pt) node[above] {$B$};
  \fill (12.5,0.095) circle (1.8pt) node[above right] {$B'$};
  \draw[dotted] (15,0.07) -- (15,0);
  \node[below] at (10,0) {$S_B$};
  \node[below] at (12.5,0) {$S_{B'}$};
  \node[below] at (15,0) {$S_A$};
\end{tikzpicture}
