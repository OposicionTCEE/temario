% Figura (cuerpo, 2.2 «Escolaridad»): la escolaridad óptima con capacidad y financiación distintas (BECKER 1967; CARD
% 2001). Era el panel (b) de b2_escolaridad (dividida a petición del usuario, 02/11/2026); eje vertical rotulado.
% Rendimiento marginal rho_i = b_i - 0,01 S (b = 0,22 y 0,28) y coste marginal de financiarse i_i = r_i + 0,002 S
% (r = 0,04 y 0,10): A = (15; 0,07), B = (10; 0,12), C = (20; 0,08), D = (15; 0,13).
% Escala: x = 0,27 cm por año, y = 15 cm. Generar con: bash Code/generar_figura.sh b2_escolaridad_optima
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=0.27cm, y=15cm]
  \draw[->] (0,0) -- (23.5,0) node[below] {$S$};
  \draw[->] (0,0) -- (0,0.29) node[left] {$\rho,\ i$};
  \draw[very thick] (0,0.22) -- (22,0.0) node[above right] {$\rho_1$};
  \draw[very thick] (0,0.28) -- (22,0.06) node[right] {$\rho_2$};
  \draw[very thick, dashed] (0,0.04) -- (22,0.084) node[right] {$i_1$};
  \draw[very thick, dashed] (0,0.10) -- (22,0.144) node[right] {$i_2$};
  \fill (15,0.07) circle (1.8pt) node[below] {$A$};
  \fill (10,0.12) circle (1.8pt) node[above] {$B$};
  \fill (20,0.08) circle (1.8pt) node[below] {$C$};
  \fill (15,0.13) circle (1.8pt) node[above] {$D$};
\end{tikzpicture}
