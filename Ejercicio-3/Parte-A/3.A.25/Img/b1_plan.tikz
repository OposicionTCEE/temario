% Figura (cuerpo, 1.3.1 «Plan de vida»): el plan de trabajo y de consumo con dos periodos, hoy (t = 0) y mañana (t = 1).
% Rehecha el 06/11/2026 para la versión de dos periodos del cuerpo (la de J periodos, con el perfil de toda la vida, está
% en anx_ciclo_vital, panel a).
% Salario previsto w_0 = 2 y w_1 = 2,88 (un 44 % mayor mañana); utilidad separable e isoelástica con elasticidad de
% FRISCH 0,5 y beta (1 + r) = 1, con r = 0,2: lambda es la misma en los dos periodos y las horas siguen al salario,
% h_t = sqrt(w_t / w_0): h_0 = 1, h_1 = 1,2. Ingresos y_t = w_t h_t: y_0 = 2, y_1 = 3,456. Consumo constante,
% C = (y_0 + y_1 / 1,2) / (1 + 1 / 1,2) = 2,662: se endeuda hoy 0,662 (gris claro) y devuelve mañana 0,794 = 1,2 x 0,662
% (gris oscuro). Valores ilustrativos; ejes verticales rotulados (petición del usuario, 02/11/2026).
% Escala: x = 2,6 cm por periodo; y = 0,85 cm. Generar con: bash Code/generar_figura.sh b1_plan
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=2.6cm, y=0.85cm]
  % ---------------- (a) Salario y horas ----------------
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (1.1,4.45) {(a) Salario y horas};
    \draw[->] (0,0) -- (2.3,0) node[below] {$t$};
    \draw[->] (0,0) -- (0,3.75) node[above] {$w_t,\ h_t$};
    \draw[very thick] (0,2) -- (1,2) -- (1,2.88) -- (2,2.88) node[right] {$w_t$};
    \draw[very thick, dashed] (0,1) -- (1,1) -- (1,1.2) -- (2,1.2) node[right] {$h_t$};
    \draw[dotted] (1,0) -- (1,2.88);
    \node[below] at (0.5,0) {$0$};
    \node[below] at (1.5,0) {$1$};
  \end{scope}
  % ---------------- (b) Ingresos y consumo ----------------
  \begin{scope}[xshift=8.2cm]
    \node[font=\footnotesize\bfseries] at (1.1,4.45) {(b) Ingresos y consumo};
    \fill[black!8] (0,2) rectangle (1,2.662);
    \fill[black!22] (1,2.662) rectangle (2,3.456);
    \draw[->] (0,0) -- (2.3,0) node[below] {$t$};
    \draw[->] (0,0) -- (0,3.75) node[above] {$w_t\,h_t,\ C_t$};
    \draw[very thick] (0,2) -- (1,2) -- (1,3.456) -- (2,3.456) node[right] {$w_t h_t$};
    \draw[very thick, dashed] (0,2.662) -- (2,2.662) node[right] {$C_t$};
    \draw[dotted] (1,0) -- (1,2);
    \node[below] at (0.5,0) {$0$};
    \node[below] at (1.5,0) {$1$};
  \end{scope}
\end{tikzpicture}
