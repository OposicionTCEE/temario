    \draw[->] (0,0) -- (49,0) node[below] {$t$};
    \draw[->] (0,0) -- (0,3.45) node[above] {$w_t\,h_t,\ C_t$};
    \draw[very thick] plot[smooth] coordinates {(0.00,1.000) (1.50,1.140) (3.00,1.289) (4.50,1.446) (6.00,1.608) (7.50,1.775) (9.00,1.943) (10.50,2.110) (12.00,2.272) (13.50,2.428) (15.00,2.573) (16.50,2.705) (18.00,2.820) (19.50,2.917) (21.00,2.993) (22.50,3.046) (24.00,3.075) (25.50,3.079) (27.00,3.058) (28.50,3.013) (30.00,2.945) (31.50,2.855) (33.00,2.745) (34.50,2.618) (36.00,2.477) (37.50,2.325) (39.00,2.165) (40.50,1.999) (42.00,1.831) (43.50,1.664) (45.00,1.499)} node[below right] {$w_t h_t$};
    \draw[very thick, dashed] (0,2.338) -- (45,2.338) node[right] {$C_t$};
