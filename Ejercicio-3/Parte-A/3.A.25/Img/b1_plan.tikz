% Figura (cuerpo, 1.3.1 «Plan de vida»): el plan de trabajo y de consumo a lo largo de la vida.
% Salario previsto w_t = exp(0,06 t - 0,0012 t^2), t de 0 a J = 45; horas h_t = sqrt(w_t) (siguen al salario, como en
% anx_ciclo_vital); ingresos y_t = w_t h_t; con beta (1 + r) = 1 el consumo es constante e igual a la media de los
% ingresos, C = 2,338. Se ahorra entre t = 12,63 y t = 37,38 (ingresos mayores que el consumo) y se desahorra o se pide
% prestado antes y después. Valores ilustrativos. Ejes verticales rotulados (petición del usuario, 02/11/2026): en (a),
% salario y horas como índices, w_t/w_0 y h_t/h_0, que valen 1 en t = 0; en (b), ingresos y consumo de cada periodo en
% unidades de consumo. La utilidad marginal de la riqueza no se dibuja: con beta (1 + r) = 1 es constante.
% Escala: x = 0,13 cm por periodo; (a) y = 1,6 cm; (b) y = 1,15 cm. Generar con: bash Code/generar_figura.sh b1_plan
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  % ---------------- (a) Salario y horas ----------------
  \begin{scope}[x=0.13cm, y=1.6cm]
    \node[font=\footnotesize\bfseries] at (23,2.98) {(a) Salario y horas};
    \draw[->] (0,0) -- (49,0) node[below] {$t$};
    \draw[->] (0,0) -- (0,2.45) node[above] {$w_t/w_0,\ h_t/h_0$};
    \draw (0,1) -- (-0.8,1) node[left] {$1$};
    \draw[very thick] plot[smooth] coordinates {(0.00,1.000) (3.00,1.184) (6.00,1.373) (9.00,1.557) (12.00,1.728) (15.00,1.878) (18.00,1.996) (21.00,2.077) (24.00,2.114) (27.00,2.107) (30.00,2.054) (33.00,1.961) (36.00,1.831) (39.00,1.673) (42.00,1.497) (45.00,1.310)} node[above right] {$w_t$};
    \draw[very thick, dashed] plot[smooth] coordinates {(0.00,1.000) (3.00,1.088) (6.00,1.172) (9.00,1.248) (12.00,1.315) (15.00,1.370) (18.00,1.413) (21.00,1.441) (24.00,1.454) (27.00,1.452) (30.00,1.433) (33.00,1.400) (36.00,1.353) (39.00,1.294) (42.00,1.223) (45.00,1.145)} node[below right] {$h_t$};
    \node[below] at (0,0) {$0$};
    \node[below] at (45,0) {$J$};
  \end{scope}
  % ---------------- (b) Ingresos y consumo ----------------
  \begin{scope}[xshift=8.2cm, x=0.13cm, y=1.15cm]
    \node[font=\footnotesize\bfseries] at (23,4.15) {(b) Ingresos y consumo};
    \fill[black!22] plot[smooth] coordinates {(12.63,2.338) (13.50,2.428) (15.00,2.573) (16.50,2.705) (18.00,2.820) (19.50,2.917) (21.00,2.993) (22.50,3.046) (24.00,3.075) (25.50,3.079) (27.00,3.058) (28.50,3.013) (30.00,2.945) (31.50,2.855) (33.00,2.745) (34.50,2.618) (36.00,2.477) (37.38,2.338)} -- cycle;
    \fill[black!8] (0,2.338) -- plot[smooth] coordinates {(0.00,1.000) (1.50,1.140) (3.00,1.289) (4.50,1.446) (6.00,1.608) (7.50,1.775) (9.00,1.943) (10.50,2.110) (12.00,2.272) (12.63,2.338)} -- cycle;
