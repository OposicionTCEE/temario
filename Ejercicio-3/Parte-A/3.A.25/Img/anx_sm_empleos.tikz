% Figura (Anexo III, «Salario mínimo»): el método de agrupamiento de CENGIZ, DUBE, LINDNER y ZIPPERER (2019).
% Cambio en el número de empleos por tramo salarial tras subir el salario mínimo de w_ a w_': faltan empleos en los tramos
% entre el mínimo anterior y el nuevo (F = -0,5 - 0,8 - 1,0 - 1,3 = -3,6) y aparecen en el nuevo mínimo y justo por encima
% (E = 1,5 + 1,1 + 0,6 + 0,4 = 3,6); más arriba, el cambio es nulo. Si E compensa F, el empleo de salario bajo no cambia.
% Valores ilustrativos. Escala: x = 0,6 cm por tramo; y = 1,2 cm. Generar con: bash Code/generar_figura.sh anx_sm_empleos
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=0.6cm, y=1.2cm]
  \draw[->] (-5.2,0) -- (7.2,0) node[below] {$w$};
  \draw[->] (-5.2,-1.75) -- (-5.2,2.0) node[left] {$\Delta N$};
  \foreach \k/\v in {-4/-0.5, -3/-0.8, -2/-1.0, -1/-1.3, 0/1.5, 1/1.1, 2/0.6, 3/0.4, 4/0.05, 5/-0.05}
    \draw[fill=gray!35] ({\k-0.4},0) rectangle ({\k+0.4},\v);
  \draw[dashed] (-0.5,-1.7) -- (-0.5,1.85);
  \draw[dotted] (-4.5,-1.7) -- (-4.5,1.85);
  \node[above] at (-0.5,1.85) {$\underline w'$};
  \node[above] at (-4.5,1.85) {$\underline w$};
  \node at (-2.5,-1.55) {$F$};
  \node at (1.5,1.75) {$E$};
\end{tikzpicture}
