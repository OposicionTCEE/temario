% Figura (Anexo I, «Asignación del tiempo»): el modelo de GRONAU (1977) con producción doméstica.
% Espacio (ocio, consumo). Dotación T = 5; renta no laboral R = 0,5; producción doméstica f(H) = 1,6 sqrt(H), con
% f'(H) = 0,8/sqrt(H); bienes domésticos y de mercado sustitutivos perfectos; preferencias COBB-DOUGLAS U = (C ell)^(1/2).
% Desde E = (5; 0,5), la frontera doméstica sube hacia la izquierda: (T - H; R + f(H)).
% (a) w = 1: la frontera doméstica llega hasta P = (4,36; 1,78), donde f'(H) = w (H = 0,64); desde P, recta de mercado de
%     pendiente -1 hasta (0; 6,14); óptimo A = (3,07; 3,07) en C ell = 9,4249. Ocio 3,07; mercado N = 1,29; casa H = 0,64.
% (b) w = 0,3 < f'(T) = 0,358: la recta de mercado nunca compensa; óptimo en la frontera doméstica, B = (3,5815; 2,4056),
%     donde f'(H) = 0,6717 = RMS (C ell = 8,6157); recta discontinua de pendiente -0,3 desde B.
% Escala: x = 0,95 cm; y = 0,8 cm. Generar con: bash Code/generar_figura.sh anx_gronau
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=0.95cm, y=0.8cm]
  % ---------------- (a) Trabajo en casa y en el mercado ----------------
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (2.9,7.5) {(a) Trabajo en casa y en el mercado};
    \draw[->] (0,0) -- (5.9,0) node[below] {$\ell$};
    \draw[->] (0,0) -- (0,7.0) node[left] {$C$};
    \draw[very thick] (5,0) -- (5,0.5);
    \draw[very thick] plot[smooth] coordinates {(5.000,0.500) (4.950,0.858) (4.850,1.120) (4.700,1.376) (4.550,1.573) (4.360,1.780)};
    \draw[very thick] (4.36,1.78) -- (0,6.14);
    \draw[dashed] plot[smooth] coordinates {(4.360,1.780) (4.000,2.100) (3.500,2.460) (3.000,2.763) (2.500,3.030) (2.000,3.271) (1.500,3.493)};
    \draw[thick] plot[domain=1.5:5.6, samples=80] (\x,{9.4249/\x});
    \node[right] at (5.6,{9.4249/5.6}) {$U_A$};
    \fill (5,0.5) circle (1.8pt) node[right] {$E$};
    \fill (4.36,1.78) circle (1.8pt) node[right] {$P$};
    \fill (3.07,3.07) circle (1.8pt) node[above right] {$A$};
    \draw[dotted] (3.07,3.07) -- (3.07,0);
    \draw[dotted] (4.36,1.78) -- (4.36,0);
    \node[below] at (5,0) {$T$};
    \draw[decorate, decoration={brace, amplitude=3pt, mirror}] (0,-0.75) -- (3.07,-0.75) node[midway, below=3pt] {$\ell^*$};
    \draw[decorate, decoration={brace, amplitude=3pt, mirror}] (3.07,-0.75) -- (4.36,-0.75) node[midway, below=3pt] {$N$};
    \draw[decorate, decoration={brace, amplitude=3pt, mirror}] (4.36,-0.75) -- (5,-0.75) node[midway, below=3pt] {$H$};
  \end{scope}
  % ---------------- (b) Solo trabajo en casa ----------------
  \begin{scope}[xshift=7.3cm]
    \node[font=\footnotesize\bfseries] at (2.9,7.5) {(b) Solo trabajo en casa};
    \draw[->] (0,0) -- (5.9,0) node[below] {$\ell$};
    \draw[->] (0,0) -- (0,7.0) node[left] {$C$};
    \draw[very thick] (5,0) -- (5,0.5);
    \draw[very thick] plot[smooth] coordinates {(5.000,0.500) (4.900,1.006) (4.700,1.376) (4.400,1.739) (4.000,2.100) (3.500,2.460) (3.000,2.763) (2.500,3.030) (2.000,3.271) (1.500,3.493) (1.000,3.700) (0.500,3.894) (0.000,4.078)};
    \draw[dashed] (3.5815,2.4056) -- (0.3,3.390);
    \draw[thick] plot[domain=1.4:5.6, samples=80] (\x,{8.6157/\x});
    \node[right] at (5.6,{8.6157/5.6}) {$U_B$};
    \fill (5,0.5) circle (1.8pt) node[right] {$E$};
    \fill (3.5815,2.4056) circle (1.8pt) node[below left] {$B$};
    \draw[dotted] (3.5815,2.4056) -- (3.5815,0);
    \node[below] at (5,0) {$T$};
    \node[above, font=\scriptsize] at (0.9,3.25) {$-w$};
    \draw[decorate, decoration={brace, amplitude=3pt, mirror}] (0,-0.75) -- (3.5815,-0.75) node[midway, below=3pt] {$\ell^*$};
    \draw[decorate, decoration={brace, amplitude=3pt, mirror}] (3.5815,-0.75) -- (5,-0.75) node[midway, below=3pt] {$H$};
  \end{scope}
\end{tikzpicture}
