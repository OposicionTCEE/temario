% Figura (cuerpo, 1.4.1 «Perturbaciones»): la misma perturbación de la demanda con la oferta de FRISCH y con la de MARSHALL.
% Reúne en un panel los dos de anx_perturbaciones. Demanda L^d_0: w = 3 - 0,4 L; L^d_1: w = 3,6 - 0,4 L. Oferta de FRISCH
% (transitoria): w = 0,5 + 0,2 L; oferta de MARSHALL (permanente), de pendiente 3 por A. A = (4,167; 1,333);
% B = (5,167; 1,533) con la de FRISCH; C = (4,343; 1,863) con la de MARSHALL. Rectas ilustrativas.
% Escala: x = 0,95 cm; y = 1,5 cm. Generar con: bash Code/generar_figura.sh b1_perturbaciones
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=0.95cm, y=1.5cm]
  \draw[->] (0,0) -- (7.6,0) node[below] {$L$};
  \draw[->] (0,0) -- (0,3.3) node[left] {$w$};
  \draw[very thick] (0.5,2.8) -- (6.5,0.4) node[right] {$L^d_0$};
  \draw[very thick] (1.5,3.0) -- (7.0,0.8) node[right] {$L^d_1$};
  \draw[very thick, dashed] (0.4,0.58) -- (6.8,1.86) node[right] {$L^s_F$};
  \draw[very thick, dash dot] (3.75,0.083) -- (4.75,3.083) node[above] {$L^s_M$};
  \fill (4.167,1.333) circle (1.8pt) node[below right] {$A$};
  \fill (5.167,1.533) circle (1.8pt) node[above] {$B$};
  \fill (4.343,1.863) circle (1.8pt) node[left] {$C$};
\end{tikzpicture}
