% Figura (cuerpo, 2.4 «Función de ingresos»): si el rendimiento difiere entre personas, el coeficiente es un promedio que
% no es el de nadie. Pedida por el usuario el 02/11/2026 («¿Ilustrar lo que sucedería sin estos supuestos?»).
% Dos personas con rendimientos distintos: ln w_1 = 0,4 + 0,22 S (rendimiento alto, peor financiación: estudia poco,
% A = (3; 1,06)) y ln w_2 = 1,01 + 0,10 S (rendimiento bajo: estudia más, B = (8; 1,81)). La recta que une A y B tiene
% pendiente 0,15, entre los dos rendimientos.
% Escala: x = 0,55 cm por año, y = 1,6 cm. Generar con: bash Code/generar_figura.sh b2_supuesto_rendimiento
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=0.55cm, y=1.6cm]
  \draw[->] (0,0) -- (11,0) node[below] {$S$};
  \draw[->] (0,0) -- (0,3.1) node[left] {$\ln w$};
  \draw[very thick] (0,0.4) -- (10,2.6) node[right] {$a_1+r_1S$};
  \draw[very thick] (0,1.01) -- (10,2.01) node[right] {$a_2+r_2S$};
  \draw[thick, dashed] (1,0.76) -- (10,2.11);
  \node[above] at (1.2,0.80) {$\hat\rho$};
  \fill (3,1.06) circle (1.8pt) node[below right] {$A$};
  \fill (8,1.81) circle (1.8pt) node[below right] {$B$};
  \draw[dotted] (3,1.06) -- (3,0);
  \draw[dotted] (8,1.81) -- (8,0);
  \node[below] at (3,0) {$S_1$};
  \node[below] at (8,0) {$S_2$};
\end{tikzpicture}
