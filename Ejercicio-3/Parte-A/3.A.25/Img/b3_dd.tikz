% Figura (cuerpo, 3.1 «Metodología», experimentos naturales): las diferencias en diferencias. Adaptada del panel (a) de
% anx_cuasiexperimentos (y de la que era el panel (b) de b3_credito en la primera pasada).
% Grupo de control C de 1,0 (t_0) a 1,6 (t_1); grupo tratado T de 1,8 a 3,2; contrafactual de T paralelo al de C (de punto,
% de 1,8 a 2,4): tendencias comunes; efecto beta_DD = 3,2 - 2,4 = 0,8. Valores ilustrativos.
% Escala: x = 1,8 cm; y = 0,75 cm. Generar con: bash Code/generar_figura.sh b3_dd
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1.8cm, y=0.75cm]
  \draw[->] (0,0) -- (2.85,0) node[below] {$t$};
  \draw[->] (0,0) -- (0,3.75) node[left] {$y$};
  \draw[very thick] (1,1.8) -- (2,3.2) node[above] {$T$};
  \draw[very thick, dashed] (1,1.0) -- (2,1.6) node[right] {$C$};
  \draw[thick, dotted] (1,1.8) -- (2,2.4);
  \foreach \p in {(1,1.8), (2,3.2), (1,1.0), (2,1.6)} \fill \p circle (1.6pt);
  \draw[<->, thin] (2.12,2.42) -- (2.12,3.18);
  \node[right] at (2.12,2.8) {$\beta_{DD}$};
  \draw[dotted] (1,1.0) -- (1,0);
  \draw[dotted] (2,1.6) -- (2,0);
  \node[below] at (1,0) {$t_0$};
  \node[below] at (2,0) {$t_1$};
\end{tikzpicture}
