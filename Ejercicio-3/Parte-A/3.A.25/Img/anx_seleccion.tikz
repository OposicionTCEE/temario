% Figura (Anexo III, «Selección»): el sesgo de selección cuando el salario solo se observa para quienes trabajan
% (HECKMAN 1974, 1979). Datos simulados: oferta salarial w = 1 + 0,25 x + u, u ~ N(0; 0,55), 40 personas con x entre
% 0,3 y 7,7 (semilla 7); se trabaja si w > w_R = 2,2 (14 personas, puntos llenos; las demás, huecos). La recta es la
% verdadera relación, E[w | x] = 1 + 0,25 x; la curva discontinua, la media de quienes trabajan,
% E[w | x, w > w_R] = mu + 0,55 lambda((mu - 2,2)/0,55), con lambda = phi/Phi (inversa del cociente de MILLS).
% MCO con todos: pendiente 0,253; con quienes trabajan: 0,095.
% Escala: x = 0,85 cm; y = 1 cm. Generar con: bash Code/generar_figura.sh anx_seleccion
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=0.85cm, y=1cm]
  \draw[->] (0,0) -- (8.7,0) node[below] {$x$};
  \draw[->] (0,0) -- (0,4.0) node[left] {$w$};
  \draw[thick, dotted] (0,2.2) -- (8.3,2.2);
  \node[left] at (0,2.2) {$w_R$};
  % quienes no trabajan (salario no observado)
  \foreach \p in {(0.30,0.93), (0.49,1.40), (0.68,1.05), (0.87,1.04), (1.06,0.75), (1.25,1.19), (1.44,1.97), (1.63,1.64), (1.82,2.02), (2.01,1.64), (2.20,1.77), (2.39,1.70), (2.58,0.73), (2.77,2.16), (2.96,2.02), (3.15,2.06), (3.34,0.90), (3.53,0.92), (3.72,1.44), (3.91,1.72), (4.09,2.19), (4.28,2.05), (4.66,1.81), (5.23,1.94), (5.99,2.16), (6.18,2.14)}
    \draw \p circle (1.4pt);
  % quienes trabajan (salario observado)
  \foreach \p in {(4.47,2.41), (4.85,2.38), (5.04,2.48), (5.42,3.30), (5.61,2.71), (5.80,3.11), (6.37,2.40), (6.56,2.58), (6.75,3.04), (6.94,2.87), (7.13,2.54), (7.32,2.30), (7.51,2.59), (7.70,3.60)}
    \fill \p circle (1.4pt);
  \draw[very thick] (0,1) -- (8.2,3.05) node[below right] {$E[w\mid x]$};
  \draw[very thick, dashed] plot[smooth] coordinates {(0.00,2.394) (0.50,2.408) (1.00,2.424) (1.50,2.441) (2.00,2.461) (2.50,2.484) (3.00,2.510) (3.50,2.540) (4.00,2.574) (4.50,2.613) (5.00,2.658) (5.50,2.709) (6.00,2.767) (6.50,2.834) (7.00,2.908) (7.50,2.991) (8.00,3.082)} node[above right] {$E[w\mid x,\ w>w_R]$};
\end{tikzpicture}
