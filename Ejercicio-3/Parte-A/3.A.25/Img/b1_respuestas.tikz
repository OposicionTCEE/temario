% Figura (cuerpo, 1.3.2 «Elasticidades»): un cambio transitorio y uno permanente del salario, no previstos, en t0 = 4.
% Unidades ilustrativas: salario de partida 2, horas de partida 1. (a) Transitorio: el salario sube a 2,6 solo en el periodo
% [4, 5] y las horas suben a 1,5 en ese periodo (respuesta cercana a la de FRISCH). (b) Permanente: el salario sube a 2,6
% desde t0 y las horas apenas cambian (1,05), porque el efecto riqueza compensa la sustitución (respuesta marshalliana).
% Escala: x = 0,55 cm por periodo; y = 1,2 cm. Generar con: bash Code/generar_figura.sh b1_respuestas
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=0.55cm, y=1.2cm]
  % ---------------- (a) Cambio transitorio ----------------
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (5.2,3.35) {(a) Cambio transitorio};
    \draw[->] (0,0) -- (10.8,0) node[below] {$t$};
    \draw[->] (0,0) -- (0,3.0);
    \draw[very thick] (0,2) -- (4,2) -- (4,2.6) -- (5,2.6) -- (5,2) -- (10,2) node[right] {$w_t$};
    \draw[very thick, dashed] (0,1) -- (4,1) -- (4,1.5) -- (5,1.5) -- (5,1) -- (10,1) node[right] {$h_t$};
    \draw[dotted] (4,0) -- (4,2.6);
    \node[below] at (4,0) {$t_0$};
  \end{scope}
  % ---------------- (b) Cambio permanente ----------------
  \begin{scope}[xshift=8.0cm]
    \node[font=\footnotesize\bfseries] at (5.2,3.35) {(b) Cambio permanente};
    \draw[->] (0,0) -- (10.8,0) node[below] {$t$};
    \draw[->] (0,0) -- (0,3.0);
    \draw[very thick] (0,2) -- (4,2) -- (4,2.6) -- (10,2.6) node[right] {$w_t$};
    \draw[very thick, dashed] (0,1) -- (4,1) -- (4,1.05) -- (10,1.05) node[right] {$h_t$};
    \draw[dotted] (4,0) -- (4,2.6);
    \node[below] at (4,0) {$t_0$};
  \end{scope}
\end{tikzpicture}
