% Figura (Anexo I, «Salario»): efectos sustitución y renta de una subida del salario de w0 = 0,6 a w1 = 1, con T = 5 y
% R = 1 (E = (5; 1)); rectas de (5; 1) a (0; 4) y de (5; 1) a (0; 6). Las dos rectas son iguales en los dos paneles; cambian
% las preferencias.
% (a) COBB-DOUGLAS U = (C ell)^(1/2): A = (3,333; 2) en C ell = 6,667; B = (2,582; 2,582), tangencia de la recta compensada
%     C = 5,164 - ell con la curva inicial; D = (3; 3) en C ell = 9. Horas: 1,667 -> 2 (domina la sustitución).
% (b) CES con elasticidad de sustitución 1/3, U = (0,5 C^-2 + 0,5 ell^-2)^(-1/2), cuyas curvas son C = 1/sqrt(2/U^2 - 1/ell^2):
%     A = (2,771; 2,337), U0 = 2,5267; B = (2,527; 2,527), recta compensada C = 5,054 - ell; D = (3; 3), U1 = 3.
%     Horas: 2,229 -> 2 (domina la renta).
% Escala: 1 unidad = 0,85 cm. Generar con: bash Code/generar_figura.sh anx_efectos
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=0.85cm, y=0.85cm]
  % ---------------- (a) Domina el efecto sustitución ----------------
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (2.9,6.8) {(a) Domina el efecto sustitución};
    \draw[->] (0,0) -- (5.9,0) node[below] {$\ell$};
    \draw[->] (0,0) -- (0,6.5) node[left] {$C$};
    \draw[very thick] (0,4) -- (5,1) -- (5,0);
    \draw[very thick] (0,6) -- (5,1);
    \draw[dashed] (0.3,4.864) -- (4.4,0.764);
    \draw[thick] plot[domain=1.1:5.6, samples=80] (\x,{6.6667/\x});
    \draw[thick] plot[domain=1.45:5.6, samples=80] (\x,{9/\x});
    \node[right] at (5.6,{6.6667/5.6}) {$U_0$};
    \node[right] at (5.6,{9/5.6}) {$U_1$};
    \fill (5,1) circle (1.8pt) node[right] {$E$};
    \fill (3.333,2) circle (1.8pt) node[below right] {$A$};
    \fill (2.582,2.582) circle (1.8pt) node[below left] {$B$};
    \fill (3,3) circle (1.8pt) node[above right] {$D$};
    \draw[dotted] (3.333,2) -- (3.333,0);
    \draw[dotted] (2.582,2.582) -- (2.582,0);
    \draw[dotted] (3,3) -- (3,0);
    \node[below] at (5,0) {$T$};
    \draw[->] (3.333,-0.45) -- (2.582,-0.45) node[midway, below] {$ES$};
    \draw[->] (2.582,-1.05) -- (3,-1.05) node[midway, below] {$ER$};
  \end{scope}
  % ---------------- (b) Domina el efecto renta ----------------
  \begin{scope}[xshift=7.3cm]
    \node[font=\footnotesize\bfseries] at (2.9,6.8) {(b) Domina el efecto renta};
    \draw[->] (0,0) -- (5.9,0) node[below] {$\ell$};
    \draw[->] (0,0) -- (0,6.5) node[left] {$C$};
    \draw[very thick] (0,4) -- (5,1) -- (5,0);
    \draw[very thick] (0,6) -- (5,1);
    \draw[dashed] (0.3,4.754) -- (4.4,0.654);
    \draw[thick] plot[domain=1.9:5.6, samples=100] (\x,{1/sqrt(0.31327-1/(\x*\x))});
    \draw[thick] plot[domain=2.32:5.6, samples=100] (\x,{1/sqrt(0.22222-1/(\x*\x))});
    \node[right] at (5.6,{1/sqrt(0.31327-1/(5.6*5.6))}) {$U_0$};
    \node[right] at (5.6,{1/sqrt(0.22222-1/(5.6*5.6))}) {$U_1$};
    \fill (5,1) circle (1.8pt) node[right] {$E$};
    \fill (2.771,2.337) circle (1.8pt) node[below right] {$A$};
    \fill (2.527,2.527) circle (1.8pt) node[above left] {$B$};
    \fill (3,3) circle (1.8pt) node[above right] {$D$};
    \draw[dotted] (2.771,2.337) -- (2.771,0);
    \draw[dotted] (2.527,2.527) -- (2.527,0);
    \draw[dotted] (3,3) -- (3,0);
    \node[below] at (5,0) {$T$};
    \draw[->] (2.771,-0.45) -- (2.527,-0.45) node[midway, below] {$ES$};
    \draw[->] (2.527,-1.05) -- (3,-1.05) node[midway, below] {$ER$};
  \end{scope}
\end{tikzpicture}
