% Figura (Anexo I, «Jubilación»): el modelo del valor de opción de STOCK y WISE (1990).
% Valor esperado, visto desde la edad actual, de jubilarse a cada edad futura s (curvas ilustrativas).
% (a) A la edad t: V_t(s) = 10 + 0,8 (s - t) - 0,08 (s - t)^2, máximo en s* = t + 5; el valor de opción, V_t(s*) - V_t(t) = 2,
%     es positivo: conviene seguir trabajando.
% (b) A una edad posterior t': V_t'(s) = 10 - 0,15 (s - t') - 0,01 (s - t')^2, decreciente: el máximo está en s = t' y el
%     valor de opción es nulo: conviene jubilarse.
% Ejes: edad s, 1 unidad = 0,38 cm (de t a t + 12); valor, 1 unidad = 0,9 cm (eje desde 6).
% Generar con: bash Code/generar_figura.sh anx_jubilacion
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  % ---------------- (a) Conviene seguir trabajando ----------------
  \begin{scope}[x=0.38cm, y=0.9cm]
    \node[font=\footnotesize\bfseries] at (6.5,13.3) {(a) Conviene seguir trabajando};
    \draw[->] (0,6) -- (13.5,6) node[below] {$s$};
    \draw[->] (0,6) -- (0,12.8) node[left] {$V$};
    \draw[very thick] plot[domain=0:12, samples=60] (\x,{10+0.8*\x-0.08*\x*\x});
    \fill (0,10) circle (1.8pt);
    \fill (5,12) circle (1.8pt);
    \draw[dotted] (0,12) -- (5,12);
    \draw[dotted] (5,12) -- (5,6);
    \node[below] at (0,6) {$t$};
    \node[below] at (5,6) {$s^*$};
    \draw[decorate, decoration={brace, amplitude=3pt}] (-0.35,10) -- (-0.35,12) node[midway, left=3pt] {$OV_t>0$};
    \node[right] at (12,8.08) {$V_t(s)$};
  \end{scope}
  % ---------------- (b) Conviene jubilarse ----------------
  \begin{scope}[xshift=7.4cm, x=0.38cm, y=0.9cm]
    \node[font=\footnotesize\bfseries] at (6.5,13.3) {(b) Conviene jubilarse};
    \draw[->] (0,6) -- (13.5,6) node[below] {$s$};
    \draw[->] (0,6) -- (0,12.8) node[left] {$V$};
    \draw[very thick] plot[domain=0:12, samples=60] (\x,{10-0.15*\x-0.01*\x*\x});
    \fill (0,10) circle (1.8pt);
    \node[below] at (0,6) {$t'$};
    \node[above right] at (0,10) {$OV_{t'}=0$};
    \node[right] at (12,6.76) {$V_{t'}(s)$};
  \end{scope}
\end{tikzpicture}
