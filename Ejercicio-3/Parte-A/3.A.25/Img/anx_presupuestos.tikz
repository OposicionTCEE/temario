% Figura (Anexo I, «Restricciones no lineales»): cuatro restricciones presupuestarias no lineales en el espacio (ocio, consumo).
% Común: T = 5, R = 1, salario bruto w = 0,8 (recta sin intervención de (5; 1) a (0; 5)); preferencias COBB-DOUGLAS
% U = (C ell)^(1/2), que en el mercado sin intervención eligen A = (3,125; 2,5).
% (a) Impuesto progresivo: tipo 0 hasta h_K = 2 horas (K = (3; 2,6)) y 0,5 a partir de ahí; frontera E-K-(0; 3,8);
%     renta virtual R_v = 1,8 (prolongación del segundo tramo hasta ell = T).
% (b) Renta mínima G = 1,2 que se retira euro a euro: tramo plano C = 2,2 de ell = 5 a ell = 3,5 y después la recta
%     original; la curva por E' = (5; 2,2), C ell = 11, queda por encima de la frontera: la persona elige E' y no trabaja.
% (c) Costes fijos F = 0,8: E = (5; 1) si no trabaja; si trabaja, recta de (5; 0,2) (excluido) a (0; 4,2); la curva por E,
%     C ell = 5, corta esa recta en ell = 3,425 (h_R = 1,575 horas mínimas) y ell = 1,825; óptimo trabajando (2,625; 2,1).
% (d) Jornada fija h = 3: solo E y P = (2; 3,4); curvas por E (C ell = 5) y por P (C ell = 6,8); A, el óptimo libre.
% Escala: 1 unidad = 0,72 cm. Generar con: bash Code/generar_figura.sh anx_presupuestos
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=0.72cm, y=0.72cm]
  % ---------------- (a) Impuesto progresivo ----------------
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (2.8,6.0) {(a) Impuesto progresivo};
    \draw[->] (0,0) -- (5.9,0) node[below] {$\ell$};
    \draw[->] (0,0) -- (0,5.6) node[left] {$C$};
    \draw[dashed, black!60] (3,2.6) -- (0,5);
    \draw[very thick] (5,0) -- (5,1) -- (3,2.6) -- (0,3.8);
    \draw[dotted, thick] (3,2.6) -- (5,1.8);
    \fill (5,1) circle (1.8pt) node[right] {$E$};
    \fill (3,2.6) circle (1.8pt) node[above right] {$K$};
    \fill (5,1.8) circle (1.5pt) node[right] {$R_v$};
    \node[below] at (5,0) {$T$};
  \end{scope}
  % ---------------- (b) Renta mínima que se retira ----------------
  \begin{scope}[xshift=6.4cm]
    \node[font=\footnotesize\bfseries] at (2.8,6.0) {(b) Renta mínima que se retira};
    \draw[->] (0,0) -- (5.9,0) node[below] {$\ell$};
    \draw[->] (0,0) -- (0,5.6) node[left] {$C$};
    \draw[dashed, black!60] (5,1) -- (3.5,2.2);
    \draw[very thick] (5,0) -- (5,2.2) -- (3.5,2.2) -- (0,5);
    \draw[thick] plot[domain=2.2:5.6, samples=80] (\x,{11/\x});
    \draw (5,1) circle (1.8pt) node[right] {$E$};
    \fill (5,2.2) circle (1.8pt) node[below left] {$E'$};
    \node[below] at (5,0) {$T$};
    \node[right] at (5.6,{11/5.6}) {$U_{E'}$};
  \end{scope}
  % ---------------- (c) Costes fijos de trabajar ----------------
  \begin{scope}[yshift=-5.4cm]
    \node[font=\footnotesize\bfseries] at (2.8,6.0) {(c) Costes fijos de trabajar};
    \draw[->] (0,0) -- (5.9,0) node[below] {$\ell$};
    \draw[->] (0,0) -- (0,5.6) node[left] {$C$};
    \draw[dashed, black!60] (5,1) -- (0,5);
    \draw[very thick] (5,0.2) -- (0,4.2);
    \draw[thick] plot[domain=1.0:5.6, samples=80] (\x,{5/\x});
    \fill (5,1) circle (1.8pt) node[below left] {$E$};
    \draw[fill=white] (5,0.2) circle (1.8pt);
    \fill (2.625,2.1) circle (1.8pt) node[above right] {$A$};
    \draw[dotted] (3.425,1.46) -- (3.425,0);
    \draw[decorate, decoration={brace, amplitude=3pt, mirror}] (3.425,-0.5) -- (5,-0.5) node[midway, below=3pt] {$h_R$};
    \node[right] at (5.6,{5/5.6}) {$U_E$};
  \end{scope}
  % ---------------- (d) Jornada fija ----------------
  \begin{scope}[xshift=6.4cm, yshift=-5.4cm]
    \node[font=\footnotesize\bfseries] at (2.8,6.0) {(d) Jornada fija};
    \draw[->] (0,0) -- (5.9,0) node[below] {$\ell$};
    \draw[->] (0,0) -- (0,5.6) node[left] {$C$};
    \draw[dashed, black!60] (5,1) -- (0,5);
    \draw[thick] plot[domain=1.0:5.6, samples=80] (\x,{5/\x});
    \draw[thick] plot[domain=1.3:5.6, samples=80] (\x,{6.8/\x});
    \fill (5,1) circle (1.8pt) node[right] {$E$};
    \fill (2,3.4) circle (1.8pt) node[above right] {$P$};
    \draw[fill=white] (3.125,2.5) circle (1.8pt) node[above right] {$A$};
    \draw[decorate, decoration={brace, amplitude=3pt, mirror}] (2,-0.5) -- (5,-0.5) node[midway, below=3pt] {$\bar h$};
    \node[right] at (5.6,{5/5.6}) {$U_E$};
    \node[right] at (5.6,{6.8/5.6}) {$U_P$};
  \end{scope}
\end{tikzpicture}
