% Figura (Anexo II, «Experiencia»): perfiles de ingresos de la función de MINCER (1974) por experiencia y por edad.
% Coeficientes de MINCER (1974, cuadro 5.1, P(1)): ln w = 6,20 + 0,107 S + 0,081 X - 0,0012 X^2; S_1 = 12, S_2 = 16.
% Eje vertical desplazado 7,2. (a) Experiencia X de 0 a 45: perfiles paralelos; máximo en X* = 0,081/0,0024 = 33,75;
% líneas de puntos: capacidad de ingresos al terminar los estudios, ln w(S), situada para que el punto de alcance sea
% X^ = 8 (ln w(S) = intercepto + 0,081*8 - 0,0012*64 = intercepto + 0,571). (b) Edad t = S + 6 + X hasta 65 años:
% la diferencia entre los perfiles crece con la edad, 0,104 + 0,0096 (t - 20).
% Escala: x = 0,13 cm por año; y = 1,55 cm. Generar con: bash Code/generar_figura.sh anx_mincer
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  % ---------------- (a) Experiencia ----------------
  \begin{scope}[x=0.13cm, y=1.55cm]
    \node[font=\footnotesize\bfseries] at (24,2.62) {(a) Experiencia};
    \draw[->] (0,0) -- (49,0) node[below] {$X$};
    \draw[->] (0,0) -- (0,2.4) node[left] {$\ln w$};
    \draw[thick, dotted] (0,0.855) -- (45,0.855) node[right] {$\ln w(S_1)$};
    \draw[thick, dotted] (0,1.283) -- (45,1.283) node[right] {$\ln w(S_2)$};
    \draw[very thick] plot[smooth] coordinates {(0.000,0.284) (3.000,0.516) (6.000,0.727) (9.000,0.916) (12.000,1.083) (15.000,1.229) (18.000,1.353) (21.000,1.456) (24.000,1.537) (27.000,1.596) (30.000,1.634) (33.000,1.650) (36.000,1.645) (39.000,1.618) (42.000,1.569) (45.000,1.499)};
    \draw[very thick] plot[smooth] coordinates {(0.000,0.712) (3.000,0.944) (6.000,1.155) (9.000,1.344) (12.000,1.511) (15.000,1.657) (18.000,1.781) (21.000,1.884) (24.000,1.965) (27.000,2.024) (30.000,2.062) (33.000,2.078) (36.000,2.073) (39.000,2.046) (42.000,1.997) (45.000,1.927)};
    \node[above] at (40,1.60) {$S_1$};
    \node[above] at (40,2.03) {$S_2$};
    \fill (8,0.855) circle (1.6pt);
    \fill (8,1.283) circle (1.6pt);
    \draw[dotted] (8,0.855) -- (8,0);
    \node[below] at (8,0) {$\hat X$};
    \draw[dotted] (33.75,2.079) -- (33.75,0);
    \node[below] at (33.75,0) {$X^*$};
  \end{scope}
  % ---------------- (b) Edad ----------------
  \begin{scope}[xshift=8.4cm, x=0.13cm, y=1.55cm]
    \node[font=\footnotesize\bfseries] at (26,2.62) {(b) Edad};
    \draw[->] (0,0) -- (54,0) node[below] {$t$};
    \draw[->] (0,0) -- (0,2.4) node[left] {$\ln w$};
    % la coordenada x es la edad menos 14
    \draw[very thick] plot[smooth] coordinates {(4.000,0.284) (7.917,0.583) (11.833,0.845) (15.750,1.070) (19.667,1.258) (23.583,1.410) (27.500,1.525) (31.417,1.603) (35.333,1.644) (39.250,1.648) (43.167,1.616) (47.083,1.546) (51.000,1.440)} node[right] {$S_1$};
    \draw[very thick] plot[smooth] coordinates {(8.000,0.712) (11.583,0.987) (15.167,1.231) (18.750,1.444) (22.333,1.626) (25.917,1.778) (29.500,1.899) (33.083,1.989) (36.667,2.048) (40.250,2.076) (43.833,2.074) (47.417,2.040) (51.000,1.976)} node[right] {$S_2$};
    \fill (4,0.284) circle (1.6pt);
    \fill (8,0.712) circle (1.6pt);
  \end{scope}
\end{tikzpicture}
