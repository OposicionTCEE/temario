% Figura (cuerpo, 1.2.2 «Salario»): una subida del salario sobre la elección de quien trabaja (b1_eleccion), con su
% descomposición en efecto sustitución y efecto renta. Rehecha el 04/11/2026 a petición del usuario: parte de la figura
% anterior, con las mismas preferencias, la misma dotación y el mismo punto A.
% COBB-DOUGLAS U = (C ell)^(1/2); T = 5; R = 1,5; E = (5; 1,5). Con w_0 = 0,8: A = (3,4375; 2,75) en C ell = 9,4531.
% Con w_1 = 1,2: D = (3,125; 3,75) en C ell = 11,7188. Recta compensada de pendiente -w_1 tangente a U_A en
% B = (2,8067; 3,3680) (discontinua). Efecto sustitución: de A a B (menos ocio); efecto renta: de B a D (más ocio);
% domina el primero: las horas pasan de 1,5625 a 1,875.
% Escala: 1 unidad = 0,95 cm. Generar con: bash Code/generar_figura.sh b1_oferta
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=0.95cm, y=0.95cm]
  \draw[->] (0,0) -- (5.9,0) node[below] {$\ell$};
  \draw[->] (0,0) -- (0,6.4) node[left] {$C$};
  \draw[very thick] (0.5,5.1) -- (5,1.5) -- (5,0);
  \draw[very thick] (1.3,5.94) -- (5,1.5);
  \draw[dashed] (0.9,5.656) -- (4.6,1.216);
  \draw[thick] plot[domain=2.15:5.6, samples=80] (\x,{9.4531/\x});
  \draw[thick] plot[domain=2.0:5.6, samples=80] (\x,{11.7188/\x});
  \node[right] at (5.6,{9.4531/5.6-0.05}) {$U_A$};
  \node[right] at (5.6,{11.7188/5.6+0.1}) {$U_D$};
  \fill (5,1.5) circle (2pt) node[right] {$E$};
  \fill (3.4375,2.75) circle (1.8pt) node[below left] {$A$};
  \fill (2.8067,3.368) circle (1.8pt) node[below left] {$B$};
  \fill (3.125,3.75) circle (1.8pt) node[above right] {$D$};
  \draw[dotted] (3.4375,2.75) -- (3.4375,0);
  \draw[dotted] (2.8067,3.368) -- (2.8067,0);
  \draw[dotted] (3.125,3.75) -- (3.125,0);
  \node[below] at (5,0) {$T$};
  \node[below left, font=\scriptsize] at (1.3,4.46) {$-w_0$};
  \node[above, font=\scriptsize] at (1.3,5.94) {$-w_1$};
  \draw[->] (3.4375,-0.45) -- (2.8067,-0.45) node[midway, below] {$ES$};
  \draw[->] (2.8067,-1.05) -- (3.125,-1.05) node[midway, below] {$ER$};
\end{tikzpicture}
