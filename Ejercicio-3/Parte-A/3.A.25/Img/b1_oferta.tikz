% Figura (cuerpo, 1.2.2 «Salario»): de la elección a la oferta individual. Combina el panel (a) de anx_efectos y el
% panel (b) de anx_oferta_individual: el apartado explica la descomposición de una subida del salario y la forma de la
% curva que resulta.
% (a) COBB-DOUGLAS U = (C ell)^(1/2), T = 5, R = 1 (E = (5; 1)); el salario sube de 0,6 a 1: A = (3,333; 2) en
%     C ell = 6,667; B = (2,582; 2,582), tangencia de la recta compensada C = 5,164 - ell; D = (3; 3) en C ell = 9.
% (b) Oferta individual con preferencias CES de elasticidad de sustitución 1/2, U = 2/(1/C + 1/ell), T = 5, R = 2:
%     nula hasta w_R = 0,16, máxima en w = 1,32 (h = 1,517) y decreciente después.
% Escala: (a) 1 unidad = 0,85 cm; (b) h, 1 unidad = 3 cm, y w, 1 unidad = 0,8 cm. Generar con: bash Code/generar_figura.sh b1_oferta
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  % ---------------- (a) Subida del salario ----------------
  \begin{scope}[x=0.85cm, y=0.85cm]
    \node[font=\footnotesize\bfseries] at (2.9,6.8) {(a) Subida del salario};
    \draw[->] (0,0) -- (5.9,0) node[below] {$\ell$};
    \draw[->] (0,0) -- (0,6.5) node[left] {$C$};
    \draw[very thick] (0,4) -- (5,1) -- (5,0);
    \draw[very thick] (0,6) -- (5,1);
    \draw[dashed] (0.3,4.864) -- (4.4,0.764);
    \draw[thick] plot[domain=1.1:5.6, samples=80] (\x,{6.6667/\x});
    \draw[thick] plot[domain=1.45:5.6, samples=80] (\x,{9/\x});
    \node[right] at (5.6,{6.6667/5.6}) {$U_0$};
    \node[right] at (5.6,{9/5.6}) {$U_1$};
    \fill (5,1) circle (1.8pt) node[right] {$E$};
    \fill (3.333,2) circle (1.8pt);
    \draw[thin] (3.333,2) -- (3.85,1.62) node[right, inner sep=1pt] {$A$};
    \fill (2.582,2.582) circle (1.8pt) node[below left] {$B$};
    \fill (3,3) circle (1.8pt) node[above right] {$D$};
    \draw[dotted] (3.333,2) -- (3.333,0);
    \draw[dotted] (2.582,2.582) -- (2.582,0);
    \draw[dotted] (3,3) -- (3,0);
    \node[below] at (5,0) {$T$};
    \draw[->] (3.333,-0.45) -- (2.582,-0.45) node[midway, below] {$ES$};
    \draw[->] (2.582,-1.05) -- (3,-1.05) node[midway, below] {$ER$};
  \end{scope}
  % ---------------- (b) Oferta individual ----------------
  \begin{scope}[xshift=7.3cm, x=3cm, y=0.8cm]
    \node[font=\footnotesize\bfseries] at (0.95,7.225) {(b) Oferta individual};
    \draw[->] (0,0) -- (1.85,0) node[below] {$h$};
    \draw[->] (0,0) -- (0,6.2) node[left] {$w$};
    \draw[very thick] (0,0) -- (0,0.16);
    \draw[very thick] plot[smooth] coordinates {(0.000,0.160) (0.365,0.200) (0.667,0.250) (0.912,0.312) (1.108,0.391) (1.258,0.488) (1.370,0.610) (1.447,0.763) (1.494,0.954) (1.515,1.192) (1.514,1.490) (1.495,1.863) (1.461,2.328) (1.415,2.910) (1.359,3.638) (1.297,4.547) (1.230,5.684)};
    \fill (0,0.16) circle (1.8pt);
    \node[left] at (0,0.16) {$w_R$};
    \node[above] at (1.23,5.684) {$h(w)$};
  \end{scope}
\end{tikzpicture}
