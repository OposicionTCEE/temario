% Figura (cuerpo, 1.2.3 «Agregación»): los salarios de reserva y la participación. Al subir el salario de w0 a w1 entran
% a trabajar las personas con el salario de reserva entre ambos (área sombreada, Delta N). La oferta agregada que
% resulta va aparte, en b1_agregada, porque el texto la comenta en otro párrafo.
% Densidad logística f(w_R) = F(1 - F)/0,2, F = 1/(1 + exp(-(w_R - 1)/0,2)); w0 = 0,9, w1 = 1,1. Valores ilustrativos.
% Escala: x = 3,2 cm, y = 3 cm. Generar con: bash Code/generar_figura.sh b1_participacion
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=3.2cm, y=3cm]
  \fill[black!15] plot[domain=0.9:1.1, samples=20] (\x,{exp(-(\x-1)/0.2)/(0.2*(1+exp(-(\x-1)/0.2))^2)}) -- (1.1,0) -- (0.9,0) -- cycle;
  \draw[->] (0,0) -- (2.05,0) node[below] {$w_R$};
  \draw[->] (0,0) -- (0,1.45) node[left] {$f(w_R)$};
  \draw[very thick] plot[domain=0.15:1.9, samples=80] (\x,{exp(-(\x-1)/0.2)/(0.2*(1+exp(-(\x-1)/0.2))^2)});
  \draw[dotted] (0.9,0) -- (0.9,1.3);
  \draw[dotted] (1.1,0) -- (1.1,1.3);
  \node[below] at (0.9,0) {$w_0$};
  \node[below] at (1.1,0) {$w_1$};
  \node at (1.0,0.5) {$\Delta N$};
\end{tikzpicture}
