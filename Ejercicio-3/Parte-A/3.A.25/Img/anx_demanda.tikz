% Figura (Anexo I, «Demanda»): la demanda de trabajo de una empresa competitiva.
% (a) Corto plazo: valor del producto marginal con el capital fijo, w = 2,5 L^(-1/2) (rendimientos decrecientes);
%     con el salario w0 = 1,5 la empresa contrata L0 = 2,78 (punto A).
% (b) Corto y largo plazo: por A pasan la demanda a corto plazo anterior y una demanda a largo plazo más elástica,
%     L = 2,78 (w/1,5)^(-3); si el salario baja a w1 = 1,2, el empleo pasa a B = (4,34; 1,2) a corto plazo y a
%     C = (5,43; 1,2) a largo plazo, cuando el capital se ajusta (curvas ilustrativas).
% Escala: x = 0,85 cm, y = 1,35 cm. Generar con: bash Code/generar_figura.sh anx_demanda
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=0.85cm, y=1.35cm]
  % ---------------- (a) Corto plazo ----------------
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (3.3,4.35) {(a) Corto plazo};
    \draw[->] (0,0) -- (6.8,0) node[below] {$L$};
    \draw[->] (0,0) -- (0,4.0) node[left] {$w$};
    \draw[very thick] plot[domain=0.42:6.4, samples=80] (\x,{2.5/sqrt(\x)});
    \node[right] at (6.4,{2.5/sqrt(6.4)}) {$F_L(\bar K,L)$};
    \draw[dashed] (0,1.5) -- (2.78,1.5);
    \draw[dotted] (2.78,1.5) -- (2.78,0);
    \fill (2.78,1.5) circle (1.8pt) node[above right] {$A$};
    \node[left] at (0,1.5) {$w_0$};
    \node[below] at (2.78,0) {$L_0$};
  \end{scope}
  % ---------------- (b) Corto y largo plazo ----------------
  \begin{scope}[xshift=7.6cm]
    \node[font=\footnotesize\bfseries] at (3.3,4.35) {(b) Corto y largo plazo};
    \draw[->] (0,0) -- (6.8,0) node[below] {$L$};
    \draw[->] (0,0) -- (0,4.0) node[left] {$w$};
    \draw[very thick] plot[domain=0.42:6.4, samples=80] (\x,{2.5/sqrt(\x)});
    \draw[very thick, dashed] plot[domain=0.6:6.4, samples=80] (\x,{1.5*(\x/2.78)^(-1/3)});
    \node[right] at (6.4,{2.5/sqrt(6.4)-0.08}) {$L^d_{cp}$};
    \node[right] at (6.4,{1.5*(6.4/2.78)^(-1/3)+0.08}) {$L^d_{lp}$};
    \draw[dotted] (0,1.5) -- (2.78,1.5);
    \draw[dotted] (0,1.2) -- (5.43,1.2);
    \fill (2.78,1.5) circle (1.8pt) node[above right] {$A$};
    \fill (4.34,1.2) circle (1.8pt) node[below] {$B$};
    \fill (5.43,1.2) circle (1.8pt) node[below] {$C$};
    \node[left] at (0,1.5) {$w_0$};
    \node[left] at (0,1.2) {$w_1$};
  \end{scope}
\end{tikzpicture}
