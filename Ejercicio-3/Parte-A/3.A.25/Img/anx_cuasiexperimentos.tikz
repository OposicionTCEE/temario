% Figura (Anexo III, «Experimentos naturales»): tres diseños para identificar efectos causales.
% (a) Diferencias en diferencias: grupo de control C de 1,0 (t_0) a 1,6 (t_1); grupo tratado T de 1,8 a 3,2;
%     contrafactual de T paralelo al de C (de 1,8 a 2,4); efecto beta_DD = 3,2 - 2,4 = 0,8.
% (b) Discontinuidad: resultado 1 + 0,4 x a la izquierda del umbral x = 2 y 2,6 + 0,35 (x - 2) a la derecha;
%     salto beta_RD = 0,8 en el umbral; puntos ilustrativos alrededor de las rectas.
% (c) Agrupamiento: densidad de la renta sin vértice f(z) = 0,15 + 0,55 exp(-((z - 1,7)/1,1)^2) (discontinua) y con un
%     vértice en z* = 2: masa adicional B en z* y, a su derecha, f(z) (1 - 0,35 exp(-(z - 2)/0,5)).
% Escala: x = 1,5 cm, 1,05 cm y 1,05 cm; y = 0,9 cm, 0,9 cm y 3,9 cm. Generar con: bash Code/generar_figura.sh anx_cuasiexperimentos
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  % ---------------- (a) Diferencias en diferencias ----------------
  \begin{scope}[x=1.5cm, y=0.9cm]
    \node[font=\footnotesize\bfseries] at (1.45,4.15) {(a) Diferencias en diferencias};
    \draw[->] (0,0) -- (2.85,0) node[below] {$t$};
    \draw[->] (0,0) -- (0,3.75) node[left] {$y$};
    \draw[very thick] (1,1.8) -- (2,3.2) node[above] {$T$};
    \draw[very thick, dashed] (1,1.0) -- (2,1.6) node[right] {$C$};
    \draw[thick, dotted] (1,1.8) -- (2,2.4);
    \foreach \p in {(1,1.8), (2,3.2), (1,1.0), (2,1.6)} \fill \p circle (1.6pt);
    \draw[<->, thin] (2.15,2.42) -- (2.15,3.18);
    \node[right] at (2.15,2.8) {$\beta_{DD}$};
    \draw[dotted] (1,1.0) -- (1,0);
    \draw[dotted] (2,1.6) -- (2,0);
    \node[below] at (1,0) {$t_0$};
    \node[below] at (2,0) {$t_1$};
  \end{scope}
  % ---------------- (b) Discontinuidad ----------------
  \begin{scope}[xshift=5.45cm, x=1.05cm, y=0.9cm]
    \node[font=\footnotesize\bfseries] at (2.05,4.15) {(b) Discontinuidad};
    \draw[->] (0,0) -- (4.3,0) node[below] {$x$};
    \draw[->] (0,0) -- (0,3.75) node[left] {$y$};
    \foreach \p in {(0.2,0.95), (0.45,1.35), (0.7,1.1), (0.95,1.55), (1.2,1.3), (1.45,1.75), (1.7,1.55), (1.9,1.85), (2.1,2.75), (2.35,2.6), (2.6,3.0), (2.85,2.8), (3.1,3.15), (3.35,2.95), (3.6,3.35), (3.85,3.1)}
      \fill \p circle (1.1pt);
    \draw[very thick] (0,1.0) -- (2,1.8);
    \draw[very thick] (2,2.6) -- (4,3.3);
    \draw[dotted] (2,0) -- (2,3.5);
    \draw[<->, thin] (2.15,1.82) -- (2.15,2.58);
    \node[right] at (2.15,2.2) {$\beta_{RD}$};
    \node[below] at (2,0) {$\bar x$};
  \end{scope}
  % ---------------- (c) Agrupamiento ----------------
  \begin{scope}[xshift=10.75cm, x=1.05cm, y=3.9cm]
    \node[font=\footnotesize\bfseries] at (2.05,0.9577) {(c) Agrupamiento};
    \draw[->] (0,0) -- (4.3,0) node[below] {$z$};
    \draw[->] (0,0) -- (0,0.865) node[left] {$f$};
    \draw[thick, dashed] plot[domain=0:4, samples=81] (\x,{0.15+0.55*exp(-1*(((\x-1.7)/1.1)^2))});
    \draw[very thick] plot[domain=0:1.95, samples=41] (\x,{0.15+0.55*exp(-1*(((\x-1.7)/1.1)^2))}) -- (1.95,0.80) -- (2.05,0.80) -- (2.05,{(1-0.35*exp(-0.1))*(0.15+0.55*exp(-1*(((2.05-1.7)/1.1)^2)))});
    \draw[very thick] plot[domain=2.05:4, samples=41] (\x,{(1-0.35*exp(-(\x-2)/0.5))*(0.15+0.55*exp(-1*(((\x-1.7)/1.1)^2)))});
    \node[right] at (2.05,0.80) {$B$};
    \draw[dotted] (2,0) -- (2,0.78);
    \node[below] at (2,0) {$z^*$};
  \end{scope}
\end{tikzpicture}
