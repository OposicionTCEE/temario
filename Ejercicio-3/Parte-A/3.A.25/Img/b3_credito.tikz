% Figura (cuerpo, 3.1.1 «Participación»): el crédito fiscal por trabajo y su evaluación (EISSA y LIEBMAN, 1996).
% (a) Recta presupuestaria con un crédito por trabajo: T = 5, w = 0,8, R = 0,5, E = (5; 0,5); sin crédito,
%     C = 0,5 + 0,8 (5 - ell) (discontinua). Crédito: tramo de entrada al 60 % de los ingresos hasta h = 1,5
%     (K1 = (3,5; 2,42)), constante en 0,72 hasta h = 2,25 (K2 = (2,75; 3,02)) y retirada al 40 % hasta anularse en
%     h = 4,5 (K3 = (0,5; 4,1)). Pendientes: -w(1+s) = -1,28; -w = -0,8; -w(1-t) = -0,48. Sombreado: lo que añade el crédito.
% (b) Diferencias en diferencias: control C (mujeres solas sin hijos) de 3,0 a 3,15, cerca de su máximo; tratadas T (madres
%     solas) de 1,5 a 2,45; contrafactual de T paralelo al de C (de 1,5 a 1,65); efecto beta_DD = 0,8. Valores ilustrativos.
% Escala: (a) 0,95 cm por unidad; (b) x = 1,5 cm, y = 1,1 cm. Generar con: bash Code/generar_figura.sh b3_credito
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  % ---------------- (a) Crédito por trabajo ----------------
  \begin{scope}[x=0.95cm, y=0.95cm]
    \node[font=\footnotesize\bfseries] at (2.8,5.3) {(a) Crédito por trabajo};
    \fill[black!12] (5,0.5) -- (3.5,2.42) -- (2.75,3.02) -- (0.5,4.1) -- cycle;
    \draw[->] (0,0) -- (5.9,0) node[below] {$\ell$};
    \draw[->] (0,0) -- (0,5.0) node[left] {$C$};
    \draw[thick, dashed] (0,4.5) -- (5,0.5);
    \draw[very thick] (0,4.5) -- (0.5,4.1) -- (2.75,3.02) -- (3.5,2.42) -- (5,0.5) -- (5,0);
    \fill (5,0.5) circle (2pt) node[above right] {$E$};
    \node[below] at (5,0) {$T$};
    \node[above right, font=\scriptsize] at (4.3,1.45) {$-w(1+s)$};
    \node[above right, font=\scriptsize] at (3.1,2.75) {$-w$};
    \node[above, font=\scriptsize] at (1.8,3.92) {$-w(1-t)$};
  \end{scope}
  % ---------------- (b) Diferencias en diferencias ----------------
  \begin{scope}[xshift=7.4cm, x=1.5cm, y=1.1cm]
    \node[font=\footnotesize\bfseries] at (1.45,4.55) {(b) Diferencias en diferencias};
    \draw[->] (0,0) -- (2.85,0) node[below] {$t$};
    \draw[->] (0,0) -- (0,3.75) node[left] {$p$};
    \draw[very thick, dashed] (1,3.0) -- (2,3.15) node[right] {$C$};
    \draw[very thick] (1,1.5) -- (2,2.45) node[above] {$T$};
    \draw[thick, dotted] (1,1.5) -- (2,1.65);
    \foreach \p in {(1,3.0), (2,3.15), (1,1.5), (2,2.45)} \fill \p circle (1.6pt);
    \draw[<->, thin] (2.15,1.67) -- (2.15,2.43);
    \node[right] at (2.15,2.05) {$\beta_{DD}$};
    \draw[dotted] (1,1.5) -- (1,0);
    \draw[dotted] (2,1.65) -- (2,0);
    \node[below] at (1,0) {$t_0$};
    \node[below] at (2,0) {$t_1$};
  \end{scope}
\end{tikzpicture}
