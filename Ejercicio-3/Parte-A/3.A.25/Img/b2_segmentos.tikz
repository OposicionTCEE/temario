% Figura (cuerpo, 2.1 «Diferencias salariales»): mercados de trabajo por cualificación.
% (a) Cualificado: demanda w = 6 - 0,8 L; oferta w = 1 + 0,6 L; E_H = (3,571; 3,143). Si se cualifican 1,5 unidades de
%     trabajo, la oferta pasa a w = 0,1 + 0,6 L (discontinua) y E'_H = (4,214; 2,629).
% (b) No cualificado: demanda w = 4 - 0,8 L; oferta w = 0,2 + 0,6 L; E_L = (2,714; 1,829). La oferta pasa a
%     w = 1,1 + 0,6 L y E'_L = (2,071; 2,343). La diferencia salarial pasa de 1,314 a 0,286, la que compensa el coste de
%     cualificarse. Rectas ilustrativas, con la misma escala en los dos paneles.
% Escala: x = 0,85 cm; y = 0,7 cm. Generar con: bash Code/generar_figura.sh b2_segmentos
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=0.85cm, y=0.7cm]
  % ---------------- (a) Trabajo cualificado ----------------
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (3.4,6.9) {(a) Trabajo cualificado};
    \draw[->] (0,0) -- (7.0,0) node[below] {$L_H$};
    \draw[->] (0,0) -- (0,6.4) node[left] {$w$};
    \draw[very thick] (0.3,5.76) -- (6.5,0.8) node[right] {$D_H$};
    \draw[very thick] (0,1.0) -- (6.0,4.6) node[right] {$S_H$};
    \draw[thick, dashed] (1.0,0.7) -- (6.4,3.94) node[right] {$S'_H$};
    \fill (3.571,3.143) circle (1.8pt);
    \fill (4.214,2.629) circle (1.8pt);
    \draw[dotted] (0,3.143) -- (3.571,3.143);
    \draw[dotted] (0,2.629) -- (4.214,2.629);
    \node[left] at (0,3.143) {$w_H$};
    \node[left] at (0,2.629) {$w'_H$};
  \end{scope}
  % ---------------- (b) Trabajo no cualificado ----------------
  \begin{scope}[xshift=8.0cm]
    \node[font=\footnotesize\bfseries] at (3.4,6.9) {(b) Trabajo no cualificado};
    \draw[->] (0,0) -- (7.0,0) node[below] {$L_L$};
    \draw[->] (0,0) -- (0,6.4) node[left] {$w$};
    \draw[very thick] (0.3,3.76) -- (4.8,0.16) node[right] {$D_L$};
    \draw[very thick] (0,0.2) -- (6.0,3.8) node[right] {$S_L$};
    \draw[thick, dashed] (0,1.1) -- (5.5,4.4) node[right] {$S'_L$};
    \fill (2.714,1.829) circle (1.8pt);
    \fill (2.071,2.343) circle (1.8pt);
    \draw[dotted] (0,1.829) -- (2.714,1.829);
    \draw[dotted] (0,2.343) -- (2.071,2.343);
    \node[left] at (0,1.829) {$w_L$};
    \node[left] at (0,2.343) {$w'_L$};
  \end{scope}
\end{tikzpicture}
