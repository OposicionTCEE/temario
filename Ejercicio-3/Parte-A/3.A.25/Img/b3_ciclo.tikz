% Figura (cuerpo, 3.2.2 «Sustitución intertemporal»): una recesión con la oferta de FRISCH que mide la evidencia, sobre el
% gráfico de b1_perturbaciones. Rehecha el 03/11/2026 (segunda pasada): sustituye a la trayectoria de las horas en un año
% sin impuestos, demasiado ligada a un estudio.
% Demanda L^d_0: w = 3,6 - 0,4 L; tras una perturbación negativa, L^d_1: w = 3 - 0,4 L. Oferta de FRISCH estimada, poco
% elástica: w = 1,533 + 1,5 (L - 5,167), por A = (5,167; 1,533); con ella, el equilibrio pasaría a B = (4,851; 1,060).
% Lo observado, O = (4,167; 1,333), sobre L^d_1: mucho menos empleo y un salario poco menor; solo sería un equilibrio con
% una oferta muy elástica, w = 0,5 + 0,2 L (de puntos). Con la oferta estimada, al salario de O querrían trabajar 5,034
% (punto S): la distancia entre O y S es paro involuntario. Rectas ilustrativas.
% Escala: x = 0,95 cm; y = 1,5 cm. Generar con: bash Code/generar_figura.sh b3_ciclo
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=0.95cm, y=1.5cm]
  \draw[->] (0,0) -- (7.6,0) node[below] {$L$};
  \draw[->] (0,0) -- (0,3.3) node[left] {$w$};
  \draw[very thick] (1.5,3.0) -- (7.0,0.8) node[right] {$L^d_0$};
  \draw[very thick] (0.5,2.8) -- (6.5,0.4) node[right] {$L^d_1$};
  \draw[very thick, dashed] (4.278,0.2) -- (6.212,3.1) node[above] {$L^s_F$};
  \draw[thick, dotted] (0.4,0.58) -- (6.8,1.86) node[right] {$\tilde L^s_F$};
  \fill (5.167,1.533) circle (1.8pt) node[right] {$A$};
  \fill (4.851,1.060) circle (1.8pt) node[below right] {$B$};
  \fill (4.167,1.333) circle (1.8pt) node[above left] {$O$};
  \draw[thin] (4.167,1.333) -- (5.034,1.333);
  \fill (5.034,1.333) circle (1.5pt) node[right] {$S$};
\end{tikzpicture}
