% Figura (cuerpo, 3.1.2 «Ciclo»): un periodo sin impuestos, como los de la transición suiza que estudiaron MARTÍNEZ, SAEZ y
% SIEGENTHALER (2021). El salario neto, w_N, sube de 2 a 2,6 solo entre t_1 = 4 y t_2 = 6 (zona sombreada), un cambio
% transitorio y previsto. Con una elasticidad de FRISCH alta, las horas h_t^F subirían de 1 a 1,5 en ese intervalo
% (discontinua); las observadas, h_t, apenas cambian (1,04). Curvas ilustrativas.
% Escala: x = 0,55 cm por periodo; y = 1,0 cm. Generar con: bash Code/generar_figura.sh b3_ciclo
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=0.55cm, y=1.0cm]
  \fill[black!8] (4,0) rectangle (6,2.85);
  \draw[->] (0,0) -- (10.8,0) node[below] {$t$};
  \draw[->] (0,0) -- (0,3.0);
  \draw[very thick] (0,2) -- (4,2) -- (4,2.6) -- (6,2.6) -- (6,2) -- (10,2) node[right] {$w_N$};
  \draw[very thick, dashed] (4,1.04) -- (4,1.5) -- (6,1.5) -- (6,1.04);
  \draw[very thick] (0,1) -- (4,1) -- (4,1.04) -- (6,1.04) -- (6,1) -- (10,1) node[right] {$h_t$};
  \node[above] at (5,1.5) {$h_t^F$};
  \node[below] at (4,0) {$t_1$};
  \node[below] at (6,0) {$t_2$};
\end{tikzpicture}
