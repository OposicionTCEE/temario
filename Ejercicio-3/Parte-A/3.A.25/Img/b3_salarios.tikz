% Figura (cuerpo, 3.4 «Diferencias salariales»): lo que explica la oferta y la demanda y lo que no.
% (a) Prima de cualificación (KATZ y MURPHY, 1992): demanda relativa ln(w_H/w_L) = c - (1/sigma) ln(H/L), sigma = 1,4;
%     D_1 con c = 2,5 y D_2 con c = 3,4; oferta relativa S_1 en 1,0 y S_2 en 1,8. A = (1,0; 1,786), B = (1,0; 2,686),
%     C = (1,8; 2,114). Adaptada de anx_carrera.
% (b) Primas de las empresas (ABOWD, KRAMARZ y MARGOLIS, 1999): dos trabajadores iguales, con el mismo efecto alpha, se
%     cambian de empresa en t*: el que pasa de A a B cobra alpha + psi_A (2,2) y después alpha + psi_B (1,0); el que pasa
%     de B a A, al revés. Valores ilustrativos.
% Escala: (a) x = 1,7 cm, y = 1,15 cm; (b) x = 0,8 cm, y = 1,15 cm. Generar con: bash Code/generar_figura.sh b3_salarios
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  % ---------------- (a) Prima de cualificación ----------------
  \begin{scope}[x=1.7cm, y=1.15cm]
    \node[font=\footnotesize\bfseries] at (1.6,3.95) {(a) Prima de cualificación};
    \draw[->] (0,0) -- (3.2,0) node[below] {$\ln(H/L)$};
    \draw[->] (0,0) -- (0,3.6) node[left] {$\ln(w_H/w_L)$};
    \draw[very thick] (0.3,2.286) -- (2.8,0.500) node[right] {$D_1$};
    \draw[very thick] (0.3,3.186) -- (2.8,1.400) node[right] {$D_2$};
    \draw[very thick, dashed] (1.0,0) -- (1.0,3.3) node[above] {$S_1$};
    \draw[very thick, dashed] (1.8,0) -- (1.8,3.3) node[above] {$S_2$};
    \fill (1.0,1.786) circle (1.8pt) node[below left] {$A$};
    \fill (1.0,2.686) circle (1.8pt) node[above right] {$B$};
    \fill (1.8,2.114) circle (1.8pt) node[above right] {$C$};
    \draw[dotted] (0,1.786) -- (1.0,1.786);
    \draw[dotted] (0,2.114) -- (1.8,2.114);
  \end{scope}
  % ---------------- (b) Primas de las empresas ----------------
  \begin{scope}[xshift=7.6cm, x=0.8cm, y=1.15cm]
    \node[font=\footnotesize\bfseries] at (3.2,3.95) {(b) Primas de las empresas};
    \draw[->] (0,0) -- (6.6,0) node[below] {$t$};
    \draw[->] (0,0) -- (0,3.3) node[left] {$\ln w$};
    \draw[very thick] (0.4,2.2) -- (3,2.2) -- (3.6,1.0) -- (6,1.0) node[right] {$A\to B$};
    \draw[very thick, dashed] (0.4,1.0) -- (3,1.0) -- (3.6,2.2) -- (6,2.2) node[right] {$B\to A$};
    \draw[dotted] (3.3,0) -- (3.3,2.9);
    \node[below] at (3.3,0) {$t^*$};
    \node[left] at (0,2.2) {$\alpha+\psi_A$};
    \node[left] at (0,1.0) {$\alpha+\psi_B$};
  \end{scope}
\end{tikzpicture}
