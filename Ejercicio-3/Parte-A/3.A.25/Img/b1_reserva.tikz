% Figura (cuerpo, 1.2.1 «Elección»): el salario de reserva como pendiente de la curva de indiferencia en el punto de
% dotación. Se comparan desde E dos rectas presupuestarias: con un salario mayor que el de reserva hay cestas con trabajo
% mejores que E (zona sombreada, entre la recta y U_E); con uno menor, todas quedan por debajo de U_E y se elige E.
% Preferencias COBB-DOUGLAS U = (C ell)^(1/2); T = 5; R = 1,5; E = (5; 1,5); curva por E: C ell = 7,5, de pendiente
% -C/ell = -0,3 = -w_R en E (recta discontinua). Salario alto w = 0,8 (corta U_E también en ell = 1,875); salario bajo
% w = 0,15. Escala: 1 unidad = 0,95 cm. Generar con: bash Code/generar_figura.sh b1_reserva
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=0.95cm, y=0.95cm]
  \fill[black!12] plot[domain=1.875:5, samples=60] (\x,{5.5-0.8*\x}) -- plot[domain=5:1.875, samples=60] (\x,{7.5/\x}) -- cycle;
  \draw[->] (0,0) -- (5.9,0) node[below] {$\ell$};
  \draw[->] (0,0) -- (0,6.0) node[left] {$C$};
  \draw[very thick] (0.9,4.78) -- (5,1.5) -- (5,0);
  \draw[very thick] (0,2.25) -- (5,1.5);
  \draw[thick] plot[domain=1.3:5.6, samples=80] (\x,{7.5/\x});
  \node[right] at (5.6,{7.5/5.6}) {$U_E$};
  \draw[dashed] (1.3,2.61) -- (5.6,1.32);
  \fill (5,1.5) circle (2pt) node[above right] {$E$};
  \node[below] at (5,0) {$T$};
  \draw[decorate, decoration={brace, amplitude=3pt, mirror}] (5.12,0) -- (5.12,1.5) node[midway, right=3pt] {$R$};
  \node[left, font=\scriptsize] at (0.9,4.78) {$w>w_R$};
  \node[above, font=\scriptsize] at (1.3,2.62) {$w_R$};
  \node[left, font=\scriptsize] at (0,2.25) {$w<w_R$};
\end{tikzpicture}
