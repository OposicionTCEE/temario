% Figura (Anexo I, «Hogar»): el modelo colectivo de CHIAPPORI (1992) en dos etapas.
% (a) Frontera de posibilidades de utilidad del hogar, U1^2 + U2^2 = 16 (cuarto de círculo); asignaciones eficientes con
%     peso del miembro 1 mu = 0,4 (E = (2,219; 3,328)) y mu' = 0,6 (E' = (3,328; 2,219)), con sus rectas de bienestar
%     tangentes (discontinuas); un factor de distribución z mueve el punto a lo largo de la frontera.
% (b) Elección del miembro 1 en el espacio (ocio, consumo): T = 5, w1 = 0,8, COBB-DOUGLAS U = (C ell)^(1/2); con la parte
%     phi = 0,5 de la renta no laboral, A = (2,8125; 2,25); con phi' = 1,5, A' = (3,4375; 2,75): más ocio y menos horas.
% Escala: 1 unidad = 0,95 cm. Generar con: bash Code/generar_figura.sh anx_colectivo
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=0.95cm, y=0.95cm]
  % ---------------- (a) Asignaciones eficientes ----------------
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (2.6,5.6) {(a) Asignaciones eficientes};
    \draw[->] (0,0) -- (5.3,0) node[below] {$U_1$};
    \draw[->] (0,0) -- (0,5.1) node[left] {$U_2$};
    \draw[very thick] (4,0) arc (0:90:4);
    \draw[dashed] (0.8,4.274) -- (3.6,2.407);
    \draw[dashed] (1.9,4.361) -- (4.2,0.911);
    \fill (2.219,3.328) circle (1.8pt) node[above right] {$E$};
    \fill (3.328,2.219) circle (1.8pt) node[above right] {$E'$};
    \draw[->, thick] (2.45,3.12) to[bend left=12] node[midway, below left=-1pt] {$z$} (3.12,2.45);
  \end{scope}
  % ---------------- (b) Reparto y oferta del miembro 1 ----------------
  \begin{scope}[xshift=6.6cm]
    \node[font=\footnotesize\bfseries] at (2.8,5.6) {(b) Reparto y oferta del miembro 1};
    \draw[->] (0,0) -- (5.9,0) node[below] {$\ell_1$};
    \draw[->] (0,0) -- (0,5.6) node[left] {$C_1$};
    \draw[very thick] (0,4.5) -- (5,0.5) -- (5,0);
    \draw[very thick] (0,5.5) -- (5,1.5);
    \draw[thick] plot[domain=1.25:5.6, samples=80] (\x,{6.3281/\x});
    \draw[thick] plot[domain=1.75:5.6, samples=80] (\x,{9.4531/\x});
    \fill (2.8125,2.25) circle (1.8pt) node[below left] {$A$};
    \fill (3.4375,2.75) circle (1.8pt) node[above right] {$A'$};
    \fill (5,0.5) circle (1.5pt);
    \fill (5,1.5) circle (1.5pt);
    \draw[dotted] (5,1.5) -- (5,0.5);
    \node[right] at (5,0.5) {$\varphi$};
    \node[right] at (5,1.5) {$\varphi'$};
    \draw[dotted] (2.8125,2.25) -- (2.8125,0);
    \draw[dotted] (3.4375,2.75) -- (3.4375,0);
    \node[below] at (5,0) {$T$};
    \node[below, font=\scriptsize] at (0.9,3.6) {$-w_1$};
  \end{scope}
\end{tikzpicture}
