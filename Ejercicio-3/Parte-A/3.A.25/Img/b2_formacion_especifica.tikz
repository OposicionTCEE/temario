% Figura (cuerpo, 2.3 «General y específica»): la formación específica la pagan y la cobran a medias la empresa y el
% trabajador (BECKER 1962, 1964). Adaptada del panel (b) de anx_formacion.
% Mismos valores: \bar y = 2 (productividad sin formación y salario en las demás empresas), y_0 = 1,2, y_1 = 3,2;
% salarios y_0 < w_0 = 1,6 < \bar y < w_1 = 2,6 < y_1. Trazo grueso: salario; fino: productividad; de puntos: \bar y.
% Gris oscuro: lo que paga la empresa en 0 (w_0 - y_0) y lo que recupera en 1 (y_1 - w_1); gris claro: lo que paga el
% trabajador en 0 (\bar y - w_0) y lo que recupera en 1 (w_1 - \bar y).
% Escala: x = 2,6 cm por periodo; y = 0,95 cm. Generar con: bash Code/generar_figura.sh b2_formacion_especifica
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=2.6cm, y=0.95cm]
  \fill[black!35] (0,1.2) rectangle (1,1.6);
  \fill[black!12] (0,1.6) rectangle (1,2);
  \fill[black!12] (1,2) rectangle (2,2.6);
  \fill[black!35] (1,2.6) rectangle (2,3.2);
  \draw[->] (0,0) -- (2.35,0) node[below] {$t$};
  \draw[->] (0,0) -- (0,4.0) node[left] {$w,\ y$};
  \draw[dashed, thin] (1,0) -- (1,3.7);
  \node[below] at (0.5,0) {$0$};
  \node[below] at (1.5,0) {$1$};
  \draw[thick, dotted] (0,2) -- (2,2);
  \draw[thin] (0,1.2) -- (1,1.2);
  \draw[thin] (1,3.2) -- (2,3.2);
  \draw[very thick] (0,1.6) -- (1,1.6);
  \draw[very thick] (1,2.6) -- (2,2.6);
  \node[left] at (0,1.2) {$y_0$};
  \node[left] at (0,1.6) {$w_0$};
  \node[left] at (0,2) {$\bar y$};
  \node[right] at (2,3.2) {$y_1$};
  \node[right] at (2,2.6) {$w_1$};
\end{tikzpicture}
