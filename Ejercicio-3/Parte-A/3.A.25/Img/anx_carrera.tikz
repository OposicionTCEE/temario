% Figura (Anexo III, «Prima de cualificación»): la carrera entre la educación y la tecnología en el modelo de
% KATZ y MURPHY (1992). Demanda relativa ln(w_H/w_L) = c - (1/sigma) ln(H/L), con sigma = 1,4 (pendiente -0,714):
% D_1 con c = 2,5 y D_2 con c = 3,4 (el progreso técnico desplaza la demanda). Oferta relativa vertical: S_1 en 1,0 y
% S_2 en 1,8. A = (1,0; 1,786), B = (1,0; 2,686) y C = (1,8; 2,114): la prima sube de A a C porque la demanda crece
% más deprisa que la oferta. Escala: x = 2,2 cm; y = 1,15 cm. Generar con: bash Code/generar_figura.sh anx_carrera
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=2.2cm, y=1.15cm]
  \draw[->] (0,0) -- (3.2,0) node[below] {$\ln(H/L)$};
  \draw[->] (0,0) -- (0,3.6) node[left] {$\ln(w_H/w_L)$};
  \draw[very thick] (0.3,2.286) -- (2.8,0.500) node[right] {$D_1$};
  \draw[very thick] (0.3,3.186) -- (2.8,1.400) node[right] {$D_2$};
  \draw[very thick, dashed] (1.0,0) -- (1.0,3.3) node[above] {$S_1$};
  \draw[very thick, dashed] (1.8,0) -- (1.8,3.3) node[above] {$S_2$};
  \fill (1.0,1.786) circle (1.8pt) node[below left] {$A$};
  \fill (1.0,2.686) circle (1.8pt) node[above right] {$B$};
  \fill (1.8,2.114) circle (1.8pt) node[above right] {$C$};
  \draw[dotted] (0,1.786) -- (1.0,1.786);
  \draw[dotted] (0,2.114) -- (1.8,2.114);
\end{tikzpicture}
