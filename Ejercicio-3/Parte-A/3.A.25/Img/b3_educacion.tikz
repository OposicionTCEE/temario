% Figura (cuerpo, 3.3 «Educación»): el sesgo de capacidad y cómo lo evita una variable instrumental.
% Dos personas que solo difieren en capacidad: ln w_1 = 0,3 + 0,15 S y ln w_2 = 1,3 + 0,15 S (el efecto causal de la
% escolaridad, r = 0,15, es el mismo para las dos).
% (a) La más capaz estudia más: A = (3; 0,75) y B = (7; 2,35); la recta que las une (MCO) tiene pendiente 0,40 > 0,15.
% (b) Un instrumento ajeno a la capacidad aumenta 2,5 años la escolaridad de las dos: A' = (5,5; 1,125) y
%     B' = (9,5; 2,725). Las medias de los grupos (círculos blancos), (5; 1,55) y (7,5; 1,925), se unen con pendiente 0,15 = r.
% Escala: x = 0,55 cm por año; y = 1,2 cm. Generar con: bash Code/generar_figura.sh b3_educacion
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=0.55cm, y=1.2cm]
  % ---------------- (a) Sesgo de capacidad ----------------
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (5.3,3.65) {(a) Sesgo de capacidad};
    \draw[->] (0,0) -- (10.8,0) node[below] {$S$};
    \draw[->] (0,0) -- (0,3.3) node[left] {$\ln w$};
    \draw[very thick] (0.5,0.375) -- (10,1.8) node[right] {$\ln w_1$};
    \draw[very thick] (0.5,1.375) -- (10,2.8) node[right] {$\ln w_2$};
    \draw[thick, dashed] (1.5,0.15) -- (8.5,2.95) node[above] {$\beta_{MCO}$};
    \fill (3,0.75) circle (1.8pt) node[below right] {$A$};
    \fill (7,2.35) circle (1.8pt) node[above left] {$B$};
    \draw[dotted] (3,0.75) -- (3,0);
    \draw[dotted] (7,2.35) -- (7,0);
    \node[below] at (3,0) {$S_1$};
    \node[below] at (7,0) {$S_2$};
  \end{scope}
  % ---------------- (b) Variable instrumental ----------------
  \begin{scope}[xshift=7.6cm]
    \node[font=\footnotesize\bfseries] at (5.3,3.65) {(b) Variable instrumental};
    \draw[->] (0,0) -- (10.8,0) node[below] {$S$};
    \draw[->] (0,0) -- (0,3.3) node[left] {$\ln w$};
    \draw[very thick] (0.5,0.375) -- (10,1.8) node[right] {$\ln w_1$};
    \draw[very thick] (0.5,1.375) -- (10,2.8) node[right] {$\ln w_2$};
    \draw[->, thick] (3.3,0.68) -- (5.2,0.965);
    \draw[->, thick] (7.3,2.28) -- (9.2,2.565);
    \fill (3,0.75) circle (1.8pt) node[above left] {$A$};
    \fill (5.5,1.125) circle (1.8pt) node[below right] {$A'$};
    \fill (7,2.35) circle (1.8pt) node[above left] {$B$};
    \fill (9.5,2.725) circle (1.8pt) node[above left] {$B'$};
    \draw[thick, dashed] (5,1.55) -- (7.5,1.925) node[right] {$\beta_{VI}$};
    \draw[fill=white] (5,1.55) circle (1.8pt);
    \draw[fill=white] (7.5,1.925) circle (1.8pt);
  \end{scope}
\end{tikzpicture}
