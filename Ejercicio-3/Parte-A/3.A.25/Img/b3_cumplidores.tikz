% Figura (cuerpo, 4.1 «Metodología», variables instrumentales): los tipos de comportamiento ante el instrumento según los
% tratamientos potenciales (IMBENS y ANGRIST 1994; ANGRIST, IMBENS y RUBIN 1996). Era el panel (b) de b3_instrumento
% (dividida a petición del usuario el 04/11/2026), adaptada del esquema de pizarra del usuario.
% Nunca tratados (0, 0), cumplidores (0, 1), siempre tratados (1, 1) y desafiantes (1, 0); el instrumento solo cambia el
% tratamiento de los cumplidores (sombreado), y la monotonía descarta a los desafiantes (en gris).
% Generar con: bash Code/generar_figura.sh b3_cumplidores
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=2.4cm, y=1.25cm]
  \fill[black!15] (1,1) rectangle (2,2);
  \fill[black!5] (0,0) rectangle (1,1);
  \draw[thick] (0,0) rectangle (2,2);
  \draw[thick] (1,0) -- (1,2);
  \draw[thick] (0,1) -- (2,1);
  \node[font=\scriptsize] at (0.5,1.5) {nunca tratados};
  \node[font=\scriptsize\bfseries] at (1.5,1.5) {cumplidores};
  \node[font=\scriptsize, black!55] at (0.5,0.5) {desafiantes};
  \node[font=\scriptsize] at (1.5,0.5) {siempre tratados};
  \node at (0.5,2.3) {$0$};
  \node at (1.5,2.3) {$1$};
  \node at (1,2.75) {$D(1)$};
  \node at (-0.18,1.5) {$0$};
  \node at (-0.18,0.5) {$1$};
  \node at (-0.55,1) {$D(0)$};
\end{tikzpicture}
