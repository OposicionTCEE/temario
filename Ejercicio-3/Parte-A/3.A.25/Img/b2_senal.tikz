% Figura (cuerpo, 2.4 «Señal»): capital humano frente a señal (SPENCE 1973). Pedida por el usuario el 02/11/2026
% («ilustrar? quizás?»). Dos tipos de trabajador, de productividad baja (L) y alta (H); años de estudio e.
% (a) Capital humano: la productividad crece con la educación, y_L(e) = 1 + 0,15 e, y_H(e) = 2 + 0,15 e, y el salario es
%     igual a la productividad: lo que se gana estudiando es lo que se produce de más.
% (b) Señal: la productividad no depende de la educación, y_L = 1,2 e y_H = 2,6 (de puntos); las empresas pagan y_L a quien
%     estudia menos de e* = 4 y y_H a quien llega a e* (trazo grueso); sin señal pagarían a todos la media, y = 1,9
%     (discontinua). Valores ilustrativos.
% Escala: x = 0,6 cm por año, y = 1,3 cm. Generar con: bash Code/generar_figura.sh b2_senal
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  % ---------------- (a) Capital humano ----------------
  \begin{scope}[x=0.6cm, y=1.3cm]
    \node[font=\footnotesize\bfseries] at (4.5,3.85) {(a) Capital humano};
    \draw[->] (0,0) -- (9.2,0) node[below] {$e$};
    \draw[->] (0,0) -- (0,3.5) node[left] {$y,\ w$};
    \draw[very thick] (0,1) -- (8,2.2) node[right] {$w=y_L(e)$};
    \draw[very thick] (0,2) -- (8,3.2) node[right] {$w=y_H(e)$};
  \end{scope}
  % ---------------- (b) Señal ----------------
  \begin{scope}[xshift=8.0cm, x=0.6cm, y=1.3cm]
    \node[font=\footnotesize\bfseries] at (4.5,3.85) {(b) Señal};
    \draw[->] (0,0) -- (9.2,0) node[below] {$e$};
    \draw[->] (0,0) -- (0,3.5) node[left] {$y,\ w$};
    \draw[thick, dotted] (0,1.2) -- (8,1.2) node[right] {$y_L$};
    \draw[thick, dotted] (0,2.6) -- (8,2.6) node[right] {$y_H$};
    \draw[dashed] (0,1.9) -- (8,1.9) node[right] {$\bar y$};
    \draw[very thick] (0,1.2) -- (4,1.2);
    \draw[very thick] (4,2.6) -- (8,2.6);
    \draw[dotted] (4,1.2) -- (4,2.6);
    \fill (4,2.6) circle (1.8pt);
    \draw[dotted] (4,1.2) -- (4,0);
    \node[below] at (4,0) {$e^*$};
  \end{scope}
\end{tikzpicture}
