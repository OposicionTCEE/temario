% Figura (cuerpo, 1.2.2 «Salario»): la oferta individual de trabajo, nula por debajo del salario de reserva, creciente
% y, con salarios altos, decreciente. Adaptada del panel (b) de anx_oferta_individual.
% Preferencias CES de elasticidad de sustitución 1/2, U = 2/(1/C + 1/ell), T = 5, R = 2: nula hasta w_R = 0,16,
% máxima en w = 1,32 (h = 1,517) y decreciente después.
% Escala: h, 1 unidad = 3 cm, y w, 1 unidad = 0,8 cm. Generar con: bash Code/generar_figura.sh b1_oferta_individual
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=3cm, y=0.8cm]
  \draw[->] (0,0) -- (1.85,0) node[below] {$h$};
  \draw[->] (0,0) -- (0,6.2) node[left] {$w$};
  \draw[very thick] (0,0) -- (0,0.16);
  \draw[very thick] plot[smooth] coordinates {(0.000,0.160) (0.365,0.200) (0.667,0.250) (0.912,0.312) (1.108,0.391) (1.258,0.488) (1.370,0.610) (1.447,0.763) (1.494,0.954) (1.515,1.192) (1.514,1.490) (1.495,1.863) (1.461,2.328) (1.415,2.910) (1.359,3.638) (1.297,4.547) (1.230,5.684)};
  \fill (0,0.16) circle (1.8pt);
  \node[left] at (0,0.16) {$w_R$};
  \node[above] at (1.23,5.684) {$h(w)$};
\end{tikzpicture}
