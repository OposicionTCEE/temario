% Figura (Anexo II, «Salarios hedónicos»): la función de salarios hedónicos como envolvente (ROSEN 1974, 1986).
% Espacio (riesgo p, salario w). Función hedónica W(p) = 1 + 2p + p^2.
% Trabajador A, más averso al riesgo, y empresa Y, a la que la seguridad le cuesta poco: tangencia en p = 0,4
% (W = 1,96; pendiente 2,8). Trabajador B, menos averso, y empresa X, a la que la seguridad le cuesta mucho: tangencia
% en p = 1,1 (W = 4,41; pendiente 4,2). Curvas de indiferencia: W(p0) + W'(p0)(p - p0) + 2,5 (p - p0)^2 (convexas,
% por encima); curvas de isobeneficio: W(p0) + W'(p0)(p - p0) - 1,5 (p - p0)^2 (cóncavas, por debajo).
% Escala: x = 4 cm, y = 0,8 cm. Generar con: bash Code/generar_figura.sh anx_hedonico
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=4cm, y=0.8cm]
  \draw[->] (0,0) -- (1.75,0) node[below] {$p$};
  \draw[->] (0,0) -- (0,6.9) node[left] {$w$};
  \draw[very thick] plot[domain=0:1.6, samples=80] (\x,{1+2*\x+\x*\x}) node[right] {$W(p)$};
  % Tangencia A-Y en p = 0,4
  \draw[thick] plot[domain=0.05:0.7, samples=60] (\x,{1.96+2.8*(\x-0.4)+2.5*(\x-0.4)^2});
  \draw[thick, dashed] plot[domain=0:0.78, samples=60] (\x,{1.96+2.8*(\x-0.4)-1.5*(\x-0.4)^2});
  \node[left] at (0.05,{1.96+2.8*(0.05-0.4)+2.5*(0.05-0.4)^2+0.1}) {$u_A$};
  \node[below right] at (0.78,{1.96+2.8*(0.78-0.4)-1.5*(0.78-0.4)^2}) {$\pi_Y$};
  \fill (0.4,1.96) circle (1.8pt);
  % Tangencia B-X en p = 1,1
  \draw[thick] plot[domain=0.82:1.45, samples=60] (\x,{4.41+4.2*(\x-1.1)+2.5*(\x-1.1)^2});
  \draw[thick, dashed] plot[domain=0.78:1.62, samples=60] (\x,{4.41+4.2*(\x-1.1)-1.5*(\x-1.1)^2});
  \node[above] at (1.45,{4.41+4.2*0.35+2.5*0.1225}) {$u_B$};
  \node[right] at (1.62,{4.41+4.2*0.52-1.5*0.2704}) {$\pi_X$};
  \fill (1.1,4.41) circle (1.8pt);
  \draw[dotted] (0.4,1.96) -- (0.4,0);
  \draw[dotted] (1.1,4.41) -- (1.1,0);
  \node[below] at (0.4,0) {$p_A$};
  \node[below] at (1.1,0) {$p_B$};
\end{tikzpicture}
