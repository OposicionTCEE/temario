% Figura (cuerpo, 1.4.2 «Salario mínimo»): el salario mínimo con competencia. Sustituye al panel (a) de b1_salario_minimo
% (el usuario pidió separar competencia, monopsonio y salario mínimo óptimo, 02/11/2026).
% Oferta del mercado w = 0,5 + 0,35 L; demanda w = 4 - 0,45 L; E = (4,375; 2,031). Mínimo 2,8: empleo 2,667 (D), oferta
% 6,571; la diferencia es paro involuntario.
% Escala: x = 0,8 cm, y = 1,05 cm. Generar con: bash Code/generar_figura.sh b1_sm_competencia
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=0.8cm, y=1.05cm]
  \draw[->] (0,0) -- (8.0,0) node[below] {$L$};
  \draw[->] (0,0) -- (0,4.1) node[left] {$w$};
  \draw[very thick] (0,0.5) -- (7.4,3.09) node[right] {$L^s$};
  \draw[very thick] (0,4) -- (7.6,0.58) node[right] {$L^d$};
  \draw[dashed] (0,2.8) -- (7.4,2.8);
  \node[left] at (0,2.8) {$\underline w$};
  \draw[dotted] (0,2.031) -- (4.375,2.031);
  \node[left] at (0,2.031) {$w^*$};
  \fill (4.375,2.031) circle (1.8pt) node[below] {$E$};
  \fill (2.667,2.8) circle (1.8pt) node[above] {$D$};
  \fill (6.571,2.8) circle (1.5pt);
  \draw[dotted] (2.667,2.8) -- (2.667,0);
  \draw[dotted] (6.571,2.8) -- (6.571,0);
  \draw[dotted] (4.375,2.031) -- (4.375,0);
  \node[below] at (2.667,0) {$L^d(\underline w)$};
  \node[below] at (4.375,0) {$L^*$};
  \node[below] at (6.571,0) {$L^s(\underline w)$};
  \draw[decorate, decoration={brace, amplitude=3pt}] (2.667,3.0) -- (6.571,3.0) node[midway, above=3pt] {$L^s-L^d$};
\end{tikzpicture}
