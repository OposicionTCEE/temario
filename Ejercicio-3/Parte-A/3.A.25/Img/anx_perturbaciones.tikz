% Figura (Anexo I, «Perturbaciones»): la misma perturbación positiva de la demanda (productividad), transitoria o
% permanente. Demanda inicial w = 3 - 0,4 L; tras la perturbación, w = 3,6 - 0,4 L. Equilibrio inicial A = (4,1667; 1,3333).
% (a) Transitoria: responde la oferta de FRISCH, plana, w = 0,5 + 0,2 L: B = (5,1667; 1,5333) (mucho empleo, poco salario).
% (b) Permanente: responde la oferta marshalliana, empinada, w = 1,3333 + 3 (L - 4,1667): C = (4,343; 1,863)
%     (poco empleo, mucho salario). Rectas ilustrativas.
% Escala: x = 0,85 cm, y = 1,2 cm. Generar con: bash Code/generar_figura.sh anx_perturbaciones
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=0.85cm, y=1.2cm]
  % ---------------- (a) Perturbación transitoria ----------------
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (3.4,4.25) {(a) Perturbación transitoria};
    \draw[->] (0,0) -- (7.4,0) node[below] {$L$};
    \draw[->] (0,0) -- (0,3.9) node[left] {$w$};
    \draw[very thick] (0.4,2.84) -- (6.8,0.28) node[right] {$L^d_0$};
    \draw[very thick] (1.9,2.84) -- (7.0,0.80) node[right] {$L^d_1$};
    \draw[very thick, dashed] (0.5,0.6) -- (6.9,1.88) node[right] {$h^F$};
    \fill (4.1667,1.3333) circle (1.8pt) node[below] {$A$};
    \fill (5.1667,1.5333) circle (1.8pt) node[above] {$B$};
    \draw[dotted] (4.1667,1.3333) -- (4.1667,0);
    \draw[dotted] (5.1667,1.5333) -- (5.1667,0);
  \end{scope}
  % ---------------- (b) Perturbación permanente ----------------
  \begin{scope}[xshift=7.7cm]
    \node[font=\footnotesize\bfseries] at (3.4,4.25) {(b) Perturbación permanente};
    \draw[->] (0,0) -- (7.4,0) node[below] {$L$};
    \draw[->] (0,0) -- (0,3.9) node[left] {$w$};
    \draw[very thick] (0.4,2.84) -- (6.8,0.28) node[right] {$L^d_0$};
    \draw[very thick] (1.9,2.84) -- (7.0,0.80) node[right] {$L^d_1$};
    \draw[very thick, dashed] (3.833,0.3333) -- (4.9,3.533) node[above] {$h^M$};
    \fill (4.1667,1.3333) circle (1.8pt) node[left] {$A$};
    \fill (4.343,1.863) circle (1.8pt) node[right] {$C$};
    \draw[dotted] (4.343,1.863) -- (0,1.863);
    \draw[dotted] (4.1667,1.3333) -- (0,1.3333);
  \end{scope}
\end{tikzpicture}
