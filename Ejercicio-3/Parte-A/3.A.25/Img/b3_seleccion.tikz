% Figura (cuerpo, 3.1 «Metodología», modelos estructurales): el sesgo de selección (HECKMAN 1979). Adaptada de
% anx_seleccion sin los datos simulados: solo las curvas, que es lo que comenta el texto.
% Oferta salarial w = 1 + 0,25 x + u, u ~ N(0; 0,55); se trabaja, y el salario se observa, si w > w_R = 2,2 (por debajo,
% zona sombreada, no se observa). Recta: la relación verdadera, E[w | x] = 1 + 0,25 x; curva discontinua: la media de
% quienes trabajan, E[w | x, w > w_R] = mu + 0,55 lambda((mu - 2,2)/0,55), con lambda = phi/Phi (inversa del cociente de
% MILLS), calculada en 17 puntos entre x = 0,3 y 7,7.
% Escala: x = 0,85 cm; y = 1 cm. Generar con: bash Code/generar_figura.sh b3_seleccion
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=0.85cm, y=1cm]
  \fill[black!8] (0,0) rectangle (8.3,2.2);
  \draw[->] (0,0) -- (8.7,0) node[below] {$x$};
  \draw[->] (0,0) -- (0,4.0) node[left] {$w$};
  \draw[thick, dotted] (0,2.2) -- (8.3,2.2);
  \node[left] at (0,2.2) {$w_R$};
  \draw[very thick] (0.3,1.075) -- (7.7,2.925) node[right] {$E[w\mid x]$};
  \draw[very thick, dashed] plot[smooth] coordinates {(0.300,2.402) (0.762,2.416) (1.225,2.431) (1.688,2.448) (2.150,2.468) (2.612,2.489) (3.075,2.514) (3.538,2.542) (4.000,2.574) (4.463,2.610) (4.925,2.650) (5.388,2.697) (5.850,2.749) (6.312,2.808) (6.775,2.874) (7.237,2.947) (7.700,3.027)};
  \node[above] at (6.0,3.05) {$E[w\mid x,\ w>w_R]$};
\end{tikzpicture}
