% Figura (Anexo I, «Curva de oferta»): la oferta individual de trabajo se obtiene de las tangencias al variar el salario.
% Preferencias CES con elasticidad de sustitución 1/2, U = 2/(1/C + 1/ell) (curvas C = 1/(2/U - 1/ell)); T = 5; R = 2.
% Salario de reserva w_R = (R/T)^2 = 0,16.
% (a) Espacio (ocio, consumo), eje de consumo comprimido (1 unidad = 0,5 cm): rectas desde E = (5; 2) con w_R = 0,16,
%     w2 = 1,32 (salario con el que las horas son máximas) y w3 = 4 (cortada en C = 10); tangencias A1 = E (U = 2,857),
%     A2 = (3,483; 4,002) (U = 3,7247) y A3 = (3,667; 7,333) (U = 4,8889); curva de tangencias calculada para w entre
%     0,16 y 6,9 (discontinua).
% (b) Espacio (horas, salario): oferta h(w), nula hasta w_R; máxima en w2 (h = 1,517) y decreciente después
%     (h = 1,333 con w3 = 4 y 1,23 con w = 5,68). Ejes: h, 1 unidad = 3 cm; w, 1 unidad = 0,8 cm.
% Generar con: bash Code/generar_figura.sh anx_oferta_individual
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  % ---------------- (a) Elección con tres salarios ----------------
  \begin{scope}[x=0.9cm, y=0.5cm]
    \node[font=\footnotesize\bfseries] at (2.9,11.3) {(a) Elección con tres salarios};
    \draw[->] (0,0) -- (5.9,0) node[below] {$\ell$};
    \draw[->] (0,0) -- (0,10.8) node[left] {$C$};
    \draw[thick] (0,2.8) -- (5,2) -- (5,0);
    \draw[thick] (0,8.6) -- (5,2);
    \draw[thick] (3,10) -- (5,2);
    \draw[dashed] plot[smooth] coordinates {(5.000,2.000) (4.635,2.073) (4.333,2.167) (4.088,2.285) (3.892,2.433) (3.742,2.614) (3.630,2.836) (3.553,3.104) (3.506,3.424) (3.485,3.806) (3.486,4.256) (3.505,4.784) (3.539,5.401) (3.585,6.117) (3.641,6.944) (3.703,7.897) (3.770,8.989)};
    \draw plot[domain=1.7:5.6, samples=80] (\x,{1/(0.7-1/\x)});
    \draw plot[domain=2.35:5.6, samples=80] (\x,{1/(0.53696-1/\x)});
    \draw plot[domain=3.25:5.6, samples=80] (\x,{1/(0.40909-1/\x)});
    \fill (5,2) circle (1.8pt) node[right] {$E=A_1$};
    \fill (3.483,4.002) circle (1.8pt) node[left] {$A_2$};
    \fill (3.667,7.333) circle (1.8pt) node[left] {$A_3$};
    \node[below] at (5,0) {$T$};
    \node[left, font=\scriptsize] at (0,2.8) {$w_R$};
    \node[left, font=\scriptsize] at (0,8.6) {$w_2$};
    \node[above, font=\scriptsize] at (3,10) {$w_3$};
  \end{scope}
  % ---------------- (b) Oferta individual ----------------
  \begin{scope}[xshift=7.4cm, x=3cm, y=0.8cm]
    \node[font=\footnotesize\bfseries] at (0.95,6.6) {(b) Oferta individual de trabajo};
    \draw[->] (0,0) -- (1.85,0) node[below] {$h$};
    \draw[->] (0,0) -- (0,6.2) node[left] {$w$};
    \draw[very thick] (0,0) -- (0,0.16);
    \draw[very thick] plot[smooth] coordinates {(0.000,0.160) (0.365,0.200) (0.667,0.250) (0.912,0.312) (1.108,0.391) (1.258,0.488) (1.370,0.610) (1.447,0.763) (1.494,0.954) (1.515,1.192) (1.514,1.490) (1.495,1.863) (1.461,2.328) (1.415,2.910) (1.359,3.638) (1.297,4.547) (1.230,5.684)};
    \fill (0,0.16) circle (1.8pt);
    \node[left] at (0,0.16) {$w_R$};
    \fill (1.517,1.32) circle (1.8pt) node[right] {$A_2$};
    \fill (1.333,4.0) circle (1.8pt) node[right] {$A_3$};
    \draw[dotted] (0,1.32) -- (1.517,1.32);
    \draw[dotted] (0,4.0) -- (1.333,4.0);
    \node[left] at (0,1.32) {$w_2$};
    \node[left] at (0,4.0) {$w_3$};
    \node[above] at (1.23,5.684) {$h(w)$};
  \end{scope}
\end{tikzpicture}
