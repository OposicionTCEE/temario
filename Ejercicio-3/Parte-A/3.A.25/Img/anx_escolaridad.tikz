% Figura (Anexo II, «Escolaridad óptima»): la escolaridad óptima con rendimiento marginal decreciente y coste marginal
% de los fondos creciente (BECKER 1967; formulación lineal de CARD 1999, 2001).
% rho_i(S) = b_i - 0,01 S (rendimiento marginal); i_i(S) = r_i + 0,002 S (coste marginal de los fondos).
% (a) Una persona: b = 0,22, r = 0,04: S* = 15, rendimiento marginal en el óptimo 0,07.
% (b) Capacidad (b_1 = 0,22; b_2 = 0,28) y acceso a la financiación (r_1 = 0,04; r_2 = 0,10):
%     A = (b_1, r_1) en (15; 0,07); B = (b_1, r_2) en (10; 0,12); C = (b_2, r_1) en (20; 0,08); D = (b_2, r_2) en (15; 0,13).
% Escala: x = 0,27 cm por año; y = 18 cm por unidad de rendimiento. Generar con: bash Code/generar_figura.sh anx_escolaridad
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=0.27cm, y=18cm]
  % ---------------- (a) Una persona ----------------
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (11,0.335) {(a) Una persona};
    \draw[->] (0,0) -- (23.5,0) node[below] {$S$};
    \draw[->] (0,0) -- (0,0.31);
    \draw[very thick] (0,0.22) -- (22,0.0) node[above right] {$\rho(S)$};
    \draw[very thick, dashed] (0,0.04) -- (22,0.084) node[right] {$i(S)$};
    \fill (15,0.07) circle (1.8pt) node[above right] {$E$};
    \draw[dotted] (15,0.07) -- (15,0);
    \node[below] at (15,0) {$S^*$};
  \end{scope}
  % ---------------- (b) Capacidad y financiación ----------------
  \begin{scope}[xshift=7.6cm]
    \node[font=\footnotesize\bfseries] at (11,0.335) {(b) Capacidad y financiación};
    \draw[->] (0,0) -- (23.5,0) node[below] {$S$};
    \draw[->] (0,0) -- (0,0.31);
    \draw[very thick] (0,0.22) -- (22,0.0) node[above right] {$\rho_1$};
    \draw[very thick] (0,0.28) -- (22,0.06) node[right] {$\rho_2$};
    \draw[very thick, dashed] (0,0.04) -- (22,0.084) node[right] {$i_1$};
    \draw[very thick, dashed] (0,0.10) -- (22,0.144) node[right] {$i_2$};
    \fill (15,0.07) circle (1.8pt) node[below] {$A$};
    \fill (10,0.12) circle (1.8pt) node[above] {$B$};
    \fill (20,0.08) circle (1.8pt) node[below] {$C$};
    \fill (15,0.13) circle (1.8pt) node[above] {$D$};
  \end{scope}
\end{tikzpicture}
