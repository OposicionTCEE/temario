% Figura (cuerpo, 2.4 «Función de ingresos»): la escolaridad en la función de ingresos (MINCER 1958). Era el panel (a) de
% b2_mincer (dividida a petición del usuario, 02/11/2026); adaptada de anx_mincer_escolaridad, reducida.
% S = 0, S_1 = 4, S_2 = 8; N = 40 años de trabajo; ln w(S) = ln w(0) + 0,08 S, con el origen del eje vertical arbitrario
% (ln w(0) en 0,5): quien estudia más empieza a cobrar más tarde y cobra más; los puntos en que empieza cada perfil están
% sobre la recta ln w(S).
% Escala: x = 0,1 cm por año, y = 2,6 cm. Generar con: bash Code/generar_figura.sh b2_mincer_escolaridad
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=0.1cm, y=2.6cm]
  \draw[->] (0,0) -- (52,0) node[below] {$t$};
  \draw[->] (0,0) -- (0,1.5) node[left] {$\ln w$};
  \draw[very thick] (0,0.5) -- (40,0.5) node[right] {$0$};
  \draw[very thick] (4,0.82) -- (44,0.82) node[right] {$S_1$};
  \draw[very thick] (8,1.14) -- (48,1.14) node[right] {$S_2$};
  \draw[thick, dashed] (0,0.5) -- (10.5,1.34) node[right] {$\ln w(S)$};
  \fill (0,0.5) circle (1.6pt);
  \fill (4,0.82) circle (1.6pt);
  \fill (8,1.14) circle (1.6pt);
  \draw[dotted] (4,0.82) -- (4,0);
  \draw[dotted] (8,1.14) -- (8,0);
  \node[below] at (4,0) {$S_1$};
  \node[below] at (8,0) {$S_2$};
\end{tikzpicture}
