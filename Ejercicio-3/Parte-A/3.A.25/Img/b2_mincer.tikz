% Figura (cuerpo, 2.4 «Función de ingresos»): las dos partes de la función de ingresos de MINCER. Combina
% anx_mincer_escolaridad, reducida, y el panel (a) de anx_mincer sin las líneas de alcance ni el máximo, que el cuerpo
% no comenta.
% (a) Escolaridad (MINCER 1958): S = 0, S_1 = 4, S_2 = 8; N = 40 años de trabajo; ln w(S) = ln w(0) + 0,08 S, con el
%     origen del eje vertical arbitrario (ln w(0) en 0,5).
% (b) Experiencia (MINCER 1974, coeficientes del cuadro 5.1): ln w = 6,20 + 0,107 S + 0,081 X - 0,0012 X^2 con S_1 = 12 y
%     S_2 = 16, desplazado 7,2.
% Escala: (a) x = 0,1 cm por año, y = 2,6 cm; (b) x = 0,12 cm por año, y = 1,55 cm. Generar con: bash Code/generar_figura.sh b2_mincer
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  % ---------------- (a) Escolaridad ----------------
  \begin{scope}[x=0.1cm, y=2.6cm]
    \node[font=\footnotesize\bfseries] at (26,1.6) {(a) Escolaridad};
    \draw[->] (0,0) -- (52,0) node[below] {$t$};
    \draw[->] (0,0) -- (0,1.5) node[left] {$\ln w$};
    \draw[very thick] (0,0.5) -- (40,0.5) node[right] {$0$};
    \draw[very thick] (4,0.82) -- (44,0.82) node[right] {$S_1$};
    \draw[very thick] (8,1.14) -- (48,1.14) node[right] {$S_2$};
    \draw[thick, dashed] (0,0.5) -- (11.5,1.42) node[above] {$\ln w(S)$};
    \fill (0,0.5) circle (1.6pt);
    \fill (4,0.82) circle (1.6pt);
    \fill (8,1.14) circle (1.6pt);
    \draw[dotted] (4,0.82) -- (4,0);
    \draw[dotted] (8,1.14) -- (8,0);
    \node[below] at (4,0) {$S_1$};
    \node[below] at (8,0) {$S_2$};
  \end{scope}
  % ---------------- (b) Experiencia ----------------
  \begin{scope}[xshift=8.2cm, x=0.12cm, y=1.55cm]
    \node[font=\footnotesize\bfseries] at (24,2.68) {(b) Experiencia};
    \draw[->] (0,0) -- (49,0) node[below] {$X$};
    \draw[->] (0,0) -- (0,2.4) node[left] {$\ln w$};
    \draw[very thick] plot[smooth] coordinates {(0.000,0.284) (3.000,0.516) (6.000,0.727) (9.000,0.916) (12.000,1.083) (15.000,1.229) (18.000,1.353) (21.000,1.456) (24.000,1.537) (27.000,1.596) (30.000,1.634) (33.000,1.650) (36.000,1.645) (39.000,1.618) (42.000,1.569) (45.000,1.499)} node[right] {$S_1$};
    \draw[very thick] plot[smooth] coordinates {(0.000,0.712) (3.000,0.944) (6.000,1.155) (9.000,1.344) (12.000,1.511) (15.000,1.657) (18.000,1.781) (21.000,1.884) (24.000,1.965) (27.000,2.024) (30.000,2.062) (33.000,2.078) (36.000,2.073) (39.000,2.046) (42.000,1.997) (45.000,1.927)} node[right] {$S_2$};
