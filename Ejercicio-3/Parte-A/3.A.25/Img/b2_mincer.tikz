% Figura (cuerpo, 2.4 «Función de ingresos»): las dos piezas de la función de ingresos de MINCER en una sola figura
% (pedida por el usuario el 04/11/2026; sustituye a b2_mincer_escolaridad y b2_mincer_experiencia). Eje horizontal: el
% tiempo desde que se empieza a estudiar, t = S + X (ligero abuso de notación aceptado por el usuario).
% Escolaridad (MINCER 1958): cada perfil empieza a los S años de estudio sobre la recta ln w(S) = 0,5 + 0,15 S (origen
% arbitrario), con S = 0, S_1 = 4 y S_2 = 8. Experiencia (MINCER 1974): después crece de forma cóncava con la experiencia,
% g(X) = 0,06 X - 0,0009 X^2, durante 40 años: los perfiles son el mismo, desplazado. Valores ilustrativos, con la
% pendiente de la escolaridad mayor que la inicial de la experiencia para que los perfiles se distingan.
% Escala: x = 0,12 cm por año; y = 1,5 cm. Generar con: bash Code/generar_figura.sh b2_mincer
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=0.12cm, y=1.5cm]
  \draw[->] (0,0) -- (53,0) node[below] {$t$};
  \draw[->] (0,0) -- (0,3.0) node[left] {$\ln w$};
  \draw[very thick] plot[smooth] coordinates {(0.0,0.500) (4.0,0.726) (8.0,0.922) (12.0,1.090) (16.0,1.230) (20.0,1.340) (24.0,1.422) (28.0,1.474) (32.0,1.498) (36.0,1.494) (40.0,1.460)} node[right] {$0$};
  \draw[very thick] plot[smooth] coordinates {(4.0,1.100) (8.0,1.326) (12.0,1.522) (16.0,1.690) (20.0,1.830) (24.0,1.940) (28.0,2.022) (32.0,2.074) (36.0,2.098) (40.0,2.094) (44.0,2.060)} node[right] {$S_1$};
  \draw[very thick] plot[smooth] coordinates {(8.0,1.700) (12.0,1.926) (16.0,2.122) (20.0,2.290) (24.0,2.430) (28.0,2.540) (32.0,2.622) (36.0,2.674) (40.0,2.698) (44.0,2.694) (48.0,2.660)} node[right] {$S_2$};
  \draw[thick, dashed] (0,0.5) -- (11,2.15) node[above left] {$\ln w(S)$};
  \fill (0,0.5) circle (1.6pt);
  \fill (4,1.1) circle (1.6pt);
  \fill (8,1.7) circle (1.6pt);
  \draw[dotted] (4,1.1) -- (4,0);
  \draw[dotted] (8,1.7) -- (8,0);
  \node[below] at (4,0) {$S_1$};
  \node[below] at (8,0) {$S_2$};
\end{tikzpicture}
