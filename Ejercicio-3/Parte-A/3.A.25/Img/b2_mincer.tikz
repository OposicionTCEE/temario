% Figura (cuerpo, 2.4 «Función de ingresos»): las dos piezas de la función de ingresos de MINCER en una sola figura
% (pedida por el usuario el 04/11/2026; sustituye a b2_mincer_escolaridad y b2_mincer_experiencia). Eje horizontal: el
% tiempo desde que se empieza a estudiar, t = S + X (ligero abuso de notación aceptado por el usuario).
% Escolaridad (MINCER 1958): cada perfil empieza a los S años de estudio sobre la recta ln w(S) = 0,5 + 0,08 S (origen
% arbitrario), con S = 0, S_1 = 4 y S_2 = 8. Experiencia (MINCER 1974): después crece de forma cóncava con la experiencia,
% g(X) = 0,081 X - 0,0012 X^2 (coeficientes de MINCER, 1974), durante 40 años: los perfiles son el mismo, desplazado.
% Escala: x = 0,12 cm por año; y = 1,6 cm. Generar con: bash Code/generar_figura.sh b2_mincer
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=0.12cm, y=1.6cm]
  \draw[->] (0,0) -- (53,0) node[below] {$t$};
  \draw[->] (0,0) -- (0,2.85) node[left] {$\ln w$};
  \draw[very thick] plot[smooth] coordinates {(0.0,0.500) (4.0,0.805) (8.0,1.071) (12.0,1.299) (16.0,1.489) (20.0,1.640) (24.0,1.753) (28.0,1.827) (32.0,1.863) (36.0,1.861) (40.0,1.820)} node[right] {$0$};
  \draw[very thick] plot[smooth] coordinates {(4.0,0.820) (8.0,1.125) (12.0,1.391) (16.0,1.619) (20.0,1.809) (24.0,1.960) (28.0,2.073) (32.0,2.147) (36.0,2.183) (40.0,2.181) (44.0,2.140)} node[right] {$S_1$};
  \draw[very thick] plot[smooth] coordinates {(8.0,1.140) (12.0,1.445) (16.0,1.711) (20.0,1.939) (24.0,2.129) (28.0,2.280) (32.0,2.393) (36.0,2.467) (40.0,2.503) (44.0,2.501) (48.0,2.460)} node[right] {$S_2$};
  \draw[thick, dashed] (0,0.5) -- (13,1.54) node[above] {$\ln w(S)$};
  \fill (0,0.5) circle (1.6pt);
  \fill (4,0.82) circle (1.6pt);
  \fill (8,1.14) circle (1.6pt);
  \draw[dotted] (4,0.82) -- (4,0);
  \draw[dotted] (8,1.14) -- (8,0);
  \node[below] at (4,0) {$S_1$};
  \node[below] at (8,0) {$S_2$};
\end{tikzpicture}
