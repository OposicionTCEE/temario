% Figura (cuerpo, 3.5.1 «Oferta y demanda»): la prima de cualificación con los mercados por cualificación en términos
% relativos (KATZ y MURPHY, 1992). Era el panel (a) de b3_salarios (separado el 03/11/2026: los dos paneles se comentaban
% en párrafos distintos). Adaptada de anx_carrera.
% Demanda relativa ln(w_H/w_L) = c - (1/sigma) ln(H/L), sigma = 1,4; D_1 con c = 2,5 y D_2 con c = 3,4; oferta relativa S_1
% en 1,0 y S_2 en 1,8. A = (1,0; 1,786), B = (1,0; 2,686), C = (1,8; 2,114).
% Escala: x = 1,7 cm, y = 1,15 cm. Generar con: bash Code/generar_figura.sh b3_prima
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1.7cm, y=1.15cm]
  \draw[->] (0,0) -- (3.2,0) node[below] {$\ln(H/L)$};
  \draw[->] (0,0) -- (0,3.6) node[left] {$\ln(w_H/w_L)$};
  \draw[very thick] (0.3,2.286) -- (2.8,0.500) node[right] {$D_1$};
  \draw[very thick] (0.3,3.186) -- (2.8,1.400) node[right] {$D_2$};
  \draw[very thick, dashed] (1.0,0) -- (1.0,3.3) node[above] {$S_1$};
  \draw[very thick, dashed] (1.8,0) -- (1.8,3.3) node[above] {$S_2$};
  \fill (1.0,1.786) circle (1.8pt) node[below left] {$A$};
  \fill (1.0,2.686) circle (1.8pt) node[above right] {$B$};
  \fill (1.8,2.114) circle (1.8pt) node[above right] {$C$};
  \draw[dotted] (0,1.786) -- (1.0,1.786);
  \draw[dotted] (0,2.114) -- (1.8,2.114);
\end{tikzpicture}
