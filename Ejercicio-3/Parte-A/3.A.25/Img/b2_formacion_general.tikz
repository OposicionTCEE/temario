% Figura (cuerpo, 2.3 «General y específica»): la formación general la paga y la cobra el trabajador (BECKER 1962, 1964).
% Pedida por el usuario el 02/11/2026 («¿Se puede ilustrar?»); adaptada del panel (a) de anx_formacion.
% Dos periodos: 0 (formación) y 1 (después). Sin formación, productividad \bar y = 2, que es también lo que pagan las
% demás empresas. Con formación, productividad neta y_0 = 1,2 y después y_1 = 3,2; el salario es igual a la
% productividad en los dos periodos (trazo grueso). Sombreado: lo que paga el trabajador en 0 (\bar y - w_0) y lo que
% cobra en 1 (w_1 - \bar y).
% Escala: x = 2,6 cm por periodo; y = 0,95 cm. Generar con: bash Code/generar_figura.sh b2_formacion_general
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=2.6cm, y=0.95cm]
  \fill[black!15] (0,1.2) rectangle (1,2);
  \fill[black!15] (1,2) rectangle (2,3.2);
  \draw[->] (0,0) -- (2.35,0) node[below] {$t$};
  \draw[->] (0,0) -- (0,4.0) node[left] {$w,\ y$};
  \draw[dashed, thin] (1,0) -- (1,3.7);
  \node[below] at (0.5,0) {$0$};
  \node[below] at (1.5,0) {$1$};
  \draw[thick, dotted] (0,2) -- (2,2);
  \draw[very thick] (0,1.2) -- (1,1.2);
  \draw[very thick] (1,3.2) -- (2,3.2);
  \node[left] at (0,1.2) {$w_0=y_0$};
  \node[left] at (0,2) {$\bar y$};
  \node[right] at (2,3.2) {$w_1=y_1$};
\end{tikzpicture}
