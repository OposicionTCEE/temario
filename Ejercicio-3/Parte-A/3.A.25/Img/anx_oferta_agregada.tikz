% Figura (Anexo I, «Oferta agregada»): la participación hace la oferta agregada mucho más elástica que la de horas.
% Modelo ilustrativo: preferencias COBB-DOUGLAS U = (C ell)^(1/2), T = 5, R = 1, salario común w y costes fijos de
% trabajar F distintos entre personas (logaritmo normal de mediana 1 y desviación 0,6). Quien trabaja lo hace
% h = 2,5 + 0,5 (F - 1)/w horas; participa si F < (sqrt(5w) - 1)^2, es decir, si w supera su salario de reserva
% w_R = (1 + sqrt(F))^2 / 5, que crece con F.
% (a) Densidad de los salarios de reserva; sombreados, los que participan con w0 = 0,8 (la mitad).
% (b) Horas agregadas H(w) y horas con los participantes fijos en los de w0, H_{w0}(w); se cortan en (1,141; 0,8).
%     Elasticidades en w0: 3,0 y 0,09.
% Generar con: bash Code/generar_figura.sh anx_oferta_agregada
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  % ---------------- (a) Salarios de reserva ----------------
  \begin{scope}[x=3cm, y=1.6cm]
    \node[font=\footnotesize\bfseries] at (1.0,2.45) {(a) Salarios de reserva};
    \fill[black!15] (0.33,0) -- plot[smooth] coordinates {(0.33,0.001) (0.37,0.021) (0.41,0.107) (0.45,0.307) (0.49,0.616) (0.53,0.976) (0.57,1.317) (0.61,1.586) (0.65,1.757) (0.69,1.830) (0.73,1.820) (0.77,1.746) (0.80,1.660)} -- (0.80,0) -- cycle;
    \draw[->] (0,0) -- (2.05,0) node[below] {$w_R$};
    \draw[->] (0,0) -- (0,2.2) node[left] {$f(w_R)$};
    \draw[thick] plot[smooth] coordinates {(0.21,0.000) (0.29,0.000) (0.33,0.001) (0.37,0.021) (0.41,0.107) (0.45,0.307) (0.49,0.616) (0.53,0.976) (0.57,1.317) (0.61,1.586) (0.65,1.757) (0.69,1.830) (0.73,1.820) (0.77,1.746) (0.81,1.630) (0.85,1.489) (0.89,1.338) (0.93,1.186) (0.97,1.040) (1.01,0.904) (1.05,0.782) (1.09,0.672) (1.13,0.575) (1.17,0.491) (1.21,0.418) (1.25,0.356) (1.29,0.302) (1.33,0.256) (1.37,0.218) (1.41,0.185) (1.45,0.157) (1.49,0.133) (1.53,0.113) (1.57,0.096) (1.61,0.082) (1.65,0.070) (1.69,0.059) (1.73,0.051) (1.77,0.043) (1.81,0.037) (1.85,0.032) (1.89,0.027) (1.93,0.023) (1.97,0.020)};
    \draw[dashed] (0.8,0) -- (0.8,2.0);
    \node[below] at (0.8,0) {$w_0$};
    \node at (0.66,0.55) {$F(w_0)$};
  \end{scope}
  % ---------------- (b) Oferta agregada de horas ----------------
  \begin{scope}[xshift=7.6cm, x=2cm, y=2.4cm]
    \node[font=\footnotesize\bfseries] at (1.3,2.04) {(b) Oferta agregada de horas};
    \draw[->] (0,0) -- (2.75,0) node[below] {$H$};
    \draw[->] (0,0) -- (0,1.8) node[left] {$w$};
    \draw[very thick] plot[smooth] coordinates {(0.000,0.35) (0.002,0.40) (0.062,0.50) (0.298,0.60) (0.700,0.70) (1.141,0.80) (1.536,0.90) (1.844,1.00) (2.069,1.10) (2.227,1.20) (2.405,1.40) (2.484,1.60)};
    \draw[thick, dashed] plot[smooth] coordinates {(1.077,0.50) (1.105,0.60) (1.126,0.70) (1.141,0.80) (1.153,0.90) (1.163,1.00) (1.170,1.10) (1.177,1.20) (1.187,1.40) (1.195,1.60)};
    \fill (1.141,0.8) circle (1.8pt);
    \draw[dotted] (0,0.8) -- (1.141,0.8);
    \node[left] at (0,0.8) {$w_0$};
    \node[right] at (2.484,1.6) {$H(w)$};
    \node[above] at (1.195,1.6) {$H_{w_0}(w)$};
