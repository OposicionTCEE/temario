% Figura (cuerpo, 1.4.2 «Salario mínimo»): el salario mínimo con competencia y con monopsonio. Adaptada de
% anx_salario_minimo: el mínimo se denota como en el anexo III, y la diferencia entre oferta y demanda se rotula con letras.
% Oferta del mercado w = 0,5 + 0,35 L; demanda w = 4 - 0,45 L.
% (a) Competencia: E = (4,375; 2,031); mínimo 2,8: empleo 2,667 (D), oferta 6,571; la diferencia es paro involuntario.
% (b) Monopsonio: CMg_L = 0,5 + 0,7 L; L_M = 3,043, w_M = 1,565 (M); un mínimo de 1,9 lleva el empleo a 4 (N).
% Escala: x = 0,8 cm, y = 1,15 cm. Generar con: bash Code/generar_figura.sh b1_salario_minimo
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=0.8cm, y=1.15cm]
  % ---------------- (a) Competencia ----------------
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (3.8,4.45) {(a) Competencia};
    \draw[->] (0,0) -- (8.0,0) node[below] {$L$};
    \draw[->] (0,0) -- (0,4.1) node[left] {$w$};
    \draw[very thick] (0,0.5) -- (7.4,3.09) node[right] {$L^s$};
    \draw[very thick] (0,4) -- (7.6,0.58) node[right] {$L^d$};
    \draw[dashed] (0,2.8) -- (7.4,2.8);
    \node[left] at (0,2.8) {$\underline w$};
    \fill (4.375,2.031) circle (1.8pt) node[below] {$E$};
    \fill (2.667,2.8) circle (1.8pt) node[above] {$D$};
    \fill (6.571,2.8) circle (1.5pt);
    \draw[dotted] (2.667,2.8) -- (2.667,0);
    \draw[dotted] (6.571,2.8) -- (6.571,0);
    \draw[dotted] (4.375,2.031) -- (4.375,0);
    \node[below] at (4.375,0) {$L^*$};
    \draw[decorate, decoration={brace, amplitude=3pt}] (2.667,3.0) -- (6.571,3.0) node[midway, above=3pt] {$L^s-L^d$};
  \end{scope}
  % ---------------- (b) Monopsonio ----------------
  \begin{scope}[xshift=7.6cm]
    \node[font=\footnotesize\bfseries] at (3.8,4.45) {(b) Monopsonio};
    \draw[->] (0,0) -- (8.0,0) node[below] {$L$};
    \draw[->] (0,0) -- (0,4.1) node[left] {$w$};
    \draw[very thick] (0,0.5) -- (7.4,3.09) node[right] {$L^s$};
    \draw[very thick] (0,4) -- (7.6,0.58) node[right] {$L^d$};
    \draw[thick, dashed] (0,0.5) -- (5.0,4.0) node[above] {$CMg_L$};
    \draw[thick, dotted] (0,1.9) -- (4.0,1.9);
    \node[left] at (0,1.9) {$\underline w$};
    \fill (3.043,1.565) circle (1.8pt) node[below right] {$M$};
    \fill (3.043,2.630) circle (1.5pt);
    \draw[dotted] (3.043,2.630) -- (3.043,0);
    \node[below] at (3.043,0) {$L_M$};
    \fill (4.0,1.9) circle (1.8pt) node[below right] {$N$};
    \fill (4.375,2.031) circle (1.8pt) node[above right] {$E$};
    \draw[dotted] (0,1.565) -- (3.043,1.565);
    \node[left] at (0,1.565) {$w_M$};
  \end{scope}
\end{tikzpicture}
