% Figura (Anexo I, «Elección»): elección entre consumo y ocio. Dos paneles, en el espacio (ocio, consumo).
% Preferencias COBB-DOUGLAS U = (C ell)^(1/2); dotación T = 5; renta no laboral R = 1,5; punto de dotación E = (5; 1,5).
% (a) Solución interior: w = 0,8; recta de (5; 1,5) a (0; 5,5); tangencia en A = (3,4375; 2,75); curva C ell = 9,4531.
% (b) Solución de esquina: w = 0,15 < w_R = 0,3; recta de (5; 1,5) a (0; 2,25); curva por E, C ell = 7,5, cuya pendiente
%     en E es -w_R (recta discontinua).
% Escala: 1 unidad = 0,95 cm. Generar con: bash Code/generar_figura.sh anx_eleccion
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=0.95cm, y=0.95cm]
  % ---------------- (a) Solución interior ----------------
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (2.8,6.3) {(a) Solución interior: $w>w_R$};
    \fill[black!12] (0,0) -- (0,5.5) -- (5,1.5) -- (5,0) -- cycle;
    \draw[->] (0,0) -- (5.9,0) node[below] {$\ell$};
    \draw[->] (0,0) -- (0,6.0) node[left] {$C$};
    \draw[very thick] (0,5.5) -- (5,1.5) -- (5,0);
    \draw[thick] plot[domain=1.75:5.6, samples=80] (\x,{9.4531/\x});
    \node[right] at (5.6,{9.4531/5.6}) {$U_A$};
    \fill (5,1.5) circle (2pt) node[right] {$E$};
    \fill (3.4375,2.75) circle (2pt) node[above right] {$A$};
    \draw[dotted] (3.4375,2.75) -- (3.4375,0);
    \node[below] at (3.4375,0) {$\ell^*$};
    \node[below] at (5,0) {$T$};
    \node[left] at (0,5.5) {$wT+R$};
    \draw[decorate, decoration={brace, amplitude=4pt, mirror}] (3.4375,-0.55) -- (5,-0.55) node[midway, below=4pt] {$h^*$};
    \draw[decorate, decoration={brace, amplitude=3pt, mirror}] (5.12,0) -- (5.12,1.5) node[midway, right=3pt] {$R$};
    \node[above right, font=\scriptsize] at (1.2,4.55) {$-w$};
  \end{scope}
  % ---------------- (b) Solución de esquina ----------------
  \begin{scope}[xshift=7.2cm]
    \node[font=\footnotesize\bfseries] at (2.8,6.3) {(b) Solución de esquina: $w\le w_R$};
    \fill[black!12] (0,0) -- (0,2.25) -- (5,1.5) -- (5,0) -- cycle;
    \draw[->] (0,0) -- (5.9,0) node[below] {$\ell$};
    \draw[->] (0,0) -- (0,6.0) node[left] {$C$};
    \draw[very thick] (0,2.25) -- (5,1.5) -- (5,0);
    \draw[thick] plot[domain=1.3:5.6, samples=80] (\x,{7.5/\x});
    \node[right] at (5.6,{7.5/5.6}) {$U_E$};
    \draw[dashed] (1.3,2.61) -- (5.5,1.35);
    \fill (5,1.5) circle (2pt) node[above right] {$E$};
    \node[below] at (5,0) {$T$};
    \node[left] at (0,2.25) {$wT+R$};
    \node[above, font=\scriptsize] at (1.6,2.6) {$-w_R$};
    \node[below, font=\scriptsize] at (1.3,2.05) {$-w$};
  \end{scope}
\end{tikzpicture}
