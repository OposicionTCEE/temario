% Figura (Anexo II, «Contraste»): predicciones que distinguen el capital humano de la señal.
% (a) Efecto diploma: con capital humano (H), ln w = 1 + 0,08 S; con señal pura (D), el salario solo sube al obtener un
% título, en S_1 = 12 y S_2 = 16: escalones en 1,45 (S < 12), 2,0 (12 a 16) y 2,35 (16 a 20).
% (b) Aprendizaje de las empresas (FARBER y GIBBONS 1996; ALTONJI y PIERRET 2001; LANGE 2007): coeficiente de la escolaridad
% beta_S(X) = 0,06 + 0,04 e^{-lambda X}, que converge a su parte productiva, beta_S^H = 0,06; coeficiente de una
% característica que las empresas no observan al contratar, beta_z(X) = 0,08 (1 - e^{-lambda X}); lambda = ln 2 / 3
% (los errores de las empresas se reducen a la mitad en tres años, como en LANGE 2007).
% Escala: (a) x = 0,3 cm por año, y = 1,25 cm; (b) x = 0,2 cm por año, y = 28 cm. Generar con: bash Code/generar_figura.sh anx_senal
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  % ---------------- (a) Efecto diploma ----------------
  \begin{scope}[x=0.3cm, y=1.25cm]
    \node[font=\footnotesize\bfseries] at (10.5,3.25) {(a) Efecto diploma};
    \draw[->] (0,0) -- (21.5,0) node[below] {$S$};
    \draw[->] (0,0) -- (0,2.95) node[left] {$\ln w$};
    \draw[very thick] (0,1) -- (20,2.6) node[right] {$H$};
    \draw[very thick, dashed] (0,1.45) -- (12,1.45) -- (12,2.0) -- (16,2.0) -- (16,2.35) -- (20,2.35) node[right] {$D$};
    \draw[dotted] (12,1.45) -- (12,0);
    \draw[dotted] (16,2.0) -- (16,0);
    \node[below] at (12,0) {$S_1$};
    \node[below] at (16,0) {$S_2$};
  \end{scope}
  % ---------------- (b) Aprendizaje de las empresas ----------------
  \begin{scope}[xshift=8.0cm, x=0.2cm, y=28cm]
    \node[font=\footnotesize\bfseries] at (16,0.145) {(b) Aprendizaje de las empresas};
    \draw[->] (0,0) -- (32.5,0) node[below] {$X$};
    \draw[->] (0,0) -- (0,0.122);
    \draw[thick, dotted] (0,0.06) -- (30,0.06);
    \node[left] at (0,0.06) {$\beta_S^H$};
    \draw[very thick] plot[domain=0:30, samples=61] (\x,{0.06+0.04*exp(-0.2310*\x)}) node[right] {$\beta_S(X)$};
    \draw[very thick, dashed] plot[domain=0:30, samples=61] (\x,{0.08*(1-exp(-0.2310*\x))}) node[right] {$\beta_z(X)$};
  \end{scope}
\end{tikzpicture}
