% Figura (cuerpo, 1.1 «Demanda»): la demanda de trabajo a corto y a largo plazo, el principio de LE CHATELIER y la
% descomposición del ajuste a largo plazo en efecto sustitución y efecto escala (pedida por el usuario el 04/11/2026).
% Corto plazo con el capital inicial: w = 4,17/L (por A = (2,78; 1,5)); si el salario baja a w1 = 1,2, el empleo pasa a
% B = (3,475; 1,2). A largo plazo la demanda tiene elasticidad -3, L = 2,78 (w/1,5)^(-3), y el empleo llega a
% C = (5,43; 1,2), sobre la curva de corto plazo con el capital ya ajustado, w = 6,516/L. Demanda con la producción
% constante (condicionada), de elasticidad -1,8: L = 2,78 (w/1,5)^(-1,8), por A; en w1, S = (4,153; 1,2). Efecto
% sustitución: de A a S; efecto escala: de S a C. Curvas ilustrativas.
% Escala: x = 0,85 cm; y = 1,6 cm. Generar con: bash Code/generar_figura.sh b1_demanda
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=0.85cm, y=1.6cm]
  \draw[->] (0,0) -- (7.4,0) node[below] {$L$};
  \draw[->] (0,0) -- (0,3.3) node[left] {$w$};
  \draw[very thick] plot[domain=1.35:6.6, samples=80] (\x,{4.17/\x}) node[right] {$F_L(\bar K_0,L)$};
  \draw[thick] plot[domain=2.1:6.6, samples=80] (\x,{6.516/\x}) node[right] {$F_L(\bar K_1,L)$};
  \draw[very thick, dashed] plot[domain=1.0:6.0, samples=80] (\x,{1.5*(\x/2.78)^(-1/3)}) node[right] {$L^d$};
  \draw[thick, dash dot] plot[domain=1.6:5.0, samples=60] (\x,{1.5*(\x/2.78)^(-1/1.8)});
  \node[above] at (1.6,2.04) {$L^c(q_0)$};
  \draw[dotted] (0,1.5) -- (2.78,1.5);
  \draw[dotted] (0,1.2) -- (5.43,1.2);
  \draw[dotted] (2.78,1.5) -- (2.78,-0.22);
  \draw[dotted] (4.153,1.2) -- (4.153,-0.22);
  \draw[dotted] (5.43,1.2) -- (5.43,-0.22);
  \fill (2.78,1.5) circle (1.8pt) node[above right] {$A$};
  \fill (3.475,1.2) circle (1.8pt) node[below left] {$B$};
  \fill (4.153,1.2) circle (1.8pt) node[above] {$S$};
  \fill (5.43,1.2) circle (1.8pt) node[above right] {$C$};
  \node[left] at (0,1.5) {$w_0$};
  \node[left] at (0,1.2) {$w_1$};
  \draw[->] (2.78,-0.3) -- (4.153,-0.3) node[midway, below] {$ES$};
  \draw[->] (4.153,-0.3) -- (5.43,-0.3) node[midway, below] {$EE$};
\end{tikzpicture}
