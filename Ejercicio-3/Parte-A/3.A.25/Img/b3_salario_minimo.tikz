% Figura (cuerpo, 3.2 «Salario mínimo»): el método de CENGIZ, DUBE, LINDNER y ZIPPERER (2019), con lo que predice la
% competencia y lo que encontraron. Cambio en el número de empleos por tramo salarial tras subir el mínimo de w_ a w_'.
% Faltan empleos entre el mínimo anterior y el nuevo, F = -0,5 - 0,8 - 1,0 - 1,3 = -3,6, en los dos paneles.
% (a) Competencia: aparecen menos en el nuevo mínimo y justo encima, E = 0,9 + 0,5 + 0,3 + 0,1 = 1,8, y E + F < 0.
% (b) Evidencia: E = 1,5 + 1,1 + 0,6 + 0,4 = 3,6 (más arriba, cambios nulos), y E + F = 0. Valores ilustrativos.
% Escala: x = 0,45 cm por tramo; y = 1 cm. Generar con: bash Code/generar_figura.sh b3_salario_minimo
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=0.45cm, y=1cm]
  % ---------------- (a) Competencia ----------------
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (0.5,2.6) {(a) Competencia};
    \draw[->] (-5.2,0) -- (6.2,0) node[below] {$w$};
    \draw[->] (-5.2,-1.75) -- (-5.2,2.0) node[left] {$\Delta N$};
    \foreach \k/\v in {-4/-0.5, -3/-0.8, -2/-1.0, -1/-1.3, 0/0.9, 1/0.5, 2/0.3, 3/0.1}
      \draw[fill=gray!35] ({\k-0.4},0) rectangle ({\k+0.4},\v);
    \draw[dashed] (-0.5,-1.7) -- (-0.5,1.85);
    \draw[dotted] (-4.5,-1.7) -- (-4.5,1.85);
    \node[above] at (-0.5,1.85) {$\underline w'$};
    \node[above] at (-4.5,1.85) {$\underline w$};
    \node at (-2.5,-1.55) {$F$};
    \node at (1.3,1.15) {$E$};
    \node at (4.2,1.5) {$E+F<0$};
  \end{scope}
  % ---------------- (b) Evidencia ----------------
  \begin{scope}[xshift=6.6cm]
    \node[font=\footnotesize\bfseries] at (0.5,2.6) {(b) Evidencia};
    \draw[->] (-5.2,0) -- (6.2,0) node[below] {$w$};
    \draw[->] (-5.2,-1.75) -- (-5.2,2.0) node[left] {$\Delta N$};
    \foreach \k/\v in {-4/-0.5, -3/-0.8, -2/-1.0, -1/-1.3, 0/1.5, 1/1.1, 2/0.6, 3/0.4}
      \draw[fill=gray!35] ({\k-0.4},0) rectangle ({\k+0.4},\v);
    \draw[dashed] (-0.5,-1.7) -- (-0.5,1.85);
    \draw[dotted] (-4.5,-1.7) -- (-4.5,1.85);
    \node[above] at (-0.5,1.85) {$\underline w'$};
    \node[above] at (-4.5,1.85) {$\underline w$};
    \node at (-2.5,-1.55) {$F$};
    \node at (1.5,1.75) {$E$};
    \node at (4.4,1.0) {$E+F\approx0$};
  \end{scope}
\end{tikzpicture}
