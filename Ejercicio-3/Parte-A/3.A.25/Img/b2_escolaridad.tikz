% Figura (cuerpo, 2.2 «Escolaridad»): la decisión de estudiar. Combina anx_inversion, reducida, y el panel (b) de
% anx_escolaridad.
% (a) Perfiles por edad (BECKER 1964): sin estudios superiores w_B(t) = 1 + 0,06 (t - 18) - 0,0009 (t - 18)^2; con ellos,
%     costes directos de 0,4 entre los 18 y los 22 años y w_U(t) = 1,5 + 0,1 (t - 22) - 0,0013 (t - 22)^2 desde los 22.
%     C_d costes directos, C_o ingresos a los que se renuncia, B ganancia.
% (b) Escolaridad óptima (BECKER 1967; CARD 2001): rendimiento marginal rho_i = b_i - 0,01 S (b = 0,22 y 0,28) y coste
%     marginal i_i = r_i + 0,002 S (r = 0,04 y 0,10): A = (15; 0,07), B = (10; 0,12), C = (20; 0,08), D = (15; 0,13).
% Escala: (a) x = 0,12 cm por año, y = 1 cm; (b) x = 0,27 cm por año, y = 15 cm. Generar con: bash Code/generar_figura.sh b2_escolaridad
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  % ---------------- (a) Costes y beneficios ----------------
  \begin{scope}[x=0.12cm, y=1cm]
    \node[font=\footnotesize\bfseries] at (42,4.5) {(a) Costes y beneficios};
    \fill[black!25] (18,0) rectangle (22,-0.4);
    \fill[black!10] (18,0) -- plot[domain=18:22, samples=20] (\x,{1+0.06*(\x-18)-0.0009*(\x-18)^2}) -- (22,0) -- cycle;
    \fill[black!15] plot[domain=22:65, samples=80] (\x,{1.5+0.1*(\x-22)-0.0013*(\x-22)^2}) -- plot[domain=65:22, samples=80] (\x,{1+0.06*(\x-18)-0.0009*(\x-18)^2}) -- cycle;
    \draw[->] (16,0) -- (69,0) node[below] {$t$};
    \draw[->] (16,-0.7) -- (16,4.0) node[left] {$w$};
    \draw[very thick] plot[domain=18:65, samples=80] (\x,{1+0.06*(\x-18)-0.0009*(\x-18)^2}) node[right] {$w_B$};
    \draw[very thick] (18,-0.4) -- (22,-0.4) -- (22,1.5);
    \draw[very thick] plot[domain=22:65, samples=80] (\x,{1.5+0.1*(\x-22)-0.0013*(\x-22)^2}) node[right] {$w_U$};
    \node[font=\scriptsize] at (20,-0.2) {$C_d$};
    \node[font=\scriptsize] at (20,0.5) {$C_o$};
    \node at (45,2.35) {$B$};
    \draw[dotted] (22,-0.4) -- (22,-0.7);
    \node[below] at (22,-0.7) {$S$};
  \end{scope}
  % ---------------- (b) Capacidad y financiación ----------------
  \begin{scope}[xshift=8.6cm, x=0.27cm, y=15cm]
    \node[font=\footnotesize\bfseries] at (11,0.3) {(b) Capacidad y financiación};
    \draw[->] (0,0) -- (23.5,0) node[below] {$S$};
    \draw[->] (0,0) -- (0,0.29);
    \draw[very thick] (0,0.22) -- (22,0.0) node[above right] {$\rho_1$};
    \draw[very thick] (0,0.28) -- (22,0.06) node[right] {$\rho_2$};
    \draw[very thick, dashed] (0,0.04) -- (22,0.084) node[right] {$i_1$};
    \draw[very thick, dashed] (0,0.10) -- (22,0.144) node[right] {$i_2$};
    \fill (15,0.07) circle (1.8pt) node[below] {$A$};
    \fill (10,0.12) circle (1.8pt) node[above] {$B$};
    \fill (20,0.08) circle (1.8pt) node[below] {$C$};
    \fill (15,0.13) circle (1.8pt) node[above] {$D$};
  \end{scope}
\end{tikzpicture}
