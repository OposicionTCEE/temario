\begin{tikzpicture}[xscale=1.42,yscale=1.42,font=\footnotesize]

% Optimo del consumidor en dos fechas contiguas (version del cuerpo)
%   Dotacion E=(3,2; 0,6) ; 1+r = 1,25 ; recta  c_{t+1} = 4,6 - 1,25 c_t
%   Utilidad logaritmica con beta=1 -> optimo C* = (1,84; 2,30)
%   Curva de indiferencia tangente: c_{t+1} = 4,232 / c_t
%   Se anade el rayo de 45 grados (escalas iguales), que no esta en la figura del anexo

  \draw[->,thick] (0,0) -- (4.35,0) node[right] {$c_t$};
  \draw[->,thick] (0,0) -- (0,5.1) node[above] {$c_{t+1}$};

  % rayo de 45 grados
  \draw[thin,gray,dash pattern=on 2pt off 2pt] (0,0) -- (4.1,4.1);
  \node[gray,above left] at (4.12,4.1) {$45^{\circ}$};

  % restriccion presupuestaria
  \draw[very thick] (0,4.6) -- (3.68,0);
  \node[right,align=left] at (3.1,0.78) {pendiente\\$-(1+r)$};

  % curva de indiferencia
  \draw[very thick,dash pattern=on 4pt off 2pt,domain=0.93:4.15,samples=100,smooth,variable=\x]
       plot ({\x},{4.232/\x});
  \node[above right] at (0.95,{4.232/0.95}) {$u^{*}$};

  % dotacion
  \node[circle,fill,inner sep=1.5pt] at (3.2,0.6) {};
  \node[above right] at (3.24,0.62) {$E$};
  \draw[dotted,gray] (3.2,0) -- (3.2,0.6) -- (0,0.6);
  \node[below] at (3.2,-0.1) {$w_t$};
  \node[left] at (0,0.6) {$w_{t+1}$};

  % optimo
  \node[circle,fill,inner sep=1.5pt] at (1.84,2.3) {};
  \node[above right] at (1.89,2.33) {$C^{*}$};
  \draw[dotted,gray] (1.84,0) -- (1.84,2.3) -- (0,2.3);
  \node[below] at (1.84,-0.1) {$c_t^{*}$};
  \node[left] at (0,2.3) {$c_{t+1}^{*}$};

\end{tikzpicture}
