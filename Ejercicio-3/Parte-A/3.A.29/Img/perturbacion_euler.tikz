\begin{tikzpicture}[scale=1,font=\footnotesize]

  \draw[->,thick] (0,0) -- (9.3,0) node[right] {fecha};
  \draw[->,thick] (0,0) -- (0,4.5) node[above] {$c$};

  % fechas
  \foreach \i/\lab in {1/{$t-2$},2.4/{$t-1$},3.8/{$t$},5.2/{$t+1$},6.6/{$t+2$},8/{$t+3$}}{
    \draw[dotted,gray] (\i,0) -- (\i,3.9);
    \node[below] at (\i,-0.08) {\lab};
  }

  % senda optima: valores en cada fecha
  \def\ca{1.95}\def\cb{2.25}\def\cc{2.55}\def\cd{2.85}\def\ce{3.15}\def\cf{3.45}
  \draw[very thick] (1,\ca) -- (2.4,\cb) -- (3.8,\cc) -- (5.2,\cd) -- (6.6,\ce) -- (8,\cf);
  \foreach \i/\v in {1/\ca,2.4/\cb,3.8/\cc,5.2/\cd,6.6/\ce,8/\cf}{\fill (\i,\v) circle (2pt);}
  \node[above left] at (8,\cf) {$c^{*}$};

  % senda perturbada: solo en t y t+1
  \draw[very thick,dash pattern=on 4pt off 2pt] (2.4,\cb) -- (3.8,1.75) -- (5.2,3.45) -- (6.6,\ce);
  \draw[fill=white,very thick] (3.8,1.75) circle (2pt);
  \draw[fill=white,very thick] (5.2,3.45) circle (2pt);

  % magnitudes de la perturbacion
  \draw[<->,thick] (4.05,\cc) -- (4.05,1.75);
  \node[right] at (4.15,2.15) {$\varepsilon$};
  \draw[<->,thick] (5.45,\cd) -- (5.45,3.45);
  \node[right] at (5.55,3.15) {$(1+r)\,\varepsilon$};

\end{tikzpicture}
