\begin{tikzpicture}[xscale=1.30,yscale=1.75,font=\footnotesize]

% Diagrama de fases del modelo de RAMSEY-CASS-KOOPMANS, sobre la MISMA base que la figura
% de la regla de oro: la ceroclina de k es c = f(k) - (n+delta) k, con f(k)=2,2 k^0,4
% Ceroclina de c: vertical en k* donde f'(k*) = rho+delta = 0,75  ->  k* = 1,31
% Regla de oro en k = 2,57 (a la derecha de k*: la economia nunca sobreacumula)
% Senda de silla: por debajo de la ceroclina a la izquierda de E y por encima a su derecha

  \draw[->,thick] (0,0) -- (4.5,0) node[right] {$k$};
  \draw[->,thick] (0,0) -- (0,2.75) node[above] {$c$};

  % ceroclina del capital
  \draw[very thick,domain=0.05:4.25,samples=160,smooth,variable=\x]
       plot ({\x},{2.2*pow(\x,0.4)-0.5*\x});
  \node[below right] at (3.45,{2.2*pow(3.45,0.4)-0.5*3.45-0.02}) {$\dot k=0$};

  % ceroclina del consumo
  \draw[very thick] (1.306,0) -- (1.306,2.60);
  \node[above] at (1.306,2.60) {$\dot c=0$};

  % estado estacionario
  \node[circle,fill,inner sep=1.4pt] at (1.306,1.790) {};
  \node[above right] at (1.35,1.80) {$E$};
  \draw[dotted,gray] (0,1.790) -- (1.306,1.790);
  \node[left] at (0,1.790) {$c^{*}$};
  \node[below] at (1.306,-0.06) {$k^{*}$};

  % regla de oro
  \draw[dotted,gray] (2.566,0) -- (2.566,1.912);
  \node[below] at (2.566,-0.06) {$k_{\text{oro}}$};

  % senda de silla
  \draw[very thick,dash pattern=on 4pt off 2pt,smooth]
       plot coordinates {(0.25,0.95) (0.70,1.45) (1.306,1.790) (2.00,2.05) (2.80,2.25) (3.70,2.43)};
  \node[right] at (3.72,2.43) {senda de silla};

  % trayectorias divergentes
  \draw[thin,dash pattern=on 2pt off 2pt,smooth]
       plot coordinates {(0.70,1.58) (1.20,1.95) (1.55,2.35) (1.72,2.68)};
  \draw[thin,dash pattern=on 2pt off 2pt,smooth]
       plot coordinates {(0.70,1.33) (1.30,1.55) (2.10,1.45) (2.90,1.00) (3.40,0.40)};

\end{tikzpicture}
