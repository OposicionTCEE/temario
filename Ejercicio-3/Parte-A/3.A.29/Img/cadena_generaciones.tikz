\begin{tikzpicture}[font=\footnotesize,xscale=1.75,yscale=0.88]

% Cada generacion vive dos fechas: joven (J) en la primera, viejo (V) en la segunda.
% G0 es la generacion inicial, que solo vive la vejez.
% Las flechas verticales son la transferencia delta del joven al viejo de cada fecha.

  % ---- eje de fechas ----
  \draw[->,thick] (0.3,-0.75) -- (6.1,-0.75) node[right] {tiempo};
  \foreach \x/\lab in {1/$t$,2/{$t+1$},3/{$t+2$},4/{$t+3$},5/{$t+4$}}{
     \draw (\x,-0.68) -- (\x,-0.82);
     \node[below] at (\x,-0.84) {\lab};}

  % ---- generaciones ----
  % G0: solo vejez, en t
  \draw[very thick,fill=black!7,rounded corners=2pt] (0.72,3.72) rectangle (1.28,4.22);
  \node at (1,3.97) {$V$};
  \node[left] at (0.66,3.97) {$G_{0}$};

  % G1 .. G4
  \foreach \i/\y/\xj in {1/3.0/1, 2/2.25/2, 3/1.5/3, 4/0.75/4}{
     \draw[very thick,fill=black!3,rounded corners=2pt] (\xj-0.28,\y-0.25) rectangle (\xj+1+0.28,\y+0.25);
     \node at (\xj,\y) {$J$};
     \node at (\xj+1,\y) {$V$};
     \node[left] at (\xj-0.34,\y) {$G_{\i}$};}

  % ---- transferencias: del joven de cada fecha al viejo de esa fecha ----
  \draw[-{Stealth[length=5pt]},very thick] (1,3.3) -- (1,3.66);
  \node[right] at (1.06,3.48) {$\delta$};
  \foreach \x/\yb/\ya in {2/2.55/2.72, 3/1.8/1.97, 4/1.05/1.22}{
     \draw[-{Stealth[length=5pt]},very thick] (\x,\yb) -- (\x,\ya);
     \node[right] at (\x+0.06,{(\yb+\ya)/2}) {$\delta$};}

  % ---- continuacion ----
  \node at (5.55,0.35) {$\ddots$};
  \draw[dotted,very thick] (5.05,0.62) -- (5.42,0.45);

\end{tikzpicture}
