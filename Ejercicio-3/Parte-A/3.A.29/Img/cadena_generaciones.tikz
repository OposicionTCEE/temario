\begin{tikzpicture}[font=\footnotesize,xscale=1.75,yscale=0.80]

% Cada generacion vive dos fechas: joven (J) en la primera, viejo (V) en la segunda.
% G0 es la generacion inicial, que solo vive la vejez.
% Las flechas verticales son la transferencia delta del joven al viejo de cada fecha.

  % ---- eje de fechas ----
  \draw[->,thick] (0.3,-1.35) -- (6.3,-1.35) node[right] {tiempo};
  \foreach \x/\lab in {1/$t$,2/{$t+1$},3/{$t+2$},4/{$t+3$},5/{$t+4$}}{
     \draw (\x,-1.27) -- (\x,-1.43);
     \node[below] at (\x,-1.45) {\lab};}

  % ---- generaciones ----
  % G0: solo vejez, en t
  \draw[very thick,fill=black!7,rounded corners=2pt] (0.74,4.18) rectangle (1.26,4.62);
  \node at (1,4.40) {$V$};
  \node[left] at (0.68,4.40) {$G_{0}$};

  % G1 .. G4
  \foreach \i/\y/\xj in {1/3.3/1, 2/2.2/2, 3/1.1/3, 4/0.0/4}{
     \draw[very thick,fill=black!3,rounded corners=2pt] (\xj-0.26,\y-0.22) rectangle (\xj+1.26,\y+0.22);
     \node at (\xj,\y) {$J$};
     \node at (\xj+1,\y) {$V$};
     \node[left] at (\xj-0.32,\y) {$G_{\i}$};}

  % ---- transferencias: del joven de cada fecha al viejo de esa fecha ----
  \foreach \x/\yb/\ya in {1/3.54/4.14, 2/2.44/3.04, 3/1.34/1.94, 4/0.24/0.84}{
     \draw[-{Stealth[length=5pt]},very thick] (\x,\yb) -- (\x,\ya);
     \node[right] at (\x+0.07,{(\yb+\ya)/2}) {$\delta$};}

  % ---- continuacion ----
  \draw[dotted,very thick] (5.40,-0.22) -- (5.68,-0.48);
  \node at (5.88,-0.68) {$\ddots$};

\end{tikzpicture}
