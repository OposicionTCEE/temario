\begin{tikzpicture}[font=\footnotesize,
   caja/.style={draw,very thick,rounded corners=2pt,align=center,inner sep=3pt,
                minimum width=3.55cm,minimum height=1.75cm},
   fl/.style={-{Stealth[length=6pt]},very thick}]

% Las cuatro aproximaciones por radicalidad creciente y el canje que cada una acepta
% Todas las coordenadas son positivas: con coordenadas negativas el envoltorio recorta la figura
% Un \\ dentro de un grupo {\scriptsize ...} genera un PDF en blanco: una llave por linea

  \node[caja] (a) at (1.78,0)  {\textbf{Agentes heterogéneos}\\{\scriptsize cae la agregación}};
  \node[caja] (b) at (5.66,0)  {\textbf{Juegos dinámicos}\\{\scriptsize cae el precio-aceptante}};
  \node[caja] (c) at (9.54,0)  {\textbf{Aprendizaje}\\{\scriptsize cae el conocimiento}\\{\scriptsize del modelo}};
  \node[caja] (d) at (13.42,0) {\textbf{Simulación}\\{\scriptsize caen optimización,}\\{\scriptsize equilibrio y ergodicidad}};

  \draw[fl] (0.10,1.65) -- (15.10,1.65);
  \node[above] at (7.60,1.70) {más fenómenos representables};

  \draw[fl] (15.10,-1.65) -- (0.10,-1.65);
  \node[below] at (7.60,-1.70) {más se puede demostrar};

\end{tikzpicture}
