\begin{tikzpicture}[font=\footnotesize,
   caja/.style={draw,very thick,rounded corners=2pt,align=center,inner sep=5pt,
                minimum width=4.5cm,minimum height=1.45cm},
   fl/.style={-{Stealth[length=6pt]},very thick}]

% Las tres aproximaciones por radicalidad creciente y el canje que cada una acepta
% Todas las coordenadas son positivas: con coordenadas negativas el envoltorio recorta la figura

  \node[caja] (a) at (2.55,0)  {\textbf{Agentes heterogéneos}\\{\scriptsize cae la agregación}};
  \node[caja] (b) at (7.65,0)  {\textbf{Juegos dinámicos}\\{\scriptsize cae el precio-aceptante}};
  \node[caja] (c) at (12.75,0) {\textbf{Simulación}\\{\scriptsize caen optimización,\\equilibrio y ergodicidad}};

  \draw[fl] (0.1,1.45) -- (15.2,1.45);
  \node[above] at (7.65,1.5) {más fenómenos representables};

  \draw[fl] (15.2,-1.45) -- (0.1,-1.45);
  \node[below] at (7.65,-1.5) {más se puede demostrar};

\end{tikzpicture}
