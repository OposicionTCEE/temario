   caja/.style={draw,very thick,rounded corners=2pt,align=center,inner sep=5pt,
                minimum width=4.5cm,minimum height=1.45cm},
   fl/.style={-{Stealth[length=6pt]},very thick}]

% Las tres aproximaciones por radicalidad creciente y el canje que cada una acepta

  \node[caja] (a) at (0,0)   {\textbf{Agentes heterogéneos}\\{\scriptsize cae la agregación}};
  \node[caja] (b) at (5.1,0) {\textbf{Juegos dinámicos}\\{\scriptsize cae el precio-aceptante}};
  \node[caja] (c) at (10.2,0){\textbf{Simulación}\\{\scriptsize caen optimización,\\equilibrio y ergodicidad}};

  \draw[fl] (-2.45,1.45) -- (12.65,1.45);
  \node[above] at (5.1,1.5) {más fenómenos representables};

  \draw[fl] (12.65,-1.45) -- (-2.45,-1.45);
  \node[below] at (5.1,-1.5) {más se puede demostrar};

