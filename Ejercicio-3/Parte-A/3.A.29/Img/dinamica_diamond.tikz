\begin{tikzpicture}[xscale=2.4,yscale=2.4,font=\footnotesize]

% Dinamica k_{t+1} = phi(k_t) = 1,6 k_t^0,4 ; corta la diagonal en k* = 2,188
% Regla de oro situada a la izquierda (k_oro = 1,4): economia dinamicamente ineficiente
% Escalera de convergencia desde k_0 = 0,6

  \draw[->,thick] (0,0) -- (3.35,0) node[right] {$k_t$};
  \draw[->,thick] (0,0) -- (0,3.35) node[above] {$k_{t+1}$};

  % diagonal
  \draw[thick,dash pattern=on 2pt off 2pt] (0,0) -- (3.15,3.15);
  \node[above left] at (3.12,3.12) {$45^{\circ}$};

  % funcion de transicion
  \draw[very thick,domain=0.02:3.2,samples=160,smooth,variable=\x]
       plot ({\x},{1.6*pow(\x,0.4)});
  \node[below right] at (3.0,{1.6*pow(3.0,0.4)-0.05}) {$\varphi(k_t)$};

  % estado estacionario
  \node[circle,fill,inner sep=1.4pt] at (2.188,2.188) {};
  \draw[dotted,gray] (2.188,0) -- (2.188,2.188);
  \node[below] at (2.188,-0.07) {$k^{*}$};

  % regla de oro
  \draw[dotted,gray] (1.4,0) -- (1.4,1.4);
  \node[circle,draw,very thick,fill=white,inner sep=1.1pt] at (1.4,1.4) {};
  \node[below] at (1.4,-0.07) {$k_{\text{oro}}$};

  % escalera de convergencia desde k_0
  \draw[thick,gray] (0.6,0) -- (0.6,1.304) -- (1.304,1.304) -- (1.304,1.779)
                 -- (1.779,1.779) -- (1.779,2.013) -- (2.013,2.013) -- (2.013,2.117);
  \node[below] at (0.6,-0.07) {$k_0$};

\end{tikzpicture}
