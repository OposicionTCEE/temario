\begin{tikzpicture}[xscale=1.85,yscale=1.02,font=\footnotesize,
   fl/.style={-{Stealth[length=5pt]},thick}]

% El mapa T y el principio de E-estabilidad.
% T(phi) = phi + 0,25 (phi-1)(phi-3,5): corta la diagonal en phi=1 (pendiente 0,375 < 1)
% y en phi=3,5 (pendiente 1,625 > 1). Las flechas del eje dan el signo de T(phi)-phi.
% Todas las coordenadas en x son positivas: con coordenadas negativas el envoltorio recorta la figura.

  \draw[->,thick] (0,0) -- (4.95,0) node[below right] {$\phi$};
  \draw[->,thick] (0,0) -- (0,5.75);
  \node[above right] at (0,5.65) {$T(\phi)$};

  % diagonal
  \draw[thick,dash pattern=on 3pt off 2.5pt,gray] (0,0) -- (5.15,5.15);
  \node[right,gray] at (4.6,4.75) {$45^{\circ}$};

  % el mapa T
  \draw[very thick,domain=0:4.55,samples=160,smooth,variable=\x]
       plot ({\x},{\x+0.25*(\x-1)*(\x-3.5)});
  \node[above left] at (4.5,{4.5+0.25*3.5*1}) {$T(\phi)$};

  % puntos fijos
  \draw[dotted,gray] (1,0) -- (1,1);
  \draw[dotted,gray] (3.5,0) -- (3.5,3.5);
  \node[circle,fill,inner sep=1.5pt] at (1,1) {};
  \node[circle,fill,inner sep=1.5pt] at (3.5,3.5) {};
  \node[below] at (1,-0.12) {$\bar{\phi}_{1}$};
  \node[below] at (3.5,-0.12) {$\bar{\phi}_{2}$};
  \node[below] at (1,-0.62) {E-estable};
  \node[below] at (3.5,-0.62) {no E-estable};

  % direccion del aprendizaje: signo de T(phi) - phi
  \draw[fl] (0.20,-0.33) -- (0.80,-0.33);
  \draw[fl] (3.30,-0.33) -- (1.20,-0.33);
  \draw[fl] (3.70,-0.33) -- (4.55,-0.33);

\end{tikzpicture}
