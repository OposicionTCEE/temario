\begin{tikzpicture}[font=\footnotesize,
   caja/.style={draw,very thick,rounded corners=2pt,align=center,inner sep=5pt},
   met/.style={caja,minimum width=4.1cm,minimum height=1.05cm},
   flecha/.style={-{Stealth[length=6pt]},very thick}]

% Los tres metodos y el objeto comun que calculan

  \node[met] (lag) at (0,2.9)  {LAGRANGE\\{\scriptsize multiplicador $\lambda_t$}};
  \node[met] (pon) at (0,1.45) {PONTRYAGIN\\{\scriptsize coestado $\mu(t)$}};
  \node[met] (bel) at (0,0)    {BELLMAN\\{\scriptsize derivada $V'(a_t)$}};

  \node[caja,minimum width=3.3cm,minimum height=1.45cm] (sombra) at (5.9,1.45)
       {Precio sombra\\del estado};

  \node[caja,minimum width=3.4cm,minimum height=1.45cm] (cond) at (11.0,1.45)
       {Condición de EULER\\y transversalidad};

  \draw[flecha] (lag.east) -- (sombra.west);
  \draw[flecha] (pon.east) -- (sombra.west);
  \draw[flecha] (bel.east) -- (sombra.west);
  \draw[flecha] (sombra.east) -- (cond.west);

\end{tikzpicture}
