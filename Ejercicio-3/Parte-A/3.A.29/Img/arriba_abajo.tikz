\begin{tikzpicture}[font=\footnotesize,
   caja/.style={draw,very thick,rounded corners=2pt,align=center,inner sep=4pt},
   ag/.style={caja,minimum width=1.5cm,minimum height=0.72cm},
   fl/.style={-{Stealth[length=5pt]},very thick}]

% Las dos arquitecturas, una frente a otra
%   (a) canonica: un agente representativo del que salen las variables agregadas
%   (b) basada en agentes: agentes heterogeneos -> protocolos -> agregados -> realimentacion

% ============ (a) El marco canonico ============
\begin{scope}
  \node at (2.1,3.95) {\textbf{(a) Marco canónico}};
  \node[caja,minimum width=3.4cm,minimum height=0.9cm] (rep) at (2.1,0.25)
       {Agente representativo};
  \node[caja,minimum width=3.4cm,minimum height=0.9cm] (mac) at (2.1,3.0)
       {Variables agregadas};
  \draw[fl] (rep) -- (mac);
\end{scope}

% ============ (b) El enfoque basado en agentes ============
\begin{scope}[xshift=6.3cm]
  \node at (3.3,3.95) {\textbf{(b) Enfoque basado en agentes}};

  \node[ag] (h1) at (0.5,0) {$a_1$};
  \node[ag] (h2) at (2.4,0) {$a_2$};
  \node[ag] (h3) at (4.3,0) {$\cdots$};
  \node[ag] (h4) at (6.2,0) {$a_n$};

  \node[caja,minimum width=6.6cm,minimum height=0.72cm] (prot) at (3.35,1.5)
       {Protocolos de mercado};
  \node[caja,minimum width=6.6cm,minimum height=0.72cm] (mac2) at (3.35,3.0)
       {Variables agregadas};

  \foreach \n in {h1,h2,h3,h4}{\draw[fl] (\n) -- (\n |- prot.south);}
  \draw[fl] (prot) -- (mac2);

  % realimentacion
  \draw[very thick] (mac2.east) -- (7.3,3.0) -- (7.3,-1.25) -- (-0.55,-1.25);
  \node[right,align=left] at (7.38,0.9) {realimentación};
  \foreach \n in {h1,h2,h3,h4}{\draw[fl] (\n.south |- 0,-1.25) -- (\n.south);}
\end{scope}

\end{tikzpicture}
