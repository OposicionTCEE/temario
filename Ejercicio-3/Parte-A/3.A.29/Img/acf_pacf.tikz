\begin{tikzpicture}[font=\footnotesize]

% Valores teoricos exactos, con phi = 0,7 en el AR(1) y theta = 0,7 en el MA(1)
%   AR(1):  ACF  rho(h) = 0,7^h            PACF  phi_11 = 0,7 y cero despues
%   MA(1):  ACF  rho(1) = th/(1+th^2)      PACF  phi_hh = -(-th)^h (1-th^2)/(1-th^(2h+2))

\newcommand{\panelejes}[1]{%
  \draw[thick] (0,0) -- (8.2,0);
  \draw[thick] (0,-0.62) -- (0,1.18);
  \foreach \y in {-0.5,0.5,1} {\draw (0,\y) -- (-0.12,\y);}
  \node[left] at (-0.14,1) {$1$};
  \node[left] at (-0.14,0.5) {$0{,}5$};
  \node[left] at (-0.14,0) {$0$};
  \node[left] at (-0.14,-0.5) {$-0{,}5$};
  \node at (4.1,1.5) {\textbf{#1}};
}

% ---------------- fila 1: ACF ----------------
\begin{scope}[xscale=0.40,yscale=1.95]
  \panelejes{ACF de un AR(1)}
  \foreach \h/\v in {1/0.700,2/0.490,3/0.343,4/0.240,5/0.168,6/0.118,7/0.082}{
    \draw[very thick] (\h,0) -- (\h,\v);
    \node[circle,fill,inner sep=0.9pt] at (\h,\v) {};
    \node[below] at (\h,-0.62) {$\h$};}
\end{scope}

\begin{scope}[xshift=5.6cm,xscale=0.40,yscale=1.95]
  \panelejes{ACF de un MA(1)}
  \draw[very thick] (1,0) -- (1,0.470);
  \node[circle,fill,inner sep=0.9pt] at (1,0.470) {};
  \foreach \h in {2,...,7}{\node[circle,fill,inner sep=0.9pt] at (\h,0) {};}
  \foreach \h in {1,...,7}{\node[below] at (\h,-0.62) {$\h$};}
\end{scope}

% ---------------- fila 2: PACF ----------------
\begin{scope}[yshift=-5.0cm,xscale=0.40,yscale=1.95]
  \panelejes{PACF de un AR(1)}
  \draw[very thick] (1,0) -- (1,0.700);
  \node[circle,fill,inner sep=0.9pt] at (1,0.700) {};
  \foreach \h in {2,...,7}{\node[circle,fill,inner sep=0.9pt] at (\h,0) {};}
  \foreach \h in {1,...,7}{\node[below] at (\h,-0.62) {$\h$};}
  \node at (4.1,-1.08) {retardo $h$};
\end{scope}

\begin{scope}[xshift=5.6cm,yshift=-5.0cm,xscale=0.40,yscale=1.95]
  \panelejes{PACF de un MA(1)}
  \foreach \h/\v in {1/0.470,2/-0.283,3/0.186,4/-0.126,5/0.087,6/-0.060,7/0.042}{
    \draw[very thick] (\h,0) -- (\h,\v);
    \node[circle,fill,inner sep=0.9pt] at (\h,\v) {};
    \node[below] at (\h,-0.62) {$\h$};}
  \node at (4.1,-1.08) {retardo $h$};
\end{scope}

\end{tikzpicture}
