\begin{tikzpicture}[scale=1,font=\footnotesize]

% ================= PANEL (a): funciones de descuento =================
\begin{scope}
  \draw[->,thick] (0,0) -- (7.5,0) node[right] {$t$};
  \draw[->,thick] (0,0) -- (0,4.7) node[above] {$D(t)$};
  \node at (3.6,5.25) {\textbf{(a) La forma del descuento}};

  \draw[dashed,gray] (0,4) -- (7.2,4);
  \node[left] at (0,4) {$1$};
  \node[below left] at (0,0) {$0$};

  % exponencial D = 0,85^t   (4 unidades de alto = 1)
  \draw[very thick,domain=0:7.1,samples=90,smooth,variable=\x] plot ({\x},{4*pow(0.85,\x)});
  \draw[gray] (7.1,{4*pow(0.85,7.1)}) -- (7.45,{4*pow(0.85,7.1)});
  \node[right] at (7.5,{4*pow(0.85,7.1)}) {Exponencial, $\beta^{t}$};

  % hiperbolica D = 1/(1+kt)
  \draw[very thick,dash pattern=on 4pt off 2pt,domain=0:7.1,samples=90,smooth,variable=\x]
       plot ({\x},{4/(1+0.9*\x)});
  \draw[gray] (7.1,{4/(1+0.9*7.1)}) -- (7.45,{4/(1+0.9*7.1)});
  \node[right] at (7.5,{4/(1+0.9*7.1)}) {Hiperbólica, $1/(1+kt)$};

  % cuasi-hiperbolica: 1 en t=0 y despues beta*delta^t
  \fill (0,4) circle (1.7pt);
  \draw[very thick,dotted,domain=0:7.1,samples=90,smooth,variable=\x]
       plot ({\x},{4*0.65*pow(0.97,\x)});
  \fill (0,2.6) circle (1.7pt);
  \draw[gray] (7.1,{4*0.65*pow(0.97,7.1)}) -- (7.45,{4*0.65*pow(0.97,7.1)});
  \node[right] at (7.5,{4*0.65*pow(0.97,7.1)}) {Cuasi-hiperbólica, $\beta\delta^{t}$};

  \draw[<->] (-0.7,3.98) -- (-0.7,2.62);
  \node[left,align=right] at (-0.75,3.3) {salto\\$\beta$};

  \node[align=left,anchor=north west] at (-0.3,-0.55)
    {El exponencial cae a tasa constante: la distancia al presente no importa.\\
     Los otros dos castigan mucho el futuro inmediato y poco el lejano.};
\end{scope}

% ================= PANEL (b): reversion de preferencias =================
\begin{scope}[xshift=12.6cm]
  \draw[->,thick] (0,0) -- (7.5,0) node[right] {demora $d$ de las dos fechas};
  \draw[->,thick] (0,0) -- (0,4.7) node[above] {valor hoy};
  \node at (3.6,5.25) {\textbf{(b) La reversión de preferencias}};

  % A: premio pequeno cobrado en d        -> 3,9/(1+0,6 d)
  % B: premio grande cobrado en d+1       -> 5,2/(1+0,6(d+1))
  \draw[very thick,domain=0:7.1,samples=90,smooth,variable=\x] plot ({\x},{3.9/(1+0.6*\x)});
  \draw[gray] (7.1,{3.9/(1+0.6*7.1)}) -- (7.45,{3.9/(1+0.6*7.1)});
  \node[right] at (7.5,{3.9/(1+0.6*7.1)}) {$A$: pequeño y pronto};

  \draw[very thick,dash pattern=on 4pt off 2pt,domain=0:7.1,samples=90,smooth,variable=\x]
       plot ({\x},{5.2/(1+0.6*(\x+1))});
  \draw[gray] (7.1,{5.2/(1+0.6*8.1)}) -- (7.45,{5.2/(1+0.6*8.1)});
  \node[right] at (7.5,{5.2/(1+0.6*8.1)}) {$B$: grande y tardío};

  % cruce en d = 4/3
  \draw[dotted,gray] (1.333,0) -- (1.333,2.167);
  \fill (1.333,2.167) circle (2pt);
  \node[above right,align=left] at (1.42,2.22) {punto de reversión};

  % comparacion cerca del presente (d = 0)
  \fill (0,3.9) circle (1.9pt);
  \fill (0,3.25) circle (1.9pt);
  \draw[<->,thick] (0.3,3.9) -- (0.3,3.25);
  \node[right,align=left] at (0.42,3.55) {hoy, $A$ vale más: se elige $A$};

  % comparacion lejos del presente (d = 4,5)
  \draw[dotted,gray] (4.5,0) -- (4.5,1.39);
  \fill (4.5,{3.9/(1+0.6*4.5)}) circle (1.9pt);
  \fill (4.5,{5.2/(1+0.6*5.5)}) circle (1.9pt);
  \draw[<->,thick] (4.8,{3.9/(1+0.6*4.5)}) -- (4.8,{5.2/(1+0.6*5.5)});
  \node[right,align=left] at (4.92,1.3) {alejando las dos fechas por igual,\\$B$ vale más: se elige $B$};

  \node[align=left,anchor=north west] at (-0.3,-0.55)
    {El intervalo entre $A$ y $B$ es siempre el mismo y solo cambia su distancia\\
     al presente: con descuento exponencial las dos curvas nunca se cruzarían.};
\end{scope}

\end{tikzpicture}
