\begin{tikzpicture}[scale=1,font=\footnotesize]

% ================= PANEL (a): funciones de descuento =================
\begin{scope}
  \draw[->,thick] (0,0) -- (7.4,0) node[right] {$t$};
  \draw[->,thick] (0,0) -- (0,4.6) node[above] {$D(t)$};
  \node at (3.7,5.1) {\textbf{(a) La forma del descuento}};

  \draw[dashed,gray] (0,4) -- (7.1,4);
  \node[left] at (0,4) {$1$};
  \node[below left] at (0,0) {$0$};

  % exponencial D=0.85^t  (escala: 4 unidades = 1)
  \draw[very thick,domain=0:7,samples=80,smooth,variable=\x] plot ({\x},{4*pow(0.85,\x)});
  \node[right,align=left] at (5.0,1.95) {Exponencial\\$\beta^t$};

  % hiperbólica D=1/(1+0.9t)
  \draw[very thick,dash pattern=on 4pt off 2pt,domain=0:7,samples=80,smooth,variable=\x]
       plot ({\x},{4/(1+0.9*\x)});
  \node[right,align=left] at (4.6,0.45) {Hiperbólica\\$1/(1+kt)$};

  % cuasi-hiperbólica beta-delta: 1 en t=0, luego 0.65*0.97^t
  \fill (0,4) circle (1.6pt);
  \draw[very thick,dotted,domain=0.0:7,samples=80,smooth,variable=\x]
       plot ({\x},{4*0.65*pow(0.97,\x)});
  \draw[very thick,dotted] (0,4) -- (0,2.6);
  \fill (0,2.6) circle (1.6pt);
  \draw[<->] (-0.55,4) -- (-0.55,2.6);
  \node[left,align=right] at (-0.6,3.3) {salto\\$\beta$};
  \node[right,align=left] at (4.3,2.55) {Cuasi-hiperbólica\\$\beta\delta^t$};

  \node[align=left,anchor=north west] at (0.15,-0.45)
    {El descuento exponencial cae a tasa constante: el calendario no importa.\\
     Los otros dos castigan mucho el futuro inmediato y poco el lejano.};
\end{scope}

% ================= PANEL (b): reversión de preferencias =================
\begin{scope}[xshift=9.6cm]
  \draw[->,thick] (0,0) -- (7.4,0) node[right] {fecha de cobro};
  \draw[->,thick] (0,0) -- (0,4.6) node[above] {valor hoy};
  \node at (3.7,5.1) {\textbf{(b) La reversión de preferencias}};

  % premio pequeno A en t=0 y en t=T ; premio grande B en t=1 y en T+1
  % curvas de valor descontado hiperbolico de A (menor) y B (mayor)
  \draw[very thick,domain=0:7,samples=90,smooth,variable=\x]
       plot ({\x},{3.4/(1+1.3*\x)});
  \node[right] at (7.0,{3.4/(1+1.3*7)+0.25}) {$A$};
  \draw[very thick,dash pattern=on 4pt off 2pt,domain=0:7,samples=90,smooth,variable=\x]
       plot ({\x},{4.3/(1+1.3*\x)});
  \node[right] at (7.0,{4.3/(1+1.3*7)-0.22}) {$B$};

  % corto plazo: A en 0, B en 0.6
  \draw[dotted,gray] (0,0) -- (0,3.4);
  \fill (0,3.4) circle (1.8pt) node[above right] {$A$ hoy};
  \draw[dotted,gray] (0.6,0) -- (0.6,{4.3/(1+1.3*0.6)});
  \fill (0.6,{4.3/(1+1.3*0.6)}) circle (1.8pt);
  \node[right] at (0.72,{4.3/(1+1.3*0.6)-0.1}) {$B$ mañana};
  \draw[<->,thick] (0.28,3.4) -- (0.28,{4.3/(1+1.3*0.6)});
  \node[align=left,anchor=west] at (1.65,2.75) {$A$ hoy vale \textbf{más}:\\se elige $A$};

  % largo plazo: A en 4.4, B en 5.0
  \draw[dotted,gray] (4.4,0) -- (4.4,{3.4/(1+1.3*4.4)});
  \fill (4.4,{3.4/(1+1.3*4.4)}) circle (1.8pt);
  \draw[dotted,gray] (5.0,0) -- (5.0,{4.3/(1+1.3*5.0)});
  \fill (5.0,{4.3/(1+1.3*5.0)}) circle (1.8pt);
  \node[align=left,anchor=south west] at (3.25,1.15)
    {$B$ dentro de un mes y un día\\vale \textbf{más}: se elige $B$};
  \draw[->] (4.6,1.1) -- (4.95,{4.3/(1+1.3*5.0)+0.07});

  \node[align=left,anchor=north west] at (0.15,-0.45)
    {El mismo intervalo entre $A$ y $B$ se juzga de dos maneras según su\\
     distancia al presente: la ordenación depende del calendario.};
\end{scope}

\end{tikzpicture}
