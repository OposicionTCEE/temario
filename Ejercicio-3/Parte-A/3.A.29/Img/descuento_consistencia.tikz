\begin{tikzpicture}[scale=1,font=\footnotesize]

% ================= PANEL (a): funciones de descuento =================
\begin{scope}
  \draw[->,thick] (0,0) -- (7.5,0) node[right] {$t$};
  \draw[->,thick] (0,0) -- (0,4.7) node[above] {$D(t)$};
  \node at (3.6,5.25) {\textbf{(a) La forma del descuento}};

  \draw[dashed,gray] (0,4) -- (7.2,4);
  \node[left] at (0,4) {$1$};
  \node[below left] at (0,0) {$0$};

  % exponencial D = 0,85^t   (4 unidades de alto = 1)
  \draw[very thick,domain=0:7.1,samples=90,smooth,variable=\x] plot ({\x},{4*pow(0.85,\x)});
  \draw[gray] (7.1,{4*pow(0.85,7.1)}) -- (7.45,{4*pow(0.85,7.1)});
  \node[right] at (7.5,{4*pow(0.85,7.1)}) {Exponencial, $\beta^{t}$};

  % hiperbolica D = 1/(1+kt)
  \draw[very thick,dash pattern=on 4pt off 2pt,domain=0:7.1,samples=90,smooth,variable=\x]
       plot ({\x},{4/(1+0.9*\x)});
  \draw[gray] (7.1,{4/(1+0.9*7.1)}) -- (7.45,{4/(1+0.9*7.1)});
  \node[right] at (7.5,{4/(1+0.9*7.1)}) {Hiperbólica, $1/(1+kt)$};

  % cuasi-hiperbolica: 1 en t=0 y despues beta*delta^t
  \fill (0,4) circle (1.7pt);
  \draw[very thick,dotted,domain=0:7.1,samples=90,smooth,variable=\x]
       plot ({\x},{4*0.65*pow(0.97,\x)});
  \fill (0,2.6) circle (1.7pt);
  \draw[gray] (7.1,{4*0.65*pow(0.97,7.1)}) -- (7.45,{4*0.65*pow(0.97,7.1)});
  \node[right] at (7.5,{4*0.65*pow(0.97,7.1)}) {Cuasi-hiperbólica, $\beta\delta^{t}$};

  \draw[<->] (-0.7,3.98) -- (-0.7,2.62);
  \node[left,align=right] at (-0.75,3.3) {salto\\$\beta$};

  \node[align=left,anchor=north west] at (-0.3,-0.55)
    {El exponencial cae a tasa constante: la distancia al presente no importa.\\
     Los otros dos castigan mucho el futuro inmediato y poco el lejano.};
\end{scope}

% ================= PANEL (b): reversion de preferencias =================
% A: premio pequeno (2,4) cobrado en t=5 ; B: premio grande (4,4) cobrado en t=7
% valor visto desde t:  A/(1+k(5-t))  y  B/(1+k(7-t)), con k=0,8. Se cruzan en t=3,85
\begin{scope}[xshift=12.2cm]
  \draw[->,thick] (0,0) -- (8.3,0) node[below right] {momento desde el que se juzga, $t$};
  \draw[->,thick] (0,0) -- (0,4.7) node[above] {valor descontado};
  \node at (4.0,5.25) {\textbf{(b) La reversión de preferencias}};

  % premios, como barras en su fecha de cobro
  \draw[very thick] (5,0) -- (5,2.4);
  \draw[very thick] (4.86,2.4) -- (5.14,2.4);
  \node[above,align=center] at (5,2.5) {$A$};
  \draw[very thick,dash pattern=on 4pt off 2pt] (7,0) -- (7,4.4);
  \draw[very thick] (6.86,4.4) -- (7.14,4.4);
  \node[above,align=center] at (7,4.5) {$B$};
  \node[below] at (5,-0.08) {fecha de $A$};
  \node[below] at (7,-0.08) {fecha de $B$};

  % curvas de valor visto desde t
  \draw[very thick,domain=0:5,samples=90,smooth,variable=\x] plot ({\x},{2.4/(1+0.8*(5-\x))});
  \draw[very thick,dash pattern=on 4pt off 2pt,domain=0:7,samples=120,smooth,variable=\x]
       plot ({\x},{4.4/(1+0.8*(7-\x))});

  % punto de cruce
  \draw[dotted,gray] (3.85,0) -- (3.85,1.25);
  \fill (3.85,1.25) circle (2pt);
  \draw[->] (2.55,2.05) -- (3.78,1.33);
  \node[above left,align=right] at (2.6,2.0) {aquí cambia\\la preferencia};

  % regiones
  \node[align=center] at (1.85,0.42) {visto de lejos,\\se prefiere $B$};
  \node[align=center] at (4.5,3.55) {visto de cerca,\\se prefiere $A$};

  \node[align=left,anchor=north west] at (-0.3,-0.75)
    {El premio grande domina mientras los dos están lejos; al acercarse la fecha\\
     del pequeño, la preferencia se invierte sin que nada haya cambiado.};
\end{scope}

\end{tikzpicture}
