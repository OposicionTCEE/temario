\begin{tikzpicture}[font=\footnotesize,
   estado/.style={circle,draw,very thick,minimum size=1.8cm,inner sep=1pt,align=center},
   fl/.style={-{Stealth[length=6pt]},very thick}]

% Version del cuerpo: los dos estados con la ACCION DE EQUILIBRIO dentro de cada uno,
% y cada arco rotulado con su probabilidad y con el perfil de acciones que lo produce.
%   omega_1 = debil, equilibrio (NI,NI), cuyo bucle tiene probabilidad 1: trampa
%   omega_2 = fuerte, equilibrio (I,I)

  \node[estado] (w1) at (0,0) {$\omega_1$\\{\scriptsize$(NI,NI)$}};
  \node[estado] (w2) at (5.8,0) {$\omega_2$\\{\scriptsize$(I,I)$}};
  \node[below] at (0,-1.15) {débil};
  \node[below] at (5.8,-1.15) {fuerte};

  % transiciones entre estados
  \draw[fl] (w1) to[bend left=28] node[above,midway] {$q\;(I,I)$} (w2);
  \draw[fl] (w2) to[bend left=28] node[below,midway] {$s\;(NI,NI)$} (w1);

  % bucles
  \draw[fl] (w1) to[out=160,in=215,looseness=5.5] node[left,midway] {$1\;(NI,NI)$} (w1);
  \draw[fl] (w2) to[out=20,in=-35,looseness=5.5] node[right,midway] {$1-s\;(I,I)$} (w2);

\end{tikzpicture}
