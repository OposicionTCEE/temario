\begin{tikzpicture}[font=\footnotesize,
   caja/.style={draw,very thick,rounded corners=2pt,align=center,inner sep=5pt},
   ag/.style={caja,minimum width=2.5cm,minimum height=1.05cm},
   flecha/.style={-{Stealth[length=6pt]},very thick}]

% Arquitectura de un modelo macroeconomico basado en agentes, de abajo arriba

  % --- nivel 1: agentes ---
  \node[ag] (hog) at (0,0)   {Hogares\\{\scriptsize reglas de decisión}};
  \node[ag] (emp) at (3.4,0) {Empresas\\{\scriptsize reglas de decisión}};
  \node[ag] (ban) at (6.8,0) {Bancos\\{\scriptsize reglas de decisión}};

  % --- nivel 2: protocolos ---
  \node[caja,minimum width=8.6cm,minimum height=0.95cm] (prot) at (3.4,2.3)
       {Protocolos de mercado: bienes, trabajo, crédito};

  % --- nivel 3: agregacion ---
  \node[caja,minimum width=8.6cm,minimum height=0.95cm] (agr) at (3.4,4.3)
       {Variables meso y macro: producción, empleo, precios, crédito};

  % --- flechas ascendentes ---
  \foreach \n in {hog,emp,ban}{\draw[flecha] (\n) -- (\n |- prot.south);}
  \draw[flecha] (prot) -- (agr);

  % --- realimentacion: baja por la derecha y entra en los tres tipos de agente ---
  \draw[very thick] (agr.east) -- (9.3,4.3) -- (9.3,-1.45) -- (-1.5,-1.45);
  \node[right,align=left] at (9.4,1.6) {realimentación};
  \foreach \n in {hog,emp,ban}{\draw[flecha] (\n.south |- 0,-1.45) -- (\n.south);}

\end{tikzpicture}
