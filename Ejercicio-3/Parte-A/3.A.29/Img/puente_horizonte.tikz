\begin{tikzpicture}[font=\footnotesize,
   caja/.style={draw,very thick,rounded corners=2pt,align=center,inner sep=6pt},
   flecha/.style={-{Stealth[length=6pt]},very thick}]

% Lo que decide el resultado no es la duracion de la vida, sino la llegada de agentes nuevos

  \node[caja,minimum width=7.6cm] (preg) at (0,3.0)
       {¿Llegan agentes nuevos que no estén\\en la restricción presupuestaria de los actuales?};

  \node[caja,minimum width=5.4cm,minimum height=1.5cm] (no) at (-4.3,0.4)
       {\textbf{No}\\equivalencia ricardiana\\equilibrio óptimo\\{\scriptsize RAMSEY-CASS-KOOPMANS, BARRO}};

  \node[caja,minimum width=5.4cm,minimum height=1.5cm] (si) at (4.3,0.4)
       {\textbf{Sí}\\la equivalencia falla\\puede haber ineficiencia\\{\scriptsize DIAMOND, WEIL}};

  \draw[flecha] (preg.south) -- (-4.3,2.2) -- (no.north);
  \draw[flecha] (preg.south) -- (4.3,2.2) -- (si.north);

\end{tikzpicture}
