\begin{tikzpicture}[xscale=1.05,yscale=2.05,font=\footnotesize]

% Consumo de estado estacionario: c = f(k) - (n+delta) k, con f(k) = 2,2 k^0,4 y n+delta = 0,5
% Maximo (regla de oro) en k = 2,57 ; c = 1,91
% Estado estacionario de DIAMOND situado a la DERECHA: k* = 4,5 ; c = 1,78 (sobreacumulacion)

  \draw[->,thick] (0,0) -- (7.4,0) node[right] {$k$};
  \draw[->,thick] (0,0) -- (0,2.45) node[above] {$c$};

  % curva de consumo de estado estacionario
  \draw[very thick,domain=0.06:7.1,samples=160,smooth,variable=\x]
       plot ({\x},{2.2*pow(\x,0.4)-0.5*\x});
  \node[below right] at (6.4,{2.2*pow(6.4,0.4)-0.5*6.4}) {$f(k)-(n+\delta)k$};

  % regla de oro
  \node[circle,fill,inner sep=1.4pt] at (2.566,1.912) {};
  \node[above] at (2.566,1.95) {$G$};
  \draw[dotted,gray] (2.566,0) -- (2.566,1.912) -- (0,1.912);
  \node[below] at (2.566,-0.06) {$k_{\text{oro}}$};
  \node[left] at (0,1.912) {$c_{\text{oro}}$};

  % estado estacionario con sobreacumulacion
  \node[circle,fill,inner sep=1.4pt] at (4.5,1.777) {};
  \node[above right] at (4.52,1.80) {$E$};
  \draw[dotted,gray] (4.5,0) -- (4.5,1.777) -- (0,1.777);
  \node[below] at (4.5,-0.06) {$k^{*}$};
  \node[left] at (0,1.777) {$c^{*}$};

\end{tikzpicture}
