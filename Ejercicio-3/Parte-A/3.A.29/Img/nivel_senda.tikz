\begin{tikzpicture}[font=\footnotesize]

% El nivel de la senda: tres valores de c_0 con la MISMA pendiente
%   Panel (a): c_t = c_0 (1,06)^t con c_0 = 2,6 (A) ; 2,0 (*) ; 1,5 (B)
%   Panel (b): sendas de activos que generan, todas desde el mismo a_0 = 1,5
%     A: 1,5 + 0,25 t - 0,13 t^2   (se endeuda sin limite)
%     *: 1,5 e^{-0,45 t}           (tiende a cero)
%     B: 1,5 e^{0,18 t}            (acumula sin limite)

% ============ PANEL (a): el consumo ============
\begin{scope}[xscale=0.93,yscale=1.08]
  \draw[->,thick] (0,0) -- (7.0,0) node[right] {$t$};
  \draw[->,thick] (0,0) -- (0,4.4) node[above] {$c_t$};
  \node at (3.2,4.9) {\textbf{(a) El consumo}};

  \draw[very thick,domain=0:6.0,samples=90,smooth,variable=\x]
       plot ({\x},{2.6*pow(1.06,\x)});
  \node[right] at (6.05,{2.6*pow(1.06,6.0)}) {$c^{A}$};

  \draw[very thick,domain=0:6.0,samples=90,smooth,variable=\x]
       plot ({\x},{2.0*pow(1.06,\x)});
  \node[right] at (6.05,{2.0*pow(1.06,6.0)}) {$c^{*}$};

  \draw[very thick,domain=0:6.0,samples=90,smooth,variable=\x]
       plot ({\x},{1.5*pow(1.06,\x)});
  \node[right] at (6.05,{1.5*pow(1.06,6.0)}) {$c^{B}$};

  \node[circle,fill,inner sep=1.3pt] at (0,2.6) {};
  \node[circle,fill,inner sep=1.3pt] at (0,2.0) {};
  \node[circle,fill,inner sep=1.3pt] at (0,1.5) {};
  \node[left] at (0,2.62) {$c_0^{A}$};
  \node[left] at (0,2.0) {$c_0^{*}$};
  \node[left] at (0,1.48) {$c_0^{B}$};
\end{scope}

% ============ PANEL (b): los activos ============
\begin{scope}[xshift=8.6cm,yshift=1.95cm,xscale=0.93,yscale=0.62]
  \draw[->,thick] (0,-3.1) -- (0,4.6) node[above] {$a_t$};
  \draw[->,thick] (0,0) -- (7.0,0) node[right] {$t$};
  \node at (3.2,5.25) {\textbf{(b) Los activos}};

  \draw[very thick,domain=0:6.0,samples=90,smooth,variable=\x]
       plot ({\x},{1.5+0.25*\x-0.13*\x*\x});
  \node[below right] at (5.6,{1.5+0.25*5.6-0.13*5.6*5.6}) {$a^{A}$};

  \draw[very thick,domain=0:6.0,samples=90,smooth,variable=\x]
       plot ({\x},{1.5*exp(-0.45*\x)});
  \node[above right] at (6.05,0.12) {$a^{*}$};

  \draw[very thick,domain=0:6.0,samples=90,smooth,variable=\x]
       plot ({\x},{1.5*exp(0.18*\x)});
  \node[right] at (6.05,{1.5*exp(0.18*6.0)}) {$a^{B}$};

  \node[circle,fill,inner sep=2.1pt] at (0,1.5) {};
  \node[left] at (-0.08,1.5) {$a_0$};
  \node[left] at (-0.08,0) {$0$};
\end{scope}

\end{tikzpicture}
