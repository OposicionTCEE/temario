\begin{tikzpicture}[font=\footnotesize,
   estado/.style={circle,draw,very thick,minimum size=1.5cm,inner sep=1pt}]

% Dos estados de la economia y las transiciones que inducen los perfiles de accion
%   omega_1 = debil ; omega_2 = fuerte
%   (NI,NI) = ninguna empresa invierte ; (I,I) = ambas invierten

  \node[estado] (w1) at (0,0) {$\omega_1$};
  \node[estado] (w2) at (5.4,0) {$\omega_2$};
  \node[below] at (0,-0.95) {débil};
  \node[below] at (5.4,-0.95) {fuerte};

  % transiciones entre estados
  \draw[-{Stealth[length=6pt]},very thick] (w1) to[bend left=28] node[above,midway] {$q\,(I,I)$} (w2);
  \draw[-{Stealth[length=6pt]},very thick] (w2) to[bend left=28] node[below,midway] {$s\,(NI,NI)$} (w1);

  % bucles
  \draw[-{Stealth[length=6pt]},very thick] (w1) to[out=160,in=215,looseness=5.5] node[left,midway] {$1\,(NI,NI)$} (w1);
  \draw[-{Stealth[length=6pt]},very thick] (w2) to[out=20,in=-35,looseness=5.5] node[right,midway] {$1-s\,(I,I)$} (w2);

\end{tikzpicture}
