\begin{tikzpicture}[xscale=1.30,yscale=0.56,font=\footnotesize]

% Recursos del primer periodo: y1 = 5. Tecnologia: c2 = 4 raiz(5-c1)
% Mercado de capitales: 1+r = 1,5. Tangencia de la FPCI en B = (3,222; 5,333)
% Recta de valor: c2 = 10,167 - 1,5 c1
% Preferencias Cobb-Douglas alpha = 0,7
%   Autarquia: A = (4,118; 3,757), tangencia de la FPCI con u^A = 102,2 c1^(-2,3333)
%   Con mercado: C = (4,744; 3,050), tangencia de la recta con u^C = 115,3 c1^(-2,3333)

  \draw[->,thick] (0,0) -- (7.6,0) node[right] {$c_1$};
  \draw[->,thick] (0,0) -- (0,11.3) node[above] {$c_2$};

  % ---- frontera de posibilidades de consumo intertemporal ----
  \draw[very thick,domain=0:4.97,samples=140,smooth,variable=\x]
       plot ({\x},{4*sqrt(5-\x)});
  \node[right] at (0.55,{4*sqrt(5-0.55)+0.45}) {FPCI};
  \node[below] at (5,-0.2) {$y_1$};
  \draw[dotted,gray] (5,0) -- (5,0.35);

  % ---- recta de valor de mercado ----
  \draw[very thick,dash pattern=on 5pt off 2.5pt] (0,10.167) -- (6.78,0);
  \node[right,align=left] at (5.75,1.95) {pendiente\\$-(1+r)$};

  % ---- curvas de indiferencia ----
  \draw[very thick,dash pattern=on 1.5pt off 2pt,domain=2.9:7.3,samples=120,smooth,variable=\x]
       plot ({\x},{102.2*pow(\x,-2.3333)});
  \node[below left] at (7.3,{102.2*pow(7.3,-2.3333)+0.45}) {$u^{A}$};
  \draw[very thick,dash pattern=on 1.5pt off 2pt,domain=3.05:7.3,samples=120,smooth,variable=\x]
       plot ({\x},{115.3*pow(\x,-2.3333)});
  \node[above right] at (7.0,{115.3*pow(7.0,-2.3333)+0.1}) {$u^{C}$};

  % ---- puntos ----
  \node[circle,fill,inner sep=1.5pt] at (4.118,3.757) {};
  \node[above right] at (4.17,3.80) {$A$};
  \node[circle,fill,inner sep=1.5pt] at (3.222,5.333) {};
  \node[above right] at (3.27,5.38) {$B$};
  \node[circle,fill,inner sep=1.5pt] at (4.744,3.050) {};
  \node[below right] at (4.80,3.05) {$C$};

  \draw[dotted,gray] (3.222,0) -- (3.222,5.333);
  \draw[dotted,gray] (4.744,0) -- (4.744,3.050);
  \node[below] at (3.222,-0.2) {$c_1^{B}$};
  \node[below] at (4.744,-0.2) {$c_1^{C}$};

\end{tikzpicture}
