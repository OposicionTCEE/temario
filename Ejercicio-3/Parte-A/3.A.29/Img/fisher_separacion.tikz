\begin{tikzpicture}[xscale=0.95,yscale=0.75,font=\footnotesize]

% Recursos del primer periodo: y1 = 5. Tecnologia: c2 = 4 raiz(5-c1)
% Mercado de capitales: 1+r = 1. Tangencia de la FPCI en B = (1; 8)
% Recta de valor: c2 = 9 - c1
% Preferencias Cobb-Douglas alpha = 0,7
%   Autarquia:   A = (4,118; 3,757), con u^A = 102,2 c1^(-2,3333)
%   Con mercado: C = (6,300; 2,700), con u^C = 197,9 c1^(-2,3333)

  \draw[->,thick] (0,0) -- (9.9,0) node[right] {$c_1$};
  \draw[->,thick] (0,0) -- (0,9.9) node[above] {$c_2$};

  % ---- frontera de posibilidades de consumo intertemporal ----
  \draw[very thick,domain=0:4.985,samples=160,smooth,variable=\x]
       plot ({\x},{4*sqrt(5-\x)});
  \node at (3.65,1.45) {FPCI};
  \draw[gray,thin] (3.9,1.62) -- (4.47,2.88);

  % ---- recta de valor de mercado ----
  \draw[very thick,dash pattern=on 5pt off 2.5pt] (0,9) -- (9,0);
  \node[align=center] at (7.3,4.3) {pendiente\\$-(1+r)$};
  \draw[gray,thin] (7.6,3.65) -- (8.2,1.05);

  % ---- curvas de indiferencia ----
  \draw[very thick,dash pattern=on 1.5pt off 2pt,domain=2.95:7.0,samples=130,smooth,variable=\x]
       plot ({\x},{102.2*pow(\x,-2.3333)});
  \node[below right] at (7.0,{102.2*pow(7.0,-2.3333)+0.1}) {$u^{A}$};
  \draw[very thick,dash pattern=on 1.5pt off 2pt,domain=3.95:9.3,samples=130,smooth,variable=\x]
       plot ({\x},{197.9*pow(\x,-2.3333)});
  \node[right] at (9.3,{197.9*pow(9.3,-2.3333)}) {$u^{C}$};

  % ---- puntos ----
  \node[circle,fill,inner sep=1.5pt] at (1,8) {};
  \node[above right] at (1.06,8.06) {$B$};
  \node[circle,fill,inner sep=1.5pt] at (4.118,3.757) {};
  \node[above right] at (4.19,3.81) {$A$};
  \node[circle,fill,inner sep=1.5pt] at (6.3,2.7) {};
  \node[above right] at (6.38,2.76) {$C$};

  % ---- marcas en el eje ----
  \draw[dotted,gray] (1,0) -- (1,8);
  \draw[dotted,gray] (6.3,0) -- (6.3,2.7);
  \draw[dotted,gray] (5,0) -- (5,0.45);
  \node[below] at (1,-0.2) {$c_1^{B}$};
  \node[below] at (5,-0.2) {$y_1$};
  \node[below] at (6.3,-0.2) {$c_1^{C}$};

\end{tikzpicture}
