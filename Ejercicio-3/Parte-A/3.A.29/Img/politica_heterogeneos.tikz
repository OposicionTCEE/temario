\begin{tikzpicture}[xscale=1.75,yscale=1.15,font=\footnotesize]

% Funcion de politica del consumo en un modelo de mercados incompletos
%   Tramo restringido (a <= a*):  c = a + y, con y = 1 ; a* = 1,2
%   Tramo no restringido (a > a*): c = 2,2 + 0,9(a-1,2) - 0,06(a-1,2)^2, concava
% La pendiente es la propension marginal a consumir

  \draw[->,thick] (0,0) -- (5.4,0) node[right] {$a$};
  \draw[->,thick] (0,0) -- (0,5.4) node[above] {$c$};

  % recta de consumo restringido, prolongada
  \draw[thick,dash pattern=on 3pt off 2.5pt,gray] (0,1) -- (4.15,5.15);
  \node[right,gray] at (4.2,5.15) {$c=a+y$};

  % tramo restringido
  \draw[very thick] (0,1) -- (1.2,2.2);

  % tramo no restringido
  \draw[very thick,domain=1.2:5.1,samples=120,smooth,variable=\x]
       plot ({\x},{2.2+0.65*(\x-1.2)-0.045*(\x-1.2)*(\x-1.2)});
  \node[below right] at (4.6,{2.2+0.65*3.4-0.045*3.4*3.4}) {$c(a)$};

  % umbral
  \draw[dotted,gray] (1.2,0) -- (1.2,2.2);
  \node[circle,fill,inner sep=1.4pt] at (1.2,2.2) {};
  \node[below] at (1.2,-0.1) {$a^{*}$};

  \node[left] at (0,1) {$y$};

\end{tikzpicture}
