\begin{tikzpicture}[xscale=1.45,yscale=0.92,font=\footnotesize]

% ============ PANEL (a): optimo sin restricciones ============
% Dotacion E=(3,4; 0,9); 1+r=1,5; recta c2 = 6 - 1,5 c1
% Preferencias Cobb-Douglas alpha=0,6  ->  optimo C*=(2,4; 2,4)
% Curva de indiferencia tangente: c2 = 8,924 c1^(-1,5)
\begin{scope}
  \draw[->,thick] (0,0) -- (5.2,0) node[right] {$c_1$};
  \draw[->,thick] (0,0) -- (0,7.0) node[above] {$c_2$};
  \node at (2.5,7.6) {\textbf{(a) El óptimo}};

  % recta presupuestaria
  \draw[very thick] (0,6) -- (4,0);
  \node[right,align=left] at (4.05,0.55) {pendiente\\$-(1+r)$};

  % curva de indiferencia
  \draw[very thick,dash pattern=on 4pt off 2pt,domain=1.25:4.6,samples=90,smooth,variable=\x]
       plot ({\x},{8.924*pow(\x,-1.5)});
  \node[above right] at (1.3,{8.924*pow(1.3,-1.5)}) {$u^{*}$};

  % dotacion
  \node[circle,fill,inner sep=1.5pt] at (3.4,0.9) {};
  \node[above right] at (3.45,0.92) {$E$};
  \draw[dotted,gray] (3.4,0) -- (3.4,0.9) -- (0,0.9);
  \node[below] at (3.4,-0.12) {$w_1$};
  \node[left] at (0,0.9) {$w_2$};

  % optimo
  \node[circle,fill,inner sep=1.5pt] at (2.4,2.4) {};
  \node[above right] at (2.45,2.45) {$C^{*}$};
  \draw[dotted,gray] (2.4,0) -- (2.4,2.4) -- (0,2.4);
  \node[below] at (2.4,-0.12) {$c_1^{*}$};
  \node[left] at (0,2.4) {$c_2^{*}$};
\end{scope}

% ============ PANEL (b): con restriccion de liquidez ============
% Dotacion E=(1,5; 4); misma recta de pendiente -1,5: c2 = 6,25 - 1,5 c1
% Optimo libre C*=(2,5; 2,5); curva de indiferencia c2 = 9,882 c1^(-1,5)
% Curva por E: c2 = 7,348 c1^(-1,5)
\begin{scope}[xshift=7.4cm]
  \draw[->,thick] (0,0) -- (5.2,0) node[right] {$c_1$};
  \draw[->,thick] (0,0) -- (0,7.0) node[above] {$c_2$};
  \node at (2.5,7.6) {\textbf{(b) Con restricción de liquidez}};

  % tramo accesible y tramo vedado
  \draw[very thick] (0,6.25) -- (1.5,4);
  \draw[thick,dash pattern=on 2pt off 2.5pt,gray] (1.5,4) -- (4.167,0);

  % curva de indiferencia del optimo libre
  \draw[very thick,dash pattern=on 4pt off 2pt,domain=1.35:4.7,samples=90,smooth,variable=\x]
       plot ({\x},{9.882*pow(\x,-1.5)});
  \node[above right] at (1.4,{9.882*pow(1.4,-1.5)}) {$u^{*}$};

  % curva de indiferencia alcanzable
  \draw[very thick,dash pattern=on 4pt off 2pt,domain=1.05:4.7,samples=90,smooth,variable=\x]
       plot ({\x},{7.348*pow(\x,-1.5)});
  \node[below left] at (4.5,{7.348*pow(4.5,-1.5)}) {$u^{R}$};

  % dotacion, que es el optimo restringido
  \node[circle,fill,inner sep=1.7pt] at (1.5,4) {};
  \node[below left] at (1.46,3.95) {$E$};
  \draw[dotted,gray] (1.5,0) -- (1.5,4);
  \node[below] at (1.5,-0.12) {$w_1$};

  % optimo libre
  \node[circle,draw,very thick,fill=white,inner sep=1.3pt] at (2.5,2.5) {};
  \node[above right] at (2.56,2.52) {$C^{*}$};
  \draw[dotted,gray] (2.5,0) -- (2.5,2.5);
  \node[below] at (2.5,-0.12) {$c_1^{*}$};
\end{scope}

\end{tikzpicture}
