\begin{tikzpicture}[xscale=0.95,yscale=0.95,font=\footnotesize]

% Alisamiento: renta escalonada (3,2 y 1,6 alternando) y consumo constante en 2,4
% El perfil de renta es un esquema, no una serie: cuatro tramos de dos periodos

  \draw[->,thick] (0,0) -- (9.0,0) node[right] {$t$};
  \draw[->,thick] (0,0) -- (0,4.2) node[above] {};

  % renta escalonada
  \draw[very thick,dash pattern=on 4pt off 2pt]
       (0,3.2) -- (2,3.2) -- (2,1.6) -- (4,1.6) -- (4,3.2) -- (6,3.2) -- (6,1.6) -- (8,1.6);
  \node[above] at (1.0,3.25) {$w_t$};

  % consumo constante
  \draw[very thick] (0,2.4) -- (8.3,2.4);
  \node[right] at (8.35,2.4) {$c_t$};

  % niveles
  \draw[dotted,gray] (0,3.2) -- (0.1,3.2);
  \node[left] at (0,3.2) {$w^{H}$};
  \node[left] at (0,2.4) {$\bar c$};
  \node[left] at (0,1.6) {$w^{L}$};

\end{tikzpicture}
