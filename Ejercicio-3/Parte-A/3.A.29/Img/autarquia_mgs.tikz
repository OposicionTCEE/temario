\begin{tikzpicture}[xscale=1.62,yscale=1.26,font=\footnotesize]

% Dotaciones e^J = 3,5 y e^V = 0,8, sin crecimiento de la poblacion (n = 0)
% Asignaciones estacionarias factibles: c^J + c^V = 4,3, de pendiente -(1+n) = -1
% Preferencias u = raiz(c^J c^V):  curva por E: c^V = 2,8/c^J ; por G: c^V = 4,6225/c^J
% Tangencia con la recta en G = (2,15; 2,15)

  \draw[->,thick] (0,0) -- (5.1,0) node[right] {$c^{J}$};
  \draw[->,thick] (0,0) -- (0,5.1) node[above] {$c^{V}$};

  % ---- recta de asignaciones estacionarias factibles ----
  \draw[very thick] (0,4.3) -- (4.3,0);
  \node[align=center] at (1.62,4.62) {pendiente\\$-(1+n)$};
  \draw[gray,thin] (1.5,4.28) -- (0.78,3.56);

  % ---- curvas de indiferencia ----
  \draw[very thick,dash pattern=on 4pt off 2pt,domain=0.78:4.75,samples=120,smooth,variable=\x]
       plot ({\x},{2.8/\x});
  \node[below right] at (4.6,{2.8/4.6+0.06}) {$u^{E}$};
  \draw[very thick,dash pattern=on 4pt off 2pt,domain=1.15:4.15,samples=120,smooth,variable=\x]
       plot ({\x},{4.6225/\x});
  \node[above right] at (4.05,{4.6225/4.05}) {$u^{G}$};

  % ---- dotacion ----
  \node[circle,fill,inner sep=1.5pt] at (3.5,0.8) {};
  \node[above right] at (3.56,0.82) {$E$};
  \draw[dotted,gray] (3.5,0) -- (3.5,0.8) -- (0,0.8);
  \node[below] at (3.5,-0.1) {$e^{J}$};
  \node[left] at (0,0.8) {$e^{V}$};

  % ---- regla de oro ----
  \node[circle,fill,inner sep=1.5pt] at (2.15,2.15) {};
  \node[above right] at (2.21,2.17) {$G$};
  \draw[dotted,gray] (2.15,0) -- (2.15,2.15) -- (0,2.15);
  \node[below] at (2.15,-0.1) {$c^{J}_{G}$};
  \node[left] at (0,2.15) {$c^{V}_{G}$};

\end{tikzpicture}
