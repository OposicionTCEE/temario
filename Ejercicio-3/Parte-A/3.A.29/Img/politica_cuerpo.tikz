\begin{tikzpicture}[xscale=1.62,yscale=1.08,font=\footnotesize]

% Version del cuerpo: la funcion de consumo con restriccion de endeudamiento,
% marcando la PROPENSION MARGINAL A CONSUMIR en dos puntos (es lo que el cuerpo discute)
%   Tramo restringido (a <= a*): c = a + y, con y = 1 ; a* = 1,2 ; pendiente 1
%   Tramo no restringido (a > a*): c = 2,2 + 0,65(a-1,2) - 0,045(a-1,2)^2

  \draw[->,thick] (0,0) -- (5.6,0) node[right] {$a$};
  \draw[->,thick] (0,0) -- (0,5.3) node[above] {$c$};

  % recta de consumo restringido, prolongada
  \draw[thick,dash pattern=on 3pt off 2.5pt,gray] (0,1) -- (4.15,5.15);
  \node[right,gray] at (4.2,5.15) {$c=a+y$};

  % tramo restringido
  \draw[very thick] (0,1) -- (1.2,2.2);

  % tramo no restringido
  \draw[very thick,domain=1.2:5.3,samples=140,smooth,variable=\x]
       plot ({\x},{2.2+0.65*(\x-1.2)-0.045*(\x-1.2)*(\x-1.2)});
  \node[below right] at (4.75,{2.2+0.65*3.55-0.045*3.55*3.55}) {$c(a)$};

  % umbral
  \draw[dotted,gray] (1.2,0) -- (1.2,2.2);
  \node[circle,fill,inner sep=1.4pt] at (1.2,2.2) {};
  \node[below] at (1.2,-0.1) {$a^{*}$};
  \node[left] at (0,1) {$y$};

  % propension marginal a consumir en dos puntos
  \draw[very thick] (0.42,1.42) -- (0.92,1.92);
  \node[above left] at (0.80,1.86) {$\text{PMC}=1$};

  \node[circle,fill,inner sep=1.4pt] at (4.2,{2.2+0.65*3.0-0.045*3.0*3.0}) {};
  \draw[very thick] (3.6,{2.2+0.65*3.0-0.045*3.0*3.0-0.6*0.38}) -- (4.8,{2.2+0.65*3.0-0.045*3.0*3.0+0.6*0.38});
  \node[below right] at (4.35,{2.2+0.65*3.0-0.045*3.0*3.0-0.10}) {$\text{PMC}<1$};

\end{tikzpicture}
