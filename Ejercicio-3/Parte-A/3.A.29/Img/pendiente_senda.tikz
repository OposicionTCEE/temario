\begin{tikzpicture}[xscale=1.12,yscale=1.25,font=\footnotesize]

% La pendiente de la senda de consumo segun r frente a rho
%   Mismo c_0 = 2 en las tres sendas ; factor de crecimiento [beta(1+r)]^sigma
%   creciente 1,08 ; constante 1 ; decreciente 0,93

  \draw[->,thick] (0,0) -- (7.0,0) node[right] {$t$};
  \draw[->,thick] (0,0) -- (0,3.9) node[above] {$c_t$};

  % senda creciente
  \draw[very thick,domain=0:6.2,samples=90,smooth,variable=\x]
       plot ({\x},{2*pow(1.08,\x)});
  \node[right] at (6.25,{2*pow(1.08,6.2)}) {$r>\rho$};

  % senda constante
  \draw[very thick,domain=0:6.2,samples=2,variable=\x]
       plot ({\x},{2});
  \node[right] at (6.25,2) {$r=\rho$};

  % senda decreciente
  \draw[very thick,domain=0:6.2,samples=90,smooth,variable=\x]
       plot ({\x},{2*pow(0.93,\x)});
  \node[right] at (6.25,{2*pow(0.93,6.2)}) {$r<\rho$};

  % nivel inicial comun
  \node[circle,fill,inner sep=1.4pt] at (0,2) {};
  \node[left] at (0,2) {$c_0$};

\end{tikzpicture}
