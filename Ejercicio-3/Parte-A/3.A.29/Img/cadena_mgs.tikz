\begin{tikzpicture}[xscale=1.38,yscale=1.10,font=\footnotesize]

% Version del cuerpo (doble infinitud): las dotaciones contingentes y lo que genera la cadena.
% Misma base que autarquia_mgs.tikz (anexo) y reparto_mgs.tikz: e^J = 3,5 y e^V = 0,8 ; n = 0
% Asignaciones estacionarias factibles: c^J + c^V = 4,3, de pendiente -(1+n) = -1
% Curva por E: c^V = 2,8/c^J. La recta la corta en E = (3,5; 0,8) y en (0,8; 3,5), de modo que
% el tramo entre esos dos puntos son las transferencias que mejoran a todas las generaciones.
% La tangencia G y la pendiente -(1+n) NO se dibujan aqui: son la figura del apartado siguiente.
% Un \\ dentro de un grupo {\scriptsize ...} genera un PDF en blanco: font=\scriptsize como opcion.

  \draw[->,thick] (0,0) -- (5.1,0) node[right] {$c^{J}$};
  \draw[->,thick] (0,0) -- (0,5.1) node[above] {$c^{V}$};

  % ---- tramo de la recta preferido a la autarquia ----
  \draw[line width=3.6pt,black!22] (0.8,3.5) -- (3.5,0.8);
  \node[rotate=-38.6,above,inner sep=3pt] at (1.70,2.60) {preferidas a $E$};
  \node[circle,draw,semithick,fill=white,inner sep=1.2pt] at (0.8,3.5) {};

  % ---- recta de asignaciones estacionarias factibles ----
  \draw[very thick] (0,4.3) -- (4.3,0);
  \node[align=center] at (1.78,4.74) {asignaciones estacionarias\\factibles};
  \draw[gray,thin] (1.58,4.44) -- (0.40,3.90);

  % ---- curva de indiferencia por la dotacion ----
  \draw[very thick,dash pattern=on 4pt off 2pt,domain=0.62:4.75,samples=120,smooth,variable=\x]
       plot ({\x},{2.8/\x});
  \node[below right] at (4.6,{2.8/4.6+0.06}) {$u^{E}$};

  % ---- dotacion contingente y consumo con la cadena ----
  \node[circle,fill,inner sep=1.5pt] at (3.5,0.8) {};
  \node[below right] at (3.54,0.78) {$E$};
  \node[circle,fill,inner sep=1.5pt] at (2.7,1.6) {};
  \node[above right] at (2.74,1.62) {$F$};

  \draw[dotted,gray] (3.5,0) -- (3.5,0.8);
  \draw[dotted,gray] (0,0.8) -- (3.5,0.8);
  \draw[dotted,gray] (2.7,0) -- (2.7,1.6);
  \draw[dotted,gray] (0,1.6) -- (2.7,1.6);
  \node[below] at (3.5,-0.1) {$e^{J}$};
  \node[below] at (2.7,-0.1) {$e^{J}-\delta$};
  \node[left] at (0,0.8) {$e^{V}$};
  \node[left] at (0,1.6) {$e^{V}+\delta$};

  % ---- la cadena: entrega delta de joven y recibe delta de viejo ----
  \draw[-{Stealth[length=5pt]},very thick] (3.5,0.42) -- (2.72,0.42);
  \node[below] at (3.11,0.40) {$\delta$};
  \draw[-{Stealth[length=5pt]},very thick] (0.42,0.8) -- (0.42,1.58);
  \node[right] at (0.46,1.19) {$\delta$};

\end{tikzpicture}
