\begin{tikzpicture}[font=\footnotesize]

% Version del cuerpo: dos paneles con la misma escalera de generaciones.
%   (a) sin transferencias: cada generacion consume su dotacion
%   (b) con la cadena de transferencias delta del joven al viejo de cada fecha
% G0 es la generacion inicial, que solo vive la vejez.

\foreach \panel/\dx/\conflechas/\titulo in {a/0/0/{(a) Autarquía}, b/8.1/1/{(b) Con la cadena de transferencias}}{
\begin{scope}[xshift=\dx cm,xscale=1.30,yscale=0.74]

  % ---- eje de fechas ----
  \draw[->,thick] (0.35,-1.25) -- (5.1,-1.25) node[right] {tiempo};
  \foreach \x/\lab in {1/$t$,2/{$t+1$},3/{$t+2$},4/{$t+3$}}{
     \draw (\x,-1.17) -- (\x,-1.33);
     \node[below] at (\x,-1.36) {\lab};}

  \node at (2.5,4.35) {\textbf{\titulo}};

  % ---- generacion inicial: solo vejez ----
  \draw[very thick,fill=black!7,rounded corners=2pt] (0.76,3.08) rectangle (1.24,3.52);
  \node at (1,3.30) {$V$};
  \node[left] at (0.70,3.30) {$G_{0}$};

  % ---- generaciones 1 a 3 ----
  \foreach \i/\y/\xj in {1/2.2/1, 2/1.1/2, 3/0.0/3}{
     \draw[very thick,fill=black!3,rounded corners=2pt] (\xj-0.24,\y-0.22) rectangle (\xj+1.24,\y+0.22);
     \node at (\xj,\y) {$J$};
     \node at (\xj+1,\y) {$V$};
     \node[left] at (\xj-0.30,\y) {$G_{\i}$};}

  % ---- transferencias, solo en el panel (b) ----
  \ifnum\conflechas=1
     \foreach \x/\yb/\ya in {1/2.44/3.04, 2/1.34/1.94, 3/0.24/0.84}{
        \draw[-{Stealth[length=5pt]},very thick] (\x,\yb) -- (\x,\ya);
        \node[right] at (\x+0.06,{(\yb+\ya)/2}) {$\delta$};}
  \fi

  % ---- continuacion ----
  \draw[dotted,very thick] (4.38,-0.22) -- (4.62,-0.46);
  \node at (4.80,-0.66) {$\ddots$};

\end{scope}}

\end{tikzpicture}
