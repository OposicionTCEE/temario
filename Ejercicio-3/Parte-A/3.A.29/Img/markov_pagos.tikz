% Forma normal del juego de inversion en cada estado de la economia. Misma convencion que
% 3.A.14 (Img/JE_forma_normal.tikz): cabeceras sombreadas, jugadores en negrita, acciones en
% cursiva y pagos en letras. Pagos simetricos entre las dos empresas.
%   (a) estado debil: no invertir es dominante   -> c>a y d>b
%   (b) estado fuerte: invertir es dominante     -> a'>c' y b'>d'
\begin{tikzpicture}[font=\footnotesize, line cap=round,
    jug/.style={font=\footnotesize\bfseries},
    acc/.style={font=\footnotesize\itshape},
    tit/.style={font=\footnotesize\bfseries}]

  % (a) Estado debil
  \node[tit] at (2.45,0.6) {(a) Estado débil ($\omega_1$)};
  \fill[black!8] (0,0.15) rectangle (4.9,-0.95);
  \fill[black!8] (0,-0.95) rectangle (2.1,-2.05);
  \draw[line width=0.5pt] (2.1,0.15) -- (4.9,0.15);
  \draw[line width=0.5pt] (2.1,-0.40) -- (4.9,-0.40);
  \draw[line width=0.5pt] (0,-0.95) -- (4.9,-0.95);
  \draw[line width=0.5pt] (0.6,-1.50) -- (4.9,-1.50);
  \draw[line width=0.5pt] (0,-2.05) -- (4.9,-2.05);
  \draw[line width=0.5pt] (0,-0.95) -- (0,-2.05);
  \draw[line width=0.5pt] (0.6,-0.95) -- (0.6,-2.05);
  \draw[line width=0.5pt] (2.1,0.15) -- (2.1,-2.05);
  \draw[line width=0.5pt] (3.5,-0.40) -- (3.5,-2.05);
  \draw[line width=0.5pt] (4.9,0.15) -- (4.9,-2.05);
  \node[jug] at (3.5,-0.125) {E2};
  \node[acc] at (2.8,-0.675) {Invertir};
  \node[acc] at (4.2,-0.675) {No invertir};
  \node[jug] at (0.3,-1.50) {E1};
  \node[acc] at (1.35,-1.225) {Invertir};
  \node[acc] at (1.35,-1.775) {No invertir};
  \node at (2.8,-1.225) {$a_1,\ a_2$};
  \node at (4.2,-1.225) {$b_1,\ b_2$};
  \node at (2.8,-1.775) {$c_1,\ c_2$};
  \node at (4.2,-1.775) {$d_1,\ d_2$};

  % (b) Estado fuerte
  \begin{scope}[shift={(6.4,0)}]
    \node[tit] at (2.45,0.6) {(b) Estado fuerte ($\omega_2$)};
    \fill[black!8] (0,0.15) rectangle (4.9,-0.95);
    \fill[black!8] (0,-0.95) rectangle (2.1,-2.05);
    \draw[line width=0.5pt] (2.1,0.15) -- (4.9,0.15);
    \draw[line width=0.5pt] (2.1,-0.40) -- (4.9,-0.40);
    \draw[line width=0.5pt] (0,-0.95) -- (4.9,-0.95);
    \draw[line width=0.5pt] (0.6,-1.50) -- (4.9,-1.50);
    \draw[line width=0.5pt] (0,-2.05) -- (4.9,-2.05);
    \draw[line width=0.5pt] (0,-0.95) -- (0,-2.05);
    \draw[line width=0.5pt] (0.6,-0.95) -- (0.6,-2.05);
    \draw[line width=0.5pt] (2.1,0.15) -- (2.1,-2.05);
    \draw[line width=0.5pt] (3.5,-0.40) -- (3.5,-2.05);
    \draw[line width=0.5pt] (4.9,0.15) -- (4.9,-2.05);
    \node[jug] at (3.5,-0.125) {E2};
    \node[acc] at (2.8,-0.675) {Invertir};
    \node[acc] at (4.2,-0.675) {No invertir};
    \node[jug] at (0.3,-1.50) {E1};
    \node[acc] at (1.35,-1.225) {Invertir};
    \node[acc] at (1.35,-1.775) {No invertir};
    \node at (2.8,-1.225) {$a'_1,\ a'_2$};
    \node at (4.2,-1.225) {$b'_1,\ b'_2$};
    \node at (2.8,-1.775) {$c'_1,\ c'_2$};
    \node at (4.2,-1.775) {$d'_1,\ d'_2$};
  \end{scope}

\end{tikzpicture}
