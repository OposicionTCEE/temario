\begin{tikzpicture}[font=\footnotesize]

% Las cuatro decisiones del modelizador y lo que cada una decide.
% Cada casilla remite a un resultado demostrado en los bloques anteriores.
% Columnas sin recuadro, solo reglas horizontales.

  \def\xa{0}      % columna 1: la decision
  \def\xb{4.1}    % columna 2: si se mantiene
  \def\xc{9.6}    % columna 3: si se levanta
  \def\ancA{3.7cm}
  \def\ancB{5.1cm}

  % ---- cabecera ----
  \node[anchor=north west,align=left,text width=\ancA] at (\xa,0.55) {\textbf{Supuesto}};
  \node[anchor=north west,align=left,text width=\ancB] at (\xb,0.55) {\textbf{Si se mantiene}};
  \node[anchor=north west,align=left,text width=\ancB] at (\xc,0.55) {\textbf{Si se levanta}};
  \draw[very thick] (-0.1,-0.05) -- (14.9,-0.05);

  % ---- fila 1: horizonte ----
  \node[anchor=north west,align=left,text width=\ancA] at (\xa,-0.3) {Horizonte infinito};
  \node[anchor=north west,align=left,text width=\ancB] at (\xb,-0.3) {el equilibrio es óptimo y vale la equivalencia ricardiana};
  \node[anchor=north west,align=left,text width=\ancB] at (\xc,-0.3) {llegan agentes nuevos y puede haber ineficiencia dinámica};
  \draw[thin] (-0.1,-1.55) -- (14.9,-1.55);

  % ---- fila 2: agregacion ----
  \node[anchor=north west,align=left,text width=\ancA] at (\xa,-1.8) {Agente representativo};
  \node[anchor=north west,align=left,text width=\ancB] at (\xb,-1.8) {la propensión a consumir es un parámetro};
  \node[anchor=north west,align=left,text width=\ancB] at (\xc,-1.8) {es una función de la riqueza: importa a quién alcance la medida};
  \draw[thin] (-0.1,-3.05) -- (14.9,-3.05);

  % ---- fila 3: precio-aceptante ----
  \node[anchor=north west,align=left,text width=\ancA] at (\xa,-3.3) {Precio-aceptante};
  \node[anchor=north west,align=left,text width=\ancB] at (\xb,-3.3) {basta con que el plan sea óptimo};
  \node[anchor=north west,align=left,text width=\ancB] at (\xc,-3.3) {ha de ser además creíble, y los equilibrios se multiplican};
  \draw[thin] (-0.1,-4.55) -- (14.9,-4.55);

  % ---- fila 4: equilibrio y ergodicidad ----
  \node[anchor=north west,align=left,text width=\ancA] at (\xa,-4.8) {Equilibrio y ergodicidad};
  \node[anchor=north west,align=left,text width=\ancB] at (\xb,-4.8) {se puede demostrar y estimar con una sola historia};
  \node[anchor=north west,align=left,text width=\ancB] at (\xc,-4.8) {hay que simular y la historia deja de ser intercambiable};
  \draw[very thick] (-0.1,-6.05) -- (14.9,-6.05);

\end{tikzpicture}
