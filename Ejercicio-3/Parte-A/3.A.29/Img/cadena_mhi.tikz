\begin{tikzpicture}[font=\footnotesize]

% La MISMA operacion leida en dos estructuras demograficas distintas.
%   (a) con generaciones que se suceden: cada delta lo paga la generacion siguiente
%   (b) con un solo decisor: el que tendria que pagar al final es el mismo -> juego de PONZI
% Misma base grafica que cadena_mgs.tikz (eje de fechas y escalera de generaciones).
% Un \\ dentro de un grupo {\scriptsize ...} genera un PDF en blanco: font=\scriptsize como opcion.

% ---------------- panel (a): generaciones que se suceden ----------------
\begin{scope}[xscale=1.30,yscale=0.74]

  \draw[->,thick] (0.35,-1.25) -- (5.1,-1.25) node[right] {tiempo};
  \foreach \x/\lab in {1/$t$,2/{$t+1$},3/{$t+2$},4/{$t+3$}}{
     \draw (\x,-1.17) -- (\x,-1.33);
     \node[below] at (\x,-1.36) {\lab};}

  \node at (2.5,4.35) {\textbf{(a) Con generaciones que se suceden}};

  \draw[very thick,fill=black!7,rounded corners=2pt] (0.76,3.08) rectangle (1.24,3.52);
  \node at (1,3.30) {$V$};
  \node[left] at (0.70,3.30) {$G_{0}$};

  \foreach \i/\y/\xj in {1/2.2/1, 2/1.1/2, 3/0.0/3}{
     \draw[very thick,fill=black!3,rounded corners=2pt] (\xj-0.24,\y-0.22) rectangle (\xj+1.24,\y+0.22);
     \node at (\xj,\y) {$J$};
     \node at (\xj+1,\y) {$V$};
     \node[left] at (\xj-0.30,\y) {$G_{\i}$};}

  \foreach \x/\yb/\ya in {1/2.44/3.04, 2/1.34/1.94, 3/0.24/0.84}{
     \draw[-{Stealth[length=5pt]},very thick] (\x,\yb) -- (\x,\ya);
     \node[right] at (\x+0.06,{(\yb+\ya)/2}) {$\delta$};}

  \draw[dotted,very thick] (4.38,-0.22) -- (4.62,-0.46);
  \node at (4.80,-0.66) {$\ddots$};

  \node[font=\scriptsize,align=center,text width=4.6cm] at (2.5,-2.45)
       {cada $\delta$ lo paga la generación siguiente};

\end{scope}

% ---------------- panel (b): un solo decisor ----------------
\begin{scope}[xshift=8.1cm,xscale=1.30,yscale=0.74]

  \draw[->,thick] (0.35,-1.25) -- (5.1,-1.25) node[right] {tiempo};
  \foreach \x/\lab in {1/$t$,2/{$t+1$},3/{$t+2$},4/{$t+3$}}{
     \draw (\x,-1.17) -- (\x,-1.33);
     \node[below] at (\x,-1.36) {\lab};}

  \node at (2.5,4.35) {\textbf{(b) Con un solo decisor}};

  % el mismo agente en todas las fechas
  \draw[very thick,fill=black!3,rounded corners=2pt] (0.76,1.98) rectangle (4.24,2.42);
  \foreach \x in {1.5,2.5,3.5}{\draw[thin,black!35] (\x,1.98) -- (\x,2.42);}
  \node[left] at (0.70,2.20) {$A$};

  % adelantar consumo contra la fecha siguiente: la deuda se renueva y nunca se amortiza
  \foreach \x in {1,2,3}{
     \draw[-{Stealth[length=5pt]},very thick] (\x+1,1.42) -- (\x,1.42);
     \node[below] at (\x+0.5,1.38) {$\delta$};}

  \draw[dotted,very thick] (4.30,1.42) -- (4.80,1.42);
  \node at (5.00,1.42) {$\cdots$};

  \node[font=\scriptsize,align=center,text width=5.1cm] at (2.5,-2.45)
       {$\neq$ cada $\delta$ lo paga él mismo $\Rightarrow$ juego de PONZI};

\end{scope}

\end{tikzpicture}
