\begin{tikzpicture}[xscale=0.80,yscale=1.18,font=\footnotesize]

  % ---- ejes ----
  \draw[->,thick] (0,0) -- (13.2,0) node[right] {$k$};
  \draw[->,thick] (0,0) -- (0,4.9) node[above] {$c$};

  % ---- locus k punto = 0 :  c = 3,2 sqrt(k) - 0,8 k ----
  \draw[very thick,domain=0.02:12.6,samples=140,smooth,variable=\x]
        plot ({\x},{3.2*sqrt(\x)-0.8*\x});
  \node[right] at (12.7,{3.2*sqrt(12.6)-0.8*12.6}) {$\dot k=0$};

  % ---- locus c punto = 0 : vertical en k* = 2 ----
  \draw[very thick] (2,0) -- (2,4.75);
  \node[above] at (2,4.75) {$\dot c=0$};

  % ---- senda de silla ----
  \draw[very thick,dash pattern=on 5pt off 2.5pt]
        plot[smooth,tension=0.7]
        coordinates {(0.3,0.75) (1,1.95) (2,2.925) (4,3.55) (7,3.95) (10.5,4.2) (12.3,4.3)};
  \node[above] at (8.6,4.02) {senda de silla};

  % ---- estado estacionario ----
  \fill (2,2.925) circle (2.4pt);
  \node[above left] at (1.94,2.99) {$E$};
  \draw[dotted,gray] (0,2.925) -- (2,2.925);
  \node[left] at (0,2.925) {$c^{*}$};
  \node[below] at (2,-0.1) {$k^{*}$};

  % ---- punto de partida sobre la senda ----
  \draw[dotted,gray] (1,0) -- (1,1.95);
  \node[below] at (1,-0.1) {$k_0$};
  \fill (1,1.95) circle (2pt);
  \node[left] at (0.88,1.95) {$c_0$};

  % ---- trayectorias divergentes ----
  % A: arranca por encima de la senda
  \draw[thick,dotted,-{Stealth[length=5pt]}]
        plot[smooth,tension=0.8] coordinates {(1,2.6) (0.78,3.2) (0.55,3.9) (0.4,4.55)};
  \fill (1,2.6) circle (1.8pt);
  \node[right] at (1.12,2.62) {$A$};

  % B: arranca por debajo de la senda
  \draw[thick,dotted,-{Stealth[length=5pt]}]
        plot[smooth,tension=0.8] coordinates {(1,1.4) (2,1.75) (4,1.8) (7,1.3) (9.6,0.45)};
  \fill (1,1.4) circle (1.8pt);
  \node[below left] at (1.05,1.34) {$B$};

  % ---- flechas de region ----
  \draw[-{Stealth[length=4pt]},gray] (1.45,0.75) -- (1.85,0.75);
  \draw[-{Stealth[length=4pt]},gray] (1.45,0.75) -- (1.45,1.1);
  \draw[-{Stealth[length=4pt]},gray] (1.35,3.75) -- (0.95,3.75);
  \draw[-{Stealth[length=4pt]},gray] (1.35,3.75) -- (1.35,4.1);
  \draw[-{Stealth[length=4pt]},gray] (4.8,0.75) -- (5.2,0.75);
  \draw[-{Stealth[length=4pt]},gray] (4.8,0.75) -- (4.8,0.4);
  \draw[-{Stealth[length=4pt]},gray] (11.1,3.15) -- (10.7,3.15);
  \draw[-{Stealth[length=4pt]},gray] (11.1,3.15) -- (11.1,2.8);

\end{tikzpicture}
