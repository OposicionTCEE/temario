\begin{tikzpicture}[xscale=1.55,yscale=1.3,font=\footnotesize]

  % ---- ejes ----
  \draw[->,thick] (0,0) -- (6.7,0) node[right] {$k$};
  \draw[->,thick] (0,0) -- (0,4.3) node[above] {$c$};

  % ---- locus k punto = 0 :  c = 3,6 sqrt(k) - 1,15 k ----
  \draw[very thick,domain=0.02:6.4,samples=120,smooth,variable=\x]
        plot ({\x},{3.6*sqrt(\x)-1.15*\x});
  \node[right] at (6.42,{3.6*sqrt(6.4)-1.15*6.4}) {$\dot k=0$};

  % ---- locus c punto = 0 : vertical en k* = 1 ----
  \draw[very thick] (1,0) -- (1,4.15);
  \node[above] at (1,4.15) {$\dot c=0$};

  % ---- estado estacionario ----
  \fill (1,2.45) circle (2.2pt);
  \node[above right] at (1.06,2.47) {$E$};
  \draw[dotted,gray] (0,2.45) -- (1,2.45);
  \node[left] at (0,2.45) {$c^{*}$};
  \node[below] at (1,-0.08) {$k^{*}$};

  % ---- senda de silla ----
  \draw[very thick,dash pattern=on 5pt off 2.5pt]
        plot[smooth,tension=0.7] coordinates {(0.12,0.95) (0.5,1.85) (1,2.45) (2,2.95) (3.4,3.25) (4.9,3.48)};
  \node[below right] at (4.1,3.33) {senda de silla};

  % ---- trayectorias divergentes desde k0 ----
  \draw[dotted,gray] (0.5,0) -- (0.5,1.85);
  \node[below] at (0.5,-0.08) {$k_0$};
  \fill (0.5,1.85) circle (1.9pt);
  \node[left] at (0.42,1.9) {$c_0$};

  % A: arranca por encima de la senda
  \draw[thick,dotted,-{Stealth[length=5pt]}]
        plot[smooth,tension=0.8] coordinates {(0.5,2.35) (0.38,2.95) (0.22,3.55) (0.13,4.0)};
  \fill (0.5,2.35) circle (1.6pt);
  \node[right] at (0.57,2.3) {$A$};

  % B: arranca por debajo de la senda
  \draw[thick,dotted,-{Stealth[length=5pt]}]
        plot[smooth,tension=0.8] coordinates {(0.5,1.35) (1.3,1.75) (2.6,1.6) (4.0,1.0) (4.9,0.42)};
  \fill (0.5,1.35) circle (1.6pt);
  \node[right] at (0.57,1.3) {$B$};

  % ---- flechas de region ----
  \draw[-{Stealth[length=4pt]},gray] (0.62,0.78) -- (0.86,0.78);
  \draw[-{Stealth[length=4pt]},gray] (0.62,0.78) -- (0.62,1.08);
  \draw[-{Stealth[length=4pt]},gray] (0.68,3.35) -- (0.44,3.35);
  \draw[-{Stealth[length=4pt]},gray] (0.68,3.35) -- (0.68,3.65);
  \draw[-{Stealth[length=4pt]},gray] (3.3,0.95) -- (3.54,0.95);
  \draw[-{Stealth[length=4pt]},gray] (3.3,0.95) -- (3.3,0.65);
  \draw[-{Stealth[length=4pt]},gray] (4.3,3.75) -- (4.06,3.75);
  \draw[-{Stealth[length=4pt]},gray] (4.3,3.75) -- (4.3,3.45);

\end{tikzpicture}
