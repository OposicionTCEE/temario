\begin{tikzpicture}[xscale=2.0,yscale=1.5,font=\footnotesize]

  % ---- ejes ----
  \draw[->,thick] (0,0) -- (5.75,0) node[right] {$k$};
  \draw[->,thick] (0,0) -- (0,3.65) node[above] {$c$};

  % ---- locus k punto = 0 :  c = 3 k^0,4 - 0,75 k ----
  \draw[very thick,domain=0.01:5.5,samples=160,smooth,variable=\x]
        plot ({\x},{3*pow(\x,0.4)-0.75*\x});
  \node[right] at (5.55,{3*pow(5.5,0.4)-0.75*5.5}) {$\dot k=0$};

  % ---- locus c punto = 0 : vertical en k* = 1,4 ----
  \draw[very thick] (1.4,0) -- (1.4,3.5);
  \node[above] at (1.4,3.5) {$\dot c=0$};

  % ---- senda de silla ----
  \draw[very thick,dash pattern=on 5pt off 2.5pt]
        plot[smooth,tension=0.7]
        coordinates {(0.15,0.55) (0.4,1.25) (0.7,1.78) (1.4,2.382) (2.3,2.72) (3.5,2.95) (5.3,3.17)};
  \node[above] at (3.3,3.12) {senda de silla};

  % ---- estado estacionario ----
  \node[circle,fill,inner sep=1.7pt] at (1.4,2.382) {};
  \node[above left] at (1.33,2.42) {$E$};
  \draw[dotted,gray] (0,2.382) -- (1.4,2.382);
  \node[left] at (0,2.382) {$c^{*}$};
  \node[below] at (1.4,-0.09) {$k^{*}$};

  % ---- punto de partida sobre la senda ----
  \draw[dotted,gray] (0.7,0) -- (0.7,1.78);
  \node[below] at (0.7,-0.09) {$k_0$};
  \node[circle,fill,inner sep=1.5pt] at (0.7,1.78) {};
  \node[right] at (0.76,1.70) {$c_0$};

  % ---- trayectorias divergentes ----
  % A: arranca por encima de la senda
  \draw[thick,dotted,-{Stealth[length=5pt]}]
        plot[smooth,tension=0.8] coordinates {(0.7,2.22) (0.55,2.68) (0.4,3.08) (0.3,3.42)};
  \node[circle,fill,inner sep=1.4pt] at (0.7,2.22) {};
  \node[right] at (0.78,2.23) {$A$};

  % B: arranca por debajo de la senda
  \draw[thick,dotted,-{Stealth[length=5pt]}]
        plot[smooth,tension=0.8] coordinates {(0.7,1.35) (1.4,1.6) (2.4,1.6) (3.6,1.2) (4.7,0.5)};
  \node[circle,fill,inner sep=1.4pt] at (0.7,1.35) {};
  \node[below] at (0.68,1.28) {$B$};

  % ---- flechas de region ----
  \draw[-{Stealth[length=4pt]},gray] (1.0,0.85) -- (1.18,0.85);
  \draw[-{Stealth[length=4pt]},gray] (1.0,0.85) -- (1.0,1.15);
  \draw[-{Stealth[length=4pt]},gray] (1.02,2.95) -- (0.84,2.95);
  \draw[-{Stealth[length=4pt]},gray] (1.02,2.95) -- (1.02,3.25);
  \draw[-{Stealth[length=4pt]},gray] (2.95,0.8) -- (3.13,0.8);
  \draw[-{Stealth[length=4pt]},gray] (2.95,0.8) -- (2.95,0.5);
  \draw[-{Stealth[length=4pt]},gray] (4.45,2.5) -- (4.27,2.5);
  \draw[-{Stealth[length=4pt]},gray] (4.45,2.5) -- (4.45,2.2);

\end{tikzpicture}
