% Figura: secuencia del problema de señalización (bloque 3, «Señalización: ¿cómo puede el informado obtener condiciones mejores?»).
% Sustituye al esquema copiado de los apuntes (EsquemaTemporal_Señalizacion.png). Mismo formato que rm_secuencia y sa_secuencia:
% etapas, información, condiciones de equilibrio, pagos e incentivos y, debajo, lo que se obtiene al resolver.
% Esquema sin datos. Generar con: bash Code/generar_figura.sh sa_senal_secuencia
\begin{tikzpicture}[font=\scriptsize, >={Stealth[length=4pt]},
    celda/.style={align=center, text width=2.4cm, inner sep=1pt},
    fila/.style={font=\scriptsize\bfseries, align=right, anchor=east, text width=1.5cm}]
  % Zona de información asimétrica: hasta que los principales observan la señal.
  \fill[gray!14] (0.15,-3.75) rectangle (5.28,0.25);
  \node[font=\scriptsize\itshape, anchor=south west] at (0.2,-3.73) {el principal no conoce $\theta$};
  % Eje temporal.
  \draw[->, thick] (0,0) -- (13.45,0) node[right] {$t$};
  \foreach \x/\n/\t in {1.3/1/{La naturaleza\\ asigna el tipo $\theta$}, 3.95/2/{El agente elige\\ su señal $e$}, 6.6/3/{Los principales observan $e$ y revisan sus creencias}, 9.25/4/{Los principales\\ ofrecen $w(e)$}, 11.9/5/{El agente acepta\\ y se le paga}} {
    \draw[thick] (\x,0.12) -- (\x,-0.12);
    \node[celda, font=\scriptsize\bfseries, anchor=south] at (\x,0.3) {\n. \t};
  }
  % Filas.
  \node[fila] at (0.1,-0.95) {Información};
  \node[fila] at (0.1,-1.95) {Condición de equilibrio};
  \node[fila] at (0.1,-2.95) {Pagos e\\ incentivos};
  \foreach \y in {-1.45,-2.45} \draw[gray!50] (0.15,\y) -- (13.3,\y);
  % Información.
  \node[celda] at (1.3,-0.95) {solo el agente conoce su productividad $\theta$};
  \node[celda] at (3.95,-0.95) {la señal es observable};
  \node[celda] at (6.6,-0.95) {creencias sobre $\theta$ según la señal};
  \node[celda] at (9.25,-0.95) {---};
  \node[celda] at (11.9,-0.95) {---};
  % Condiciones de equilibrio.
  \node[celda] at (1.3,-1.95) {---};
  \node[celda] at (3.95,-1.95) {cada tipo elige el $e$ que maximiza $w(e)-c(e,\theta)$};
  \node[celda] at (6.6,-1.95) {creencias coherentes con lo que hace cada tipo (BAYES)};
  \node[celda] at (9.25,-1.95) {beneficio nulo: $w(e)=\mathbb E[\theta\mid e]$};
  \node[celda] at (11.9,-1.95) {---};
  % Pagos e incentivos.
  \node[celda] at (1.3,-2.95) {---};
  \node[celda] at (3.95,-2.95) {la señal cuesta menos al tipo productivo (cruce único)};
  \node[celda] at (6.6,-2.95) {---};
  \node[celda] at (9.25,-2.95) {el salario depende de la señal};
  \node[celda] at (11.9,-2.95) {el tipo productivo soporta el coste de la señal};
  % Lo que se obtiene al resolver.
  \node[draw, rounded corners=2pt, align=left, text width=14.7cm, inner sep=4pt, anchor=north west, font=\scriptsize] at (-1.5,-3.95) {\textbf{Al resolver el problema:} (i) hay equilibrios separadores, en los que cada tipo emite una señal distinta, y son muchos, uno para cada señal entre dos umbrales; (ii) hay equilibrios agrupadores, en los que todos emiten la misma señal; (iii) el criterio intuitivo selecciona el separador más barato; (iv) la señal no crea valor: es un coste para distinguirse. Resultado: un \textit{second best}.};
\end{tikzpicture}
