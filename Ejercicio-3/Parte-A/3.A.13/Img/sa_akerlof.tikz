% Figura: el mercado de AKERLOF (1970) (anexo I, «El punto de partida: el mercado de AKERLOF»).
% Calidad θ uniforme; el vendedor valora su coche en θ y el comprador en βθ, con 1 < β < 2. A un precio p solo venden
% quienes tienen θ ≤ p, y el comprador está dispuesto a pagar β·E[θ | θ ≤ p].
% (a) θ uniforme en [0, θ̄]: la disposición a pagar, βp/2, queda siempre por debajo del precio: no hay comercio.
% (b) θ uniforme en [θ_min, θ̄]: equilibrio con mercado parcial en p* = βθ_min/(2-β); las calidades superiores a p* se retiran.
% Rectas ilustrativas (β = 1,5; en (b) θ_min = 1, θ̄ = 5), sin datos. Generar con: bash Code/generar_figura.sh sa_akerlof
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  \def\S{6.6}
  \foreach \i/\titulo in {0/{(a) El mercado desaparece}, 1/{(b) Solo se venden las peores calidades}} {
    \begin{scope}[xshift=\i*\S cm, x=0.78cm, y=0.78cm]
      \draw[->] (0,0) -- (5.9,0) node[below] {$p$};
      \draw[->] (0,0) -- (0,5.6);
      \node[font=\footnotesize\bfseries, anchor=south] at (2.9,5.7) {\titulo};
      \draw[dotted, thick] (0,0) -- (5.3,5.3) node[above, font=\scriptsize] {precio $p$};
    \end{scope}
  }
  % (a) Calidad mínima nula.
  \begin{scope}[x=0.78cm, y=0.78cm]
    \draw[very thick] (0,0) -- (5.3,3.975) node[right, align=left, font=\scriptsize] {$\beta\,\mathbb E[\theta\mid\theta\le p]$\\$=\beta p/2$};
    \node[align=center, font=\scriptsize] at (3.4,1.2) {a cualquier precio, el\\ comprador paga menos\\ de lo que se pide};
    \draw (5,0.08) -- (5,-0.08) node[below] {$\bar\theta$};
  \end{scope}
  % (b) Calidad mínima positiva: equilibrio parcial en p*.
  \begin{scope}[xshift=\S cm, x=0.78cm, y=0.78cm]
    \draw[very thick] (1,1.5) -- (5.3,4.725) node[right, font=\scriptsize] {$\beta\,\mathbb E[\theta\mid\theta\le p]$};
    \draw[dashed] (3,3) -- (3,0) node[below] {$p^{*}$};
    \fill (3,3) circle (1.5pt);
    \draw (1,0.08) -- (1,-0.08) node[below] {$\theta_{min}$};
    \draw (5,0.08) -- (5,-0.08) node[below] {$\bar\theta$};
    \draw[decorate, decoration={brace, amplitude=3pt, mirror}] (3.05,-0.55) -- (4.95,-0.55) node[midway, below=3pt, font=\scriptsize] {se retiran};
  \end{scope}
\end{tikzpicture}
