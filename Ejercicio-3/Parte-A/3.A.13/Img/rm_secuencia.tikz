% Figura: secuencia del problema de riesgo moral con acción oculta (bloque 2, «Acción oculta: ¿cuál es la secuencia del problema?»).
% Sustituye al esquema copiado de los apuntes (Esquem_Temporal_RM_AccionOculta.png). Para cada etapa: qué ocurre, qué
% información tiene cada parte, qué restricción actúa y cómo intervienen pagos e incentivos; debajo, lo que se obtiene al
% resolver el problema (apartado «Propiedades»). Esquema sin datos. Generar con: bash Code/generar_figura.sh rm_secuencia
\begin{tikzpicture}[font=\scriptsize, >={Stealth[length=4pt]},
    celda/.style={align=center, text width=2.4cm, inner sep=1pt},
    fila/.style={font=\scriptsize\bfseries, align=right, anchor=east, text width=1.5cm}]
  % Zona de información asimétrica: desde que el agente elige su esfuerzo.
  \fill[gray!14] (5.28,-3.55) rectangle (13.3,0.25);
  \node[font=\scriptsize\itshape, anchor=north east] at (13.25,-0.1) {información asimétrica: el principal no ve $e$};
  % Eje temporal.
  \draw[->, thick] (0,0) -- (13.45,0) node[right] {$t$};
  \foreach \x/\n/\t in {1.3/1/{El principal\\ propone $w(x)$}, 3.95/2/{El agente acepta\\ o rechaza}, 6.6/3/{El agente\\ elige su esfuerzo $e$}, 9.25/4/{La naturaleza\\ fija el resultado $x$}, 11.9/5/{Se paga\\ $w(x)$}} {
    \draw[thick] (\x,0.12) -- (\x,-0.12);
    \node[celda, font=\scriptsize\bfseries, anchor=south] at (\x,0.3) {\n. \t};
  }
  % Filas.
  \node[fila] at (0.1,-0.8) {Información};
  \node[fila] at (0.1,-1.85) {Restricción};
  \node[fila] at (0.1,-2.9) {Pagos e\\ incentivos};
  \foreach \y in {-1.32,-2.37} \draw[gray!50] (0.15,\y) -- (13.3,\y);
  % Información.
  \node[celda] at (1.3,-0.8) {ambos conocen $f(x\mid e)$, $u$, $\psi$ y $\bar U$};
  \node[celda] at (3.95,-0.8) {información simétrica};
  \node[celda] at (6.6,-0.8) {solo el agente observa $e$};
  \node[celda] at (9.25,-0.8) {ambos observan $x$, que es verificable};
  \node[celda] at (11.9,-0.8) {$e$ sigue oculto};
  % Restricciones.
  \node[celda] at (1.3,-1.85) {el principal anticipa la RP y la RCI};
  \node[celda] at (3.95,-1.85) {\textbf{RP}: $\mathbb E[u(w)]-\psi(e)\ge\bar U$};
  \node[celda] at (6.6,-1.85) {\textbf{RCI}: el agente elige el $e$ que más le conviene};
  \node[celda] at (9.25,-1.85) {$x$ depende de $e$, pero con ruido};
  \node[celda] at (11.9,-1.85) {---};
  % Pagos e incentivos.
  \node[celda] at (1.3,-2.9) {$w$ solo puede depender de lo verificable: $x$};
  \node[celda] at (3.95,-2.9) {---};
  \node[celda] at (6.6,-2.9) {se esfuerza según cuánto varía $w$ con $x$};
  \node[celda] at (9.25,-2.9) {---};
  \node[celda] at (11.9,-2.9) {si $w$ varía con $x$, el agente soporta riesgo};
  % Lo que se obtiene al resolver.
  \node[draw, rounded corners=2pt, align=left, text width=14.7cm, inner sep=4pt, anchor=north west, font=\scriptsize] at (-1.5,-3.8) {\textbf{Al resolver el problema:} (i) el pago depende del resultado y el agente soporta riesgo; (ii) la RP se satura: el agente recibe su utilidad de reserva, y lo que cobra de más es una prima de riesgo, no una renta; (iii) se paga según lo que $x$ revela sobre $e$; (iv) sin aversión al riesgo (ni límites a la riqueza del agente) no hay problema. Resultado: un \textit{second best}.};
\end{tikzpicture}
