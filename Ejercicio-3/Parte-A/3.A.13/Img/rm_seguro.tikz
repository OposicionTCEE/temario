% Figura: riesgo moral en el seguro (bloque 2, «Ejemplo: el seguro con cuidado oculto»).
% Plano (w_na, w_a): riqueza sin siniestro y con siniestro, el mismo que se usa en la selección adversa (ROTHSCHILD-STIGLITZ).
% Los dos ejes empiezan en el MISMO valor (3,2) y tienen la misma escala, de modo que la diagonal w_a = w_na es la
% bisectriz del cuadrante dibujado (nota del usuario, 19/10/2026).
% E: sin seguro. Rectas de prima justa desde E con cuidado alto (pendiente -(1-π^H)/π^H, continua) y bajo (discontinua).
% (a) Cuidado observable: seguro completo con cuidado alto, F^H (tangencia sobre la diagonal).
% (b) Cuidado oculto: con seguro completo el asegurado no se cuida (F^L); para inducir el cuidado hace falta estar por debajo
%     de la RCI, u(w_na) - u(w_a) = Δψ/(π^L - π^H): contrato S, seguro parcial con franquicia D. F^H ya no es alcanzable.
% Curvas trazadas con u(w) = -1/w; ilustrativas, sin datos. Generar con: bash Code/generar_figura.sh rm_seguro
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  \def\S{6.1}  % separación horizontal entre paneles (cm)
  \foreach \i/\titulo in {0/{(a) Cuidado observable: seguro completo}, 1/{(b) Cuidado oculto: franquicia}} {
    \begin{scope}[xshift=\i*\S cm, x=0.62cm, y=0.62cm, shift={(-3.2,-3.2)}]
      \draw[->] (3.2,3.2) -- (11.3,3.2) node[below] {$w_{na}$};
      \draw[->] (3.2,3.2) -- (3.2,11.1) node[left] {$w_a$};
      \node[font=\footnotesize\bfseries, anchor=south] at (7.2,11.2) {\titulo};
      \draw[dotted] (3.2,3.2) -- (10.7,10.7) node[right, font=\scriptsize] {$w_a=w_{na}$};
      % Rectas de prima justa desde la situación sin seguro, E.
      \draw (8.4,10.4) -- (10,4);
      \draw[dashed] (5.5,10.75) -- (10,4);
      \fill (10,4) circle (1.5pt) node[below right] {$E$};
    \end{scope}
  }
  % (a) Cuidado observable: tangencia en F^H.
  \begin{scope}[x=0.62cm, y=0.62cm, shift={(-3.2,-3.2)}]
    \draw[gray, thick, domain=8.42:10.6, samples=60] plot (\x, {0.2/(0.11364-0.8/\x)});
    \fill (8.8,8.8) circle (1.6pt) node[left] {$F^H$};
    \fill (7.6,7.6) circle (1.6pt) node[left] {$F^L$};
  \end{scope}
  % (b) Cuidado oculto: RCI y contrato S con franquicia D.
  \begin{scope}[xshift=\S cm, x=0.62cm, y=0.62cm, shift={(-3.2,-3.2)}]
    \draw[very thick, domain=4.6:10.9, samples=50] plot (\x, {\x/(1+0.03019*\x)}) node[right] {RCI};
    \draw[gray, thick, domain=8.45:10.6, samples=60] plot (\x, {0.2/(0.11473-0.8/\x)});
    \draw (8.8,8.8) circle (1.6pt) node[left] {$F^H$};
    \fill (7.6,7.6) circle (1.6pt) node[left] {$F^L$};
    \fill (9.2,7.2) circle (1.6pt) node[below right] {$S$};
    \draw[decorate, decoration={brace, amplitude=3pt, mirror}] (9.3,7.2) -- (9.3,9.2) node[midway, right=2pt] {$D$};
  \end{scope}
  % Leyenda común.
  \node[align=center] at ({(\S+5.0)/2},-1.0) {Rectas de prima justa con cuidado alto (continua) y bajo (discontinua). Gris: curva de indiferencia del asegurado con cuidado alto.\\[0.2em] RCI: $u(w_{na})-u(w_a)=(\psi^H-\psi^L)/(\pi^L-\pi^H)$ \qquad $D$: franquicia \qquad $F^H$ en (b): ya no es alcanzable};
\end{tikzpicture}
