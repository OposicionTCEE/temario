% Figura: el valor de la información (bloque 1, «El valor de la información»).
% Dos estados; p = probabilidad del estado favorable. U_1 y U_2: utilidad esperada de cada decisión (rectas en p);
% V(p) = envolvente superior (convexa). Una señal lleva la creencia inicial p_0 a p_L o p_H, cuya media ponderada es p_0;
% decidir tras la señal rinde un punto de la cuerda, y su distancia a V(p_0) es el valor de la información.
% (a) las creencias revisadas caen en tramos distintos: la señal cambia la decisión y tiene valor;
% (b) caen en el mismo tramo: la decisión no cambia y la señal no vale nada. Curvas ilustrativas, sin datos.
% Generar con: bash Code/generar_figura.sh valor_informacion
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  \def\W{5.0}  % ancho de cada eje (p de 0 a 1)
  \def\H{3.7}  % alto de cada eje
  \def\S{7.3}  % separación horizontal entre paneles
  \foreach \i/\titulo in {0/{(a) La señal cambia la decisión}, 1/{(b) La señal no cambia la decisión}} {
    \begin{scope}[xshift=\i*\S cm]
      \draw[->] (0,0) -- (\W+0.35,0) node[below] {$p$};
      \draw[->] (0,0) -- (0,\H) node[above] {Utilidad esperada};
      \node[below] at (0,0) {$0$};
      \draw (\W,0.06) -- (\W,-0.06) node[below] {$1$};
      \node[font=\footnotesize\bfseries, anchor=south] at (\W/2,\H+0.4) {\titulo};
      % Utilidad esperada de cada decisión: rectas en p.
      \draw[gray] (0,1.5) -- (\W,1.8) node[right, black] {$U_1(p)$};
      \draw[gray] (0,0.2) -- (\W,3.4) node[right, black] {$U_2(p)$};
      % Valor de decidir óptimamente: envolvente superior, convexa.
      \draw[very thick] (0,1.5) -- (2.241,1.634) -- (\W,3.4);
      \node[below] at (1.25,1.53) {$V(p)$};
      % Creencia a partir de la cual conviene cambiar de decisión.
      \draw[dotted] (2.241,1.634) -- (2.241,0) node[below] {$\hat p$};
    \end{scope}
  }
  % (a) Creencias revisadas a ambos lados de p^: la cuerda queda por encima de V(p_0).
  \draw[dashed] (0.7,1.542) -- (4.5,3.08);
  \draw[densely dotted] (0.7,1.542) -- (0.7,0) node[below] {$p_L$};
  \draw[densely dotted] (4.5,3.08) -- (4.5,0) node[below] {$p_H$};
  \draw[densely dotted] (2.9,2.432) -- (2.9,0) node[below] {$p_0$};
  \foreach \p in {(0.7,1.542), (4.5,3.08), (2.9,2.056), (2.9,2.432)} \fill \p circle (1.4pt);
  \draw[decorate, decoration={brace, amplitude=3pt}] (2.82,2.056) -- (2.82,2.432);
  \node[align=center, anchor=east] (va) at (2.55,2.95) {valor de la\\ información};
  \draw[->] (va.south east) -- (2.7,2.27);
  % (b) Creencias revisadas en el mismo tramo: la cuerda coincide con V y el valor es nulo.
  \begin{scope}[xshift=\S cm]
    \draw[densely dotted] (3.0,2.12) -- (3.0,0) node[below] {$p_L$};
    \draw[densely dotted] (4.6,3.144) -- (4.6,0) node[below] {$p_H$};
    \draw[densely dotted] (3.8,2.632) -- (3.8,0) node[below] {$p_0$};
    \foreach \p in {(3.0,2.12), (4.6,3.144), (3.8,2.632)} \fill \p circle (1.4pt);
    \node[align=center, anchor=east] (vn) at (2.9,2.95) {la cuerda coincide con $V$:\\ valor nulo};
    \draw[->] (vn.south east) -- (3.72,2.66);
  \end{scope}
  % Leyenda común.
  \node[align=center] at ({(\S+\W)/2},-1.0) {$U_1$: producir poco \qquad $U_2$: producir mucho \qquad $V(p)=\max\{U_1(p),\,U_2(p)\}$ \qquad $p_0=\lambda\,p_H+(1-\lambda)\,p_L$};
\end{tikzpicture}
