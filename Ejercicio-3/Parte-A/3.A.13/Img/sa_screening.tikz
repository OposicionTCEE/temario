% Figura: filtrado con un principal monopolista y dos tipos (anexo I, «El filtrado con un principal monopolista»).
% Plano (e, w): esfuerzo exigido y pago. Utilidad del agente w - ψ(e,θ), con ψ(e,θ) = θe²/2, θ_1 = 1 (eficiente) y θ_2 = 2.
% Curvas de participación w = ψ(e,θ_i); la del eficiente es más plana (cruce único de SPENCE-MIRRLEES).
% Primer óptimo: A^FB, B^FB (hueco). Segundo óptimo: B* (esfuerzo del ineficiente distorsionado a la baja, sin renta) y
% A* (esfuerzo eficiente, sin distorsión en el extremo, sobre la curva de indiferencia del eficiente que pasa por B*: renta R).
% Valores ilustrativos (x(e) = 3e, π = 1/2), sin datos. Generar con: bash Code/generar_figura.sh sa_screening
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1.6cm, y=0.85cm]
  \draw[->] (0,0) -- (3.95,0) node[below] {$e$};
  \draw[->] (0,0) -- (0,7.0) node[left] {$w$};
  % Curvas de participación de cada tipo.
  \draw[gray, thick, domain=0:3.45, samples=40] plot (\x, {0.5*\x*\x}) node[right, black, font=\scriptsize] {RP de $\theta_1$};
  \draw[gray, thick, dashed, domain=0:2.6, samples=40] plot (\x, {\x*\x}) node[above, black, font=\scriptsize] {RP de $\theta_2$};
  % Curva de indiferencia del eficiente que pasa por B*.
  \draw[thick, domain=0:3.5, samples=40] plot (\x, {0.5+0.5*\x*\x}) node[right, font=\scriptsize] {indiferencia de $\theta_1$ por $B^{*}$};
  % Contratos.
  \draw (3,4.5) circle (1.7pt) node[below right] {$A^{FB}$};
  \draw (1.5,2.25) circle (1.7pt) node[left] {$B^{FB}$};
  \fill (3,5) circle (1.7pt) node[above left] {$A^{*}$};
  \fill (1,1) circle (1.7pt) node[below right] {$B^{*}$};
  \draw[->, shorten >=3pt, shorten <=3pt] (1.5,2.25) -- (1,1);
  \node[font=\scriptsize, anchor=east] at (1.2,1.7) {distorsión};
  \draw[decorate, decoration={brace, amplitude=2.5pt}] (3.07,5.0) -- (3.07,4.5);
  \node[font=\scriptsize, anchor=west] at (3.14,4.75) {renta $R$};
  \draw[dotted] (3,0) -- (3,4.5);
  \node[below] at (3,0) {$e_1^{FB}=e_1^{*}$};
  \draw[dotted] (1,0) -- (1,1); \node[below] at (1,0) {$e_2^{*}$};
  \draw[dotted] (1.5,0) -- (1.5,2.25); \node[below] at (1.55,0) {$e_2^{FB}$};
\end{tikzpicture}
