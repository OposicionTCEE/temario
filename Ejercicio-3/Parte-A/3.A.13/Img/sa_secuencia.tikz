% Figura: secuencia del problema de selección adversa con filtrado (bloque 3, «Problema: ¿un mismo precio para tipos distintos?»).
% Sustituye al esquema copiado de los apuntes (EsquemaTemporal_SA.png). Mismo formato que rm_secuencia: etapas, información,
% restricciones, pagos e incentivos y, debajo, lo que se obtiene al resolver. A diferencia del riesgo moral, la asimetría
% existe desde el principio y la elección del contrato revela el tipo. Esquema sin datos.
% Generar con: bash Code/generar_figura.sh sa_secuencia
\begin{tikzpicture}[font=\scriptsize, >={Stealth[length=4pt]},
    celda/.style={align=center, text width=2.4cm, inner sep=1pt},
    fila/.style={font=\scriptsize\bfseries, align=right, anchor=east, text width=1.5cm}]
  % Zona de información asimétrica: desde el principio hasta que la elección revela el tipo.
  \fill[gray!14] (0.15,-3.55) rectangle (7.95,0.25);
  \node[font=\scriptsize\itshape, anchor=north west] at (0.2,-0.1) {información asimétrica: el principal no conoce $\theta$};
  % Eje temporal.
  \draw[->, thick] (0,0) -- (13.45,0) node[right] {$t$};
  \foreach \x/\n/\t in {1.3/1/{La naturaleza\\ asigna el tipo $\theta$}, 3.95/2/{El principal ofrece\\ un menú de contratos}, 6.6/3/{Cada agente\\ elige un contrato}, 9.25/4/{Se ejecuta lo pactado\\ (esfuerzo exigible)}, 11.9/5/{Se paga\\ $w_i$}} {
    \draw[thick] (\x,0.12) -- (\x,-0.12);
    \node[celda, font=\scriptsize\bfseries, anchor=south] at (\x,0.3) {\n. \t};
  }
  % Filas.
  \node[fila] at (0.1,-0.95) {Información};
  \node[fila] at (0.1,-1.95) {Restricción};
  \node[fila] at (0.1,-2.95) {Pagos e\\ incentivos};
  \foreach \y in {-1.45,-2.45} \draw[gray!50] (0.15,\y) -- (13.3,\y);
  % Información.
  \node[celda] at (1.3,-0.95) {solo el agente conoce $\theta$; el principal, su distribución};
  \node[celda] at (3.95,-0.95) {el principal no sabe con quién contrata};
  \node[celda] at (6.6,-0.95) {la elección revela el tipo (autoselección)};
  \node[celda] at (9.25,-0.95) {el esfuerzo es observable y verificable};
  \node[celda] at (11.9,-0.95) {---};
  % Restricciones.
  \node[celda] at (1.3,-1.95) {---};
  \node[celda] at (3.95,-1.95) {el principal anticipa la RP y la RCI de cada tipo};
  \node[celda] at (6.6,-1.95) {\textbf{RP}: quiere participar; \textbf{RCI}: prefiere su contrato al de otro tipo};
  \node[celda] at (9.25,-1.95) {---};
  \node[celda] at (11.9,-1.95) {---};
  % Pagos e incentivos.
  \node[celda] at (1.3,-2.95) {---};
  \node[celda] at (3.95,-2.95) {un par de esfuerzo y pago $(e_i,w_i)$ por tipo};
  \node[celda] at (6.6,-2.95) {cada tipo compara lo que obtiene con cada contrato};
  \node[celda] at (9.25,-2.95) {se exige el esfuerzo pactado};
  \node[celda] at (11.9,-2.95) {quien podría imitar a otro tipo cobra una renta};
  % Lo que se obtiene al resolver.
  \node[draw, rounded corners=2pt, align=left, text width=14.7cm, inner sep=4pt, anchor=north west, font=\scriptsize] at (-1.5,-3.8) {\textbf{Al resolver el problema:} (i) solo el tipo menos deseable queda en su utilidad de reserva; (ii) los demás obtienen una renta de información, lo que ganarían haciéndose pasar por otro tipo; (iii) el principal la reduce distorsionando los contratos de los tipos imitados; (iv) el contrato del tipo al que nadie quiere imitar no se distorsiona; (v) puede convenirle no contratar a los peores. Resultado: un \textit{second best}.};
\end{tikzpicture}
