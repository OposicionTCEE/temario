% Figura: riesgo moral con dos esfuerzos y dos resultados (anexo I, «El caso de dos esfuerzos y dos resultados»).
% Sustituye a las tres PNG dibujadas a mano (RiesgoMoral_EjGrafico, Beneficio_EjRiesgoMoral_Principal, Optimo_Conjunto_RM_EjGrafico).
% Plano (w_2, w_1): pago si sale el resultado alto y si sale el bajo. Agente averso (curvas trazadas con u = raíz cuadrada),
% principal neutral. p^H = 0,7; p^L = 0,3; la RCI es u(w_2) - u(w_1) = Δψ/(p^H - p^L), una CURVA (no una recta) por la aversión.
% (a) El agente: curvas de indiferencia con e^H (continua) y e^L (discontinua), que se cortan sobre la RCI; por encima prefiere e^L.
% (b) El principal: rectas de isobeneficio con e^H y e^L, que se cortan donde su beneficio neto es igual en ambos resultados.
% (c) El contrato óptimo: L y H (primer óptimo, pago fijo) y H' (segundo óptimo con e^H, donde se cortan las dos RP y la RCI).
% Curvas ilustrativas, sin datos. Generar con: bash Code/generar_figura.sh rm_dos_esfuerzos
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  \def\S{5.25}  % separación horizontal entre paneles (cm)
  \foreach \i/\titulo in {0/{(a) El agente}, 1/{(b) El principal}, 2/{(c) El contrato óptimo}} {
    \begin{scope}[xshift=\i*\S cm, x=0.52cm, y=0.55cm]
      \draw[->] (0,0) -- (8.8,0) node[below] {$w_2$};
      \draw[->] (0,0) -- (0,6.4) node[left] {$w_1$};
      \node[font=\footnotesize\bfseries, anchor=south] at (4.2,6.6) {\titulo};
    \end{scope}
  }
  % (a) El agente.
  \begin{scope}[x=0.52cm, y=0.55cm]
    \draw[dotted] (0,0) -- node[pos=0.22, sloped, above, font=\scriptsize] {$w_1=w_2$} (6.2,6.2);
    \draw[thick, domain=2.25:8.5, samples=60] plot (\x, {(sqrt(\x)-1.5)^2}) node[above left, xshift=2pt] {RCI};
    \draw[gray, thick, domain=5.0:8.5, samples=60] plot (\x, {((2.3-0.7*sqrt(\x))/0.3)^2});
    \node[gray, right] at (5.0,6.0) {$e^H$};
    \draw[gray, thick, dashed, domain=0.05:8.5, samples=60] plot (\x, {((1.7-0.3*sqrt(\x))/0.7)^2});
    \node[gray, above] at (0.75,5.6) {$e^L$};
    \fill (4.0,3.0) circle (1.4pt) node[left] {$A$};
    \fill (6.4,0.45) circle (1.4pt) node[left] {$B$};
  \end{scope}
  % (b) El principal.
  \begin{scope}[xshift=\S cm, x=0.52cm, y=0.55cm]
    \draw[dotted] (3,0) -- node[pos=0.86, sloped, below, font=\scriptsize] {$x_2-w_2=x_1-w_1$} (8.5,5.5);
    \draw[very thick, red!70!black, domain=4.72:7.28] plot (\x, {17-2.3333*\x});
    \node[red!70!black, right] at (4.75,5.95) {$\Pi$ con $e^H$};
    \draw[very thick, red!70!black, dashed, domain=0:8.5] plot (\x, {5.5714-0.42857*\x});
    \node[red!70!black, above right] at (0,5.55) {$\Pi$ con $e^L$};
    \fill (6,3) circle (1.4pt);
    \node[align=center, font=\scriptsize] at (2.1,2.0) {prefiere $e^H$};
    \node[align=center, font=\scriptsize] at (7.6,0.75) {prefiere\\ $e^L$};
  \end{scope}
  % (c) El contrato óptimo.
  \begin{scope}[xshift=2*\S cm, x=0.52cm, y=0.55cm]
    \draw[dotted] (0,0) -- (6.2,6.2);
    \draw[thick, domain=2.25:8.5, samples=60] plot (\x, {(sqrt(\x)-1.5)^2});
    \node[above] at (3.7,0.15) {RCI};
    \draw[gray, thick, domain=5.0:8.5, samples=60] plot (\x, {((2.3-0.7*sqrt(\x))/0.3)^2});
    \draw[gray, thick, dashed, domain=0.05:8.5, samples=60] plot (\x, {((1.7-0.3*sqrt(\x))/0.7)^2});
    \node[gray, above] at (0.95,5.6) {RP, $e^L$};
    \node[gray, left] at (5.0,6.0) {RP, $e^H$};
    % Rectas de isobeneficio del principal con e^H por H y por H': la segunda, más alejada del origen, cuesta más.
    \draw[red!70!black, domain=5.0:7.56] plot (\x, {17.633-2.3333*\x});
    \draw[red!70!black, domain=5.66:8.23] plot (\x, {19.21-2.3333*\x});
    \fill (2.89,2.89) circle (1.5pt) node[above left] {$L$};
    \fill (5.29,5.29) circle (1.5pt) node[left] {$H$};
    \fill (7.5625,1.5625) circle (1.5pt) node[below left] {$H'$};
  \end{scope}
  % Leyenda común.
  \node[align=center, font=\footnotesize] at ({\S+2.3},-1.25) {Gris: curvas de indiferencia del agente con $e^H$ (continua) y $e^L$ (discontinua). Rojo: rectas de isobeneficio del principal.\\[0.2em] RCI: $u(w_2)-u(w_1)=\big(\psi(e^H)-\psi(e^L)\big)/(p^H-p^L)$\\[0.2em] $L$, $H$: primer óptimo con esfuerzo bajo y alto \qquad $H'$: segundo óptimo con esfuerzo alto};
\end{tikzpicture}
