% Figura: el seguro con dos tipos de riesgo, ROTHSCHILD y STIGLITZ (1976) (bloque 3, ejemplo de filtrado competitivo).
% Sustituye a las PNG Modelo_ROSTCHILD_STIGLITZ_Seguros, Dist_Utilidad_TipoAgente y NO_POOLINGEq_ROTSCHILD_STIGLITZ.
% Plano (w_na, w_a), el mismo que rm_seguro. E: sin seguro (W = 10, L = 6). Tipo 1, bajo riesgo (π_1 = 0,15); tipo 2,
% alto riesgo (π_2 = 0,5). Rectas de prima justa desde E con pendiente -(1-π)/π; agrupadora con π media.
% Curvas trazadas con u(w) = -1/w: la del bajo riesgo es más inclinada en cada punto (cruce único).
% (a) Agrupador P (λ = 0,5): un contrato P se lee desde E como prima q (hacia la izquierda) e indemnización neta I - q
%     (hacia arriba). La zona sombreada atrae solo al tipo 1 y da beneficio: el agrupador se deshace.
% (b) Separador: C_2, seguro completo para el alto riesgo; C_1, seguro parcial para el bajo riesgo donde el alto es
%     indiferente. Con pocos de bajo riesgo (λ = 0,3) la agrupadora pasa por debajo de la curva del tipo 1 por C_1 y el
%     separador existe; con muchos (λ = 0,9) la corta y no existe equilibrio. Ilustrativa, sin datos.
% Generar con: bash Code/generar_figura.sh sa_rothschild_stiglitz
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  \def\S{7.0}
  \colorlet{tipouno}{blue!65!black}
  \foreach \i/\titulo in {0/{(a) No hay equilibrio agrupador}, 1/{(b) El equilibrio separador}} {
    \begin{scope}[xshift=\i*\S cm, x=0.8cm, y=0.8cm, shift={(-6.3,-3.2)}]
      \draw[->] (6.3,3.2) -- (11.0,3.2) node[below] {$w_{na}$};
      \draw[->] (6.3,3.2) -- (6.3,10.7) node[left] {$w_a$};
      \node[font=\footnotesize\bfseries, anchor=south] at (8.6,10.8) {\titulo};
      \draw[dotted] (6.6,6.6) -- (10.3,10.3) node[right, font=\scriptsize] {$w_a=w_{na}$};
      \draw (10,4) -- (8.941,10) node[above, font=\scriptsize] {1};
      \draw (10,4) -- (6.5,7.5) node[left, font=\scriptsize] {2};
      \fill (10,4) circle (1.5pt) node[below right] {$E$};
    \end{scope}
  }
  % (a) Agrupador y desviación que lo rompe.
  \begin{scope}[x=0.8cm, y=0.8cm, shift={(-6.3,-3.2)}]
    \draw[dashed] (10,4) -- (7.3,9.608) node[above, font=\scriptsize] {media};
    \fill[gray!35] plot[domain=8.6:9.3, samples=30] (\x, {0.5/(0.130520-0.5/\x)}) -- plot[domain=9.3:8.6, samples=30] (\x, {0.15/(0.120551-0.85/\x)}) -- cycle;
    \draw[tipouno, thick, domain=8.06:10.4, samples=60] plot (\x, {0.15/(0.120551-0.85/\x)});
    \draw[gray, thick, domain=6.5:10.5, samples=60] plot (\x, {0.5/(0.130520-0.5/\x)});
    \draw[red!70!black, ->] (10,4) -- node[below, font=\scriptsize] {$q$} (8.6,4);
    \draw[red!70!black, ->] (8.6,4) -- node[left, font=\scriptsize] {$I-q$} (8.6,6.85);
    \fill (8.6,6.908) circle (1.6pt) node[above left] {$P$};
  \end{scope}
  % (b) Separador y su posible inexistencia.
  \begin{scope}[xshift=\S cm, x=0.8cm, y=0.8cm, shift={(-6.3,-3.2)}]
    \draw[dashed] (10,4) -- (6.6,9.207) node[above, font=\scriptsize] {media, $\lambda$ bajo};
    \draw[dash dot] (10,4) -- (8.638,10) node[above left, font=\scriptsize] {$\lambda$ alto};
    \draw[gray, thick, domain=6.4:10.4, samples=60] plot (\x, {1/(0.285714-1/\x)});
    \draw[tipouno, thick, domain=8.53:10.4, samples=60] plot (\x, {0.15/(0.114712-0.85/\x)});
    \draw[line width=2.2pt, gray, opacity=0.45] (8.66,9.903) -- (9.6,5.762);
    \fill (7,7) circle (1.6pt) node[above left] {$C_2$};
    \fill (9.741,5.464) circle (1.6pt) node[below left] {$C_1$};
  \end{scope}
  % Leyenda común.
  \node[align=center] at ({\S/2+1.85},-1.15) {Rectas de prima justa: 1, bajo riesgo; 2, alto riesgo; discontinuas, agrupadoras (prima media). Curvas de indiferencia: azul, bajo riesgo; gris, alto riesgo.\\[0.2em] (a) Desde $E$: prima $q$ e indemnización neta $I-q$. Sombreado: contratos que solo atraen a los de bajo riesgo y dan beneficio.\\[0.2em] (b) Si los de bajo riesgo son muchos ($\lambda$ alto), la agrupadora corta la curva del bajo riesgo por $C_1$ (trazo grueso) y no hay equilibrio.};
\end{tikzpicture}
