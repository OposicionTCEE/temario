% Figura: cómo distinguir la selección adversa del riesgo moral (bloque 4, «Evidencia empírica: cómo distinguirlos»).
% (a) Las dos causas producen la misma correlación positiva entre cobertura y siniestros, con causalidades opuestas.
% (b) Las tres estrategias empíricas y lo que permite cada una. Esquema sin datos.
% Generar con: bash Code/generar_figura.sh b4_identificacion
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]},
    caja/.style={draw, rounded corners=2pt, align=center, inner sep=3pt, minimum height=0.8cm, text width=2.3cm},
    estr/.style={draw, rounded corners=2pt, align=left, inner sep=4pt, text width=6.75cm}]
  % (a) Dos causas, una correlación.
  \node[font=\footnotesize\bfseries] at (3.3,4.75) {(a) Dos causas, una misma correlación};
  \node[font=\scriptsize\bfseries] at (1.4,4.15) {Selección adversa};
  \node[font=\scriptsize\bfseries] at (5.2,4.15) {Riesgo moral};
  \node[caja] (riesgo) at (1.4,3.3) {más riesgo,\\ que solo él conoce};
  \node[caja] (cobA) at (1.4,1.75) {elige más\\ cobertura};
  \node[caja] (cobM) at (5.2,3.3) {tiene más\\ cobertura};
  \node[caja] (cuid) at (5.2,1.75) {pone menos\\ cuidado};
  \draw[->] (riesgo) -- node[left, font=\scriptsize] {causa} (cobA);
  \draw[->] (cobM) -- node[right, font=\scriptsize] {causa} (cuid);
  \node[draw, thick, rounded corners=2pt, align=center, inner sep=4pt, text width=6.0cm] (corr) at (3.3,0.2) {\textbf{más cobertura y más siniestros}\\ la misma correlación positiva};
  \draw[->] (riesgo.west) -- ++(-0.3,0) |- node[pos=0.3, left, font=\scriptsize, align=right] {más\\ siniestros} (corr.west);
  \draw[->] (cobA) -- (corr);
  \draw[->] (cuid) -- (corr);
  % (b) Tres estrategias.
  \node[font=\footnotesize\bfseries, anchor=west] at (7.45,4.75) {(b) Tres estrategias para distinguirlas};
  \node[estr, anchor=north west] (e1) at (7.45,4.35) {\textbf{1. Correlación condicional} {\scriptsize(CHIAPPORI y SALANIÉ, 2000)}\\ {\scriptsize Detecta si hay información asimétrica, pero no cuál de los dos problemas la causa.}};
  \node[estr, anchor=north west] (e2) at (7.45,3.0) {\textbf{2. Dinámica} {\scriptsize(ABBRING, CHIAPPORI y PINQUET, 2003)}\\ {\scriptsize Con riesgo moral, el recargo que sigue a un siniestro aumenta el cuidado y reduce los siniestros siguientes; con selección pura, no.}};
  \node[estr, anchor=north west] (e3) at (7.45,1.45) {\textbf{3. Experimentos} {\scriptsize(RAND; KARLAN y ZINMAN, 2009)}\\ {\scriptsize Si el contrato se asigna al azar, su efecto solo puede deberse al comportamiento, es decir, al riesgo moral.}};
\end{tikzpicture}
