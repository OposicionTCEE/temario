% Figura: cómo distinguir la selección adversa del riesgo moral (bloque 4, «Evidencia empírica: ¿cómo distinguirlos?»).
% (a) Rehecho el 19/10/2026 a petición del usuario («parece la misma causalidad»): los dos problemas producen la misma
%     correlación entre cobertura y siniestros, pero con estructuras causales distintas. Con selección adversa, el riesgo
%     propio causa a la vez la cobertura elegida y los siniestros (la cobertura no causa nada); con riesgo moral, la
%     cobertura causa los siniestros, porque reduce el cuidado.
%     Segunda pasada (19/10/2026): el riesgo moral, en vertical; en las dos columnas la causa va arriba y los siniestros
%     abajo, en la misma fila, para que se lean igual. Cajas más anchas y rótulos fuera de las flechas.
% (b) Las tres estrategias empíricas y lo que permite cada una. Esquema sin datos. Cajas separadas y alineadas con (a).
% Generar con: bash Code/generar_figura.sh b4_identificacion
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]},
    caja/.style={draw, rounded corners=2pt, align=center, inner sep=3pt, minimum height=0.85cm, text width=1.75cm},
    estr/.style={draw, rounded corners=2pt, align=left, inner sep=4pt, text width=7.1cm, execute at begin node={\hyphenpenalty=10000}}]
  % (a) Dos estructuras causales, un mismo dato.
  \node[font=\footnotesize\bfseries] at (3.5,4.75) {(a) Un mismo dato, dos causas distintas};
  \node[font=\scriptsize\bfseries] at (1.8,4.2) {Selección adversa};
  \node[font=\scriptsize\bfseries] at (5.85,4.2) {Riesgo moral};
  \draw[gray!60] (4.4,0.45) -- (4.4,4.4);
  % Selección adversa: causa común (arriba) de la cobertura y de los siniestros (abajo).
  \node[caja, fill=gray!15, text width=2.4cm] (riesgo) at (1.8,3.5) {riesgo propio\\ (solo él lo sabe)};
  \node[caja] (cobA) at (0.6,1.6) {cobertura};
  \node[caja] (sinA) at (3.0,1.6) {siniestros};
  \draw[->, thick] (riesgo) -- node[left, font=\scriptsize] {elige} (cobA);
  \draw[->, thick] (riesgo) -- node[right, font=\scriptsize] {causa} (sinA);
  \draw[<->, dashed] (cobA) -- (sinA);
  \node[font=\scriptsize, align=center] at (1.8,0.8) {correlación sin causalidad\\ entre ellas};
  % Riesgo moral: la cobertura (arriba) causa los siniestros (abajo).
  \node[caja] (cobM) at (5.85,3.5) {cobertura};
  \node[caja] (sinM) at (5.85,1.6) {siniestros};
  \draw[->, thick] (cobM) -- node[right=2pt, font=\scriptsize, align=left] {causa: reduce\\ el cuidado} (sinM);
  \node[font=\scriptsize, align=center] at (5.85,0.8) {la cobertura\\ causa los siniestros};
  % Mismo dato observado.
  \node[draw, thick, rounded corners=2pt, align=center, inner sep=4pt, text width=6.9cm, anchor=north] (obs) at (3.5,0.25) {\textbf{lo que se observa en los dos casos:}\\ quienes tienen más cobertura tienen más siniestros};
  % (b) Tres estrategias, de la misma altura que el panel (a): la primera arriba, la última con la base de (obs) y la
  % segunda en medio, con huecos iguales.
  \node[font=\footnotesize\bfseries, anchor=west] at (7.7,4.75) {(b) Tres estrategias para distinguirlas};
  \node[estr, anchor=north west] (e1) at (7.7,4.35) {\textbf{1. Correlación condicional} {\scriptsize(CHIAPPORI y SALANIÉ, 2000)}\\ {\scriptsize Detecta si hay información asimétrica, pero no cuál de los dos problemas la causa.}};
  \node[estr, anchor=south west] (e3) at (7.7,0 |- obs.south) {\textbf{3. Experimentos} {\scriptsize(RAND; KARLAN y ZINMAN, 2009)}\\ {\scriptsize Si el contrato se asigna al azar, nadie lo ha elegido según su riesgo, y su efecto solo puede deberse al comportamiento.}};
  \node[estr, anchor=west] (e2) at ($(e1.south west)!0.5!(e3.north west)$) {\textbf{2. Dinámica} {\scriptsize(ABBRING, CHIAPPORI y PINQUET, 2003)}\\ {\scriptsize Con riesgo moral, el recargo que sigue a un siniestro aumenta el cuidado y reduce los siniestros siguientes; con selección, un siniestro anuncia más siniestros.}};
\end{tikzpicture}
