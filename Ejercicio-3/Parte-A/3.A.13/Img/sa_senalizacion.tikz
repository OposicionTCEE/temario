% Figura: equilibrios de señalización con dos tipos (anexo I, «La señalización»).
% Plano (e, w): señal (educación) y salario. Productividades θ_L < θ_H; coste de la señal c(e,θ) = e/θ (cruce único:
% al tipo alto le cuesta menos). Las empresas pagan la productividad esperada dadas sus creencias.
% (a) Separadores: el tipo bajo elige e = 0 y cobra θ_L; el alto elige e_H en [e_1, e_2] y cobra θ_H. En e_1 el tipo bajo es
%     indiferente entre imitar o no; en e_2 lo es el alto entre señalizar o no. El criterio intuitivo selecciona e_1.
% (b) Agrupador en e = 0 con salario E[θ]: una desviación a (e', e'') solo compensaría al tipo alto si se le pagara θ_H;
%     con el criterio intuitivo, las empresas deben atribuírsela, y el agrupador se rompe.
% Valores ilustrativos (θ_L = 1, θ_H = 2, E[θ] = 1,6), sin datos. Generar con: bash Code/generar_figura.sh sa_senalizacion
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  \def\S{6.9}
  \foreach \i/\titulo in {0/{(a) Equilibrios separadores}, 1/{(b) Agrupador y criterio intuitivo}} {
    \begin{scope}[xshift=\i*\S cm, x=1.85cm, y=1.55cm]
      \draw[->] (0,0) -- (2.75,0) node[below] {$e$};
      \draw[->] (0,0) -- (0,2.65) node[left] {$w$};
      \node[font=\footnotesize\bfseries, anchor=south] at (1.35,2.7) {\titulo};
      \draw[densely dotted] (0,1) node[left] {$\theta_L$} -- (2.6,1);
      \draw[densely dotted] (0,2) node[left] {$\theta_H$} -- (2.6,2);
    \end{scope}
  }
  % (a) Separadores.
  \begin{scope}[x=1.85cm, y=1.55cm]
    \draw[gray, thick, dashed] (0,1) -- (1.55,2.55) node[above, black, font=\scriptsize] {tipo bajo};
    \draw[gray, thick] (0,1) -- (2.6,2.3) node[right, black, font=\scriptsize] {tipo alto};
    \fill (0,1) circle (1.5pt);
    \fill (1,2) circle (1.5pt); \draw[dotted] (1,0) node[below] {$e_1$} -- (1,2);
    \draw (2,2) circle (1.5pt); \draw[dotted] (2,0) node[below] {$e_2$} -- (2,2);
    \draw[decorate, decoration={brace, amplitude=3pt}] (1,2.12) -- (2,2.12) node[midway, above=2pt, font=\scriptsize] {separadores};
  \end{scope}
  % (b) Agrupador en e = 0 y desviación que lo rompe.
  \begin{scope}[xshift=\S cm, x=1.85cm, y=1.55cm]
    \draw[densely dotted] (0,1.6) node[left] {$\mathbb E[\theta]$} -- (2.6,1.6);
    \draw[gray, thick, dashed] (0,1.6) -- (0.95,2.55) node[above, black, font=\scriptsize] {tipo bajo};
    \draw[gray, thick] (0,1.6) -- (2.0,2.6) node[right, black, font=\scriptsize] {tipo alto};
    \fill (0,1.6) circle (1.5pt);
    \draw[dotted] (0.4,0) node[below] {$e'$} -- (0.4,2);
    \draw[dotted] (0.8,0) node[below] {$e''$} -- (0.8,2);
    \fill[gray!35] (0.4,1.97) rectangle (0.8,2.03);
    \draw[->] (1.45,0.55) node[below, font=\scriptsize, align=center] {solo le compensa\\ al tipo alto} -- (0.62,1.9);
  \end{scope}
\end{tikzpicture}
