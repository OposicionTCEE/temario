%% Cuerpo B3: espiral de amplificación financiera (precios de los activos, patrimonio y garantías, crédito, gasto) y capital de los intermediarios.
%% Generada por Code/libro_y_figuras.py; PDF con: bash Code/generar_figura.sh b3_espiral
\begin{tikzpicture}[font=\footnotesize, caja/.style={draw, rounded corners=2pt, align=center, inner sep=4pt, minimum width=3.2cm, minimum height=1.1cm}]
\node[caja] (pre) at (0,1.9) {Caen los precios\\de los activos};
\node[caja] (pat) at (4.2,0) {Caen el patrimonio de los\\prestatarios y el valor\\de sus garantías};
\node[caja] (cre) at (0,-1.9) {Se encarece y se\\restringe el crédito};
\node[caja] (gas) at (-4.2,0) {Caen la inversión\\y el gasto};
\node[caja, fill=black!8] (per) at (0,3.75) {Una perturbación: cae la\\productividad o sube el tipo de interés};
\node[caja, fill=black!8] (int) at (4.2,-3.4) {Los intermediarios pierden\\capital y prestan menos};
\draw[-{Stealth[length=2.4mm]}, thick] (per) -- (pre);
\draw[-{Stealth[length=2.4mm]}, thick] (pre.east) to[out=0, in=90] (pat.north);
\draw[-{Stealth[length=2.4mm]}, thick] (pat.south) to[out=270, in=0] (cre.east);
\draw[-{Stealth[length=2.4mm]}, thick] (cre.west) to[out=180, in=270] (gas.south);
\draw[-{Stealth[length=2.4mm]}, thick] (gas.north) to[out=90, in=180] (pre.west);
\draw[-{Stealth[length=2.4mm]}, thick, dashed] (pat.south east) to[out=300, in=90] (int.north);
\draw[-{Stealth[length=2.4mm]}, thick, dashed] (int.west) to[out=180, in=300] (cre.south);
\end{tikzpicture}
