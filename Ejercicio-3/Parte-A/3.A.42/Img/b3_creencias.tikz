%% Cuerpo B3: ciclo de las creencias en el mercado de crédito (optimismo, crédito, auge, decepción y corrección).
%% Generada por Code/libro_y_figuras.py; PDF con: bash Code/generar_figura.sh b3_creencias
\begin{tikzpicture}[font=\footnotesize, caja/.style={draw, rounded corners=2pt, align=center, inner sep=4pt, text width=3.1cm, minimum height=1.0cm}]
\node[caja, fill=black!8] (c0) at (0.00,3.30) {Buenas noticias};
\node[caja] (c1) at (3.86,1.65) {Los inversores sobrevaloran los escenarios favorables};
\node[caja] (c2) at (3.86,-1.65) {Los diferenciales caen y el crédito crece en exceso};
\node[caja] (c3) at (0.00,-3.30) {Suben la inversión y los precios de los activos};
\node[caja] (c4) at (-3.86,-1.65) {Las noticias decepcionan y el optimismo se corrige};
\node[caja] (c5) at (-3.86,1.65) {Los diferenciales suben, el crédito se contrae y la actividad se frena};
\draw[-{Stealth[length=2.4mm]}, thick] (c0) -- (c1);
\draw[-{Stealth[length=2.4mm]}, thick] (c1) -- (c2);
\draw[-{Stealth[length=2.4mm]}, thick] (c2) -- (c3);
\draw[-{Stealth[length=2.4mm]}, thick] (c3) -- (c4);
\draw[-{Stealth[length=2.4mm]}, thick] (c4) -- (c5);
\draw[-{Stealth[length=2.4mm]}, thick, dashed] (c5) -- (c0);
