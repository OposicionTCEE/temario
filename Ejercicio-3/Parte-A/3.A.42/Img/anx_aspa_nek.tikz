% Aspa del modelo neokeynesiano de tres ecuaciones en el plano (brecha de producción, inflación), dibujada a mano (A8, 08/11/2026).
% Con perturbaciones autorregresivas de persistencia común, la curva de PHILLIPS (CP, pendiente kappa/(1-delta rho)) y la demanda
% agregada (DA: IS dinámica con la regla de TAYLOR, pendiente -(theta(1-rho)+phi_y)/(phi_pi-rho)) son dos rectas.
% (a) Perturbación de demanda (sube el tipo natural): DA se desplaza a DA_1. (b) Perturbación de costes: CP se desplaza a CP_1;
% A estabiliza la inflación y B la brecha. Sin cifras. Generar con: bash Code/generar_figura.sh anx_aspa_nek
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=2mm]}]
  % ---- (a) perturbación de demanda
  \begin{scope}
    \node at (0,2.55) {(a) Perturbación de demanda};
    \draw[->] (-2.6,0) -- (2.8,0) node[below left] {$\tilde y_t$};
    \draw[->] (0,-1.9) -- (0,2.15) node[below left] {$\pi_t$};
    \draw[thick] (-2.4,-1.2) -- (2.5,1.25) node[above] {$CP$};
    \draw[thick] (-1.5,1.8) -- (1.5,-1.8) node[below] {$DA_0$};
    \draw[thick, black!60, dashed] (-0.3,1.8) -- (2.7,-1.8) node[below] {$DA_1$};
    \draw[->, black!60] (0.75,-0.72) -- (1.65,-0.72);
    \fill (0,0) circle (1.6pt) node[below left] {$E_0$};
    \fill (0.847,0.424) circle (1.6pt) node[above right] {$E_1$};
  \end{scope}
  % ---- (b) perturbación de costes
  \begin{scope}[xshift=7.8cm]
    \node at (0,2.55) {(b) Perturbación de costes};
    \draw[->] (-2.6,0) -- (2.8,0) node[below left] {$\tilde y_t$};
    \draw[->] (0,-1.9) -- (0,2.15) node[below left] {$\pi_t$};
    \draw[thick] (-2.4,-1.2) -- (2.5,1.25) node[right] {$CP_0$};
    \draw[thick, black!60, dashed] (-2.5,-0.25) -- (1.8,1.9) node[right] {$CP_1$};
    \draw[->, black!60] (1.25,0.69) -- (1.25,1.55);
    \draw[thick] (-1.5,1.8) -- (1.5,-1.8) node[below] {$DA$};
    \fill (0,0) circle (1.6pt) node[below right] {$E_0$};
    \fill (-0.588,0.706) circle (1.6pt) node[below left] {$E_1$};
    \fill (-2,0) circle (1.6pt) node[below] {$A$};
    \fill (0,1) circle (1.6pt) node[above left] {$B$};
  \end{scope}
\end{tikzpicture}
