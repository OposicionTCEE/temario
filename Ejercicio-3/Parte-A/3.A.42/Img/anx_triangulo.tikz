% Medidas de HARDING y PAGAN (2002) para una recesión: amplitud A, duración D, pérdida acumulada C y exceso respecto al
% triángulo (área entre la trayectoria y la recta que une el pico con el valle). Sin cifras.
% Generar con: bash Code/generar_figura.sh anx_triangulo
\begin{tikzpicture}[font=\footnotesize, x=1cm, y=1cm]
  \draw[-{Stealth[length=2mm]}] (0,0) -- (9.6,0) node[below left] {tiempo};
  \draw[-{Stealth[length=2mm]}] (0,0) -- (0,4.6) node[left] {$y_t$};
  % pérdida acumulada C: entre el nivel del pico y la trayectoria
  \fill[black!10] (1.5,3.6) -- (7.5,3.6) -- (7.5,1.0) .. controls (5.2,1.05) and (3.3,1.4) .. (2.6,2.2) .. controls (2.1,2.8) and (1.8,3.35) .. (1.5,3.6) -- cycle;
  % exceso: entre la recta del triángulo y la trayectoria
  \fill[black!28] (1.5,3.6) -- (7.5,1.0) .. controls (5.2,1.05) and (3.3,1.4) .. (2.6,2.2) .. controls (2.1,2.8) and (1.8,3.35) .. (1.5,3.6) -- cycle;
  % trayectoria y triángulo
  \draw[black!55, dashed] (1.5,3.6) -- (7.5,3.6) -- (7.5,1.0);
  \draw[black!70] (1.5,3.6) -- (7.5,1.0);
  \draw[black, thick] (0.3,3.0) .. controls (0.8,3.45) and (1.2,3.6) .. (1.5,3.6) .. controls (1.8,3.35) and (2.1,2.8) .. (2.6,2.2) .. controls (3.3,1.4) and (5.2,1.05) .. (7.5,1.0) .. controls (8.2,1.0) and (8.8,1.4) .. (9.2,1.9);
  \fill (1.5,3.6) circle (1.6pt) node[above=2pt] {$P$};
  \fill (7.5,1.0) circle (1.6pt) node[below right=1pt] {$V$};
  % medidas
  \draw[decorate, decoration={brace, amplitude=4pt}] (7.65,3.6) -- (7.65,1.0) node[midway, right=5pt] {$A$};
  \draw[decorate, decoration={brace, amplitude=4pt}] (1.5,3.75) -- (7.5,3.75) node[midway, above=5pt] {$D$};
  \node at (5.6,2.9) {$C$};
  \node at (3.3,2.05) {exceso};
\end{tikzpicture}
