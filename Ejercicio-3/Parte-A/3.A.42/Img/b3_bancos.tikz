%% Cuerpo B3: canal del capital bancario (pérdidas, capital, apalancamiento, venta de activos y menos crédito para todos).
%% Generada por Code/libro_y_figuras.py; PDF con: bash Code/generar_figura.sh b3_bancos
\begin{tikzpicture}[font=\footnotesize, caja/.style={draw, rounded corners=2pt, align=center, inner sep=4pt, minimum width=3.2cm, minimum height=1.1cm}]
\node[caja, fill=black!8] (per) at (0,3.75) {Una perturbación: pérdidas en una\\parte de los activos de los bancos};
\node[caja] (pre) at (0,1.9) {Caen los precios\\de los activos};
\node[caja] (cap) at (4.3,0) {Los bancos pierden capital\\y su apalancamiento sube};
\node[caja] (bal) at (0,-1.9) {Venden activos y prestan\\menos y más caro,\\también a los demás};
\node[caja] (gas) at (-4.3,0) {Caen la inversión\\y el gasto};
\draw[-{Stealth[length=2.4mm]}, thick] (per) -- (pre);
\draw[-{Stealth[length=2.4mm]}, thick] (pre.east) to[out=0, in=90] (cap.north);
\draw[-{Stealth[length=2.4mm]}, thick] (cap.south) to[out=270, in=0] (bal.east);
\draw[-{Stealth[length=2.4mm]}, thick] (bal.west) to[out=180, in=270] (gas.south);
\draw[-{Stealth[length=2.4mm]}, thick] (gas.north) to[out=90, in=180] (pre.west);
\end{tikzpicture}
