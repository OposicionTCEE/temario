% Método de la función de producción para el PIB potencial (Comisión Europea, HAVIK et al., 2014; CBO): trabajo potencial,
% capital y productividad total de los factores tendencial en una COBB-DOUGLAS; la brecha compara el PIB observado con
% el potencial. Sin cifras salvo las elasticidades. Generar con: bash Code/generar_figura.sh anx_funcion_produccion
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=2mm]},
    caja/.style={draw, rounded corners=2pt, align=center, inner sep=4pt, minimum height=1.25cm, text width=4.3cm},
    central/.style={draw, very thick, rounded corners=2pt, align=center, inner sep=5pt, text width=4.6cm, minimum height=1.25cm},
    nota/.style={align=center, text width=3.9cm, font=\scriptsize}]
  \node[caja] (trabajo) at (0,2.2) {\textbf{Trabajo potencial}, $\bar H_t$\\[2pt] población en edad de trabajar, actividad y horas tendenciales, paro estructural (NAWRU)};
  \node[caja] (capital) at (0,0) {\textbf{Capital}, $k_t$\\[2pt] stock observado};
  \node[caja] (ptf) at (0,-2.2) {\textbf{Productividad total de los factores tendencial}, $\bar Z_t$\\[2pt] tendencia estimada con la utilización de la capacidad};
  \node[central] (fp) at (6.3,0) {\textbf{Función de producción}\\[3pt] $\bar Y_t=\bar Z_t\,\bar H_t^{\,1-\eta}\,k_t^{\,\eta}$, $\ \eta=0{,}35$};
  \node[caja, text width=3.2cm] (pot) at (11.3,1.2) {\textbf{PIB potencial}, $\bar Y_t$};
  \node[caja, text width=3.2cm] (obs) at (11.3,-1.2) {\textbf{PIB observado}, $Y_t$};
  \node[central, text width=3.4cm] (brecha) at (11.3,-3.6) {\textbf{Brecha de producción}\\[3pt] $\dfrac{Y_t-\bar Y_t}{\bar Y_t}$};
  \draw[->] (trabajo.east) -- (fp.west);
  \draw[->] (capital.east) -- (fp.west);
  \draw[->] (ptf.east) -- (fp.west);
  \draw[->] (fp.east) -- (pot.west);
  \draw[->] (pot.east) -- ++(0.35,0) |- (brecha.east);
  \draw[->] (obs.south) -- (brecha.north);
\end{tikzpicture}
