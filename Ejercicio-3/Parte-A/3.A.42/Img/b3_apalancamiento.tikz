%% Cuerpo B3: ciclo del apalancamiento (la calma reduce los márgenes y eleva el apalancamiento; una mala noticia sube los márgenes y fuerza ventas: crisis).
%% Generada por Code/libro_y_figuras.py; PDF con: bash Code/generar_figura.sh b3_apalancamiento
\begin{tikzpicture}[font=\footnotesize, caja/.style={draw, rounded corners=2pt, align=center, inner sep=4pt, minimum width=3.2cm, minimum height=1.1cm}]
\node[caja] (cal) at (0,1.8) {Calma: la volatilidad\\es baja};
\node[caja] (mar) at (3.9,0) {Los prestamistas piden\\márgenes pequeños};
\node[caja] (apa) at (0,-1.8) {Más apalancamiento y\\posiciones más frágiles};
\node[caja] (pre) at (-3.9,0) {Suben los precios\\de los activos};
\node[caja, fill=black!8] (mal) at (4.6,-3.6) {Una mala noticia};
\node[caja] (ven) at (0,-5.4) {Suben los márgenes y\\hay ventas forzosas};
\node[caja] (cri) at (-4.6,-3.6) {Caen de golpe los precios\\y el crédito: crisis};
\draw[-{Stealth[length=2.4mm]}, thick] (cal.east) to[out=0, in=90] (mar.north);
\draw[-{Stealth[length=2.4mm]}, thick] (mar.south) to[out=270, in=0] (apa.east);
\draw[-{Stealth[length=2.4mm]}, thick] (apa.west) to[out=180, in=270] (pre.south);
\draw[-{Stealth[length=2.4mm]}, thick] (pre.north) to[out=90, in=180] (cal.west);
\draw[-{Stealth[length=2.4mm]}, thick, dashed] (apa.south) -- (ven.north);
\draw[-{Stealth[length=2.4mm]}, thick, dashed] (mal.south) to[out=270, in=0] (ven.east);
\draw[-{Stealth[length=2.4mm]}, thick] (ven.west) to[out=180, in=270] (cri.south);
\end{tikzpicture}
