% Acelerador financiero de BERNANKE, GERTLER y GILCHRIST (1999), dibujado a mano (A9, 08/11/2026): una perturbación adversa
% baja el precio del capital; cae el patrimonio neto de los empresarios; sube la prima de financiación externa s(.); caen la
% inversión y la producción; vuelve a bajar el precio del capital. Sin cifras. Generar con: bash Code/generar_figura.sh anx_acelerador
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=2mm]},
    caja/.style={draw, rounded corners=2pt, align=center, inner sep=4pt, text width=3.7cm, minimum height=1.15cm}]
  \node[caja] (precio) at (0,2.1) {\textbf{Precio del capital}, $q_t$, baja};
  \node[caja] (patrimonio) at (4.7,0) {\textbf{Patrimonio neto} de los empresarios, $n_t$, cae};
  \node[caja] (prima) at (0,-2.1) {\textbf{Prima de financiación externa}, $s(\cdot)$, sube};
  \node[caja] (inversion) at (-4.7,0) {\textbf{Inversión y producción} caen};
  \node[caja, dashed, text width=2.8cm] (choque) at (-4.7,2.5) {Perturbación adversa};
  \node[font=\footnotesize\itshape] at (0,0) {acelerador financiero};
  \draw[->, thick] (precio.east) to[bend left=18] (patrimonio.north);
  \draw[->, thick] (patrimonio.south) to[bend left=18] (prima.east);
  \draw[->, thick] (prima.west) to[bend left=18] (inversion.south);
  \draw[->, thick] (inversion.north) to[bend left=18] (precio.west);
  \draw[->, dashed] (choque.east) -- (precio.west |- choque.east) -- ([yshift=4pt]precio.west);
\end{tikzpicture}
