% Fases de un ciclo clásico sobre el nivel del PIB: pico P, valle V y pico siguiente P', amplitud A y duraciones de la
% recesión y de la expansión. Sin cifras. Generar con: bash Code/generar_figura.sh anx_fases
\begin{tikzpicture}[font=\footnotesize, x=1cm, y=1cm]
  % ejes
  \draw[-{Stealth[length=2mm]}] (0,0) -- (14.6,0) node[below left] {tiempo};
  \draw[-{Stealth[length=2mm]}] (0,0) -- (0,5.2) node[left] {$y_t$};
  % trayectoria
  \draw[black, thick] plot[smooth, tension=0.65] coordinates {(0.3,1.2) (1.8,2.2) (3.0,2.85) (4.0,3.1) (5.0,2.6) (6.2,1.75) (7.0,1.6) (8.2,1.95) (9.8,2.9) (11.2,3.7) (12.2,4.05) (13.2,3.75) (14.0,3.2)};
  % puntos de giro
  \fill (4.0,3.1) circle (1.6pt) node[above=2pt] {$P$};
  \fill (7.0,1.6) circle (1.6pt) node[below=2pt] {$V$};
  \fill (12.2,4.05) circle (1.6pt) node[above=2pt] {$P'$};
  % amplitud de la recesión
  \draw[black!55, dashed] (4.0,3.1) -- (7.25,3.1);
  \draw[decorate, decoration={brace, amplitude=4pt}] (7.15,3.1) -- (7.15,1.65) node[midway, right=5pt] {$A$};
  % duraciones
  \draw[black!40] (4.0,3.1) -- (4.0,0);
  \draw[black!40] (7.0,1.6) -- (7.0,0);
  \draw[black!40] (12.2,4.05) -- (12.2,0);
  \draw[decorate, decoration={brace, amplitude=4pt, mirror}] (4.0,-0.15) -- (7.0,-0.15) node[midway, below=5pt] {recesión};
  \draw[decorate, decoration={brace, amplitude=4pt, mirror}] (7.0,-0.15) -- (12.2,-0.15) node[midway, below=5pt] {expansión};
  \draw[decorate, decoration={brace, amplitude=4pt, mirror}] (4.0,-0.95) -- (12.2,-0.95) node[midway, below=5pt] {ciclo de pico a pico};
\end{tikzpicture}
