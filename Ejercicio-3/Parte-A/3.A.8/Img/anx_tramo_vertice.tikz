% Figura (Anexo I, «Elección sin Buen Comportamiento», «Convexidad estricta y diferenciabilidad»): tramo recto y vértice.
% Dos paneles (eran los (b) y (c) de anx_fallos_eleccion).
% (a) Tramo recto: curva con un tramo recto entre (1,3; 2,7) y (2,7; 1,3) sobre la recta de balance x_1 + x_2 = 4: todo el
%     tramo es óptimo.
% (b) Vértice: curva en L con vértice K = (2, 2); tres rectas de balance que pasan por K, con pendientes -1/2, -1 y -2:
%     K se elige con los tres precios relativos.
% Escala: 1 unidad = 1 cm; cada panel, 4,4 x 4,4 cm.
% Generar con: bash Code/generar_figura.sh anx_tramo_vertice
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1cm, y=1cm]
  % ---------------- (a) Tramo recto ----------------
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (2.2,4.85) {(a) Tramo recto};
    \fill[black!12] (0,0) -- (0,4) -- (4,0) -- cycle;
    \draw[->] (0,0) -- (4.4,0) node[below] {$x_1$};
    \draw[->] (0,0) -- (0,4.4) node[left] {$x_2$};
    \draw[very thick] (0,4) -- (4,0);
    \draw[thick] (0.55,4.4) .. controls (0.8,3.3) and (1.05,2.95) .. (1.3,2.7);
    \draw[thick] (2.7,1.3) .. controls (2.95,1.05) and (3.3,0.8) .. (4.4,0.55);
    \draw[line width=2.4pt] (1.3,2.7) -- (2.7,1.3);
  \end{scope}
  % ---------------- (b) Vértice ----------------
  \begin{scope}[xshift=5.8cm]
    \node[font=\footnotesize\bfseries] at (2.2,4.85) {(b) Vértice};
    \draw[->] (0,0) -- (4.4,0) node[below] {$x_1$};
    \draw[->] (0,0) -- (0,4.4) node[left] {$x_2$};
    \draw[thick, dashed] (0,3) -- (4.4,0.8);
    \draw[thick, dashed] (0,4) -- (4,0);
    \draw[thick, dashed] (0.8,4.4) -- (3,0);
    \draw[very thick] (2,4.4) -- (2,2) -- (4.4,2);
    \fill (2,2) circle (2pt);
    \node[below left] at (2,2) {$K$};
  \end{scope}
\end{tikzpicture}
