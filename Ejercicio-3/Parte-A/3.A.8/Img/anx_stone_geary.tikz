% Figura (Anexo I, «Formas Funcionales», «Homotéticas»): senda de expansión de STONE-GEARY, con precios iguales a 1. Era el
% panel (b) de anx_homoteticas.
% u = (1/3) ln(x_1 - 0,8) + (2/3) ln(x_2 - 0,6); mínimos gamma = (0,8; 0,6); rectas x_1 + x_2 = 2,4; 3,4; 4,4; elecciones
% (1,133; 1,267), (1,467; 1,933) y (1,8; 2,6), sobre la recta que parte de gamma con pendiente 2; curvas
% x_2 = 0,6 + k / raíz(x_1 - 0,8) con k = 0,385; 1,089; 2,0.
% Escala: 1 unidad = 1 cm; 4,4 x 4,4 cm.
% Generar con: bash Code/generar_figura.sh anx_stone_geary
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1cm, y=1cm]
  \draw[->] (0,0) -- (4.4,0) node[below] {$x_1$};
  \draw[->] (0,0) -- (0,4.4) node[left] {$x_2$};
  \draw[densely dotted] (0.8,0) -- (0.8,4.3);
  \draw[densely dotted] (0,0.6) -- (4.3,0.6);
  \foreach \w in {2.4,3.4,4.4} { \draw[thick, dashed] (0,\w) -- (\w,0); }
  \draw[thick] plot[domain=0.81:4.3, samples=100] (\x,{0.6+0.385/sqrt(\x-0.8)});
  \draw[thick] plot[domain=0.87:4.3, samples=100] (\x,{0.6+1.089/sqrt(\x-0.8)});
  \draw[thick] plot[domain=1.05:4.3, samples=100] (\x,{0.6+2.0/sqrt(\x-0.8)});
  \draw[very thick] (0.8,0.6) -- (2.6,4.2);
  \fill (0.8,0.6) circle (2pt);
  \node[below left] at (0.8,0.6) {$\gamma$};
  \foreach \p in {(1.133,1.267),(1.467,1.933),(1.8,2.6)} { \fill \p circle (2pt); }
\end{tikzpicture}
