% Figura (Anexo I, «Formas Funcionales», «CES»): la demanda del bien 1 con tres elasticidades de sustitución.
% CES con a_1 = a_2, p_2 = 1 y W = 4; las tres pasan por (2, 1) (con p_1 = p_2 se gasta la mitad en cada bien):
%   sigma = 1/2: x_1 = 4 p_1^(-1/2) / (p_1^(1/2) + 1) (discontinua);
%   sigma = 1 (COBB-DOUGLAS): x_1 = 2/p_1 (continua);
%   sigma = 2: x_1 = 4 / (p_1 (p_1 + 1)) (gruesa).
% Escala: horizontal, 1 unidad = 0,7 cm; vertical, 1 unidad = 1,2 cm.
% Generar con: bash Code/generar_figura.sh anx_ces_demanda
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=0.7cm, y=1.2cm]
  \draw[->] (0,0) -- (6.4,0) node[below] {$x_1$};
  \draw[->] (0,0) -- (0,3.7) node[left] {$p_1$};
  \draw[thick, dashed] plot[domain=0.27:3.4, samples=80] ({4*\x^(-0.5)/(\x^(0.5)+1)},{\x});
  \draw[thick] plot[domain=0.34:3.4, samples=80] ({2/\x},{\x});
  \draw[very thick] plot[domain=0.54:3.4, samples=80] ({4/(\x*(\x+1))},{\x});
  \fill (2,1) circle (2pt);
  \draw[densely dotted] (0,1) -- (2,1);
  \node[left] at (0,1) {$p_2$};
  % Leyenda
  \draw[thick, dashed] (3.6,3.3) -- (4.6,3.3) node[right] {$\sigma=\tfrac12$};
  \draw[thick] (3.6,2.95) -- (4.6,2.95) node[right] {$\sigma=1$};
  \draw[very thick] (3.6,2.6) -- (4.6,2.6) node[right] {$\sigma=2$};
\end{tikzpicture}
