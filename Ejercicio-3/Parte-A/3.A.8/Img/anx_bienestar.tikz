% Figura (Anexo II, «Comparaciones de Bienestar»): ordenar dos periodos con las elecciones. Tres paneles.
% Periodo base: B^0 = {x_1 + x_2 <= 4}, elegida x^0 = (2, 2) en los tres.
% (a) Mejor: B^1 = {0,6 x_1 + x_2 <= 3,4}, elegida x^1 = (3; 1,6); x^0 era asequible en el periodo corriente (Q_P >= 1).
% (b) Peor: B^1 = {2 x_1 + x_2 <= 4,5}, elegida x^1 = (1; 2,5); x^1 era asequible en el periodo base (Q_L <= 1).
% (c) Indeterminado: B^1 = {0,5 x_1 + x_2 <= 2,8}, elegida x^1 = (4; 0,8); ninguna era asequible cuando se eligió la otra.
% Escala: 1 unidad = 0,7 cm.
% Generar con: bash Code/generar_figura.sh anx_bienestar
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=0.7cm, y=0.7cm]
  \foreach \sx/\titulo/\ya/\xa/\pa in {
      0/{(a) Mejor}/3.4/5.667/{(3,1.6)},
      5.3/{(b) Peor}/4.5/2.25/{(1,2.5)},
      10.6/{(c) Indeterminado}/2.8/5.6/{(4,0.8)}} {
    \begin{scope}[xshift=\sx cm]
      \node[font=\footnotesize\bfseries] at (3.1,5.4) {\titulo};
      \draw[->] (0,0) -- (6.3,0) node[below] {$x_1$};
      \draw[->] (0,0) -- (0,5) node[left] {$x_2$};
      \draw[very thick] (0,4) -- (4,0) node[below] {$B^0$};
      \draw[thick, dashed] (0,\ya) -- (\xa,0) node[below] {$B^1$};
      \fill (2,2) circle (2pt) node[above right] {$x^0$};
      \fill \pa circle (2pt) node[above right] {$x^1$};
    \end{scope}
  }
\end{tikzpicture}
