% Figura (Anexo I, «Renta»): la respuesta de la elección a la renta. Tres paneles. Precios iguales a 1.
% (a) Senda de expansión: rectas x_1 + x_2 = 1,6; 2,6; 3,6 y cestas elegidas A = (0,6; 1), B = (1; 1,6), C = (0,85; 2,75):
%     entre B y C la cantidad del bien 1 disminuye (bien inferior a partir de cierta renta).
% (b) Curva de ENGEL del bien 1 que corresponde a (a): (W, x_1) = (1,6; 0,6), (2,6; 1), (3,6; 0,85); eje vertical x_1 a escala
%     3 (1 unidad = 3 cm).
% (c) Tres tipos de curva de ENGEL: lujo, x = 0,15 W^2 (eta = 2); necesario, x = 1,3 raíz(W) (eta = 1/2); inferior,
%     x = 2,4 - 0,35 W.
% Escala: 1 unidad = 1 cm salvo el eje vertical de (b).
% Generar con: bash Code/generar_figura.sh anx_renta
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1cm, y=1cm]
  % ---------------- (a) Senda de expansión ----------------
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (2.1,4.65) {(a) Senda de expansión};
    \draw[->] (0,0) -- (4.2,0) node[below] {$x_1$};
    \draw[->] (0,0) -- (0,4.2) node[left] {$x_2$};
    \foreach \w in {1.6,2.6,3.6} { \draw[thick, dashed] (0,\w) -- (\w,0); }
    \draw[very thick] plot[smooth] coordinates {(0,0) (0.6,1.0) (1.0,1.6) (0.85,2.75) (0.68,3.5)};
    \fill (0.6,1.0) circle (2pt) node[right] {$A$};
    \fill (1.0,1.6) circle (2pt) node[right] {$B$};
    \fill (0.85,2.75) circle (2pt) node[right] {$C$};
  \end{scope}
  % ---------------- (b) Curva de ENGEL del bien 1 ----------------
  \begin{scope}[xshift=5.0cm]
    \node[font=\footnotesize\bfseries] at (2.1,4.65) {(b) Curva de ENGEL del bien 1};
    \draw[->] (0,0) -- (4.2,0) node[below] {$W$};
    \draw[->] (0,0) -- (0,4.2) node[left] {$x_1$};
    \draw[very thick] plot[smooth] coordinates {(0,0) (1.6,1.8) (2.6,3.0) (3.6,2.55) (4.0,2.25)};
    \fill (1.6,1.8) circle (2pt) node[above left] {$A$};
    \fill (2.6,3.0) circle (2pt) node[above] {$B$};
    \fill (3.6,2.55) circle (2pt) node[above right] {$C$};
    \node[font=\scriptsize] at (1.35,2.45) {$\eta_1>0$};
    \node[font=\scriptsize] at (3.55,3.2) {$\eta_1<0$};
  \end{scope}
  % ---------------- (c) Lujo, necesario e inferior ----------------
  \begin{scope}[xshift=10.0cm]
    \node[font=\footnotesize\bfseries] at (2.1,4.65) {(c) Tipos de bien};
    \draw[->] (0,0) -- (4.2,0) node[below] {$W$};
    \draw[->] (0,0) -- (0,4.2) node[left] {$x_i$};
    \draw[very thick] plot[domain=0:4, samples=60] (\x,{0.15*\x*\x});
    \draw[very thick] plot[domain=0:4, samples=60] (\x,{1.3*sqrt(\x)});
    \draw[very thick] plot[domain=0.5:4, samples=10] (\x,{2.4-0.35*\x});
    \node[right, font=\scriptsize] at (4.0,2.4) {$\eta>1$};
    \node[right, font=\scriptsize] at (4.0,2.85) {$0<\eta<1$};
    \node[right, font=\scriptsize] at (4.0,1.0) {$\eta<0$};
  \end{scope}
\end{tikzpicture}
