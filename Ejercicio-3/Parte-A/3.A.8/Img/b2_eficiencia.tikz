% Figura (bloque 2, «Eficiencia»): el índice de eficiencia de AFRIAT (1973) como eficiencia de FARRELL, con el par incoherente
% del ejemplo del bloque: x^2 = (2, 2) con B^2 = {x_1 + x_2 <= 4} y la elección hipotética x^4 = (0,4; 3,2) con
% B^4 = {0,5 x_1 + x_2 <= 3,4} (figura b2_debil, panel b).
% Con e < 0,9, x^4 deja de ser asequible con el presupuesto reducido e B^2 y la contradicción desaparece (con B^4 bastaría
% e < 3/3,4 = 0,882, pero la cadena se rompe antes por B^2): e* = 3,6/4 = 0,9. Recta reducida e* B^2: x_1 + x_2 = 3,6, que pasa
% por x^4. Radio del origen por x^2 (punteado) y R = 0,9 x^2 = (1,8; 1,8) sobre e* B^2: e* = OR/Ox^2, como la eficiencia
% económica de FARRELL (3.A.12).
% Escala: 1 unidad = 1,15 cm.
% Generar con: bash Code/generar_figura.sh b2_eficiencia
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1.15cm, y=1.15cm]
  \draw[->] (0,0) -- (7.4,0) node[below] {$x_1$};
  \draw[->] (0,0) -- (0,4.4) node[left] {$x_2$};
  \draw[thick] (0,4) -- (4,0) node[below] {$B^2$};
  \draw[thick] (0,3.4) -- (6.8,0) node[below] {$B^4$};
  \draw[thick, dashed] (0,3.6) node[left] {$e^*B^2$} -- (3.6,0);
  \draw[densely dotted] (0,0) -- (2.4,2.4);
  \node[below left] at (0,0) {$O$};
  \fill (1.8,1.8) circle (1.8pt) node[left] {$R$};
  \fill (2,2) circle (2pt) node[right] {$x^2$};
  \fill (0.4,3.2) circle (2pt) node[left] {$x^4$};
\end{tikzpicture}
