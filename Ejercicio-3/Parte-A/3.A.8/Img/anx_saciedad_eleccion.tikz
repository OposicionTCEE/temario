% Figura (Anexo I, «Elección sin Buen Comportamiento», «No saciedad local»): la elección con un punto de saciedad asequible.
% Era el panel (a) de anx_fallos_eleccion.
% Punto de saciedad s = (1,3; 1,3) dentro del conjunto presupuestario (recta x_1 + x_2 = 4); se elige s y sobra renta.
% Escala: 1 unidad = 1 cm; 4,4 x 4,4 cm.
% Generar con: bash Code/generar_figura.sh anx_saciedad_eleccion
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1cm, y=1cm]
  \fill[black!12] (0,0) -- (0,4) -- (4,0) -- cycle;
  \draw[->] (0,0) -- (4.4,0) node[below] {$x_1$};
  \draw[->] (0,0) -- (0,4.4) node[left] {$x_2$};
  \draw[very thick] (0,4) -- (4,0);
  \foreach \r in {0.45,0.9} { \draw[thick] (1.3,1.3) circle (\r); }
  \fill (1.3,1.3) circle (2pt);
  \node[right] at (1.33,1.3) {$s$};
\end{tikzpicture}
