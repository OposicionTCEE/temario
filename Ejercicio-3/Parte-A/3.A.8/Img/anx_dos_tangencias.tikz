% Figura (Anexo I, «Hesiano orlado»): una recta de balance tangente a dos curvas de indiferencia, en un máximo y en un mínimo.
% Utilidad u = x_2 - g(x_1), con g(x_1) = 4 - x_1 + 0,35 sen(2 (x_1 - 2)): monótona (g' = -1 + 0,7 cos(...) < 0), con curvas
% de indiferencia x_2 = g(x_1) + c, traslaciones verticales con un tramo convexo y otro cóncavo.
% Recta de balance x_1 + x_2 = 4 (p_1 = p_2). Tangencias donde g' = -1, es decir, cos(2 (x_1 - 2)) = 0:
%   A = (1,215; 2,785), con g'' > 0 (curva convexa): máximo local, sobre la curva c = 0,35 (la más alta que se alcanza);
%   B = (2,785; 1,215), con g'' < 0 (curva cóncava): mínimo local, sobre la curva c = -0,35.
% Escala: 1 unidad = 1 cm.
% Generar con: bash Code/generar_figura.sh anx_dos_tangencias
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1cm, y=1cm]
  \fill[black!12] (0,0) -- (0,4) -- (4,0) -- cycle;
  \draw[->] (0,0) -- (4.8,0) node[below] {$x_1$};
  \draw[->] (0,0) -- (0,4.8) node[left] {$x_2$};
  \draw[very thick] (0,4) -- (4,0);
  \draw[thick] plot[domain=0.3:4.0, samples=90] (\x,{4.35-\x+0.35*sin(2*(\x-2) r)});
  \draw[thick, dashed] plot[domain=0.1:3.62, samples=90] (\x,{3.65-\x+0.35*sin(2*(\x-2) r)});
  \fill (1.215,2.785) circle (2pt) node[above right] {$A$};
  \fill (2.785,1.215) circle (2pt) node[below left] {$B$};
\end{tikzpicture}
