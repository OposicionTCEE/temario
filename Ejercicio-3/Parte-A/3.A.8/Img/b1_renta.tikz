% Figura (bloque 1, «Renta»): de la elección a la curva de ENGEL. Dos paneles, uno encima del otro, con la misma escala
% horizontal (x_1), para que cada cesta elegida baje a su punto de la curva de ENGEL (líneas de puntos).
% Precios iguales a 1; rentas W^0 = 2, W^1 = 3,2 y W^2 = 4,4 (rectas x_1 + x_2 = W). Cestas elegidas A = (1; 1),
% B = (1,8; 1,4) y C = (1,4; 3): el bien 1 es normal de A a B e inferior de B a C. Arcos de curva de indiferencia tangentes,
% x_2 = P_2 - (x_1 - P_1) + 0,7 (x_1 - P_1)^2.
% (a) Arriba: rectas de balance y senda de expansión (discontinua) por el origen, A, B y C.
% (b) Abajo: curva de ENGEL del bien 1, con la renta en el eje vertical: (x_1, W) = (1; 2), (1,8; 3,2), (1,4; 4,4).
% Escala: x_1, 1 unidad = 1,1 cm en los dos paneles; (a) x_2, 1 unidad = 0,65 cm; (b) W, 1 unidad = 0,55 cm.
% Generar con: bash Code/generar_figura.sh b1_renta
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  % ---------------- (a) Senda de expansión ----------------
  \begin{scope}[x=1.1cm, y=0.65cm]
    \node[font=\footnotesize\bfseries] at (2.4,5.5) {(a) Senda de expansión de la renta};
    \draw[->] (0,0) -- (4.9,0) node[below] {$x_1$};
    \draw[->] (0,0) -- (0,4.9) node[left] {$x_2$};
    \draw[thick] (0,2) -- (2,0);
    \draw[thick] (0,3.2) -- (3.2,0);
    \draw[thick] (0,4.4) -- (4.4,0);
    \draw[very thick] plot[domain=0.45:1.65, samples=40] (\x,{1-(\x-1)+0.7*(\x-1)^2});
    \draw[very thick] plot[domain=1.25:2.45, samples=40] (\x,{1.4-(\x-1.8)+0.7*(\x-1.8)^2});
    \draw[very thick] plot[domain=0.85:2.05, samples=40] (\x,{3-(\x-1.4)+0.7*(\x-1.4)^2});
    \draw[dashed] plot[smooth] coordinates {(0,0) (1,1) (1.8,1.4) (1.4,3)};
    \coordinate (A1) at (1,1);
    \coordinate (B1) at (1.8,1.4);
    \coordinate (C1) at (1.4,3);
    \fill (A1) circle (1.8pt) node[above right] {$A$};
    \fill (B1) circle (1.8pt) node[right] {$B$};
    \fill (C1) circle (1.8pt) node[left] {$C$};
  \end{scope}
  % ---------------- (b) Curva de ENGEL ----------------
  \begin{scope}[yshift=-4.3cm, x=1.1cm, y=0.55cm]
    \node[font=\footnotesize\bfseries] at (2.4,5.5) {(b) Curva de ENGEL del bien 1};
    \draw[->] (0,0) -- (4.9,0) node[below] {$x_1$};
    \draw[->] (0,0) -- (0,4.9) node[left] {$W$};
    \draw[very thick] plot[smooth] coordinates {(0,0) (1,2) (1.8,3.2) (1.4,4.4)};
    \coordinate (A2) at (1,2);
    \coordinate (B2) at (1.8,3.2);
    \coordinate (C2) at (1.4,4.4);
    \draw[densely dotted] (A2) -- (0,2) node[left] {$W^0$};
    \draw[densely dotted] (B2) -- (0,3.2) node[left] {$W^1$};
    \draw[densely dotted] (C2) -- (0,4.4) node[left] {$W^2$};
    \fill (A2) circle (1.8pt) node[right] {$A$};
    \fill (B2) circle (1.8pt) node[right] {$B$};
    \fill (C2) circle (1.8pt) node[right] {$C$};
    \node at (2.35,2.3) {$\eta_1>0$};
    \node at (2.45,4.1) {$\eta_1<0$};
  \end{scope}
  \draw[densely dotted] (A1) -- (A2);
  \draw[densely dotted] (B1) -- (B2);
  \draw[densely dotted] (C1) -- (C2);
\end{tikzpicture}
