% Figura (Anexo III, «Teoría de las Características»): la frontera de eficiencia de LANCASTER (1966). Dos paneles.
% Espacio de las características (z_1, z_2). Tres bienes, con características por unidad b_A = (2; 0,5), b_B = (1,3; 1,3),
% b_C = (0,4; 2) (radios desde el origen). Con precios iguales a 1 y renta 2, gastar todo en un bien da A* = (4, 1),
% B* = (2,6; 2,6) y C* = (0,8; 4). La frontera de eficiencia es la envolvente convexa C*-B*-A*.
% (a) Elección privada: curva de indiferencia z_1^0,677 z_2^0,323 = 2,713, tangente en c* = (3,3; 1,8), en el tramo A*-B*
%     (el consumidor combina los bienes A y B). Curva: z_2 = 21,97 z_1^(-2,096).
% (b) El precio de B sube a 1,25: B** = (2,08; 2,08) queda por debajo del tramo A*-C* y el bien B sale de la frontera
%     (sustitución de eficiencia). Nueva tangencia en c* = (3,43; 1,535), en el tramo A*-C*: z_2 = 20,34 z_1^(-2,096).
% Escala: 1 unidad = 0,9 cm.
% Generar con: bash Code/generar_figura.sh anx_lancaster
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=0.9cm, y=0.9cm]
  % ---------------- (a) Frontera de eficiencia ----------------
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (2.4,5.3) {(a) Frontera de eficiencia};
    \draw[->] (0,0) -- (5,0) node[below] {$z_1$};
    \draw[->] (0,0) -- (0,4.9) node[left] {$z_2$};
    \draw[thin] (0,0) -- (4.6,1.15) node[right] {$A$};
    \draw[thin] (0,0) -- (3.4,3.4) node[above right] {$B$};
    \draw[thin] (0,0) -- (0.9,4.5) node[above] {$C$};
    \draw[very thick] (0.8,4) -- (2.6,2.6) -- (4,1);
    \draw[thick, densely dashed] plot[domain=2.38:4.6, samples=80] (\x,{21.97*\x^(-2.096)});
    \foreach \p in {(4,1),(2.6,2.6),(0.8,4)} { \fill \p circle (1.8pt); }
    \fill (3.3,1.8) circle (2.2pt) node[below left] {$c^*$};
  \end{scope}
  % ---------------- (b) Sube el precio de B ----------------
  \begin{scope}[xshift=6cm]
    \node[font=\footnotesize\bfseries] at (2.4,5.3) {(b) Sube el precio de $B$};
    \draw[->] (0,0) -- (5,0) node[below] {$z_1$};
    \draw[->] (0,0) -- (0,4.9) node[left] {$z_2$};
    \draw[thin] (0,0) -- (4.6,1.15) node[right] {$A$};
    \draw[thin] (0,0) -- (3.4,3.4) node[above right] {$B$};
    \draw[thin] (0,0) -- (0.9,4.5) node[above] {$C$};
    \draw[thin, dotted] (0.8,4) -- (2.6,2.6) -- (4,1);
    \draw[very thick] (0.8,4) -- (4,1);
    \draw[thick, densely dashed] plot[domain=2.3:4.6, samples=80] (\x,{20.34*\x^(-2.096)});
    \foreach \p in {(4,1),(0.8,4)} { \fill \p circle (1.8pt); }
    \draw[thick, fill=white] (2.08,2.08) circle (1.8pt);
    \fill (3.43,1.535) circle (2.2pt) node[below left] {$c^*$};
  \end{scope}
\end{tikzpicture}
