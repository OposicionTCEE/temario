% Figura (Anexo I, «Precios Cruzados»): la senda precio-consumo y la relación bruta entre los bienes. Tres paneles.
% p_2 = 1, W = 4; p_1 = 2; 4/3; 1, con rectas de (0, 4) a (2, 0), (3, 0) y (4, 0).
% (a) Complementarios perfectos, min{x_1, x_2}: (1,333; 1,333), (1,714; 1,714), (2; 2): la senda sube (x_2 aumenta al bajar
%     p_1: complementarios brutos).
% (b) COBB-DOUGLAS con a = 1/2: (1; 2), (1,5; 2), (2; 2): la senda es horizontal (independientes brutos).
% (c) CES con pesos iguales y sigma = 3: (0,4; 3,2), (1,08; 2,56), (2; 2): la senda baja (sustitutivos brutos).
% Escala: 1 unidad = 1 cm; cada panel, 4,4 x 4,4 cm.
% Generar con: bash Code/generar_figura.sh anx_cruzados
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1cm, y=1cm]
  \foreach \sx/\titulo/\pa/\pb/\pc in {
      0/{(a) Complementarios brutos}/{(1.333,1.333)}/{(1.714,1.714)}/{(2,2)},
      5.3/{(b) Independientes}/{(1,2)}/{(1.5,2)}/{(2,2)},
      10.6/{(c) Sustitutivos brutos}/{(0.4,3.2)}/{(1.08,2.56)}/{(2,2)}} {
    \begin{scope}[xshift=\sx cm]
      \node[font=\footnotesize\bfseries] at (2.2,4.85) {\titulo};
      \draw[->] (0,0) -- (4.4,0) node[below] {$x_1$};
      \draw[->] (0,0) -- (0,4.4) node[left] {$x_2$};
      \draw[thick, dashed] (0,4) -- (2,0);
      \draw[thick, dashed] (0,4) -- (3,0);
      \draw[thick, dashed] (0,4) -- (4,0);
      \draw[very thick] plot[smooth] coordinates {\pa \pb \pc};
      \foreach \p in {\pa,\pb,\pc} { \fill \p circle (2pt); }
    \end{scope}
  }
\end{tikzpicture}
