% Figura (bloque 2, «Axioma Débil»): dos elecciones coherentes y dos que se contradicen. Dos paneles.
% (a) Coherentes (datos del ejemplo del bloque): B^1 = {3 x_1 + x_2 <= 6} con x^1 = (1, 3) y B^2 = {x_1 + x_2 <= 4} con
%     x^2 = (2, 2). x^1 era asequible cuando se eligió x^2 (está sobre B^2), pero x^2 no lo era cuando se eligió x^1 (cuesta 8 > 6).
% (b) Incoherentes: B^2 con x^2 y una elección hipotética x^4 = (1; 2,7) con B^4 = {0,55 x_1 + x_2 <= 3,25}: x^4 costaba
%     3,7 < 4 con los precios de B^2, y x^2 costaba 3,1 < 3,25 con los de B^4: cada cesta era asequible cuando se eligió la otra.
% Escala: 1 unidad = 0,72 cm; paneles separados 7,6 cm.
% Generar con: bash Code/generar_figura.sh b2_debil
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=0.72cm, y=0.72cm]
  % ---------------- (a) Coherentes ----------------
  \node[font=\footnotesize\bfseries] at (3.2,7.0) {(a) Coherentes};
  \draw[->] (0,0) -- (6.8,0) node[below] {$x_1$};
  \draw[->] (0,0) -- (0,6.6) node[left] {$x_2$};
  \draw[thick] (0,6) -- (2,0) node[below] {$B^1$};
  \draw[thick] (0,4) -- (4,0) node[below] {$B^2$};
  \fill (1,3) circle (2pt) node[above right] {$x^1$};
  \fill (2,2) circle (2pt) node[above right] {$x^2$};
  % ---------------- (b) Incoherentes ----------------
  \begin{scope}[xshift=7.6cm]
    \node[font=\footnotesize\bfseries] at (3.2,7.0) {(b) Incoherentes};
    \draw[->] (0,0) -- (6.8,0) node[below] {$x_1$};
    \draw[->] (0,0) -- (0,6.6) node[left] {$x_2$};
    \draw[thick] (0,4) -- (4,0) node[below] {$B^2$};
    \draw[thick] (0,3.25) -- (5.909,0) node[below] {$B^4$};
    \fill (2,2) circle (2pt) node[below left] {$x^2$};
    \fill (1,2.7) circle (2pt) node[below left] {$x^4$};
  \end{scope}
\end{tikzpicture}
