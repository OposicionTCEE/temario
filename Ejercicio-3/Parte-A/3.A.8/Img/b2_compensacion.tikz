% Figura (bloque 2, «Ley de la Demanda Compensada»): la compensación de SLUTSKY, sin curvas de indiferencia.
% Elección de partida x^2 = (2, 2) con B^2 = {x_1 + x_2 <= 4} (p = (1, 1), W = 4). Baja el precio del bien 1 a 0,6: la recta
% nueva, B', va de (0, 4) a (6,667; 0); la compensada, B^S, pasa por x^2 con la pendiente nueva y va de (0; 3,2) a (5,333; 0)
% (renta compensada W' = 0,6 * 2 + 2 = 3,2). Su tramo a la izquierda de x^2 (gris grueso) estaba dentro de B^2 y el axioma
% débil lo excluye. Elección compensada x^S = (2,667; 1,6) y elección final x' = (3,333; 2), las de la COBB-DOUGLAS del ejemplo.
% ES: efecto sustitución (de x^2 a x^S); ER: efecto renta (de x^S a x'), como en la figura b1_slutsky del 3.A.9.
% Escala: 1 unidad = 1,05 cm.
% Generar con: bash Code/generar_figura.sh b2_compensacion
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1.05cm, y=1.05cm]
  \draw[->] (0,0) -- (7.3,0) node[below] {$x_1$};
  \draw[->] (0,0) -- (0,4.5) node[left] {$x_2$};
  \draw[thick] (0,4) -- (4,0) node[below] {$B^2$};
  \draw[thick] (0,4) -- (6.667,0) node[below] {$B'$};
  \draw[line width=2.4pt, gray!55] (0,3.2) -- (2,2);
  \draw[thick, dashed] (2,2) -- (5.333,0) node[below] {$B^S$};
  \draw[densely dotted] (2,2) -- (2,0);
  \draw[densely dotted] (2.667,1.6) -- (2.667,0);
  \draw[densely dotted] (3.333,2) -- (3.333,0);
  \fill (2,2) circle (2pt) node[above right] {$x^2$};
  \fill (2.667,1.6) circle (2pt) node[above right] {$x^S$};
  \fill (3.333,2) circle (2pt) node[above right] {$x'$};
  \draw[decorate, decoration={brace, mirror, amplitude=4pt}] (2,-0.45) -- (2.667,-0.45) node[midway, below=4pt] {ES};
  \draw[decorate, decoration={brace, mirror, amplitude=4pt}] (2.667,-0.45) -- (3.333,-0.45) node[midway, below=4pt] {ER};
\end{tikzpicture}
