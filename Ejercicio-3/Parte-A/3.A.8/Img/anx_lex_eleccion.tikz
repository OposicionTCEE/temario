% Figura (Anexo I, «Elección sin Buen Comportamiento», «Racionalidad y continuidad»): la elección con preferencias
% lexicográficas. Era el panel (d) de anx_fallos_eleccion.
% Recta x_1 + x_2 = 3; se elige x* = (3, 0), todo el gasto en el bien 1; la vertical discontinua es la curva de indiferencia
% de u = x_1 por x*, que genera la misma elección.
% Escala: 1 unidad = 1 cm; 4,4 x 4,4 cm.
% Generar con: bash Code/generar_figura.sh anx_lex_eleccion
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1cm, y=1cm]
  \fill[black!12] (0,0) -- (0,3) -- (3,0) -- cycle;
  \draw[->] (0,0) -- (4.4,0) node[below] {$x_1$};
  \draw[->] (0,0) -- (0,4.4) node[left] {$x_2$};
  \draw[very thick] (0,3) -- (3,0);
  \draw[thick, dashed] (3,0) -- (3,4.2);
  \fill (3,0) circle (2pt);
  \node[above right] at (3,0) {$x^*$};
\end{tikzpicture}
