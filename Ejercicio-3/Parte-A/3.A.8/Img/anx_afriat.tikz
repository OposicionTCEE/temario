% Figura (Anexo II, «Teorema de AFRIAT»): curvas de indiferencia construidas con los datos.
% Tres elecciones de una COBB-DOUGLAS con a = 1/2: x^1 = (1, 3) con p^1 = (3, 1) y W = 6; x^2 = (2, 2) con p^2 = (1, 1) y
% W = 4; x^3 = (3, 1) con p^3 = (1, 3) y W = 6. Números de AFRIAT: U = (raíz 3; 2; raíz 3), lambda = (0,2887; 0,5; 0,2887).
% Utilidad construida: u(x) = min{0,866 x_1 + 0,2887 x_2; 0,5 x_1 + 0,5 x_2; 0,2887 x_1 + 0,866 x_2}.
% Curvas poligonales (gruesas): nivel 2, vértices (0,8; 4,528), (1,464; 2,536), (2,536; 1,464), (5,6; 0,442);
% nivel raíz 3, vértices (0,75; 3,75), (1,268; 2,196), (2,196; 1,268), (5,6; 0,133).
% Curva verdadera por x^2, x_1 x_2 = 4 (punteada). Rectas de balance finas.
% Escala: 1 unidad = 0,8 cm.
% Generar con: bash Code/generar_figura.sh anx_afriat
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=0.8cm, y=0.8cm]
  \draw[->] (0,0) -- (6.3,0) node[below] {$x_1$};
  \draw[->] (0,0) -- (0,6.3) node[left] {$x_2$};
  \draw[thin, dashed] (0,6) -- (2,0) node[below] {$B^1$};
  \draw[thin, dashed] (0,4) -- (4,0) node[below] {$B^2$};
  \draw[thin, dashed] (0,2) -- (6,0) node[below] {$B^3$};
  \draw[thin, densely dotted] plot[domain=0.7:5.6, samples=80] (\x,{4/\x});
  \draw[very thick] (0.8,4.528) -- (1.464,2.536) -- (2.536,1.464) -- (5.6,0.442);
  \draw[very thick] (0.75,3.75) -- (1.268,2.196) -- (2.196,1.268) -- (5.6,0.133);
  \fill (1,3) circle (2pt) node[left, xshift=-2pt] {$x^1$};
  \fill (2,2) circle (2pt) node[above right] {$x^2$};
  \fill (3,1) circle (2pt) node[above right] {$x^3$};
\end{tikzpicture}
