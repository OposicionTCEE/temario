% Figura (Anexo I, «Preferencias no convexas»): un bien adictivo (el 1), con un solo tramo no convexo.
% x_2 = 3,6 - 2,4 x_1 + 0,9 x_1^2 - 0,12 x_1^3, de pendiente negativa en todo el tramo (máximo -0,15 en x_1 = 2,5), convexa a
% la izquierda de 2,5 y cóncava a la derecha (la RMS crece con x_1); contorno superior en gris.
% y = (2,8; 1,302), z = (4; 0,72) y m = (3,4; 1,011), por debajo de la curva (x_2 = 1,128 en 3,4).
% Escala: 1 unidad = 1 cm; 4,4 x 4,4 cm.
% Generar con: bash Code/generar_figura.sh anx_adictivos
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1cm, y=1cm]
  \fill[black!12] plot[domain=0.2:4.3, samples=80] (\x,{3.6-2.4*\x+0.9*\x*\x-0.12*\x*\x*\x}) -- (4.3,4.2) -- (0.2,4.2)
    -- cycle;
  \draw[->] (0,0) -- (4.4,0) node[below] {$x_1$};
  \draw[->] (0,0) -- (0,4.4) node[left] {$x_2$};
  \draw[very thick] plot[domain=0.2:4.3, samples=80] (\x,{3.6-2.4*\x+0.9*\x*\x-0.12*\x*\x*\x});
  \draw[thick, dashed] (2.8,1.302) -- (4,0.72);
  \fill (2.8,1.302) circle (2pt) node[above right] {$y$};
  \fill (4,0.72) circle (2pt) node[above right] {$z$};
  \fill (3.4,1.011) circle (2pt) node[below left] {$m$};
\end{tikzpicture}
