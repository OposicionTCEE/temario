% Figura (bloque 3, «Frontera de Eficiencia»): la elección en el espacio de las características. Dos paneles.
% Características por unidad: b_A = (2; 0,5), b_B = (1,3; 1,3), b_C = (0,4; 2) (los de anx_lancaster) y un bien dominado,
% b_D = (0,6; 1,2). Con precios iguales a 1 y renta 2: A* = (4, 1), B* = (2,6; 2,6), C* = (0,8; 4) y z^D = (1,2; 2,4).
% (a) Frontera de eficiencia C*-B*-A* (gruesa). z^D queda dentro: su proyección radial sobre el tramo C*B*
%     (z_2 = 4,622 - 0,778 z_1) es z^D' = (1,664; 3,328), y su eficiencia técnica, Oz^D/Oz^D' = 0,72. Elección privada:
%     curva de indiferencia z_1^0,677 z_2^0,323 = 2,713, z_2 = 21,97 z_1^(-2,096), tangente en z* = (3,3; 1,8) (combina A y B).
% (b) El precio de B sube a 1,25: B** = (2,08; 2,08) queda por debajo del tramo A*-C* y B sale de la frontera (sustitución de
%     eficiencia). Frontera vieja punteada. Nueva tangencia en z* = (3,43; 1,535), z_2 = 20,34 z_1^(-2,096) (combina A y C).
% Escala: 1 unidad = 0,9 cm; paneles separados 6 cm.
% Generar con: bash Code/generar_figura.sh b3_lancaster
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=0.9cm, y=0.9cm]
  % ---------------- (a) Elección de eficiencia y elección privada ----------------
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (2.4,5.3) {(a) Eficiencia y elección privada};
    \draw[->] (0,0) -- (5,0) node[below] {$z_1$};
    \draw[->] (0,0) -- (0,4.9) node[left] {$z_2$};
    \draw[thin] (0,0) -- (4.6,1.15) node[right] {$A$};
    \draw[thin] (0,0) -- (3.4,3.4) node[above right] {$B$};
    \draw[thin] (0,0) -- (0.9,4.5) node[above] {$C$};
    \draw[thin] (0,0) -- (2.1,4.2) node[above right] {$D$};
    \draw[very thick] (0.8,4) -- (2.6,2.6) -- (4,1);
    \draw[thick, densely dashed] plot[domain=2.38:4.6, samples=80] (\x,{21.97*\x^(-2.096)});
    \foreach \p in {(4,1),(2.6,2.6),(0.8,4)} { \fill \p circle (1.8pt); }
    \draw[thick, fill=white] (1.2,2.4) circle (1.8pt);
    \node[left] at (1.15,2.4) {$z^D$};
    \fill (1.664,3.328) circle (1.8pt) node[right] {$z^{D'}$};
    \fill (3.3,1.8) circle (2.2pt) node[below left] {$z^*$};
  \end{scope}
  % ---------------- (b) Sube el precio de B ----------------
  \begin{scope}[xshift=6cm]
    \node[font=\footnotesize\bfseries] at (2.4,5.3) {(b) Sube el precio de $B$};
    \draw[->] (0,0) -- (5,0) node[below] {$z_1$};
    \draw[->] (0,0) -- (0,4.9) node[left] {$z_2$};
    \draw[thin] (0,0) -- (4.6,1.15) node[right] {$A$};
    \draw[thin] (0,0) -- (3.4,3.4) node[above right] {$B$};
    \draw[thin] (0,0) -- (0.9,4.5) node[above] {$C$};
    \draw[thin, dotted] (0.8,4) -- (2.6,2.6) -- (4,1);
    \draw[very thick] (0.8,4) -- (4,1);
    \draw[thick, densely dashed] plot[domain=2.3:4.6, samples=80] (\x,{20.34*\x^(-2.096)});
    \foreach \p in {(4,1),(0.8,4)} { \fill \p circle (1.8pt); }
    \draw[thick, fill=white] (2.08,2.08) circle (1.8pt);
    \fill (3.43,1.535) circle (2.2pt) node[below left] {$z^*$};
  \end{scope}
\end{tikzpicture}
