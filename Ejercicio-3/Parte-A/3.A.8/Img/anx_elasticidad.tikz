% Figura (Anexo I, «Precio Propio»): elasticidad precio y gasto a lo largo de una curva de demanda lineal. Dos paneles con
% el mismo eje vertical (p_1).
% (a) Demanda x_1 = 4 - p_1. E = (1, 3), en el tramo elástico; U = (2, 2), punto medio, elasticidad unitaria; I = (3, 1), en
%     el tramo inelástico. Rectángulo del gasto en U (gris, 4) y, con trazo discontinuo, en E y en I (3 cada uno).
% (b) Gasto p_1 x_1 = p_1 (4 - p_1) en el eje horizontal, con p_1 en el vertical: máximo, 4, en p_1 = 2; E = (3, 3) e
%     I = (3, 1).
% Escala: 1 unidad = 1 cm; cada panel, 4,4 x 4,4 cm.
% Generar con: bash Code/generar_figura.sh anx_elasticidad
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1cm, y=1cm]
  % ---------------- (a) Curva de demanda ----------------
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (2.2,4.85) {(a) Curva de demanda};
    \fill[black!12] (0,0) rectangle (2,2);
    \draw[thick, dashed] (0,3) -- (1,3) -- (1,0);
    \draw[thick, dashed] (0,1) -- (3,1) -- (3,0);
    \draw[->] (0,0) -- (4.4,0) node[below] {$x_1$};
    \draw[->] (0,0) -- (0,4.4) node[left] {$p_1$};
    \draw[very thick] (0,4) -- (4,0);
    \fill (1,3) circle (2pt) node[above right] {$E$};
    \fill (2,2) circle (2pt) node[above right] {$U$};
    \fill (3,1) circle (2pt) node[above right] {$I$};
    \node[anchor=west] at (1.9,3.7) {$\varepsilon_{11}<-1$};
    \node[anchor=west] at (2.7,2.15) {$\varepsilon_{11}=-1$};
    \node[anchor=west] at (3.35,1.15) {$-1<\varepsilon_{11}<0$};
  \end{scope}
  % ---------------- (b) Gasto en el bien ----------------
  \begin{scope}[xshift=7.2cm]
    \node[font=\footnotesize\bfseries] at (2.2,4.85) {(b) Gasto en el bien};
    \draw[->] (0,0) -- (4.6,0) node[below] {$p_1x_1$};
    \draw[->] (0,0) -- (0,4.4) node[left] {$p_1$};
    \draw[very thick] plot[domain=0:4, samples=80] ({\x*(4-\x)},{\x});
    \draw[densely dotted] (0,2) -- (4,2) -- (4,0);
    \fill (3,3) circle (2pt) node[right] {$E$};
    \fill (4,2) circle (2pt) node[right] {$U$};
    \fill (3,1) circle (2pt) node[below right] {$I$};
    \node[anchor=west] at (0.15,3.2) {elástica};
    \node[anchor=west] at (0.15,0.8) {inelástica};
  \end{scope}
\end{tikzpicture}
