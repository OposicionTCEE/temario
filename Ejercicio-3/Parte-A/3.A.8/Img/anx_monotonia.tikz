% Figura (Anexo I, «Monotonía»): qué excluye la monotonía y qué ocurre cuando falla. Cuatro paneles, 2 x 2.
% (a) Monotonía: curva x_1 x_2 = 4 y su contorno superior (gris), al noreste.
% (b) Un mal (x_2): curvas de indiferencia rectas de pendiente positiva, x_2 = x_1 + d con d = 1,2; 0; -1,2; la utilidad crece
%     hacia el sureste (flecha).
% (c) Saciedad: curvas cerradas alrededor del punto de saciedad s = (2,2; 2,2), radios 0,55; 1,1; 1,65.
% (d) Indiferencia gruesa: franja entre x_1 x_2 = 3 y x_1 x_2 = 5.
% Escala: 1 unidad = 1 cm; cada panel, 4,4 x 4,4 cm.
% Generar con: bash Code/generar_figura.sh anx_monotonia
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1cm, y=1cm]
  % ---------------- (a) Monotonía ----------------
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (2.2,4.85) {(a) Monotonía};
    \fill[black!12] plot[domain=1:4, samples=60] (\x,{4/\x}) -- (4,4) -- cycle;
    \draw[->] (0,0) -- (4.4,0) node[below] {$x_1$};
    \draw[->] (0,0) -- (0,4.4) node[left] {$x_2$};
    \draw[very thick] plot[domain=1:4, samples=60] (\x,{4/\x});
    \fill (2,2) circle (2pt) node[below left] {$x$};
    \node at (3.1,3.2) {$\succsim(x)$};
  \end{scope}
  % ---------------- (b) Un mal ----------------
  \begin{scope}[xshift=5.8cm]
    \node[font=\footnotesize\bfseries] at (2.2,4.85) {(b) Un mal ($x_2$)};
    \draw[->] (0,0) -- (4.4,0) node[below] {$x_1$};
    \draw[->] (0,0) -- (0,4.4) node[left] {$x_2$};
    \draw[very thick] (0,1.2) -- (2.8,4);
    \draw[very thick] (0.15,0.15) -- (4,4);
    \draw[very thick] (1.2,0) -- (4,2.8);
    \draw[->, thick] (1.5,2.9) -- (2.5,1.9);
  \end{scope}
  % ---------------- (c) Saciedad ----------------
  \begin{scope}[yshift=-5.8cm]
    \node[font=\footnotesize\bfseries] at (2.2,4.85) {(c) Saciedad};
    \draw[->] (0,0) -- (4.4,0) node[below] {$x_1$};
    \draw[->] (0,0) -- (0,4.4) node[left] {$x_2$};
    \foreach \r in {0.55,1.1,1.65} { \draw[very thick] (2.2,2.2) circle (\r); }
    \fill (2.2,2.2) circle (2pt);
    \node[right] at (2.25,2.2) {$s$};
  \end{scope}
  % ---------------- (d) Indiferencia gruesa ----------------
  \begin{scope}[xshift=5.8cm, yshift=-5.8cm]
    \node[font=\footnotesize\bfseries] at (2.2,4.85) {(d) Indiferencia gruesa};
    \fill[black!25] plot[domain=0.75:4, samples=60] (\x,{3/\x}) -- plot[domain=4:1.25, samples=60] (\x,{5/\x}) -- cycle;
    \draw[->] (0,0) -- (4.4,0) node[below] {$x_1$};
    \draw[->] (0,0) -- (0,4.4) node[left] {$x_2$};
    \draw[thick] plot[domain=0.75:4, samples=60] (\x,{3/\x});
    \draw[thick] plot[domain=1.25:4, samples=60] (\x,{5/\x});
  \end{scope}
\end{tikzpicture}
