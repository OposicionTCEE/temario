% Figura (Anexo I, «Monotonía»): tres mapas monótonos, de los que solo el primero es convexo. Tres paneles.
% En los tres, la curva de indiferencia que pasa por x = (2, 2) tiene pendiente negativa y su contorno superior (gris) queda
% al noreste: la monotonía no fija la curvatura.
% (a) Convexas: x_1 x_2 = 4.
% (b) Cóncavas hacia el origen: arco de radio 2,828 centrado en el origen (x_1^2 + x_2^2 = 8), entre 80 y 10 grados.
% (c) Por tramos: x_2 = 4 - x_1 + 0,35 sen(2 (x_1 - 2)), de pendiente -1 + 0,7 cos(...) < 0; convexa a la izquierda de x
%     y cóncava a la derecha.
% Escala: 1 unidad = 1 cm; cada panel, 4,2 x 4,2 cm.
% Generar con: bash Code/generar_figura.sh anx_monotonia
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1cm, y=1cm]
  % ---------------- (a) Convexas ----------------
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (2.1,4.7) {(a) Convexas};
    \fill[black!12] plot[domain=0.95:4.2, samples=60] (\x,{4/\x}) -- (4.2,4.2) -- cycle;
    \draw[->] (0,0) -- (4.4,0) node[below] {$x_1$};
    \draw[->] (0,0) -- (0,4.4) node[left] {$x_2$};
    \draw[very thick] plot[domain=0.95:4.2, samples=60] (\x,{4/\x});
    \fill (2,2) circle (2pt) node[below left] {$x$};
    \node at (3.1,3.2) {$\succsim(x)$};
  \end{scope}
  % ---------------- (b) Cóncavas ----------------
  \begin{scope}[xshift=5.4cm]
    \node[font=\footnotesize\bfseries] at (2.1,4.7) {(b) Cóncavas};
    \fill[black!12] (0.491,2.785) arc (80:10:2.828) -- (4.2,0.491) -- (4.2,4.2) -- (0.491,4.2) -- cycle;
    \draw[->] (0,0) -- (4.4,0) node[below] {$x_1$};
    \draw[->] (0,0) -- (0,4.4) node[left] {$x_2$};
    \draw[very thick] (0.491,2.785) arc (80:10:2.828);
    \fill (2,2) circle (2pt) node[below left] {$x$};
    \node at (3.1,3.2) {$\succsim(x)$};
  \end{scope}
  % ---------------- (c) Por tramos ----------------
  \begin{scope}[xshift=10.8cm]
    \node[font=\footnotesize\bfseries] at (2.1,4.7) {(c) Por tramos};
    \fill[black!12] plot[domain=0.3:3.7, samples=80] (\x,{4-\x+0.35*sin(2*(\x-2) r)}) -- (4.2,0.211) -- (4.2,4.2)
      -- (0.3,4.2) -- cycle;
    \draw[->] (0,0) -- (4.4,0) node[below] {$x_1$};
    \draw[->] (0,0) -- (0,4.4) node[left] {$x_2$};
    \draw[very thick] plot[domain=0.3:3.7, samples=80] (\x,{4-\x+0.35*sin(2*(\x-2) r)});
    \fill (2,2) circle (2pt) node[below left] {$x$};
    \node at (3.1,3.2) {$\succsim(x)$};
  \end{scope}
\end{tikzpicture}
