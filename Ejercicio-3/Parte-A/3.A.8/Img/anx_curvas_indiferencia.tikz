% Figura (Anexo I, «Curvas de Indiferencia»): dos propiedades del mapa de indiferencia. Dos paneles.
% (a) Por qué no se cortan: x_1 x_2 = 4 y x_2 = 8/x_1^2 se cortarían en x = (2, 2); y = (3,2; 1,25) está en la primera y
%     z = (3,2; 0,781), en la segunda: y tiene la misma cantidad del bien 1 y más del bien 2 que z.
% (b) RMS decreciente: x_1 x_2 = 4; tangentes en A = (1, 4), pendiente -4, y en B = (4, 1), pendiente -1/4.
% Escala: 1 unidad = 1 cm; cada panel, 5,4 x 5,4 cm.
% Generar con: bash Code/generar_figura.sh anx_curvas_indiferencia
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1cm, y=1cm]
  % ---------------- (a) No se cortan ----------------
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (2.7,5.9) {(a) Dos curvas que se cortaran};
    \draw[->] (0,0) -- (5.6,0) node[below] {$x_1$};
    \draw[->] (0,0) -- (0,5.6) node[left] {$x_2$};
    \draw[very thick] plot[domain=0.8:5.2, samples=80] (\x,{4/\x});
    \draw[very thick, dashed] plot[domain=1.25:5.2, samples=80] (\x,{8/(\x*\x)});
    \fill (2,2) circle (2pt) node[above right] {$x$};
    \fill (3.2,1.25) circle (2pt) node[above right] {$y$};
    \fill (3.2,0.781) circle (2pt) node[below left] {$z$};
    \draw[densely dotted] (3.2,0) -- (3.2,1.25);
  \end{scope}
  % ---------------- (b) RMS decreciente ----------------
  \begin{scope}[xshift=7cm]
    \node[font=\footnotesize\bfseries] at (2.7,5.9) {(b) Relación marginal de sustitución};
    \draw[->] (0,0) -- (5.6,0) node[below] {$x_1$};
    \draw[->] (0,0) -- (0,5.6) node[left] {$x_2$};
    \draw[very thick] plot[domain=0.78:5.2, samples=80] (\x,{4/\x});
    \draw[thick] (0.65,5.4) -- (1.35,2.6);
    \draw[thick] (2.8,1.3) -- (5.2,0.7);
    \fill (1,4) circle (2pt) node[right, xshift=2pt] {$A$};
    \fill (4,1) circle (2pt) node[above, yshift=2pt] {$B$};
  \end{scope}
\end{tikzpicture}
