% Figura (bloque 1, «Precios Cruzados»): el signo de la elasticidad cruzada del bien 2 respecto del precio del bien 1, leído
% en la senda precio-consumo. Tres paneles con las mismas rectas de balance: p_2 = 1, W = 4; p_1 baja de 2 (recta de (0, 4)
% a (2, 0), cesta A) a 1 (recta de (0, 4) a (4, 0), cesta B). Mismos datos que anx_cruzados (anexo I), con solo dos precios,
% las curvas de indiferencia y la variación de x_2 marcada en el eje (flecha), que es lo que el cuerpo comenta.
% (a) Complementarios perfectos, min{x_1, x_2}: A = (1,333; 1,333), B = (2; 2): x_2 sube al bajar p_1 (epsilon_21 < 0).
% (b) COBB-DOUGLAS con a = 1/2: A = (1; 2), B = (2; 2), curvas x_1 x_2 = 2 y 4: x_2 no cambia (epsilon_21 = 0).
% (c) CES con pesos iguales y sigma = 3 (rho = 2/3): A = (0,4; 3,2), B = (2; 2), curvas x_1^(2/3) + x_2^(2/3) = 2,7144 y
%     3,1748: x_2 baja al bajar p_1 (epsilon_21 > 0). Senda precio-consumo (discontinua) por los puntos intermedios de
%     anx_cruzados, con p_1 = 4/3: (1,714; 1,714), (1,5; 2) y (1,08; 2,56).
% Escala: 1 unidad = 1 cm; paneles separados 6 cm.
% Generar con: bash Code/generar_figura.sh b1_cruzados
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1cm, y=1cm]
  % ---------------- (a) Complementarios brutos ----------------
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (2.2,4.85) {(a) Complementarios brutos};
    \draw[->] (0,0) -- (4.4,0) node[below] {$x_1$};
    \draw[->] (0,0) -- (0,4.4) node[left] {$x_2$};
    \draw[thick] (0,4) -- (2,0);
    \draw[thick] (0,4) -- (4,0);
    \draw (1.333,3.2) -- (1.333,1.333) -- (3.4,1.333);
    \draw (2,3.6) -- (2,2) -- (3.8,2);
    \draw[dashed] (1.333,1.333) -- (2,2);
    \draw[densely dotted] (1.333,1.333) -- (0,1.333) node[left] {$x_2^A$};
    \draw[densely dotted] (2,2) -- (0,2) node[left] {$x_2^B$};
    \draw[->, very thick] (0.2,1.333) -- (0.2,2);
    \fill (1.333,1.333) circle (2pt) node[below right] {$A$};
    \fill (2,2) circle (2pt) node[above right] {$B$};
    \node at (2.2,-0.75) {$\varepsilon_{21}<0$};
  \end{scope}
  % ---------------- (b) Independientes ----------------
  \begin{scope}[xshift=6cm]
    \node[font=\footnotesize\bfseries] at (2.2,4.85) {(b) Independientes};
    \draw[->] (0,0) -- (4.4,0) node[below] {$x_1$};
    \draw[->] (0,0) -- (0,4.4) node[left] {$x_2$};
    \draw[thick] (0,4) -- (2,0);
    \draw[thick] (0,4) -- (4,0);
    \draw plot[domain=0.5:4.2, samples=60] (\x,{2/\x});
    \draw plot[domain=0.95:4.2, samples=60] (\x,{4/\x});
    \draw[dashed] (1,2) -- (2,2);
    \draw[densely dotted] (1,2) -- (0,2) node[left] {$x_2^A=x_2^B$};
    \fill (1,2) circle (2pt) node[above left] {$A$};
    \fill (2,2) circle (2pt) node[above right] {$B$};
    \node at (2.2,-0.75) {$\varepsilon_{21}=0$};
  \end{scope}
  % ---------------- (c) Sustitutivos brutos ----------------
  \begin{scope}[xshift=12cm]
    \node[font=\footnotesize\bfseries] at (2.2,4.85) {(c) Sustitutivos brutos};
    \draw[->] (0,0) -- (4.4,0) node[below] {$x_1$};
    \draw[->] (0,0) -- (0,4.4) node[left] {$x_2$};
    \draw[thick] (0,4) -- (2,0);
    \draw[thick] (0,4) -- (4,0);
    \draw plot[domain=0.02:3.6, samples=80] (\x,{(2.7144-(\x)^(2/3))^(1.5)});
    \draw plot[domain=0.4:4.3, samples=80] (\x,{(3.1748-(\x)^(2/3))^(1.5)});
    \draw[dashed] plot[smooth] coordinates {(0.4,3.2) (1.08,2.56) (2,2)};
    \draw[densely dotted] (0.4,3.2) -- (0,3.2) node[left] {$x_2^A$};
    \draw[densely dotted] (2,2) -- (0,2) node[left] {$x_2^B$};
    \draw[->, very thick] (0.2,3.2) -- (0.2,2);
    \fill (0.4,3.2) circle (2pt) node[right] {$A$};
    \fill (2,2) circle (2pt) node[above right] {$B$};
    \node at (2.2,-0.75) {$\varepsilon_{21}>0$};
  \end{scope}
\end{tikzpicture}
