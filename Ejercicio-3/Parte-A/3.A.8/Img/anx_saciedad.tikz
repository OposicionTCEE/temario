% Figura (Anexo I, «Monotonía»): un punto de saciedad. Era el panel (c) de anx_monotonia.
% Curvas de indiferencia cerradas alrededor del punto de saciedad s = (2,2; 2,2), radios 0,55; 1,1; 1,65.
% Escala: 1 unidad = 1 cm; 4,4 x 4,4 cm.
% Generar con: bash Code/generar_figura.sh anx_saciedad
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1cm, y=1cm]
  \draw[->] (0,0) -- (4.4,0) node[below] {$x_1$};
  \draw[->] (0,0) -- (0,4.4) node[left] {$x_2$};
  \foreach \r in {0.55,1.1,1.65} { \draw[very thick] (2.2,2.2) circle (\r); }
  \fill (2.2,2.2) circle (2pt);
  \node[right] at (2.25,2.2) {$s$};
\end{tikzpicture}
