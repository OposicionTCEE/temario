% Figura (Anexo II, «Matriz de SLUTSKY»): un ciclo de preferencia revelada con tres bienes que no se contradice de dos en dos.
% Datos (cuadro del texto): x^1 = (1, 0, 0) con p^1 = (2, 1, 3); x^2 = (0, 1, 0) con p^2 = (3, 2, 1); x^3 = (0, 0, 1) con
% p^3 = (1, 3, 2); renta 2 en las tres situaciones.
% Flechas continuas: x^t se revela preferida a x^(t+1), que era más barata cuando se eligió x^t (coste 1 < 2).
% Flechas punteadas tachadas: la revelación inversa no existe, porque x^t no era asequible cuando se eligió x^(t+1) (coste 3 > 2).
% Generar con: bash Code/generar_figura.sh anx_ciclo
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=5pt]},
    cesta/.style={draw, circle, thick, minimum size=0.95cm, inner sep=1pt}]
  \node[cesta] (x1) at (90:1.9) {$x^1$};
  \node[cesta] (x2) at (210:1.9) {$x^2$};
  \node[cesta] (x3) at (330:1.9) {$x^3$};
  % Revelaciones directas (continuas)
  \draw[->, very thick] (x1) to[bend right=18] node[midway, left, xshift=-2pt] {$x^1\succ x^2$} (x2);
  \draw[->, very thick] (x2) to[bend right=18] node[midway, below, yshift=-2pt] {$x^2\succ x^3$} (x3);
  \draw[->, very thick] (x3) to[bend right=18] node[midway, right, xshift=2pt] {$x^3\succ x^1$} (x1);
  % Revelaciones inversas que no existen (punteadas, tachadas)
  \draw[->, densely dotted] (x2) to[bend right=18] coordinate[midway] (m12) (x1);
  \draw[->, densely dotted] (x3) to[bend right=18] coordinate[midway] (m23) (x2);
  \draw[->, densely dotted] (x1) to[bend right=18] coordinate[midway] (m31) (x3);
  \foreach \m in {m12, m23, m31} { \node[font=\normalsize] at (\m) {$\times$}; }
\end{tikzpicture}
