% Figura (Anexo I, «Solución»): la cesta elegida. Dos paneles.
% (a) Solución interior: recta x_1 + x_2 = 4; curvas x_1 x_2 = 2; 4; 6,25; tangencia en x* = (2, 2), donde el gradiente
%     de la utilidad (flecha) es perpendicular a la recta de balance, proporcional a los precios.
% (b) Solución de esquina: utilidad u = x_1 + 0,5 ln(1 + x_2), cuya RMS_12 = 2(1 + x_2) supera siempre el precio relativo
%     p_1/p_2 = 0,75 de la recta (0; 3)-(4; 0); curvas x_2 = exp(2(U - x_1)) - 1 con U = 3,4; 4; 4,6; la elegida es la
%     esquina x* = (4, 0).
% Escala: 1 unidad = 1 cm.
% Generar con: bash Code/generar_figura.sh anx_optimo
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1cm, y=1cm]
  % ---------------- (a) Solución interior ----------------
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (2.4,5.1) {(a) Solución interior};
    \fill[black!12] (0,0) -- (0,4) -- (4,0) -- cycle;
    \draw[->] (0,0) -- (4.8,0) node[below] {$x_1$};
    \draw[->] (0,0) -- (0,4.8) node[left] {$x_2$};
    \draw[very thick] (0,4) -- (4,0);
    \draw[thick] plot[domain=0.47:4.5, samples=80] (\x,{2/\x});
    \draw[thick] plot[domain=0.9:4.5, samples=80] (\x,{4/\x});
    \draw[thick] plot[domain=1.4:4.5, samples=80] (\x,{6.25/\x});
    \fill (2,2) circle (2pt);
    \node[below left] at (2,2) {$x^*$};
    \draw[->, thick] (2,2) -- (2.65,2.65) node[above right] {$\nabla u(x^*)$};
  \end{scope}
  % ---------------- (b) Solución de esquina ----------------
  \begin{scope}[xshift=6.4cm]
    \node[font=\footnotesize\bfseries] at (2.4,5.1) {(b) Solución de esquina};
    \fill[black!12] (0,0) -- (0,3) -- (4,0) -- cycle;
    \draw[->] (0,0) -- (4.8,0) node[below] {$x_1$};
    \draw[->] (0,0) -- (0,4.8) node[left] {$x_2$};
    \draw[very thick] (0,3) -- (4,0);
    \foreach \U in {3.4,4,4.6} {
      \draw[thick] plot[domain={\U-0.5*ln(1+4.4)}:\U, samples=80] (\x,{exp(2*(\U-\x))-1});
    }
    \fill (4,0) circle (2pt);
    \node[above right] at (4,0) {$x^*$};
  \end{scope}
\end{tikzpicture}
