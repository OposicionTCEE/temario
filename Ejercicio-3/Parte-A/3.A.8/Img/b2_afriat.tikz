% Figura (bloque 2, «Teorema de AFRIAT»): la curva de indiferencia que pasa por x^2, construida con las tres elecciones del
% ejemplo del bloque: x^1 = (1, 3) con B^1 = {3 x_1 + x_2 <= 6}; x^2 = (2, 2) con B^2 = {x_1 + x_2 <= 4}; x^3 = (3, 1) con
% B^3 = {x_1 + 3 x_2 <= 6}. Números de AFRIAT: U = (raíz 3; 2; raíz 3), lambda = (0,2887; 0,5; 0,2887) (los de anx_afriat).
% Utilidad construida: u(x) = min{0,866 x_1 + 0,2887 x_2; 0,5 x_1 + 0,5 x_2; 0,2887 x_1 + 0,866 x_2}.
% Curva de nivel u = 2 (gruesa), poligonal, con un tramo paralelo a cada recta de balance: (0,643; 5) - (1,464; 2,536) sobre
% 0,866 x_1 + 0,2887 x_2 = 2 (pendiente -3, la de B^1); de ahí a (2,536; 1,464) sobre B^2; y hasta (6; 0,309) sobre
% 0,2887 x_1 + 0,866 x_2 = 2 (pendiente -1/3, la de B^3). En gris, las cestas con u >= 2. x^1 y x^3 quedan por debajo (u = raíz 3).
% Escala: 1 unidad = 0,8 cm.
% Generar con: bash Code/generar_figura.sh b2_afriat
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=0.8cm, y=0.8cm]
  \fill[gray!20] (0.643,5) -- (1.464,2.536) -- (2.536,1.464) -- (6,0.309) -- (6,5) -- cycle;
  \draw[->] (0,0) -- (6.8,0) node[below] {$x_1$};
  \draw[->] (0,0) -- (0,5.4) node[left] {$x_2$};
  \draw[thin] (0.333,5) -- (2,0) node[below] {$B^1$};
  \draw[thin] (0,4) -- (4,0) node[below] {$B^2$};
  \draw[thin] (0,2) -- (6,0) node[below] {$B^3$};
  \draw[very thick] (0.643,5) -- (1.464,2.536) -- (2.536,1.464) -- (6,0.309);
  \fill (1,3) circle (2pt) node[below left] {$x^1$};
  \fill (2,2) circle (2pt) node[below left] {$x^2$};
  \fill (3,1) circle (2pt) node[below left] {$x^3$};
\end{tikzpicture}
