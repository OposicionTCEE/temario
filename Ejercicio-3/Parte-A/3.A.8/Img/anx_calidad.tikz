% Figura (Anexo III, «Índices de Precios Hedónicos»): separar el cambio de precio en calidad y precio puro.
% Una característica. Función hedónica doble logarítmica en el periodo base, ln p = 1 + 0,5 ln z (recta continua), y en el
% corriente, desplazada hacia arriba en delta = 0,6 (recta discontinua). El modelo viejo, m, se vende en el periodo base en
% M^0 = (1,5; 1,75); el nuevo, n, con más de la característica, en el corriente en N^1 = (3,5; 3,35). N^0 = (3,5; 2,75) es
% el precio que habría tenido el modelo nuevo en el periodo base. La diferencia de log-precios entre M^0 y N^1 se divide en
% calidad, alpha (ln z^n - ln z^m) = 1, a lo largo de la función base, y precio puro, delta = 0,6, entre las dos funciones.
% Ejes: ln z (horizontal) y ln p (vertical). Escala: 1 unidad = 1 cm.
% Generar con: bash Code/generar_figura.sh anx_calidad
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1cm, y=1cm]
  \draw[->] (0,0) -- (5.6,0) node[below] {$\ln z$};
  \draw[->] (0,0) -- (0,4.4) node[left] {$\ln p$};
  \draw[very thick] (0.3,1.15) -- (4.8,3.4) node[right] {$t=0$};
  \draw[very thick, dashed] (0.3,1.75) -- (4.8,4.0) node[right] {$t=1$};
  \fill (1.5,1.75) circle (2pt) node[above left] {$M^0$};
  \draw[thick, fill=white] (3.5,2.75) circle (2pt);
  \node[above left] at (3.48,2.77) {$N^0$};
  \fill (3.5,3.35) circle (2pt) node[above left] {$N^1$};
  \draw[densely dotted] (1.5,1.75) -- (3.5,1.75);
  \draw[densely dotted] (1.5,1.75) -- (1.5,0) node[below] {$\ln z^m$};
  \draw[densely dotted] (3.5,1.75) -- (3.5,0) node[below] {$\ln z^n$};
  \draw[decorate, decoration={brace, amplitude=4pt, mirror}] (3.65,1.75) -- (3.65,2.73) node[midway, right, xshift=4pt] {$\alpha\,(\ln z^n-\ln z^m)$};
  \draw[decorate, decoration={brace, amplitude=4pt, mirror}] (3.65,2.77) -- (3.65,3.35) node[midway, right, xshift=4pt] {$\delta$};
\end{tikzpicture}
