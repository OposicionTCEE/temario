% Figura (bloque 1, «Representación»): la utilidad numera las curvas de indiferencia (construcción por la diagonal).
% Curvas x_1 x_2 = 2,25 (por x = (2,6; 0,865)) y x_1 x_2 = 5,29 (por y = (1,6; 3,306)). La diagonal, las cestas alpha e con
% e = (1, 1), corta la primera en alpha(x) e = (1,5; 1,5) y la segunda en alpha(y) e = (2,3; 2,3): la utilidad de cada cesta es
% el punto en que su curva corta la diagonal, que se lee en el eje horizontal. Discontinua: tangente en x, cuya pendiente es
% -RMS_12(x) = -2,25/2,6^2 = -0,333.
% Escala: 1 unidad = 1 cm.
% Generar con: bash Code/generar_figura.sh b1_utilidad
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1cm, y=1cm]
  \draw[->] (0,0) -- (5.0,0) node[below] {$x_1$};
  \draw[->] (0,0) -- (0,4.2) node[left] {$x_2$};
  \draw[thin] (0,0) -- (3.8,3.8) node[above right] {$\alpha\,e$};
  \draw[very thick] plot[domain=0.56:4.7, samples=80] (\x,{2.25/\x});
  \draw[very thick] plot[domain=1.32:4.7, samples=80] (\x,{5.29/\x});
  \draw[dashed] (1.6,1.198) -- (3.8,0.465);
  \draw[densely dotted] (1.5,1.5) -- (1.5,0) node[below] {$\alpha(x)$};
  \draw[densely dotted] (2.3,2.3) -- (2.3,0) node[below] {$\alpha(y)$};
  \draw[thick, fill=white] (1.5,1.5) circle (1.6pt);
  \draw[thick, fill=white] (2.3,2.3) circle (1.6pt);
  \fill (2.6,0.865) circle (1.8pt) node[above right] {$x$};
  \fill (1.6,3.306) circle (1.8pt) node[above right] {$y$};
\end{tikzpicture}
