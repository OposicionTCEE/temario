% Figura (Anexo II, «Axioma Débil»): la compensación de SLUTSKY y la ley de la demanda compensada.
% Datos de una COBB-DOUGLAS con a = 1/2. Con p = (1, 1) y W = 4 se elige x^0 = (2, 2) en B^0 (recta de (0, 4) a (4, 0)).
% Baja el precio del bien 1 a 0,6: la recta nueva, B^1, va de (0, 4) a (6,667; 0), y la compensada, B^S, pasa por x^0 con la
% pendiente nueva, de (0; 3,2) a (5,333; 0) (W' = 3,2). El tramo de B^S a la izquierda de x^0 (gris grueso) estaba dentro de
% B^0 y el axioma débil lo excluye. Elección compensada x^S = (2,667; 1,6) y elección final x^1 = (3,333; 2).
% Escala: 1 unidad = 0,85 cm.
% Generar con: bash Code/generar_figura.sh anx_compensacion
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=0.85cm, y=0.85cm]
  \draw[->] (0,0) -- (7.2,0) node[below] {$x_1$};
  \draw[->] (0,0) -- (0,4.6) node[left] {$x_2$};
  \draw[very thick] (0,4) -- (4,0) node[below] {$B^0$};
  \draw[very thick] (0,4) -- (6.667,0) node[below] {$B^1$};
  \draw[thick, dashed] (0,3.2) -- (5.333,0) node[below] {$B^S$};
  \draw[line width=3pt, black!35] (0,3.2) -- (2,2);
  \fill (2,2) circle (2.2pt) node[above right] {$x^0$};
  \fill (2.667,1.6) circle (2.2pt) node[below left] {$x^S$};
  \fill (3.333,2) circle (2.2pt) node[above right] {$x^1$};
  \draw[densely dotted] (2,2) -- (2,0) node[below] {$x_1^0$};
  \draw[densely dotted] (2.667,1.6) -- (2.667,0);
  \draw[densely dotted] (3.333,2) -- (3.333,0);
  \node[below] at (2.72,-0.02) {$x_1^S$};
  \node[below] at (3.42,-0.02) {$x_1^1$};
\end{tikzpicture}
