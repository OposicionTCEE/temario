% Figura (Anexo I, «Derivabilidad»): una demanda derivable y dos que no lo son en algún precio. Tres paneles, curvas de
% demanda del bien 1 con p_1 en el eje vertical (1 unidad = 2 cm) y x_1 en el horizontal (1 unidad = 1 cm).
% (a) Derivable: x_1 = 2/p_1.
% (b) Esquina: x_1 = 1,5 (1/p_1 - 1) si p_1 < 1 y x_1 = 0 si p_1 >= 1 (tramo sobre el eje): vértice en el precio de
%     reserva, p^R = 1.
% (c) Vértice en la curva de indiferencia: x_1 = 2,4/p_1 si p_1 > 1,2; x_1 = 2 si 0,6 <= p_1 <= 1,2 (tramo vertical: la
%     misma cesta con todos esos precios); x_1 = 1,2/p_1 si p_1 < 0,6. Vértices en (2; 1,2) y (2; 0,6).
% Generar con: bash Code/generar_figura.sh anx_derivable
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1cm, y=2cm]
  % ---------------- (a) Derivable ----------------
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (2.2,2.4) {(a) Derivable};
    \draw[->] (0,0) -- (4.6,0) node[below] {$x_1$};
    \draw[->] (0,0) -- (0,2.2) node[left] {$p_1$};
    \draw[very thick] plot[domain=0.47:2, samples=80] ({2/\x},{\x});
  \end{scope}
  % ---------------- (b) Esquina ----------------
  \begin{scope}[xshift=5.15cm]
    \node[font=\footnotesize\bfseries] at (2.2,2.4) {(b) Esquina};
    \draw[->] (0,0) -- (4.6,0) node[below] {$x_1$};
    \draw[->] (0,0) -- (0,2.2) node[left] {$p_1$};
    \draw[very thick] (0,2) -- (0,1);
    \draw[very thick] plot[domain=0.27:1, samples=80] ({1.5*(1/\x-1)},{\x});
    \draw[thick] (0,1) circle (3pt);
    \node[right, xshift=3pt] at (0,1.05) {$p^R$};
  \end{scope}
  % ---------------- (c) Vértice ----------------
  \begin{scope}[xshift=10.8cm]
    \node[font=\footnotesize\bfseries] at (2.2,2.4) {(c) Vértice};
    \draw[->] (0,0) -- (4.6,0) node[below] {$x_1$};
    \draw[->] (0,0) -- (0,2.2) node[left] {$p_1$};
    \draw[very thick] plot[domain=1.2:2, samples=60] ({2.4/\x},{\x});
    \draw[very thick] (2,1.2) -- (2,0.6);
    \draw[very thick] plot[domain=0.3:0.6, samples=60] ({1.2/\x},{\x});
    \draw[thick] (2,1.2) circle (3pt);
    \draw[thick] (2,0.6) circle (3pt);
  \end{scope}
\end{tikzpicture}
