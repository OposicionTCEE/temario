% Figura (Anexo I, «Demanda de Mercado»): la suma horizontal de dos demandas individuales. Tres paneles.
% Consumidor A: x_A = 4 - 2p para p <= 2; consumidor B: x_B = 3 - p para p <= 3; mercado: X = 3 - p si 2 <= p <= 3 y
% X = 7 - 3p si p < 2, con un vértice en p = 2, donde entra el consumidor A. Con p = 1: x_A = 2, x_B = 2, X = 4 (discontinua).
% Escala: horizontal, 1 unidad = 0,7 cm; vertical, 1 unidad = 1 cm.
% Generar con: bash Code/generar_figura.sh anx_agregacion
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=0.7cm, y=1cm]
  % ---------------- (a) Consumidor A ----------------
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (2.4,3.8) {(a) Consumidor A};
    \draw[->] (0,0) -- (4.8,0) node[below] {$x_A$};
    \draw[->] (0,0) -- (0,3.5) node[left] {$p$};
    \draw[very thick] (0,2) -- (4,0);
    \draw[densely dashed] (0,1) -- (2,1);
    \fill (2,1) circle (2pt);
  \end{scope}
  % ---------------- (b) Consumidor B ----------------
  \begin{scope}[xshift=4.8cm]
    \node[font=\footnotesize\bfseries] at (2.4,3.8) {(b) Consumidor B};
    \draw[->] (0,0) -- (4.8,0) node[below] {$x_B$};
    \draw[->] (0,0) -- (0,3.5) node[left] {$p$};
    \draw[very thick] (0,3) -- (3,0);
    \draw[densely dashed] (0,1) -- (2,1);
    \fill (2,1) circle (2pt);
  \end{scope}
  % ---------------- (c) Mercado ----------------
  \begin{scope}[xshift=9.6cm]
    \node[font=\footnotesize\bfseries] at (4,3.8) {(c) Mercado};
    \draw[->] (0,0) -- (8,0) node[below] {$X=x_A+x_B$};
    \draw[->] (0,0) -- (0,3.5) node[left] {$p$};
    \draw[very thick] (0,3) -- (1,2) -- (7,0);
    \draw[densely dashed] (0,1) -- (4,1);
    \fill (4,1) circle (2pt);
    \draw[densely dotted] (0,2) -- (1,2);
    \node[left] at (0,2) {$2$};
  \end{scope}
\end{tikzpicture}
