% Figura (Anexo I, «Convexidad»): dos cestas indiferentes, y y z, y su mezcla m (punto medio). Tres paneles.
% (a) Estrictamente convexas: x_1 x_2 = 4; y = (1,2; 3,333), z = (3,333; 1,2); m = (2,267; 2,267), por encima de la curva.
% (b) Convexas, no estrictamente: curva con un tramo recto entre y = (1,6; 2,6) y z = (2,6; 1,6); m = (2,1; 2,1), en el tramo.
% (c) No convexas: arco de radio 3 centrado en el origen (cóncavo hacia el origen); y y z en los ángulos de 72 y 18 grados;
%     m = (1,89; 1,89), por debajo de la curva.
% El contorno superior de la curva, en gris. Escala: 1 unidad = 1 cm; cada panel, 4,2 x 4,2 cm.
% Generar con: bash Code/generar_figura.sh anx_convexidad
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1cm, y=1cm]
  % ---------------- (a) Estrictamente convexas ----------------
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (2.1,4.7) {(a) Estrictamente convexas};
    \fill[black!12] plot[domain=0.95:4.2, samples=60] (\x,{4/\x}) -- (4.2,4.2) -- cycle;
    \draw[->] (0,0) -- (4.4,0) node[below] {$x_1$};
    \draw[->] (0,0) -- (0,4.4) node[left] {$x_2$};
    \draw[very thick] plot[domain=0.95:4.2, samples=60] (\x,{4/\x});
    \draw[thick, dashed] (1.2,3.333) -- (3.333,1.2);
    \fill (1.2,3.333) circle (2pt) node[left] {$y$};
    \fill (3.333,1.2) circle (2pt) node[below] {$z$};
    \fill (2.267,2.267) circle (2pt) node[above right] {$m$};
  \end{scope}
  % ---------------- (b) Convexas, no estrictamente ----------------
  \begin{scope}[xshift=5.4cm]
    \node[font=\footnotesize\bfseries] at (2.1,4.7) {(b) Convexas, no estrictamente};
    \fill[black!12] (0.8,4.2) -- (0.8,4) .. controls (0.95,3.3) and (1.35,2.85) .. (1.6,2.6) -- (2.6,1.6)
      .. controls (2.85,1.35) and (3.3,0.95) .. (4.2,0.8) -- (4.2,4.2) -- cycle;
    \draw[->] (0,0) -- (4.4,0) node[below] {$x_1$};
    \draw[->] (0,0) -- (0,4.4) node[left] {$x_2$};
    \draw[very thick] (0.8,4) .. controls (0.95,3.3) and (1.35,2.85) .. (1.6,2.6) -- (2.6,1.6)
      .. controls (2.85,1.35) and (3.3,0.95) .. (4.2,0.8);
    \fill (1.6,2.6) circle (2pt) node[below left] {$y$};
    \fill (2.6,1.6) circle (2pt) node[below left] {$z$};
    \fill (2.1,2.1) circle (2pt) node[above right] {$m$};
  \end{scope}
  % ---------------- (c) No convexas ----------------
  \begin{scope}[xshift=10.8cm]
    \node[font=\footnotesize\bfseries] at (2.1,4.7) {(c) No convexas};
    \fill[black!12] (0.52,2.954) arc (80:10:3) -- (4.2,0.521) -- (4.2,4.2) -- (0.52,4.2) -- cycle;
    \draw[->] (0,0) -- (4.4,0) node[below] {$x_1$};
    \draw[->] (0,0) -- (0,4.4) node[left] {$x_2$};
    \draw[very thick] (0.52,2.954) arc (80:10:3);
    \draw[thick, dashed] (0.927,2.853) -- (2.853,0.927);
    \fill (0.927,2.853) circle (2pt) node[above right] {$y$};
    \fill (2.853,0.927) circle (2pt) node[above right] {$z$};
    \fill (1.89,1.89) circle (2pt) node[below left] {$m$};
  \end{scope}
\end{tikzpicture}
