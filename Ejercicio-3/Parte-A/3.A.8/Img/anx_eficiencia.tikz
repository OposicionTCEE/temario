% Figura (Anexo II, «Contrastabilidad»): el índice de eficiencia de AFRIAT con las dos elecciones contradictorias de la figura
% del axioma débil: B^0 = {x_1 + x_2 <= 4}, elegida x^0 = (3,4; 0,6); B^1 = {0,4 x_1 + x_2 <= 2,4}, elegida x^1 = (1, 2).
% Reducir el presupuesto B^1 a la fracción e* = 1,96/2,4 = 0,817 de su gasto (recta punteada 0,4 x_1 + x_2 = 1,96, que pasa
% por x^0) basta para que x^0 deje de ser estrictamente más barata que x^1 con B^1, y la contradicción desaparece.
% Escala: 1 unidad = 0,85 cm.
% Generar con: bash Code/generar_figura.sh anx_eficiencia
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=0.85cm, y=0.85cm]
  \draw[->] (0,0) -- (6.6,0) node[below] {$x_1$};
  \draw[->] (0,0) -- (0,4.6) node[left] {$x_2$};
  \draw[very thick] (0,4) -- (4,0) node[below] {$B^0$};
  \draw[thick, dashed] (0,2.4) -- (6,0) node[below] {$B^1$};
  \draw[thick, densely dotted] (0,1.96) node[left] {$e^*B^1$} -- (4.9,0);
  \draw[->, thick] (1.6,1.75) -- (1.6,1.42);
  \fill (3.4,0.6) circle (2pt) node[above right] {$x^0$};
  \fill (1,2) circle (2pt) node[above] {$x^1$};
\end{tikzpicture}
