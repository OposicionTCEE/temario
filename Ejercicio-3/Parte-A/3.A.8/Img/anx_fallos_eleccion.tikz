% Figura (Anexo I, «Elección sin Buen Comportamiento»): qué le ocurre a la cesta elegida cuando falla un supuesto. 2 x 2.
% (a) Saciedad: punto de saciedad s = (1,3; 1,3) dentro del conjunto presupuestario (recta x_1 + x_2 = 4); se elige s y
%     sobra renta.
% (b) Tramo recto: curva con un tramo recto entre (1,3; 2,7) y (2,7; 1,3) sobre la recta de balance: todo el tramo es óptimo.
% (c) Vértice: curva en L con vértice K = (2, 2); tres rectas de balance que pasan por K, con pendientes -1/2, -1 y -2:
%     K se elige con los tres precios relativos.
% (d) Lexicográficas: recta x_1 + x_2 = 3; se elige x* = (3, 0), todo el gasto en el bien 1; la vertical discontinua es la
%     curva de indiferencia de u = x_1 por x*, que genera la misma elección.
% Escala: 1 unidad = 1 cm; cada panel, 4,4 x 4,4 cm.
% Generar con: bash Code/generar_figura.sh anx_fallos_eleccion
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1cm, y=1cm]
  % ---------------- (a) Saciedad ----------------
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (2.2,4.85) {(a) Saciedad};
    \fill[black!12] (0,0) -- (0,4) -- (4,0) -- cycle;
    \draw[->] (0,0) -- (4.4,0) node[below] {$x_1$};
    \draw[->] (0,0) -- (0,4.4) node[left] {$x_2$};
    \draw[very thick] (0,4) -- (4,0);
    \foreach \r in {0.45,0.9} { \draw[thick] (1.3,1.3) circle (\r); }
    \fill (1.3,1.3) circle (2pt);
    \node[right] at (1.33,1.3) {$s$};
  \end{scope}
  % ---------------- (b) Tramo recto ----------------
  \begin{scope}[xshift=5.8cm]
    \node[font=\footnotesize\bfseries] at (2.2,4.85) {(b) Tramo recto};
    \fill[black!12] (0,0) -- (0,4) -- (4,0) -- cycle;
    \draw[->] (0,0) -- (4.4,0) node[below] {$x_1$};
    \draw[->] (0,0) -- (0,4.4) node[left] {$x_2$};
    \draw[very thick] (0,4) -- (4,0);
    \draw[thick] (0.55,4.4) .. controls (0.8,3.3) and (1.05,2.95) .. (1.3,2.7);
    \draw[thick] (2.7,1.3) .. controls (2.95,1.05) and (3.3,0.8) .. (4.4,0.55);
    \draw[line width=2.4pt] (1.3,2.7) -- (2.7,1.3);
  \end{scope}
  % ---------------- (c) Vértice ----------------
  \begin{scope}[yshift=-5.8cm]
    \node[font=\footnotesize\bfseries] at (2.2,4.85) {(c) Vértice};
    \draw[->] (0,0) -- (4.4,0) node[below] {$x_1$};
    \draw[->] (0,0) -- (0,4.4) node[left] {$x_2$};
    \draw[thick, dashed] (0,3) -- (4.4,0.8);
    \draw[thick, dashed] (0,4) -- (4,0);
    \draw[thick, dashed] (0.8,4.4) -- (3,0);
    \draw[very thick] (2,4.4) -- (2,2) -- (4.4,2);
    \fill (2,2) circle (2pt);
    \node[below left] at (2,2) {$K$};
  \end{scope}
  % ---------------- (d) Lexicográficas ----------------
  \begin{scope}[xshift=5.8cm, yshift=-5.8cm]
    \node[font=\footnotesize\bfseries] at (2.2,4.85) {(d) Lexicográficas};
    \fill[black!12] (0,0) -- (0,3) -- (3,0) -- cycle;
    \draw[->] (0,0) -- (4.4,0) node[below] {$x_1$};
    \draw[->] (0,0) -- (0,4.4) node[left] {$x_2$};
    \draw[very thick] (0,3) -- (3,0);
    \draw[thick, dashed] (3,0) -- (3,4.2);
    \fill (3,0) circle (2pt);
    \node[above right] at (3,0) {$x^*$};
  \end{scope}
\end{tikzpicture}
