% Figura (Anexo I, «Representación»): construcción de la utilidad por la diagonal (MAS-COLELL, WHINSTON y GREEN, 1995).
% Curvas de indiferencia x_1 x_2 = alpha^2 con alpha = 1,4; 2,4; 3,4, que cortan la diagonal en alpha e, con e = (1, 1).
% La cesta x = (4,6; 1,252) está en la curva de alpha(x) = 2,4; la cesta y = (2,6; 4,446), en la de alpha(y) = 3,4.
% La utilidad de cada cesta es el alpha del punto en que su curva corta la diagonal.
% Escala: 1 unidad = 1 cm.
% Generar con: bash Code/generar_figura.sh anx_diagonal
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1cm, y=1cm]
  \draw[->] (0,0) -- (5.6,0) node[below] {$x_1$};
  \draw[->] (0,0) -- (0,5.6) node[left] {$x_2$};
  \draw[thick, dashed] (0,0) -- (5.2,5.2);
  \foreach \a in {1.4,2.4,3.4} {
    \draw[very thick] plot[domain={\a*\a/5.2}:5.2, samples=80] (\x,{\a*\a/\x});
  }
  % e
  \fill (1,1) circle (1.6pt);
  \node[right] at (1.05,0.92) {$e$};
  % x y su punto de la diagonal
  \fill (4.6,1.252) circle (2pt) node[above right] {$x$};
  \fill (2.4,2.4) circle (2pt) node[above left] {$\alpha(x)\,e$};
  \draw[densely dotted] (2.4,2.4) -- (2.4,0);
  \node[below] at (2.4,0) {$\alpha(x)$};
  % y y su punto de la diagonal
  \fill (2.6,4.446) circle (2pt) node[above right] {$y$};
  \fill (3.4,3.4) circle (2pt) node[left, xshift=-2pt] {$\alpha(y)\,e$};
  \draw[densely dotted] (3.4,3.4) -- (3.4,0);
  \node[below] at (3.4,0) {$\alpha(y)$};
\end{tikzpicture}
