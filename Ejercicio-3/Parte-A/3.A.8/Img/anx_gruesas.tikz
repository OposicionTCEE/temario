% Figura (Anexo I, «Monotonía»): curvas gruesas. Era el panel (d) de anx_monotonia.
% Franja de indiferencia entre x_1 x_2 = 3 y x_1 x_2 = 5 (gris).
% Escala: 1 unidad = 1 cm; 4,4 x 4,4 cm.
% Generar con: bash Code/generar_figura.sh anx_gruesas
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1cm, y=1cm]
  \fill[black!25] plot[domain=0.75:4, samples=60] (\x,{3/\x}) -- plot[domain=4:1.25, samples=60] (\x,{5/\x}) -- cycle;
  \draw[->] (0,0) -- (4.4,0) node[below] {$x_1$};
  \draw[->] (0,0) -- (0,4.4) node[left] {$x_2$};
  \draw[thick] plot[domain=0.75:4, samples=60] (\x,{3/\x});
  \draw[thick] plot[domain=1.25:4, samples=60] (\x,{5/\x});
\end{tikzpicture}
