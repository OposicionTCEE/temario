% Figura (bloque 1, «Buen Comportamiento»): las curvas de indiferencia con buen comportamiento y cuando falla cada supuesto.
% Cuatro paneles con los mismos ejes (x_1, x_2), en el mismo orden que la figura de la elección (b1_eleccion).
% (a) Buen comportamiento: curvas x_1 x_2 = c, con c = 0,7; 1,6 y 2,8; la flecha señala el sentido en que crece la utilidad.
% (b) Sin continuidad (lexicográficas, primero el bien 1): cesta x = (1,4; 1,5). Las cestas al menos tan buenas como x son el
%     semiplano x_1 > 1,4 (gris) y la semirrecta vertical por encima de x (gruesa); la semirrecta por debajo de x (discontinua)
%     no pertenece al conjunto: ninguna otra cesta es indiferente a x.
% (c) Sin no saciedad local: punto de saciedad s = (1,7; 1,5), con curvas cerradas a su alrededor (radios 0,45; 0,9 y 1,3).
% (d) Sin convexidad: utilidad x_1^2 + x_2^2. Arco de radio 2,5 por y = (0,647; 2,415) y z = (2,415; 0,647), indiferentes;
%     su punto medio m = (1,531; 1,531) está en una curva más baja (radio 2,165, punteada).
% Escala: 1 unidad = 1 cm; paneles separados 3,85 cm.
% Generar con: bash Code/generar_figura.sh b1_incumplimientos
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  % ---------------- (a) Buen comportamiento ----------------
  \node[font=\footnotesize\bfseries, align=center] at (1.7,3.65) {(a) Buen\\ comportamiento};
  \draw[->] (0,0) -- (3.4,0) node[below] {$x_1$};
  \draw[->] (0,0) -- (0,3.0) node[left] {$x_2$};
  \draw[thick] plot[domain=0.25:3.2, samples=60] (\x,{0.7/\x});
  \draw[thick] plot[domain=0.56:3.2, samples=60] (\x,{1.6/\x});
  \draw[thick] plot[domain=0.98:3.2, samples=60] (\x,{2.8/\x});
  \draw[->] (0.75,0.75) -- (1.85,1.85);
  % ---------------- (b) Sin continuidad ----------------
  \begin{scope}[xshift=3.85cm]
    \node[font=\footnotesize\bfseries, align=center] at (1.7,3.65) {(b) Sin\\ continuidad};
    \fill[gray!25] (1.4,0) rectangle (3.3,2.9);
    \draw[->] (0,0) -- (3.4,0) node[below] {$x_1$};
    \draw[->] (0,0) -- (0,3.0) node[left] {$x_2$};
    \draw[very thick] (1.4,1.5) -- (1.4,2.9);
    \draw[dashed] (1.4,0) -- (1.4,1.5);
    \fill (1.4,1.5) circle (1.6pt) node[left] {$x$};
  \end{scope}
  % ---------------- (c) Sin no saciedad local ----------------
  \begin{scope}[xshift=7.7cm]
    \node[font=\footnotesize\bfseries, align=center] at (1.7,3.65) {(c) Sin no\\ saciedad local};
    \draw[->] (0,0) -- (3.4,0) node[below] {$x_1$};
    \draw[->] (0,0) -- (0,3.0) node[left] {$x_2$};
    \draw[thick] (1.7,1.5) circle (0.45);
    \draw[thick] (1.7,1.5) circle (0.9);
    \draw[thick] (1.7,1.5) circle (1.3);
    \fill (1.7,1.5) circle (1.6pt) node[right] {$s$};
  \end{scope}
  % ---------------- (d) Sin convexidad ----------------
  \begin{scope}[xshift=11.55cm]
    \node[font=\footnotesize\bfseries, align=center] at (1.7,3.65) {(d) Sin\\ convexidad};
    \draw[->] (0,0) -- (3.4,0) node[below] {$x_1$};
    \draw[->] (0,0) -- (0,3.0) node[left] {$x_2$};
    \draw[very thick] plot[domain=8:82, samples=60] ({2.5*cos(\x)},{2.5*sin(\x)});
    \draw[thick, dotted] plot[domain=10:80, samples=60] ({2.165*cos(\x)},{2.165*sin(\x)});
    \draw[dashed] (0.647,2.415) -- (2.415,0.647);
    \fill (0.647,2.415) circle (1.6pt) node[above right] {$y$};
    \fill (2.415,0.647) circle (1.6pt) node[right] {$z$};
    \draw[thick, fill=white] (1.531,1.531) circle (1.6pt);
    \node[below left] at (1.5,1.5) {$m$};
  \end{scope}
\end{tikzpicture}
