% Figura (Anexo I, «Ordinalidad»): el mismo mapa de indiferencia con dos funciones de utilidad, u y v = f(u), f creciente.
% Curvas x_1 x_2 = 1,5; 3; 5. En la cesta A = (1,5; 2), sobre la curva x_1 x_2 = 3, la tangente tiene pendiente -4/3 en los dos
% paneles: la RMS no depende de la función elegida. Solo cambian los rótulos de las curvas.
% Escala: 1 unidad = 1 cm; cada panel, 4,6 x 4,6 cm.
% Generar con: bash Code/generar_figura.sh anx_ordinalidad
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1cm, y=1cm]
  \foreach \sx/\titulo/\ra/\rb/\rc in {0/{(a) Con $u(x)$}/{$U^0$}/{$U^1$}/{$U^2$},
                                       6.2/{(b) Con $v(x)=f\big(u(x)\big)$}/{$f(U^0)$}/{$f(U^1)$}/{$f(U^2)$}} {
    \begin{scope}[xshift=\sx cm]
      \node[font=\footnotesize\bfseries] at (2.3,5.05) {\titulo};
      \draw[->] (0,0) -- (4.8,0) node[below] {$x_1$};
      \draw[->] (0,0) -- (0,4.8) node[left] {$x_2$};
      \draw[very thick] plot[domain=0.36:4.4, samples=80] (\x,{1.5/\x});
      \draw[very thick] plot[domain=0.7:4.4, samples=80] (\x,{3/\x});
      \draw[very thick] plot[domain=1.16:4.4, samples=80] (\x,{5/\x});
      \node[right] at (4.4,0.34) {\ra};
      \node[right] at (4.4,0.68) {\rb};
      \node[right] at (4.4,1.14) {\rc};
      \draw[thick] (0.75,3.0) -- (2.4,0.8);
      \fill (1.5,2) circle (2pt) node[above right] {$A$};
    \end{scope}
  }
\end{tikzpicture}
