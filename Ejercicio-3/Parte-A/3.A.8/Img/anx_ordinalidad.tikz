% Figura (Anexo I, «Ordinalidad»): tres funciones de utilidad para las mismas preferencias, una por columna:
% u = x_1 x_2, v = ln x_1 + ln x_2 = ln u y w = (x_1 x_2)^2 = u^2.
% Arriba, el mismo mapa (curvas x_1 x_2 = 1, 3 y 9), rotulado con los números de cada función: u = 1, 3, 9; v = 0; 1,10; 2,20;
% w = 1, 9, 81. La tangente en A = (1, 3), de pendiente -3, es la misma en las tres: la RMS no depende de la función.
% Abajo, la utilidad a lo largo de la recta x_2 = 3 (discontinua arriba), en función de x_1: u = 3 x_1 (recta: utilidad
% marginal constante), v = ln(3 x_1) (cóncava: decreciente) y w = 9 x_1^2 (convexa: creciente). Los puntos marcan los cortes
% de la recta con las tres curvas, en x_1 = 1/3, 1 y 3, unidos con las columnas de arriba por líneas de puntos.
% Escalas verticales de la fila inferior: u, 1/3 cm por unidad; v, 1,6 cm por unidad; w, 0,0258 cm por unidad.
% Escala horizontal: 1 unidad = 1 cm; cada panel, 4,4 x 4,4 cm.
% Generar con: bash Code/generar_figura.sh anx_ordinalidad
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1cm, y=1cm]
  \foreach \sx/\titulo/\ra/\rb/\rc/\fun/\eje/\ya/\yb/\yc in {
      0/{(a) $u=x_1x_2$}/{$1$}/{$3$}/{$9$}/u/{$u(x_1,3)$}/0.333/1/3,
      5.6/{(b) $v=\ln x_1+\ln x_2$}/{$0$}/{$1{,}10$}/{$2{,}20$}/v/{$v(x_1,3)$}/0/1.758/3.515,
      11.2/{(c) $w=(x_1x_2)^2$}/{$1$}/{$9$}/{$81$}/w/{$w(x_1,3)$}/0.026/0.232/2.09} {
    % ---------------- Arriba: el mapa de indiferencia ----------------
    \begin{scope}[xshift=\sx cm, yshift=5.9cm]
      \node[font=\footnotesize\bfseries] at (2.2,4.85) {\titulo};
      \draw[->] (0,0) -- (4.4,0) node[below] {$x_1$};
      \draw[->] (0,0) -- (0,4.4) node[left] {$x_2$};
      \draw[very thick] plot[domain=0.24:4.2, samples=80] (\x,{1/\x});
      \draw[very thick] plot[domain=0.69:4.2, samples=80] (\x,{3/\x});
      \draw[very thick] plot[domain=2.15:4.2, samples=80] (\x,{9/\x});
      \node[right] at (4.2,0.238) {\ra};
      \node[right] at (4.2,0.714) {\rb};
      \node[right] at (4.2,2.143) {\rc};
      \draw[dashed] (0,3) -- (4.2,3);
      \draw[thick] (0.55,4.35) -- (1.6,1.2);
      \foreach \px in {0.333,1,3} { \fill (\px,3) circle (1.8pt); }
      \node[above right] at (1,3) {$A$};
    \end{scope}
    % ---------------- Abajo: la utilidad a lo largo de x_2 = 3 ----------------
    \begin{scope}[xshift=\sx cm]
      \draw[->] (0,0) -- (4.4,0) node[below] {$x_1$};
      \draw[->] (0,0) -- (0,4.4) node[left] {\eje};
      \ifthenelse{\equal{\fun}{u}}{\draw[very thick] (0,0) -- (4.2,4.2);}{}
      \ifthenelse{\equal{\fun}{v}}{\draw[very thick] plot[domain=0.333:4.2, samples=80] (\x,{1.6*ln(3*\x)});}{}
      \ifthenelse{\equal{\fun}{w}}{\draw[very thick] plot[domain=0:4.2, samples=80] (\x,{0.2323*\x*\x});}{}
      \draw[black!45, densely dotted] (0.333,\ya) -- (0.333,8.9);
      \draw[black!45, densely dotted] (1,\yb) -- (1,8.9);
      \draw[black!45, densely dotted] (3,\yc) -- (3,8.9);
      \fill (0.333,\ya) circle (1.8pt) node[above left] {\ra};
      \fill (1,\yb) circle (1.8pt) node[above left] {\rb};
      \fill (3,\yc) circle (1.8pt) node[above left] {\rc};
    \end{scope}
  }
\end{tikzpicture}
