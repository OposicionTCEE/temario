% Figura (bloque 3, «Pujas y Ofertas»): la función hedónica como envolvente de pujas y ofertas, y lo que revela.
% Una característica, z. Función hedónica p(z) = 0,3 + 0,12 z^2 (gruesa). Dos compradores eligen z^1 = 1,8 y z^2 = 3,6
% (los datos de anx_rosen). Pujas (cóncavas, por debajo de p y tangentes en z^j):
% theta_j(z) = p(z^j) + p'(z^j)(z - z^j) - 0,25 (z - z^j)^2, continuas cerca del punto elegido (z^j +- 0,4) y punteadas lejos:
% el mercado revela su pendiente en z^j, la valoración marginal, pero no el resto de la curva, que es la demanda.
% Ofertas (convexas, por encima y tangentes en z^j): phi_j(z) = p(z^j) + p'(z^j)(z - z^j) + 0,45 (z - z^j)^2 (finas).
% p(1,8) = 0,689, p'(1,8) = 0,432; p(3,6) = 1,855, p'(3,6) = 0,864.
% Escala: horizontal, 1 unidad = 1,05 cm; vertical (precio), 1 unidad = 1,2 cm.
% Generar con: bash Code/generar_figura.sh b3_rosen
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1.05cm, y=1.2cm]
  \draw[->] (0,0) -- (5.6,0) node[below] {$z$};
  \draw[->] (0,0) -- (0,3.6) node[left] {$p$};
  \draw[very thick] plot[domain=0.3:5.0, samples=80] (\x,{0.3+0.12*\x*\x}) node[right] {$p(z)$};
  % pujas: tramo revelado (continuo) y resto (punteado)
  \draw[thick, dotted] plot[domain=0.9:1.4, samples=30] (\x,{0.689+0.432*(\x-1.8)-0.25*(\x-1.8)^2});
  \draw[thick] plot[domain=1.4:2.2, samples=30] (\x,{0.689+0.432*(\x-1.8)-0.25*(\x-1.8)^2});
  \draw[thick, dotted] plot[domain=2.2:3.0, samples=30] (\x,{0.689+0.432*(\x-1.8)-0.25*(\x-1.8)^2}) node[right] {$\theta_1$};
  \draw[thick, dotted] plot[domain=2.8:3.2, samples=30] (\x,{1.855+0.864*(\x-3.6)-0.25*(\x-3.6)^2});
  \draw[thick] plot[domain=3.2:4.0, samples=30] (\x,{1.855+0.864*(\x-3.6)-0.25*(\x-3.6)^2});
  \draw[thick, dotted] plot[domain=4.0:4.9, samples=30] (\x,{1.855+0.864*(\x-3.6)-0.25*(\x-3.6)^2}) node[right] {$\theta_2$};
  % ofertas
  \draw[thin] plot[domain=1.0:2.6, samples=40] (\x,{0.689+0.432*(\x-1.8)+0.45*(\x-1.8)^2}) node[above] {$\phi_1$};
  \draw[thin] plot[domain=3.0:4.3, samples=40] (\x,{1.855+0.864*(\x-3.6)+0.45*(\x-3.6)^2}) node[above left] {$\phi_2$};
  \fill (1.8,0.689) circle (1.8pt);
  \fill (3.6,1.855) circle (1.8pt);
  \draw[densely dotted] (1.8,0.689) -- (1.8,0) node[below] {$z^1$};
  \draw[densely dotted] (3.6,1.855) -- (3.6,0) node[below] {$z^2$};
\end{tikzpicture}
