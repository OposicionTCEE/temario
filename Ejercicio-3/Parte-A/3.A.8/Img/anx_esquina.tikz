% Figura (Anexo I, «Solución de esquina»): solución de esquina. Era el panel (b) de anx_optimo.
% Utilidad u = x_1 + 0,5 ln(1 + x_2), cuya RMS_12 = 2(1 + x_2) supera siempre el precio relativo p_1/p_2 = 0,75 de la recta
% (0; 3)-(4; 0); curvas x_2 = exp(2(U - x_1)) - 1 con U = 3,4; 4; 4,6; la elegida es la esquina x* = (4, 0).
% Escala: 1 unidad = 1 cm.
% Generar con: bash Code/generar_figura.sh anx_esquina
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1cm, y=1cm]
  \fill[black!12] (0,0) -- (0,3) -- (4,0) -- cycle;
  \draw[->] (0,0) -- (4.8,0) node[below] {$x_1$};
  \draw[->] (0,0) -- (0,4.8) node[left] {$x_2$};
  \draw[very thick] (0,3) -- (4,0);
  \foreach \U in {3.4,4,4.6} {
    \draw[thick] plot[domain={\U-0.5*ln(1+4.4)}:\U, samples=80] (\x,{exp(2*(\U-\x))-1});
  }
  \fill (4,0) circle (2pt);
  \node[above right] at (4,0) {$x^*$};
\end{tikzpicture}
