% Figura (Anexo I, «Formas Funcionales», «Sustitutivos Perfectos»): elección, demandas individuales y demanda de mercado.
% Tres paneles; p_2 = 1. Era, en parte, el panel (a) de anx_formas.
% (a) Elección con u = x_1 + x_2: rectas x_1 + x_2 = 1,5; 3; 4,2. Recta de balance (discontinua) de (0, 3) a (2, 0), con
%     p_1/p_2 = 1,5 > RMS = 1: se elige la esquina x* = (0, 3).
% (b) Demandas del bien 1 de A (umbral p^A = 1,5, renta 1,5) y de B (umbral p^B = 3, renta 2): nula por encima del umbral,
%     todo el gasto en el bien 1 por debajo (x_1 = W/p_1), y un tramo horizontal en el umbral (cualquier cantidad entre 0 y
%     W/p). A continua, B discontinua.
% (c) Mercado: 0 por encima de 3; tramo horizontal en 3 hasta 0,667; 2/p_1 entre 3 y 1,5; tramo horizontal en 1,5 de 1,333
%     a 2,333; 3,5/p_1 por debajo de 1,5.
% Escala: (a), 1 unidad = 1 cm; (b) y (c), horizontal 1 unidad = 0,7 cm y vertical 1 unidad = 1 cm.
% Generar con: bash Code/generar_figura.sh anx_sustitutivos
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1cm, y=1cm]
  % ---------------- (a) Elección ----------------
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (2.2,4.85) {(a) Elección};
    \draw[->] (0,0) -- (4.4,0) node[below] {$x_1$};
    \draw[->] (0,0) -- (0,4.4) node[left] {$x_2$};
    \foreach \c in {1.5,3,4.2} { \draw[thick] (0,\c) -- (\c,0); }
    \draw[very thick, dashed] (0,3) -- (2,0);
    \fill (0,3) circle (2pt);
    \node[left] at (0,3) {$x^*$};
  \end{scope}
  % ---------------- (b) Demandas individuales ----------------
  \begin{scope}[xshift=5.3cm, x=0.7cm]
    \node[font=\footnotesize\bfseries] at (3.1,4.85) {(b) Demandas individuales};
    \draw[->] (0,0) -- (6.3,0) node[below] {$x_1$};
    \draw[->] (0,0) -- (0,4.4) node[left] {$p_1$};
    \draw[very thick] (0,1.5) -- (1,1.5);
    \draw[very thick] plot[domain=0.25:1.5, samples=60] ({1.5/\x},{\x});
    \draw[very thick, dashed] (0,3) -- (0.667,3);
    \draw[very thick, dashed] plot[domain=0.333:3, samples=60] ({2/\x},{\x});
    \node[left] at (0,1.5) {$\hat p^A$};
    \node[left] at (0,3) {$\hat p^B$};
    \node[above] at (6,0.25) {$A$};
    \node[above] at (5.6,0.6) {$B$};
  \end{scope}
  % ---------------- (c) Demanda de mercado ----------------
  \begin{scope}[xshift=10.6cm, x=0.7cm]
    \node[font=\footnotesize\bfseries] at (3.1,4.85) {(c) Demanda de mercado};
    \draw[->] (0,0) -- (6.3,0) node[below] {$X_1$};
    \draw[->] (0,0) -- (0,4.4) node[left] {$p_1$};
    \draw[very thick] (0,3) -- (0.667,3);
    \draw[very thick] plot[domain=1.5:3, samples=60] ({2/\x},{\x});
    \draw[very thick] (1.333,1.5) -- (2.333,1.5);
    \draw[very thick] plot[domain=0.583:1.5, samples=60] ({3.5/\x},{\x});
  \end{scope}
\end{tikzpicture}
