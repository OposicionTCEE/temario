% Figura (Anexo I, «Formas Funcionales», «COBB-DOUGLAS»): elección, demandas individuales y demanda de mercado.
% Tres paneles; p_2 = 1. Era, en parte, el panel (c) de anx_formas.
% (a) Elección con u = x_1^(1/2) x_2^(1/2): curvas x_1 x_2 = 2; 4; 7; recta x_1 + x_2 = 4; tangencia en x* = (2, 2).
% (b) Demandas del bien 1 con a = 1/2 de A (renta 2) y de B (renta 4): x_1 = a W/p_1, hipérbolas equiláteras (elasticidad
%     precio -1). A continua, B discontinua.
% (c) Mercado: X_1 = 3/p_1, la de un consumidor con la renta total.
% Escala: (a), 1 unidad = 1 cm; (b) y (c), horizontal 1 unidad = 0,7 cm y vertical 1 unidad = 1 cm.
% Generar con: bash Code/generar_figura.sh anx_cobb_douglas
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1cm, y=1cm]
  % ---------------- (a) Elección ----------------
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (2.2,4.85) {(a) Elección};
    \draw[->] (0,0) -- (4.4,0) node[below] {$x_1$};
    \draw[->] (0,0) -- (0,4.4) node[left] {$x_2$};
    \draw[thick] plot[domain=0.47:4.3, samples=80] (\x,{2/\x});
    \draw[thick] plot[domain=0.93:4.3, samples=80] (\x,{4/\x});
    \draw[thick] plot[domain=1.63:4.3, samples=80] (\x,{7/\x});
    \draw[very thick, dashed] (0,4) -- (4,0);
    \fill (2,2) circle (2pt);
    \node[below left] at (2,2) {$x^*$};
  \end{scope}
  % ---------------- (b) Demandas individuales ----------------
  \begin{scope}[xshift=5.3cm, x=0.7cm]
    \node[font=\footnotesize\bfseries] at (3.1,4.85) {(b) Demandas individuales};
    \draw[->] (0,0) -- (6.3,0) node[below] {$x_1$};
    \draw[->] (0,0) -- (0,4.4) node[left] {$p_1$};
    \draw[very thick] plot[domain=0.17:4.2, samples=80] ({1/\x},{\x});
    \draw[very thick, dashed] plot[domain=0.34:4.2, samples=80] ({2/\x},{\x});
    \node[below left] at (1,1) {$A$};
    \node[above right] at (2,1) {$B$};
  \end{scope}
  % ---------------- (c) Demanda de mercado ----------------
  \begin{scope}[xshift=10.6cm, x=0.7cm]
    \node[font=\footnotesize\bfseries] at (3.1,4.85) {(c) Demanda de mercado};
    \draw[->] (0,0) -- (6.3,0) node[below] {$X_1$};
    \draw[->] (0,0) -- (0,4.4) node[left] {$p_1$};
    \draw[very thick] plot[domain=0.5:4.2, samples=80] ({3/\x},{\x});
  \end{scope}
\end{tikzpicture}
