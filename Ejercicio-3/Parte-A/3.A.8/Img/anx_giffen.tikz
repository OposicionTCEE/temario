% Figura (Anexo I, «Precio Propio»): un bien de GIFFEN. Dos paneles. p_2 = 1, W = 4.
% (a) Rectas de balance de (0, 4) a (2,2; 0), (3; 0) y (4,2; 0) (p_1 = 1,82; 1,33; 0,95) y cestas elegidas
%     A = (1,6; 1,091), B = (1,3; 2,267) y C = (2; 2,095), con arcos de curva de indiferencia tangentes (parábolas
%     x_2 = P_2 + m (x_1 - P_1) + 0,5 (x_1 - P_1)^2, con m la pendiente de la recta). Entre A y B, el precio del bien 1 baja
%     y se compra menos de él. Las tres elecciones cumplen el axioma débil de la preferencia revelada.
% (b) Curva de demanda por (x_1, p_1) = (1,6; 1,82), (1,3; 1,33), (2; 0,95), con p_1 en el eje vertical
%     (1 unidad = 1,5 cm): el tramo entre A y B tiene pendiente positiva.
% Escala: 1 unidad = 1 cm.
% Generar con: bash Code/generar_figura.sh anx_giffen
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1cm, y=1cm]
  % ---------------- (a) Elección ----------------
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (2.3,4.75) {(a) Senda precio-consumo};
    \draw[->] (0,0) -- (4.6,0) node[below] {$x_1$};
    \draw[->] (0,0) -- (0,4.5) node[left] {$x_2$};
    \draw[thick, dashed] (0,4) -- (2.2,0);
    \draw[thick, dashed] (0,4) -- (3,0);
    \draw[thick, dashed] (0,4) -- (4.2,0);
    \draw[thin] plot[domain=1.15:2.05, samples=40] (\x,{1.091-1.818*(\x-1.6)+0.5*(\x-1.6)^2});
    \draw[thin] plot[domain=0.85:1.75, samples=40] (\x,{2.267-1.333*(\x-1.3)+0.5*(\x-1.3)^2});
    \draw[thin] plot[domain=1.55:2.45, samples=40] (\x,{2.095-0.952*(\x-2)+0.5*(\x-2)^2});
    \draw[very thick] plot[smooth] coordinates {(1.6,1.091) (1.3,2.267) (2,2.095)};
    \fill (1.6,1.091) circle (2pt) node[right] {$A$};
    \fill (1.3,2.267) circle (2pt) node[above left] {$B$};
    \fill (2,2.095) circle (2pt) node[above right] {$C$};
  \end{scope}
  % ---------------- (b) Demanda ----------------
  \begin{scope}[xshift=6.2cm]
    \node[font=\footnotesize\bfseries] at (2.3,4.75) {(b) Curva de demanda del bien 1};
    \draw[->] (0,0) -- (4.6,0) node[below] {$x_1$};
    \draw[->] (0,0) -- (0,4.5) node[left] {$p_1$};
    \draw[very thick] plot[smooth] coordinates {(1.35,3.4) (1.6,2.73) (1.3,2.0) (2.0,1.43) (2.6,1.05)};
    \fill (1.6,2.73) circle (2pt) node[right] {$A$};
    \fill (1.3,2.0) circle (2pt) node[left] {$B$};
    \fill (2.0,1.43) circle (2pt) node[above right] {$C$};
  \end{scope}
\end{tikzpicture}
