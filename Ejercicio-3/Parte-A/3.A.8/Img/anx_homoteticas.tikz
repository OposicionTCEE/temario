% Figura (Anexo I, «Formas Funcionales», «Homotéticas»): senda de expansión de unas preferencias homotéticas, con precios
% iguales a 1. La de STONE-GEARY está en anx_stone_geary (antes, panel (b) de esta figura).
% COBB-DOUGLAS con a = 1/3; rectas x_1 + x_2 = 1,5; 2,5; 3,5; elecciones (0,5; 1), (0,833; 1,667) y (1,167; 2,333), sobre el
% radio x_2 = 2 x_1; curvas x_2 = k / raíz(x_1) con k = 0,707; 1,522; 2,520.
% Escala: 1 unidad = 1 cm; 4,4 x 4,4 cm.
% Generar con: bash Code/generar_figura.sh anx_homoteticas
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1cm, y=1cm]
  \draw[->] (0,0) -- (4.4,0) node[below] {$x_1$};
  \draw[->] (0,0) -- (0,4.4) node[left] {$x_2$};
  \foreach \w in {1.5,2.5,3.5} { \draw[thick, dashed] (0,\w) -- (\w,0); }
  \draw[thick] plot[domain=0.03:4.3, samples=100] (\x,{0.707/sqrt(\x)});
  \draw[thick] plot[domain=0.13:4.3, samples=100] (\x,{1.522/sqrt(\x)});
  \draw[thick] plot[domain=0.34:4.3, samples=100] (\x,{2.520/sqrt(\x)});
  \draw[very thick] (0,0) -- (2.1,4.2);
  \foreach \p in {(0.5,1),(0.833,1.667),(1.167,2.333)} { \fill \p circle (2pt); }
\end{tikzpicture}
