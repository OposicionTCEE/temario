% Figura (Anexo I, «Formas Funcionales»): sendas de expansión de la renta, con precios iguales a 1. Dos paneles.
% (a) Homotéticas: COBB-DOUGLAS con a = 1/3; rectas x_1 + x_2 = 1,5; 2,5; 3,5; elecciones (0,5; 1), (0,833; 1,667) y
%     (1,167; 2,333), sobre el radio x_2 = 2 x_1; curvas x_2 = k / raíz(x_1) con k = 0,707; 1,522; 2,520.
% (b) STONE-GEARY: u = (1/3) ln(x_1 - 0,8) + (2/3) ln(x_2 - 0,6); mínimos gamma = (0,8; 0,6); rectas x_1 + x_2 = 2,4; 3,4;
%     4,4; elecciones (1,133; 1,267), (1,467; 1,933) y (1,8; 2,6), sobre la recta que parte de gamma con pendiente 2;
%     curvas x_2 = 0,6 + k / raíz(x_1 - 0,8) con k = 0,385; 1,089; 2,0.
% Escala: 1 unidad = 1 cm; cada panel, 4,4 x 4,4 cm.
% Generar con: bash Code/generar_figura.sh anx_homoteticas
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1cm, y=1cm]
  % ---------------- (a) Homotéticas ----------------
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (2.2,4.85) {(a) Homotéticas};
    \draw[->] (0,0) -- (4.4,0) node[below] {$x_1$};
    \draw[->] (0,0) -- (0,4.4) node[left] {$x_2$};
    \foreach \w in {1.5,2.5,3.5} { \draw[thick, dashed] (0,\w) -- (\w,0); }
    \draw[thick] plot[domain=0.03:4.3, samples=100] (\x,{0.707/sqrt(\x)});
    \draw[thick] plot[domain=0.13:4.3, samples=100] (\x,{1.522/sqrt(\x)});
    \draw[thick] plot[domain=0.34:4.3, samples=100] (\x,{2.520/sqrt(\x)});
    \draw[very thick] (0,0) -- (2.1,4.2);
    \foreach \p in {(0.5,1),(0.833,1.667),(1.167,2.333)} { \fill \p circle (2pt); }
  \end{scope}
  % ---------------- (b) STONE-GEARY ----------------
  \begin{scope}[xshift=5.8cm]
    \node[font=\footnotesize\bfseries] at (2.2,4.85) {(b) STONE-GEARY};
    \draw[->] (0,0) -- (4.4,0) node[below] {$x_1$};
    \draw[->] (0,0) -- (0,4.4) node[left] {$x_2$};
    \draw[densely dotted] (0.8,0) -- (0.8,4.3);
    \draw[densely dotted] (0,0.6) -- (4.3,0.6);
    \foreach \w in {2.4,3.4,4.4} { \draw[thick, dashed] (0,\w) -- (\w,0); }
    \draw[thick] plot[domain=0.81:4.3, samples=100] (\x,{0.6+0.385/sqrt(\x-0.8)});
    \draw[thick] plot[domain=0.87:4.3, samples=100] (\x,{0.6+1.089/sqrt(\x-0.8)});
    \draw[thick] plot[domain=1.05:4.3, samples=100] (\x,{0.6+2.0/sqrt(\x-0.8)});
    \draw[very thick] (0.8,0.6) -- (2.6,4.2);
    \fill (0.8,0.6) circle (2pt);
    \node[below left] at (0.8,0.6) {$\gamma$};
    \foreach \p in {(1.133,1.267),(1.467,1.933),(1.8,2.6)} { \fill \p circle (2pt); }
  \end{scope}
\end{tikzpicture}
