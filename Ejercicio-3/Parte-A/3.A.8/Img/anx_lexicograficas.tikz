% Figura (Anexo I, «Continuidad»): preferencias lexicográficas (primero x_1, después x_2).
% Contorno superior de x = (2,5; 2,5): el semiplano x_1 > 2,5 (gris), más el tramo de la vertical por encima de x (trazo grueso);
% el tramo por debajo de x (discontinuo) no pertenece a él. La sucesión y^k = (2,5 + 1,6/k; 1,2), k = 1,...,5, está toda en el
% contorno superior y converge a w = (2,5; 1,2), que es peor que x: el contorno superior no es cerrado.
% Escala: 1 unidad = 1 cm.
% Generar con: bash Code/generar_figura.sh anx_lexicograficas
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1cm, y=1cm]
  \fill[black!12] (2.5,0) rectangle (5.3,5.3);
  \draw[->] (0,0) -- (5.6,0) node[below] {$x_1$};
  \draw[->] (0,0) -- (0,5.6) node[left] {$x_2$};
  \draw[very thick] (2.5,2.5) -- (2.5,5.3);
  \draw[thick, dashed] (2.5,0) -- (2.5,2.5);
  \fill (2.5,2.5) circle (2pt);
  \node[left] at (2.45,2.5) {$x$};
  \node at (4.1,4.3) {$\succsim(x)$};
  \foreach \k in {1,...,5} { \fill ({2.5+1.6/\k},1.2) circle (1.3pt); }
  \node[above] at (4.1,1.25) {$y^k$};
  \draw[thick, fill=white] (2.5,1.2) circle (2pt);
  \node[left] at (2.42,1.2) {$w$};
  \draw[->] (3.7,0.75) -- (2.75,0.75);
\end{tikzpicture}
