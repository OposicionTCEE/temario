% Figura (Anexo II, «Críticas»): qué supone la preferencia revelada y qué le objeta SEN (1973, 1977). Dos paneles, esquemas.
% (a) La teoría: una sola ordenación, la del bienestar, explica la elección; las elecciones observadas revelan esa ordenación
%     (flecha discontinua de vuelta).
% (b) SEN: el bienestar, el compromiso y las creencias equivocadas producen las mismas elecciones; la flecha de vuelta ya no
%     identifica el bienestar (interrogación).
% Generar con: bash Code/generar_figura.sh anx_criticas_sen
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]},
    caja/.style={draw, thick, rounded corners=2pt, minimum width=2.3cm, minimum height=0.75cm, align=center}]
  % ---------------- (a) La teoría ----------------
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (1.6,3.3) {(a) Lo que supone la teoría};
    \node[caja] (b) at (1.6,2.3) {Bienestar};
    \node[caja] (e) at (1.6,1.0) {Elección};
    \node[caja] (d) at (1.6,-0.3) {Datos $(p^t,x^t)$};
    \draw[->, thick] (b) -- (e);
    \draw[->, thick] (e) -- (d);
    \draw[->, thick, dashed] (d.east) -- ++(0.7,0) |- node[pos=0.25, right] {revela} (b.east);
  \end{scope}
  % ---------------- (b) SEN ----------------
  \begin{scope}[xshift=6.4cm]
    \node[font=\footnotesize\bfseries] at (2.6,3.3) {(b) Lo que objeta SEN};
    \node[caja, minimum width=1.9cm] (b2) at (0,2.3) {Bienestar};
    \node[caja, minimum width=1.9cm] (c2) at (2.6,2.3) {Compromiso};
    \node[caja, minimum width=1.9cm] (k2) at (5.2,2.3) {Creencias\\[-2pt] equivocadas};
    \node[caja] (e2) at (2.6,1.0) {Elección};
    \node[caja] (d2) at (2.6,-0.3) {Datos $(p^t,x^t)$};
    \draw[->, thick] (b2) -- (e2);
    \draw[->, thick] (c2) -- (e2);
    \draw[->, thick] (k2) -- (e2);
    \draw[->, thick] (e2) -- (d2);
    \draw[->, thick, dashed] (d2.west) -- ++(-1.9,0) -- node[pos=0.5, left] {¿revela?} (b2.south);
  \end{scope}
\end{tikzpicture}
