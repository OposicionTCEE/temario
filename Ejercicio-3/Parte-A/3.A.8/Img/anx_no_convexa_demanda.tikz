% Figura (Anexo I, «Elección sin Buen Comportamiento»): preferencias no convexas, u = x_1^2 + x_2^2. Dos paneles.
% (a) Elección: recta x_1 + 1,2 x_2 = 3,6 (p_1 = 1, p_2 = 1,2, W = 3,6). La curva de radio 2,305 es tangente en
%     m = (1,476; 1,771), el peor punto de la recta; la de radio 3 pasa por la esquina (0, 3); la de radio 3,6, por la
%     esquina elegida x* = (3,6; 0).
% (b) Demanda del bien 1 con p_2 = 1,2 y W = 3,6: x_1 = W/p_1 si p_1 < p_2 (hipérbola), x_1 = 0 si p_1 > p_2 (tramo sobre
%     el eje), y salto entre 0 y W/p_2 = 3 en p_1 = p_2. Eje vertical: p_1 (1 unidad = 1,5 cm).
% Escala: 1 unidad = 1 cm en el panel (a) y en el eje horizontal del (b).
% Generar con: bash Code/generar_figura.sh anx_no_convexa_demanda
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1cm, y=1cm]
  % ---------------- (a) Elección ----------------
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (2.4,5.0) {(a) Elección};
    \fill[black!12] (0,0) -- (0,3) -- (3.6,0) -- cycle;
    \draw[->] (0,0) -- (4.6,0) node[below] {$x_1$};
    \draw[->] (0,0) -- (0,4.6) node[left] {$x_2$};
    \draw[very thick] (0,3) -- (3.6,0);
    \draw[thick] (2.305,0) arc (0:90:2.305);
    \draw[thick] (3,0) arc (0:90:3);
    \draw[thick] (3.6,0) arc (0:90:3.6);
    \fill (1.476,1.771) circle (2pt);
    \node[below left] at (1.476,1.771) {$m$};
    \fill (3.6,0) circle (2pt);
    \node[above right] at (3.6,0) {$x^*$};
  \end{scope}
  % ---------------- (b) Demanda del bien 1 ----------------
  \begin{scope}[xshift=6.6cm]
    \node[font=\footnotesize\bfseries] at (2.4,5.0) {(b) Demanda del bien 1};
    \draw[->] (0,0) -- (4.8,0) node[below] {$x_1$};
    \draw[->] (0,0) -- (0,4.6) node[left] {$p_1$};
    \draw[very thick] plot[domain=0.82:1.2, samples=60] ({3.6/\x},{1.5*\x});
    \draw[very thick] (0,1.8) -- (0,4.2);
    \draw[densely dotted] (0,1.8) -- (3,1.8);
    \fill (3,1.8) circle (2pt);
    \fill (0,1.8) circle (2pt);
    \node[left] at (0,1.8) {$p_2$};
    \node[below] at (3,0) {$W/p_2$};
    \draw[densely dotted] (3,0) -- (3,1.8);
  \end{scope}
\end{tikzpicture}
