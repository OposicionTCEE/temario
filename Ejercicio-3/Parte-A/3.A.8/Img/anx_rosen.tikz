% Figura (Anexo III, «Función Hedónica»): la función hedónica como envolvente de pujas y ofertas (ROSEN, 1974).
% Una característica, z. Función hedónica p(z) = 0,3 + 0,12 z^2 (gruesa). Dos compradores eligen z^1 = 1,8 y z^2 = 3,6.
% Pujas (cóncavas, por debajo de p y tangentes en z^j): theta_j(z) = p(z^j) + p'(z^j)(z - z^j) - 0,25 (z - z^j)^2.
% Ofertas (convexas, por encima y tangentes en z^j): phi_j(z) = p(z^j) + p'(z^j)(z - z^j) + 0,45 (z - z^j)^2.
% p(1,8) = 0,689, p'(1,8) = 0,432; p(3,6) = 1,855, p'(3,6) = 0,864. Eje vertical: precio (1 unidad = 1,2 cm).
% Escala horizontal: 1 unidad = 1 cm.
% Generar con: bash Code/generar_figura.sh anx_rosen
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1cm, y=1.2cm]
  \draw[->] (0,0) -- (6,0) node[below] {$z$};
  \draw[->] (0,0) -- (0,4.1) node[left] {$p$};
  \draw[very thick] plot[domain=0.3:5.3, samples=80] (\x,{0.3+0.12*\x*\x}) node[right] {$p(z)$};
  \draw[thick] plot[domain=1.0:2.9, samples=60] (\x,{0.689+0.432*(\x-1.8)-0.25*(\x-1.8)^2}) node[below right] {$\theta_1$};
  \draw[thick] plot[domain=2.5:4.7, samples=60] (\x,{1.855+0.864*(\x-3.6)-0.25*(\x-3.6)^2}) node[below right] {$\theta_2$};
  \draw[thick, dashed] plot[domain=0.9:2.7, samples=60] (\x,{0.689+0.432*(\x-1.8)+0.45*(\x-1.8)^2}) node[above] {$\phi_1$};
  \draw[thick, dashed] plot[domain=2.8:4.4, samples=60] (\x,{1.855+0.864*(\x-3.6)+0.45*(\x-3.6)^2}) node[above] {$\phi_2$};
  \fill (1.8,0.689) circle (2pt);
  \fill (3.6,1.855) circle (2pt);
  \draw[densely dotted] (1.8,0.689) -- (1.8,0) node[below] {$z^1$};
  \draw[densely dotted] (3.6,1.855) -- (3.6,0) node[below] {$z^2$};
\end{tikzpicture}
