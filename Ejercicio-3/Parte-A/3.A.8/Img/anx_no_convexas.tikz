% Figura (Anexo I, «Preferencias no convexas»): tres orígenes de la no convexidad. Tres paneles; en cada uno, una curva de
% indiferencia y su contorno superior (gris).
% (a) Bienes que se disfrutan por separado: arco de radio 3 centrado en el origen, cóncavo en todo su recorrido; y y z en los
%     ángulos de 72 y 18 grados, y su punto medio m = (1,89; 1,89), por debajo de la curva (peor que los extremos).
% (b) Bien adictivo (el 1): x_2 = 3,6 - 2,4 x_1 + 0,9 x_1^2 - 0,12 x_1^3, de pendiente negativa en todo el tramo
%     (máximo -0,15 en x_1 = 2,5), convexa a la izquierda de 2,5 y cóncava a la derecha (la RMS crece con x_1).
%     y = (2,8; 1,302), z = (4; 0,72) y m = (3,4; 1,011), por debajo de la curva (x_2 = 1,128 en 3,4).
% (c) Bien indivisible (el 1): cestas indiferentes a x = (2; 1,8) solo en cantidades enteras, (1; 3,2), (2; 1,8), (3; 1,2) y
%     (4; 0,9); el contorno superior son semirrectas verticales separadas. La mezcla de (1; 3,2) y (2; 1,8), m = (1,5; 2,5)
%     (círculo blanco), no puede consumirse.
% Escala: 1 unidad = 1 cm; cada panel, 4,2 x 4,2 cm.
% Generar con: bash Code/generar_figura.sh anx_no_convexas
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1cm, y=1cm]
  % ---------------- (a) Por separado ----------------
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (2.1,4.7) {(a) Por separado};
    \fill[black!12] (0.52,2.954) arc (80:10:3) -- (4.2,0.521) -- (4.2,4.2) -- (0.52,4.2) -- cycle;
    \draw[->] (0,0) -- (4.4,0) node[below] {$x_1$};
    \draw[->] (0,0) -- (0,4.4) node[left] {$x_2$};
    \draw[very thick] (0.52,2.954) arc (80:10:3);
    \draw[thick, dashed] (0.927,2.853) -- (2.853,0.927);
    \fill (0.927,2.853) circle (2pt) node[above right] {$y$};
    \fill (2.853,0.927) circle (2pt) node[above right] {$z$};
    \fill (1.89,1.89) circle (2pt) node[below left] {$m$};
  \end{scope}
  % ---------------- (b) Adictivos ----------------
  \begin{scope}[xshift=5.4cm]
    \node[font=\footnotesize\bfseries] at (2.1,4.7) {(b) Adictivos};
    \fill[black!12] plot[domain=0.2:4.3, samples=80] (\x,{3.6-2.4*\x+0.9*\x*\x-0.12*\x*\x*\x}) -- (4.3,4.2) -- (0.2,4.2)
      -- cycle;
    \draw[->] (0,0) -- (4.4,0) node[below] {$x_1$};
    \draw[->] (0,0) -- (0,4.4) node[left] {$x_2$};
    \draw[very thick] plot[domain=0.2:4.3, samples=80] (\x,{3.6-2.4*\x+0.9*\x*\x-0.12*\x*\x*\x});
    \draw[thick, dashed] (2.8,1.302) -- (4,0.72);
    \fill (2.8,1.302) circle (2pt) node[above right] {$y$};
    \fill (4,0.72) circle (2pt) node[above right] {$z$};
    \fill (3.4,1.011) circle (2pt) node[below left] {$m$};
  \end{scope}
  % ---------------- (c) Indivisibles ----------------
  \begin{scope}[xshift=10.8cm]
    \node[font=\footnotesize\bfseries] at (2.1,4.7) {(c) Indivisibles};
    \foreach \k/\h in {1/3.2, 2/1.8, 3/1.2, 4/0.9} {
      \draw[line width=3pt, black!20] (\k,\h) -- (\k,4.2);
      \draw[densely dotted] (\k,0) -- (\k,\h);
      \node[below] at (\k,0) {$\k$};
    }
    \draw[->] (0,0) -- (4.4,0) node[below right] {$x_1$};
    \draw[->] (0,0) -- (0,4.4) node[left] {$x_2$};
    \draw[thick, dashed] (1,3.2) -- (2,1.8);
    \foreach \k/\h in {1/3.2, 3/1.2, 4/0.9} { \fill (\k,\h) circle (2pt); }
    \fill (2,1.8) circle (2pt) node[right, xshift=1pt] {$x$};
    \draw[thick, fill=white] (1.5,2.5) circle (2pt) node[below left] {$m$};
  \end{scope}
\end{tikzpicture}
