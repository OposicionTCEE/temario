% Figura (bloque 3, «Índices de Precios»): separar la subida de precio de un producto que mejora en calidad y precio.
% Una característica. Función hedónica doble logarítmica en el periodo base, ln p = 1 + 0,5 ln z (recta continua), y en el
% corriente, desplazada hacia arriba en 0,9 (recta discontinua). El modelo viejo, m, se vende en el periodo base en
% M^0 = (1,5; 1,75); el nuevo, n, con más de la característica, en el corriente en N^1 = (3,5; 3,65). N^0 = (3,5; 2,75) es lo
% que habría costado el modelo nuevo en el periodo base. La subida de M^0 a N^1 se divide en calidad (a lo largo de la función
% base, de M^0 a N^0) y precio (el desplazamiento de la función, de N^0 a N^1). Los mismos datos que anx_calidad (anexo III),
% con las llaves rotuladas con palabras, como corresponde al cuerpo; las rectas terminan antes de las llaves y se rotulan a la
% izquierda para que las palabras no se crucen con ellas.
% Ejes: ln z (horizontal) y ln p (vertical). Escala: 1 unidad = 1 cm.
% Generar con: bash Code/generar_figura.sh b3_calidad
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1cm, y=1cm]
  \draw[->] (0,0) -- (5.2,0) node[below] {$\ln z$};
  \draw[->] (0,0) -- (0,4.4) node[left] {$\ln p$};
  \draw[very thick] (0.3,1.15) -- (3.75,2.875);
  \draw[very thick, dashed] (0.3,2.05) -- (3.75,3.775);
  \node[below right] at (0.45,1.2) {$t=0$};
  \node at (0.75,2.8) {$t=1$};
  \fill (1.5,1.75) circle (2pt) node[above left] {$M^0$};
  \draw[thick, fill=white] (3.5,2.75) circle (2pt);
  \node[above left] at (3.48,2.77) {$N^0$};
  \fill (3.5,3.65) circle (2pt) node[above left] {$N^1$};
  \draw[densely dotted] (1.5,1.75) -- (3.85,1.75);
  \draw[densely dotted] (3.5,2.75) -- (3.85,2.75);
  \draw[densely dotted] (3.5,3.65) -- (3.85,3.65);
  \draw[densely dotted] (1.5,1.75) -- (1.5,0) node[below] {$\ln z^m$};
  \draw[densely dotted] (3.5,1.75) -- (3.5,0) node[below] {$\ln z^n$};
  \draw[decorate, decoration={brace, amplitude=4pt, mirror}] (3.95,1.75) -- (3.95,2.73) node[midway, right, xshift=4pt] {calidad};
  \draw[decorate, decoration={brace, amplitude=4pt, mirror}] (3.95,2.77) -- (3.95,3.65) node[midway, right, xshift=4pt] {precio};
\end{tikzpicture}
