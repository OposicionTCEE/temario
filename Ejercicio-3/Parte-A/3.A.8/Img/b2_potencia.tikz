% Figura (bloque 2, «Potencia»): cuándo pueden contradecirse dos elecciones. Dos paneles, con las letras s y t de la
% formulación del axioma débil (no las del ejemplo x^1-x^3 del bloque).
% (a) Las rectas se cortan: B^s de (0; 4,2) a (2,4; 0) y B^t de (0; 2,4) a (4,2; 0), que se cortan en (1,527; 1,527).
%     En trazo grueso, el tramo de B^s por debajo de B^t (asequible con B^t) y el de B^t por debajo de B^s (asequible con
%     B^s). x^s = (2; 0,7) y x^t = (0,6; 2,057), cada una en su tramo grueso: cada cesta era asequible cuando se eligió la
%     otra, y las dos elecciones se contradicen.
% (b) Un presupuesto contiene al otro: B^s de (0; 2,2) a (2,6; 0), con su conjunto presupuestario en gris, y B^t de
%     (0; 3,8) a (3,4; 0), con otra pendiente (cambian los precios relativos) pero fuera de B^s en todo el cuadrante.
%     x^s = (2; 0,508) y x^t = (0,6; 3,129), en las mismas posiciones que en (a): x^s era asequible cuando se eligió x^t,
%     pero x^t no lo era cuando se eligió x^s, y no hay contradicción posible.
% Escala: 1 unidad = 1 cm; paneles separados 6 cm.
% Generar con: bash Code/generar_figura.sh b2_potencia
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1cm, y=1cm]
  % ---------------- (a) Las rectas se cortan ----------------
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (2.2,4.95) {(a) Los presupuestos se cortan};
    \draw[->] (0,0) -- (4.6,0) node[below] {$x_1$};
    \draw[->] (0,0) -- (0,4.6) node[left] {$x_2$};
    \draw[thick] (0,4.2) -- (2.4,0);
    \draw[thick] (0,2.4) -- (4.2,0);
    \draw[line width=2.4pt] (1.527,1.527) -- (2.4,0);
    \draw[line width=2.4pt] (0,2.4) -- (1.527,1.527);
    \node[anchor=west] at (0.3,4.0) {$B^s$};
    \node[anchor=south] at (3.9,0.2) {$B^t$};
    \fill (2,0.7) circle (2pt) node[right, xshift=1pt] {$x^s$};
    \fill (0.6,2.057) circle (2pt) node[above right] {$x^t$};
  \end{scope}
  % ---------------- (b) Un presupuesto contiene al otro ----------------
  \begin{scope}[xshift=6cm]
    \node[font=\footnotesize\bfseries] at (2.2,4.95) {(b) Un presupuesto contiene al otro};
    \fill[gray!25] (0,0) -- (0,2.2) -- (2.6,0) -- cycle;
    \draw[->] (0,0) -- (4.6,0) node[below] {$x_1$};
    \draw[->] (0,0) -- (0,4.6) node[left] {$x_2$};
    \draw[thick] (0,2.2) -- (2.6,0);
    \draw[thick] (0,3.8) -- (3.4,0);
    \node[anchor=west] at (0.3,2.15) {$B^s$};
    \node[anchor=west] at (0.45,3.7) {$B^t$};
    \fill (2,0.508) circle (2pt) node[right, xshift=1pt] {$x^s$};
    \fill (0.6,3.129) circle (2pt) node[above right] {$x^t$};
  \end{scope}
\end{tikzpicture}
