% Figura (Anexo I, «Formas Funcionales»): cuatro formas funcionales, con su mapa de indiferencia y la cesta elegida. 2 x 2.
% (a) Sustitutivos perfectos, u = x_1 + x_2: rectas x_1 + x_2 = 1,5; 2,5; 3,5. Recta de balance (discontinua) de (0, 3) a
%     (2, 0), con p_1/p_2 = 1,5 > RMS = 1: se elige la esquina x* = (0, 3).
% (b) Complementarios perfectos, u = min{x_1, x_2}: vértices en (1, 1), (2, 2), (3, 3); recta x_1 + x_2 = 4; x* = (2, 2).
% (c) COBB-DOUGLAS, u = x_1^(1/2) x_2^(1/2): curvas x_1 x_2 = 2; 4; 7; recta x_1 + x_2 = 4; tangencia en x* = (2, 2).
% (d) Cuasilineal, u = 2 ln x_1 + x_2: curvas x_2 = U - 2 ln x_1 con U = 2,386 y 3,386 (traslaciones verticales); rectas
%     x_1 + x_2 = 3 y 4; las cestas elegidas, x^0 = (2, 1) y x^1 = (2, 2), tienen la misma cantidad del bien 1.
% Escala: 1 unidad = 1 cm; cada panel, 4,4 x 4,4 cm.
% Generar con: bash Code/generar_figura.sh anx_formas
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1cm, y=1cm]
  % ---------------- (a) Sustitutivos perfectos ----------------
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (2.2,4.85) {(a) Sustitutivos perfectos};
    \draw[->] (0,0) -- (4.4,0) node[below] {$x_1$};
    \draw[->] (0,0) -- (0,4.4) node[left] {$x_2$};
    \foreach \c in {1.5,3,4.2} { \draw[thick] (0,\c) -- (\c,0); }
    \draw[very thick, dashed] (0,3) -- (2,0);
    \fill (0,3) circle (2pt);
    \node[left] at (0,3) {$x^*$};
  \end{scope}
  % ---------------- (b) Complementarios perfectos ----------------
  \begin{scope}[xshift=5.8cm]
    \node[font=\footnotesize\bfseries] at (2.2,4.85) {(b) Complementarios perfectos};
    \draw[->] (0,0) -- (4.4,0) node[below] {$x_1$};
    \draw[->] (0,0) -- (0,4.4) node[left] {$x_2$};
    \draw[densely dotted] (0,0) -- (4.2,4.2);
    \foreach \k in {1,2,3} { \draw[thick] (\k,4.3) -- (\k,\k) -- (4.3,\k); }
    \draw[very thick, dashed] (0,4) -- (4,0);
    \fill (2,2) circle (2pt);
    \node[below left] at (2,2) {$x^*$};
  \end{scope}
  % ---------------- (c) COBB-DOUGLAS ----------------
  \begin{scope}[yshift=-5.8cm]
    \node[font=\footnotesize\bfseries] at (2.2,4.85) {(c) COBB-DOUGLAS};
    \draw[->] (0,0) -- (4.4,0) node[below] {$x_1$};
    \draw[->] (0,0) -- (0,4.4) node[left] {$x_2$};
    \draw[thick] plot[domain=0.47:4.3, samples=80] (\x,{2/\x});
    \draw[thick] plot[domain=0.93:4.3, samples=80] (\x,{4/\x});
    \draw[thick] plot[domain=1.63:4.3, samples=80] (\x,{7/\x});
    \draw[very thick, dashed] (0,4) -- (4,0);
    \fill (2,2) circle (2pt);
    \node[below left] at (2,2) {$x^*$};
  \end{scope}
  % ---------------- (d) Cuasilineal ----------------
  \begin{scope}[xshift=5.8cm, yshift=-5.8cm]
    \node[font=\footnotesize\bfseries] at (2.2,4.85) {(d) Cuasilineal};
    \draw[->] (0,0) -- (4.4,0) node[below] {$x_1$};
    \draw[->] (0,0) -- (0,4.4) node[left] {$x_2$};
    \draw[thick] plot[domain=0.7:3.3, samples=80] (\x,{2.386-2*ln(\x)});
    \draw[thick] plot[domain=0.86:4.3, samples=80] (\x,{3.386-2*ln(\x)});
    \draw[very thick, dashed] (0,3) -- (3,0);
    \draw[very thick, dashed] (0,4) -- (4,0);
    \draw[densely dotted] (2,0) -- (2,4.2);
    \fill (2,1) circle (2pt);
    \node[below left] at (2,1) {$x^0$};
    \fill (2,2) circle (2pt);
    \node[above right] at (2,2) {$x^1$};
  \end{scope}
\end{tikzpicture}
