% Figura (Anexo I, «Sin racionalidad»): la bomba de dinero con preferencias cíclicas.
% Preferencias intransitivas z > x, y > z, x > y. Cada flecha es un intercambio que el consumidor acepta pagando epsilon:
% x -> z -> y -> x. Tras tres intercambios vuelve a x con 3 epsilon menos.
% Generar con: bash Code/generar_figura.sh anx_bomba_dinero
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1cm, y=1cm]
  \node[circle, draw, thick, minimum size=8mm] (x) at (2.6,3.0) {$x$};
  \node[circle, draw, thick, minimum size=8mm] (z) at (0,0) {$z$};
  \node[circle, draw, thick, minimum size=8mm] (y) at (5.2,0) {$y$};
  \draw[->, thick] (x) -- node[left, xshift=-3pt] {$-\varepsilon$} (z);
  \draw[->, thick] (z) -- node[below] {$-\varepsilon$} (y);
  \draw[->, thick] (y) -- node[right, xshift=3pt] {$-\varepsilon$} (x);
  \node at (2.6,1.05) {$z\succ x,\quad y\succ z,\quad x\succ y$};
\end{tikzpicture}
