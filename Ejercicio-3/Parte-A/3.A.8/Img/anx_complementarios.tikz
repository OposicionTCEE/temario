% Figura (Anexo I, «Formas Funcionales», «Complementarios Perfectos»): elección, demandas individuales y de mercado.
% Tres paneles; p_2 = 1. Era, en parte, el panel (b) de anx_formas.
% (a) Elección con u = min{x_1, x_2}: vértices en (1, 1), (2, 2), (3, 3); recta x_1 + x_2 = 4; x* = (2, 2).
% (b) Demandas del bien 1 de A (renta 2) y de B (renta 4): x_1 = W/(p_1 + 1). A continua, B discontinua.
% (c) Mercado: X_1 = 6/(p_1 + 1), la de un consumidor con la renta total.
% Escala: (a), 1 unidad = 1 cm; (b) y (c), horizontal 1 unidad = 0,7 cm y vertical 1 unidad = 1 cm.
% Generar con: bash Code/generar_figura.sh anx_complementarios
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1cm, y=1cm]
  % ---------------- (a) Elección ----------------
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (2.2,4.85) {(a) Elección};
    \draw[->] (0,0) -- (4.4,0) node[below] {$x_1$};
    \draw[->] (0,0) -- (0,4.4) node[left] {$x_2$};
    \draw[densely dotted] (0,0) -- (4.2,4.2);
    \foreach \k in {1,2,3} { \draw[thick] (\k,4.3) -- (\k,\k) -- (4.3,\k); }
    \draw[very thick, dashed] (0,4) -- (4,0);
    \fill (2,2) circle (2pt);
    \node[below left] at (2,2) {$x^*$};
  \end{scope}
  % ---------------- (b) Demandas individuales ----------------
  \begin{scope}[xshift=5.3cm, x=0.7cm]
    \node[font=\footnotesize\bfseries] at (3.1,4.85) {(b) Demandas individuales};
    \draw[->] (0,0) -- (6.3,0) node[below] {$x_1$};
    \draw[->] (0,0) -- (0,4.4) node[left] {$p_1$};
    \draw[very thick] plot[domain=0:4.2, samples=60] ({2/(\x+1)},{\x});
    \draw[very thick, dashed] plot[domain=0:4.2, samples=60] ({4/(\x+1)},{\x});
    \node[above right] at (2,0) {$A$};
    \node[above right] at (4,0) {$B$};
  \end{scope}
  % ---------------- (c) Demanda de mercado ----------------
  \begin{scope}[xshift=10.6cm, x=0.7cm]
    \node[font=\footnotesize\bfseries] at (3.1,4.85) {(c) Demanda de mercado};
    \draw[->] (0,0) -- (6.3,0) node[below] {$X_1$};
    \draw[->] (0,0) -- (0,4.4) node[left] {$p_1$};
    \draw[very thick] plot[domain=0:4.2, samples=60] ({6/(\x+1)},{\x});
  \end{scope}
\end{tikzpicture}
