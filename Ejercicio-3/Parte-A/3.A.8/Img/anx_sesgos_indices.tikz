% Figura (Anexo III, «Índices de Precios Hedónicos»): tres errores de un índice que no ajusta por calidad. Tres paneles, datos
% imaginarios y ejes sin cifras.
% (a) Calidad contada como inflación: índice sin ajuste (continuo) que crece más que el ajustado (discontinuo).
% (b) Exclusión de los modelos nuevos: parte de las compras que representan los modelos del índice (barras), cada vez menor.
% (c) Deflación oculta: índice sin ajuste casi plano (continuo) y precio ajustado por calidad que cae deprisa (discontinuo).
% Escala: 1 unidad = 1 cm; cada panel, 4,2 x 3,4 cm.
% Generar con: bash Code/generar_figura.sh anx_sesgos_indices
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1cm, y=1cm]
  % ---------------- (a) Calidad como inflación ----------------
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (2.1,3.95) {(a) Calidad como inflación};
    \draw[->] (0,0) -- (4.3,0) node[below] {$t$};
    \draw[->] (0,0) -- (0,3.6) node[left] {Índice};
    \draw[very thick] (0.2,1.2) -- (4,3.1) node[above left] {sin ajuste};
    \draw[very thick, dashed] (0.2,1.2) -- (4,1.75) node[below left] {ajustado};
  \end{scope}
  % ---------------- (b) Modelos que ya no se compran ----------------
  \begin{scope}[xshift=5.4cm]
    \node[font=\footnotesize\bfseries] at (2.1,3.95) {(b) Modelos que se dejan de comprar};
    \draw[->] (0,0) -- (4.3,0) node[below] {$t$};
    \draw[->] (0,0) -- (0,3.6) node[left, align=right] {Compras\\[-2pt] cubiertas};
    \foreach \t/\h in {0.6/3.0, 1.5/2.2, 2.4/1.4, 3.3/0.7} { \fill[black!30] (\t-0.3,0) rectangle (\t+0.3,\h); \draw (\t-0.3,0) rectangle (\t+0.3,\h); }
  \end{scope}
  % ---------------- (c) Deflación oculta ----------------
  \begin{scope}[xshift=10.8cm]
    \node[font=\footnotesize\bfseries] at (2.1,3.95) {(c) Deflación oculta};
    \draw[->] (0,0) -- (4.3,0) node[below] {$t$};
    \draw[->] (0,0) -- (0,3.6) node[left] {Índice};
    \draw[very thick] (0.2,2.6) -- (4,2.8) node[above left] {sin ajuste};
    \draw[very thick, dashed] plot[domain=0.2:4, samples=50] (\x,{2.6*exp(-0.42*(\x-0.2))}) node[below left, yshift=-2pt] {ajustado};
  \end{scope}
\end{tikzpicture}
