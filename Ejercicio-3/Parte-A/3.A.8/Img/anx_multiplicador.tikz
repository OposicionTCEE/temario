% Figura (Anexo I, «Multiplicador»): el multiplicador como utilidad marginal de la renta. Dos paneles.
% Utilidad u = raíz(x_1 x_2), precios p_1 = p_2 = 1.
% (a) En 3D (pgfplots): la superficie u(x_1, x_2) sobre [0, 4]^2; en el suelo, las rectas de balance con W^0 = 3 y
%     W^1 = 4 (discontinuas); sobre la superficie, la utilidad a lo largo de cada recta (gruesas). Sus puntos más altos son
%     las cestas elegidas, x^0 = (1,5; 1,5), con u = 1,5, y x^1 = (2, 2), con u = 2: un euro más eleva la utilidad máxima
%     en lambda = 1/2.
% (b) Utilidad máxima en función de la renta: V(W) = W/2 con u (recta, pendiente lambda = 1/2) y W^2/4 con v = u^2 = x_1 x_2
%     (discontinua, pendiente W/2 = 3/2 en W^0 = 3). Tangentes en W^0 punteadas: la elección es la misma, lambda no.
%     Escala: W, 1 cm por unidad; V, 0,9 cm por unidad.
% Generar con: bash Code/generar_figura.sh anx_multiplicador
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  % ---------------- (a) La utilidad sobre las rectas de balance ----------------
  \begin{axis}[name=tres, at={(0,0)}, anchor=origin, width=8.6cm, height=7.2cm, view={-135}{25},
      axis lines=left, ticks=none, xmin=0, xmax=4.3, ymin=0, ymax=4.3, zmin=0, zmax=4.3,
      xlabel={$x_1$}, ylabel={$x_2$}, zlabel={$u$}, clip=false,
      title={\footnotesize\bfseries (a) La utilidad sobre las rectas de balance}]
    \addplot3[surf, shader=faceted, faceted color=black!30, fill=black!6, opacity=0.75,
      domain=0:4, y domain=0:4, samples=13] {sqrt(x*y)};
    \addplot3[thick, dashed, domain=0:3, samples=2, samples y=0] ({x},{3-x},{0});
    \addplot3[thick, dashed, domain=0:4, samples=2, samples y=0] ({x},{4-x},{0});
    \addplot3[very thick, domain=0:3, samples=60, samples y=0] ({x},{3-x},{sqrt(x*(3-x))});
    \addplot3[very thick, domain=0:4, samples=60, samples y=0] ({x},{4-x},{sqrt(x*(4-x))});
    \addplot3[densely dotted, samples y=0] coordinates {(1.5,1.5,0) (1.5,1.5,1.5)};
    \addplot3[densely dotted, samples y=0] coordinates {(2,2,0) (2,2,2)};
    \addplot3[only marks, mark=*, mark size=1.8pt, samples y=0] coordinates {(1.5,1.5,1.5) (2,2,2)};
    \node[anchor=south east] at (axis cs:1.5,1.5,1.5) {$u(x^0)$};
    \node[anchor=south west] at (axis cs:2,2,2) {$u(x^1)$};
    \node[anchor=north] at (axis cs:3,0,0) {$W^0$};
    \node[anchor=north] at (axis cs:4,0,0) {$W^1$};
  \end{axis}
  % ---------------- (b) La utilidad máxima en función de la renta ----------------
  \begin{scope}[xshift=9.6cm, yshift=0.6cm, x=1cm, y=0.9cm]
    \node[font=\footnotesize\bfseries] at (2.3,5.6) {(b) Utilidad máxima y renta};
    \draw[->] (0,0) -- (4.8,0) node[below] {$W$};
    \draw[->] (0,0) -- (0,5.2) node[left] {$V$};
    \draw[very thick] (0,0) -- (4.5,2.25) node[right] {con $u$};
    \draw[very thick, dashed] plot[domain=0:4.5, samples=60] (\x,{\x*\x/4});
    \node[right] at (4.4,4.95) {con $v=u^2$};
    \draw[densely dotted] (3,0) node[below] {$W^0$} -- (3,2.25);
    \draw[densely dotted] (4,0) node[below] {$W^1$} -- (4,4);
    \draw[thin] (2.1,0.9) -- (3.9,3.6);
    \fill (3,1.5) circle (1.8pt);
    \fill (4,2) circle (1.8pt);
    \fill (3,2.25) circle (1.8pt);
    \node[above left] at (3,1.5) {$\lambda=\tfrac12$};
    \node[left] at (2.75,2.45) {$\lambda=\tfrac32$};
  \end{scope}
\end{tikzpicture}
