% Figura (bloque 2, «Cotas»): las cotas de VARIAN (1982) para la curva de indiferencia que pasa por x^2, con las tres
% elecciones del ejemplo del bloque: x^1 = (1, 3) con B^1 = {3 x_1 + x_2 <= 6}; x^2 = (2, 2) con B^2 = {x_1 + x_2 <= 4};
% x^3 = (3, 1) con B^3 = {x_1 + 3 x_2 <= 6}.
% RW(x^2) (gris claro): unión de los tres conjuntos presupuestarios, porque x^1 y x^3 eran asequibles con B^2; su frontera pasa
% por (0, 6), x^1, x^3 y (6, 0). RP(x^2) (gris oscuro): ninguna elección se revela preferida a x^2, de modo que se reduce a las
% cestas con más de los dos bienes. Curva de las preferencias que generaron los datos (COBB-DOUGLAS con a = 1/2), x_1 x_2 = 4,
% punteada: pasa por x^2 dentro de la zona en blanco.
% Escala: 1 unidad = 0,8 cm.
% Generar con: bash Code/generar_figura.sh b2_cotas
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=0.8cm, y=0.8cm]
  \fill[gray!20] (0,0) -- (6,0) -- (3,1) -- (1,3) -- (0,6) -- cycle;
  \fill[gray!50] (2,2) rectangle (6.4,6.2);
  \draw[->] (0,0) -- (7.0,0) node[below] {$x_1$};
  \draw[->] (0,0) -- (0,6.6) node[left] {$x_2$};
  \draw[thin] (0,6) -- (2,0) node[below] {$B^1$};
  \draw[thin] (0,4) -- (4,0) node[below] {$B^2$};
  \draw[thin] (0,2) -- (6,0) node[below] {$B^3$};
  \draw[thick, densely dotted] plot[domain=0.66:6.4, samples=80] (\x,{4/\x});
  \fill (1,3) circle (2pt) node[below left] {$x^1$};
  \fill (2,2) circle (2pt) node[left] {$x^2$};
  \fill (3,1) circle (2pt) node[below left] {$x^3$};
\end{tikzpicture}
