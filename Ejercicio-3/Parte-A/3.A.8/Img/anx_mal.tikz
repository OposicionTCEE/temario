% Figura (Anexo I, «Monotonía»): un mal. Era el panel (b) de anx_monotonia.
% El bien 2 es un mal: curvas de indiferencia rectas de pendiente positiva, x_2 = x_1 + d con d = 1,2; 0; -1,2; la utilidad
% crece hacia el sureste (flecha).
% Escala: 1 unidad = 1 cm; 4,4 x 4,4 cm.
% Generar con: bash Code/generar_figura.sh anx_mal
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1cm, y=1cm]
  \draw[->] (0,0) -- (4.4,0) node[below] {$x_1$};
  \draw[->] (0,0) -- (0,4.4) node[left] {$x_2$ (mal)};
  \draw[very thick] (0,1.2) -- (2.8,4);
  \draw[very thick] (0.15,0.15) -- (4,4);
  \draw[very thick] (1.2,0) -- (4,2.8);
  \draw[->, thick] (1.5,2.9) -- (2.5,1.9);
\end{tikzpicture}
