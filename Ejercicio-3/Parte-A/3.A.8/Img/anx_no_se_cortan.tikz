% Figura (Anexo I, «Curvas de Indiferencia»): por qué no se cortan. Era el panel (a) de anx_curvas_indiferencia.
% x_1 x_2 = 4 y x_2 = 8/x_1^2 se cortarían en x = (2, 2); y = (3,2; 1,25) está en la primera y z = (3,2; 0,781), en la
% segunda: y tiene la misma cantidad del bien 1 y más del bien 2 que z.
% Escala: 1 unidad = 1 cm; 5,4 x 5,4 cm.
% Generar con: bash Code/generar_figura.sh anx_no_se_cortan
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1cm, y=1cm]
  \draw[->] (0,0) -- (5.6,0) node[below] {$x_1$};
  \draw[->] (0,0) -- (0,5.6) node[left] {$x_2$};
  \draw[very thick] plot[domain=0.8:5.2, samples=80] (\x,{4/\x});
  \draw[very thick, dashed] plot[domain=1.25:5.2, samples=80] (\x,{8/(\x*\x)});
  \fill (2,2) circle (2pt) node[above right] {$x$};
  \fill (3.2,1.25) circle (2pt) node[above right] {$y$};
  \fill (3.2,0.781) circle (2pt) node[below left] {$z$};
  \draw[densely dotted] (3.2,0) -- (3.2,1.25);
\end{tikzpicture}
