% Figura (bloque 1, «Sin Buen Comportamiento»): la cesta elegida con buen comportamiento y cuando falla cada supuesto.
% La misma recta de balance en los cuatro paneles: corta los ejes en W/p_1 = 3 y W/p_2 = 2,2 (pendiente -p_1/p_2 = -0,733).
% Mismo orden de paneles que la figura de las curvas de indiferencia (b1_incumplimientos).
% (a) Buen comportamiento: curva x_1 x_2 = 1,65, tangente a la recta en x* = (1,5; 1,1) (COBB-DOUGLAS con a = 1/2).
% (b) Sin continuidad (lexicográficas, primero el bien 1): x* = (W/p_1, 0) = (3, 0); la vertical discontinua por x* es la curva
%     de indiferencia de u = x_1, que lleva a la misma elección.
% (c) Sin no saciedad local: punto de saciedad s = (0,9; 0,75), asequible, con curvas cerradas de radios 0,35 y 0,6: el
%     consumidor elige s y le sobra renta.
% (d) Sin convexidad: u = x_1^2 + x_2^2. La curva de radio 1,774 es tangente a la recta en m = (1,049; 1,431), el punto de la
%     recta más cercano al origen y el PEOR de ella; el óptimo es la esquina x* = (3, 0), por la que pasa la curva de radio 3.
% Escala: 1 unidad = 1 cm; paneles separados 3,85 cm.
% Generar con: bash Code/generar_figura.sh b1_eleccion
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  % ---------------- (a) Buen comportamiento ----------------
  \node[font=\footnotesize\bfseries, align=center] at (1.7,3.65) {(a) Buen\\ comportamiento};
  \draw[->] (0,0) -- (3.4,0) node[below] {$x_1$};
  \draw[->] (0,0) -- (0,3.0) node[left] {$x_2$};
  \draw[thick] (0,2.2) node[left] {$\frac{W}{p_2}$} -- (3,0) node[below] {$\frac{W}{p_1}$};
  \draw[very thick] plot[domain=0.57:3.3, samples=60] (\x,{1.65/\x});
  \fill (1.5,1.1) circle (1.8pt) node[above right] {$x^*$};
  % ---------------- (b) Sin continuidad ----------------
  \begin{scope}[xshift=3.85cm]
    \node[font=\footnotesize\bfseries, align=center] at (1.7,3.65) {(b) Sin\\ continuidad};
    \draw[->] (0,0) -- (3.4,0) node[below] {$x_1$};
    \draw[->] (0,0) -- (0,3.0) node[left] {$x_2$};
    \draw[thick] (0,2.2) -- (3,0);
    \draw[dashed] (3,0) -- (3,2.7);
    \fill (3,0) circle (1.8pt) node[above right] {$x^*$};
  \end{scope}
  % ---------------- (c) Sin no saciedad local ----------------
  \begin{scope}[xshift=7.7cm]
    \node[font=\footnotesize\bfseries, align=center] at (1.7,3.65) {(c) Sin no\\ saciedad local};
    \draw[->] (0,0) -- (3.4,0) node[below] {$x_1$};
    \draw[->] (0,0) -- (0,3.0) node[left] {$x_2$};
    \draw[thick] (0,2.2) -- (3,0);
    \draw[thick] (0.9,0.75) circle (0.35);
    \draw[thick] (0.9,0.75) circle (0.6);
    \fill (0.9,0.75) circle (1.6pt) node[right, inner sep=1.5pt] {$s$};
  \end{scope}
  % ---------------- (d) Sin convexidad ----------------
  \begin{scope}[xshift=11.55cm]
    \node[font=\footnotesize\bfseries, align=center] at (1.7,3.65) {(d) Sin\\ convexidad};
    \draw[->] (0,0) -- (3.4,0) node[below] {$x_1$};
    \draw[->] (0,0) -- (0,3.0) node[left] {$x_2$};
    \draw[thick] (0,2.2) -- (3,0);
    \draw[very thick] plot[domain=4:86, samples=60] ({1.774*cos(\x)},{1.774*sin(\x)});
    \draw[very thick] plot[domain=0:62, samples=60] ({3*cos(\x)},{3*sin(\x)});
    \draw[thick, fill=white] (1.049,1.431) circle (1.6pt);
    \node[below left] at (1.02,1.40) {$m$};
    \fill (3,0) circle (1.8pt) node[above right] {$x^*$};
  \end{scope}
\end{tikzpicture}
