% Figura (Anexo I, «CES»): curvas de indiferencia CES con pesos iguales que pasan por la misma cesta, (2, 2), para cinco
% valores de la elasticidad de sustitución, sigma = 1/(1 - rho):
% sigma = 0 (complementarios perfectos, L con vértice en (2, 2)); sigma = 1/2 (rho = -1): x_2 = x_1/(x_1 - 1);
% sigma = 1 (COBB-DOUGLAS): x_2 = 4/x_1; sigma = 2 (rho = 1/2): x_2 = (2 raíz(2) - raíz(x_1))^2;
% sigma = infinito (sustitutivos perfectos): x_2 = 4 - x_1.
% Escala: 1 unidad = 1,1 cm.
% Generar con: bash Code/generar_figura.sh anx_ces
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1.1cm, y=1.1cm]
  \draw[->] (0,0) -- (4.9,0) node[below] {$x_1$};
  \draw[->] (0,0) -- (0,4.7) node[left] {$x_2$};
  \draw[very thick] (2,4.4) -- (2,2) -- (4.4,2);
  \draw[thick] plot[domain=1.3:4.4, samples=80] (\x,{\x/(\x-1)});
  \draw[thick] plot[domain=0.91:4.4, samples=80] (\x,{4/\x});
  \draw[thick] plot[domain=0.62:4.4, samples=80] (\x,{(2*sqrt(2)-sqrt(\x))^2});
  \draw[thick, dashed] (0,4) -- (4,0);
  \fill (2,2) circle (2pt);
  \node[right, font=\scriptsize] at (4.4,2) {$\sigma=0$};
  \node[right, font=\scriptsize] at (4.4,1.43) {$\sigma=\tfrac12$};
  \node[right, font=\scriptsize] at (4.4,0.91) {$\sigma=1$};
  \node[right, font=\scriptsize] at (4.4,0.53) {$\sigma=2$};
  \node[below right, font=\scriptsize] at (3.95,0.05) {$\sigma=\infty$};
\end{tikzpicture}
