% Figura (Anexo I, «Preferencias no convexas»): bienes que se disfrutan por separado.
% Arco de radio 3 centrado en el origen, cóncavo en todo su recorrido, con su contorno superior (gris); y y z en los ángulos
% de 72 y 18 grados, y su punto medio m = (1,89; 1,89), por debajo de la curva (peor que los extremos).
% Escala: 1 unidad = 1 cm; 4,4 x 4,4 cm.
% Generar con: bash Code/generar_figura.sh anx_separados
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1cm, y=1cm]
  \fill[black!12] (0.52,2.954) arc (80:10:3) -- (4.2,0.521) -- (4.2,4.2) -- (0.52,4.2) -- cycle;
  \draw[->] (0,0) -- (4.4,0) node[below] {$x_1$};
  \draw[->] (0,0) -- (0,4.4) node[left] {$x_2$};
  \draw[very thick] (0.52,2.954) arc (80:10:3);
  \draw[thick, dashed] (0.927,2.853) -- (2.853,0.927);
  \fill (0.927,2.853) circle (2pt) node[above right] {$y$};
  \fill (2.853,0.927) circle (2pt) node[above right] {$z$};
  \fill (1.89,1.89) circle (2pt) node[below left] {$m$};
\end{tikzpicture}
