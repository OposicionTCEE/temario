% Figura (bloque 1, «Precio Propio»): de la elección a la curva de demanda de un bien de GIFFEN. Dos paneles, uno encima del
% otro, con la misma escala horizontal (x_1), para que cada cesta elegida baje a su punto de la curva (líneas de puntos).
% Mismas elecciones que anx_giffen (anexo I): p_2 = 1, W = 4; rectas de balance de (0, 4) a (2,2; 0), (3; 0) y (4,2; 0), con
% p_1 = 1,818 (A), 1,333 (B) y 0,952 (C); cestas A = (1,6; 1,091), B = (1,3; 2,267) y C = (2; 2,095), con arcos de curva de
% indiferencia tangentes, x_2 = P_2 + m (x_1 - P_1) + 0,5 (x_1 - P_1)^2, con m la pendiente de la recta. Las tres elecciones
% cumplen el axioma débil de la preferencia revelada. Entre A y B baja el precio y se compra menos del bien 1 (GIFFEN).
% (a) Arriba: rectas de balance, arcos y senda precio-consumo (discontinua) por A, B y C.
% (b) Abajo: curva de demanda del bien 1, con p_1 en el eje vertical, por (1,6; 1,818), (1,3; 1,333) y (2; 0,952).
% Escala: x_1, 1 unidad = 1,15 cm en los dos paneles; (a) x_2, 1 unidad = 0,7 cm; (b) p_1, 1 unidad = 1,3 cm.
% Generar con: bash Code/generar_figura.sh b1_precio
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}]
  % ---------------- (a) Senda precio-consumo ----------------
  \begin{scope}[x=1.15cm, y=0.7cm]
    \node[font=\footnotesize\bfseries, anchor=west] at (2.2,5.15) {(a) Senda precio-consumo};
    \draw[->] (0,0) -- (4.6,0) node[below] {$x_1$};
    \draw[->] (0,0) -- (0,4.5) node[left] {$x_2$};
    \draw[thick] (0,4) -- (2.2,0);
    \draw[thick] (0,4) -- (3,0);
    \draw[thick] (0,4) -- (4.2,0);
    \draw[very thick] plot[domain=1.1:2.1, samples=40] (\x,{1.091-1.818*(\x-1.6)+0.5*(\x-1.6)^2});
    \draw[very thick] plot[domain=0.8:1.8, samples=40] (\x,{2.267-1.333*(\x-1.3)+0.5*(\x-1.3)^2});
    \draw[very thick] plot[domain=1.5:2.5, samples=40] (\x,{2.095-0.952*(\x-2)+0.5*(\x-2)^2});
    \draw[dashed] plot[smooth] coordinates {(1.6,1.091) (1.3,2.267) (2,2.095)};
    \coordinate (A1) at (1.6,1.091);
    \coordinate (B1) at (1.3,2.267);
    \coordinate (C1) at (2,2.095);
    \fill (A1) circle (1.8pt) node[right] {$A$};
    \fill (B1) circle (1.8pt) node[left] {$B$};
    \fill (C1) circle (1.8pt) node[above right] {$C$};
  \end{scope}
  % ---------------- (b) Curva de demanda ----------------
  \begin{scope}[yshift=-4.75cm, x=1.15cm, y=1.3cm]
    \node[font=\footnotesize\bfseries] at (2.3,2.75) {(b) Curva de demanda del bien 1};
    \draw[->] (0,0) -- (4.6,0) node[below] {$x_1$};
    \draw[->] (0,0) -- (0,2.4) node[left] {$p_1$};
    \draw[very thick] plot[smooth, tension=0.8] coordinates {(1.72,2.08) (1.6,1.818) (1.3,1.333) (2,0.952) (2.6,0.76)};
    \coordinate (A2) at (1.6,1.818);
    \coordinate (B2) at (1.3,1.333);
    \coordinate (C2) at (2,0.952);
    \draw[densely dotted] (A2) -- (0,1.818) node[left] {$p_1^A$};
    \draw[densely dotted] (B2) -- (0,1.333) node[left] {$p_1^B$};
    \draw[densely dotted] (C2) -- (0,0.952) node[left] {$p_1^C$};
    \fill (A2) circle (1.8pt) node[right] {$A$};
    \fill (B2) circle (1.8pt) node[below left] {$B$};
    \fill (C2) circle (1.8pt) node[above right] {$C$};
    \node at (0.75,1.62) {$\varepsilon_{11}>0$};
    \node at (2.75,1.2) {$\varepsilon_{11}<0$};
  \end{scope}
  \draw[densely dotted] (A1) -- (A2);
  \draw[densely dotted] (B1) -- (B2);
  \draw[densely dotted] (C1) -- (C2);
\end{tikzpicture}
