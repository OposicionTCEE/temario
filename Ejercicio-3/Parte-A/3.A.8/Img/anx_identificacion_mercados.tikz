% Figura (Anexo III, «Identificación», «Soluciones»): dos mercados identifican la demanda de una característica.
% Un mismo tipo de comprador, con valoración marginal D: p' = 1,2 - 0,25 z (gruesa), se enfrenta a dos funciones de precios
% implícitos: p'_A(z) = 0,24 z (mercado A) y p'_B(z) = 0,15 + 0,1 z (mercado B), discontinuas.
% Elige z^A = 2,449 con p' = 0,588 en A y z^B = 3 con p' = 0,45 en B: los dos puntos están sobre D.
% Ejes: z (1 unidad = 1 cm) y precio implícito (1 unidad = 3,5 cm).
% Generar con: bash Code/generar_figura.sh anx_identificacion_mercados
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1cm, y=3.5cm]
  \draw[->] (0,0) -- (5.9,0) node[below] {$z$};
  \draw[->] (0,0) -- (0,1.3) node[left] {$p'(z)$};
  \draw[thick, dashed] (0.3,0.072) -- (5.0,1.2) node[right] {$p'_A(z)$};
  \draw[thick, dashed] (0,0.15) -- (5.5,0.7) node[right] {$p'_B(z)$};
  \draw[very thick] (0.4,1.1) -- (4.8,0) node[above right] {$D$};
  \fill (2.449,0.588) circle (2pt);
  \fill (3,0.45) circle (2pt);
  \draw[densely dotted] (2.449,0.588) -- (2.449,0) node[below] {$z^A$};
  \draw[densely dotted] (3,0.45) -- (3,0) node[below] {$z^B$};
\end{tikzpicture}
