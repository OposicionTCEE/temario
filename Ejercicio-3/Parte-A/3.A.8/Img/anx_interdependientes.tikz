% Figura (Anexo I, «Preferencias Interdependientes»): la demanda de mercado con los efectos de LEIBENSTEIN (1950). Tres
% paneles; en cada uno, D (discontinua) es la suma horizontal de las demandas individuales sin el efecto, p = 4 - X, y D'
% (continua), la que se observaría con él.
% (a) Arrastre: D' es p = 3 - 0,5 X, más plana (más elástica), y corta a D en R = (2, 2).
% (b) Esnob: D' es p = 6 - 2 X, más inclinada (menos elástica), y corta a D en R = (2, 2).
% (c) VEBLEN: D' es X = 4 - 2p + 0,45 p^2, con pendiente negativa por debajo de p = 2,22 y positiva por encima (tramo
%     creciente: más cantidad cuanto más caro).
% Escala: 1 unidad = 1 cm; cada panel, 4,4 x 4,4 cm.
% Generar con: bash Code/generar_figura.sh anx_interdependientes
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1cm, y=1cm]
  % ---------------- (a) Arrastre ----------------
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (2.2,4.85) {(a) Arrastre};
    \draw[->] (0,0) -- (4.4,0) node[below] {$X$};
    \draw[->] (0,0) -- (0,4.4) node[left] {$p$};
    \draw[thick, dashed] (0,4) -- (4,0) node[above right] {$D$};
    \draw[very thick] (0,3) -- (4.2,0.9) node[above] {$D'$};
    \fill (2,2) circle (1.8pt) node[above right] {$R$};
  \end{scope}
  % ---------------- (b) Esnob ----------------
  \begin{scope}[xshift=5.4cm]
    \node[font=\footnotesize\bfseries] at (2.2,4.85) {(b) Esnob};
    \draw[->] (0,0) -- (4.4,0) node[below] {$X$};
    \draw[->] (0,0) -- (0,4.4) node[left] {$p$};
    \draw[thick, dashed] (0,4) -- (4,0) node[above right] {$D$};
    \draw[very thick] (1,4) -- (3,0) node[above right] {$D'$};
    \fill (2,2) circle (1.8pt) node[right, xshift=2pt] {$R$};
  \end{scope}
  % ---------------- (c) VEBLEN ----------------
  \begin{scope}[xshift=10.8cm]
    \node[font=\footnotesize\bfseries] at (2.2,4.85) {(c) VEBLEN};
    \draw[->] (0,0) -- (4.4,0) node[below] {$X$};
    \draw[->] (0,0) -- (0,4.4) node[left] {$p$};
    \draw[thick, dashed] (0,4) -- (4,0) node[above right] {$D$};
    \draw[very thick] plot[domain=0.2:3.8, samples=80] ({4-2*\x+0.45*\x*\x},{\x});
    \node[right] at (2.9,3.8) {$D'$};
    \draw[densely dotted] (0,2.22) -- (1.78,2.22);
  \end{scope}
\end{tikzpicture}
