% Figura (bloque 2, «Observación»): lo que revela una elección y los datos del ejemplo del bloque. Dos paneles.
% Tres elecciones de un mismo consumidor (las del anexo II, de una COBB-DOUGLAS con a = 1/2, que no se dibuja):
% x^1 = (1, 3) con B^1 = {3 x_1 + x_2 <= 6}; x^2 = (2, 2) con B^2 = {x_1 + x_2 <= 4}; x^3 = (3, 1) con B^3 = {x_1 + 3 x_2 <= 6}.
% (a) Una elección: x^2 se revela preferida a todo su conjunto presupuestario (gris claro); con monotonía, las cestas con más
%     de los dos bienes son mejores (gris oscuro); de las demás (en blanco), la elección no dice nada.
% (b) Los datos: las tres rectas de balance y las tres cestas elegidas; x^1 y x^3 están sobre B^2.
% Escala: 1 unidad = 0,72 cm; paneles separados 7,6 cm.
% Generar con: bash Code/generar_figura.sh b2_observacion
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=0.72cm, y=0.72cm]
  % ---------------- (a) Una elección ----------------
  \node[font=\footnotesize\bfseries] at (3.2,7.0) {(a) Una elección};
  \fill[gray!20] (0,0) -- (4,0) -- (0,4) -- cycle;
  \fill[gray!50] (2,2) rectangle (6.2,6.2);
  \draw[->] (0,0) -- (6.8,0) node[below] {$x_1$};
  \draw[->] (0,0) -- (0,6.6) node[left] {$x_2$};
  \draw[thick] (0,4) -- (4,0) node[below] {$B^2$};
  \fill (2,2) circle (2pt) node[above left] {$x^2$};
  % ---------------- (b) Tres elecciones ----------------
  \begin{scope}[xshift=7.6cm]
    \node[font=\footnotesize\bfseries] at (3.2,7.0) {(b) Tres elecciones};
    \draw[->] (0,0) -- (6.8,0) node[below] {$x_1$};
    \draw[->] (0,0) -- (0,6.6) node[left] {$x_2$};
    \draw[thick] (0,6) -- (2,0) node[below] {$B^1$};
    \draw[thick] (0,4) -- (4,0) node[below] {$B^2$};
    \draw[thick] (0,2) -- (6,0) node[below] {$B^3$};
    \fill (1,3) circle (2pt) node[above right] {$x^1$};
    \fill (2,2) circle (2pt) node[above right] {$x^2$};
    \fill (3,1) circle (2pt) node[above right] {$x^3$};
  \end{scope}
\end{tikzpicture}
