% Figura (Anexo I, «Formas Funcionales», «Cuasilineal»): elección, demandas individuales y demanda de mercado.
% Tres paneles; p_2 = 1. Era, en parte, el panel (d) de anx_formas.
% (a) Elección con u = 2 ln x_1 + x_2: curvas x_2 = U - 2 ln x_1 con U = 2,386 y 3,386 (traslaciones verticales); rectas
%     x_1 + x_2 = 3 y 4; las cestas elegidas, x^0 = (2, 1) y x^1 = (2, 2), tienen la misma cantidad del bien 1.
% (b) Demandas del bien 1 de A (renta 3) y de B (renta 5): las dos son x_1 = 2/p_1, porque la renta no la afecta (solución
%     interior: el gasto en el bien 1 es siempre 2, menor que las dos rentas).
% (c) Mercado: X_1 = 4/p_1, que no depende de cómo se reparta la renta.
% Escala: (a), 1 unidad = 1 cm; (b) y (c), horizontal 1 unidad = 0,7 cm y vertical 1 unidad = 1 cm.
% Generar con: bash Code/generar_figura.sh anx_cuasilineal
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1cm, y=1cm]
  % ---------------- (a) Elección ----------------
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (2.2,4.85) {(a) Elección};
    \draw[->] (0,0) -- (4.4,0) node[below] {$x_1$};
    \draw[->] (0,0) -- (0,4.4) node[left] {$x_2$};
    \draw[thick] plot[domain=0.7:3.3, samples=80] (\x,{2.386-2*ln(\x)});
    \draw[thick] plot[domain=0.86:4.3, samples=80] (\x,{3.386-2*ln(\x)});
    \draw[very thick, dashed] (0,3) -- (3,0);
    \draw[very thick, dashed] (0,4) -- (4,0);
    \draw[densely dotted] (2,0) -- (2,4.2);
    \fill (2,1) circle (2pt);
    \node[below left] at (2,1) {$x^0$};
    \fill (2,2) circle (2pt);
    \node[above right] at (2,2) {$x^1$};
  \end{scope}
  % ---------------- (b) Demandas individuales ----------------
  \begin{scope}[xshift=5.3cm, x=0.7cm]
    \node[font=\footnotesize\bfseries] at (3.1,4.85) {(b) Demandas individuales};
    \draw[->] (0,0) -- (6.3,0) node[below] {$x_1$};
    \draw[->] (0,0) -- (0,4.4) node[left] {$p_1$};
    \draw[very thick] plot[domain=0.34:4.2, samples=80] ({2/\x},{\x});
    \node[above] at (5.4,0.4) {$A$ y $B$};
  \end{scope}
  % ---------------- (c) Demanda de mercado ----------------
  \begin{scope}[xshift=10.6cm, x=0.7cm]
    \node[font=\footnotesize\bfseries] at (3.1,4.85) {(c) Demanda de mercado};
    \draw[->] (0,0) -- (6.3,0) node[below] {$X_1$};
    \draw[->] (0,0) -- (0,4.4) node[left] {$p_1$};
    \draw[very thick] plot[domain=0.67:4.2, samples=80] ({4/\x},{\x});
  \end{scope}
\end{tikzpicture}
