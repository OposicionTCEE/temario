% Figura (Anexo II, «Recuperación»): las cotas de VARIAN (1982) para la curva de indiferencia que pasa por x^0.
% Cinco elecciones de una COBB-DOUGLAS con a = 1/2:
%   x^0 = (2, 2) con B^0 = {x_1 + x_2 <= 4};
%   x^1 = (1,3; 5,2) con B^1 = {4 x_1 + x_2 <= 10,4} y x^2 = (5,2; 1,3) con B^2 = {x_1 + 4 x_2 <= 10,4}: x^0 era asequible,
%   de modo que x^1 y x^2 se revelan preferidas a x^0;
%   x^3 = (0,75; 3) con B^3 = {4 x_1 + x_2 <= 6} y x^4 = (3; 0,75) con B^4 = {x_1 + 4 x_2 <= 6}: eran asequibles con B^0,
%   de modo que se revelan peores que x^0, igual que todo lo que era asequible cuando se eligieron.
% RP(x^0) (gris claro): envolvente convexa y monótona de x^1 y x^2. RW(x^0) (gris oscuro): unión de B^0, B^3 y B^4, con
% vértices (0, 6), (0,667; 3,333), (3,333; 0,667), (6, 0). Curva verdadera x_1 x_2 = 4, punteada.
% Escala: 1 unidad = 0,8 cm.
% Generar con: bash Code/generar_figura.sh anx_recuperacion
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=0.8cm, y=0.8cm]
  \fill[black!12] (1.3,6.6) -- (1.3,5.2) -- (5.2,1.3) -- (6.6,1.3) -- (6.6,6.6) -- cycle;
  \fill[black!28] (0,0) -- (0,6) -- (0.667,3.333) -- (3.333,0.667) -- (6,0) -- cycle;
  \draw[->] (0,0) -- (7,0) node[below] {$x_1$};
  \draw[->] (0,0) -- (0,7) node[left] {$x_2$};
  \draw[thin, dashed] (1.3,5.2) -- (2.6,0);
  \draw[thin, dashed] (5.2,1.3) -- (0,2.6);
  \draw[thick] (1.3,6.6) -- (1.3,5.2) -- (5.2,1.3) -- (6.6,1.3);
  \draw[thick] (0,6) -- (0.667,3.333) -- (3.333,0.667) -- (6,0);
  \draw[densely dotted, thick] plot[domain=0.62:6.4, samples=80] (\x,{4/\x});
  \fill (2,2) circle (2pt) node[above right] {$x^0$};
  \fill (1.3,5.2) circle (2pt) node[left] {$x^1$};
  \fill (5.2,1.3) circle (2pt) node[below] {$x^2$};
  \fill (0.75,3) circle (2pt) node[right] {$x^3$};
  \fill (3,0.75) circle (2pt) node[above] {$x^4$};
  \node at (4.6,4.6) {$RP(x^0)$};
  \node at (1.25,1.15) {$RW(x^0)$};
\end{tikzpicture}
