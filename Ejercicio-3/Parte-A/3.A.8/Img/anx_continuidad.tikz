% Figura (Anexo I, «Continuidad»): un cambio pequeño del precio mueve poco la cesta elegida y el punto de la demanda.
% Utilidad COBB-DOUGLAS u = x_1 x_2, p_2 = 1, W = 4: x_1 = 2/p_1, x_2 = 2.
% (a) Elección: con p_1 = 1, recta (0, 4)-(4, 0) y x = (2, 2) en x_1 x_2 = 4; con p_1' = 0,85, recta (0, 4)-(4,706; 0)
%     (discontinua) y x' = (2,353; 2) en x_1 x_2 = 4,706.
% (b) Demanda del bien 1: x_1 = 2/p_1, con p_1 en el eje vertical (1 unidad = 2,5 cm); puntos (2; 1) y (2,353; 0,85).
% Escala: 1 unidad = 1 cm.
% Generar con: bash Code/generar_figura.sh anx_continuidad
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1cm, y=1cm]
  % ---------------- (a) Elección ----------------
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (2.4,5.1) {(a) Elección};
    \draw[->] (0,0) -- (5,0) node[below] {$x_1$};
    \draw[->] (0,0) -- (0,4.7) node[left] {$x_2$};
    \draw[very thick] (0,4) -- (4,0);
    \draw[thick, dashed] (0,4) -- (4.706,0);
    \draw[thick] plot[domain=0.9:4.6, samples=80] (\x,{4/\x});
    \draw[thick] plot[domain=1.05:4.6, samples=80] (\x,{4.706/\x});
    \fill (2,2) circle (2pt) node[below left] {$x$};
    \fill (2.353,2) circle (2pt) node[above right] {$x'$};
  \end{scope}
  % ---------------- (b) Demanda ----------------
  \begin{scope}[xshift=6.6cm, y=2.5cm]
    \node[font=\footnotesize\bfseries] at (2.4,2.04) {(b) Demanda del bien 1};
    \draw[->] (0,0) -- (5,0) node[below] {$x_1$};
    \draw[->] (0,0) -- (0,1.88) node[left] {$p_1$};
    \draw[very thick] plot[domain=0.45:1.75, samples=80] ({2/\x},{\x});
    \draw[densely dotted] (0,1) node[left] {$p_1$} -- (2,1) -- (2,0);
    \draw[densely dotted] (0,0.85) node[left] {$p_1'$} -- (2.353,0.85) -- (2.353,0);
    \fill (2,1) circle (2pt) node[above right] {$x$};
    \fill (2.353,0.85) circle (2pt) node[above right] {$x'$};
  \end{scope}
\end{tikzpicture}
