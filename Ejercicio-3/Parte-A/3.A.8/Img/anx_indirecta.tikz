% Figura (Anexo II, «Axioma Fuerte»): preferencia revelada indirecta.
% B^1 = {x_1 + x_2 <= 4}, elegida x^1 = (2, 2); B^2 = {2,5 x_1 + x_2 <= 4,6}, elegida x^2 = (0,8; 2,6), que era asequible con
% B^1; B^3 = {6 x_1 + x_2 <= 5,4}, elegida x^3 = (0,25; 3,9), que era asequible con B^2 pero no con B^1.
% x^1 se revela preferida a x^2 y x^2 a x^3: x^1 se revela preferida a x^3 de forma indirecta. Con B^3, x^1 no es asequible,
% de modo que no hay ciclo.
% Escala: 1 unidad = 1 cm.
% Generar con: bash Code/generar_figura.sh anx_indirecta
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1cm, y=1cm]
  \draw[->] (0,0) -- (4.6,0) node[below] {$x_1$};
  \draw[->] (0,0) -- (0,5.8) node[left] {$x_2$};
  \draw[very thick] (0,4) -- (4,0) node[below] {$B^1$};
  \draw[thick, dashed] (0,4.6) -- (1.84,0) node[below] {$B^2$};
  \draw[thick, densely dotted] (0,5.4) -- (0.9,0) node[below] {$B^3$};
  \fill (2,2) circle (2pt) node[above right] {$x^1$};
  \fill (0.8,2.6) circle (2pt) node[right, xshift=1pt] {$x^2$};
  \fill (0.25,3.9) circle (2pt) node[right, xshift=1pt] {$x^3$};
\end{tikzpicture}
