% Figura (Anexo III, «Identificación»): por qué los precios implícitos no trazan la demanda de la característica.
% Precio implícito p'(z) = 0,24 z (recta creciente). Dos compradores con valoraciones marginales decrecientes y paralelas,
% D_1 por (1,8; 0,432) y D_2 por (3,6; 0,864), ambas con pendiente -0,25. Los puntos observados (z^j, p'(z^j)) están sobre
% p'(z), no sobre ninguna de las dos demandas. Eje vertical: precio implícito (1 unidad = 2 cm).
% Escala horizontal: 1 unidad = 1 cm.
% Generar con: bash Code/generar_figura.sh anx_identificacion
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1cm, y=2cm]
  \draw[->] (0,0) -- (5.9,0) node[below] {$z$};
  \draw[->] (0,0) -- (0,1.55) node[left] {$p'(z)$};
  \draw[very thick] (0.3,0.072) -- (5.3,1.272) node[right] {$p'(z)$};
  \draw[thick, dashed] (0.5,0.757) -- (3.4,0.032) node[below] {$D_1$};
  \draw[thick, dashed] (2.1,1.239) -- (5.3,0.439) node[right] {$D_2$};
  \fill (1.8,0.432) circle (2pt);
  \fill (3.6,0.864) circle (2pt);
  \draw[densely dotted] (1.8,0.432) -- (1.8,0) node[below] {$z^1$};
  \draw[densely dotted] (3.6,0.864) -- (3.6,0) node[below] {$z^2$};
\end{tikzpicture}
