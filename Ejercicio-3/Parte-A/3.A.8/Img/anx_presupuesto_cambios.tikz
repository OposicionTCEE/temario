% Figura (Anexo I, «Conjunto Presupuestario»): cambios de la recta de balance. Dos paneles (eran los (b) y (c) de
% anx_presupuesto).
% (a) Aumenta la renta: la recta se desplaza en paralelo, de (0; 2,7)-(2,25; 0) a (0; 3,9)-(3,25; 0).
% (b) Baja el precio del bien 1: la recta gira en torno a su corte con el eje del bien 2, W/p_2 = 3; el corte con el eje
%     del bien 1 pasa de W/p_1^0 = 2 a W/p_1^1 = 3,6.
% Escala: 1 unidad = 1 cm; cada panel, 4,4 x 4,4 cm.
% Generar con: bash Code/generar_figura.sh anx_presupuesto_cambios
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1cm, y=1cm]
  % ---------------- (a) Aumenta la renta ----------------
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (2.2,4.85) {(a) Sube la renta};
    \draw[->] (0,0) -- (4.4,0) node[below] {$x_1$};
    \draw[->] (0,0) -- (0,4.4) node[left] {$x_2$};
    \draw[thick, dashed] (0,2.7) -- (2.25,0);
    \draw[very thick] (0,3.9) -- (3.25,0);
    \draw[->, thick] (0.9,1.95) -- (1.45,2.6);
    \node[left] at (0,2.7) {$W^0/p_2$};
    \node[left] at (0,3.9) {$W^1/p_2$};
  \end{scope}
  % ---------------- (b) Baja el precio del bien 1 ----------------
  \begin{scope}[xshift=6.2cm]
    \node[font=\footnotesize\bfseries] at (2.2,4.85) {(b) Baja $p_1$};
    \draw[->] (0,0) -- (4.4,0) node[below] {$x_1$};
    \draw[->] (0,0) -- (0,4.4) node[left] {$x_2$};
    \draw[thick, dashed] (0,3) -- (2,0);
    \draw[very thick] (0,3) -- (3.6,0);
    \draw[->, thick] (2.15,0.3) -- (3.1,0.3);
    \node[left] at (0,3) {$W/p_2$};
    \node[below] at (2,0) {$W/p_1^0$};
    \node[below] at (3.6,0) {$W/p_1^1$};
  \end{scope}
\end{tikzpicture}
