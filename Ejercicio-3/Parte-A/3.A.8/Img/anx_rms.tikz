% Figura (Anexo I, «Curvas de Indiferencia», «Pendiente»): la relación marginal de sustitución decreciente. Era el panel (b)
% de anx_curvas_indiferencia.
% x_1 x_2 = 4; tangentes en A = (1, 4), pendiente -4 (RMS_12 = 4), y en B = (4, 1), pendiente -1/4 (RMS_12 = 1/4).
% Escala: 1 unidad = 1 cm; 5,4 x 5,4 cm.
% Generar con: bash Code/generar_figura.sh anx_rms
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1cm, y=1cm]
  \draw[->] (0,0) -- (5.6,0) node[below] {$x_1$};
  \draw[->] (0,0) -- (0,5.6) node[left] {$x_2$};
  \draw[very thick] plot[domain=0.78:5.2, samples=80] (\x,{4/\x});
  \draw[thick] (0.65,5.4) -- (1.35,2.6);
  \draw[thick] (2.8,1.3) -- (5.2,0.7);
  \fill (1,4) circle (2pt) node[right, xshift=2pt] {$A$};
  \fill (4,1) circle (2pt) node[above, yshift=2pt] {$B$};
  \node[left] at (0.65,5.3) {$RMS_{12}(A)=4$};
  \node[above] at (4.6,1.6) {$RMS_{12}(B)=\tfrac{1}{4}$};
\end{tikzpicture}
