% Figura (Anexo I, «Demanda Marshalliana», «Obtención»; antes en «Precio Propio»): de la elección a la curva de demanda.
% Dos paneles, uno encima del otro, con la misma escala horizontal.
% Preferencias CES con a_1 = a_2 y sigma = 1/2; p_2 = 1, W = 3. Con p_1 = 2; 1,2; 0,75 se eligen
% A = (0,879; 1,243), B = (1,307; 1,432) y C = (1,856; 1,608).
% (a) Arriba: rectas de balance de (0, 3) a (W/p_1, 0) = (1,5; 0), (2,5; 0), (4; 0) y senda precio-consumo por A, B y C.
% (b) Abajo: curva de demanda x_1 = 3 p_1^(-1/2) / (p_1^(1/2) + 1), con p_1 en el eje vertical (1 unidad = 1,2 cm).
% Escala: 1 unidad = 1 cm.
% Generar con: bash Code/generar_figura.sh anx_precio
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=1cm, y=1cm]
  % ---------------- (a) Elección ----------------
  \node[font=\footnotesize\bfseries] at (2.2,3.75) {(a) Senda precio-consumo};
  \draw[->] (0,0) -- (4.6,0) node[below] {$x_1$};
  \draw[->] (0,0) -- (0,3.5) node[left] {$x_2$};
  \draw[thick, dashed] (0,3) -- (1.5,0);
  \draw[thick, dashed] (0,3) -- (2.5,0);
  \draw[thick, dashed] (0,3) -- (4,0);
  \draw[very thick] plot[smooth] coordinates {(0.55,1.1) (0.879,1.243) (1.307,1.432) (1.856,1.608) (2.3,1.72)};
  \fill (0.879,1.243) circle (2pt) node[above left] {$A$};
  \fill (1.307,1.432) circle (2pt) node[above left] {$B$};
  \fill (1.856,1.608) circle (2pt) node[above] {$C$};
  % ---------------- (b) Demanda ----------------
  \begin{scope}[yshift=-4.3cm]
    \node[font=\footnotesize\bfseries] at (2.2,3.55) {(b) Curva de demanda del bien 1};
    \draw[->] (0,0) -- (4.6,0) node[below] {$x_1$};
    \draw[->] (0,0) -- (0,3.3) node[left] {$p_1$};
    \draw[very thick] plot[domain=0.6:2.6, samples=80] ({3*\x^(-0.5)/(\x^(0.5)+1)},{1.2*\x});
    \fill (0.879,2.4) circle (2pt) node[right] {$A$};
    \fill (1.307,1.44) circle (2pt) node[right] {$B$};
    \fill (1.856,0.9) circle (2pt) node[above right] {$C$};
    \foreach \x/\y in {0.879/2.4,1.307/1.44,1.856/0.9} { \draw[densely dotted] (\x,3.25) -- (\x,\y); }
  \end{scope}
  \draw[densely dotted] (0.879,1.243) -- (0.879,0);
  \draw[densely dotted] (1.307,1.432) -- (1.307,0);
  \draw[densely dotted] (1.856,1.608) -- (1.856,0);
\end{tikzpicture}
