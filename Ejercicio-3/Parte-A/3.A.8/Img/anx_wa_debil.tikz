% Figura (Anexo II, «Axioma Débil»): dos elecciones con presupuestos de mercado. Dos paneles.
% (a) Coherentes: B^0 = {x_1 + x_2 <= 4}, elegida x^0 = (1,5; 2,5); B^1 = {0,6 x_1 + x_2 <= 3,6}, elegida x^1 = (4; 1,2).
%     x^0 era asequible con B^1 (x^1 se revela preferida a x^0), pero x^1 no lo era con B^0: no hay contradicción.
% (b) Violación: B^0 = {x_1 + x_2 <= 4}, elegida x^0 = (3,4; 0,6); B^1 = {0,4 x_1 + x_2 <= 2,4}, elegida x^1 = (1; 2).
%     Cada cesta elegida era asequible cuando se eligió la otra.
% Escala: 1 unidad = 0,85 cm.
% Generar con: bash Code/generar_figura.sh anx_wa_debil
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]}, x=0.85cm, y=0.85cm]
  % ---------------- (a) Elecciones coherentes ----------------
  \begin{scope}
    \node[font=\footnotesize\bfseries] at (3.1,5.0) {(a) Elecciones coherentes};
    \draw[->] (0,0) -- (6.4,0) node[below] {$x_1$};
    \draw[->] (0,0) -- (0,4.6) node[left] {$x_2$};
    \draw[very thick] (0,4) -- (4,0) node[below] {$B^0$};
    \draw[thick, dashed] (0,3.6) -- (6,0) node[below] {$B^1$};
    \fill (1.5,2.5) circle (2pt) node[above right] {$x^0$};
    \fill (4,1.2) circle (2pt) node[above right] {$x^1$};
  \end{scope}
  % ---------------- (b) Violación del axioma débil ----------------
  \begin{scope}[xshift=7.6cm]
    \node[font=\footnotesize\bfseries] at (3.1,5.0) {(b) Violación del axioma débil};
    \draw[->] (0,0) -- (6.4,0) node[below] {$x_1$};
    \draw[->] (0,0) -- (0,4.6) node[left] {$x_2$};
    \draw[very thick] (0,4) -- (4,0) node[below] {$B^0$};
    \draw[thick, dashed] (0,2.4) -- (6,0) node[below] {$B^1$};
    \fill (3.4,0.6) circle (2pt) node[above right] {$x^0$};
    \fill (1,2) circle (2pt) node[below left] {$x^1$};
  \end{scope}
\end{tikzpicture}
