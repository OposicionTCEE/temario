% Figura: cadena de agencia en la empresa pública (sustituye a Esquema_NISKANEN_EmpPublica.png, trasladada del Tema 3.A.15).
% Propietarios (ciudadanos) -> directivos -> agentes (trabajadores, proveedores), con el fallo de control en cada eslabón.
% Generar con: bash Code/generar_figura.sh agencia_empresa_publica
\begin{tikzpicture}[font=\footnotesize, >={Stealth[length=4pt]},
  nivel/.style={draw, rounded corners=2pt, align=center, inner sep=4pt, minimum width=5.2cm},
  nota/.style={align=left, text width=6.6cm, anchor=west}]
  \node[nivel] (p) at (0,2.6) {\textit{Propietarios} (ciudadanos)};
  \node[nivel] (d) at (0,1.3) {\textit{Directivos}};
  \node[nivel] (a) at (0,0) {\textit{Agentes} (trabajadores, proveedores)};
  \draw[->] (p) -- (d);
  \draw[->] (d) -- (a);
  \node[nota] (n1) at (3.6,1.95) {Mala supervisión: los propietarios son muchos, están dispersos y poco organizados};
  \node[nota] (n2) at (3.6,0.65) {Gestión ineficiente por la burocracia asociada a la empresa pública (Ley de Contratos del Sector Público, etc.)};
  \draw[->] (n1.west) -- ($(p)!0.5!(d)+(0.15,0)$);
  \draw[->] (n2.west) -- ($(d)!0.5!(a)+(0.15,0)$);
\end{tikzpicture}
